[user]
    name = Ongki Pro
    email = get@ongki.pro
[core]
    excludesfile = ~/.gitignore_global
    autocrlf = input
    editor = hx
    pager = delta
[init]
    defaultBranch = main
[push]
    autoSetupRemote = true
    default = simple
[fetch]
    prune = true
    writeCommitGraph = true
[diff]
    colorMoved = default
    algorithm = histogram
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true
[merge]
    conflictStyle = zdiff3
[rerere]
    enabled = true
    autoupdate = true
[column]
    ui = auto
[branch]
    sort = -committerdate
[tag]
    sort = -version:refname
[commit]
    verbose = true
[help]
    autocorrect = prompt
[rebase]
    autosquash = true
    autostash = true
[alias]
    st = status -sb
    co = checkout
    br = branch
    lg = log --oneline --graph --decorate --all -20
    last = log -1 HEAD --stat
    undo = reset --soft HEAD~1
    amend = commit --amend --no-edit
    unstage = reset HEAD --
    diffstat = diff --stat
[color]
    ui = auto
[pull]
    rebase = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
