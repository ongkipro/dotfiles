[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[user]
	name = ongkipro
	email = 82156528+ongkipro@users.noreply.github.com
[core]
	autocrlf = input
	editor = hx
	excludesfile = /home/ongki/.gitignore_global
	pager = delta
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
	default = simple
[pull]
	rebase = true
[alias]
	lg = log --graph --oneline --decorate --all -20
	st = status -sb
	ci = commit
	br = branch
	co = checkout
	rb = rebase
	diffstat = diff --stat
	last = log -1 HEAD --stat
	undo = reset --soft HEAD~1
	amend = commit --amend --no-edit
[color]
	ui = auto
[fetch]
	prune = true
	writeCommitGraph = true
[diff]
	colorMoved = default
	algorithm = histogram
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
	autoupdate = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = -version:refname
[commit]
	verbose = true
[help]
	autocorrect = prompt
[rebase]
	autosquash = true
	autostash = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
