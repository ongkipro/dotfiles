# ============================================================================
#  ~/.zshrc — macOS (Apple Silicon) · oh-my-zsh
#  Disempurnakan: history, completion, modern CLI tools, plugins.
#  Backup lama: ~/.zshrc.bak.YYYYMMDD
# ============================================================================

# --- PATH: dedup otomatis (elemen unik, urutan dipertahankan) ---------------
typeset -U path PATH

# --- Oh My Zsh --------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

# Update oh-my-zsh: ingatkan (jangan auto tanpa izin), tiap 13 hari
zstyle ':omz:update' mode reminder
zstyle ':omz:update' frequency 13

# Plugin bawaan omz yang relevan dgn tooling kamu.
# (git gh brew macos npm) — hindari kebanyakan biar startup tetap cepat.
plugins=(git gh brew macos npm fzf)

source "$ZSH/oh-my-zsh.sh"

# ============================================================================
#  History — besar, tanpa duplikat, dibagikan antar-tab, bertimestamp
# ============================================================================
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt HIST_IGNORE_ALL_DUPS      # buang duplikat lama
setopt HIST_IGNORE_SPACE         # perintah diawali spasi tidak disimpan
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY               # expand !! dulu sebelum dijalankan
setopt SHARE_HISTORY             # sinkron antar sesi
setopt EXTENDED_HISTORY          # simpan timestamp
setopt INC_APPEND_HISTORY

# QoL zsh
setopt AUTO_CD                   # ketik nama folder = cd
setopt INTERACTIVE_COMMENTS      # izinkan # komentar di prompt
setopt NO_BEEP

# ============================================================================
#  Environment
# ============================================================================
export LANG="en_US.UTF-8"
export EDITOR="hx"; command -v hx >/dev/null 2>&1 || export EDITOR="vim"
export VISUAL="$EDITOR"
export CLICOLOR=1

# Homebrew (shellenv sudah di .zprofile; ini jaring pengaman utk shell non-login)
command -v brew >/dev/null 2>&1 || eval "$(/opt/homebrew/bin/brew shellenv)"

# ============================================================================
#  Node — nvm & bun
# ============================================================================
export NVM_DIR="$HOME/.nvm"
[ -s "$(brew --prefix nvm)/nvm.sh" ] && source "$(brew --prefix nvm)/nvm.sh"

export BUN_INSTALL="$HOME/.bun"
path=("$BUN_INSTALL/bin" $path)
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"   # bun completions

# Antigravity CLI
path=("$HOME/.local/bin" $path)

# ============================================================================
#  Modern CLI tools (semua sudah terinstall via brew)
# ============================================================================
# zoxide — `cd` yang belajar; `z <keyword>`, `zi` interaktif
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# fzf — fuzzy finder (Ctrl-R history, Ctrl-T file, Alt-C cd)
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh) 2>/dev/null
  export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border --info=inline"
  command -v fd >/dev/null 2>&1 && export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git' \
    && export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
fi

# ============================================================================
#  Aliases
# ============================================================================
# eza (pengganti ls)
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first --icons=auto'
  alias ll='eza -lah --group-directories-first --icons=auto --git'
  alias la='eza -a  --group-directories-first --icons=auto'
  alias lt='eza --tree --level=2 --icons=auto'
fi
# bat (pengganti cat, tapi jangan override cat — bisa break script)
command -v bat >/dev/null 2>&1 && export BAT_THEME="ansi" && alias batp='bat --paging=never'
# fd/ripgrep sudah jadi command sendiri (fd, rg)
command -v btop >/dev/null 2>&1 && alias top='btop'

# git / gh / dev
alias g='git'
alias gs='git status -sb'
alias gl='git log --oneline --graph --decorate --all -20'
alias gd='git diff'
alias reload='exec zsh'
alias zshrc='$EDITOR ~/.zshrc'
alias ip='ipconfig getifaddr en0'
alias path='echo $PATH | tr ":" "\n"'
alias myip='curl -s https://ifconfig.me; echo'

# macOS quality-of-life
alias flush='sudo dscacheutil -flushcache && sudo killall -HUP mDNSResponder && echo "DNS cache flushed"'
alias showfiles='defaults write com.apple.finder AppleShowAllFiles YES && killall Finder'
alias hidefiles='defaults write com.apple.finder AppleShowAllFiles NO && killall Finder'

# ============================================================================
#  Completion cache (percepat compinit)
# ============================================================================
autoload -Uz compinit
if [[ -n "$HOME/.zcompdump"(#qN.mh+24) ]]; then compinit; else compinit -C; fi
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'   # case-insensitive

# ============================================================================
#  Plugin eksternal — HARUS di akhir (syntax-highlighting paling akhir)
# ============================================================================
BREW_PREFIX="$(brew --prefix 2>/dev/null || echo /opt/homebrew)"
source "$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" 2>/dev/null
export ZSH_HIGHLIGHT_HIGHLIGHTERS_DIR="$BREW_PREFIX/share/zsh-syntax-highlighting/highlighters"
source "$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" 2>/dev/null

# mise activation (dari install-macos.sh)
eval "$($HOME/.local/bin/mise activate zsh)"

# PATH: local bin + agents bin
export PATH="$HOME/.local/bin:$HOME/.agents/bin:$PATH"

source "$HOME/dotfiles/config/zshrc.tools.sh"

# agent-browser encryption key (auto-generated)
export AGENT_BROWSER_ENCRYPTION_KEY="$(cat ~/.agent-browser/.encryption_key 2>/dev/null || openssl rand -hex 32 | tee ~/.agent-browser/.encryption_key)"

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi
