{
  "typescript": {
    "command": ["typescript-language-server", "--stdio"],
    "extensions": [".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".mts", ".cts"],
    "diagnosticsSettleMs": 1000
  },
  "pyright": {
    "command": ["pyright-langserver", "--stdio"],
    "extensions": [".py", ".pyi"]
  },
  "bash": {
    "command": ["bash-language-server", "start"],
    "extensions": [".sh", ".bash"]
  }
}
