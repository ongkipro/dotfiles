{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultProvider": "9router-fantastico",
  "defaultModel": "cc/claude-sonnet-5-5",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "9router-fantastico/cc/claude-opus-5-5",
    "9router-fantastico/cc/claude-sonnet-5-5",
    "9router-fantastico/cx/gpt-6.1-sol",
    "9router-fantastico/ag/gemini-4-carbon-high",
    "9router-fantastico/ag/gemini-4-carbon-medium",
    "9router-fantastico/cc/claude-fable-5-2",
    "9router-fantastico/ag/claude-opus-5-5",
    "9router-fantastico/cc/claude-haiku-5-5",
    "9router-fantastico/ag/gemini-3.8-flash",
    "9router-fantastico/ag/claude-opus-5-5-high",
    "9router-fantastico/ag/claude-opus-5-5-medium",
    "9router-fantastico/ag/claude-sonnet-5-5",
    "9router-fantastico/ag/claude-sonnet-5-5-high",
    "9router-fantastico/ag/claude-sonnet-5-5-medium",
    "9router-fantastico/ag/gemini-4-argon-high",
    "9router-fantastico/ag/gemini-4-argon-low",
    "9router-fantastico/ag/gemini-4-argon-medium",
    "9router-fantastico/ag/gemini-4-carbon",
    "9router-fantastico/ag/gemini-4-carbon-low",
    "9router-fantastico/ag/gemini-4-hydrogen-high",
    "9router-fantastico/ag/gemini-4-hydrogen-low",
    "9router-fantastico/ag/gemini-4-hydrogen-medium",
    "9router-fantastico/ag/gemini-4-hydrogen-xhigh",
    "9router-fantastico/ag/gpt-oss-120b-medium",
    "9router-fantastico/cc/claude-fable-5",
    "9router-fantastico/cc/claude-haiku-4-5-20251001",
    "9router-fantastico/cc/claude-opus-5",
    "9router-fantastico/cc/claude-sonnet-5",
    "9router-fantastico/cx/gpt-6-astra",
    "9router-fantastico/cx/gpt-6-astra[1m]",
    "9router-fantastico/cx/gpt-6-luna[1m]",
    "9router-fantastico/cx/gpt-6.1-terra",
    "9router-fantastico/mmf/mimo-auto",
    "9router-fantastico/oc/deepseek-v4.1-flash-free",
    "9router-fantastico/oc/glm-5.3-flash-free",
    "9router-fantastico/oc/mimo-v2.6-flash-free",
    "9router-fantastico/ag/gemini-3.8-flash-low",
    "9router-fantastico/ag/gemini-3.8-flash-medium",
    "9router-fantastico/ag/gemini-3.8-flash-high"
  ],
  "quietStartup": true,
  "hideThinkingBlock": true,
  "packages": [
    "npm:pi-web-access",
    "npm:pi-agent-browser-native",
    "npm:pi-subagents@0.88.0",
    "npm:@narumitw/pi-lsp@0.49.11",
    "npm:cc-safety-net",
    "npm:pi-background-tasks",
    "npm:@ff-labs/pi-fff",
    "npm:@narumitw/pi-plan-mode",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-rewind-hook",
    "npm:@narumitw/pi-worktree",
    "npm:@narumitw/pi-btw",
    "npm:@narumitw/pi-goal"
  ],
  "prompts": [
    "~/dotfiles/config/pi/prompts"
  ],
  "rewind": {
    "retention": {
      "maxSnapshots": 2000,
      "maxAgeDays": 30,
      "pinLabeledEntries": true
    }
  },
  "subagents": {
    "agentOverrides": {
      "reviewer": {
        "model": "9router-fantastico/cx/gpt-6.1-sol",
        "thinking": "high",
        "description": "Independent read-only review. Default GPT-6.1 Sol; the parent passes another model when the implementer is GPT (see config/pi/README.md, Review pairing)"
      },
      "oracle": {
        "model": "9router-fantastico/ag/gemini-4-carbon-high",
        "thinking": "high",
        "description": "Read-only advisor (alias: advisor) for plan, architecture and decision-drift checks. Default Gemini 4 Carbon, outside the Claude implementer family; when the implementer is Gemini or GPT the parent passes cc/claude-fable-5-2 (see config/pi/README.md, Review pairing)"
      },
      "scout": {
        "model": "9router-fantastico/cc/claude-haiku-5-5",
        "thinking": "low",
        "description": "Fast codebase recon that returns compressed context for handoff. Pinned to Haiku 5.5 (low): recon needs speed, not the parent's heavy model"
      },
      "researcher": {
        "model": "9router-fantastico/ag/gemini-4-carbon-medium",
        "thinking": "medium",
        "description": "Autonomous web researcher. Pinned to Gemini 4 Carbon medium (1M context) for source synthesis; evidence-auditor checks it from another family"
      },
      "evidence-auditor": {
        "model": "9router-fantastico/cx/gpt-6.1-sol",
        "thinking": "high",
        "description": "Independent evidence reviewer. Pinned to GPT-6.1 Sol, outside the researcher's Gemini family, so claim checks stay independent"
      }
    }
  }
}
