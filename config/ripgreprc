# ripgrep config — akurat & cepat
--smart-case
--hidden
--glob=!.git/*
# artefak build/deps — nama telanjang (tanpa slash) = cocok di kedalaman mana pun.
# Tetap berlaku walau rg dipanggil dengan --no-ignore.
--glob=!node_modules
--glob=!.next
--glob=!.astro
--glob=!.turbo
--glob=!.vercel
--glob=!dist
--glob=!.cache
--glob=!package-lock.json
--glob=!pnpm-lock.yaml
--max-columns=200
--max-columns-preview
--colors=line:fg:yellow
--colors=match:fg:black
--colors=match:bg:yellow
--colors=path:fg:green
--colors=path:style:bold
