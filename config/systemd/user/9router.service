[Unit]
Description=9Router AI Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.nvm/versions/node/v24.16.0/bin/node %h/.nvm/versions/node/v24.16.0/lib/node_modules/9router/cli.js --host 127.0.0.1 --no-browser --skip-update
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=NODE_ENV=production
Environment=HOME=%h
WorkingDirectory=%h

NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
