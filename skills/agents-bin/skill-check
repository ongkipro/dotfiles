#!/usr/bin/env bash
# Validate owned skills without downloading dependencies.
set -euo pipefail

SRC="${SKILL_SOURCE:-$HOME/dotfiles/skills/local}"
requested="${1:-}"
fail=0
warn=0
count=0
description_chars=0

DESCRIPTION_MAX=1024

bad() { printf '  FAIL  %s\n' "$*"; fail=$((fail + 1)); }
wrn() { printf '  WARN  %s\n' "$*"; warn=$((warn + 1)); }
ok()  { printf '  OK    %s\n' "$*"; }

yaml_available=0
if command -v python3 >/dev/null 2>&1 && python3 -c "import yaml" >/dev/null 2>&1; then
  yaml_available=1
fi

# Parse a SKILL.md's frontmatter (between the first two '---' lines) with
# PyYAML and report a parse error on stdout, exit 1, if it is invalid.
# Exits 0 (silently) when there is no frontmatter to validate here — the
# awk-based checks already enforce that a leading '---' block exists.
frontmatter_yaml_error() {
  python3 - "$1" <<'PYEOF'
import sys
import yaml

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as f:
    lines = f.readlines()

if not lines or lines[0].rstrip("\n") != "---":
    sys.exit(0)

end = None
for i in range(1, len(lines)):
    if lines[i].rstrip("\n") == "---":
        end = i
        break
if end is None:
    sys.exit(0)

frontmatter = "".join(lines[1:end])
try:
    yaml.safe_load(frontmatter)
except yaml.YAMLError as exc:
    print(str(exc).replace("\n", " "))
    sys.exit(1)
sys.exit(0)
PYEOF
}

frontmatter_value() {
  local key="$1" file="$2"
  awk -v key="$key" '
    NR == 1 { if ($0 != "---") exit 2; in_frontmatter = 1; next }
    in_frontmatter && $0 == "---" { exit }
    in_frontmatter && $0 ~ ("^" key ":[[:space:]]*") {
      value = $0
      sub("^" key ":[[:space:]]*", "", value)
      if (value ~ /^[>|][-+]?[[:space:]]*$/) { block = 1; next }
      gsub(/^['\''\"]|['\''\"]$/, "", value)
      print value
      exit
    }
    block {
      if ($0 !~ /^[[:space:]]+/) exit
      value = $0
      sub(/^[[:space:]]+/, "", value)
      if (length(value)) printf "%s%s", separator, value
      separator = " "
    }
    END { if (block) print "" }
  ' "$file"
}

[ -d "$SRC" ] || { echo "ERROR: skill source not found: $SRC" >&2; exit 1; }

if [ "$yaml_available" -eq 1 ]; then
  echo "YAML frontmatter validation: python3 + PyYAML available; parsing each frontmatter block strictly."
else
  echo "YAML frontmatter validation: python3 or its yaml module is unavailable; degrading to the awk line-scan only. Install PyYAML (pip install pyyaml) to catch frontmatter a strict YAML parser would reject."
fi

if [ -n "$requested" ]; then
  [ -f "$SRC/$requested/SKILL.md" ] || { echo "ERROR: unknown skill: $requested" >&2; exit 1; }
  skills=("$SRC/$requested")
else
  skills=()
  while IFS= read -r file; do skills+=("$(dirname "$file")"); done \
    < <(find "$SRC" -mindepth 2 -maxdepth 2 -name SKILL.md -print | LC_ALL=C sort)
fi

seen_file="$(mktemp "${TMPDIR:-/tmp}/skill-check-seen.XXXXXX")"
cleanup() { rm -f "$seen_file"; }
trap cleanup EXIT

# The awk scanner below reads raw frontmatter lines. That is right for the
# checks — a placeholder or a missing field is visible in the raw text — but
# wrong for a character COUNT, which is the one number a task can be held to:
# TASK-049's verification used it. Measured 2026-09-04, awk was over by 188
# characters across 36 skills: +3 wherever a folded '>-' marker is counted as
# description text, and +14 to +36 on the four single-quoted scalars whose
# quotes and doubled '' escapes it keeps. Count from the parsed value when
# PyYAML is present, and say the number is approximate when it is not.
description_length() {
  if [ "$yaml_available" -eq 1 ]; then
    parsed="$(python3 - "$1" <<'PYCOUNT'
import sys, yaml
text = open(sys.argv[1], encoding="utf-8").read()
if not text.startswith("---"):
    raise SystemExit(1)
end = text.index("\n---", 3)
value = (yaml.safe_load(text[4:end]) or {}).get("description")
print(len(" ".join(str(value).split())) if value is not None else 0)
PYCOUNT
)" && [ -n "$parsed" ] && { printf '%s' "$parsed"; return 0; }
  fi
  printf '%s' "$2"
}

for dir in "${skills[@]}"; do
  count=$((count + 1))
  fail_before=$fail
  file="$dir/SKILL.md"
  folder="$(basename "$dir")"
  name="$(frontmatter_value name "$file" | tr -d '\r')"
  description="$(frontmatter_value description "$file" | tr -d '\r')"
  description_chars=$((description_chars + $(description_length "$file" "${#description}")))

  [ -n "$name" ] || bad "$folder: missing frontmatter name"
  [ -n "$description" ] || bad "$folder: missing frontmatter description"
  case "$description" in
    Describe\ what*|Describe\ exactly*|TODO*) bad "$folder: placeholder description is still active" ;;
  esac
  [ "${#description}" -le "$DESCRIPTION_MAX" ] || wrn "$folder: description is ${#description} characters; guideline is ~$DESCRIPTION_MAX"

  if [ "$yaml_available" -eq 1 ]; then
    yaml_err="$(frontmatter_yaml_error "$file")" || bad "$folder: frontmatter is not valid YAML: $yaml_err"
  fi
  [ "$name" = "$folder" ] || bad "$folder: name is '$name'"
  [[ "$folder" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || bad "$folder: invalid folder name"
  duplicate="$(awk -F '\t' -v key="$name" '$1 == key { print $2; exit }' "$seen_file")"
  if [ -n "$name" ] && [ -n "$duplicate" ]; then
    bad "$folder: duplicate name also used by $duplicate"
  elif [ -n "$name" ]; then
    printf '%s\t%s\n' "$name" "$folder" >> "$seen_file"
  fi

  grep -Eq '\[TODO[^]]*\]|TODO:' "$file" && bad "$folder: unresolved TODO placeholder"
  lines="$(wc -l < "$file" | tr -d ' ')"
  [ "$lines" -le 500 ] || wrn "$folder: SKILL.md is $lines lines; split references near 500"

  while IFS= read -r target; do
    case "$target" in
      http:*|https:*|mailto:*|\#*|'') continue ;;
    esac
    target="${target%%#*}"
    [ -e "$dir/$target" ] || bad "$folder: broken relative link $target"
  done < <(grep -Eo '\]\([^)]+\)' "$file" | sed -E 's/^\]\((.*)\)$/\1/' || true)

  [ "$fail" -eq "$fail_before" ] && ok "$folder"
done

printf '\nChecked %d skill(s): %d failure(s), %d warning(s)\n' "$count" "$fail" "$warn"
if [ -z "$requested" ]; then
  if [ "$yaml_available" -eq 1 ]; then approx=''
  else approx=' (approximate: counted from raw frontmatter because PyYAML is unavailable)'
  fi
  printf 'Discovery metadata: %d description characters%s; hosts may truncate the initial registry, so keep each key use case front-loaded.\n' "$description_chars" "$approx"
fi
[ "$fail" -eq 0 ]
