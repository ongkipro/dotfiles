#!/usr/bin/env bash
set -euo pipefail

SKILL_NAME="${1:-}"
LOCAL_SKILLS_DIR="${LOCAL_SKILLS_DIR:-$HOME/.agents/local-skills}"

realpath_portable() {
  python3 - "$1" <<'PY'
import os, sys
print(os.path.realpath(sys.argv[1]))
PY
}

LOCAL_SKILLS_DIR="$(realpath_portable "$LOCAL_SKILLS_DIR")"
TARGET_DIR="$LOCAL_SKILLS_DIR/$SKILL_NAME"

if [ -z "$SKILL_NAME" ]; then
  echo "Usage: skill-remove <skill-name>" >&2
  exit 1
fi

if [ ! -d "$TARGET_DIR" ]; then
  echo "Local skill not found: $SKILL_NAME" >&2
  exit 1
fi

rm -rf "$TARGET_DIR"
"$HOME/.agents/bin/skill-update" >/dev/null

echo "Removed: $TARGET_DIR"
echo "Unlinked from: ~/.agents/skills, ~/.claude/skills, ~/.codex/skills, ~/.gemini/skills, ~/.pi/agent/skills"
