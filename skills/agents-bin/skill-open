#!/usr/bin/env bash
set -euo pipefail
SRC="${SKILL_SOURCE:-$HOME/dotfiles/skills/local}"
SKILL_NAME="${1:-}"

[ -n "$SKILL_NAME" ] || { echo "Usage: skill-open <skill-name>" >&2; exit 1; }
f="$SRC/$SKILL_NAME/SKILL.md"
[ -f "$f" ] || { echo "Skill not found: $SKILL_NAME (lihat: skill-list)" >&2; exit 1; }
exec "${VISUAL:-${EDITOR:-hx}}" "$f"
