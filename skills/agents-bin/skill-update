#!/usr/bin/env bash
# Link every AI CLI's skills dir to the ONE source: dotfiles/skills/local.
#
# Model: WHOLE-DIRECTORY symlink.
#   ~/.claude/skills       ─┐
#   ~/.pi/agent/skills     ─┼─→ dotfiles/skills/local/
#   ~/.agents/local-skills ─┘
#
# Consequence: `git pull` alone syncs skills. A new skill appears, a deleted skill
# disappears, on every CLI, with zero extra steps. This script only needs to run
# ONCE per device (install.sh calls it). Running it again is a safe no-op.
#
# It replaced a per-skill-symlink version that carried a destructive bug: when a
# target base was ALREADY a whole-dir symlink into the source, the backup step
# `mv`-ed every real skill directory inside dotfiles to *.backup.<ts> and left
# self-referencing symlinks behind ("Too many levels of symbolic links").
# Hence the hard rule below: NEVER modify anything that resolves inside SRC.
set -euo pipefail

# Source of truth = this script's own repo, not a guessable $HOME path.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
SRC="$(cd "$SCRIPT_DIR/../local" && pwd)"

[ -d "$SRC" ] || { echo "ERROR: skill source not found: $SRC" >&2; exit 1; }

# Link where the CLI actually exists or parent dir exists.
TARGETS=(
  "$HOME/.claude/skills"
  "$HOME/.pi/agent/skills"
  "$HOME/.agents/local-skills"
  "$HOME/.gemini/skills"
  "$HOME/.gemini/config/skills"
  "$HOME/.antigravity/skills"
  "$HOME/.omp/agent/skills"
)

linked=0 skipped=0

for target in "${TARGETS[@]}"; do
  parent="$(dirname "$target")"
  # Create parent if gemini/antigravity exists
  if [ ! -d "$parent" ] && [[ "$parent" == *".gemini"* || "$parent" == *".antigravity"* ]]; then
    mkdir -p "$parent"
  fi

  # CLI not installed on this device → skip. Not an error.
  if [ ! -d "$parent" ]; then
    printf '  skip   %-24s (%s tidak ada — CLI belum terpasang)\n' "${target/#$HOME/\~}" "${parent/#$HOME/\~}"
    skipped=$((skipped + 1))
    continue
  fi

  resolved="$(readlink -f "$target" 2>/dev/null || true)"

  # HARD SAFETY: never touch a path that lives inside the source tree.
  case "$resolved" in
    "$SRC"/*)
      echo "ERROR: $target resolves INSIDE the source ($resolved). Refusing to touch it." >&2
      exit 1
      ;;
  esac

  # Already correct → no-op.
  if [ -L "$target" ] && [ "$resolved" = "$SRC" ]; then
    printf '  ok     %-24s -> %s\n' "${target/#$HOME/\~}" "${SRC/#$HOME/\~}"
    continue
  fi

  # A real directory in the way (per-skill layout from the old script, or a
  # hand-made dir). Move it aside — never delete, and never inside the source.
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    backup="${target}.backup.$(date +%Y%m%d-%H%M%S)"
    mv "$target" "$backup"
    echo "  moved  ${target/#$HOME/\~} -> ${backup/#$HOME/\~}  (tidak dihapus)"
  fi

  ln -sfn "$SRC" "$target"
  printf '  link   %-24s -> %s\n' "${target/#$HOME/\~}" "${SRC/#$HOME/\~}"
  linked=$((linked + 1))
done

count=$(find "$SRC" -mindepth 2 -maxdepth 2 -name SKILL.md | wc -l | tr -d ' ')
echo
echo "Source : ${SRC/#$HOME/\~}  (${count} skill)"
echo "Linked : $linked   Skipped: $skipped"
echo "Sinkron lintas device = 'git pull' saja. skill-update cukup sekali per mesin."
