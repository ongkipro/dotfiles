#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
SRC="$(cd "$SCRIPT_DIR/../local" && pwd)"

n=0
while IFS= read -r d; do
  printf '  - %s\n' "$(basename "$d")"
  n=$((n+1))
done < <(find "$SRC" -mindepth 2 -maxdepth 2 -name SKILL.md -exec dirname {} \; | sort)
echo
echo "$n skill — sumber: ${SRC/#$HOME/\~}"
