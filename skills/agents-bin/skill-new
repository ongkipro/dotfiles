#!/usr/bin/env bash
set -euo pipefail

LOCAL_SKILLS_DIR="${SKILL_SOURCE:-$HOME/dotfiles/skills/local}"
SKILL_NAME="${1:-}"
SKILL_DESCRIPTION="${2:-}"

usage() {
  echo 'Usage: skill-new <skill-name> "what it does and exactly when to use it"'
  echo 'Example: skill-new seo-audit "Audit technical SEO when asked to diagnose indexing or ranking issues."'
}

if [ -z "$SKILL_NAME" ]; then
  usage
  exit 1
fi

if [ -z "$SKILL_DESCRIPTION" ]; then
  echo "A trigger-ready description is required; incomplete skills must not enter the live registry." >&2
  usage >&2
  exit 1
fi
case "$SKILL_DESCRIPTION" in
  *$'\n'*)
    echo "Skill description must be one line; put detailed guidance in SKILL.md." >&2
    exit 1
    ;;
esac

if ! [[ "$SKILL_NAME" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  echo "Invalid skill name: $SKILL_NAME" >&2
  echo "Use lowercase letters, numbers, and hyphens only." >&2
  exit 1
fi

SKILL_DIR="$LOCAL_SKILLS_DIR/$SKILL_NAME"
SKILL_FILE="$SKILL_DIR/SKILL.md"

if [ -e "$SKILL_DIR" ]; then
  echo "Skill already exists: $SKILL_DIR" >&2
  exit 1
fi

mkdir -p "$SKILL_DIR"

cat > "$SKILL_FILE" <<EOF
---
name: $SKILL_NAME
description: >-
  $SKILL_DESCRIPTION
---

# $SKILL_NAME

## Purpose

Describe the workflow this skill handles.

## Steps

1. Inspect the relevant files or inputs.
2. Apply the workflow for this skill.
3. Validate the result.

EOF

echo "Created: $SKILL_DIR"
echo "Main file: $SKILL_FILE"
echo "Langsung aktif di semua CLI (symlink satu-direktori). Jangan lupa commit dotfiles."
