# === SSH — TIDAK PERNAH masuk dotfiles. Titik. ===
# Key SSH bersifat per-device & rahasia. Backup key JANGAN di repo (walau privat):
# repo bisa ter-clone, ter-mirror, atau tak sengaja jadi publik.
.ssh/
**/.ssh/
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*.ppk
known_hosts*
authorized_keys*

# === Credentials / secrets — JANGAN PERNAH commit ===
*.key
*.pem
*.p12
*.pfx
.env
.env.*
.dev.vars
*auth*.json
**/*auth*.json
*credential*.json
*.credentials.json
.credentials.json
oauth_creds*.json
*.token
*_secret*
.secrets/

# === OS / junk / backup ===
.DS_Store
Thumbs.db
*.bak
*.bak.*
*.swp
*~
__pycache__/
node_modules/

# gh CLI: hosts.yml berisi oauth token — config.yml aman, hosts.yml TIDAK
config/gh/hosts.yml
hosts.yml
