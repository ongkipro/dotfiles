# === SSH — TIDAK PERNAH masuk dotfiles. Titik. ===
# Key SSH bersifat per-device & rahasia. Backup key JANGAN di repo (walau privat):
# repo bisa ter-clone, ter-mirror, atau tak sengaja jadi publik.
.ssh/
**/.ssh/
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
*.ppk
known_hosts*
authorized_keys*

# === Credentials / secrets — JANGAN PERNAH commit ===
*.key
*.pem
*.p12
*.pfx
.env
.env.*
.dev.vars
*auth*.json
**/*auth*.json
*credential*.json
*.credentials.json
.credentials.json
oauth_creds*.json
*.token
*_secret*
.secrets/

# Credential FILENAMES, not just extensions. The patterns above catch *.key,
# *.pem, .env and *credential*.json — but not the shapes this repo actually
# produces or that a stray copy would bring in. dotpush copies ~/.bashrc and
# ~/.zshrc into the tree and then runs `git add -A`, and security-check only
# recognises prefixed tokens (ghp_, sk-, AKIA…) or a NAME=value form limited to
# API_KEY/ACCESS_TOKEN/AUTH_TOKEN/SECRET/PASSWORD/PRIVATE_KEY. An opaque key with
# no prefix, in a file with no matching extension, would pass both gates.
*.env
secrets.env
*-remote-key
credentials
.npmrc
.netrc
.git-credentials

# === OS / junk / backup ===
.DS_Store
Thumbs.db
*.bak
*.bak.*
*.swp
*~
__pycache__/
node_modules/
*.log
logs/
# gh CLI: hosts.yml berisi oauth token — config.yml aman, hosts.yml TIDAK
config/gh/hosts.yml
hosts.yml

# === OMP Runtime DBs & Sessions ===
config/omp/*.db
config/omp/*.db-shm
config/omp/*.db-wal
config/omp/agents/
config/omp/terminal-sessions/
config/omp/last-changelog-version

# OMP writes no lock file; a zero-byte config.yml.lock was tracked for weeks
# with no reader (2026-08-15 audit P2-13, removed 2026-09-04). Ignore the shape
# so it cannot return unnoticed.
config/omp/*.lock
