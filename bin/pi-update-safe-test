#!/usr/bin/env bash
# pi-update-safe archives skill directories before letting an update run, so a
# broken update cannot take the skills with it. It exposes PI_RUNTIME_SKILL_DIRS
# and PI_ARCHIVE_ROOT for exactly this, and a shim `pi` keeps the network out.
set -uo pipefail
ROOT="${1:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
CMD="$ROOT/bin/pi-update-safe"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
f=0; ok(){ printf '  ✓ %s\n' "$1"; }; bad(){ echo "  FAIL $1" >&2; f=$((f+1)); }

SHIM="$TMP/shim"; mkdir -p "$SHIM"
# The shim records that it ran and returns whatever the fixture asks for, so the
# test can distinguish "the update was attempted" from "the wrapper gave up".
cat > "$SHIM/pi" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$PI_SHIM_LOG"
exit "${PI_SHIM_EXIT:-0}"
SH
chmod +x "$SHIM/pi"

# Command substitution would run this in a subshell and lose the exit code, so
# the output goes to a file and $rc stays in this shell.
run() { # run <exit-code> -> writes $TMP/out, sets $rc
  : > "$TMP/log"
  env PATH="$SHIM:$PATH" PI_SHIM_LOG="$TMP/log" PI_SHIM_EXIT="$1" \
    PI_RUNTIME_SKILL_DIRS="$TMP/skills" PI_ARCHIVE_ROOT="$TMP/archive" \
    HOME="$TMP/home" bash "$CMD" > "$TMP/out" 2>&1
  rc=$?
}

mkdir -p "$TMP/skills/demo" "$TMP/home"
printf -- '---\nname: demo\ndescription: A fixture skill.\n---\n\n# Demo\n' \
  > "$TMP/skills/demo/SKILL.md"

# 1. A clean run: the update is attempted and nothing is invented. The command
#    moves leftover *.backup.* artefacts out of the runtime skill dirs; with none
#    present it must NOT create an empty dated archive.
run 0
[ "$rc" -eq 0 ] && ok "a clean update succeeds" || bad "a clean update exited $rc ($(head -3 "$TMP/out"|tr '\n' ' '))"
grep -q 'update' "$TMP/log" && ok "the update was actually attempted" \
  || bad "pi update was never invoked"
[ ! -d "$TMP/archive" ] && ok "no archive is created when there is nothing to move" \
  || bad "an empty archive directory was created"

# 2. A leftover backup IS moved out, under PI_ARCHIVE_ROOT and not the default
#    path. Left in place it would be re-read as a skill by the next runtime scan.
printf 'stale\n' > "$TMP/skills/demo.backup.20260101"
run 0
moved="$(find "$TMP/archive" -name 'demo.backup.*' 2>/dev/null | head -1)"
[ -n "$moved" ] && ok "a leftover backup is archived" || bad "the backup was not moved"
[ ! -e "$TMP/skills/demo.backup.20260101" ] \
  && ok "and removed from the runtime skill directory" || bad "the backup stayed in place"
[ ! -e "$TMP/home/.pi/agent/skill-backups" ] \
  && ok "PI_ARCHIVE_ROOT is honoured over the default path" \
  || bad "it wrote to the default archive path despite PI_ARCHIVE_ROOT"

# 3. The archive is dated, so two runs on different days cannot overwrite each
#    other's evidence.
printf '%s' "$(basename "$(dirname "$(dirname "$moved")")")" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}_' \
  && ok "the archive directory is timestamped" || bad "the archive is not dated"

# 4. A failing update must surface. A wrapper that swallows it leaves you
#    believing you are current when you are not.
run 7
[ "$rc" -ne 0 ] && ok "a failing update fails the wrapper" \
  || bad "a failing pi update was reported as success"

[ "$f" -eq 0 ] && { echo "pi-update-safe-test: PASS"; exit 0; }
echo "pi-update-safe-test: $f case(s) failed" >&2; exit 1
