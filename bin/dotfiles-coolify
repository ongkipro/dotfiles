#!/usr/bin/env bash
# coolify CLI for the vps-main instance (https://dotserver.ongki.pro). The context
# "vps-main" holds only the URL; the API token comes from secrets-env
# (COOLIFY_VPS_MAIN_TOKEN) and is passed per call, never stored in the CLI config.
# Usage: dotfiles-coolify <coolify args...>   e.g. dotfiles-coolify server list
set -euo pipefail

key=$(secrets-env get COOLIFY_VPS_MAIN_TOKEN 2>/dev/null || true)
if [ -z "$key" ]; then
  echo "dotfiles-coolify: COOLIFY_VPS_MAIN_TOKEN is empty in ~/.config/ai-local/secrets.env" >&2
  exit 1
fi
exec coolify --context vps-main --token "$key" "$@"
