#!/usr/bin/env bash
# skill-upstream-test — offline fixtures for the upstream watch registry; a fake
# `gh` stands in for GitHub so no network or credentials are used.
set -euo pipefail
ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd)}"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/skill-upstream-test.XXXXXX")"; trap 'rm -rf "$TMP"' EXIT
S="$TMP/skills"; CMD="$ROOT/bin/skill-upstream"
fail() { echo "FAIL: $*" >&2; exit 1; }
skill() { mkdir -p "$S/$1"; printf -- '---\nname: %s\ndescription: fixture\n---\n' "$1" > "$S/$1/SKILL.md"; }

skill vendored; printf 'source: https://raw.githubusercontent.com/acme/skills/main/skills/vendored\nvendored: 2026-09-01\n' > "$S/vendored/.source"
skill forked
printf 'source: https://raw.githubusercontent.com/acme/skills/main/skills/forked\nvendored: 2026-09-01\n' > "$S/forked/.source"
printf 'upstream: https://raw.githubusercontent.com/acme/skills/main/skills/forked/SKILL.md\nverified: 2026-10-01\nnote: local patch\n  continues here\n' > "$S/forked/.local-fork"
skill watched; printf 'watch: acme/framework docs\nwatch: acme/gone\nverified: 2026-10-10\nnote: two sources\n' > "$S/watched/.upstream"
skill archived; printf 'watch: acme/old\nverified: 2026-10-10\n' > "$S/archived/.upstream"
skill offsite; printf 'source: https://docs.example.com/.well-known/skills/offsite\nvendored: 2026-10-02\n' > "$S/offsite/.source"
skill plain

# --- Offline listing never calls gh -------------------------------------------
export SKILL_UPSTREAM_GH="$TMP/no-such-gh"
"$CMD" --skills-dir "$S" --list --json > "$TMP/list.json" || true
python3 - "$TMP/list.json" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); w={(x['skill'],x.get('repo'),x.get('path')):x for x in d['watches']}
v=w[('vendored','acme/skills','skills/vendored')]; assert v['kind']=='vendored' and v['since']=='2026-09-01' and v['ref']=='main'
f=w[('forked','acme/skills','skills/forked')]; assert f['kind']=='fork' and f['since']=='2026-10-01', f   # newest comparison wins; SKILL.md stripped
assert sum(x['skill']=='forked' for x in d['watches'])==1                          # .source + .local-fork is one watch
assert w[('watched','acme/framework','docs')]['kind']=='watch' and w[('watched','acme/gone','')]['since']=='2026-10-10'
assert w[('offsite',None,None)]['url'].startswith('https://docs.example.com')
assert d['localOnly']==['plain'] and d['problems']==[], d
assert all('status' not in x for x in d['watches'])                                # no network in --list
PY

# --- Invalid registries fail loudly -------------------------------------------
B="$TMP/bad"; mkdir -p "$B"; cp -r "$S/plain" "$B/a"; cp -r "$S/plain" "$B/b"; cp -r "$S/plain" "$B/c"
printf 'watch: not-a-repo\nverified: 2026-10-10\ncolour: blue\n' > "$B/a/.upstream"
printf 'watch: acme/x\n' > "$B/b/.upstream"
mkdir -p "$B/orphan"; printf 'watch: acme/x\nverified: 2026-10-10\n' > "$B/orphan/.upstream"
printf 'source: https://raw.githubusercontent.com/acme/skills/main/skills/c\n' > "$B/c/.source"
if "$CMD" --skills-dir "$B" --list > "$TMP/bad.txt"; then fail "invalid registry accepted"; fi
for want in "unknown key 'colour'" "watch must be 'owner/repo [path]'" "needs exactly one 'verified" "directory has no SKILL.md" "no valid vendored/verified date"; do
  grep -qF "$want" "$TMP/bad.txt" || fail "missing problem: $want"
done
if "$CMD" --skills-dir "$S" --list --skill nope > "$TMP/nope.txt"; then fail "unknown --skill accepted"; fi
grep -q 'no such skill' "$TMP/nope.txt" || fail "unknown --skill not reported"

# --- Live report against a fake GitHub ----------------------------------------
cat > "$TMP/gh" <<'PY'
#!/usr/bin/env python3
import json,os,sys
a=sys.argv[1:]; open(os.environ['GH_LOG'],'a').write(' '.join(a)+'\n')
url=a[3]; q=dict(x.split('=',1) for x in a[4:][1::2])
if os.environ.get('GH_BROKEN'): sys.stderr.write('HTTP 401: Bad credentials\n'); sys.exit(1)
if url in ('repos/acme/gone','repos/acme/gone/commits'): sys.stderr.write('gh: Not Found (HTTP 404)\n'); sys.exit(1)
if url.endswith('/commits'):
    c=lambda d,s,t:{'sha':s*5,'commit':{'committer':{'date':d+'T01:00:00Z'},'message':t+'\nbody'}}
    out={'skills/vendored':[c('2026-10-20','abcdefgh','Upstream rewrote vendored')],'docs':[c('2026-10-21','12345678','Docs moved')]}.get(q.get('path',''),[])
    print(json.dumps(out)); sys.exit(0)
print(json.dumps({'archived': url=='repos/acme/old'}))
PY
chmod +x "$TMP/gh"; export SKILL_UPSTREAM_GH="$TMP/gh" GH_LOG="$TMP/gh.log"
find "$S" -type f -exec sha256sum {} + | sort > "$TMP/before.sum"
if "$CMD" --skills-dir "$S" --json > "$TMP/live.json"; then fail "missing/archived upstream not reported"; fi
python3 - "$TMP/live.json" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); st={(x['skill'],x.get('repo')):x for x in d['watches']}
assert st[('vendored','acme/skills')]['status']=='CHANGED' and st[('vendored','acme/skills')]['recent'][0]=={'date':'2026-10-20','sha':'abcdefgh','title':'Upstream rewrote vendored'}
assert st[('forked','acme/skills')]['status']=='CURRENT' and st[('forked','acme/skills')]['commits']==0
assert st[('watched','acme/framework')]['status']=='CHANGED'
assert st[('watched','acme/gone')]['status']=='MISSING'
assert st[('archived','acme/old')]['status']=='ARCHIVED'
assert st[('offsite',None)]['status']=='UNWATCHABLE'
assert any('acme/gone is missing' in p for p in d['problems']) and any('acme/old is archived' in p for p in d['problems'])
PY
grep -qF 'repos/acme/skills/commits -f per_page=100 -f since=2026-10-01T00:00:00Z -f path=skills/forked -f sha=main' "$TMP/gh.log" || fail "fork not queried from its newest date, path, and ref"
grep -qF 'repos/acme/framework/commits -f per_page=100 -f since=2026-10-10T00:00:00Z -f path=docs' "$TMP/gh.log" || fail "watch query wrong"
find "$S" -type f -exec sha256sum {} + | sort > "$TMP/after.sum"
cmp -s "$TMP/before.sum" "$TMP/after.sum" || fail "report modified the skills tree"

"$CMD" --skills-dir "$S" --skill vendored > "$TMP/one.txt" || fail "clean single-skill report failed"
grep -q 'CHANGED .*vendored' "$TMP/one.txt" && grep -q 'Upstream rewrote vendored' "$TMP/one.txt" || fail "text report lacks drift detail"
grep -q 'forked' "$TMP/one.txt" && fail "--skill did not filter"

# --- An unreachable GitHub is not a clean report ------------------------------
set +e; GH_BROKEN=1 "$CMD" --skills-dir "$S" --skill vendored > /dev/null 2> "$TMP/err.txt"; code=$?; set -e
[ "$code" -eq 2 ] || fail "query failure exit $code, want 2"
grep -q 'Bad credentials' "$TMP/err.txt" || fail "query failure not explained"

echo 'skill-upstream-test: PASS'
