#!/usr/bin/env bash
# Mutation-backed regression for the actionlint policy gate.
set -euo pipefail

ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd)}"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/ai-policy-lint-test.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
fail(){ echo "FAIL: $*" >&2; exit 1; }

command -v actionlint >/dev/null 2>&1 || fail "actionlint is unavailable"

cat > "$TMP/invalid.yml" <<'YAML'
name: Invalid fixture
on: push
jobs:
  test:
    runs-on: ubuntu-latest
    invalid-key: true
    steps: []
YAML
if actionlint "$TMP/invalid.yml" >"$TMP/invalid.log" 2>&1; then
  fail "actionlint accepted an invalid workflow fixture"
fi

mkdir -p "$TMP/bin"
cat > "$TMP/bin/actionlint" <<'SH'
#!/bin/sh
echo "deliberate-actionlint-failure"
exit 23
SH
chmod +x "$TMP/bin/actionlint"

set +e
PATH="$TMP/bin:$PATH" "$ROOT/bin/ai-policy-lint" >"$TMP/policy.log" 2>&1
status=$?
set -e
[ "$status" -eq 1 ] || {
  cat "$TMP/policy.log" >&2
  fail "ai-policy-lint did not fail when actionlint failed"
}
grep -qF "deliberate-actionlint-failure" "$TMP/policy.log" || fail "actionlint output was not preserved"
grep -qF "GitHub workflows failed" "$TMP/policy.log" || fail "actionlint failure lost its policy-gate owner"


# ── Task execution contract ─────────────────────────────────────────────────
# The contract rules run against fixtures through ai-policy-lint's own
# --task-contracts entry point, so this exercises the shipped code path rather
# than a copy of the rules.
LINT="$ROOT/bin/ai-policy-lint"
contracts(){ "$LINT" --task-contracts "$@"; }

"$LINT" --task-contracts "$ROOT/TASKS.md" "$ROOT/config/templates/TASKS.md" >"$TMP/contracts.log" 2>&1 || {
  cat "$TMP/contracts.log" >&2
  fail "tracked task contracts must satisfy the lint"
}

good_task(){
  cat <<'MD'
## Done
### TASK-900: Well-formed implementation task
- **Requirement:** REQ-900
- **Risk Level:** R3
- **Allowed Paths:** `src/**`
- **Protected Paths:** `src/auth/**`
- **Canonical Contract Owners:** `identity.session`
- **Accepted Invariants:** session rotation stays observable
- **Depends On:** None
- **Regression Checks:** `npm test`
- **Reopen Conditions:** rotation regression reproduces
- **Non-Scope:** billing
- **Escalation Conditions:** verification fails twice
MD
}

good_task > "$TMP/good.md"
contracts "$TMP/good.md" >/dev/null || fail "a complete R3 task must pass the contract lint"

reject_contract(){
  local label="$1" file="$2" expected="$3"
  set +e
  contracts "$file" > "$TMP/contract.log" 2>&1
  local rc=$?
  set -e
  [ "$rc" -eq 1 ] || { cat "$TMP/contract.log" >&2; fail "task contract lint accepted: $label"; }
  grep -qF "$expected" "$TMP/contract.log" || {
    cat "$TMP/contract.log" >&2
    fail "task contract lint lost its reason for: $label"
  }
}

good_task | grep -v '^- \*\*Non-Scope' > "$TMP/no-scope.md"
reject_contract "missing Non-Scope" "$TMP/no-scope.md" "missing required field: Non-Scope"

good_task | grep -v '^- \*\*Canonical Contract Owners' > "$TMP/no-owner.md"
reject_contract "missing owner" "$TMP/no-owner.md" "Canonical Contract Owners or Shared Owner"

good_task | grep -v '^- \*\*Reopen Conditions' > "$TMP/no-reopen.md"
reject_contract "missing Reopen Conditions" "$TMP/no-reopen.md" "missing required field: Reopen Conditions"

good_task | grep -v '^- \*\*Protected Paths' > "$TMP/no-protected.md"
reject_contract "R3 without protected surface" "$TMP/no-protected.md" "is R3 and must declare"

good_task | sed 's/^- \*\*Depends On:\*\* None/- **Depends On:**/' > "$TMP/empty-conditional.md"
reject_contract "empty conditional field" "$TMP/empty-conditional.md" "declares Depends On with no value"

good_task | sed 's/^- \*\*Risk Level:\*\* R3/- **Risk Level:** high/' > "$TMP/no-risk.md"
reject_contract "unparsable risk level" "$TMP/no-risk.md" "no parsable Risk Level"

{ good_task; good_task | tail -n +2; } > "$TMP/duplicate.md"
reject_contract "duplicate task ID" "$TMP/duplicate.md" "duplicate task ID TASK-900"

# A task that changes a rendered surface needs stated visual criteria, or
# "modern UI" is the whole brief and review has nothing to measure. The trigger
# is the declared change surface, matching the delivery ledger's browser-evidence
# gate: paths decide, not the author's account of the work.
ui_task(){
  good_task | sed 's|^- \*\*Allowed Paths:\*\* `src/\*\*`|- **Allowed Paths:** `src/components/Card.tsx`|'
}
ui_task > "$TMP/ui-no-contract.md"
reject_contract "rendered surface without a visual contract" "$TMP/ui-no-contract.md" \
  "changes a rendered surface (.tsx) and must declare Visual Contract"

{ ui_task; echo '- **Visual Contract:** modern UI'; } > "$TMP/ui-placeholder.md"
reject_contract "a visual contract that cannot be failed" "$TMP/ui-placeholder.md" \
  "declares a placeholder Visual Contract"

{ ui_task; echo '- **Visual Contract:** Storefront PDP card; buyer scanning price; tokens from design-tokens.md; states loading/empty/error; rejects a centred hero'; } > "$TMP/ui-good.md"
contracts "$TMP/ui-good.md" >/dev/null || fail "a stated visual contract must satisfy the lint"

# The trigger must be the paths, not the risk level or the words in the title.
# Demanding a visual contract from backend work would train people to paste one
# in, which is the same failure as accepting "modern UI".
good_task > "$TMP/non-ui.md"
contracts "$TMP/non-ui.md" >/dev/null || fail "non-visual work must not be asked for a visual contract"

# Mutation proof: without the trigger the negative fixture passes.
python3 - "$LINT" "$TMP/ui-no-contract.md" <<'PY'
import importlib.util, sys, tempfile, pathlib
src = pathlib.Path(sys.argv[1]).read_text().replace(
    "rendered = [ext for ext in BROWSER_VISIBLE_SUFFIXES if ext in surface]",
    "rendered = []")
tmp = pathlib.Path(tempfile.mkstemp(suffix=".py")[1]); tmp.write_text(src)
spec = importlib.util.spec_from_file_location("pl", tmp)
mod = importlib.util.module_from_spec(spec); spec.loader.exec_module(mod)
body = pathlib.Path(sys.argv[2]).read_text()
if any("rendered surface" in p for p in mod.lint_task_contracts("T", body)):
    raise SystemExit("mutation still reported — the trigger is not what enforces this")
PY

# A fenced contract template is documentation, not a declared task.
{ printf '## Template\n\n```markdown\n'; good_task | tail -n +2 | grep -v '^- \*\*Non-Scope'; printf '```\n'; } > "$TMP/fenced.md"
contracts "$TMP/fenced.md" >/dev/null || fail "a fenced task template must not be linted as a declared task"

# An unclosed fence must be reported, not silently swallow every task below it.
{ printf '## Notes\n\n```\nstray\n'; good_task | tail -n +2 | grep -v '^- \*\*Non-Scope'; } > "$TMP/unclosed.md"
reject_contract "unclosed code fence" "$TMP/unclosed.md" "unclosed code fence"

# A task heading without the usual colon is still a task, not an invisible one.
good_task | sed 's/^### TASK-900: Well-formed implementation task/### TASK-900 — Well-formed implementation task/' \
  | grep -v '^- \*\*Non-Scope' > "$TMP/no-colon.md"
reject_contract "task heading without a colon" "$TMP/no-colon.md" "missing required field: Non-Scope"

# Markdown fences may be tildes, and an unclosed one hides just as much.
{ printf '## Notes\n\n~~~\nstray\n'; good_task | tail -n +2 | grep -v '^- \*\*Non-Scope'; } > "$TMP/unclosed-tilde.md"
reject_contract "unclosed tilde fence" "$TMP/unclosed-tilde.md" "unclosed code fence"
{ printf '## Template\n\n~~~markdown\n'; good_task | tail -n +2 | grep -v '^- \*\*Non-Scope'; printf '~~~\n'; } > "$TMP/fenced-tilde.md"
contracts "$TMP/fenced-tilde.md" >/dev/null || fail "a tilde-fenced task template must not be linted as a declared task"

MUT_FENCE="$TMP/mutant-fence-ai-policy-lint"
sed 's/    if fence_opened_at is not None:  # unbalanced-fence guard/    if False:  # unbalanced-fence guard/' "$LINT" > "$MUT_FENCE"
python3 "$MUT_FENCE" --task-contracts "$TMP/unclosed.md" >/dev/null \
  || fail "mutation probe did not neutralize the unbalanced-fence guard"

# Mutation proof: without the required-field loop the negative fixture passes.
MUT_LINT="$TMP/mutant-ai-policy-lint"
sed 's/for names in REQUIRED_TASK_FIELDS:  # required-field guard/for names in ():  # required-field guard/' "$LINT" > "$MUT_LINT"
chmod +x "$MUT_LINT"
python3 "$MUT_LINT" --task-contracts "$TMP/no-scope.md" >/dev/null \
  || fail "mutation probe did not neutralize the required-field guard"

# The template doc-presence check must be *derived* from REQUIRED_TASK_FIELDS,
# not a second hand-maintained list — otherwise a field added to one silently
# stops being required in the other. It also applies ONLY to
# config/templates/TASKS.md, never to root TASKS.md (a live task archiving the
# one entry that happened to use a given alias must not fail the lint over
# vocabulary root TASKS.md never promised to keep saying). Exercise
# check_templates() in isolation against a template that documents nothing,
# and confirm every current required-field obligation — including aliases and
# the newly-added Reopen Conditions — is what it demands, with EXACT field-name
# matching so "Escalation Conditions" cannot stand in for "Escalation
# Condition" (a prior version of this probe used substring matching and could
# not have caught that exact regression).
python3 - "$LINT" <<'PY'
import importlib.util
from importlib.machinery import SourceFileLoader
import pathlib
import sys
import tempfile

loader = SourceFileLoader("ai_policy_lint_probe", sys.argv[1])
spec = importlib.util.spec_from_loader(loader.name, loader)
mod = importlib.util.module_from_spec(spec)
loader.exec_module(mod)

MARKER = " missing task boundary field: "

with tempfile.TemporaryDirectory() as raw:
    tmp = pathlib.Path(raw)
    root = tmp / "root"
    templates = root / "config" / "templates"
    templates.mkdir(parents=True)
    (root / "TASKS.md").write_text("no fields here\n")
    (templates / "TASKS.md").write_text("no fields here\n")
    mod.ROOT, mod.TEMPLATES_DIR = root, templates
    mod.errors, mod.warnings = [], []
    mod.check_templates()
    # Attribute each error to its emitting file, not just its field name — a
    # prior version of this probe pooled field names across both files, so it
    # could not tell "the template was field-checked" from "root TASKS.md was
    # field-checked too", and its file-scoping assertion matched a label
    # ("root/TASKS.md ...") the code never actually emits, so it could never
    # fail even when the regression it names was reintroduced.
    by_file = {}
    for e in mod.errors:
        if MARKER not in e:
            continue
        label, field = e.split(MARKER, 1)
        by_file.setdefault(label, set()).add(field)
    template_label = str((templates / "TASKS.md").relative_to(root))
    root_label = str((root / "TASKS.md").relative_to(root))
    reported = by_file.get(template_label, set())
    expected = {name for names in mod.REQUIRED_TASK_FIELDS for name in names} | set(mod.PROTECTED_TASK_FIELD)
    missing = expected - reported
    assert not missing, f"check_templates did not derive from REQUIRED_TASK_FIELDS for: {missing}"
    assert "Reopen Conditions" in reported, "the newly-required field was not propagated to the template check"
    # Every alias spelling matters, not just the primary name: a template that
    # documents only "Allowed Paths" and never "Change Surface" must still fail.
    # Exact-match, so "Escalation Conditions" cannot satisfy "Escalation Condition".
    for alias in ("Change Surface", "Protected Surface", "Shared Owner", "Escalation Condition"):
        assert alias in reported, f"alias spelling {alias!r} was dropped from the template check"
    # Root TASKS.md's content must never be field-checked by this function —
    # only its existence. A root TASKS.md missing every field must not report
    # any "missing task boundary field" error attributed to it.
    assert root_label not in by_file, f"check_templates must not field-check root TASKS.md, but reported: {by_file.get(root_label)}"
print("template-binding probe: OK")
PY

# ── Ledger task binding ─────────────────────────────────────────────────────
# A run is evidence for a contract only if it names that contract's work.
# Matching on the id alone let another device's REQ-PUBLIC-UI-QUALITY run under
# TASK-074 mark an unrelated TASK-074 finished, which removed it from the queue
# without failing anything.
python3 - "$LINT" <<'PYLEDGER'
import importlib.machinery, importlib.util, json, pathlib, sys, tempfile

loader = importlib.machinery.SourceFileLoader("ledger_probe", sys.argv[1])
spec = importlib.util.spec_from_loader(loader.name, loader)
mod = importlib.util.module_from_spec(spec)
loader.exec_module(mod)


def run(tasks_md, runs, baseline=None):
    """Return the errors check_ledger_task_binding reports for a fixture."""
    with tempfile.TemporaryDirectory() as raw:
        root = pathlib.Path(raw)
        (root / "docs" / "archive").mkdir(parents=True)
        (root / "TASKS.md").write_text(tasks_md)
        rd = root / ".delivery" / "runs"
        rd.mkdir(parents=True)
        for name, events in runs.items():
            if isinstance(events, str):
                (rd / name).write_text(events)
            else:
                (rd / name).write_text("\n".join(json.dumps(e) for e in events) + "\n")
        mod.ROOT = root
        mod.errors, mod.warnings = [], []
        saved = mod.LEDGER_BINDING_BASELINE
        if baseline is not None:
            mod.LEDGER_BINDING_BASELINE = baseline
        try:
            mod.check_ledger_task_binding()
        finally:
            mod.LEDGER_BINDING_BASELINE = saved
        return mod.errors


CONTRACT = "### TASK-100: a contract\n- **Requirement:** REQ-MINE\n"
started = lambda task, req: {"type": "run_started", "task": task, "requirement": req}

# The defect itself: a run claims a declared id for other work.
errs = run(CONTRACT, {"RUN-foreign.jsonl": [started("TASK-100", "REQ-THEIRS")]})
assert errs, "a run naming a requirement the contract does not declare was accepted"
blob = "\n".join(errs)
assert "RUN-foreign.jsonl" in blob, f"the failure does not name the run: {blob}"
assert "TASK-100" in blob and "REQ-THEIRS" in blob and "REQ-MINE" in blob, \
    f"the failure does not name both sides: {blob}"

# Matching evidence is left alone.
assert not run(CONTRACT, {"RUN-ok.jsonl": [started("TASK-100", "REQ-MINE")]}), \
    "a run naming its own contract's requirement was reported"

# An id no record declares cannot mark a contract done. Fourteen such runs
# predate the REQ- convention; failing them would fail honest history.
assert not run(CONTRACT, {"RUN-old.jsonl": [started("TASK-999", "REQ-WHATEVER")]}), \
    "a run for an id no contract declares was reported"

# The baseline accepts named history and nothing else.
assert not run(CONTRACT, {"RUN-foreign.jsonl": [started("TASK-100", "REQ-THEIRS")]},
               baseline={"TASK-100": {"REQ-THEIRS"}}), "the baseline did not accept its own entry"
assert run(CONTRACT, {"RUN-other.jsonl": [started("TASK-100", "REQ-THIRD")]},
           baseline={"TASK-100": {"REQ-THEIRS"}}), \
    "the baseline accepted a requirement it does not name"

# A record whose requirement sits several lines below its heading still counts,
# so a contract is never treated as undeclared because of its layout.
spaced = "### TASK-100: a contract\n- **Risk Level:** R2\n- **Requirement:** REQ-MINE\n"
assert run(spaced, {"RUN-foreign.jsonl": [started("TASK-100", "REQ-THEIRS")]}), \
    "a requirement below other fields was not read, so the collision was missed"

# Not knowing is a third answer: an unreadable run is reported, never skipped.
errs = run(CONTRACT, {"RUN-broken.jsonl": "{not json\n"})
assert errs and "RUN-broken.jsonl" in "\n".join(errs), \
    "an unreadable run file was silently skipped"

# A repository with no ledger passes rather than erroring.
with tempfile.TemporaryDirectory() as raw:
    root = pathlib.Path(raw)
    (root / "docs" / "archive").mkdir(parents=True)
    (root / "TASKS.md").write_text(CONTRACT)
    mod.ROOT, mod.errors, mod.warnings = root, [], []
    mod.check_ledger_task_binding()
    assert not mod.errors, "a repository with no .delivery/runs was reported as broken"


# A record with no Requirement field must not borrow the next record's. The
# window used to be a flat 400 characters, so a second record for the same id —
# "- **TASK-100 (original)**", the shape the archive is full of — widened that
# id's declared set with its neighbour's requirement, and a foreign run then
# matched. That is the TASK-074 defect again, reached by field ordering.
BLEED = (
    "### TASK-100: a contract\n- **Requirement:** REQ-MINE\n\n"
    "- **TASK-100 (original)** superseded\n\n"
    "### TASK-101: neighbour\n- **Requirement:** REQ-NEIGHBOR\n"
)
borrowed = [r for t, r in mod.task_records(BLEED) if t == "TASK-100"]
assert "REQ-MINE" in borrowed, f"the fixture lost its own requirement: {borrowed}"
assert "REQ-NEIGHBOR" not in borrowed, \
    f"a record with no requirement borrowed the next record's: {borrowed}"
errs = run(BLEED, {"RUN-bleed.jsonl": [started("TASK-100", "REQ-NEIGHBOR")]})
assert errs, "a run carrying the NEIGHBOUR's requirement was accepted as evidence"

# A run naming no requirement cannot be bound to the contract it claims, and
# skipping it quietly is a free way around this entire check.
for empty in ({"type": "run_started", "task": "TASK-100"},
              {"type": "run_started", "task": "TASK-100", "requirement": None}):
    errs = run(CONTRACT, {"RUN-noreq.jsonl": [empty]})
    assert errs and "no requirement" in "\n".join(errs), \
        f"a run with no requirement was accepted against a declared contract: {errs}"


# A bold bullet that merely CROSS-REFERENCES another task is not a record, and
# must not bound the window of the contract it sits inside. Treating every regex
# hit as a boundary truncated a contract before its own Requirement field: the
# contract then declared nothing, became exempt, and a foreign run passed
# unnoticed — the same silent false completion, reached by ordinary prose.
CROSSREF = (
    "### TASK-100: mentions another task first\n"
    "- **Risk Level:** R2\n"
    "- **TASK-050 remains blocked pending this work; tracked separately.**\n"
    "- **Requirement:** REQ-MINE\n"
)
assert dict(mod.task_records(CROSSREF)).get("TASK-100") == "REQ-MINE", \
    f"a bold cross-reference truncated the contract's own window: {list(mod.task_records(CROSSREF))}"
errs = run(CROSSREF, {"RUN-foreign.jsonl": [started("TASK-100", "REQ-UNRELATED")]})
assert errs, "a contract whose window was truncated became exempt and took a foreign run"

# An explicit Requirement FIELD outranks a requirement named in passing before
# it, so prose cannot quietly redefine what a contract declares.
INPASSING = (
    "### TASK-100: names another requirement in passing\n"
    "- **Runtime Evidence:** supersedes the REQ-OLD work.\n"
    "- **Requirement:** REQ-MINE\n"
)
assert dict(mod.task_records(INPASSING)).get("TASK-100") == "REQ-MINE", \
    f"a requirement mentioned in passing displaced the declared field: {list(mod.task_records(INPASSING))}"

# A bullet record still carries its requirement inline, with no field to find.
assert dict(mod.task_records("- **TASK-100 / REQ-INLINE — done.**\n")).get("TASK-100") == "REQ-INLINE", \
    "a bullet record lost its inline requirement when the field rule was added"

print("ledger-binding probe: OK")
PYLEDGER

echo "ai-policy-lint-test: ledger task binding PASS"


echo "ai-policy-lint-test: task contracts PASS"


# Capability policy permits arbitrary model/provider names but preserves the
# separate-review and explicit-approval clauses.
python3 - "$LINT" "$ROOT/config/ai/AGENTS.md" "$TMP" <<'PYTEST'
import importlib.machinery, importlib.util, sys
from pathlib import Path
loader = importlib.machinery.SourceFileLoader("policy_fixture", sys.argv[1])
spec = importlib.util.spec_from_loader(loader.name, loader)
mod = importlib.util.module_from_spec(spec)
loader.exec_module(mod)
fixture = Path(sys.argv[3]) / "policy-fixture"
fixture.mkdir()
mod.AI_DIR = fixture
source = Path(sys.argv[2]).read_text()
for suffix in ("", "\nPreferred runtime model: arbitrary-vendor/arbitrary-model.\n"):
    (fixture / "AGENTS.md").write_text(source + suffix)
    mod.errors.clear()
    mod.check_agents_policy()
    assert not mod.errors, mod.errors
for clause in ("Route by capability:", "Use any available capable model/provider", "separate actual agent", "Product, scope, secrets and live-operation approvals remain."):
    (fixture / "AGENTS.md").write_text(source.replace(clause, "removed-policy-fixture"))
    mod.errors.clear()
    mod.check_agents_policy()
    assert mod.errors, f"missing capability policy was accepted: {clause}"
print("model-agnostic policy fixtures: PASS")
PYTEST

# ── Task-number uniqueness (TASK-070) ────────────────────────────────────────
# Two devices allocate numbers with nothing coordinating them, and twice they
# picked the same one. Each fixture here is a shape the check must tell apart,
# because a version that reported every repeat would be noise and get ignored.
python3 - "$ROOT" <<'PYTASK'
import importlib.machinery, importlib.util, pathlib, sys, tempfile

root = pathlib.Path(sys.argv[1])
loader = importlib.machinery.SourceFileLoader("lint", str(root / "bin" / "ai-policy-lint"))
spec = importlib.util.spec_from_loader("lint", loader)
mod = importlib.util.module_from_spec(spec)
loader.exec_module(mod)

def run(tasks_md, archive=None, baseline=None):
    with tempfile.TemporaryDirectory() as d:
        r = pathlib.Path(d)
        (r / "docs" / "archive").mkdir(parents=True)
        (r / "TASKS.md").write_text(tasks_md)
        for name, text in (archive or {}).items():
            (r / "docs" / "archive" / name).write_text(text)
        old_root, old_base = mod.ROOT, mod.TASK_ID_BASELINE
        mod.ROOT = r
        if baseline is not None:
            mod.TASK_ID_BASELINE = baseline
        mod.errors = []
        try:
            mod.check_task_id_uniqueness()
            return list(mod.errors)
        finally:
            mod.ROOT, mod.TASK_ID_BASELINE = old_root, old_base

C = "### TASK-{n}: Title\n- **Requirement:** {req}\n- **Risk Level:** R1\n\n"
B = "- **TASK-{n} / {req} (R1).** Done.\n\n"

# 1. One number, two requirements: the defect this exists for.
e = run(C.format(n="900", req="REQ-ONE") + C.format(n="900", req="REQ-TWO"), baseline={})
assert e and "TASK-900" in e[0] and "REQ-ONE" in e[0] and "REQ-TWO" in e[0], e
assert "carries 2 requirements" in e[0], e

# 2. A contract and its own completion entry under one requirement: eight of the
#    ten repeats on disk are this, and flagging them would have sunk the check.
assert not run(C.format(n="901", req="REQ-SAME") + B.format(n="901", req="REQ-SAME"), baseline={})

# 3. A number used once with no readable requirement hides nothing. Twelve
#    records predate the REQ- convention and must not fail the repository.
assert not run("### TASK-902: Older than the convention\n\nNo requirement line.\n", baseline={})

# 4. A blank record in ANOTHER file, beside a readable one, could be hiding a
#    second requirement — that is the case worth failing on.
e = run(C.format(n="903", req="REQ-REAL"),
        {"old.md": "### TASK-903: Same number, no requirement\n\nprose\n"}, baseline={})
assert e and "TASK-903" in e[0] and "no readable requirement" in e[0], e

# 5. Two blank records inside ONE file are one entry continued, as TASK-052 is.
assert not run(B.format(n="904", req="REQ-X") + "- **TASK-904 (original).** Earlier wording.\n",
               baseline={})

# 6. Prose about a task is not a record. "## TASK-015 decisions" in a build log
#    made the first version report three hazards that were only its own
#    definition being too loose.
assert not run("### TASK-905: Real\n- **Requirement:** REQ-R\n",
               {"log.md": "## TASK-905 decisions\n\nnotes\n"}, baseline={})

# 7. The baseline accepts exactly its own pair and nothing wider.
pair = C.format(n="906", req="REQ-A") + C.format(n="906", req="REQ-B")
assert not run(pair, baseline={"TASK-906": {"REQ-A", "REQ-B"}})
assert run(pair + C.format(n="906", req="REQ-C"), baseline={"TASK-906": {"REQ-A", "REQ-B"}})

# 8. And the real repository's two collisions must fail without it, or the
#    baseline is decoration rather than a deliberate exemption.
real = (root / "TASKS.md").read_text()
arch = {f.name: f.read_text() for f in (root / "docs" / "archive").glob("*.md")}
assert run(real, arch, baseline={}), "the recorded collisions do not fail without the baseline"
assert not run(real, arch), "the repository does not pass with its own baseline"

