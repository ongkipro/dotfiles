#!/usr/bin/env python3
"""ai-memory-access - route memory and record privacy-minimal local usage telemetry."""
from __future__ import annotations
import argparse, json, os, subprocess, sys, tempfile
from datetime import datetime, timezone
from pathlib import Path


def now(): return datetime.now(timezone.utc).isoformat(timespec='seconds').replace('+00:00','Z')
def atomic_json(path: Path, data: dict):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd,tmp=tempfile.mkstemp(prefix='.'+path.name+'.',dir=path.parent)
    try:
        with os.fdopen(fd,'w',encoding='utf-8') as f:
            json.dump(data,f,indent=2,sort_keys=True); f.write('\n'); f.flush(); os.fsync(f.fileno())
        os.replace(tmp,path)
    finally:
        if os.path.exists(tmp): os.unlink(tmp)

def append_jsonl(path: Path, data: dict):
    path.parent.mkdir(parents=True,exist_ok=True)
    with path.open('a',encoding='utf-8') as f:
        f.write(json.dumps(data,sort_keys=True,separators=(',',':'),ensure_ascii=True)+'\n'); f.flush(); os.fsync(f.fileno())
    os.chmod(path,0o600)

def main():
    p=argparse.ArgumentParser(); p.add_argument('query'); p.add_argument('--repo'); p.add_argument('--project'); p.add_argument('--scope',choices=['auto','shared','project','execution','lesson'],default='auto'); p.add_argument('--max-files',type=int); p.add_argument('--max-bytes',type=int); p.add_argument('--telemetry-dir'); p.add_argument('--dotfiles'); p.add_argument('--json',action='store_true')
    a=p.parse_args(); dot=Path(a.dotfiles or os.environ.get('DOTFILES_DIR',Path(__file__).resolve().parent.parent)).resolve(); router=dot/'bin'/'ai-memory-route'
    telemetry=Path(a.telemetry_dir or os.environ.get('AI_MEMORY_USAGE_DIR',Path.home()/'.config/ai-local/memory-usage')).expanduser().resolve()
    try:
        cmd=['python3',str(router),a.query,'--scope',a.scope,'--json']
        if a.repo: cmd += ['--repo',a.repo]
        if a.project: cmd += ['--project',a.project]
        if a.max_files is not None: cmd += ['--max-files',str(a.max_files)]
        if a.max_bytes is not None: cmd += ['--max-bytes',str(a.max_bytes)]
        r=subprocess.run(cmd,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,check=False)
        if r.returncode != 0: raise ValueError(r.stderr.strip() or 'memory router failed')
        result=json.loads(r.stdout)
        telemetry.mkdir(parents=True,exist_ok=True); os.chmod(telemetry,0o700)
        meta=telemetry/'meta.json'
        if not meta.exists(): atomic_json(meta,{'schemaVersion':1,'startedAt':now(),'privacy':'selected durable-memory paths only; prompts, prompt hashes, and memory content are not stored'})
        selected=[]
        for item in result.get('files',[]):
            if item.get('scope') not in {'shared','project','lesson'}: continue
            path=Path(item['path']).resolve()
            try: rel=path.relative_to(dot).as_posix()
            except ValueError: continue
            selected.append({'path':rel,'scope':item.get('scope'),'bytes':item.get('bytes')})
        append_jsonl(telemetry/'events.jsonl',{'schemaVersion':1,'time':now(),'project':result.get('project'),'selected':selected})
        if a.json: print(json.dumps(result,indent=2))
        elif not result.get('needed'): print('ai-memory-access: NONE')
        else:
            print(f"ai-memory-access: {len(result.get('files',[]))} routed file(s); {len(selected)} durable memory use(s) recorded")
            for item in result.get('files',[]): print(f"  {item.get('scope'):9} {item.get('path')}")
        return 0
    except (OSError,ValueError,json.JSONDecodeError) as e:
        print(f'ai-memory-access: ERROR: {e}',file=sys.stderr); return 1
if __name__=='__main__': raise SystemExit(main())
