#!/usr/bin/env python3
"""ai-memory-access - route memory and record privacy-minimal local usage telemetry."""
from __future__ import annotations
import argparse, json, os, stat, subprocess, sys
import fcntl
from datetime import datetime, timezone
from pathlib import Path


def now(): return datetime.now(timezone.utc).isoformat(timespec='seconds').replace('+00:00','Z')
def telemetry_directory(path: Path):
    """Walk with directory descriptors so a replaced parent cannot redirect I/O."""
    # macOS exposes its system temp roots through root-owned /tmp and /var
    # aliases. Canonicalize only those exact OS aliases, never user parents.
    if sys.platform == 'darwin' and len(path.parts) > 1 and path.parts[1] in {'tmp', 'var'}:
        alias = Path('/') / path.parts[1]
        if alias.is_symlink() and alias.lstat().st_uid == 0 and os.readlink(alias) in {f'private/{path.parts[1]}', f'/private/{path.parts[1]}'}:
            path = Path('/private') / path.relative_to('/')
    fd = os.open(path.anchor, os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in path.parts[1:]:
            if part in {".", ".."}: raise ValueError("telemetry path must not traverse parents")
            try: os.mkdir(part, mode=0o700, dir_fd=fd)
            except FileExistsError: pass
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd); fd = child
            info = os.fstat(fd)
            if info.st_uid not in {0, os.getuid()} or (info.st_mode & 0o022 and not info.st_mode & stat.S_ISVTX):
                raise ValueError("unsafe telemetry parent ownership or permissions")
        info = os.fstat(fd)
        if info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ValueError("telemetry directory must be owned by this user and private (0700)")
        return fd
    except Exception:
        os.close(fd)
        raise


def telemetry_file(directory, name, data, append=False):
    flags = os.O_WRONLY | os.O_NOFOLLOW | os.O_NONBLOCK
    if append: flags |= os.O_APPEND
    # macOS openat's create-or-open path can report ENOENT when writers race
    # the first creation. Exclusive creation and a plain existing-file open
    # avoid that path without retries or following a substituted link.
    try: fd = os.open(name, flags | os.O_CREAT | os.O_EXCL, 0o600, dir_fd=directory)
    except FileExistsError:
        if append:
            fd = os.open(name, flags, dir_fd=directory)
        else:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
            try: validate_telemetry_file(fd)
            finally: os.close(fd)
            return
    try:
        validate_telemetry_file(fd)
        fcntl.flock(fd, fcntl.LOCK_EX)
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, 'w', encoding='utf-8', closefd=False) as stream:
            stream.write(json.dumps(data, sort_keys=True, separators=(',', ':'), ensure_ascii=True) + '\n')
            stream.flush(); os.fsync(fd)
    finally: os.close(fd)


def validate_telemetry_file(fd):
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.getuid():
        raise ValueError("telemetry file must be owned by this user, regular, and not hardlinked")

def main():
    p=argparse.ArgumentParser(
        description='Route memory and record device-local usage telemetry. Telemetry stores the project and selected durable-memory path, scope, and byte count; it never stores query text, query hashes, or memory content.'
    )
    p.add_argument('query',help='routing query passed to ai-memory-route but not retained in telemetry')
    p.add_argument('--repo')
    p.add_argument('--project')
    p.add_argument('--scope',choices=['auto','shared','project','execution','lesson'],default='auto')
    p.add_argument('--max-files',type=int)
    p.add_argument('--max-bytes',type=int)
    p.add_argument('--telemetry-dir')
    p.add_argument('--dotfiles')
    p.add_argument('--json',action='store_true')
    a=p.parse_args(); dot=Path(a.dotfiles or os.environ.get('DOTFILES_DIR',Path(__file__).resolve().parent.parent)).resolve(); router=dot/'bin'/'ai-memory-route'
    telemetry=Path(a.telemetry_dir or os.environ.get('AI_MEMORY_USAGE_DIR',Path.home()/'.config/ai-local/memory-usage')).expanduser().absolute()
    try:
        cmd=['python3',str(router),a.query,'--scope',a.scope,'--json']
        if a.repo: cmd += ['--repo',a.repo]
        if a.project: cmd += ['--project',a.project]
        if a.max_files is not None: cmd += ['--max-files',str(a.max_files)]
        if a.max_bytes is not None: cmd += ['--max-bytes',str(a.max_bytes)]
        r=subprocess.run(cmd,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,check=False)
        if r.returncode != 0: raise ValueError(r.stderr.strip() or 'memory router failed')
        result=json.loads(r.stdout)
        selected=[]
        for item in result.get('files',[]):
            if item.get('scope') not in {'shared','project','lesson'}: continue
            path=Path(item['path']).resolve()
            try: rel=path.relative_to(dot).as_posix()
            except ValueError: continue
            selected.append({'path':rel,'scope':item.get('scope'),'bytes':item.get('bytes')})
        directory = telemetry_directory(telemetry)
        try:
            telemetry_file(directory, 'meta.json', {'schemaVersion':1,'startedAt':now(),'privacy':'selected durable-memory paths only; query text, query hashes, and memory content are not stored'})
            telemetry_file(directory, 'events.jsonl', {'schemaVersion':1,'time':now(),'project':result.get('project'),'selected':selected}, append=True)
        finally: os.close(directory)
        if a.json: print(json.dumps(result,indent=2))
        else:
            if not result.get('needed'): print('ai-memory-routing: no files selected for this request.')
            else:
                print(f"ai-memory-routing: {len(result.get('files',[]))} file(s) selected; {len(selected)} durable memory use(s) recorded")
                for item in result.get('files',[]): print(f"  {item.get('scope'):9} {item.get('path')}")
            print('Context selection is advisory; it does not grant or deny memory access.')
        return 0
    except (OSError,ValueError,json.JSONDecodeError) as e:
        print(f'ai-memory-access: ERROR: {e}',file=sys.stderr); return 1
if __name__=='__main__': raise SystemExit(main())
