#!/usr/bin/env bash
# Regression test for the backup-before-link helpers used by the installers.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/installer-link-test.XXXXXX")"
trap 'chmod -R u+w "$TMP" 2>/dev/null || true; rm -rf "$TMP"' EXIT

extract_function() {
  local file="$1" name="$2"
  awk -v signature="$name() {" '
    $0 == signature { inside = 1 }
    inside { print }
    inside && $0 == "}" { exit }
  ' "$file"
}

test_helper() {
  local file="$1" name="$2"
  local case_dir="$TMP/$(basename "$file").$name"
  local function_code
  function_code="$(extract_function "$file" "$name")"
  [ -n "$function_code" ] || { echo "missing $name in $file" >&2; return 1; }

  mkdir -p "$case_dir"
  (
    say() { :; }
    eval "$function_code"

    src="$case_dir/source"
    dst="$case_dir/live/item"
    mkdir -p "$(dirname "$dst")"
    printf 'tracked\n' > "$src"

    "$name" "$src" "$dst" >/dev/null
    [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]

    "$name" "$src" "$dst" >/dev/null
    [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]

    unlink "$dst"
    printf 'original\n' > "$dst"
    "$name" "$src" "$dst" >/dev/null
    [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]
    backup="$(find "$(dirname "$dst")" -maxdepth 1 -type f -name 'item.bak.*' -print -quit)"
    [ -n "$backup" ] && [ "$(cat "$backup")" = "original" ]

    other="$case_dir/other"
    printf 'other\n' > "$other"
    unlink "$dst"
    ln -s "$other" "$dst"
    "$name" "$src" "$dst" >/dev/null
    [ "$(readlink "$dst")" = "$src" ] && [ "$(cat "$other")" = "other" ]
  )

  printf '✓ %s:%s\n' "$(basename "$file")" "$name"
}

test_shell_source_migration() {
  local function_code
  function_code="$(extract_function "$ROOT/install.sh" ensure_shell_source)"
  [ -n "$function_code" ] || { echo "missing ensure_shell_source in install.sh" >&2; return 1; }

  (
    eval "$function_code"
    rc="$TMP/shell-source.rc"
    cat > "$rc" <<'EOF'
before
# >>> dev-tools setup (ongkipro/dotfiles) >>>
old managed content
# <<< dev-tools setup (ongkipro/dotfiles) <<<
old trailing content
[ -f /mnt/c/Users/Asus/win-debloat.ps1 ] && alias win-debloat='legacy'
after
EOF

    ensure_shell_source \
      "$rc" \
      "shell-tools.sh" \
      "dev-tools setup (ongkipro/dotfiles)" \
      "[ -f /mnt/c/Users/Asus/win-debloat.ps1 ]" >/dev/null

    source_line='source "$HOME/dotfiles/config/shell-tools.sh"'
    grep -qxF "before" "$rc"
    grep -qxF "after" "$rc"
    grep -qxF "$source_line" "$rc"
    [ "$(grep -cxF "$source_line" "$rc")" -eq 1 ]
    ! grep -qF "old managed content" "$rc"
    ! grep -qF "old trailing content" "$rc"
    [ "$(find "$TMP" -maxdepth 1 -type f -name 'shell-source.rc.bak.*' | wc -l)" -eq 1 ]

    first="$(cksum "$rc")"
    ensure_shell_source \
      "$rc" \
      "shell-tools.sh" \
      "dev-tools setup (ongkipro/dotfiles)" \
      "[ -f /mnt/c/Users/Asus/win-debloat.ps1 ]" >/dev/null
    [ "$first" = "$(cksum "$rc")" ]
    [ "$(find "$TMP" -maxdepth 1 -type f -name 'shell-source.rc.bak.*' | wc -l)" -eq 1 ]

    printf '%s\n' "$source_line" >> "$rc"
    [ "$(grep -cxF "$source_line" "$rc")" -eq 2 ]
    ensure_shell_source \
      "$rc" \
      "shell-tools.sh" \
      "dev-tools setup (ongkipro/dotfiles)" \
      "[ -f /mnt/c/Users/Asus/win-debloat.ps1 ]" >/dev/null
    [ "$(grep -cxF "$source_line" "$rc")" -eq 1 ]
    [ "$(find "$TMP" -maxdepth 1 -type f -name 'shell-source.rc.bak.*' | wc -l)" -eq 2 ]

    bad="$TMP/malformed-shell.rc"
    printf 'keep\n# >>> broken block >>>\n' > "$bad"
    before="$(cksum "$bad")"
    ! ensure_shell_source "$bad" "broken.sh" "broken block" >/dev/null 2>&1
    [ "$before" = "$(cksum "$bad")" ]
  )

  echo "✓ install.sh:ensure_shell_source"
}

test_helper "$ROOT/install.sh" link
test_helper "$ROOT/install-macos.sh" link
test_helper "$ROOT/bin/tmux-setup" link_to_repo
test_shell_source_migration
echo "installer-link-test: OK"
