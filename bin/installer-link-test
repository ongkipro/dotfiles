#!/usr/bin/env bash
# Regression test for the backup-before-link helpers used by the installers.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/installer-link-test.XXXXXX")"
trap 'chmod -R u+w "$TMP" 2>/dev/null || true; find "$TMP" -depth -delete 2>/dev/null || true' EXIT

extract_function() {
  local file="$1" name="$2"
  awk -v signature="$name() {" '
    $0 == signature { inside = 1 }
    inside { print }
    inside && $0 == "}" { exit }
  ' "$file"
}

test_helper() {
  local file="$1" name="$2"
  local case_dir="$TMP/$(basename "$file").$name"
  local function_code
  function_code="$(extract_function "$file" "$name")"
  [ -n "$function_code" ] || { echo "missing $name in $file" >&2; return 1; }

  mkdir -p "$case_dir"
  (
    say() { :; }
    eval "$function_code"

    src="$case_dir/source"
    dst="$case_dir/live/item"
    mkdir -p "$(dirname "$dst")"
    printf 'tracked\n' > "$src"

    "$name" "$src" "$dst" >/dev/null
    [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]

    "$name" "$src" "$dst" >/dev/null
    [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]

    unlink "$dst"
    printf 'original\n' > "$dst"
    "$name" "$src" "$dst" >/dev/null
    [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]
    backup="$(find "$(dirname "$dst")" -maxdepth 1 -type f -name 'item.bak.*' -print -quit)"
    [ -n "$backup" ] && [ "$(cat "$backup")" = "original" ]

    other="$case_dir/other"
    printf 'other\n' > "$other"
    unlink "$dst"
    ln -s "$other" "$dst"
    "$name" "$src" "$dst" >/dev/null
    [ "$(readlink "$dst")" = "$src" ] && [ "$(cat "$other")" = "other" ]
  )

  printf '✓ %s:%s\n' "$(basename "$file")" "$name"
}

test_shell_source_migration() {
  local function_code
  function_code="$(extract_function "$ROOT/install.sh" ensure_shell_source)"
  [ -n "$function_code" ] || { echo "missing ensure_shell_source in install.sh" >&2; return 1; }

  (
    eval "$function_code"
    rc="$TMP/shell-source.rc"
    cat > "$rc" <<'EOF'
before
# >>> dev-tools setup (ongkipro/dotfiles) >>>
old managed content
# <<< dev-tools setup (ongkipro/dotfiles) <<<
old trailing content
[ -f /mnt/c/Users/Asus/win-debloat.ps1 ] && alias win-debloat='legacy'
after
EOF

    ensure_shell_source \
      "$rc" \
      "shell-tools.sh" \
      "dev-tools setup (ongkipro/dotfiles)" \
      "[ -f /mnt/c/Users/Asus/win-debloat.ps1 ]" >/dev/null

    source_line='source "$HOME/dotfiles/config/shell-tools.sh"'
    grep -qxF "before" "$rc"
    grep -qxF "after" "$rc"
    grep -qxF "$source_line" "$rc"
    [ "$(grep -cxF "$source_line" "$rc")" -eq 1 ]
    ! grep -qF "old managed content" "$rc"
    ! grep -qF "old trailing content" "$rc"
    [ "$(find "$TMP" -maxdepth 1 -type f -name 'shell-source.rc.bak.*' | wc -l)" -eq 1 ]

    first="$(cksum "$rc")"
    ensure_shell_source \
      "$rc" \
      "shell-tools.sh" \
      "dev-tools setup (ongkipro/dotfiles)" \
      "[ -f /mnt/c/Users/Asus/win-debloat.ps1 ]" >/dev/null
    [ "$first" = "$(cksum "$rc")" ]
    [ "$(find "$TMP" -maxdepth 1 -type f -name 'shell-source.rc.bak.*' | wc -l)" -eq 1 ]

    printf '%s\n' "$source_line" >> "$rc"
    [ "$(grep -cxF "$source_line" "$rc")" -eq 2 ]
    ensure_shell_source \
      "$rc" \
      "shell-tools.sh" \
      "dev-tools setup (ongkipro/dotfiles)" \
      "[ -f /mnt/c/Users/Asus/win-debloat.ps1 ]" >/dev/null
    [ "$(grep -cxF "$source_line" "$rc")" -eq 1 ]
    [ "$(find "$TMP" -maxdepth 1 -type f -name 'shell-source.rc.bak.*' | wc -l)" -eq 2 ]

    bad="$TMP/malformed-shell.rc"
    printf 'keep\n# >>> broken block >>>\n' > "$bad"
    before="$(cksum "$bad")"
    ! ensure_shell_source "$bad" "broken.sh" "broken block" >/dev/null 2>&1
    [ "$before" = "$(cksum "$bad")" ]
  )

  echo "✓ install.sh:ensure_shell_source"
}
test_macos_shell_source_migration() {
  local function_code
  function_code="$(extract_function "$ROOT/install-macos.sh" ensure_shell_source)"
  [ -n "$function_code" ] || { echo "missing ensure_shell_source in install-macos.sh" >&2; return 1; }

  (
    eval "$function_code"
    say() { :; }
    rc="$TMP/macos-zshrc"
    cat > "$rc" <<'EOF'
# >>> dev-tools setup (ongkipro/dotfiles) >>>  (marker — legacy suffix)
legacy managed content
command -v starship >/dev/null && eval "$(starship init zsh)"
source "$HOME/dotfiles/config/zshrc.tools.sh"
command -v omp >/dev/null 2>&1 && eval "$(omp completions zsh)"
eval "$($HOME/.local/bin/mise activate zsh)"
export PATH="$HOME/.local/bin:$HOME/.agents/bin:$PATH"
# user setup
export KEEP_ME=yes
EOF

    ensure_shell_source \
      "$rc" \
      "zshrc.tools.sh" \
      "dev-tools setup (ongkipro/dotfiles)" \
      'command -v starship >/dev/null && eval "$(starship init zsh)"' >/dev/null

    source_line='source "$HOME/dotfiles/config/zshrc.tools.sh"'
    [ "$(grep -cxF "$source_line" "$rc")" -eq 1 ]
    grep -qxF "# user setup" "$rc"
    grep -qxF "export KEEP_ME=yes" "$rc"
    ! grep -qF "legacy managed content" "$rc"
    ! grep -qF "omp completions zsh" "$rc"
    ! grep -qF "mise activate zsh" "$rc"
    [ "$(find "$TMP" -maxdepth 1 -type f -name 'macos-zshrc.bak.*' | wc -l)" -eq 1 ]

    first="$(cksum "$rc")"
    ensure_shell_source \
      "$rc" \
      "zshrc.tools.sh" \
      "dev-tools setup (ongkipro/dotfiles)" \
      'command -v starship >/dev/null && eval "$(starship init zsh)"' >/dev/null
    [ "$first" = "$(cksum "$rc")" ]
    [ "$(find "$TMP" -maxdepth 1 -type f -name 'macos-zshrc.bak.*' | wc -l)" -eq 1 ]
  )

  echo "✓ install-macos.sh:ensure_shell_source"
}

test_mise_tool_check() {
  local function_code
  function_code="$(extract_function "$ROOT/install-macos.sh" ensure_mise_tool)"
  [ -n "$function_code" ] || { echo "missing ensure_mise_tool in install-macos.sh" >&2; return 1; }

  (
    eval "$function_code"
    action=""
    say() { :; }
    mise() {
      case "$1" in
        which) [ "$2" = "hx" ] ;;
        use) action="$*" ;;
      esac
    }

    ensure_mise_tool helix hx >/dev/null
    [ -z "$action" ]
    ensure_mise_tool starship starship >/dev/null
    [ "$action" = "use -g starship" ]
  )

  echo "✓ install-macos.sh:ensure_mise_tool"
}
test_mise_absent_branch() {
  local function_code output empty_path
  function_code="$(extract_function "$ROOT/install-macos.sh" install_mise_tools)"
  [ -n "$function_code" ] || { echo "missing install_mise_tools in install-macos.sh" >&2; return 1; }

  empty_path="$TMP/no-mise-bin"
  mkdir -p "$empty_path"
  (
    eval "$function_code"
    say() { :; }
    ensure_mise_tool() { echo "ensure_mise_tool must not run without mise" >&2; return 1; }
    output="$(PATH="$empty_path" install_mise_tools)"
    grep -qF 'mise belum ada' <<< "$output"
    grep -qF 'curl -fsSL https://mise.run | sh' <<< "$output"
  )

  echo "✓ install-macos.sh:mise-absent"
}
test_mise_discovered_path() {
  local function_code fake_bin log
  function_code="$(extract_function "$ROOT/install-macos.sh" install_mise_tools)"
  [ -n "$function_code" ] || { echo "missing install_mise_tools in install-macos.sh" >&2; return 1; }

  fake_bin="$TMP/discovered mise bin"
  log="$TMP/discovered-mise.log"
  mkdir -p "$fake_bin" "$TMP/discovered mise home"
  cat > "$fake_bin/mise" <<EOF
#!/usr/bin/env bash
printf '%s\n' "\$*" >> "$log"
case "\${1:-}" in
  --version) printf '%s\n' 'mise test-version' ;;
  activate) : ;;
esac
EOF
  chmod +x "$fake_bin/mise"

  (
    eval "$function_code"
    say() { :; }
    ensure_mise_tool() { :; }
    HOME="$TMP/discovered mise home" PATH="$fake_bin:/usr/bin:/bin" install_mise_tools
  )

  grep -qxF -- '--version' "$log"
  grep -qxF 'activate bash' "$log"
  echo "✓ install-macos.sh:mise-discovered-path"
}

test_retire_omp_overrides() {
  local file="$1" function_code case_dir name live tracked other
  function_code="$(extract_function "$file" retire_omp_overrides)"
  [ -n "$function_code" ] || { echo "missing retire_omp_overrides in $file" >&2; return 1; }
  case_dir="$TMP/$(basename "$file").omp-native"
  mkdir -p "$case_dir/home/.omp/agent" "$case_dir/dotfiles/config/omp"

  (
    HOME="$case_dir/home"
    DOT="$case_dir/dotfiles"
    say() { :; }
    eval "$function_code"

    for name in config.yml models.yml agents; do
      tracked="$DOT/config/omp/$name"
      live="$HOME/.omp/agent/$name"
      mkdir -p "$(dirname "$tracked")"
      : > "$tracked"
      ln -s "$tracked" "$live"
    done
    retire_omp_overrides >/dev/null
    for name in config.yml models.yml agents; do
      [ ! -e "$HOME/.omp/agent/$name" ] && [ ! -L "$HOME/.omp/agent/$name" ]
    done

    printf 'runtime-owned\n' > "$HOME/.omp/agent/config.yml"
    other="$case_dir/unmanaged-models.yml"
    printf 'unmanaged\n' > "$other"
    ln -s "$other" "$HOME/.omp/agent/models.yml"
    mkdir "$HOME/.omp/agent/agents"
    retire_omp_overrides >/dev/null
    [ "$(cat "$HOME/.omp/agent/config.yml")" = runtime-owned ]
    [ "$(readlink "$HOME/.omp/agent/models.yml")" = "$other" ]
    [ -d "$HOME/.omp/agent/agents" ]
  )

  printf '✓ %s:retire_omp_overrides\n' "$(basename "$file")"
}

# The switcher stubs on `Fantastico` were REAL files, not links into $DOT/bin, so the
# installers' symlink prune could never have reached them. Pin both halves: the retired
# stub goes, and a same-named script the user wrote themselves stays.
test_retire_claude_account_profiles() {
  local file="$1" function_code case_dir
  function_code="$(extract_function "$file" retire_claude_account_profiles)"
  [ -n "$function_code" ] || { echo "missing retire_claude_account_profiles in $file" >&2; return 1; }
  case_dir="$TMP/$(basename "$file").claude-accounts"
  mkdir -p "$case_dir/home/.local/bin" "$case_dir/home/.claude/commands"

  (
    HOME="$case_dir/home"
    say() { :; }
    eval "$function_code"

    # retired stubs (real files) and the /akun command are removed
    printf '#!/usr/bin/env bash\nexec akun kerja "$@"\n'     > "$HOME/.local/bin/claude-kerja"
    printf '#!/usr/bin/env bash\nexec akun personal "$@"\n'  > "$HOME/.local/bin/claude-personal"
    printf -- '---\ndescription: x\n---\n!`akun open $ARGUMENTS`\n' > "$HOME/.claude/commands/akun.md"
    retire_claude_account_profiles >/dev/null
    [ ! -e "$HOME/.local/bin/claude-kerja" ]
    [ ! -e "$HOME/.local/bin/claude-personal" ]
    [ ! -e "$HOME/.claude/commands/akun.md" ]

    # a user-authored script at the same path is NOT deleted
    printf '#!/usr/bin/env bash\necho mine\n' > "$HOME/.local/bin/claude-kerja"
    retire_claude_account_profiles >/dev/null
    [ "$(cat "$HOME/.local/bin/claude-kerja")" = "$(printf '#!/usr/bin/env bash\necho mine')" ]
    rm -f "$HOME/.local/bin/claude-kerja"

    # a surviving profile directory is reported, never deleted
    mkdir -p "$HOME/.claude-accounts/personal"
    printf 'transcript\n' > "$HOME/.claude-accounts/personal/history.jsonl"
    retire_claude_account_profiles >/dev/null
    [ -f "$HOME/.claude-accounts/personal/history.jsonl" ]
  )

  printf '✓ %s:retire_claude_account_profiles\n' "$(basename "$file")"
}

test_runtime_command_manifest() {
  local manifest="$ROOT/config/ai/runtime-commands.txt" command_name
  [ -f "$manifest" ] || { echo "missing runtime command manifest" >&2; return 1; }
  while IFS= read -r command_name; do
    case "$command_name" in ""|\#*) continue ;; esac
    [ -x "$ROOT/bin/$command_name" ] || {
      echo "manifest command is missing or not executable: $command_name" >&2
      return 1
    }
  done < "$manifest"
  for command_name in ai-memory-access ai-memory-harvest ai-memory-hygiene ai-memory-lifecycle ai-memory-route ai-skill-evolution delivery-benchmark delivery-learning delivery-ledger delivery-skill-usage migration-risk production-gate release-check release-manifest rollback-check; do
    grep -qxF "$command_name" "$manifest" || {
      echo "public command missing from manifest: $command_name" >&2
      return 1
    }
  done
  grep -qF 'runtime-commands.txt' "$ROOT/install.sh"
  grep -qF 'runtime-commands.txt' "$ROOT/install-macos.sh"
  for installer in "$ROOT/install.sh" "$ROOT/install-macos.sh"; do
    ! grep -qF 'link "$DOT/config/omp/config.yml"' "$installer"
    ! grep -qF 'link "$DOT/config/omp/models.yml"' "$installer"
    ! grep -qF 'link "$DOT/config/omp/agents"' "$installer"
    grep -qF 'retire_omp_overrides' "$installer"
  done

  # The hook reconciler is idempotence-tested by ai-hooks-install-test. Both
  # platform installers must actually deliver that reconciler after linking the
  # runtime command manifest, rather than leaving fresh devices prose-only.
  grep -qxF "ai-hooks-install" "$manifest"
  grep -qF '"$HOME/.local/bin/ai-hooks-install"' "$ROOT/install.sh"
  grep -qF '"$HOME/.local/bin/ai-hooks-install"' "$ROOT/install-macos.sh"
  # Upgrades must prune commands removed from the manifest on both platforms.
  grep -qF 'pruned stale command link' "$ROOT/install.sh"
  grep -qF 'pruned stale command link' "$ROOT/install-macos.sh"
  echo "✓ runtime command manifest and hook wiring"
}

test_helper "$ROOT/install.sh" link
test_helper "$ROOT/install-macos.sh" link
test_helper "$ROOT/bin/tmux-setup" link_to_repo
test_shell_source_migration
test_macos_shell_source_migration
test_mise_tool_check
test_mise_absent_branch
test_mise_discovered_path
test_retire_omp_overrides "$ROOT/install.sh"
test_retire_omp_overrides "$ROOT/install-macos.sh"
test_retire_claude_account_profiles "$ROOT/install.sh"
test_retire_claude_account_profiles "$ROOT/install-macos.sh"
test_runtime_command_manifest
echo "installer-link-test: OK"
