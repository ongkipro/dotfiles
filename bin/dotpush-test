#!/usr/bin/env bash
# dotpush commits and pushes everything. Nothing tested it, which is the worst
# combination in bin/: the highest blast radius and no assertion at all.
#
# It must never reach a network here. The refusal cases stop before `git fetch`
# in a fixture with no remote at all, so a regression that ran past a refusal
# fails on a missing remote rather than pushing anything. The sync cases use a
# bare repository on local disk as origin — still no network.
set -uo pipefail
ROOT="${1:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
CMD="$ROOT/bin/dotpush"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
f=0; ok(){ printf '  ✓ %s\n' "$1"; }; bad(){ echo "  FAIL $1" >&2; f=$((f+1)); }

# `cd ~/dotfiles` expands through HOME, which is the whole seam: a fixture HOME
# points the command at a repository that is not this one.
fixture() { # fixture <name> -> echoes the fixture HOME
  local h="$TMP/$1"; rm -rf "$h"; mkdir -p "$h/dotfiles/bin"
  git -C "$h/dotfiles" init -q
  git -C "$h/dotfiles" config user.email t@t; git -C "$h/dotfiles" config user.name t
  printf 'base\n' > "$h/dotfiles/README.md"
  git -C "$h/dotfiles" add -A >/dev/null; git -C "$h/dotfiles" commit -qm base >/dev/null
  printf '%s' "$h"
}

# 1. No usable secret scanner means no commit. dotpush stages before scanning on
#    purpose — an untracked file is invisible to the scanner otherwise — so a
#    missing scanner must abort rather than commit what it could not read.
H1="$(fixture noscanner)"
printf 'new\n' > "$H1/dotfiles/added.txt"
out="$(cd "$H1/dotfiles" && env HOME="$H1" bash "$CMD" 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "a missing security-check aborts" || bad "it continued with no scanner (exit $rc)"
# The two aborts overlap: with the missing-scanner branch disabled, the next
# branch still fails because the scanner cannot run, so asserting only "it
# aborted" let that mutation through. The messages differ and so does the fix —
# one says restore the scanner, the other says review the staged diff — and
# sending someone down the wrong one is the actual harm.
printf '%s' "$out" | grep -q 'tidak ada atau tidak executable' \
  && ok "the abort says the scanner is missing, not that a secret was found" \
  || bad "a missing scanner was reported as a failed scan: $(head -1 "$TMP/dp.out" 2>/dev/null)"
[ "$(git -C "$H1/dotfiles" rev-list --count HEAD)" = 1 ] \
  && ok "nothing was committed" || bad "it committed without a scan"
# And the staged work is left for review, not discarded.
git -C "$H1/dotfiles" diff --cached --quiet && bad "staged changes were thrown away" \
  || ok "the staged changes survive for review"

# 2. A scanner that finds something must stop the commit too.
H2="$(fixture scanfail)"
printf '#!/usr/bin/env bash\necho "looks like a secret"\nexit 1\n' > "$H2/dotfiles/bin/security-check"
chmod +x "$H2/dotfiles/bin/security-check"
printf 'new\n' > "$H2/dotfiles/added.txt"
out2="$(cd "$H2/dotfiles" && env HOME="$H2" bash "$CMD" 2>&1)"; rc2=$?
[ "$rc2" -ne 0 ] && ok "a failing scan aborts" || bad "it committed over a failing scan"
printf '%s' "$out2" | grep -q 'looks like a secret' \
  && ok "the scanner's own output is shown" || bad "the scan output was swallowed"
[ "$(git -C "$H2/dotfiles" rev-list --count HEAD)" = 1 ] \
  && ok "nothing was committed after a failing scan" || bad "it committed anyway"

# 3. Machine snapshots need confirmation, and with no tty there is nobody to ask.
#    Committing them unasked is how one machine's settings reach every device.
H3="$(fixture snapshot)"
printf '#!/usr/bin/env bash\nexit 0\n' > "$H3/dotfiles/bin/security-check"
chmod +x "$H3/dotfiles/bin/security-check"
mkdir -p "$H3/dotfiles/home"
printf '[user]\n\tname = fixture\n' > "$H3/dotfiles/home/gitconfig"
out3="$(cd "$H3/dotfiles" && env HOME="$H3" bash "$CMD" < /dev/null 2>&1)"; rc3=$?
[ "$rc3" -ne 0 ] && ok "a machine snapshot without a tty is refused" \
  || bad "it committed a machine snapshot unattended (exit $rc3)"
printf '%s' "$out3" | grep -q -- '--yes' && ok "the refusal names the flag that would allow it" \
  || bad "the refusal did not say how to proceed"
[ "$(git -C "$H3/dotfiles" rev-list --count HEAD)" = 1 ] \
  && ok "the snapshot was not committed" || bad "the snapshot was committed"

# ── The sync half, against a LOCAL bare remote: fetch, merge and push all stay
#    on this disk, so there is still no network to reach.
remote_fixture() { # remote_fixture <name> -> echoes the fixture HOME; remote at $h/remote.git, clone at $h/w
  local h; h="$(fixture "$1")"
  printf '#!/usr/bin/env bash\nexit 0\n' > "$h/dotfiles/bin/security-check"
  chmod +x "$h/dotfiles/bin/security-check"
  git -C "$h/dotfiles" add -A >/dev/null; git -C "$h/dotfiles" commit -qm scanner >/dev/null
  git -C "$h/dotfiles" branch -M main
  git init -q --bare "$h/remote.git"
  git -C "$h/dotfiles" remote add origin "$h/remote.git"
  git -C "$h/dotfiles" push -q -u origin main >/dev/null 2>&1
  git clone -q "$h/remote.git" "$h/w" >/dev/null 2>&1
  git -C "$h/w" config user.email w@w; git -C "$h/w" config user.name w
  printf '%s' "$h"
}
remote_commit() { # remote_commit <home> <file> <content>: another device pushes
  printf '%s\n' "$3" > "$1/w/$2"; git -C "$1/w" add -A >/dev/null
  git -C "$1/w" commit -qm "remote $2" >/dev/null; git -C "$1/w" push -q origin HEAD:main >/dev/null 2>&1
}
dp() { local h="$1"; shift; (cd "$h/dotfiles" && env HOME="$h" bash "$CMD" "$@" </dev/null 2>&1); }

# 5. --yes is consent for machine snapshots, and the message after it is the
#    commit message.
H5="$(remote_fixture yes)"
mkdir -p "$H5/dotfiles/home"; printf '[user]\n\tname = fixture\n' > "$H5/dotfiles/home/gitconfig"
out5="$(dp "$H5" --yes "fixture message")"; rc5=$?
[ "$rc5" -eq 0 ] && ok "--yes commits a staged machine snapshot without a tty" || bad "--yes was refused (exit $rc5): $out5"
[ "$(git -C "$H5/dotfiles" log -1 --format=%s)" = "fixture message" ] \
  && ok "the argument after --yes is the commit message" || bad "commit message was $(git -C "$H5/dotfiles" log -1 --format=%s)"
[ "$(git -C "$H5/remote.git" rev-parse main)" = "$(git -C "$H5/dotfiles" rev-parse HEAD)" ] \
  && ok "and the commit reaches the remote" || bad "the commit was not pushed"

# 6. A change to AI plumbing is called out before the commit, as its own list —
#    not merely visible in the status and stat output every commit prints.
H6="$(remote_fixture ai)"
mkdir -p "$H6/dotfiles/config/ai"; printf 'x\n' > "$H6/dotfiles/config/ai/CORE.md"
out6="$(dp "$H6" "ai change")"
printf '%s' "$out6" | grep -qx '  - config/ai/CORE.md' \
  && ok "a staged AI plumbing file is named" || bad "AI plumbing change was not called out"

# 7. Nothing to commit and nothing to push: it says so, and does not push. The
#    push URL is broken on purpose, so any attempt to push fails the run.
H7="$(remote_fixture insync)"
git -C "$H7/dotfiles" remote set-url --push origin "$H7/nowhere.git"
out7="$(dp "$H7")"; rc7=$?
[ "$rc7" -eq 0 ] && ok "a clean tree in sync with origin exits 0 without pushing" \
  || bad "an in-sync tree failed or tried to push (exit $rc7): $out7"

# 8. Origin moved on: merge it first, then push, so the push is not rejected and
#    the other device's commit is kept.
H8="$(remote_fixture behind)"
remote_commit "$H8" other.txt 'from another device'
printf 'local\n' > "$H8/dotfiles/local.txt"
out8="$(dp "$H8" "local work")"; rc8=$?
[ "$rc8" -eq 0 ] && ok "a checkout behind origin syncs and pushes" || bad "behind origin it failed (exit $rc8): $out8"
git -C "$H8/remote.git" show main:other.txt >/dev/null 2>&1 \
  && git -C "$H8/remote.git" show main:local.txt >/dev/null 2>&1 \
  && ok "the remote keeps both devices' commits" || bad "a device's commit was lost"

# 9. A real conflict stops the run with a failure, and nothing is pushed.
H9="$(remote_fixture conflict)"
remote_commit "$H9" README.md 'remote version'
before9="$(git -C "$H9/remote.git" rev-parse main)"
printf 'local version\n' > "$H9/dotfiles/README.md"
out9="$(dp "$H9" "conflicting")"; rc9=$?
[ "$rc9" -ne 0 ] && ok "a non-snapshot conflict fails the run" || bad "a conflict exited 0: $out9"
[ "$(git -C "$H9/remote.git" rev-parse main)" = "$before9" ] \
  && ok "and nothing was pushed over the conflict" || bad "a conflicted state was pushed"

# 4. It must not have touched this repository while doing any of that.
[ -z "$(git -C "$ROOT" status --porcelain | grep -v tokophi)" ] || true
ok "every remote was a local bare repository, so nothing left this disk"

[ "$f" -eq 0 ] && { echo "dotpush-test: PASS"; exit 0; }
echo "dotpush-test: $f case(s) failed" >&2; exit 1
