#!/usr/bin/env bash
# shopify-content-helper generates listing copy and feeds. The rules it must not
# break are written down in CLAUDE.md and the copywriting skill: no CTA, no
# third-party brand names. A generator that quietly emits one is a compliance
# problem, not a formatting one.
set -uo pipefail
ROOT="${1:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
CMD="$ROOT/bin/shopify-content-helper"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
f=0; ok(){ printf '  ✓ %s\n' "$1"; }; bad(){ echo "  FAIL $1" >&2; f=$((f+1)); }

out="$(bash "$CMD" --help 2>&1 || bash "$CMD" 2>&1)"
printf '%s' "$out" | grep -qiE 'usage|subcommand|command' && ok "it describes its own surface" \
  || bad "no usage output"

# An unknown subcommand must fail rather than fall through to a default action.
bash "$CMD" definitely-not-a-subcommand >/dev/null 2>&1 \
  && bad "an unknown subcommand was accepted" || ok "an unknown subcommand fails"

# A real subcommand must produce its real output, not merely exit 0.
alt="$(bash "$CMD" image-alt-pattern "kursi kayu jati" 2>&1 || true)"
printf '%s' "$alt" | grep -qi 'kursi' && ok "image-alt-pattern echoes the subject term" \
  || bad "image-alt-pattern produced nothing usable: $(printf '%s' "$alt" | head -2)"

# CLAUDE.md forbids CTA text in Shopify meta and defaults to brand-generic. The
# shipped templates broke both — "Buy Online at [Brand]", "Shop ... at [Brand]",
# "order online today" — so a helper made the breach the path of least effort.
# This asserted the broken state until TASK-059 fixed it; it now asserts the rule.
meta="$(bash "$CMD" meta-gen "kursi kayu" 2>&1 || true)"
# Only the numbered template lines. The command also prints the rule it follows,
# which necessarily quotes "Buy Now"/"Shop Now" — scanning the whole output made
# the explanation trip the check on itself.
templates="$(printf '%s\n' "$meta" | grep -E '^  [0-9]+\.')"
if printf '%s' "$templates" | grep -qiE 'buy online|buy now|shop now|shop .* at |order online today|free shipping'; then
  bad "a meta template carries CTA text: $(printf '%s' "$templates" | grep -iE 'buy|shop|order online|free shipping' | head -1)"
else
  ok "no CTA text in the meta templates"
fi
printf '%s' "$templates" | grep -q '\[Brand\]' \
  && bad "a meta template still offers a [Brand] slot; brand-generic is the default" \
  || ok "no brand slot in the meta templates"

# The "≤60 chars" and "≤155 chars" headers were labels, not checks. A long
# keyword pushed every title past 60 while the header still claimed the limit.
long="$(bash "$CMD" meta-gen "kursi kayu jati ukir jepara premium" 2>&1 || true)"
printf '%s' "$long" | grep -q 'OVER 60' \
  && ok "a title past 60 characters is flagged, not silently claimed" \
  || bad "a 73-character title was presented as meeting the ≤60 header"
printf '%s' "$meta" | grep -qE '\([0-9]+\)' \
  && ok "each template reports its own length" || bad "no length reported"

# It must not write into the repository just by being asked what it does.
BEFORE="$(git -C "$ROOT" status --porcelain | sort)"
bash "$CMD" --help >/dev/null 2>&1 || true
[ "$(git -C "$ROOT" status --porcelain | sort)" = "$BEFORE" ] \
  && ok "describing itself writes nothing" || bad "it modified the repository"

[ "$f" -eq 0 ] && { echo "shopify-content-helper-test: PASS"; exit 0; }
echo "shopify-content-helper-test: $f case(s) failed" >&2; exit 1
