#!/usr/bin/env python3
"""ai-hooks-install - reconcile Claude Code hook wiring from a tracked source.

~/.claude/settings.json is device-local: it carries `model`, `theme`,
`permissions`, and plugin state that must not be shared across machines, so it
cannot be symlinked into dotfiles the way AGENTS.md is. The consequence, until
this script existed, was that hook wiring was hand-maintained on every device.

That is not a cosmetic gap. `config/ai/hooks/git-guard.sh` arrives on a fresh
machine through the dotfiles clone and is executable immediately, but it only
ever runs if a `PreToolUse` entry in settings.json invokes it. Nothing installed
that entry, and `ai-doctor` could not tell the difference because it ran the
guard's *test script* rather than checking the *wiring*. A machine could report
a clean bill of health with the force-push guard entirely absent.

This script merges the entries declared in `config/ai/claude-hooks.json` into
settings.json and touches nothing else. It is idempotent: an entry is matched by
a regular expression requiring the INVOCATION shape of its command — not merely a
mention of the path — so re-running never duplicates, and a hand-tuned `timeout`
or `if` on an already-present hook is left alone unless --force is given.

Usage:
  ai-hooks-install              install or repair missing hooks
  ai-hooks-install --check      report drift, write nothing, non-zero if missing
  ai-hooks-install --force      replace matching entries with the canonical form
  ai-hooks-install --settings P operate on P instead of ~/.claude/settings.json
"""
import argparse
import json
import os
import re
import shutil
import sys
from pathlib import Path


def load_manifest(dotfiles: Path) -> dict:
    path = dotfiles / "config" / "ai" / "claude-hooks.json"
    if not path.is_file():
        raise ValueError(f"hook manifest missing: {path}")
    manifest = json.loads(path.read_text(encoding="utf-8"))
    if manifest.get("schemaVersion") != 1:
        raise ValueError(f"unsupported schemaVersion in {path}")
    for spec in manifest.get("hooks", []):
        for field in ("id", "event", "match", "entry"):
            if field not in spec:
                raise ValueError(f"hook manifest entry missing '{field}': {spec!r}")
    return manifest


def commands_in(group: dict) -> list:
    return [h.get("command", "") for h in group.get("hooks", []) if isinstance(h, dict)]


def find_group(groups: list, match: str) -> int:
    """Index of the group whose command actually INVOKES the hook, or -1.

    `match` is a regular expression, not a substring. It used to be a plain
    substring test, and that reproduced the exact bug this whole tool exists to
    prevent: a settings.json containing only

        {"command": "echo 'see config/ai/hooks/git-guard.sh for details'"}

    was reported as "all canonical hooks wired", exit 0, and ai-doctor printed
    green — while the force-push guard was not installed at all. A mention is
    not an invocation. The manifest's expression must require the invocation
    shape, not just the path.
    """
    pattern = re.compile(match, re.DOTALL)
    for i, group in enumerate(groups):
        if not isinstance(group, dict):
            continue
        if any(pattern.search(cmd) for cmd in commands_in(group)):
            return i
    return -1


def reconcile(settings: dict, manifest: dict, force: bool) -> list:
    """Return a list of (id, action) and mutate `settings` in place."""
    actions = []
    hooks = settings.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        raise ValueError("settings.json 'hooks' is not an object; refusing to overwrite it")

    for spec in manifest.get("hooks", []):
        groups = hooks.setdefault(spec["event"], [])
        if not isinstance(groups, list):
            raise ValueError(f"settings.json hooks.{spec['event']} is not a list; refusing to overwrite it")
        index = find_group(groups, spec["match"])
        if index < 0:
            groups.append(spec["entry"])
            actions.append((spec["id"], "installed"))
        elif force and groups[index] != spec["entry"]:
            groups[index] = spec["entry"]
            actions.append((spec["id"], "replaced"))
        elif groups[index] != spec["entry"]:
            actions.append((spec["id"], "present (differs from canonical; --force to replace)"))
        else:
            actions.append((spec["id"], "present"))
    return actions


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true", help="report drift, write nothing")
    parser.add_argument("--force", action="store_true", help="replace matching entries with the canonical form")
    parser.add_argument("--settings")
    parser.add_argument("--dotfiles")
    args = parser.parse_args()

    dotfiles = Path(
        args.dotfiles or os.environ.get("DOTFILES_DIR", Path(__file__).resolve().parent.parent)
    ).resolve()
    settings_path = Path(
        args.settings or os.environ.get("CLAUDE_SETTINGS", Path.home() / ".claude" / "settings.json")
    ).expanduser()

    try:
        manifest = load_manifest(dotfiles)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(f"ai-hooks-install: ERROR: {exc}", file=sys.stderr)
        return 1

    if settings_path.is_file():
        try:
            original = settings_path.read_text(encoding="utf-8")
            settings = json.loads(original)
        except (OSError, json.JSONDecodeError) as exc:
            # Never rewrite a settings file we could not parse — that would
            # destroy device-local configuration to install a hook.
            print(f"ai-hooks-install: ERROR: cannot read {settings_path}: {exc}", file=sys.stderr)
            return 1
        if not isinstance(settings, dict):
            print(f"ai-hooks-install: ERROR: {settings_path} is not a JSON object", file=sys.stderr)
            return 1
    else:
        original = None
        settings = {}

    before = json.dumps(settings, sort_keys=True)
    try:
        actions = reconcile(settings, manifest, args.force)
    except ValueError as exc:
        print(f"ai-hooks-install: ERROR: {exc}", file=sys.stderr)
        return 1
    changed = json.dumps(settings, sort_keys=True) != before

    for hook_id, action in actions:
        print(f"  {hook_id}: {action}")

    missing = [i for i, a in actions if a == "installed"]
    if args.check:
        if missing:
            print(f"ai-hooks-install: {len(missing)} hook(s) NOT wired in {settings_path}: {', '.join(missing)}", file=sys.stderr)
            return 1
        print(f"ai-hooks-install: all {len(actions)} canonical hook(s) wired")
        return 0

    if not changed:
        print(f"ai-hooks-install: already up to date ({settings_path})")
        return 0

    try:
        if original is not None:
            backup = settings_path.with_suffix(settings_path.suffix + ".bak")
            shutil.copy2(settings_path, backup)
            print(f"  backup: {backup}")
        settings_path.parent.mkdir(parents=True, exist_ok=True)
        tmp = settings_path.with_suffix(settings_path.suffix + ".tmp")
        tmp.write_text(json.dumps(settings, indent=2) + "\n", encoding="utf-8")
        os.replace(tmp, settings_path)
    except OSError as exc:
        print(f"ai-hooks-install: ERROR: cannot write {settings_path}: {exc}", file=sys.stderr)
        return 1

    print(f"ai-hooks-install: updated {settings_path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
