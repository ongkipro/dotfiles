# 6c. Mocked insights pull and explicitly estimated COD delivery, without mutation plans.
cat > "$TMP/provider-python" <<'PYMOCK'
#!/usr/bin/env python3
import json,sys
request=json.load(sys.stdin)
if '--plan' in sys.argv:
    print(json.dumps({'request':request,'scope':{'level':'ad'}}));sys.exit(0)
assert request['operation']=='insights' and request['levels']==['ad']
rows=[{'account_id':'act_1234567890','account_currency':'USD','ad_id':'ad_live_1','ad_name':'Ad_Live_Pulled','spend':'100','impressions':'12000','frequency':'1.4','outbound_clicks':'200','actions':[{'action_type':'purchase','value':'5'}],'action_values':[{'action_type':'purchase','value':'500'}]},
