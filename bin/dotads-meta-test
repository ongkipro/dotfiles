# A corrupt state file must never be silently reset into a fresh deployment.
cp "$WS/.meta-state.json" "$TMP/good-state.json"
for invalid_state in '{"campaigns":' 'null' '{"version":2}' '{"version":1,"campaigns":[]}' '{"version":1,"media_cache":{},"campaigns":{},"creatives":{},"adsets":{},"ads":{"ad":{"name":"missing ID"}}}'; do
  printf '%s\n' "$invalid_state" > "$WS/.meta-state.json"
  calls_before="$(wc -l < "$META_LOG")"
  invalid_out="$("$CMD" deploy "$WS/campaigns/active-manifest.json" --apply 2>&1)"
  invalid_rc=$?
  if [ "$invalid_rc" -ne 0 ] \
    && [ "$(wc -l < "$META_LOG")" = "$calls_before" ] \
    && [ "$(cat "$WS/.meta-state.json")" = "$invalid_state" ]; then
    ok "invalid state blocks deployment without API calls or data loss: $invalid_state"
  else
    bad "invalid state allowed a deployment or changed persisted data: $invalid_state"
  fi
  "$CMD" status --brand "$WS/brand.json" --json >/dev/null 2>&1 \
    && bad "status accepted invalid state: $invalid_state" \
    || ok "status rejects invalid persisted state"
done
cp "$TMP/good-state.json" "$WS/.meta-state.json"

# An explicit brand must win over unrelated account defaults in the parent shell.
brand_account="$(jq -r '.ad_account_id' "$WS/brand.json")"
brand_business="$(jq -r '.business_id' "$WS/brand.json")"
brand_out="$(AD_ACCOUNT_ID=act_999999 BUSINESS_ID=999999 EXPECTED_AD_ACCOUNT_ID="$brand_account" EXPECTED_BUSINESS_ID="$brand_business" \
  "$CMD" run --brand "$WS/brand.json" -- --output json --no-input ads campaign list 2>&1)"
if [ "$?" -eq 0 ] && printf '%s' "$brand_out" | grep -q '"camp_1001"'; then
  ok "explicit brand overrides inherited ad account and business defaults"
else
  bad "parent account defaults overrode explicit brand: $brand_out"
fi

# No business in the selected brand must not pick a different shell default.
jq 'del(.business_id)' "$WS/brand.json" > "$WS/brand-no-business.json"
BUSINESS_ID=999999 EXPECTED_BUSINESS_ID= "$CMD" run --brand "$WS/brand-no-business.json" -- --output json --no-input ads campaign list >/dev/null 2>&1 \
  && ok "brand without business clears inherited business defaults" \
  || bad "brand without business inherited an unrelated business"

jq '.creatives += [.creatives[0] | .key = "cr_no_business"]' "$WS/campaigns/active-manifest.json" > "$WS/campaigns/no-business.json"
BUSINESS_ID=999999 EXPECTED_BUSINESS_ID= "$CMD" deploy "$WS/campaigns/no-business.json" --brand "$WS/brand-no-business.json" --apply >/dev/null 2>&1 \
  && ok "deployment without a business clears inherited business defaults" \
  || bad "deployment without a business inherited an unrelated business"
cp "$WS/.meta-state.json" "$TMP/good-state.json"

# Simulate interruption during state writing after a remote creation succeeded.
cat > "$TMP/fail-state-write.cjs" <<'EOF'
const fs = require('node:fs');
const write = fs.writeFileSync;
fs.writeFileSync = function(file, data, options) {
  if (String(file).includes('.meta-state.json')) {
    write(file, '{"interrupted":', options);
    throw new Error('Simulated state write failure');
  }
  return write.apply(this, arguments);
};
EOF
jq '.creatives += [.creatives[0] | .key = "cr_write_failure"]' "$WS/campaigns/active-manifest.json" > "$WS/campaigns/write-failure.json"
failure_out="$(NODE_OPTIONS="--require=$TMP/fail-state-write.cjs" "$CMD" deploy "$WS/campaigns/write-failure.json" --apply 2>&1)"
if [ "$?" -ne 0 ] \
  && printf '%s' "$failure_out" | grep -q 'Simulated state write failure' \
  && cmp -s "$TMP/good-state.json" "$WS/.meta-state.json" \
  && [ -d "$WS/.dotads-meta.lock" ] \
  && [ -z "$(find "$WS" -name '.meta-state.json.*.tmp' -print)" ]; then
  ok "interrupted state write preserves previous IDs and cleans its temporary file"
else
  bad "interrupted state write lost previous deployment state or temporary-file cleanup: $failure_out"
fi

