# Analysis must preserve unknowns and record observations, not causal verdicts.
if python3 - "$CMD" "$TMP" <<'PYANALYSIS'
import copy, json, pathlib, subprocess, sys
cmd, tmp = sys.argv[1:]
ws = pathlib.Path(tmp) / 'analysis-contract'; ws.mkdir()
brand = ws / 'brand.json'; brand.write_text(json.dumps({'brand':'Analysis fixture','ad_account_id':'act_1234567890','currency':'USD'}))
insights = ws / 'insights.json'
def call(*args):
    p = subprocess.run([cmd,*args,'--brand',str(brand),'--json'],capture_output=True,text=True)
    assert p.returncode == 0, p.stderr
    return json.loads(p.stdout)
def analyze(row, *args):
    insights.write_text(json.dumps([row])); return call('analyze',str(insights),*args)
def economics():
    return call('learn','unit-economics','--aov','100','--cogs','30','--shipping-fee','5','--cod-rts-rate','.1','--rts-penalty','10','--target-margin','.2')
base = {'account_id':'act_1234567890','account_currency':'USD','ad_id':'ad_observation','date_start':'2026-10-01','date_stop':'2026-10-07','spend':100,'impressions':10000,'purchases':10,'revenue':1000,'outbound_clicks':200,'purchase_basis':'placed'}
failures = []
def check(name, fn):
    try: fn(); print('  PASS',name)
    except Exception as e: failures.append(name); print('  FAIL',name,repr(e))
def missing():
    r=analyze({'ad_id':'empty'})['results'][0]
    assert r['spend'] is None and r['purchases'] is None and r['roas'] is None,r
    assert r['classification']=='INSUFFICIENT_DATA' and r['recommended_command'] is None,r
check('missing metrics stay unavailable, without an invented diagnosis',missing)
def unknown_costs():
    r=analyze(base)['results'][0]
    assert r['estimated_net_profit'] is None and r['estimated_contribution_after_ads'] is None,r
    assert r['revenue_after_ad_spend']==900 and not r['comparison_qualified'],r
check('unconfigured costs never become profit or approved default benchmarks',unknown_costs)
economics()
def invalid_metrics():
    for field in ['spend','purchases','revenue','impressions','outbound_clicks','hook_rate']:
        for value in [None,'',True,[],{},'Infinity','NaN',-1]:
            row=dict(base,**{field:value}); r=analyze(row)['results'][0]
            key={'outbound_clicks':'ctr'}.get(field,field)
            assert r[key] is None,(field,value,r)
            assert r['recommended_command'] is None,(field,value,r)
    r=analyze(dict(base,spend='bad'))['results'][0]
    assert r['spend'] is None and r['roas'] is None and r['impressions']==10000,r
check('invalid numeric shapes are not coerced to zero; valid partial metrics survive',invalid_metrics)
def zeroes():
    r=analyze(dict(base,purchases=0,revenue=0,video_3s_views=0,thruplays=0))['results'][0]
    assert r['purchases']==0 and r['revenue']==0 and r['roas']==0 and r['cpr'] is None,r
    assert r['hook_rate']==0 and r['hold_rate'] is None,r
    r=analyze(dict(base,spend=0,outbound_clicks=0))['results'][0]
    assert r['spend']==0 and r['roas'] is None and r['ctr']==0 and r['cpc'] is None,r
check('legitimate zero is retained and undefined ratios remain unavailable',zeroes)
def coherent_cod():
    r=analyze(base,'--delivery-rate','.9')['results'][0]
    assert r['purchases']==9 and r['revenue']==900,r
    assert r['estimated_contribution_after_ads']==475 and r['estimated_net_profit'] is None,r
    assert r['economic_basis']=='expected_per_placed_order' and r['comparison_qualified'],r
    assert r['comparison_cpr']==10 and r['comparison_roas']==10,r
    assert r['comparison_benchmarks']['target_cpr']==39.5 and r['comparison_benchmarks']['target_roas']==2.53,r
    assert r['comparison_benchmarks']['expected_delivered_target_roas']==2.28,r
check('ten placed COD orders with .9 delivery estimate contribute 475 after ads',coherent_cod)
def missing_basis():
    row=dict(base); row.pop('purchase_basis'); r=analyze(row)['results'][0]
    assert not r['comparison_qualified'] and r['estimated_contribution_after_ads'] is None,r
