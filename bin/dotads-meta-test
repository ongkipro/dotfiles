#!/usr/bin/env bash
# Behavioral regression suite for bin/dotads-meta.
set -uo pipefail

ROOT="${1:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
CMD="$ROOT/bin/dotads-meta"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/dotads-meta-test.XXXXXX")"
TMP="$(cd "$TMP" && pwd -P)"
# HOME/cwd fixtures must retain the actual Node binary, not a configuration-dependent shim.
dotads_test_node_dir="$(node -p 'require("node:path").dirname(process.execPath)')"
export PATH="$dotads_test_node_dir:$PATH"
trap 'rm -rf "$TMP"' EXIT

# A caller's workspace override must never redirect fixture writes to real data.
unset DOTADS_WORKSPACE_ROOT

f=0
ok()  { printf '  ✓ %s\n' "$1"; }
bad() { printf '  FAIL %s\n' "$1" >&2; f=$((f + 1)); }

# 1. Surface & read-only --help check
BEFORE="$(git -C "$ROOT" status --porcelain | sort)"
help_out="$("$CMD" --help 2>&1 || true)"
printf '%s' "$help_out" | grep -qE 'setup|init|validate|deploy|status|doctor|run' \
  && ok "describes its subcommands on --help" \
  || bad "missing usage output on --help"
[ "$(git -C "$ROOT" status --porcelain | sort)" = "$BEFORE" ] \
  && ok "--help does not modify the repository" \
  || bad "--help modified the repository"

"$CMD" unknown-subcommand >/dev/null 2>&1 \
  && bad "accepted an unknown subcommand" \
  || ok "rejects an unknown subcommand"

# Pin the public command surface and reject retired naming across maintained files.
if printf '%s' "$help_out" | grep -q '^Usage: dotads-meta ' \
  && grep -qxF 'dotads-meta' "$ROOT/config/ai/runtime-commands.txt" \
  && grep -qxF 'dotads-meta-test' "$ROOT/config/ai/runtime-commands.txt"; then
  ok "canonical command and regression suite remain installable"
else
  bad "canonical command help or installer manifest is incomplete"
fi
retired_name='meta-ads-ops'
# Git is already required by this suite; runner images need no ripgrep install.
# Include untracked maintained files, but leave immutable evidence out.
retired_refs="$(git -C "$ROOT" grep -IlF --untracked --exclude-standard -- "$retired_name" . ':(exclude).delivery/**' ':(exclude)bin/dotads-meta-test' 2>&1)"
retired_rc=$?
if [ "$retired_rc" -eq 1 ] \
  && [ ! -e "$ROOT/bin/$retired_name" ] && [ ! -L "$ROOT/bin/$retired_name" ] \
  && [ ! -e "$ROOT/bin/$retired_name-test" ] && [ ! -L "$ROOT/bin/$retired_name-test" ]; then
  ok "retired commands and references stay absent outside immutable execution evidence"
else
  bad "retired command or reference reintroduced (or search failed): $retired_refs"
fi

# 2. Scaffold workspace via init
WS="$TMP/brand-alpha"
"$CMD" init "$WS" >/dev/null 2>&1 \
  && [ -f "$WS/brand.json" ] \
  && [ -f "$WS/campaigns/sample-campaign.json" ] \
  && [ -d "$WS/media" ] \
  && grep -qxF '.meta-state.json' "$WS/.gitignore" \
  && ok "init scaffolds brand.json, sample-campaign.json, media/, and .gitignore" \
  || bad "init failed to scaffold workspace"

# Create dummy image asset for sample campaign
printf '\x89PNG\r\n\x1a\nfake-image-bytes' > "$WS/media/hero.jpg"

# Idempotency of init without --force
cp "$WS/brand.json" "$WS/brand.json.orig"
"$CMD" init "$WS" >/dev/null 2>&1
cmp -s "$WS/brand.json" "$WS/brand.json.orig" \
  && ok "init preserves existing files without --force" \
  || bad "init overwrote existing brand.json without --force"

# 3. Offline validation passes on valid CBO OUTCOME_SALES manifest
val_out="$("$CMD" validate "$WS/campaigns/sample-campaign.json" 2>&1)"
if [ "$?" -eq 0 ] && printf '%s' "$val_out" | grep -q 'Validation PASSED' && printf '%s' "$val_out" | grep -q '50.00 USD'; then
  ok "validate passes on valid CBO OUTCOME_SALES campaign and prints minor/major budget summary"
else
  bad "validate failed on valid sample campaign: $val_out"
fi

# 3b. Zero-decimal currency (IDR) explicit offset warning
jq '.currency = "IDR"' "$WS/brand.json" > "$WS/brand-idr.json"
idr_out="$("$CMD" validate "$WS/campaigns/sample-campaign.json" --brand "$WS/brand-idr.json" 2>&1)"
if [ "$?" -eq 0 ] && printf '%s' "$idr_out" | grep -q 'offset-1 OR'; then
  ok "validate surfaces explicit offset-1 vs /100 guidance for zero-decimal currencies (IDR)"
else
  bad "validate did not surface zero-decimal currency guidance for IDR: $idr_out"
fi

# 4. Trap guards in validate
# 4a. CBO + ABO budget collision (Error 1885621 guard)
jq '.adsets[0].daily_budget = 2000' "$WS/campaigns/sample-campaign.json" > "$WS/campaigns/cbo-abo-collision.json"
collision_out="$("$CMD" validate "$WS/campaigns/cbo-abo-collision.json" 2>&1)"
if [ "$?" -ne 0 ] && printf '%s' "$collision_out" | grep -q '1885621'; then
  ok "validate rejects CBO + ABO budget collision (Error 1885621 guard)"
else
  bad "validate allowed CBO + ABO budget collision: $collision_out"
fi

# 4b. Missing conversion_domain on OUTCOME_SALES
jq '.conversion_domain = ""' "$WS/brand.json" > "$WS/brand-no-domain.json"
nodomain_out="$("$CMD" validate "$WS/campaigns/sample-campaign.json" --brand "$WS/brand-no-domain.json" 2>&1)"
if [ "$?" -ne 0 ] && printf '%s' "$nodomain_out" | grep -q 'conversion_domain'; then
  ok "validate rejects OUTCOME_SALES ad without conversion_domain"
else
  bad "validate allowed OUTCOME_SALES ad without conversion_domain: $nodomain_out"
fi

# 4c. DCO creative without dynamic_creative: true on ad set
jq '.creatives[0].titles = ["Title 1", "Title 2"]' "$WS/campaigns/sample-campaign.json" > "$WS/campaigns/dco-missing-flag.json"
dco_out="$("$CMD" validate "$WS/campaigns/dco-missing-flag.json" 2>&1)"
if [ "$?" -ne 0 ] && printf '%s' "$dco_out" | grep -q 'dynamic_creative'; then
  ok "validate rejects DCO creative when ad set lacks dynamic_creative: true"
else
  bad "validate allowed DCO creative on non-dynamic ad set: $dco_out"
fi

# 4d. Missing local media file
jq '.creatives[0].image = "media/does-not-exist.jpg"' "$WS/campaigns/sample-campaign.json" > "$WS/campaigns/missing-media.json"
media_out="$("$CMD" validate "$WS/campaigns/missing-media.json" 2>&1)"
if [ "$?" -ne 0 ] && printf '%s' "$media_out" | grep -q 'file not found'; then
  ok "validate rejects missing local media file"
else
  bad "validate allowed missing local media file: $media_out"
fi

# 4e. Flexible Ad Format (ad_format: AUTOMATIC_FORMAT) allows multi-asset creative without dynamic_creative: true
jq '.creatives[0].titles = ["Title 1", "Title 2"] | .creatives[0].ad_format = "AUTOMATIC_FORMAT" | .adsets[0].advantage_audience = true | .adsets[0].incremental_attribution = true' \
  "$WS/campaigns/sample-campaign.json" > "$WS/campaigns/flexible-format.json"
flex_out="$("$CMD" validate "$WS/campaigns/flexible-format.json" --json 2>&1)"
if [ "$?" -eq 0 ] && printf '%s' "$flex_out" | jq -e '.ok == true and .algorithmAlignment.advantageStateCandidate == "ADVANTAGE_PLUS_SALES" and .algorithmAlignment.incrementalAttributionAdsets == 1' >/dev/null; then
  ok "validate accepts ad-level Flexible Ad Format (AUTOMATIC_FORMAT) and reports ADVANTAGE_PLUS_SALES alignment"
else
  bad "validate rejected Flexible Ad Format or missed algorithmAlignment: $flex_out"
fi

# 4f. Classic DCO ad set (dynamic_creative: true) rejects >1 ad referencing the same DCO ad set
jq '.creatives[0].titles = ["Title 1", "Title 2"] | .adsets[0].dynamic_creative = true | .ads += [{"key":"ad_hero_v2","name":"Ad_Hero_V2","adset":"adset_broad_id","creative":"cr_hero_v1","status":"PAUSED"}]' \
  "$WS/campaigns/sample-campaign.json" > "$WS/campaigns/dco-multi-ad.json"
dco_multi_out="$("$CMD" validate "$WS/campaigns/dco-multi-ad.json" 2>&1)"
if [ "$?" -ne 0 ] && printf '%s' "$dco_multi_out" | grep -q 'more than 1 ad'; then
  ok "validate rejects >1 ad in a dynamic_creative: true ad set"
else
  bad "validate allowed >1 ad in a dynamic_creative: true ad set: $dco_multi_out"
fi

# 4g. Rejects legacy smart_promotion_type (v25.0-v26.0 deprecation guard)
jq '.campaign.smart_promotion_type = "AUTOMATED_SHOPPING_ADS"' "$WS/campaigns/sample-campaign.json" > "$WS/campaigns/legacy-asc.json"
asc_out="$("$CMD" validate "$WS/campaigns/legacy-asc.json" 2>&1)"
if [ "$?" -ne 0 ] && printf '%s' "$asc_out" | grep -q 'smart_promotion_type'; then
  ok "validate rejects deprecated smart_promotion_type (v25.0-v26.0 guard)"
else
  bad "validate allowed deprecated smart_promotion_type: $asc_out"
fi

# 4h. Rejects deprecated 7d_view / 28d_view in attribution_spec
jq '.adsets[0].attribution_spec = [{"event_type":"CLICK_THROUGH","window_days":7},{"event_type":"VIEW_THROUGH","window_days":7}]' \
  "$WS/campaigns/sample-campaign.json" > "$WS/campaigns/deprecated-view-window.json"
attr_out="$("$CMD" validate "$WS/campaigns/deprecated-view-window.json" 2>&1)"
if [ "$?" -ne 0 ] && printf '%s' "$attr_out" | grep -q '7d_view/28d_view'; then
  ok "validate rejects deprecated 7d_view/28d_view attribution window"
else
  bad "validate allowed deprecated 7d_view attribution window: $attr_out"
fi

# 4i. Warns on deprecated standard_enhancements bundle in degrees_of_freedom_spec
jq '.creatives[0].degrees_of_freedom_spec = {"creative_features_spec":{"standard_enhancements":{"enroll_status":"OPT_IN"}}}' \
  "$WS/campaigns/sample-campaign.json" > "$WS/campaigns/deprecated-dof.json"
dof_out="$("$CMD" validate "$WS/campaigns/deprecated-dof.json" 2>&1)"
if [ "$?" -eq 0 ] && printf '%s' "$dof_out" | grep -q 'standard_enhancements'; then
  ok "validate warns on deprecated standard_enhancements bundle in degrees_of_freedom_spec"
else
  bad "validate did not warn on deprecated standard_enhancements bundle: $dof_out"
fi

# 4j. Warns on Malaysian Malay vocabulary leak when targeting Indonesia (ID) and pushy/off-funnel CTA text in copy
jq '.creatives[0].title = "Diskaun 50% & Penghantaran Percuma" | .creatives[0].body = "Tempah sekarang! Klik link di bawah atau chat WA sekarang juga." | .adsets[0].targeting_countries = ["ID"]' \
  "$WS/campaigns/sample-campaign.json" > "$WS/campaigns/id-copy-lint.json"
copy_lint_out="$("$CMD" validate "$WS/campaigns/id-copy-lint.json" --json 2>&1)"
if [ "$?" -eq 0 ] \
  && printf '%s' "$copy_lint_out" | jq -e '.ok == true and (.warnings | any(contains("Malaysian Malay term \u0027percuma\u0027"))) and (.warnings | any(contains("Malaysian Malay term \u0027penghantaran\u0027"))) and (.warnings | any(contains("Malaysian Malay term \u0027diskaun\u0027"))) and (.warnings | any(contains("pushy/off-funnel CTA text")))' >/dev/null; then
  ok "validate warns on Malaysian Malay lexical leaks for ID market and pushy direct-click/WA CTA clutter"
else
  bad "validate missed ID vs MY lexical leak or pushy CTA copy warning: $copy_lint_out"
fi

# 4k. Warns on Indonesian lexical leak when targeting Malaysia (MY), mobile viewport truncation (>40/>30 chars), and missing url_tags
jq 'del(.creatives[0].url_tags) | .creatives[0].title = "Gratis Ongkir & Diskon Gede Banget Untuk Semua Pembeli Baru Hari Ini" | .creatives[0].description = "Garansi tukar ukuran gratis sampai 30 hari penuh" | .adsets[0].targeting_countries = ["MY"]' \
  "$WS/campaigns/sample-campaign.json" > "$WS/campaigns/my-copy-lint.json"
my_lint_out="$("$CMD" validate "$WS/campaigns/my-copy-lint.json" --json 2>&1)"
if [ "$?" -eq 0 ] \
  && printf '%s' "$my_lint_out" | jq -e '.ok == true and (.warnings | any(contains("Indonesian term/slang"))) and (.warnings | any(contains("40-char mobile Feed preview guideline"))) and (.warnings | any(contains("30-char mobile Feed preview guideline"))) and (.warnings | any(contains("missing \u0027url_tags\u0027"))) and (.warnings | all(contains("Andromeda NLP") | not))' >/dev/null; then
  ok "validate warns on Indonesian slang leak for MY market, headline/description viewport truncation, and missing url_tags"
else
  bad "validate missed MY lexical leak, truncation, or url_tags warning: $my_lint_out"
fi

# Attribution is an alternative mode, not an additional attribution window.
if python3 - "$CMD" "$WS" <<'PY'
import copy, json, pathlib, re, subprocess, sys
cmd, workspace = sys.argv[1], pathlib.Path(sys.argv[2])
baseline = json.loads((workspace / 'campaigns/sample-campaign.json').read_text())
windows = [{'event_type': 'CLICK_THROUGH', 'window_days': 7}]
(workspace / 'windows.json').write_text(json.dumps(windows))
(workspace / 'old-windows.json').write_text(json.dumps([{'event_type': 'VIEW_THROUGH', 'window_days': 28}]))

def check(name, patch, valid, message=None, flags=()):
    manifest = copy.deepcopy(baseline)
    patch(manifest)
    path = workspace / 'campaigns' / (name + '.json')
    path.write_text(json.dumps(manifest))
    result = subprocess.run([cmd, 'validate', str(path), '--json'], capture_output=True, text=True)
    data = json.loads(result.stdout)
    assert data['ok'] is valid and (result.returncode == 0) is valid, (name, result.stdout, result.stderr)
    if message:
        assert any(message in error for error in data['errors']), (name, data)
    plan = subprocess.run([cmd, 'deploy', str(path)], capture_output=True, text=True)
    assert (plan.returncode == 0) is valid, (name, plan.stdout, plan.stderr)
    if valid:
        for present, flag in flags:
            assert (flag in plan.stdout) is present, (name, flag, plan.stdout)
    print('    ' + name + ': PASS')
    return data

def attribution(incremental, spec=None):
    def patch(manifest):
        manifest['adsets'][0]['incremental_attribution'] = incremental
        if spec is not None:
            manifest['adsets'][0]['attribution_spec'] = spec
    return patch

check('incremental-only', attribution(True), True,
      flags=((True, '--incremental-attribution'), (False, '--attribution-spec')))
check('window-only', lambda m: m['adsets'][0].update(attribution_spec=windows), True,
      flags=((False, '--incremental-attribution'), (True, '--attribution-spec')))
check('disabled-incremental-window', attribution(False, windows), True)
check('window-file', lambda m: m['adsets'][0].update(attribution_spec='@windows.json'), True)
for name, value in [('inline', windows), ('json-string', json.dumps(windows)), ('file', '@windows.json')]:
    check('conflicting-attribution-' + name, attribution(True, value), False, 'cannot combine')
check('old-window-file', lambda m: m['adsets'][0].update(attribution_spec='@old-windows.json'), False, '7d_view/28d_view')
check('incremental-string', attribution('true'), False, 'boolean')
check('incremental-click-goal', lambda m: m['adsets'][0].update(incremental_attribution=True, optimization_goal='LINK_CLICKS'), False, 'optimization_goal')
check('incremental-cbo-bid-cap', lambda m: (m['campaign'].update(bid_strategy='LOWEST_COST_WITH_BID_CAP'), m['adsets'][0].update(incremental_attribution=True)), False, 'bid_strategy')
check('incremental-cbo-cost-cap', lambda m: (m['campaign'].update(bid_strategy='COST_CAP'), m['adsets'][0].update(incremental_attribution=True)), True)
check('incremental-abo-bid-cap', lambda m: (m['campaign'].pop('daily_budget'), m['adsets'][0].update(daily_budget=5000, bid_strategy='LOWEST_COST_WITH_BID_CAP', bid_amount=200, incremental_attribution=True)), False, 'bid_strategy')
check('wrong-engaged-event', lambda m: m['adsets'][0].update(attribution_spec=[{'event_type':'ENGAGED_VIEW','window_days':1}]), False, 'ENGAGED_VIDEO_VIEW')
check('valid-engaged-event', lambda m: m['adsets'][0].update(attribution_spec=[{'event_type':'ENGAGED_VIDEO_VIEW','window_days':1}]), True)
check('malformed-window', lambda m: m['adsets'][0].update(attribution_spec=[None]), False, 'entries require')
check('malformed-window-json', lambda m: m['adsets'][0].update(attribution_spec='{broken'), False, 'valid JSON')

poll = {'video_data': {'poll_spec': {'question':'Choose a color'}}}
(workspace / 'poll.json').write_text(json.dumps(poll))
check('retired-poll-direct', lambda m: m['creatives'][0].update(poll_spec={}), False, 'not forwarded')
check('unsupported-components', lambda m: m['creatives'][0].update(interactive_components_spec=[]), False, 'not forwarded')
check('retired-poll-raw', lambda m: m['creatives'][0].update(object_story_spec=poll), False, 'retired across API')
check('retired-poll-file', lambda m: m['creatives'][0].update(object_story_spec='@poll.json'), False, 'retired across API')
check('retired-poll-component', lambda m: m['creatives'][0].update(asset_feed_spec={'interactive_components_spec':[{'type':'poll'}]}), False, 'retired across API')
check('poll-word-in-copy', lambda m: m['creatives'][0].update(body='Our customer poll inspired these colors.'), True)
web = check('web-only-scope-review', lambda m: m['creatives'][0].update(applink_treatment='web_only'), True)
assert any('Web and App' in warning for warning in web['warnings'])

def raw_targeting(value, shortcut=None):
    def patch(manifest):
        manifest['campaign']['special_ad_categories'] = ['HOUSING']
        adset = manifest['adsets'][0]
        adset.pop('targeting_countries')
        adset['targeting'] = value
        if shortcut is not None:
            adset['advantage_audience'] = shortcut
    return patch

targeting = {'geo_locations': {'countries': ['US']}, 'custom_audiences': [{'id':'123'}]}
check('hef-cli-default', raw_targeting(targeting), True)
for i, bad_target in enumerate(([], 1, '[]', 'null', 'true', '1')):
    check('targeting-wrong-shape-' + str(i), raw_targeting(bad_target), False, 'JSON object')
(workspace / 'bad-targeting.json').write_text('[]')
check('targeting-file-wrong-shape', raw_targeting('@bad-targeting.json'), False, 'JSON object')
(workspace / 'good-targeting.json').write_text(json.dumps(targeting))
check('targeting-file-object', raw_targeting('@good-targeting.json'), True)
check('targeting-json-object', raw_targeting(json.dumps(targeting)), True)
check('automation-wrong-shape', raw_targeting(dict(targeting, targeting_automation=[])), False, 'JSON object')
check('invalid-audience-shortcut', raw_targeting(targeting, 'true'), False, 'boolean')
nested = dict(targeting, targeting_automation={'advantage_audience':0})
candidate = check('nested-audience-overrides-optin', raw_targeting(nested, True), True)
assert candidate['algorithmAlignment']['advantageStateCandidate'] == 'MANUAL_OR_HYBRID'
assert candidate['algorithmAlignment']['verifiedWithMeta'] is False
check('invalid-nested-audience', raw_targeting(dict(targeting, targeting_automation={'advantage_audience':True})), False, 'must be 0 or 1')
for field in ('object_story_spec', 'asset_feed_spec'):
    for i, value in enumerate(([], 'null', '1', '@bad-targeting.json')):
        check(field + '-wrong-shape-' + str(i), lambda m: m['creatives'][0].update({field:value}), False, 'JSON object')
check('raw-story-object', lambda m: m['creatives'][0].update(object_story_spec={'link_data':{'link':'https://example.com/product','message':'Verified product information.'}}), True)

# Execute the documented campaign examples rather than trusting their prose.
tutorial = pathlib.Path(cmd).parent.parent / 'skills/local/meta-ads-cli/references/rules-and-tutorial.md'
recipes = [json.loads(block) for block in re.findall(r'```json\n(.*?)\n```', tutorial.read_text(), re.S)]
recipes = [recipe for recipe in recipes if 'campaign' in recipe]
assert len(recipes) == 4
for i, recipe in enumerate(recipes, 1):
    for creative in recipe['creatives']:
        refs = [creative.get('image'), creative.get('video')] + creative.get('images', []) + creative.get('videos', [])
        for ref in filter(None, refs):
            asset = workspace / ref
            asset.parent.mkdir(parents=True, exist_ok=True)
            asset.write_bytes(b'synthetic-media-for-offline-plan')
    check('documented-recipe-' + str(i), lambda manifest: manifest.update(recipe), True)
PY
then
  ok "attribution, current payload boundaries, and documented recipes validate and dry-run offline"
else
  bad "attribution compatibility regression"
fi

# 5. Mock `meta` and `secrets-env` binaries for setup, dry-run, deploy --apply, state resume, drift detection, and media hash dedup
MOCK_BIN="$TMP/mock-bin"
META_LOG="$TMP/meta-invocations.log"
mkdir -p "$MOCK_BIN"

cat > "$MOCK_BIN/secrets-env" <<'EOF'
#!/usr/bin/env bash
if [ "${1:-}" = "get" ] && [ "${2:-}" = "META_ACCESS_TOKEN" ]; then
  printf 'MOCK_SYSTEM_USER_TOKEN_SECRET_999\n'
  exit 0
fi
exit 1
EOF
chmod +x "$MOCK_BIN/secrets-env"

cat > "$MOCK_BIN/meta" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [ "${1:-}" = "--version" ]; then
  echo "meta, version 1.2.0"
  exit 0
fi
if [ "${1:-}" = "auth" ] && [ "${2:-}" = "status" ]; then
  if [ -n "${ACCESS_TOKEN:-}" ]; then
    echo "Authenticated via ACCESS_TOKEN"
    exit 0
  fi
  echo "Not authenticated. Set the ACCESS_TOKEN environment variable."
  exit 0
fi

if [ -n "${EXPECTED_AD_ACCOUNT_ID:-}" ] && [ "${AD_ACCOUNT_ID:-}" != "$EXPECTED_AD_ACCOUNT_ID" ]; then
  echo "Wrong ad account environment" >&2
  exit 98
fi
if [ "${EXPECTED_BUSINESS_ID+x}" = x ] && [ "${BUSINESS_ID:-}" != "$EXPECTED_BUSINESS_ID" ]; then
  echo "Wrong business environment" >&2
  exit 98
fi

# Record invocation args and verify ACCESS_TOKEN is in env, never in args
printf 'TOKEN_LEN=%d ARGS=%s\n' "${#ACCESS_TOKEN}" "$*" >> "$META_LOG"
case "$*" in
  *MOCK_SYSTEM_USER_TOKEN_SECRET_999*)
    echo "SECRET LEAKED IN CLI ARGS" >&2
    exit 99
    ;;
esac

# Verify global flags precede `ads`
if [ "${1:-}" != "--output" ] || [ "${2:-}" != "json" ] || [ "${3:-}" != "--no-input" ] || [ "${4:-}" != "ads" ]; then
  echo "Invalid global flag ordering: $*" >&2
  exit 2
fi

case "$*" in
  *" campaign create "*)
    printf '[\n  {\n    "id": "camp_1001",\n    "name": "Sales_CBO_Launch"\n  }\n]\n'
    ;;
  *" creative create "*)
    if [[ "$*" == *"--image-hash"* ]]; then
      printf '[\n  {\n    "id": "cr_2002",\n    "image_hash": "hash_hero_abc123"\n  }\n]\n'
    else
      printf '[\n  {\n    "id": "cr_2001",\n    "image_hash": "hash_hero_abc123"\n  }\n]\n'
    fi
    ;;
  *" adset create "*)
    printf '[\n  {\n    "id": "adset_3001",\n    "name": "AdSet_Broad_ID"\n  }\n]\n'
    ;;
  *" ad create "*)
    printf '[\n  {\n    "id": "ad_4001",\n    "name": "Ad_Hero_V1"\n  }\n]\n'
    ;;
  *" campaign list"*)
    printf '[\n  {\n    "id": "camp_1001"\n  }\n]\n'
    ;;
  *" insights "*)
    printf '[{"account_id":"act_1234567890","account_currency":"USD","ad_id":"ad_live_1","ad_name":"Ad_Live_Pulled","spend":"100","impressions":"12000","frequency":"1.4","outbound_clicks":"200","actions":[{"action_type":"purchase","value":"5"}],"action_values":[{"action_type":"purchase","value":"500"}]},{"account_id":"act_1234567890","account_currency":"USD","ad_id":"ad_early_1","ad_name":"Ad_Early_Learning","spend":"20","impressions":"2000","frequency":"1.1","outbound_clicks":"25"},{"account_id":"act_1234567890","account_currency":"USD","ad_id":"ad_fatigue_1","ad_name":"Ad_Fatigued_V1","spend":"100","impressions":"15000","frequency":"2.9","outbound_clicks":"150","actions":[{"action_type":"purchase","value":"1"}],"action_values":[{"action_type":"purchase","value":"100"}]}]\n'
    ;;
  *)
    echo "Unexpected mock meta command: $*" >&2
    exit 3
    ;;
esac
EOF
chmod +x "$MOCK_BIN/meta"

export META_ADS_BIN="$MOCK_BIN/meta"
export SECRETS_ENV_BIN="$MOCK_BIN/secrets-env"
export META_LOG

# Invalid input must stop before credential lookup, state creation, or API work.
cat > "$MOCK_BIN/forbidden-secrets" <<'EOF'
#!/usr/bin/env bash
touch "$META_LOG.secret-attempt"
exit 1
EOF
chmod +x "$MOCK_BIN/forbidden-secrets"
invalid_apply="$(SECRETS_ENV_BIN="$MOCK_BIN/forbidden-secrets" "$CMD" deploy "$WS/campaigns/conflicting-attribution-inline.json" --apply 2>&1)"
if [ "$?" -ne 0 ] && printf '%s' "$invalid_apply" | grep -q 'cannot combine' \
  && [ ! -e "$META_LOG" ] && [ ! -e "$META_LOG.secret-attempt" ] \
  && [ ! -e "$WS/.meta-state.json" ] && [ ! -e "$WS/.dotads-meta.lock" ]; then
  ok "conflicting attribution blocks apply before credentials, state, lock, or API calls"
else
  bad "invalid attribution reached deployment side effects: $invalid_apply"
fi

# 5a. setup subcommand detects installed meta-ads CLI and prepares ~/Documents/dotads-meta-report (0700)
SETUP_HOME="$TMP/setup-home"
mkdir -p "$SETUP_HOME"
setup_out="$(HOME="$SETUP_HOME" "$CMD" setup 2>&1)"
setup_ws_mode="$(python3 -c 'import os, stat, sys; print(oct(stat.S_IMODE(os.lstat(sys.argv[1]).st_mode)))' "$SETUP_HOME/Documents/dotads-meta-report" 2>/dev/null || true)"
HOME="$SETUP_HOME" "$CMD" init act_987654321--brand-alpha >/dev/null 2>&1
if [ "$?" -eq 0 ] \
  && printf '%s' "$setup_out" | grep -q 'already installed' \
  && [ "$setup_ws_mode" = "0o700" ] \
  && [ -f "$SETUP_HOME/Documents/dotads-meta-report/act_987654321--brand-alpha/brand.json" ] \
  && jq -e '.ad_account_id == "act_987654321" and .brand == "brand-alpha"' "$SETUP_HOME/Documents/dotads-meta-report/act_987654321--brand-alpha/brand.json" >/dev/null; then
  ok "setup detects already-installed meta-ads binary and prepares ~/Documents/dotads-meta-report (0700)"
else
  bad "setup or default workspace root failed: $setup_out (mode=$setup_ws_mode)"
fi

# 5a2. Real filesystem and child-process contracts for workspace setup/init.
python3 - "$CMD" "$TMP" <<'PYTEST'
import json, os, pathlib, stat, subprocess, sys
cmd, base = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]) / 'workspace-contract'
base.mkdir()
env = dict(os.environ)
for key in ('DOTADS_WORKSPACE_ROOT', 'NODE_OPTIONS'):
    env.pop(key, None)
def run(args, home, **options):
    home.mkdir(parents=True, exist_ok=True)
    return subprocess.run([str(cmd), *args], env=dict(env, HOME=str(home), **options.pop('extra', {})),
                          text=True, capture_output=True, timeout=30, **options)
home, cwd = base / 'routing-home', base / 'cwd'
cwd.mkdir()
slug = 'act_321--brand'
(cwd / slug).mkdir()
r = run(['init', slug], home, cwd=cwd)
workspace = home / 'Documents/dotads-meta-report' / slug
assert r.returncode == 0 and (workspace / 'brand.json').exists(), r.stderr
assert not (cwd / slug / 'brand.json').exists()
brand = json.loads((workspace / 'brand.json').read_text())
assert brand['ad_account_id'] == 'act_321' and brand['brand'] == 'brand'
(workspace / '.meta-state.json').write_text('{"keep":true}')
before = {p: p.read_bytes() for p in workspace.rglob('*') if p.is_file()}
assert run(['init', slug], home, cwd=cwd).returncode == 0
assert all(p.read_bytes() == data for p, data in before.items())
assert run(['init', './local-brand'], home, cwd=cwd).returncode == 0
assert (cwd / 'local-brand/brand.json').exists()
for case in ('root-link', 'root-dangling', 'root-file', 'account-link', 'media-link', 'brand-link'):
    h = base / case
    documents = h / 'Documents'
    documents.mkdir(parents=True)
    report = documents / 'dotads-meta-report'
    external = h / 'other-data'
    external.mkdir(mode=0o755)
    (external / 'keep.txt').write_text('preserve')
    if case.startswith('root-'):
        if case == 'root-file': report.write_text('preserve')
        else: report.symlink_to(external if case == 'root-link' else h / 'missing', target_is_directory=True)
    else:
        report.mkdir(mode=0o700)
        account = report / slug
        if case == 'account-link': account.symlink_to(external, target_is_directory=True)
        else:
            account.mkdir()
            if case == 'media-link': (account / 'media').symlink_to(external, target_is_directory=True)
            else: (account / 'brand.json').symlink_to(external / 'keep.txt')
    result = run(['init', slug, '--force'], h, cwd=cwd)
    assert result.returncode != 0, case
    assert sorted(p.name for p in external.iterdir()) == ['keep.txt'], case
    assert (external / 'keep.txt').read_text() == 'preserve' and stat.S_IMODE(external.stat().st_mode) == 0o755, case
    assert not (h / 'missing').exists()
for effect in ('denied', 'noop'):
    h = base / ('chmod-' + effect)
    root = h / 'Documents/dotads-meta-report'
    root.mkdir(parents=True, mode=0o755)
    root.chmod(0o755)
    hook = h / 'fs-fixture.cjs'
    hook.write_text("require('fs').fchmodSync = () => { " +
                    ("throw Object.assign(new Error('fixture EPERM'), {code:'EPERM'});" if effect == 'denied' else '') + ' };\n')
    result = run(['init', slug], h, cwd=cwd, extra={'NODE_OPTIONS': '--require=' + str(hook)})
    assert result.returncode != 0 and not (root / slug).exists(), effect
    assert stat.S_IMODE(root.stat().st_mode) == 0o755

# Fake provider processes; only dotads-meta itself and the filesystem are real.
provider = r'''
import json, os, pathlib, sys
home = pathlib.Path(os.environ['HOME'])
kind = pathlib.Path(sys.argv[0]).name
args = sys.argv[1:]
log = home / 'calls.jsonl'
past = [json.loads(x) for x in log.read_text().splitlines()] if log.exists() else []
with log.open('a') as f: f.write(json.dumps([kind, *args]) + '\n')
case = os.environ['SETUP_CASE']
shared = pathlib.Path(os.environ['PIPX_SHARED_LIBS'])
if kind == 'meta':
    if (home / 'installed').exists(): print('meta, version ' + ('11.2.0' if case == 'wrong-version' else '1.2.0')); sys.exit(0)
    sys.exit(1)
if kind == 'pipx' and args == ['--version']: print('1.4.3'); sys.exit(0)
if kind == 'pipx' and args[:1] == ['environment']: print(shared); sys.exit(0)
if kind == 'pipx' and args[:1] == ['install']:
    count = sum(x[:2] == ['pipx', 'install'] for x in past)
    if case == 'missing-binary': sys.exit(0)
    if case in ('install-success', 'wrong-version') or (case == 'recovery-success' and count == 1):
        (home / 'installed').touch(); sys.exit(0)
    sys.exit(7)
if kind == 'python3':
    (shared / 'bin').mkdir(parents=True, exist_ok=True)
    (shared / 'bin/python').touch()
    sys.exit(9 if case == 'venv-failed' else 0)
if kind == 'pip':
    if case == 'bootstrap-failed': sys.exit(8)
    (shared / 'bin/pip').touch(); sys.exit(0)
sys.exit(99)
'''
for case in ('install-success', 'missing-binary', 'wrong-version', 'recovery-success', 'venv-failed', 'bootstrap-failed', 'retry-failed', 'shared-healthy', 'no-bootstrap'):
    h = base / case
    fake = h / 'fake-bin'
    fake.mkdir(parents=True)
    shared = h / 'custom-pipx/shared'
    bootstrap = h / '.local/share/pipx-bootstrap/bin/pip'
    commands = [fake / 'meta', fake / 'pipx', fake / 'python3']
    if case != 'no-bootstrap':
        bootstrap.parent.mkdir(parents=True)
        commands.append(bootstrap)
    if case == 'shared-healthy':
        (shared / 'bin').mkdir(parents=True)
        (shared / 'bin/pip').touch()
    for executable in commands:
        executable.write_text('#!' + sys.executable + '\n' + provider)
        executable.chmod(0o755)
    result = run(['setup'], h, cwd=cwd, extra={
        'PATH': str(fake) + os.pathsep + env['PATH'], 'META_ADS_BIN': str(fake / 'meta'),
        'SETUP_CASE': case, 'PIPX_HOME': str(h / 'custom-pipx'), 'PIPX_SHARED_LIBS': str(shared)})
    assert (result.returncode == 0) == (case in ('install-success', 'recovery-success')), (case, result.stderr)
    calls = [json.loads(x) for x in (h / 'calls.jsonl').read_text().splitlines()]
    installs = sum(x[:2] == ['pipx', 'install'] for x in calls)
    assert installs == (2 if case in ('recovery-success', 'retry-failed') else 1), (case, calls)
    if case == 'venv-failed': assert not any(x[0] == 'pip' for x in calls), calls
    if case in ('shared-healthy', 'no-bootstrap', 'install-success', 'missing-binary', 'wrong-version'):
        assert not any(x[0] in ('python3', 'pip') for x in calls), calls
    assert not (h / '.local/share/pipx/shared').exists(), case
print('PASS workspace routing, preservation, symlink/permission rejection and bounded pipx recovery with custom paths')
PYTEST
if [ "$?" -eq 0 ]; then
  ok "workspace setup/init public filesystem and process contracts"
else
  bad "workspace setup/init contract failed"
fi

# 5b. Dry-run makes zero calls to meta CLI and forces PAUSED even if manifest has ACTIVE
jq '.campaign.status = "ACTIVE" | .ads[0].status = "ACTIVE"' "$WS/campaigns/sample-campaign.json" > "$WS/campaigns/active-manifest.json"
dry_out="$("$CMD" deploy "$WS/campaigns/active-manifest.json" 2>&1)"
if [ "$?" -eq 0 ] \
  && [ ! -f "$META_LOG" ] \
  && [ ! -f "$WS/.meta-state.json" ] \
  && printf '%s' "$dry_out" | grep -q 'PAUSED FORCED' \
  && ! printf '%s' "$dry_out" | grep -q -- '--status ACTIVE'; then
  ok "deploy without --apply performs a dry-run, forces PAUSED status, and makes zero API calls"
else
  bad "dry-run failed or leaked ACTIVE / API calls: $dry_out"
fi

# 5c. Deploy with --apply executes L3->L1, injects secret via env only, and writes .meta-state.json
apply_out="$("$CMD" deploy "$WS/campaigns/active-manifest.json" --apply 2>&1)"
if [ "$?" -eq 0 ] \
  && [ -f "$WS/.meta-state.json" ] \
  && [ "$(wc -l < "$META_LOG" | tr -d ' ')" -eq 4 ] \
  && ! printf '%s' "$apply_out" | grep -q 'MOCK_SYSTEM_USER_TOKEN_SECRET_999' \
  && jq -e '.campaigns.camp_sales_cbo.id == "camp_1001" and .creatives.cr_hero_v1.id == "cr_2001" and .adsets.adset_broad_id.id == "adset_3001" and .ads.ad_hero_v1.id == "ad_4001"' "$WS/.meta-state.json" >/dev/null; then
  ok "deploy --apply creates campaign->creative->adset->ad and persists .meta-state.json"
else
  bad "deploy --apply failed: $apply_out"
fi

# 5d. Idempotent re-run of deploy --apply skips all 4 steps
"$CMD" deploy "$WS/campaigns/active-manifest.json" --apply >/dev/null 2>&1
if [ "$(wc -l < "$META_LOG" | tr -d ' ')" -eq 4 ]; then
  ok "re-running deploy --apply is idempotent and skips already-created entities"
else
  bad "re-running deploy --apply called meta CLI again ($(wc -l < "$META_LOG") lines)"
fi

# 5e. Drift detection warns when a deployed entity's spec changes under the same key
jq '.creatives[0].title = "Edited Headline Without Bumping Key"' "$WS/campaigns/active-manifest.json" > "$WS/campaigns/drifted-manifest.json"
drift_out="$("$CMD" deploy "$WS/campaigns/drifted-manifest.json" 2>&1)"
if [ "$?" -eq 0 ] && printf '%s' "$drift_out" | grep -q 'DRIFT: local manifest'; then
  ok "deploy warns on spec drift when manifest changes for an already-created entity key"
else
  bad "deploy did not warn on spec drift: $drift_out"
fi

# 5f. Adding a second creative referencing the same image SHA-256 reuses --image-hash from media_cache
jq '.creatives += [{"key":"cr_hero_v2","name":"Creative_Hero_V2","image":"media/hero.jpg","title":"Second Headline","body":"Second body","link_url":"https://example.com/products/flagship","call_to_action":"SHOP_NOW"}]' \
  "$WS/campaigns/active-manifest.json" > "$WS/campaigns/second-creative.json"
"$CMD" deploy "$WS/campaigns/second-creative.json" --apply >/dev/null 2>&1
last_call="$(tail -n 1 "$META_LOG")"
if [ "$(wc -l < "$META_LOG" | tr -d ' ')" -eq 5 ] && printf '%s' "$last_call" | grep -q -- '--image-hash hash_hero_abc123'; then
  ok "second creative with identical media SHA-256 reuses cached --image-hash instead of re-uploading"
else
  bad "second creative did not reuse --image-hash: $last_call"
fi

