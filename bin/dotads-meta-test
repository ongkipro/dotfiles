 'source':{'kind':'OFFLINE_FIXTURE','sdk_version':'24.0.1','api_version':'v24.0','effective_api_version':None,'started_at':'2026-10-01T00:00:00Z','finished_at':'2026-10-01T00:01:00Z'},
