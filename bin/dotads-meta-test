#!/usr/bin/env bash
# Behavioral regression suite for bin/dotads-meta.
set -uo pipefail

ROOT="${1:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
CMD="$ROOT/bin/dotads-meta"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/dotads-meta-test.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

f=0
ok()  { printf '  ✓ %s\n' "$1"; }
bad() { printf '  FAIL %s\n' "$1" >&2; f=$((f + 1)); }

# 1. Surface & read-only --help check
BEFORE="$(git -C "$ROOT" status --porcelain | sort)"
help_out="$("$CMD" --help 2>&1 || true)"
printf '%s' "$help_out" | grep -qE 'setup|init|validate|deploy|status|doctor|run' \
  && ok "describes its subcommands on --help" \
  || bad "missing usage output on --help"
[ "$(git -C "$ROOT" status --porcelain | sort)" = "$BEFORE" ] \
  && ok "--help does not modify the repository" \
  || bad "--help modified the repository"

"$CMD" unknown-subcommand >/dev/null 2>&1 \
  && bad "accepted an unknown subcommand" \
  || ok "rejects an unknown subcommand"

# Pin the public command surface and reject retired naming across maintained files.
if printf '%s' "$help_out" | grep -q '^Usage: dotads-meta ' \
  && grep -qxF 'dotads-meta' "$ROOT/config/ai/runtime-commands.txt" \
  && grep -qxF 'dotads-meta-test' "$ROOT/config/ai/runtime-commands.txt"; then
  ok "canonical command and regression suite remain installable"
else
  bad "canonical command help or installer manifest is incomplete"
fi
retired_name='meta-ads-ops'
retired_refs="$(cd "$ROOT" && rg --files-with-matches --hidden --glob '!.git/**' --glob '!.delivery/**' --glob '!bin/dotads-meta-test' --fixed-strings "$retired_name" . 2>&1)"
retired_rc=$?
if [ "$retired_rc" -eq 1 ] \
  && [ ! -e "$ROOT/bin/$retired_name" ] && [ ! -L "$ROOT/bin/$retired_name" ] \
  && [ ! -e "$ROOT/bin/$retired_name-test" ] && [ ! -L "$ROOT/bin/$retired_name-test" ]; then
  ok "retired commands and references stay absent outside immutable execution evidence"
else
  bad "retired command or reference reintroduced (or search failed): $retired_refs"
fi

# 2. Scaffold workspace via init
WS="$TMP/brand-alpha"
"$CMD" init "$WS" >/dev/null 2>&1 \
  && [ -f "$WS/brand.json" ] \
  && [ -f "$WS/campaigns/sample-campaign.json" ] \
  && [ -d "$WS/media" ] \
  && grep -qxF '.meta-state.json' "$WS/.gitignore" \
  && ok "init scaffolds brand.json, sample-campaign.json, media/, and .gitignore" \
  || bad "init failed to scaffold workspace"

# Create dummy image asset for sample campaign
printf '\x89PNG\r\n\x1a\nfake-image-bytes' > "$WS/media/hero.jpg"

# Idempotency of init without --force
cp "$WS/brand.json" "$WS/brand.json.orig"
"$CMD" init "$WS" >/dev/null 2>&1
cmp -s "$WS/brand.json" "$WS/brand.json.orig" \
  && ok "init preserves existing files without --force" \
  || bad "init overwrote existing brand.json without --force"

# 3. Offline validation passes on valid CBO OUTCOME_SALES manifest
val_out="$("$CMD" validate "$WS/campaigns/sample-campaign.json" 2>&1)"
if [ "$?" -eq 0 ] && printf '%s' "$val_out" | grep -q 'Validation PASSED' && printf '%s' "$val_out" | grep -q '50.00 USD'; then
  ok "validate passes on valid CBO OUTCOME_SALES campaign and prints minor/major budget summary"
else
  bad "validate failed on valid sample campaign: $val_out"
fi

# 3b. Zero-decimal currency (IDR) explicit offset warning
jq '.currency = "IDR"' "$WS/brand.json" > "$WS/brand-idr.json"
idr_out="$("$CMD" validate "$WS/campaigns/sample-campaign.json" --brand "$WS/brand-idr.json" 2>&1)"
if [ "$?" -eq 0 ] && printf '%s' "$idr_out" | grep -q 'offset-1 OR'; then
  ok "validate surfaces explicit offset-1 vs /100 guidance for zero-decimal currencies (IDR)"
else
  bad "validate did not surface zero-decimal currency guidance for IDR: $idr_out"
fi

# 4. Trap guards in validate
# 4a. CBO + ABO budget collision (Error 1885621 guard)
jq '.adsets[0].daily_budget = 2000' "$WS/campaigns/sample-campaign.json" > "$WS/campaigns/cbo-abo-collision.json"
collision_out="$("$CMD" validate "$WS/campaigns/cbo-abo-collision.json" 2>&1)"
if [ "$?" -ne 0 ] && printf '%s' "$collision_out" | grep -q '1885621'; then
  ok "validate rejects CBO + ABO budget collision (Error 1885621 guard)"
else
  bad "validate allowed CBO + ABO budget collision: $collision_out"
fi

# 4b. Missing conversion_domain on OUTCOME_SALES
jq '.conversion_domain = ""' "$WS/brand.json" > "$WS/brand-no-domain.json"
nodomain_out="$("$CMD" validate "$WS/campaigns/sample-campaign.json" --brand "$WS/brand-no-domain.json" 2>&1)"
if [ "$?" -ne 0 ] && printf '%s' "$nodomain_out" | grep -q 'conversion_domain'; then
  ok "validate rejects OUTCOME_SALES ad without conversion_domain"
else
  bad "validate allowed OUTCOME_SALES ad without conversion_domain: $nodomain_out"
fi

# 4c. DCO creative without dynamic_creative: true on ad set
jq '.creatives[0].titles = ["Title 1", "Title 2"]' "$WS/campaigns/sample-campaign.json" > "$WS/campaigns/dco-missing-flag.json"
dco_out="$("$CMD" validate "$WS/campaigns/dco-missing-flag.json" 2>&1)"
if [ "$?" -ne 0 ] && printf '%s' "$dco_out" | grep -q 'dynamic_creative'; then
  ok "validate rejects DCO creative when ad set lacks dynamic_creative: true"
else
  bad "validate allowed DCO creative on non-dynamic ad set: $dco_out"
fi

# 4d. Missing local media file
jq '.creatives[0].image = "media/does-not-exist.jpg"' "$WS/campaigns/sample-campaign.json" > "$WS/campaigns/missing-media.json"
media_out="$("$CMD" validate "$WS/campaigns/missing-media.json" 2>&1)"
if [ "$?" -ne 0 ] && printf '%s' "$media_out" | grep -q 'file not found'; then
  ok "validate rejects missing local media file"
else
  bad "validate allowed missing local media file: $media_out"
fi

# 5. Mock `meta` and `secrets-env` binaries for setup, dry-run, deploy --apply, state resume, drift detection, and media hash dedup
MOCK_BIN="$TMP/mock-bin"
META_LOG="$TMP/meta-invocations.log"
mkdir -p "$MOCK_BIN"

cat > "$MOCK_BIN/secrets-env" <<'EOF'
#!/usr/bin/env bash
if [ "${1:-}" = "get" ] && [ "${2:-}" = "META_ACCESS_TOKEN" ]; then
  printf 'MOCK_SYSTEM_USER_TOKEN_SECRET_999\n'
  exit 0
fi
exit 1
EOF
chmod +x "$MOCK_BIN/secrets-env"

cat > "$MOCK_BIN/meta" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [ "${1:-}" = "--version" ]; then
  echo "meta, version 1.2.0"
  exit 0
fi
if [ "${1:-}" = "auth" ] && [ "${2:-}" = "status" ]; then
  if [ -n "${ACCESS_TOKEN:-}" ]; then
    echo "Authenticated via ACCESS_TOKEN"
    exit 0
  fi
  echo "Not authenticated. Set the ACCESS_TOKEN environment variable."
  exit 0
fi

if [ -n "${EXPECTED_AD_ACCOUNT_ID:-}" ] && [ "${AD_ACCOUNT_ID:-}" != "$EXPECTED_AD_ACCOUNT_ID" ]; then
  echo "Wrong ad account environment" >&2
  exit 98
fi
if [ "${EXPECTED_BUSINESS_ID+x}" = x ] && [ "${BUSINESS_ID:-}" != "$EXPECTED_BUSINESS_ID" ]; then
  echo "Wrong business environment" >&2
  exit 98
fi

# Record invocation args and verify ACCESS_TOKEN is in env, never in args
printf 'TOKEN_LEN=%d ARGS=%s\n' "${#ACCESS_TOKEN}" "$*" >> "$META_LOG"
case "$*" in
  *MOCK_SYSTEM_USER_TOKEN_SECRET_999*)
    echo "SECRET LEAKED IN CLI ARGS" >&2
    exit 99
    ;;
esac

# Verify global flags precede `ads`
if [ "${1:-}" != "--output" ] || [ "${2:-}" != "json" ] || [ "${3:-}" != "--no-input" ] || [ "${4:-}" != "ads" ]; then
  echo "Invalid global flag ordering: $*" >&2
  exit 2
fi

case "$*" in
  *" campaign create "*)
    printf '[\n  {\n    "id": "camp_1001",\n    "name": "Sales_CBO_Launch"\n  }\n]\n'
    ;;
  *" creative create "*)
    if [[ "$*" == *"--image-hash"* ]]; then
      printf '[\n  {\n    "id": "cr_2002",\n    "image_hash": "hash_hero_abc123"\n  }\n]\n'
    else
      printf '[\n  {\n    "id": "cr_2001",\n    "image_hash": "hash_hero_abc123"\n  }\n]\n'
    fi
    ;;
  *" adset create "*)
    printf '[\n  {\n    "id": "adset_3001",\n    "name": "AdSet_Broad_ID"\n  }\n]\n'
    ;;
  *" ad create "*)
    printf '[\n  {\n    "id": "ad_4001",\n    "name": "Ad_Hero_V1"\n  }\n]\n'
    ;;
  *" campaign list"*)
    printf '[\n  {\n    "id": "camp_1001"\n  }\n]\n'
    ;;
  *)
    echo "Unexpected mock meta command: $*" >&2
    exit 3
    ;;
esac
EOF
chmod +x "$MOCK_BIN/meta"

export META_ADS_BIN="$MOCK_BIN/meta"
export SECRETS_ENV_BIN="$MOCK_BIN/secrets-env"
export META_LOG

# 5a. setup subcommand detects installed meta-ads CLI
setup_out="$("$CMD" setup 2>&1)"
if [ "$?" -eq 0 ] && printf '%s' "$setup_out" | grep -q 'already installed'; then
  ok "setup detects already-installed meta-ads binary"
else
  bad "setup failed: $setup_out"
fi

# 5b. Dry-run makes zero calls to meta CLI and forces PAUSED even if manifest has ACTIVE
jq '.campaign.status = "ACTIVE" | .ads[0].status = "ACTIVE"' "$WS/campaigns/sample-campaign.json" > "$WS/campaigns/active-manifest.json"
dry_out="$("$CMD" deploy "$WS/campaigns/active-manifest.json" 2>&1)"
if [ "$?" -eq 0 ] \
  && [ ! -f "$META_LOG" ] \
  && [ ! -f "$WS/.meta-state.json" ] \
  && printf '%s' "$dry_out" | grep -q 'PAUSED FORCED' \
  && ! printf '%s' "$dry_out" | grep -q -- '--status ACTIVE'; then
  ok "deploy without --apply performs a dry-run, forces PAUSED status, and makes zero API calls"
else
  bad "dry-run failed or leaked ACTIVE / API calls: $dry_out"
fi

# 5c. Deploy with --apply executes L3->L1, injects secret via env only, and writes .meta-state.json
apply_out="$("$CMD" deploy "$WS/campaigns/active-manifest.json" --apply 2>&1)"
if [ "$?" -eq 0 ] \
  && [ -f "$WS/.meta-state.json" ] \
  && [ "$(wc -l < "$META_LOG" | tr -d ' ')" -eq 4 ] \
  && ! printf '%s' "$apply_out" | grep -q 'MOCK_SYSTEM_USER_TOKEN_SECRET_999' \
  && jq -e '.campaigns.camp_sales_cbo.id == "camp_1001" and .creatives.cr_hero_v1.id == "cr_2001" and .adsets.adset_broad_id.id == "adset_3001" and .ads.ad_hero_v1.id == "ad_4001"' "$WS/.meta-state.json" >/dev/null; then
  ok "deploy --apply creates campaign->creative->adset->ad and persists .meta-state.json"
else
  bad "deploy --apply failed: $apply_out"
fi

# 5d. Idempotent re-run of deploy --apply skips all 4 steps
"$CMD" deploy "$WS/campaigns/active-manifest.json" --apply >/dev/null 2>&1
if [ "$(wc -l < "$META_LOG" | tr -d ' ')" -eq 4 ]; then
  ok "re-running deploy --apply is idempotent and skips already-created entities"
else
  bad "re-running deploy --apply called meta CLI again ($(wc -l < "$META_LOG") lines)"
fi

# 5e. Drift detection warns when a deployed entity's spec changes under the same key
jq '.creatives[0].title = "Edited Headline Without Bumping Key"' "$WS/campaigns/active-manifest.json" > "$WS/campaigns/drifted-manifest.json"
drift_out="$("$CMD" deploy "$WS/campaigns/drifted-manifest.json" 2>&1)"
if [ "$?" -eq 0 ] && printf '%s' "$drift_out" | grep -q 'DRIFT: local manifest'; then
  ok "deploy warns on spec drift when manifest changes for an already-created entity key"
else
  bad "deploy did not warn on spec drift: $drift_out"
fi

# 5f. Adding a second creative referencing the same image SHA-256 reuses --image-hash from media_cache
jq '.creatives += [{"key":"cr_hero_v2","name":"Creative_Hero_V2","image":"media/hero.jpg","title":"Second Headline","body":"Second body","link_url":"https://example.com/products/flagship","call_to_action":"SHOP_NOW"}]' \
  "$WS/campaigns/active-manifest.json" > "$WS/campaigns/second-creative.json"
"$CMD" deploy "$WS/campaigns/second-creative.json" --apply >/dev/null 2>&1
last_call="$(tail -n 1 "$META_LOG")"
if [ "$(wc -l < "$META_LOG" | tr -d ' ')" -eq 5 ] && printf '%s' "$last_call" | grep -q -- '--image-hash hash_hero_abc123'; then
  ok "second creative with identical media SHA-256 reuses cached --image-hash instead of re-uploading"
else
  bad "second creative did not reuse --image-hash: $last_call"
fi

# 6. status, doctor & run subcommands
status_out="$("$CMD" status --brand "$WS/brand.json" --json 2>&1)"
if [ "$?" -eq 0 ] && printf '%s' "$status_out" | jq -e '.exists == true and .state.campaigns.camp_sales_cbo.id == "camp_1001" and .state.creatives.cr_hero_v2.id == "cr_2002"' >/dev/null; then
  ok "status reports deployed entity IDs and media cache from .meta-state.json"
else
  bad "status failed: $status_out"
fi

doc_out="$("$CMD" doctor --brand "$WS/brand.json" 2>&1)"
if [ "$?" -eq 0 ] \
  && printf '%s' "$doc_out" | grep -q 'Authenticated via ACCESS_TOKEN' \
  && ! printf '%s' "$doc_out" | grep -q 'MOCK_SYSTEM_USER_TOKEN_SECRET_999'; then
  ok "doctor verifies meta CLI, secrets-env token (redacted), and auth status"
else
  bad "doctor failed: $doc_out"
fi

run_out="$("$CMD" run --brand "$WS/brand.json" -- --output json --no-input ads --ad-account-id act_1234567890 campaign list 2>&1)"
if [ "$?" -eq 0 ] && printf '%s' "$run_out" | grep -q '"camp_1001"'; then
  ok "run bridges secrets-env and brand.json to raw meta CLI commands"
else
  bad "run failed: $run_out"
fi

# A corrupt state file must never be silently reset into a fresh deployment.
cp "$WS/.meta-state.json" "$TMP/good-state.json"
for invalid_state in '{"campaigns":' 'null' '{"version":2}' '{"version":1,"campaigns":[]}' '{"version":1,"media_cache":{},"campaigns":{},"creatives":{},"adsets":{},"ads":{"ad":{"name":"missing ID"}}}'; do
  printf '%s\n' "$invalid_state" > "$WS/.meta-state.json"
  calls_before="$(wc -l < "$META_LOG")"
  invalid_out="$("$CMD" deploy "$WS/campaigns/active-manifest.json" --apply 2>&1)"
  invalid_rc=$?
  if [ "$invalid_rc" -ne 0 ] \
    && [ "$(wc -l < "$META_LOG")" = "$calls_before" ] \
    && [ "$(cat "$WS/.meta-state.json")" = "$invalid_state" ]; then
    ok "invalid state blocks deployment without API calls or data loss: $invalid_state"
  else
    bad "invalid state allowed a deployment or changed persisted data: $invalid_state"
  fi
  "$CMD" status --brand "$WS/brand.json" --json >/dev/null 2>&1 \
    && bad "status accepted invalid state: $invalid_state" \
    || ok "status rejects invalid persisted state"
done
cp "$TMP/good-state.json" "$WS/.meta-state.json"

# An explicit brand must win over unrelated account defaults in the parent shell.
brand_account="$(jq -r '.ad_account_id' "$WS/brand.json")"
brand_business="$(jq -r '.business_id' "$WS/brand.json")"
brand_out="$(AD_ACCOUNT_ID=act_999999 BUSINESS_ID=999999 EXPECTED_AD_ACCOUNT_ID="$brand_account" EXPECTED_BUSINESS_ID="$brand_business" \
  "$CMD" run --brand "$WS/brand.json" -- --output json --no-input ads campaign list 2>&1)"
if [ "$?" -eq 0 ] && printf '%s' "$brand_out" | grep -q '"camp_1001"'; then
  ok "explicit brand overrides inherited ad account and business defaults"
else
  bad "parent account defaults overrode explicit brand: $brand_out"
fi

# No business in the selected brand must not pick a different shell default.
jq 'del(.business_id)' "$WS/brand.json" > "$WS/brand-no-business.json"
BUSINESS_ID=999999 EXPECTED_BUSINESS_ID= "$CMD" run --brand "$WS/brand-no-business.json" -- --output json --no-input ads campaign list >/dev/null 2>&1 \
  && ok "brand without business clears inherited business defaults" \
  || bad "brand without business inherited an unrelated business"

jq '.creatives += [.creatives[0] | .key = "cr_no_business"]' "$WS/campaigns/active-manifest.json" > "$WS/campaigns/no-business.json"
BUSINESS_ID=999999 EXPECTED_BUSINESS_ID= "$CMD" deploy "$WS/campaigns/no-business.json" --brand "$WS/brand-no-business.json" --apply >/dev/null 2>&1 \
  && ok "deployment without a business clears inherited business defaults" \
  || bad "deployment without a business inherited an unrelated business"
cp "$WS/.meta-state.json" "$TMP/good-state.json"

# Simulate interruption during state writing after a remote creation succeeded.
cat > "$TMP/fail-state-write.cjs" <<'EOF'
const fs = require('node:fs');
const write = fs.writeFileSync;
fs.writeFileSync = function(file, data, options) {
  if (String(file).includes('.meta-state.json')) {
    write(file, '{"interrupted":', options);
    throw new Error('Simulated state write failure');
  }
  return write.apply(this, arguments);
};
EOF
jq '.creatives += [.creatives[0] | .key = "cr_write_failure"]' "$WS/campaigns/active-manifest.json" > "$WS/campaigns/write-failure.json"
failure_out="$(NODE_OPTIONS="--require=$TMP/fail-state-write.cjs" "$CMD" deploy "$WS/campaigns/write-failure.json" --apply 2>&1)"
if [ "$?" -ne 0 ] \
  && printf '%s' "$failure_out" | grep -q 'Simulated state write failure' \
  && cmp -s "$TMP/good-state.json" "$WS/.meta-state.json" \
  && [ -d "$WS/.dotads-meta.lock" ] \
  && [ -z "$(find "$WS" -name '.meta-state.json.*.tmp' -print)" ]; then
  ok "interrupted state write preserves previous IDs and cleans its temporary file"
else
  bad "interrupted state write lost previous deployment state or temporary-file cleanup: $failure_out"
fi

# Account/parent identities, default drift, duplicate keys and concurrent writers.
if python3 - "$CMD" <<'PYTEST'
from pathlib import Path
import json, os, subprocess, sys, tempfile, time
cmd = sys.argv[1]
with tempfile.TemporaryDirectory(prefix='dotads-integrity-') as tmp:
    root = Path(tmp); ws = root/'ws'
    subprocess.run([cmd, 'init', str(ws)], check=True, capture_output=True)
    (ws/'media/hero.jpg').write_bytes(b'synthetic image')
    mock = root/'meta'
    mock.write_text('''#!/usr/bin/env python3
import json, os, time
from pathlib import Path
r=Path(os.environ['FIXTURE_ROOT'])
with (r/'calls').open('a') as f: f.write('create\\n')
(r/'started').touch()
time.sleep(float(os.environ.get('FIXTURE_DELAY','0')))
print(json.dumps({'id':str(os.getpid())}))
'''); mock.chmod(0o755)
    secret = root/'secrets-env'
    secret.write_text('#!/bin/sh\nprintf "synthetic-fixture-value\\n"\n'); secret.chmod(0o755)
    env = dict(os.environ, META_ADS_BIN=str(mock), SECRETS_ENV_BIN=str(secret), FIXTURE_ROOT=str(root))
    manifest = ws/'campaigns/sample-campaign.json'; brandpath = ws/'brand.json'; statepath = ws/'.meta-state.json'
    original = json.loads(manifest.read_text()); brand = json.loads(brandpath.read_text())
    def run(apply=True):
        return subprocess.run([cmd,'deploy',str(manifest),'--json',*(['--apply'] if apply else [])],env=env,capture_output=True,text=True)
    def save(file, value): file.write_text(json.dumps(value))
    def rejected(label):
        before = (root/'calls').read_bytes() if (root/'calls').exists() else b''
        r = run(); assert r.returncode != 0, (label,r.stdout)
        after = (root/'calls').read_bytes() if (root/'calls').exists() else b''
        assert before == after, label+' made remote calls'
        print('  PASS '+label)
    for value in ['', '  ', 23, None]:
        data = json.loads(json.dumps(original)); data['ads'][0]['key'] = value
        # null means fallback-to-name; explicit invalid values must still fail.
        if value is None: data['ads'][0]['name'] = None
        save(manifest,data); rejected('invalid effective ad key '+repr(value))
    data=json.loads(json.dumps(original)); data['ads'].append(dict(data['ads'][0],name='second ad'))
    save(manifest,data); rejected('duplicate ad identity')
    # Prototype-named keys are valid strings and cannot masquerade as saved IDs.
    data=json.loads(json.dumps(original)); data['adsets'][0]['key']='toString'; data['ads'][0]['adset']='toString'
    save(manifest,data)
    r=run(False); assert r.returncode==0 and all(step['action']=='CREATE' for step in json.loads(r.stdout)['steps']),r.stderr
    print('  PASS prototype-named key does not inherit a saved record')
    save(manifest, original)
    args=[cmd,'deploy',str(manifest),'--apply','--json']
    first=subprocess.Popen(args,env=dict(env,FIXTURE_DELAY='0.25'),stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True)
    deadline=time.monotonic()+5
    while not (root/'started').exists():
        assert time.monotonic()<deadline,'first apply did not start'; time.sleep(.01)
    second=run(); assert second.returncode != 0 and 'lock exists' in second.stderr,second.stderr
    out,err=first.communicate(timeout=10); assert first.returncode==0,err
    assert len((root/'calls').read_text().splitlines())==4,'concurrent duplicate creation'
    assert not (ws/'.dotads-meta.lock').exists()
    assert run().returncode==0 and len((root/'calls').read_text().splitlines())==4
    print('  PASS concurrent apply excluded; resumed apply reuses all IDs')
    state=json.loads(statepath.read_text()); assert state['ad_account_id']==brand['ad_account_id']
    save(brandpath,dict(brand,ad_account_id='act_999999999')); rejected('account change')
    save(brandpath,brand)
    data=json.loads(json.dumps(original)); data['campaign']['key']='new-campaign'
    save(manifest,data); rejected('campaign parent change')
    save(manifest,original)
    altered=json.loads(json.dumps(state)); del altered['ads'][original['ads'][0]['key']]['creative_id']
    save(statepath,altered); rejected('missing saved parent')
    altered=json.loads(json.dumps(state)); del altered['ad_account_id']
    save(statepath,altered); rejected('unbound legacy state')
    assert json.loads(statepath.read_text())==altered
    save(statepath,state)
    save(brandpath,dict(brand,page_id='999999',pixel_id='888888',conversion_domain='new.example.invalid'))
    r=run(False); assert r.returncode==0,r.stderr
    steps=json.loads(r.stdout)['steps']; assert all(s['drift'] for s in steps if s['kind']!='campaign'),steps
    print('  PASS effective brand defaults participate in drift')
    save(brandpath,brand)
    # DCO media content is part of creative identity even with stable paths.
    data=json.loads(json.dumps(original)); cr=data['creatives'][0]
    cr['key']='dco'; cr['images']=[cr.pop('image')]
    data['adsets'][0]['key']='dynamic'; data['adsets'][0]['dynamic_creative']=True
    data['ads'][0].update(key='dynamic-ad',adset='dynamic',creative='dco')
    save(manifest,data); r=run(); assert r.returncode==0,r.stderr
    (ws/'media/hero.jpg').write_bytes(b'changed DCO image')
    r=run(False); assert r.returncode==0,r.stderr
    assert next(step for step in json.loads(r.stdout)['steps'] if step['kind']=='creative')['drift']
    print('  PASS DCO content changes cause creative drift')
    lock=ws/'.dotads-meta.lock'; lock.mkdir(); (lock/'owner.json').write_text('{"pid":0}')
    rejected('stale lock requires explicit reconciliation')
PYTEST
then ok "deployment identity and single-writer regressions"; else bad "deployment identity or lock regression"; fi

[ "$f" -eq 0 ] && { echo "dotads-meta-test: PASS"; exit 0; }
echo "dotads-meta-test: $f case(s) failed" >&2
exit 1
