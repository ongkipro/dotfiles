import importlib.util,json,pathlib,sys
spec=importlib.util.spec_from_file_location('provider',sys.argv[1]);provider=importlib.util.module_from_spec(spec);spec.loader.exec_module(provider)
request=provider.validate(json.load(sys.stdin));scope=provider.planned_scope(request)
if '--plan' in sys.argv: print(json.dumps({'request':request,'scope':scope}));sys.exit(0)
base=pathlib.Path(__file__).parent
if (base/'provider-failed').exists(): print('synthetic-fixture-token',file=sys.stderr);sys.exit(8)
value=json.loads((base/'export.json').read_text());value['scope']=scope
print(json.dumps(value))
''')
fake.chmod(0o755)
