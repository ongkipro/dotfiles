#!/usr/bin/env bash
# ai-memory-link-test — the sealed bootstrap, attacked.
#
# This one function produced a defect in three consecutive review rounds, all of
# the same family: a refusal that damages what it refuses to touch, and a write
# that escapes the directory it is supposed to seal. It had no test at all, which
# is why each fix was verified by reading rather than by running.
#
# Everything runs under a scratch HOME. The command is driven end to end rather
# than by extracting the function, so the real control flow is what is judged.
set -uo pipefail
ROOT="${DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
LINK="$ROOT/bin/ai-memory-link"
TMP="$(mktemp -d)"; trap 'chmod -R u+rwX "$TMP" 2>/dev/null; rm -rf "$TMP"' EXIT
fails=0
say() { printf '  %-4s %s\n' "$1" "$2"; }
mode() { stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1" 2>/dev/null; }
check() { if [ "$2" = "$3" ]; then say ok "$1"; else
  say FAIL "$1"; printf '       expected %q, got %q\n' "$3" "$2"; fails=$((fails + 1)); fi; }

SLUG=""
new_home() {
  H="$TMP/h$1"; rm -rf "$H"
  # The command only visits a config directory that already exists, and reads its
  # bootstrap source from $HOME/dotfiles — both are prerequisites, not details.
  mkdir -p "$H/.config/ai" "$H/.claude"
  # A COPY, never a symlink to the real repository. The version this file
  # replaced already did that; symlinking $ROOT in was a regression, and case 9
  # then chmod 000'd a TRACKED file through it — restored only if the suite ran
  # to completion. A test must not be able to damage the repository it tests.
  mkdir -p "$H/dotfiles/config/ai/claude-home-memory"
  cp "$ROOT/config/ai/claude-home-memory/MEMORY.md" \
     "$H/dotfiles/config/ai/claude-home-memory/MEMORY.md"
  cp "$ROOT/config/ai/CORE.md" "$H/.config/ai/CORE.md"
  cp -R "$ROOT/config/ai/adapters" "$H/.config/ai/adapters"
  chmod u+w "$H/dotfiles/config/ai/claude-home-memory/MEMORY.md"
  SRC_COPY="$H/dotfiles/config/ai/claude-home-memory/MEMORY.md"
  SLUG="$(printf '%s' "$H" | tr '/' '-')"
  RT="$H/.config/ai-local/claude-home-bootstrap/$(printf '%s' "$H/.claude" | tr '/ ' '--')"
  DST="$H/.claude/projects/$SLUG/memory"
}
run() { HOME="$H" DOTFILES_DIR="$ROOT" "$LINK" >"$TMP/out" 2>&1; }

# 1. First install builds it sealed.
new_home 1; run
check "first install seals the directory" "$(mode "$RT")" "500"
check "first install writes a read-only file" "$(mode "$RT/MEMORY.md")" "400"
check "first install creates the symlink" "$([ -L "$DST" ] && echo yes || echo no)" "yes"

# 2. Re-running is a no-op that never opens the directory.
run
check "refresh leaves the directory sealed" "$(mode "$RT")" "500"
check "refresh leaves exactly one file" "$(find "$RT" -mindepth 1 | wc -l | tr -d ' ')" "1"
check "refresh re-seals the file" "$(mode "$RT/MEMORY.md")" "400"
check "refresh copies the source exactly" \
  "$(cmp -s "$SRC_COPY" "$RT/MEMORY.md" && echo same || echo differs)" "same"

# 3. A symlinked MEMORY.md must not be written through. `[ -f ]` follows
#    symlinks, so truncate-in-place turned the sealed bootstrap into an
#    arbitrary-file overwrite: the victim's content was replaced and chmodded.
new_home 3; run
printf 'PRECIOUS\n' > "$TMP/victim"; victim_mode="$(mode "$TMP/victim")"
chmod 700 "$RT"; rm -f "$RT/MEMORY.md"; ln -s "$TMP/victim" "$RT/MEMORY.md"; chmod 500 "$RT"
run
check "a symlinked MEMORY.md is refused" \
  "$(grep -c 'not a regular file' "$TMP/out")" "1"
check "the victim file is untouched" "$(cat "$TMP/victim")" "PRECIOUS"
check "the victim keeps its mode" "$(mode "$TMP/victim")" "$victim_mode"
check "refusing does not destroy the symlink" "$([ -L "$DST" ] && echo yes || echo no)" "yes"

# 4. Contamination is refused, and the symlink survives that too.
new_home 4; run
chmod 700 "$RT"; : > "$RT/stray.md"   # left at 700: the code must reseal it
run
check "an unexpected file is refused" "$(grep -c 'unexpected files' "$TMP/out")" "1"
check "the directory is resealed" "$(mode "$RT")" "500"
check "contamination refusal keeps the symlink" "$([ -L "$DST" ] && echo yes || echo no)" "yes"

# 5. A replacement that cannot proceed must leave BOTH sides alone. An empty
#    runtime whose parent is not writable cannot be rmdir'd.
new_home 5; run
chmod 700 "$RT"; rm -f "$RT/MEMORY.md"
parent="$(dirname "$RT")"; chmod 500 "$parent"
run
check "an unreplaceable directory is refused" "$(grep -c 'could not be replaced' "$TMP/out")" "1"
check "that refusal keeps the symlink" "$([ -L "$DST" ] && echo yes || echo no)" "yes"
chmod 700 "$parent"

# M6: the refresh branch's closing `chmod 500` only matters when recovering a
# directory left open by a crash, and no case constructed that state — the
# mutation survived the whole suite.
new_home 7; run
chmod 700 "$RT"
run
check "a directory left open is resealed by refresh" "$(mode "$RT")" "500"
check "and its file is still read-only" "$(mode "$RT/MEMORY.md")" "400"

# A hardlinked MEMORY.md satisfies -f and ! -L; truncate-in-place then writes
# through the shared inode into the file's other name.
new_home 8; run
printf 'LINKED\n' > "$TMP/hardvictim"
chmod 700 "$RT"; rm -f "$RT/MEMORY.md"
if ln "$TMP/hardvictim" "$RT/MEMORY.md" 2>/dev/null; then
  chmod 500 "$RT"; run
  check "a hardlinked MEMORY.md is refused" "$(grep -c 'other hard links' "$TMP/out")" "1"
  check "the hardlink victim is untouched" "$(cat "$TMP/hardvictim")" "LINKED"
else
  say ok "hardlink case skipped (cross-device link not possible here)"
fi

# An unreadable source must not truncate the bootstrap that already exists: the
# redirection empties the file before the copy can fail, so the check has to
# happen first. This path used to seal a zero-byte file and report success.
new_home 9; run
before="$(cat "$RT/MEMORY.md")"
chmod 000 "$SRC_COPY"
run
chmod 644 "$SRC_COPY"
check "an unreadable source leaves the bootstrap intact" "$(cat "$RT/MEMORY.md")" "$before"

# The migration this command exists for: a legacy symlink pointing straight at
# the tracked source must be replaced by the device-local sealed copy, and the
# sealed copy must reject an ambient write. Both cases come from the test this
# file replaced; losing them would have been a silent regression.
new_home 10
rm -rf "$DST"; mkdir -p "$(dirname "$DST")"
ln -s "$H/dotfiles/config/ai/claude-home-memory" "$DST"
run
check "a legacy symlink into the source is migrated" \
  "$(readlink "$DST" | grep -c 'claude-home-bootstrap')" "1"
check "the migrated bootstrap rejects an ambient write" \
  "$(touch "$RT/ambient.md" 2>/dev/null && echo accepted || echo rejected)" "rejected"

# 6. An unmanaged destination is never replaced.
new_home 6; mkdir -p "$(dirname "$DST")"; printf 'mine\n' > "$DST"
run; rc=$?
check "an unmanaged file at the destination survives" "$(cat "$DST")" "mine"
check "it survives by refusal, not by ln failing" \
  "$(grep -c 'unmanaged file' "$TMP/out")" "1"
check "and the linker still exits cleanly" "$rc" "0"

# ── Runtime context: shared core + per-runtime adapter ───────────────────────
C="$TMP/hctx"
ctx_home() {
  # Production layout: ~/.config/ai is a symlink into the checkout. A plain
  # directory hid a regression where the linker compared unresolved paths.
  H="$C$1"; rm -rf "$H"; mkdir -p "$H/dotfiles/config/ai" "$H/.config"
  cp "$ROOT/config/ai/CORE.md" "$H/dotfiles/config/ai/CORE.md"
  cp -R "$ROOT/config/ai/adapters" "$H/dotfiles/config/ai/adapters"
  ln -s CORE.md "$H/dotfiles/config/ai/AGENTS.md"
  ln -s "$H/dotfiles/config/ai" "$H/.config/ai"
}
expected() { # $1=runtime → what the rendered file must be, built independently
  printf '<!-- GENERATED by ai-memory-link from config/ai/CORE.md + config/ai/adapters/%s.md. Edit the sources, then run ai-memory-link. -->\n\n' "$1"
  cat "$H/.config/ai/CORE.md"; printf '\n'; cat "$H/.config/ai/adapters/$1.md"
}
target_of() { case "$1" in
  claude) echo "$H/.claude/CLAUDE.md" ;; codex) echo "$H/.codex/AGENTS.md" ;;
  antigravity) echo "$H/.gemini/GEMINI.md" ;; omp) echo "$H/.omp/agent/AGENTS.md" ;; esac; }

# Each runtime links to its own rendered file, and that file is exactly core + adapter.
ctx_home 1; run
for rt in claude codex antigravity omp; do
  t="$(target_of "$rt")"
  check "$rt links to its own rendered context" "$(readlink "$t")" "$H/.config/ai/context/$rt.md"
  check "$rt context is core + its adapter" \
    "$(expected "$rt" | cmp -s - "$t" && echo same || echo differs)" "same"
done
check "pi context is rendered for the shell wrapper" \
  "$(expected pi | cmp -s - "$H/.config/ai/context/pi.md" && echo same || echo differs)" "same"
check "adapters really differ between runtimes" \
  "$(cmp -s "$H/.config/ai/context/codex.md" "$H/.config/ai/context/omp.md" && echo same || echo differs)" "differs"
check "the OMP goal contract stays out of the Codex context" \
  "$(grep -c 'OMP autonomous repository goals' "$H/.config/ai/context/codex.md")" "0"
check "the approval canary reaches every runtime" \
  "$(cat "$H"/.config/ai/context/*.md | grep -c 'Permission allowed is not user approval')" "5"
for f in "$H"/.config/ai/context/*.md; do
  sz="$(wc -c < "$f" | tr -d ' ')"
  check "$(basename "$f") stays under the 10 KB hot-context budget" "$([ "$sz" -le 10240 ] && echo under || echo "over:$sz")" "under"
done

# Idempotent: a second run renders nothing and relinks nothing.
run
check "re-run renders nothing" "$(grep -c '^rendered:' "$TMP/out")" "0"
check "re-run links nothing" "$(grep -c '^linked:' "$TMP/out")" "0"

# --check detects a source edit, writes nothing, and the next run repairs it.
before="$(cat "$H/.config/ai/context/claude.md")"
printf '\n- test edit\n' >> "$H/.config/ai/CORE.md"
HOME="$H" "$LINK" --check >"$TMP/out" 2>&1; rc=$?
check "--check fails on a stale render" "$rc" "1"
check "--check writes nothing" "$(cat "$H/.config/ai/context/claude.md")" "$before"
run
HOME="$H" "$LINK" --check >"$TMP/out" 2>&1; rc=$?
check "a normal run re-renders what --check flagged" "$rc" "0"

# A missing source refuses before touching any link.
ctx_home 2; rm "$H/.config/ai/adapters/codex.md"
run; rc=$?
check "a missing adapter fails the run" "$rc" "1"
check "and no runtime got linked" "$([ -e "$H/.claude/CLAUDE.md" ] || [ -L "$H/.claude/CLAUDE.md" ] && echo linked || echo none)" "none"

# Migration from the retired single source: managed links move without a backup,
# links at paths no runtime reads are removed, and user files are left alone.
ctx_home 3
mkdir -p "$H/.codex" "$H/.antigravity" "$H/.gemini/antigravity-cli" "$H/.omp"
ln -s "$H/.config/ai/AGENTS.md" "$H/.codex/AGENTS.md"
ln -s "$H/.config/ai/AGENTS.md" "$H/.antigravity/AGENTS.md"
ln -s "$H/.config/ai/AGENTS.md" "$H/.omp/AGENTS.md"
printf 'mine\n' > "$H/.gemini/antigravity-cli/AGENTS.md"
printf 'other\n' > "$TMP/foreign.md"; ln -s "$TMP/foreign.md" "$H/.gemini/antigravity-cli/GEMINI.md"
run
check "a managed legacy link is migrated to its runtime context" "$(readlink "$H/.codex/AGENTS.md")" "$H/.config/ai/context/codex.md"
check "migration makes no backup of a managed link" "$(ls "$H/.codex" | grep -c '\.bak\.')" "0"
check "an unread Antigravity legacy link is removed" "$([ -L "$H/.antigravity/AGENTS.md" ] && echo kept || echo removed)" "removed"
check "the OMP root legacy link is removed" "$([ -L "$H/.omp/AGENTS.md" ] && echo kept || echo removed)" "removed"
check "an unmanaged legacy file is untouched" "$(cat "$H/.gemini/antigravity-cli/AGENTS.md")" "mine"
check "an unmanaged legacy symlink is untouched" "$(readlink "$H/.gemini/antigravity-cli/GEMINI.md")" "$TMP/foreign.md"

# A device that pulled before relinking: the old link reaches CORE.md through the
# compatibility symlink, so it is managed and migrated, not treated as foreign.
ctx_home 5; mkdir -p "$H/.omp/agent"
ln -s "$H/.config/ai/AGENTS.md" "$H/.omp/agent/AGENTS.md"
check "before relinking, the compat shim still serves the approval gates" \
  "$(grep -c 'Permission allowed is not user approval' "$H/.omp/agent/AGENTS.md")" "1"
run
check "a link through the compat shim is migrated" "$(grep -c '^migrate: .*omp/agent/AGENTS.md' "$TMP/out")" "1"
check "and now reaches the OMP context" "$(readlink "$H/.omp/agent/AGENTS.md")" "$H/.config/ai/context/omp.md"

# AI_DIR must never repoint live links: it is honoured only by --check.
ctx_home 6
HOME="$H" AI_DIR="$H/dotfiles/config/ai" "$LINK" >"$TMP/out" 2>&1; rc=$?
check "AI_DIR without --check is refused" "$rc" "1"
check "and links nothing" "$([ -e "$H/.claude/CLAUDE.md" ] || [ -L "$H/.claude/CLAUDE.md" ] && echo linked || echo none)" "none"

# A directory at one target is skipped with a warning; the other runtimes still link.
ctx_home 7; mkdir -p "$H/.codex/AGENTS.md"
run; rc=$?
check "a directory target does not abort the run" "$rc" "0"
check "it is reported" "$(grep -c 'is a directory; not linking codex' "$TMP/out")" "1"
check "later runtimes still link" "$(readlink "$H/.omp/agent/AGENTS.md")" "$H/.config/ai/context/omp.md"

# A dangling unmanaged symlink is described as dangling, not as matching content.
ctx_home 8; mkdir -p "$H/.claude"; ln -s "$TMP/nowhere.md" "$H/.claude/CLAUDE.md"
run
check "a dangling foreign link is reported as dangling" "$(grep -c 'dangling' "$TMP/out")" "1"
check "and never claimed to match" "$(grep -c 'content matches' "$TMP/out")" "0"

# An unmanaged symlink at a live target is backed up by content before repointing.
ctx_home 4; mkdir -p "$H/.claude"
printf 'hand-written rules\n' > "$TMP/own-claude.md"; ln -s "$TMP/own-claude.md" "$H/.claude/CLAUDE.md"
run
check "an unmanaged target symlink is backed up by content" \
  "$(cat "$H"/.claude/CLAUDE.md.bak.* 2>/dev/null)" "hand-written rules"
check "the user's original file survives" "$(cat "$TMP/own-claude.md")" "hand-written rules"

echo
[ "$fails" -eq 0 ] && { echo "ai-memory-link-test: all cases hold"; exit 0; }
echo "ai-memory-link-test: $fails case(s) failed"; exit 1
