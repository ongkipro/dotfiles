#!/usr/bin/env bash
# Sambungkan memori bersama (~/.config/ai/AGENTS.md) ke SEMUA AI CLI via symlink.
# Tambah AI baru ke depan: cukup tambahkan path context-file-nya ke array TARGETS.
set -euo pipefail
SRC="$HOME/.config/ai/AGENTS.md"

resolve_path() {
  local path="$1" link hops=0 dir
  while [ -L "$path" ]; do
    link="$(readlink "$path")"
    case "$link" in
      /*) path="$link" ;;
      *) path="$(dirname "$path")/$link" ;;
    esac
    hops=$((hops + 1))
    [ "$hops" -le 40 ] || return 1
  done
  dir="$(cd -P "$(dirname "$path")" 2>/dev/null && pwd)" || return 1
  printf '%s/%s\n' "$dir" "$(basename "$path")"
}

[ -f "$SRC" ] || { echo "ERROR: $SRC tidak ada. Jalankan dari setup dotfiles dulu."; exit 1; }

# Lokasi context-file global tiap AI CLI:
TARGETS=(
  "$HOME/.claude/CLAUDE.md"       # Claude Code (global)
  "$HOME/.codex/AGENTS.md"        # Codex (global)
  "$HOME/.antigravity/AGENTS.md"  # Antigravity (agy) — context file UTAMA
  "$HOME/.gemini/GEMINI.md"       # Antigravity (agy) — stack Gemini
  "$HOME/.gemini/antigravity-cli/AGENTS.md"
  "$HOME/.gemini/antigravity-cli/GEMINI.md"
  "$HOME/.omp/agent/AGENTS.md"    # OMP native user context path
)

for t in "${TARGETS[@]}"; do
  mkdir -p "$(dirname "$t")"

  if [ -L "$t" ]; then
    # Sudah benar → diam, jangan sentuh. Menjalankan ulang harus selalu no-op.
    if [ "$(resolve_path "$t" 2>/dev/null)" = "$(resolve_path "$SRC")" ]; then
      echo "ok:     $t -> $SRC"
      continue
    fi
    # Symlink, tapi menunjuk ke TEMPAT LAIN. Jangan ditimpa diam-diam: kalau ada
    # sumber memori kedua, menimpanya tanpa bilang apa-apa = kehilangan senyap.
    echo "WARNING: $t adalah symlink ke: $(readlink "$t")"
    if [ -e "$t" ] && ! cmp -s "$t" "$SRC"; then
      bak="$t.bak.$(date +%s)"
      cp -L "$t" "$bak"          # -L: salin ISI target, bukan symlink-nya
      echo "         isinya BEDA dari $SRC — disalin dulu ke: $bak"
    else
      echo "         isinya sama dengan $SRC — aman diarahkan ulang."
    fi
  elif [ -e "$t" ] && [ -s "$t" ]; then
    # File asli ber-isi (bukan symlink) → backup sebelum diganti.
    bak="$t.bak.$(date +%s)"
    cp "$t" "$bak"
    echo "backup: $t -> $bak"
  fi

  ln -sfn "$SRC" "$t"
  echo "linked: $t -> $SRC"
done

# Remove the obsolete OMP root link only when it is the managed canonical link.
OMP_LEGACY="$HOME/.omp/AGENTS.md"
if [ -L "$OMP_LEGACY" ] \
   && [ "$(resolve_path "$OMP_LEGACY" 2>/dev/null)" = "$(resolve_path "$SRC")" ]; then
  unlink "$OMP_LEGACY"
  echo "removed legacy: $OMP_LEGACY"
fi

# ── Claude home-workspace bootstrap ───────────────────────────────────────────
# Claude Code writes auto-memory into its project memory directory. Pointing the
# $HOME entry at tracked dotfiles therefore lets an unrelated terminal append
# project facts directly to the shared bootstrap. Install a device-local,
# read-only copy instead: tracked source remains review-only, while attempted
# ambient writes fail closed.
install_home_bootstrap() {
  local src_file="$1" dst="$2" runtime="$3" current=""
  [ -f "$src_file" ] || return 0

  # Validate the runtime directory before touching anything. This check used to
  # sit after `unlink "$dst"`, so refusing to expose a contaminated directory
  # also destroyed the symlink it was refusing to expose — the next run rebuilt
  # it, which is why the state alternated instead of staying broken. Refusing
  # must leave the world exactly as it was found.
  if [ -d "$runtime" ] \
     && find "$runtime" -mindepth 1 -maxdepth 1 ! -name MEMORY.md -print -quit | grep -q .; then
    chmod 500 "$runtime"
    echo "WARNING: $runtime contains unexpected files; refusing to expose it."
    echo "  Move them to config/ai/project-memory/ (cross-device) or ~/.config/ai-local/."
    return 0
  fi

  if [ -d "$dst" ] && [ ! -L "$dst" ]; then
    echo "WARNING: $dst is an unmanaged directory; inspect it before migration."
    return 0
  fi
  if [ -L "$dst" ]; then
    current="$(resolve_path "$dst" 2>/dev/null || true)"
    if [ "$current" != "$(resolve_path "$runtime" 2>/dev/null || printf '%s' "$runtime")" ] \
       && [ "$current" != "$(resolve_path "$(dirname "$src_file")" 2>/dev/null || true)" ]; then
      echo "WARNING: $dst points to an unmanaged target; refusing to replace it."
      return 0
    fi
    unlink "$dst"
  elif [ -e "$dst" ]; then
    echo "WARNING: $dst is an unmanaged file; refusing to replace it."
    return 0
  fi

  mkdir -p "$(dirname "$dst")" "$runtime"
  # Refresh the file in place rather than replacing it. `install` unlinks and
  # recreates, which needs a writable directory, and the chmod 700 / chmod 500
  # pair around it was a real window: on 2026-08-31 a concurrent Claude session's
  # auto-memory landed inside one and survived, because closing the directory
  # afterwards does not remove what got in. Truncating an existing file needs no
  # directory write at all, so steady-state refresh never opens the door.
  if [ -f "$runtime/MEMORY.md" ]; then
    chmod 600 "$runtime/MEMORY.md"
    cat "$src_file" > "$runtime/MEMORY.md"
    chmod 400 "$runtime/MEMORY.md"
    chmod 500 "$runtime"
  else
    chmod 700 "$runtime"
    install -m 400 "$src_file" "$runtime/MEMORY.md"
    chmod 500 "$runtime"
  fi
  ln -s "$runtime" "$dst"
  echo "linked read-only bootstrap: $dst -> $runtime"
}

# Every account under ~/.claude-accounts/ is its own CLAUDE_CONFIG_DIR with its
# own projects/ tree, and the account switcher points Claude at one of them. This
# linked only ~/.claude, so on a device using an account the live memory
# directory was never the linked one: Claude wrote into a real directory that no
# device ever saw. Found 2026-08-17 with 40 unsynced files in it — the same shape
# of gap ai-hooks-install had. Link every config directory that exists.
project_slug="$(printf '%s' "$HOME" | tr '/' '-')"
for cfg in "$HOME/.claude" "$HOME"/.claude-accounts/*/; do
  [ -d "$cfg" ] || continue
  cfg_key="$(printf '%s' "${cfg%/}" | tr '/ ' '--')"
  install_home_bootstrap \
    "$HOME/dotfiles/config/ai/claude-home-memory/MEMORY.md" \
    "${cfg%/}/projects/$project_slug/memory" \
    "$HOME/.config/ai-local/claude-home-bootstrap/$cfg_key"
done

echo "Selesai. Edit memori di ~/.config/ai/ (AGENTS.md + memory/*.md)."
