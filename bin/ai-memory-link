#!/usr/bin/env bash
# Sambungkan memori bersama (~/.config/ai/AGENTS.md) ke SEMUA AI CLI via symlink.
# Tambah AI baru ke depan: cukup tambahkan path context-file-nya ke array TARGETS.
set -euo pipefail
SRC="$HOME/.config/ai/AGENTS.md"

resolve_path() {
  local path="$1" link hops=0 dir
  while [ -L "$path" ]; do
    link="$(readlink "$path")"
    case "$link" in
      /*) path="$link" ;;
      *) path="$(dirname "$path")/$link" ;;
    esac
    hops=$((hops + 1))
    [ "$hops" -le 40 ] || return 1
  done
  dir="$(cd -P "$(dirname "$path")" 2>/dev/null && pwd)" || return 1
  printf '%s/%s\n' "$dir" "$(basename "$path")"
}

[ -f "$SRC" ] || { echo "ERROR: $SRC tidak ada. Jalankan dari setup dotfiles dulu."; exit 1; }

# Lokasi context-file global tiap AI CLI:
TARGETS=(
  "$HOME/.claude/CLAUDE.md"       # Claude Code (global)
  "$HOME/.codex/AGENTS.md"        # Codex (global)
  "$HOME/.antigravity/AGENTS.md"  # Antigravity (agy) — context file UTAMA
  "$HOME/.gemini/GEMINI.md"       # Antigravity (agy) — stack Gemini
  "$HOME/.gemini/antigravity-cli/AGENTS.md"
  "$HOME/.gemini/antigravity-cli/GEMINI.md"
  "$HOME/.omp/agent/AGENTS.md"    # OMP native user context path
)

for t in "${TARGETS[@]}"; do
  mkdir -p "$(dirname "$t")"

  if [ -L "$t" ]; then
    # Sudah benar → diam, jangan sentuh. Menjalankan ulang harus selalu no-op.
    if [ "$(resolve_path "$t" 2>/dev/null)" = "$(resolve_path "$SRC")" ]; then
      echo "ok:     $t -> $SRC"
      continue
    fi
    # Symlink, tapi menunjuk ke TEMPAT LAIN. Jangan ditimpa diam-diam: kalau ada
    # sumber memori kedua, menimpanya tanpa bilang apa-apa = kehilangan senyap.
    echo "WARNING: $t adalah symlink ke: $(readlink "$t")"
    if [ -e "$t" ] && ! cmp -s "$t" "$SRC"; then
      bak="$t.bak.$(date +%s)"
      cp -L "$t" "$bak"          # -L: salin ISI target, bukan symlink-nya
      echo "         isinya BEDA dari $SRC — disalin dulu ke: $bak"
    else
      echo "         isinya sama dengan $SRC — aman diarahkan ulang."
    fi
  elif [ -e "$t" ] && [ -s "$t" ]; then
    # File asli ber-isi (bukan symlink) → backup sebelum diganti.
    bak="$t.bak.$(date +%s)"
    cp "$t" "$bak"
    echo "backup: $t -> $bak"
  fi

  ln -sfn "$SRC" "$t"
  echo "linked: $t -> $SRC"
done

# Remove the obsolete OMP root link only when it is the managed canonical link.
OMP_LEGACY="$HOME/.omp/AGENTS.md"
if [ -L "$OMP_LEGACY" ] \
   && [ "$(resolve_path "$OMP_LEGACY" 2>/dev/null)" = "$(resolve_path "$SRC")" ]; then
  unlink "$OMP_LEGACY"
  echo "removed legacy: $OMP_LEGACY"
fi

# ── Memori per-project (Claude Code) ──────────────────────────────────────────
# Claude Code menyimpan memori per-project di ~/.claude/projects/<cwd>/memory/,
# dan <cwd> = $HOME dengan '/' → '-' ('-Users-ongki' di Mac, '-home-<user>' di
# Linux). Isinya dipindah ke dotfiles 2026-07-20 lalu di-symlink balik supaya
# ikut ter-sync antar device dan bisa dibaca CLI lain.
#
# Kalau symlink ini TIDAK ada, Claude Code tidak error — ia diam-diam bikin
# direktori kosong baru, dan konteks project hilang tanpa gejala. Karena itu
# bagian ini idempoten dan aman dijalankan di device yang belum punya.
link_pmem() {
  local src="$1" dst="$2"
  [ -d "$src" ] || return 0
  if [ -L "$dst" ] && [ "$(resolve_path "$dst" 2>/dev/null)" = "$(resolve_path "$src")" ]; then
    echo "ok:     $dst -> $src"
  elif [ -d "$dst" ] && [ ! -L "$dst" ]; then
    # Direktori ASLI berisi memori yang belum ter-sync. JANGAN timpa — isinya
    # bisa jadi konteks project device ini yang belum pernah masuk dotfiles.
    echo "WARNING: $dst adalah direktori asli, bukan symlink."
    echo "         Isinya belum ter-sync. Pindahkan manual ke $src (cek dulu"
    echo "         apakah ada file yang belum ada di sana), lalu jalankan ulang."
  else
    mkdir -p "$(dirname "$dst")"
    ln -sfn "$src" "$dst"
    echo "linked: $dst -> $src"
  fi
}

# Every account under ~/.claude-accounts/ is its own CLAUDE_CONFIG_DIR with its
# own projects/ tree, and the account switcher points Claude at one of them. This
# linked only ~/.claude, so on a device using an account the live memory
# directory was never the linked one: Claude wrote into a real directory that no
# device ever saw. Found 2026-08-17 with 40 unsynced files in it — the same shape
# of gap ai-hooks-install had. Link every config directory that exists.
project_slug="$(printf '%s' "$HOME" | tr '/' '-')"
for cfg in "$HOME/.claude" "$HOME"/.claude-accounts/*/; do
  [ -d "$cfg" ] || continue
  link_pmem "$HOME/dotfiles/config/ai/project-memory" \
            "${cfg%/}/projects/$project_slug/memory"
done

echo "Selesai. Edit memori di ~/.config/ai/ (AGENTS.md + memory/*.md)."
