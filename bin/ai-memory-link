#!/usr/bin/env bash
# Sambungkan memori bersama (~/.config/ai/AGENTS.md) ke SEMUA AI CLI via symlink.
# Tambah AI baru ke depan: cukup tambahkan path context-file-nya ke array TARGETS.
set -euo pipefail
SRC="$HOME/.config/ai/AGENTS.md"

resolve_path() {
  local path="$1" link hops=0 dir
  while [ -L "$path" ]; do
    link="$(readlink "$path")"
    case "$link" in
      /*) path="$link" ;;
      *) path="$(dirname "$path")/$link" ;;
    esac
    hops=$((hops + 1))
    [ "$hops" -le 40 ] || return 1
  done
  dir="$(cd -P "$(dirname "$path")" 2>/dev/null && pwd)" || return 1
  printf '%s/%s\n' "$dir" "$(basename "$path")"
}

[ -f "$SRC" ] || { echo "ERROR: $SRC tidak ada. Jalankan dari setup dotfiles dulu."; exit 1; }

# Lokasi context-file global tiap AI CLI:
TARGETS=(
  "$HOME/.claude/CLAUDE.md"       # Claude Code (global)
  "$HOME/.codex/AGENTS.md"        # Codex (global)
  "$HOME/.antigravity/AGENTS.md"  # Antigravity (agy) — context file UTAMA
  "$HOME/.gemini/GEMINI.md"       # Antigravity (agy) — stack Gemini
  "$HOME/.gemini/antigravity-cli/AGENTS.md"
  "$HOME/.gemini/antigravity-cli/GEMINI.md"
  "$HOME/.omp/agent/AGENTS.md"    # OMP native user context path
)

for t in "${TARGETS[@]}"; do
  mkdir -p "$(dirname "$t")"

  if [ -L "$t" ]; then
    # Sudah benar → diam, jangan sentuh. Menjalankan ulang harus selalu no-op.
    if [ "$(resolve_path "$t" 2>/dev/null)" = "$(resolve_path "$SRC")" ]; then
      echo "ok:     $t -> $SRC"
      continue
    fi
    # Symlink, tapi menunjuk ke TEMPAT LAIN. Jangan ditimpa diam-diam: kalau ada
    # sumber memori kedua, menimpanya tanpa bilang apa-apa = kehilangan senyap.
    echo "WARNING: $t adalah symlink ke: $(readlink "$t")"
    if [ -e "$t" ] && ! cmp -s "$t" "$SRC"; then
      bak="$t.bak.$(date +%s)"
      cp -L "$t" "$bak"          # -L: salin ISI target, bukan symlink-nya
      echo "         isinya BEDA dari $SRC — disalin dulu ke: $bak"
    else
      echo "         isinya sama dengan $SRC — aman diarahkan ulang."
    fi
  elif [ -e "$t" ] && [ -s "$t" ]; then
    # File asli ber-isi (bukan symlink) → backup sebelum diganti.
    bak="$t.bak.$(date +%s)"
    cp "$t" "$bak"
    echo "backup: $t -> $bak"
  fi

  ln -sfn "$SRC" "$t"
  echo "linked: $t -> $SRC"
done

# Remove the obsolete OMP root link only when it is the managed canonical link.
OMP_LEGACY="$HOME/.omp/AGENTS.md"
if [ -L "$OMP_LEGACY" ] \
   && [ "$(resolve_path "$OMP_LEGACY" 2>/dev/null)" = "$(resolve_path "$SRC")" ]; then
  unlink "$OMP_LEGACY"
  echo "removed legacy: $OMP_LEGACY"
fi

# ── Claude home-workspace bootstrap ───────────────────────────────────────────
# Claude Code writes auto-memory into its project memory directory. Pointing the
# $HOME entry at tracked dotfiles therefore lets an unrelated terminal append
# project facts directly to the shared bootstrap. Install a device-local,
# read-only copy instead: tracked source remains review-only, while attempted
# ambient writes fail closed.
install_home_bootstrap() {
  local src_file="$1" dst="$2" runtime="$3" current="" staging=""
  [ -f "$src_file" ] || return 0

  # EVERY refusal below happens before $dst is touched. That ordering is the
  # whole lesson of this function: the original code validated after
  # `unlink "$dst"`, so refusing to expose a contaminated directory destroyed
  # the symlink it was refusing to expose. The 2026-09-01 rework then
  # reintroduced exactly that for two new refusal paths, one branch over, while
  # the comment above them claimed the opposite. Do not move a `return` above
  # the link step without moving its check up here too.

  if [ -d "$runtime" ]; then
    if find "$runtime" -mindepth 1 -maxdepth 1 ! -name MEMORY.md -print -quit | grep -q .; then
      chmod 500 "$runtime" 2>/dev/null || true
      echo "WARNING: $runtime contains unexpected files; refusing to expose it."
      echo "  Move them to config/ai/project-memory/ (cross-device) or ~/.config/ai-local/."
      return 0
    fi
    # -L before -f, deliberately: `[ -f ]` FOLLOWS symlinks, so a symlink named
    # MEMORY.md satisfied the refresh branch and `cat >` wrote the bootstrap
    # through it into an arbitrary file outside the sealed directory, chmodded
    # the victim 400, and reported success. Truncate-in-place is what made that
    # reachable; the earlier `install` would have replaced the link.
    if [ -e "$runtime/MEMORY.md" ] || [ -L "$runtime/MEMORY.md" ]; then
      if [ -L "$runtime/MEMORY.md" ] || [ ! -f "$runtime/MEMORY.md" ]; then
        chmod 500 "$runtime" 2>/dev/null || true
        echo "WARNING: $runtime/MEMORY.md is not a regular file; refusing to write through it."
        return 0
      fi
      # A hardlink satisfies both -f and ! -L, and truncate-in-place then writes
      # through the shared inode into the file's other name. `find -links` is
      # POSIX; `stat -c %h` is GNU and would be wrong on macOS.
      if find "$runtime" -maxdepth 1 -name MEMORY.md -links +1 -print -quit | grep -q .; then
        chmod 500 "$runtime" 2>/dev/null || true
        echo "WARNING: $runtime/MEMORY.md has other hard links; refusing to write through it."
        return 0
      fi
    fi
  fi

  if [ -d "$dst" ] && [ ! -L "$dst" ]; then
    echo "WARNING: $dst is an unmanaged directory; inspect it before migration."
    return 0
  fi
  if [ ! -L "$dst" ] && [ -e "$dst" ]; then
    echo "WARNING: $dst is an unmanaged file; refusing to replace it."
    return 0
  fi
  if [ -L "$dst" ]; then
    current="$(resolve_path "$dst" 2>/dev/null || true)"
    if [ "$current" != "$(resolve_path "$runtime" 2>/dev/null || printf '%s' "$runtime")" ] \
       && [ "$current" != "$(resolve_path "$(dirname "$src_file")" 2>/dev/null || true)" ]; then
      echo "WARNING: $dst points to an unmanaged target; refusing to replace it."
      return 0
    fi
  fi

  mkdir -p "$(dirname "$dst")" "$(dirname "$runtime")"

  # Build or refresh the runtime FIRST; the symlink is only touched once the
  # directory it will point at is known good.
  if [ -f "$runtime/MEMORY.md" ] && [ ! -L "$runtime/MEMORY.md" ]; then
    # Refresh in place. `install` unlinks and recreates, which needs a writable
    # directory, and the chmod 700 / chmod 500 pair around it was a real window:
    # a concurrent Claude session's auto-memory landed inside one and survived,
    # because closing the directory afterwards does not remove what got in.
    # Truncating an existing file needs no directory write, so this never opens.
    if [ ! -r "$src_file" ]; then
      echo "WARNING: $src_file is unreadable; leaving $runtime and $dst untouched."
      return 0
    fi
    chmod 600 "$runtime/MEMORY.md" || {
      echo "WARNING: cannot open $runtime/MEMORY.md for refresh; leaving it untouched."
      return 0
    }
    if ! cat "$src_file" > "$runtime/MEMORY.md" || ! cmp -s "$src_file" "$runtime/MEMORY.md"; then
      chmod 400 "$runtime/MEMORY.md"; chmod 500 "$runtime"
      echo "WARNING: $runtime/MEMORY.md does not match the source after refresh."
      echo "  The redirection empties it before the copy can fail, so it may be"
      echo "  truncated, or the source may have changed mid-write. Re-run after"
      echo "  fixing the source or freeing space; $dst is unchanged."
      return 0
    fi
    chmod 400 "$runtime/MEMORY.md"
    chmod 500 "$runtime"
  else
    # Built sealed in a private directory and renamed in, so the window never
    # exists rather than merely being short. chmod 500 BEFORE the rename is
    # load-bearing, not tidiness: it is what makes a losing race fail closed.
    if [ -d "$runtime" ] && ! rmdir "$runtime" 2>/dev/null; then
      echo "WARNING: $runtime could not be replaced (not empty, or its parent is not writable);"
      echo "  leaving it and $dst exactly as they are."
      return 0
    fi
    staging="$(mktemp -d "${runtime}.new.XXXXXX")" || return 0
    if ! install -m 400 "$src_file" "$staging/MEMORY.md"; then
      chmod 700 "$staging"; rm -rf "$staging"
      echo "WARNING: could not stage $runtime; leaving it and $dst untouched."
      return 0
    fi
    chmod 500 "$staging"
    if ! mv "$staging" "$runtime" 2>/dev/null; then
      chmod 700 "$staging"; rm -rf "$staging"
      echo "WARNING: could not install $runtime; leaving it and $dst untouched."
      return 0
    fi
  fi

  [ -L "$dst" ] && unlink "$dst"
  ln -s "$runtime" "$dst"
  echo "linked read-only bootstrap: $dst -> $runtime"
}

# Every account under ~/.claude-accounts/ is its own CLAUDE_CONFIG_DIR with its
# own projects/ tree, and the account switcher points Claude at one of them. This
# linked only ~/.claude, so on a device using an account the live memory
# directory was never the linked one: Claude wrote into a real directory that no
# device ever saw. Found 2026-08-17 with 40 unsynced files in it — the same shape
# of gap ai-hooks-install had. Link every config directory that exists.
project_slug="$(printf '%s' "$HOME" | tr '/' '-')"
for cfg in "$HOME/.claude" "$HOME"/.claude-accounts/*/; do
  [ -d "$cfg" ] || continue
  cfg_key="$(printf '%s' "${cfg%/}" | tr '/ ' '--')"
  install_home_bootstrap \
    "$HOME/dotfiles/config/ai/claude-home-memory/MEMORY.md" \
    "${cfg%/}/projects/$project_slug/memory" \
    "$HOME/.config/ai-local/claude-home-bootstrap/$cfg_key"
done

echo "Selesai. Edit memori di ~/.config/ai/ (AGENTS.md + memory/*.md)."
