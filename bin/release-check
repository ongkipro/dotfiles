#!/usr/bin/env python3
"""release-check — vendor-neutral post-deploy observability verification.

Reads STATUS.md State and OBSERVABILITY.md probes. Every configured probe must
succeed before a release may transition from SMOKE_TESTING to VERIFIED.

Probe format:
  Probe: <name>|<url>|<expected-status>|<contains-or-TBD>|<max-latency-ms>

Exit codes:
  0 VERIFIED
  1 FAILED
  2 UNVERIFIED
"""
from __future__ import annotations

import argparse
import ipaddress
import json
from pathlib import Path
import re
import socket
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

VERIFIED, FAILED, UNVERIFIED = 0, 1, 2
DISABLED = {"", "TBD", "UNSET", "NONE"}


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def validate_url(url: str, allow_private: bool) -> str | None:
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme not in {"http", "https"} or not parsed.hostname:
        return "valid http(s) URL required"
    if parsed.username or parsed.password:
        return "URL credentials are not allowed"
    try:
        addresses = {item[4][0] for item in socket.getaddrinfo(parsed.hostname, parsed.port or (443 if parsed.scheme == "https" else 80), type=socket.SOCK_STREAM)}
    except socket.gaierror as exc:
        return f"host resolution failed: {exc}"
    if not allow_private:
        for address in addresses:
            ip = ipaddress.ip_address(address)
            if not ip.is_global:
                return f"non-public probe target is blocked: {address}"
    return None


def field(text: str, name: str) -> str | None:
    match = re.search(rf"(?im)^{re.escape(name)}:\s*(.+?)\s*$", text)
    return match.group(1).strip() if match else None


def parse_status(spec: str):
    spec = spec.strip()
    if re.fullmatch(r"\d{3}", spec):
        code = int(spec)
        return lambda actual: actual == code
    match = re.fullmatch(r"(\d{3})-(\d{3})", spec)
    if match:
        lo, hi = map(int, match.groups())
        if lo > hi:
            raise ValueError(f"invalid status range: {spec}")
        return lambda actual: lo <= actual <= hi
    raise ValueError(f"invalid expected status: {spec}")


def parse_probes(path: Path) -> tuple[list[dict], list[str]]:
    if not path.is_file():
        return [], ["OBSERVABILITY.md missing"]
    probes, errors = [], []
    for lineno, raw in enumerate(path.read_text(encoding="utf-8", errors="replace").splitlines(), start=1):
        if not raw.startswith("Probe:"):
            continue
        parts = [p.strip() for p in raw[6:].split("|")]
        if len(parts) != 5:
            errors.append(f"line {lineno}: probe must have 5 fields")
            continue
        name, url, expected, marker, latency = parts
        if not name:
            errors.append(f"line {lineno}: probe name missing")
        if url in DISABLED or not re.match(r"^https?://", url):
            errors.append(f"line {lineno}: valid http(s) URL required for probe {name or '?'}")
        try:
            parse_status(expected)
        except ValueError as exc:
            errors.append(f"line {lineno}: {exc}")
        try:
            latency_ms = int(latency)
            if latency_ms <= 0:
                raise ValueError
        except ValueError:
            errors.append(f"line {lineno}: max latency must be a positive integer")
            latency_ms = 0
        probes.append({"name": name, "url": url, "expected": expected, "marker": None if marker in DISABLED else marker, "maxLatencyMs": latency_ms})
    if not probes:
        errors.append("no Probe entries configured")
    return probes, errors


def run_probe(probe: dict, timeout: float) -> dict:
    request = urllib.request.Request(probe["url"], headers={"User-Agent": "dotfiles-release-check/2"})
    opener = urllib.request.build_opener(NoRedirect)
    start = time.monotonic()
    try:
        with opener.open(request, timeout=timeout) as response:
            status = response.getcode()
            body = response.read(1024 * 1024).decode("utf-8", errors="replace")
    except urllib.error.HTTPError as exc:
        status = exc.code
        body = exc.read(1024 * 1024).decode("utf-8", errors="replace")
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        return {**probe, "status": "FAIL", "detail": str(exc)}
    latency_ms = round((time.monotonic() - start) * 1000)
    if not parse_status(probe["expected"])(status):
        return {**probe, "status": "FAIL", "httpStatus": status, "latencyMs": latency_ms, "detail": f"HTTP {status} outside {probe['expected']}"}
    if probe["marker"] and probe["marker"] not in body:
        return {**probe, "status": "FAIL", "httpStatus": status, "latencyMs": latency_ms, "detail": "response marker not found"}
    if latency_ms > probe["maxLatencyMs"]:
        return {**probe, "status": "FAIL", "httpStatus": status, "latencyMs": latency_ms, "detail": f"latency {latency_ms}ms exceeds {probe['maxLatencyMs']}ms"}
    return {**probe, "status": "PASS", "httpStatus": status, "latencyMs": latency_ms, "detail": "probe passed"}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("directory", nargs="?", default=".")
    parser.add_argument("--timeout", type=float, default=10.0)
    parser.add_argument("--allow-private", action="store_true", help="allow loopback/private probes for explicit local testing")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    repo = Path(args.directory).resolve()
    status_path = repo / "STATUS.md"
    if not status_path.is_file():
        payload = {"result": "UNVERIFIED", "reason": "STATUS.md missing", "probes": []}
        print(json.dumps(payload, indent=2) if args.json else "release-check: UNVERIFIED (STATUS.md missing)")
        return UNVERIFIED

    state = field(status_path.read_text(encoding="utf-8", errors="replace"), "State")
    if state not in {"DEPLOYED", "SMOKE_TESTING"}:
        payload = {"result": "UNVERIFIED", "reason": f"State={state or 'missing'}; expected DEPLOYED or SMOKE_TESTING", "probes": []}
        print(json.dumps(payload, indent=2) if args.json else f"release-check: UNVERIFIED ({payload['reason']})")
        return UNVERIFIED

    probes, errors = parse_probes(repo / "OBSERVABILITY.md")
    for probe in probes:
        problem = validate_url(probe["url"], args.allow_private)
        if problem:
            errors.append(f"probe {probe['name'] or '?'}: {problem}")
    if errors:
        payload = {"result": "UNVERIFIED", "reason": "; ".join(errors), "probes": probes}
        print(json.dumps(payload, indent=2) if args.json else f"release-check: UNVERIFIED ({payload['reason']})")
        return UNVERIFIED

    results = [run_probe(probe, args.timeout) for probe in probes]
    final = "FAILED" if any(item["status"] == "FAIL" for item in results) else "VERIFIED"
    payload = {"result": final, "state": state, "probes": results}
    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print("release-check")
        print("-" * 60)
        for item in results:
            latency = f" {item.get('latencyMs')}ms" if "latencyMs" in item else ""
            print(f"{item['name']:20} {item['status']}{latency}")
            print(f"  {item['detail']}")
        print("-" * 60)
        print(f"RELEASE_CHECK={final}")
    return VERIFIED if final == "VERIFIED" else FAILED


if __name__ == "__main__":
    raise SystemExit(main())
