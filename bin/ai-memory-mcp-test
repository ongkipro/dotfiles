#!/usr/bin/env python3
"""Behavioral regression tests for ai-memory-mcp (JSON-RPC 2.0 stdio MCP server)."""
from __future__ import annotations

import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest

ROOT = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else Path(__file__).resolve().parent.parent
SERVER = ROOT / "bin" / "ai-memory-mcp"


class MemoryMcpTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix="ai-memory-mcp-test-")
        self.addCleanup(self.temp.cleanup)
        self.base = Path(self.temp.name).resolve()
        self.home = self.base / "home"
        self.home.mkdir()
        self.mem = self.base / "mem"
        (self.mem / "memory").mkdir(parents=True)
        (self.mem / "project-memory").mkdir(parents=True)
        (self.mem / "memory" / "sample.md").write_text(
            "---\nname: sample-invariant\ndescription: \"WOFF2 preload Vite asset rule\"\n---\n"
            "# Sample\nAlways import fonts with ?url.\n",
            encoding="utf-8",
        )
        self.index = self.base / "recall.sqlite3"
        self.env = {
            **os.environ,
            "HOME": str(self.home),
            "DOTFILES_DIR": str(ROOT),
            "AI_MEMORY_MCP_ROOT": str(self.mem),
            "AI_MEMORY_MCP_INDEX": str(self.index),
        }

    def rpc_session(self, messages: list[dict]) -> list[dict]:
        payload = "\n".join(json.dumps(m) for m in messages) + "\n"
        res = subprocess.run(
            [str(SERVER)],
            input=payload,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            env=self.env,
            timeout=20,
            check=False,
        )
        self.assertEqual(res.returncode, 0, res.stderr)
        lines = [line for line in res.stdout.splitlines() if line.strip()]
        return [json.loads(line) for line in lines]

    def test_help_and_version(self):
        res = subprocess.run([str(SERVER), "--help"], capture_output=True, text=True, timeout=5)
        self.assertEqual(res.returncode, 0)
        self.assertIn("read-only MCP stdio server", res.stdout)
        ver = subprocess.run([str(SERVER), "--version"], capture_output=True, text=True, timeout=5)
        self.assertEqual(ver.returncode, 0)
        self.assertIn("ai-memory-mcp", ver.stdout)

    def test_initialize_tools_list_and_ping(self):
        responses = self.rpc_session([
            {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2024-11-05"}},
            {"jsonrpc": "2.0", "method": "notifications/initialized"},
            {"jsonrpc": "2.0", "id": 2, "method": "ping"},
            {"jsonrpc": "2.0", "id": 3, "method": "tools/list"},
        ])
        self.assertEqual([r["id"] for r in responses], [1, 2, 3])
        self.assertEqual(responses[0]["result"]["serverInfo"]["name"], "ai-memory-mcp")
        self.assertEqual(responses[1]["result"], {})
        tools = responses[2]["result"]["tools"]
        self.assertEqual([t["name"] for t in tools], ["memory_route", "memory_recall"])
        for tool in tools:
            self.assertTrue(tool["annotations"]["readOnlyHint"])
            self.assertFalse(tool["annotations"]["destructiveHint"])

    def test_memory_route_and_memory_recall_calls(self):
        responses = self.rpc_session([
            {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {
                "name": "memory_route",
                "arguments": {"query": "meta ads cpas", "max_files": 2},
            }},
            {"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": {
                "name": "memory_recall",
                "arguments": {"query": "WOFF2 preload", "limit": 3},
            }},
            {"jsonrpc": "2.0", "id": 3, "method": "tools/call", "params": {
                "name": "memory_recall",
                "arguments": {"query": "WOFF2 nonexistentterm", "any_term": True},
            }},
        ])
        r_route = responses[0]["result"]
        self.assertFalse(r_route["isError"])
        route_json = json.loads(r_route["content"][0]["text"])
        self.assertTrue(route_json["needed"])
        self.assertIn("files", route_json)

        r_recall = responses[1]["result"]
        self.assertFalse(r_recall["isError"])
        recall_json = json.loads(r_recall["content"][0]["text"])
        self.assertEqual([r["source"] for r in recall_json["results"]], ["memory/sample.md"])

        r_any = responses[2]["result"]
        self.assertFalse(r_any["isError"])
        any_json = json.loads(r_any["content"][0]["text"])
        self.assertEqual([r["source"] for r in any_json["results"]], ["memory/sample.md"])

    def test_unknown_method_and_invalid_arguments(self):
        responses = self.rpc_session([
            {"jsonrpc": "2.0", "id": 1, "method": "tools/unknown"},
            {"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": {"name": "delete_everything", "arguments": {}}},
            {"jsonrpc": "2.0", "id": 3, "method": "tools/call", "params": {"name": "memory_recall", "arguments": {"query": ""}}},
            {"jsonrpc": "2.0", "id": 4, "method": "tools/call", "params": {"name": "memory_route", "arguments": {"query": "--help"}}},
        ])
        self.assertEqual(responses[0]["error"]["code"], -32601)
        self.assertEqual(responses[1]["error"]["code"], -32601)
        self.assertTrue(responses[2]["result"]["isError"])
        # Flag-like query must be passed after `--`, not interpreted as a CLI flag
        self.assertFalse(responses[3]["result"]["isError"])
        parsed = json.loads(responses[3]["result"]["content"][0]["text"])
        self.assertIn("files", parsed)


if __name__ == "__main__":
    unittest.main(argv=[sys.argv[0]], verbosity=2)
