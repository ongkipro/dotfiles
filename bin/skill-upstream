#!/usr/bin/env python3
"""Report upstream changes for owned skills since they were last verified.

Every skill may name the upstream it learns from:

  .source / .local-fork   vendored copy (refresh owned by _refresh-vendored.sh)
  .upstream               watch-only: never fetched over the skill, e.g.

      watch: shadcn-ui/ui skills/shadcn
      watch: vercel/next.js docs
      verified: 2026-10-27
      note: why these sources matter

This command is read-only. It lists the registry, asks GitHub (through `gh`)
which commits touched each watched path after the verified date, and prints
them so a person can decide what, if anything, to adopt. Adoption follows
development-kit references/ecosystem-adoption.md; nothing here edits a skill.

  skill-upstream                 drift report for every watch
  skill-upstream --skill NAME    limit to one or more skills
  skill-upstream --list          offline registry listing and validation
  skill-upstream --json          machine-readable output

Exit: 0 report produced; 1 invalid registry, missing or archived upstream;
2 GitHub could not be queried (no `gh`, auth, or network).
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

GH = os.environ.get("SKILL_UPSTREAM_GH", "gh")
REPO = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
DATE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
RAW = re.compile(r"^https://raw\.githubusercontent\.com/([^/]+/[^/]+)/([^/]+)/?(.*)$")
WEB = re.compile(r"^https://github\.com/([^/]+/[^/]+)/(?:tree|blob)/([^/]+)/?(.*)$")
UPSTREAM_KEYS = {"watch", "verified", "note"}
TITLES = 3


class QueryError(Exception):
    """GitHub could not answer; the report would be incomplete."""


def parse_ledger(path: Path) -> list[tuple[str, str]]:
    """`key: value` lines; indented lines continue the previous value."""
    pairs: list[tuple[str, str]] = []
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if line[0].isspace() and pairs:
            pairs[-1] = (pairs[-1][0], f"{pairs[-1][1]} {line.strip()}")
        elif ":" in line:
            key, value = line.split(":", 1)
            pairs.append((key.strip(), value.strip()))
        else:
            pairs.append(("", line.strip()))
    return pairs


def from_url(url: str) -> tuple[str, str, str] | None:
    match = RAW.match(url) or WEB.match(url)
    if not match:
        return None
    repo, ref, path = match.groups()
    return repo, ref, re.sub(r"/?SKILL\.md$", "", path).strip("/")


def vendored_watch(skill_dir: Path) -> dict | None:
    """One watch from the vendoring ledgers; the newest comparison date wins."""
    fork = dict(parse_ledger(skill_dir / ".local-fork")) if (skill_dir / ".local-fork").is_file() else {}
    source = dict(parse_ledger(skill_dir / ".source")) if (skill_dir / ".source").is_file() else {}
    if not fork and not source:
        return None
    url = source.get("source") or fork.get("upstream", "")
    dates = [d for d in (source.get("vendored", ""), fork.get("verified", "")) if DATE.match(d)]
    watch = {"kind": "fork" if fork else "vendored", "url": url, "since": max(dates) if dates else ""}
    parsed = from_url(url)
    if parsed:
        watch.update(repo=parsed[0], ref=parsed[1], path=parsed[2])
    return watch


def upstream_watches(skill_dir: Path, problems: list[str]) -> list[dict]:
    path = skill_dir / ".upstream"
    if not path.is_file():
        return []
    rel = f"{skill_dir.name}/.upstream"
    pairs = parse_ledger(path)
    for key, _ in pairs:
        if key not in UPSTREAM_KEYS:
            problems.append(f"{rel}: unknown key {key!r} (allowed: {', '.join(sorted(UPSTREAM_KEYS))})")
    dates = [v for k, v in pairs if k == "verified"]
    if len(dates) != 1 or not DATE.match(dates[0]):
        problems.append(f"{rel}: needs exactly one 'verified: YYYY-MM-DD'")
        return []
    watches = []
    for key, value in pairs:
        if key != "watch":
            continue
        parts = value.split()
        if not parts or len(parts) > 2 or not REPO.match(parts[0]):
            problems.append(f"{rel}: watch must be 'owner/repo [path]', got {value!r}")
            continue
        watches.append({"kind": "watch", "repo": parts[0], "ref": None,
                        "path": parts[1].strip("/") if len(parts) == 2 else "", "since": dates[0]})
    if not watches:
        problems.append(f"{rel}: declares no watch")
    return watches


def registry(skills_dir: Path, only: set[str]) -> tuple[list[dict], list[str], list[str]]:
    rows, local_only, problems = [], [], []
    for skill_dir in sorted(p for p in skills_dir.iterdir() if p.is_dir()):
        has_skill = (skill_dir / "SKILL.md").is_file()
        if (skill_dir / ".upstream").is_file() and not has_skill:
            problems.append(f"{skill_dir.name}/.upstream: directory has no SKILL.md")
        if not has_skill or (only and skill_dir.name not in only):
            continue
        watches = [w for w in [vendored_watch(skill_dir)] if w] + upstream_watches(skill_dir, problems)
        if any(w["kind"] != "watch" and not w["since"] for w in watches):
            problems.append(f"{skill_dir.name}: vendoring ledger has no valid vendored/verified date")
        if not watches:
            local_only.append(skill_dir.name)
        for watch in watches:
            rows.append({"skill": skill_dir.name, **watch})
    unknown = only - {r["skill"] for r in rows} - set(local_only)
    problems.extend(f"--skill {name}: no such skill" for name in sorted(unknown))
    return rows, local_only, problems


def gh_json(args: list[str]):
    try:
        done = subprocess.run([GH, "api", "-X", "GET", *args], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise QueryError(f"{GH}: {exc}") from exc
    if done.returncode == 0:
        return json.loads(done.stdout or "null")
    if "Not Found" in done.stderr or "HTTP 404" in done.stderr:
        return None
    raise QueryError((done.stderr or done.stdout).strip().splitlines()[-1] if (done.stderr or done.stdout).strip() else f"{GH} exit {done.returncode}")


def query(rows: list[dict]) -> None:
    repos = sorted({r["repo"] for r in rows if r.get("repo")})
    with ThreadPoolExecutor(max_workers=8) as pool:
        meta = dict(zip(repos, pool.map(lambda repo: gh_json([f"repos/{repo}"]), repos)))

    def commits(row: dict):
        if not row.get("repo"):
            return {"status": "UNWATCHABLE"}
        info = meta.get(row["repo"])
        if info is None:
            return {"status": "MISSING"}
        args = [f"repos/{row['repo']}/commits", "-f", "per_page=100"]
        if row["since"]:
            args += ["-f", f"since={row['since']}T00:00:00Z"]
        if row.get("path"):
            args += ["-f", f"path={row['path']}"]
        if row.get("ref"):
            args += ["-f", f"sha={row['ref']}"]
        found = gh_json(args)
        if found is None:
            return {"status": "MISSING"}
        items = [{"date": c["commit"]["committer"]["date"][:10], "sha": c["sha"][:8],
                  "title": c["commit"]["message"].splitlines()[0][:100]} for c in found]
        status = "ARCHIVED" if info.get("archived") else ("CHANGED" if items else "CURRENT")
        return {"status": status, "commits": len(items), "truncated": len(items) == 100, "recent": items[:TITLES]}

    with ThreadPoolExecutor(max_workers=8) as pool:
        for row, result in zip(rows, pool.map(commits, rows)):
            row.update(result)


def target(row: dict) -> str:
    if not row.get("repo"):
        return row.get("url") or "(no URL)"
    return f"{row['repo']}:{row['path']}" if row.get("path") else row["repo"]


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--skills-dir", default=str(Path(__file__).resolve().parent.parent / "skills" / "local"))
    ap.add_argument("--skill", action="append", default=[])
    ap.add_argument("--list", action="store_true", help="offline: list and validate the registry only")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()

    rows, local_only, problems = registry(Path(a.skills_dir), set(a.skill))
    if not a.list and rows:
        try:
            query(rows)
        except QueryError as exc:
            print(f"skill-upstream: cannot query GitHub: {exc}", file=sys.stderr)
            return 2
    problems += [f"{r['skill']}: upstream {target(r)} is {r['status'].lower()}"
                 for r in rows if r.get("status") in ("MISSING", "ARCHIVED")]

    if a.json:
        print(json.dumps({"watches": rows, "localOnly": local_only, "problems": problems}, indent=2))
        return 1 if problems else 0

    kinds = {k: sum(r["kind"] == k for r in rows) for k in ("vendored", "fork", "watch")}
    skills = len({r["skill"] for r in rows})
    print(f"skill-upstream: {skills} skill(s) watched ({kinds['vendored']} vendored, {kinds['fork']} fork, "
          f"{kinds['watch']} watch-only); {len(local_only)} local-only")
    order = {"MISSING": 0, "ARCHIVED": 1, "CHANGED": 2, "UNWATCHABLE": 3, "CURRENT": 4, None: 5}
    for row in sorted(rows, key=lambda r: (order[r.get("status")], r["skill"])):
        count = "" if "commits" not in row else f"{row['commits']}{'+' if row['truncated'] else ''}"
        status = row.get("status") or "LISTED"
        print(f"  {status:<11} {row['skill']:<28} {row['kind']:<8} since {row['since'] or '?':<10} {count:>4}  {target(row)}")
        for c in row.get("recent", []) if status != "CURRENT" else []:
            print(f"      {c['date']} {c['sha']} {c['title']}")
    if local_only:
        print(f"  local-only (no upstream declared): {', '.join(local_only)}")
    for problem in problems:
        print(f"  PROBLEM {problem}")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
