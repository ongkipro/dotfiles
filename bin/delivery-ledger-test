python3 "$DL" --repo "$REV" check-boundary >/dev/null 2>&1 || true
python3 "$DL" --repo "$REV" review-boundary --reviewer other-reviewer --reviewer-model rev-model --reviewer-provider impl-provider --reviewer-reasoning high >/dev/null
grep -q '"reviewEvidenceDigest"' "$REV/.delivery/runs"/*.jsonl || fail "review evidence digest was not recorded"

printf 'unreviewed change\n' >> "$REV/auth/session.txt"
set +e; python3 "$DL" --repo "$REV" finish --result PASS >/dev/null 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "approval must not survive an unreviewed change"

# Modified review evidence is rejected even when the event hash is recomputed.
REV_RUN="$(find "$REV/.delivery/runs" -type f -name 'RUN-*.jsonl' | head -n 1)"
cp "$REV_RUN" "$TMP/rev.backup"
python3 - "$REV_RUN" <<'PY'
import hashlib, json, sys
from pathlib import Path
path = Path(sys.argv[1])
lines = path.read_text().splitlines()
event = json.loads(lines[-1])
assert event["type"] == "boundary_review", event["type"]
event["reviewEvidenceDigest"] = "0" * 64
unsigned = dict(event); unsigned.pop("eventHash", None)
canonical = lambda data: json.dumps(data, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
event["eventHash"] = hashlib.sha256(canonical(unsigned).encode()).hexdigest()
lines[-1] = canonical(event)
path.write_text("\n".join(lines) + "\n")
PY
set +e; python3 "$DL" --repo "$REV" verify > "$TMP/rev-verify.log" 2>&1; rc=$?; set -e
[ "$rc" -eq 2 ] || fail "forged review evidence digest must be UNVERIFIED"
grep -q 'review evidence digest' "$TMP/rev-verify.log" || fail "forged review evidence lost its reason"
cp "$TMP/rev.backup" "$REV_RUN"
python3 "$DL" --repo "$REV" finish --result FAIL >/dev/null

# Mutation proof: neutralizing the unexplained-scope guard lets the negative fixture escape.
MUT="$TMP/mutant"; mkdir -p "$MUT"
sed 's/if unexplained:  # unexplained-scope guard/if False:  # unexplained-scope guard/' "$DL" > "$MUT/delivery-ledger"
cp "$ROOT/bin/diff-risk" "$MUT/diff-risk"
BM="$(make_boundary_repo boundary-mutation)"
python3 "$MUT/delivery-ledger" --repo "$BM" start --task TASK-BM --requirement REQ-BM --risk R1 --worker developer --model test --provider test-provider --reasoning-effort high --allow 'src/**' >/dev/null
printf 'escaped\n' >> "$BM/user.txt"
python3 "$MUT/delivery-ledger" --repo "$BM" record --check unit --status PASS >/dev/null
python3 "$MUT/delivery-ledger" --repo "$BM" check-boundary >/dev/null || fail "mutation probe did not neutralize the expected guard"

# Mutation proofs: each new guard, neutralized one at a time, lets its own
# negative fixture through. Without these the assertions above could pass for
# reasons unrelated to the guard they are named after.
make_mutant(){
  local dir="$TMP/$1" marker="$2" replacement="$3"
  mkdir -p "$dir"
  python3 - "$DL" "$dir/delivery-ledger" "$marker" "$replacement" <<'PY'
import sys
from pathlib import Path
source, target, marker, replacement = sys.argv[1:5]
lines = Path(source).read_text().splitlines()
hits = [index for index, line in enumerate(lines) if marker in line]
assert len(hits) == 1, (marker, hits)
line = lines[hits[0]]
lines[hits[0]] = " " * (len(line) - len(line.lstrip())) + replacement
Path(target).write_text("\n".join(lines) + "\n")
PY
  cp "$ROOT/bin/diff-risk" "$dir/diff-risk"
  printf '%s\n' "$dir/delivery-ledger"
}

M_SUB="$(make_mutant mutant-subtree '# subtree-root guard' 'return exact["root"].startswith(subtree["root"] + "/")  # subtree-root guard')"
BS="$(make_boundary_repo boundary-subtree-mutation)"
mkdir -p "$BS/src/auth"
printf 'token\n' > "$BS/src/auth/token.txt"
git -C "$BS" add src/auth/token.txt && git -C "$BS" commit -qm subtree-baseline
python3 "$M_SUB" --repo "$BS" start --task TASK-BS --requirement REQ-BS --risk R2 --worker parent --model test --provider test-provider --reasoning-effort high --allow 'src/**' >/dev/null
python3 "$M_SUB" --repo "$BS" start-child --child one --task T --risk R1 --model child-model --provider child-provider --reasoning-effort medium --allow 'src/auth' --owner one.a --invariant i >/dev/null
python3 "$M_SUB" --repo "$BS" start-child --child two --task T --risk R1 --model child-model --provider child-provider --reasoning-effort medium --allow 'src/auth/**' --owner one.b --invariant i >/dev/null \
  || fail "mutation probe did not neutralize the subtree-root collision guard"

M_PROV="$(make_mutant mutant-provenance '# routing-provenance guard' 'if False:  # routing-provenance guard')"
BPM="$(make_boundary_repo boundary-provenance-mutation)"
python3 "$M_PROV" --repo "$BPM" start --task TASK-BPM --requirement REQ-BPM --risk R1 --worker developer --model unknown --provider unknown --reasoning-effort unknown --allow 'src/**' >/dev/null \
  || fail "mutation probe did not neutralize the routing-provenance guard"

M_ASCII="$(make_mutant mutant-ascii '# ascii-provenance guard' 'if False:  # ascii-provenance guard')"
BAM="$(make_boundary_repo boundary-ascii-mutation)"
python3 "$M_ASCII" --repo "$BAM" start --task TASK-BAM --requirement REQ-BAM --risk R1 --worker "devel${OMICRON}per" --model m --provider p --reasoning-effort high --allow 'src/**' >/dev/null \
  || fail "mutation probe did not neutralize the ASCII provenance guard"

M_CHILD="$(make_mutant mutant-child-provenance '# child-routing-provenance guard' 'if False:  # child-routing-provenance guard')"
BCM="$(make_boundary_repo boundary-child-provenance-mutation)"
python3 "$M_CHILD" --repo "$BCM" start --task TASK-BCM --requirement REQ-BCM --risk R2 --worker parent --model p --provider p --reasoning-effort high --allow 'src/**' >/dev/null
python3 "$M_CHILD" --repo "$BCM" start-child --child unresolved --task T --risk R1 --allow 'src/feature.txt' --owner one.m --invariant i >/dev/null \
  || fail "mutation probe did not neutralize the child-routing-provenance guard"

# --- owner decision 2026-09-01: a failure that was fixed no longer blocks -----
# The old rule refused PASS for any run containing a FAIL. Three times in one day
# that rejected finished, reviewed, green work whose only failure was TASKS.md
# crossing its size budget before being archived — and it taught the obvious
# lesson to anything running under it: do not record a failure you mean to fix.

RES="$(make_boundary_repo resolved-failure)"
python3 "$DL" --repo "$RES" start --task TASK-RES --requirement REQ-RES --risk R1 \
  --worker developer --model impl-model --provider impl-provider --reasoning-effort high \
  --allow 'src/**' >/dev/null
printf 'change\n' >> "$RES/src/feature.txt"
python3 "$DL" --repo "$RES" record --check suite --status FAIL --detail 'budget exceeded' >/dev/null
python3 "$DL" --repo "$RES" record --check suite --status PASS --detail 'archived, re-run' >/dev/null
python3 "$DL" --repo "$RES" check-boundary >/dev/null 2>&1 || true
python3 "$DL" --repo "$RES" finish --result PASS >/dev/null \
  || fail "a check that failed and then passed must no longer block PASS"

# A failure that was never re-run still blocks: nothing says it was resolved.
UNR="$(make_boundary_repo unresolved-failure)"
python3 "$DL" --repo "$UNR" start --task TASK-UNR --requirement REQ-UNR --risk R1 \
  --worker developer --model impl-model --provider impl-provider --reasoning-effort high \
  --allow 'src/**' >/dev/null
printf 'change\n' >> "$UNR/src/feature.txt"
python3 "$DL" --repo "$UNR" record --check other --status PASS >/dev/null
python3 "$DL" --repo "$UNR" record --check suite --status FAIL >/dev/null
python3 "$DL" --repo "$UNR" check-boundary >/dev/null 2>&1 || true
python3 "$DL" --repo "$UNR" finish --result PASS >/dev/null 2>&1 \
  && fail "a check whose latest record is FAIL must still block PASS"

# Passing first and failing after is not a resolution; order is what matters.
ORD="$(make_boundary_repo failure-after-pass)"
python3 "$DL" --repo "$ORD" start --task TASK-ORD --requirement REQ-ORD --risk R1 \
  --worker developer --model impl-model --provider impl-provider --reasoning-effort high \
  --allow 'src/**' >/dev/null
printf 'change\n' >> "$ORD/src/feature.txt"
python3 "$DL" --repo "$ORD" record --check suite --status PASS >/dev/null
python3 "$DL" --repo "$ORD" record --check suite --status FAIL >/dev/null
python3 "$DL" --repo "$ORD" check-boundary >/dev/null 2>&1 || true
python3 "$DL" --repo "$ORD" finish --result PASS >/dev/null 2>&1 \
  && fail "PASS then FAIL on the same check must block; the run ended red"

# An UNVERIFIED check that is not explicitly pre-existing still blocks.
UNV="$(make_boundary_repo unverified-not-preexisting)"
python3 "$DL" --repo "$UNV" start --task TASK-UNV --requirement REQ-UNV --risk R1 \
  --worker developer --model impl-model --provider impl-provider --reasoning-effort high \
  --allow 'src/**' >/dev/null
printf 'change\n' >> "$UNV/src/feature.txt"
# A passing check as well, or the freshness rule denies PASS on its own and this
# case cannot tell the UNVERIFIED guard from its absence — the first version
# could not, and a mutation disabling that guard passed the suite.
python3 "$DL" --repo "$UNV" record --check green --command 'true' >/dev/null
python3 "$DL" --repo "$UNV" record --check suite --status UNVERIFIED --detail 'not run' >/dev/null
python3 "$DL" --repo "$UNV" check-boundary >/dev/null 2>&1 || true
python3 "$DL" --repo "$UNV" finish --result PASS >/dev/null 2>&1 \
  && fail "an UNVERIFIED check that is not pre-existing must still block PASS"

# Freshness is unchanged, and it is what stops the new rule from laundering a
# failure: re-running a check against code that then changes does not resolve it.
FRS="$(make_boundary_repo resolved-then-stale)"
python3 "$DL" --repo "$FRS" start --task TASK-FRS --requirement REQ-FRS --risk R1 \
  --worker developer --model impl-model --provider impl-provider --reasoning-effort high \
  --allow 'src/**' >/dev/null
printf 'change\n' >> "$FRS/src/feature.txt"
python3 "$DL" --repo "$FRS" record --check suite --command 'true' >/dev/null
printf 'edited after the green run\n' >> "$FRS/src/feature.txt"
python3 "$DL" --repo "$FRS" check-boundary >/dev/null 2>&1 || true
python3 "$DL" --repo "$FRS" finish --result PASS >/dev/null 2>&1 \
  && fail "evidence recorded against different code must still deny PASS"

