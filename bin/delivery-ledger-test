reject_child(){
  local label="$1"; shift
  set +e
  python3 "$DL" --repo "$COL" start-child --model child-model --provider child-provider --reasoning-effort medium "$@" >/dev/null 2>&1
  local rc=$?
  set -e
  [ "$rc" -eq 1 ] || fail "pre-dispatch collision not rejected: $label"
}

