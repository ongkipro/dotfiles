reject_child "hierarchical semantic owner overlap" --child c7 --task T --risk R1 --allow 'other/**' --owner identity.session.token --invariant i
reject_child "insufficient risk for protected path" --child c8 --task T --risk R1 --allow 'auth/**' --owner one.g --invariant i
reject_child "unknown dependency" --child c9 --task T --risk R1 --allow 'other/**' --owner one.h --invariant i --depends-on nosuch
reject_child "unintegrated dependency" --child c10 --task T --risk R1 --allow 'other/**' --owner one.i --invariant i --depends-on alpha

python3 "$DL" --repo "$COL" claim-owner --owner commerce.pricing >/dev/null
