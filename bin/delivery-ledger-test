# Case folding cannot see a look-alike character, so identity and route values
# are ASCII-only. OMICRON below is a Greek omicron, not the Latin letter.
OMICRON="$(printf '\316\277')"
BU="$(make_boundary_repo boundary-homoglyph)"
reject_start(){
  local label="$1"; shift
  set +e
  python3 "$DL" --repo "$BU" start --task TASK-BU --requirement REQ-BU --risk R1 --allow 'src/**' "$@" >/dev/null 2>&1
  local rc=$?
  set -e
  [ "$rc" -eq 1 ] || fail "a non-ASCII identity or route must be rejected: $label"
}
reject_start "worker homoglyph" --worker "devel${OMICRON}per" --model m --provider p --reasoning-effort high
reject_start "provider homoglyph" --worker w --model m --provider "unkn${OMICRON}wn" --reasoning-effort high
reject_start "model homoglyph" --worker w --model "m${OMICRON}del" --provider p --reasoning-effort high

python3 "$DL" --repo "$BU" start --task TASK-BU --requirement REQ-BU --risk R1 --worker developer --model impl-model --provider impl-provider --reasoning-effort high --allow 'auth/**' --protect 'auth/**' --protected-risk R3 >/dev/null
printf 'security change\n' >> "$BU/auth/session.txt"
python3 "$DL" --repo "$BU" record --check auth-regression --status PASS >/dev/null
python3 "$DL" --repo "$BU" check-boundary >/dev/null 2>&1 || true
set +e
python3 "$DL" --repo "$BU" review-boundary --reviewer other --reviewer-model "impl-m${OMICRON}del" --reviewer-provider impl-provider --reviewer-reasoning high >/dev/null 2>&1
rc=$?
set -e
[ "$rc" -eq 1 ] || fail "a look-alike reviewer route must be rejected"
python3 "$DL" --repo "$BU" finish --result BLOCKED >/dev/null

# Pre-dispatch collision matrix: every rejected shape below must be refused
