#!/usr/bin/env bash
set -euo pipefail
ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd)}"
DL="$ROOT/bin/delivery-ledger"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/delivery-ledger-test.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
fail(){ echo "FAIL: $*" >&2; exit 1; }

REPO="$TMP/repo"
mkdir -p "$REPO"
cd "$REPO"
git init -q
git config user.email test@example.invalid
git config user.name test
cat > STATUS.md <<'EOF'
# Status
State: PLANNED
EOF
cat > RELEASE.md <<'EOF'
# Release Manifest
Release-ID: REL-TEST-001
Base: HEAD
Environment: production
Declared-Risk: R1
Rollback-Ref: HEAD
Rollback-Command: git reset --hard HEAD
Backup-Proof: NOT_REQUIRED
Status: READY
EOF
git add STATUS.md RELEASE.md && git commit -qm baseline

python3 "$DL" --repo "$REPO" init >/dev/null
[ -f "$REPO/.delivery/current.json" ] || fail "current.json missing"
python3 "$DL" --repo "$REPO" verify >/dev/null || fail "fresh ledger should verify"

python3 "$DL" --repo "$REPO" start --task TASK-001 --requirement REQ-001 --risk R1 --job implementation --capability native-first --worker task --model test-model --provider test-provider --reasoning-effort high >/dev/null
RUN_FILE="$(find "$REPO/.delivery/runs" -type f -name 'RUN-*.jsonl' | head -n 1)"
[ -n "$RUN_FILE" ] || fail "run evidence missing"
python3 "$DL" --repo "$REPO" record --check project-check --status PASS --detail ok >/dev/null
python3 "$DL" --repo "$REPO" checkpoint --note verified >/dev/null

grep -q '"type":"verification"' "$RUN_FILE" || fail "verification event missing"
grep -q '"type":"checkpoint"' "$RUN_FILE" || fail "checkpoint event missing"
grep -q '"eventHash"' "$RUN_FILE" || fail "event hash missing"
grep -q '"capability":"native-first"' "$RUN_FILE" || fail "capability evidence missing"
grep -q '"provider":"test-provider"' "$RUN_FILE" || fail "provider evidence missing"
grep -q '"reasoningEffort":"high"' "$RUN_FILE" || fail "reasoning effort evidence missing"
python3 "$DL" --repo "$REPO" verify >/dev/null || fail "hash chain should verify"

python3 - <<'PY'
from pathlib import Path
p=Path('STATUS.md'); p.write_text(p.read_text().replace('PLANNED','READY'))
PY
set +e
python3 "$DL" --repo "$REPO" verify >/dev/null 2>&1
rc=$?
set -e
[ "$rc" -eq 2 ] || fail "state drift should be UNVERIFIED"
python3 "$DL" --repo "$REPO" checkpoint --note state-synced >/dev/null
python3 "$DL" --repo "$REPO" verify >/dev/null || fail "checkpoint should resolve state drift"

git add STATUS.md .delivery && git commit -qm checkpoint
python3 "$DL" --repo "$REPO" verify >/dev/null || fail "descendant HEAD should remain valid"

python3 "$DL" --repo "$REPO" finish --result PASS --detail done >/dev/null
python3 - <<'PY'
import json
from pathlib import Path
data=json.loads(Path('.delivery/current.json').read_text())
assert data['activeRun'] is None
assert data['lastRun']['result']=='PASS'
PY

python3 "$DL" --repo "$REPO" start --task TASK-002 --requirement REQ-002 --risk R1 --worker task --model test-model >/dev/null
python3 "$DL" --repo "$REPO" record --check regression --status FAIL --detail broken >/dev/null
set +e
python3 "$DL" --repo "$REPO" finish --result PASS --detail invalid >/dev/null 2>&1
rc=$?
set -e
[ "$rc" -eq 1 ] || fail "PASS must be rejected after failed verification"
python3 "$DL" --repo "$REPO" finish --result FAIL --detail verified-failure >/dev/null
python3 "$DL" --repo "$REPO" verify >/dev/null || fail "failed run with honest result should verify"

cp "$RUN_FILE" "$TMP/run.backup"
python3 - "$RUN_FILE" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]); s=p.read_text(); p.write_text(s.replace('project-check','project-checX',1))
PY
set +e
python3 "$DL" --repo "$REPO" verify >/dev/null 2>&1
rc=$?
set -e
[ "$rc" -eq 2 ] || fail "tampered run chain should be UNVERIFIED"
cp "$TMP/run.backup" "$RUN_FILE"

python3 "$DL" --repo "$REPO" snapshot-release --release-id REL-TEST-001 >/dev/null
SNAP="$REPO/.delivery/releases/REL-TEST-001.json"
[ -f "$SNAP" ] || fail "release snapshot missing"
grep -q 'snapshotHash' "$SNAP" || fail "snapshot hash missing"
grep -q 'Rollback-Command' "$SNAP" || fail "rollback command missing from release snapshot"
python3 "$DL" --repo "$REPO" verify >/dev/null || fail "snapshot should verify"
set +e
python3 "$DL" --repo "$REPO" snapshot-release --release-id REL-TEST-001 >/dev/null 2>&1
rc=$?
set -e
[ "$rc" -eq 1 ] || fail "release snapshot must be immutable"

python3 - "$SNAP" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]); s=p.read_text(); p.write_text(s.replace('production','productioX',1))
PY
set +e
python3 "$DL" --repo "$REPO" verify >/dev/null 2>&1
rc=$?
set -e
[ "$rc" -eq 2 ] || fail "tampered release snapshot should be UNVERIFIED"

echo 'delivery-ledger-test: PASS'
