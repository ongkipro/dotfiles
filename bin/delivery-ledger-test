reject_review "unknown reviewer reasoning" --reviewer other-reviewer --reviewer-model rev-model --reviewer-provider rev-provider --reviewer-reasoning unknown
reject_review "self-review under the implementer identity" --reviewer developer --reviewer-model rev-model --reviewer-provider rev-provider --reviewer-reasoning high
reject_review "self-review behind a different label" --reviewer other-reviewer --reviewer-model impl-model --reviewer-provider impl-provider --reviewer-reasoning high
# Independence is decided by string equality, so presentation must not defeat it.
reject_review "self-review behind a re-cased identity" --reviewer Developer --reviewer-model rev-model --reviewer-provider rev-provider --reviewer-reasoning high
reject_review "implementer route behind trailing whitespace" --reviewer other-reviewer --reviewer-model 'impl-model ' --reviewer-provider impl-provider --reviewer-reasoning high
reject_review "implementer route behind different casing" --reviewer other-reviewer --reviewer-model IMPL-MODEL --reviewer-provider Impl-Provider --reviewer-reasoning high
set +e; python3 "$DL" --repo "$REV" finish --result PASS >/dev/null 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "PASS must be denied while review-required boundary is unapproved"

printf 'late edit\n' >> "$REV/auth/session.txt"
