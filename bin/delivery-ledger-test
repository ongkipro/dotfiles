  local label="$1"; shift
  set +e
  python3 "$DL" --repo "$REV" review-boundary "$@" >/dev/null 2>&1
  local rc=$?
  set -e
  [ "$rc" -eq 1 ] || fail "review independence not enforced: $label"
}

reject_review "unknown reviewer model" --reviewer other-reviewer --reviewer-model unknown --reviewer-provider rev-provider --reviewer-reasoning high
