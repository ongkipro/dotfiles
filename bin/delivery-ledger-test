#!/usr/bin/env bash
set -euo pipefail
ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd)}"
DL="$ROOT/bin/delivery-ledger"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/delivery-ledger-test.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
fail(){ echo "FAIL: $*" >&2; exit 1; }

REPO="$TMP/repo"
mkdir -p "$REPO"
cd "$REPO"
git init -q
git config user.email test@example.invalid
git config user.name test
cat > STATUS.md <<'EOF'
# Status
State: PLANNED
EOF
cat > RELEASE.md <<'EOF'
# Release Manifest
Release-ID: REL-TEST-001
Base: HEAD
Environment: production
Declared-Risk: R1
Rollback-Ref: HEAD
Rollback-Command: git reset --hard HEAD
Backup-Proof: NOT_REQUIRED
Status: READY
EOF
git add STATUS.md RELEASE.md && git commit -qm baseline

python3 "$DL" --repo "$REPO" init >/dev/null
[ -f "$REPO/.delivery/current.json" ] || fail "current.json missing"
[ "$(cat "$REPO/.delivery/.gitignore")" = 'ledger.lock' ] || fail "ledger lock ignore missing"
python3 "$DL" --repo "$REPO" verify >/dev/null || fail "fresh ledger should verify"

python3 "$DL" --repo "$REPO" start --task TASK-001 --requirement REQ-001 --risk R0 --job implementation --capability native-first --worker task --model test-model --provider test-provider --reasoning-effort high >/dev/null
RUN_FILE="$(find "$REPO/.delivery/runs" -type f -name 'RUN-*.jsonl' | head -n 1)"
[ -n "$RUN_FILE" ] || fail "run evidence missing"
python3 "$DL" --repo "$REPO" record --check project-check --status PASS --detail ok >/dev/null
python3 "$DL" --repo "$REPO" checkpoint --note verified >/dev/null

grep -q '"type":"verification"' "$RUN_FILE" || fail "verification event missing"
grep -q '"type":"checkpoint"' "$RUN_FILE" || fail "checkpoint event missing"
grep -q '"eventHash"' "$RUN_FILE" || fail "event hash missing"
grep -q '"capability":"native-first"' "$RUN_FILE" || fail "capability evidence missing"
grep -q '"provider":"test-provider"' "$RUN_FILE" || fail "provider evidence missing"
grep -q '"reasoningEffort":"high"' "$RUN_FILE" || fail "reasoning effort evidence missing"
python3 "$DL" --repo "$REPO" verify >/dev/null || fail "hash chain should verify"

python3 - <<'PY'
from pathlib import Path
p=Path('STATUS.md'); p.write_text(p.read_text().replace('PLANNED','READY'))
PY
set +e
python3 "$DL" --repo "$REPO" verify >/dev/null 2>&1
rc=$?
set -e
[ "$rc" -eq 2 ] || fail "state drift should be UNVERIFIED"
python3 "$DL" --repo "$REPO" checkpoint --note state-synced >/dev/null
python3 "$DL" --repo "$REPO" verify >/dev/null || fail "checkpoint should resolve state drift"

git add STATUS.md .delivery && git commit -qm checkpoint
python3 "$DL" --repo "$REPO" verify >/dev/null || fail "descendant HEAD should remain valid"

python3 "$DL" --repo "$REPO" finish --result PASS --detail done >/dev/null
python3 - <<'PY'
import json
from pathlib import Path
data=json.loads(Path('.delivery/current.json').read_text())
assert data['activeRun'] is None
assert data['lastRun']['result']=='PASS'
PY

python3 "$DL" --repo "$REPO" start --task TASK-002 --requirement REQ-002 --risk R0 --worker task --model test-model >/dev/null
python3 "$DL" --repo "$REPO" record --check regression --status FAIL --detail broken >/dev/null
set +e
python3 "$DL" --repo "$REPO" finish --result PASS --detail invalid >/dev/null 2>&1
rc=$?
set -e
[ "$rc" -eq 1 ] || fail "PASS must be rejected after failed verification"
python3 "$DL" --repo "$REPO" finish --result FAIL --detail verified-failure >/dev/null
python3 "$DL" --repo "$REPO" verify >/dev/null || fail "failed run with honest result should verify"

cp "$RUN_FILE" "$TMP/run.backup"
python3 - "$RUN_FILE" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]); s=p.read_text(); p.write_text(s.replace('project-check','project-checX',1))
PY
set +e
python3 "$DL" --repo "$REPO" verify >/dev/null 2>&1
rc=$?
set -e
[ "$rc" -eq 2 ] || fail "tampered run chain should be UNVERIFIED"
cp "$TMP/run.backup" "$RUN_FILE"

python3 "$DL" --repo "$REPO" snapshot-release --release-id REL-TEST-001 >/dev/null
SNAP="$REPO/.delivery/releases/REL-TEST-001.json"
[ -f "$SNAP" ] || fail "release snapshot missing"
grep -q 'snapshotHash' "$SNAP" || fail "snapshot hash missing"
grep -q 'Rollback-Command' "$SNAP" || fail "rollback command missing from release snapshot"
python3 "$DL" --repo "$REPO" verify >/dev/null || fail "snapshot should verify"
set +e
python3 "$DL" --repo "$REPO" snapshot-release --release-id REL-TEST-001 >/dev/null 2>&1
rc=$?
set -e
[ "$rc" -eq 1 ] || fail "release snapshot must be immutable"

python3 - "$SNAP" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]); s=p.read_text(); p.write_text(s.replace('production','productioX',1))
PY
set +e
python3 "$DL" --repo "$REPO" verify >/dev/null 2>&1
rc=$?
set -e
[ "$rc" -eq 2 ] || fail "tampered release snapshot should be UNVERIFIED"

make_boundary_repo(){
  local name="$1" target
  target="$TMP/$name"
  mkdir -p "$target/src" "$target/auth" "$target/docs"
  git -C "$target" init -q
  git -C "$target" config user.email test@example.invalid
  git -C "$target" config user.name test
  printf '# Status\nState: PLANNED\n' > "$target/STATUS.md"
  printf 'feature base\n' > "$target/src/feature.txt"
  printf 'user base\n' > "$target/user.txt"
  printf 'session base\n' > "$target/auth/session.txt"
  printf 'old\n' > "$target/docs/old.txt"
  git -C "$target" add . && git -C "$target" commit -qm baseline
  python3 "$DL" --repo "$target" init >/dev/null
  printf '%s\n' "$target"
}

# Clean repository plus an allowed change passes and can finish.
B1="$(make_boundary_repo boundary-allowed)"
python3 "$DL" --repo "$B1" start --task TASK-B1 --requirement REQ-B1 --risk R1 --worker developer --model test --provider test-provider --reasoning-effort high --allow 'src/**' >/dev/null
printf 'task change\n' >> "$B1/src/feature.txt"
python3 "$DL" --repo "$B1" record --check unit --status PASS >/dev/null
python3 "$DL" --repo "$B1" check-boundary --json > "$TMP/b1.json"
python3 - "$TMP/b1.json" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); assert d['result']=='PASS',d; assert d['taskOwnedChanges'][0]['classification']=='ALLOWED',d
PY
python3 "$DL" --repo "$B1" finish --result PASS >/dev/null

# The canonical parallel-child example in docs/task-change-boundary.md is
# executed, not proofread. TASK-020's routing-provenance guard broke it and
# nothing noticed for eleven days: the block omitted --model/--provider/
# --reasoning-effort, argparse defaulted them to "unknown", and the guard refused
# the run. Documentation that shows a command nobody runs is a command that stops
# working.
DOC="$ROOT/docs/task-change-boundary.md"
DOCREPO="$TMP/docexample"; mkdir -p "$DOCREPO/src/cart"
(cd "$DOCREPO"; git init -q; git config user.email t@e.com; git config user.name t
 printf '# Status\nState: READY\n' > STATUS.md; printf 'base\n' > src/cart/api.ts
 git add .; git commit -qm base)
python3 "$DL" --repo "$DOCREPO" init >/dev/null
python3 "$DL" --repo "$DOCREPO" start --task TASK-123 --requirement REQ-1 --risk R2 \
  --worker task --model m --provider p --reasoning-effort high --allow 'src/**' >/dev/null

# Take the block the document actually publishes, not a copy of it.
python3 - "$DOC" "$TMP/child-example.sh" <<'PY'
import re, sys, pathlib
text = pathlib.Path(sys.argv[1]).read_text()
blocks = [b for b in re.findall(r"```bash\n(.*?)```", text, re.S) if "start-child" in b]
if len(blocks) != 1:
    raise SystemExit(f"expected exactly one start-child example, found {len(blocks)}")
pathlib.Path(sys.argv[2]).write_text(blocks[0])
PY
grep -q -- '--reasoning-effort' "$TMP/child-example.sh" \
  || fail "the documented child example omits routing provenance the guard requires"

# `delivery-ledger` in the block is the installed name; run the tree's copy, and
# stop at finish-child — integration needs a real patch the document does not
# carry, and inventing one here would test this test rather than the example.
python3 - "$TMP/child-example.sh" "$DL" "$DOCREPO" "$TMP" <<'PY'
import pathlib, re, sys
block, dl, repo, tmp = (pathlib.Path(sys.argv[1]).read_text(), *sys.argv[2:])
# Join the block's line continuations, then split into whole commands.
flat = re.sub(r"\\\n\s*", " ", block)
cmds = [c.strip() for c in flat.splitlines() if c.strip().startswith("delivery-ledger")]
by = lambda name: next(c for c in cmds if name in c)
rewrite = lambda c: (c.replace("delivery-ledger ", f"python3 {dl} ", 1)
                      .replace("--repo .", f"--repo {repo}")
                      .replace("/tmp/cart-api.patch", f"{tmp}/cart-api.patch"))
# Order matters and the document states it: the child is started, *then* works.
# Producing its patch first makes its own boundary overlap the parent's dirty
# tree, which the ledger correctly refuses.
pathlib.Path(f"{tmp}/child-a.sh").write_text(rewrite(by("start-child")) + "\n")
pathlib.Path(f"{tmp}/child-b.sh").write_text(
    "\n".join(rewrite(by(n)) for n in ("record-child", "finish-child")) + "\n")
PY
bash "$TMP/child-a.sh" >/dev/null 2>"$TMP/child-run.err" \
  || { cat "$TMP/child-run.err" >&2; fail "the documented start-child does not run"; }
printf 'task change\n' >> "$DOCREPO/src/cart/api.ts"
(cd "$DOCREPO" && git diff -- src/cart > "$TMP/cart-api.patch")
bash "$TMP/child-b.sh" >/dev/null 2>"$TMP/child-run.err" \
  || { cat "$TMP/child-run.err" >&2; fail "the documented parallel-child example does not run"; }

# Executed evidence. Freshness proves a check was not stale; nothing proved it
# ever ran. This ledger has already accepted `installer-link-test PASS` detailed
# "pending run below" — recorded before the check ran, by the session building
# these gates. `--command` closes that by deriving the status from an exit code.
EXEC="$TMP/exec"; mkdir -p "$EXEC"
(cd "$EXEC"; git init -q; git config user.email t@e.com; git config user.name t
 printf '# Status\nState: READY\n' > STATUS.md; git add .; git commit -qm baseline)
python3 "$DL" --repo "$EXEC" init >/dev/null
python3 "$DL" --repo "$EXEC" start --task TASK-EX --requirement REQ-EX --risk R0 --worker task --model m --provider p --reasoning-effort high >/dev/null

python3 "$DL" --repo "$EXEC" record --check green --command 'exit 0' >/dev/null
python3 "$DL" --repo "$EXEC" record --check red --command 'echo boom; exit 7' >/dev/null
RUNFILE="$(find "$EXEC/.delivery/runs" -name 'RUN-*.jsonl')"
grep -q '"check":"green","checkedDigest"' "$RUNFILE" 2>/dev/null || true
python3 - "$RUNFILE" <<'PY'
import json,sys
ev=[json.loads(l) for l in open(sys.argv[1])]
v={e['check']:e for e in ev if e.get('type')=='verification'}
assert v['green']['status']=='PASS', v['green']
assert v['red']['status']=='FAIL', v['red']
assert v['red']['executed']['exitCode']==7, v['red']
assert v['red']['executed']['command']=='echo boom; exit 7', v['red']
assert 'boom' in v['red']['executed']['outputTail'], v['red']
assert v['green']['executed']['exitCode']==0, v['green']
PY

# An agent that may both run the check and name its result can skip the first
# half. The command decides, or the flag buys nothing.
set +e; python3 "$DL" --repo "$EXEC" record --check both --status PASS --command 'exit 0' >/dev/null 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "--status alongside --command must be refused"

# Declared evidence stays possible — a browser check has no exit code — but it
# must still say which it is.
python3 "$DL" --repo "$EXEC" record --check manual --status PASS --detail 'observed in a browser' >/dev/null
set +e; python3 "$DL" --repo "$EXEC" record --check neither >/dev/null 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "record without --status or --command must be refused"

# A FAIL from an executed check must bar PASS exactly as a declared one does.
set +e; python3 "$DL" --repo "$EXEC" finish --result PASS >/dev/null 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "an executed FAIL must bar a PASS finish"
python3 "$DL" --repo "$EXEC" finish --result FAIL >/dev/null

# Evidence must describe the code being shipped. A suite that passed before the
# last edit proves nothing about what is on disk now, and HEAD does not move
# while an agent works uncommitted, so nothing else would notice.
BSTALE="$(make_boundary_repo boundary-stale-evidence)"
python3 "$DL" --repo "$BSTALE" start --task TASK-BS --requirement REQ-BS --risk R1 --worker developer --model test --provider test-provider --reasoning-effort high --allow 'src/**' >/dev/null
printf 'first attempt\n' >> "$BSTALE/src/feature.txt"
python3 "$DL" --repo "$BSTALE" record --check unit --status PASS >/dev/null
printf 'edited after the green check\n' >> "$BSTALE/src/feature.txt"
python3 "$DL" --repo "$BSTALE" check-boundary >/dev/null
set +e; python3 "$DL" --repo "$BSTALE" finish --result PASS >/dev/null 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "a PASS whose only green check predates the last edit must be refused as stale"
python3 "$DL" --repo "$BSTALE" record --check unit --status PASS >/dev/null
python3 "$DL" --repo "$BSTALE" check-boundary >/dev/null
python3 "$DL" --repo "$BSTALE" finish --result PASS >/dev/null || fail "re-running the check against the current tree must clear the staleness"

# Committing verified work is not a change to it. A first attempt at the rule
# above collected "currently dirty" at both ends; a commit empties that set
# without touching a byte, so it declared commit-then-finish stale. The digest
# therefore re-measures a *fixed* recorded path list instead of recollecting one.
#
# This needs its own case. The unbounded run at the top of this file looks like
# it covers it and does not: `.delivery/` is excluded from dirty paths, so its
# check is recorded against an empty set and both definitions agree. A bounded
# run cannot cover it either — its boundary refuses a mid-run commit with
# "repository HEAD moved after baseline capture". Only an unbounded run holding a
# genuinely dirty tracked file can tell the two apart.
CMT="$TMP/commit-then-finish"; mkdir -p "$CMT"
(cd "$CMT"; git init -q; git config user.email t@e.com; git config user.name t
 printf '# Status\nState: READY\n' > STATUS.md; printf 'base\n' > work.txt
 git add . && git commit -qm baseline)
python3 "$DL" --repo "$CMT" init >/dev/null
python3 "$DL" --repo "$CMT" start --task TASK-CMT --requirement REQ-CMT --risk R0 --worker task --model m --provider p --reasoning-effort high >/dev/null
printf 'verified change\n' >> "$CMT/work.txt"
python3 "$DL" --repo "$CMT" record --check unit --status PASS >/dev/null
grep -q '"checkedPaths":\["work.txt"\]' "$(find "$CMT/.delivery/runs" -name 'RUN-*.jsonl')" \
  || fail "the check must record the dirty file it ran against, or this case proves nothing"
git -C "$CMT" add work.txt && git -C "$CMT" commit -qm 'commit the verified work'
python3 "$DL" --repo "$CMT" finish --result PASS >/dev/null \
  || fail "committing verified work must not invalidate its verification"

# An unrelated change fails, denies PASS, and does not reset or clean user work.
B2="$(make_boundary_repo boundary-outside)"
python3 "$DL" --repo "$B2" start --task TASK-B2 --requirement REQ-B2 --risk R1 --worker developer --model test --provider test-provider --reasoning-effort high --allow 'src/**' >/dev/null
printf 'must remain\n' >> "$B2/user.txt"
python3 "$DL" --repo "$B2" record --check unit --status PASS >/dev/null
set +e; python3 "$DL" --repo "$B2" check-boundary --json > "$TMP/b2.json"; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "unexplained out-of-scope change must fail"
grep -q 'must remain' "$B2/user.txt" || fail "boundary check modified user work"
set +e; python3 "$DL" --repo "$B2" finish --result PASS >/dev/null 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "PASS must be denied after boundary failure"
python3 "$DL" --repo "$B2" finish --result FAIL >/dev/null

# Unrelated pre-existing dirty work remains distinguishable and untouched.
B3="$(make_boundary_repo boundary-dirty-unrelated)"
printf 'pre-existing\n' >> "$B3/user.txt"
python3 "$DL" --repo "$B3" start --task TASK-B3 --requirement REQ-B3 --risk R1 --worker developer --model test --provider test-provider --reasoning-effort high --allow 'src/**' >/dev/null
printf 'task\n' >> "$B3/src/feature.txt"
python3 "$DL" --repo "$B3" record --check unit --status PASS >/dev/null
python3 "$DL" --repo "$B3" check-boundary --json > "$TMP/b3.json"
python3 - "$TMP/b3.json" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); assert d['result']=='PASS',d; assert d['preexistingUnchanged']==['user.txt'],d; assert [x['path'] for x in d['taskOwnedChanges']]==['src/feature.txt'],d
PY
python3 "$DL" --repo "$B3" finish --result PASS >/dev/null

# Dirty overlap blocks by default; explicit continuation stays detectable and review-gated.
B4="$(make_boundary_repo boundary-dirty-overlap)"
printf 'pre-existing\n' >> "$B4/src/feature.txt"
set +e; python3 "$DL" --repo "$B4" start --task TASK-B4 --requirement REQ-B4 --risk R1 --worker developer --model test --provider test-provider --reasoning-effort high --allow 'src/**' >/dev/null 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "dirty overlap must block start"
python3 "$DL" --repo "$B4" start --task TASK-B4 --requirement REQ-B4 --risk R1 --worker developer --model test --provider test-provider --reasoning-effort high --allow 'src/**' --accept-dirty 'src/feature.txt' >/dev/null
printf 'task continuation\n' >> "$B4/src/feature.txt"
python3 "$DL" --repo "$B4" record --check unit --status PASS >/dev/null
set +e; python3 "$DL" --repo "$B4" check-boundary --json > "$TMP/b4.json"; rc=$?; set -e
[ "$rc" -eq 2 ] || fail "changed accepted dirty overlap must require review"
grep -q '"classification": "PREEXISTING"' "$TMP/b4.json" || fail "touched pre-existing path was not classified"
python3 "$DL" --repo "$B4" review-boundary --reviewer independent-reviewer --reviewer-model review-model --reviewer-provider review-provider --reviewer-reasoning high >/dev/null
python3 "$DL" --repo "$B4" finish --result PASS >/dev/null

# Child runs at R1-R4 must carry resolved routing provenance too — the
# parent's guard means nothing if the paralleled worker's route is unrecorded.
BCP="$(make_boundary_repo boundary-child-provenance)"
python3 "$DL" --repo "$BCP" start --task TASK-BCP --requirement REQ-BCP --risk R2 --worker parent --model p --provider p --reasoning-effort high --allow 'src/**' >/dev/null
set +e
python3 "$DL" --repo "$BCP" start-child --child unresolved --task T --risk R1 --allow 'src/feature.txt' --owner one.k --invariant i >/dev/null 2>&1
rc=$?
set -e
[ "$rc" -eq 1 ] || fail "an R1-R4 child run must reject unresolved routing provenance"
python3 "$DL" --repo "$BCP" start-child --child resolved --task T --risk R1 --model child-model --provider child-provider --reasoning-effort medium --allow 'src/feature.txt' --owner one.k --invariant i >/dev/null \
  || fail "a resolved child route must be accepted"
python3 "$DL" --repo "$BCP" finish --result BLOCKED >/dev/null

# Globs handle nested, deleted, untracked, renamed, spaced, and Unicode paths.
B5="$(make_boundary_repo boundary-paths)"
python3 "$DL" --repo "$B5" start --task TASK-B5 --requirement REQ-B5 --risk R2 --worker developer --model test --provider test-provider --reasoning-effort high --allow 'src/**' --allow 'docs/**' --allow 'space dir/**' >/dev/null
mkdir -p "$B5/src/deep/cart" "$B5/space dir"
printf 'nested\n' > "$B5/src/deep/cart/cart1.txt"
printf 'unicode\n' > "$B5/space dir/fitur-ä.txt"
git -C "$B5" mv docs/old.txt docs/new.txt
rm "$B5/src/feature.txt"
python3 "$DL" --repo "$B5" record --check path-test --status PASS >/dev/null
python3 "$DL" --repo "$B5" check-boundary --json > "$TMP/b5.json"
python3 - "$TMP/b5.json" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); paths={x['path'] for x in d['taskOwnedChanges']}; assert {'src/deep/cart/cart1.txt','space dir/fitur-ä.txt','docs/old.txt','docs/new.txt','src/feature.txt'} <= paths,d; assert all(x['classification']=='ALLOWED' for x in d['taskOwnedChanges']),d
PY
python3 "$DL" --repo "$B5" finish --result PASS >/dev/null

# A protected path raises effective risk and requires independent review.
B6="$(make_boundary_repo boundary-protected)"
python3 "$DL" --repo "$B6" start --task TASK-B6 --requirement REQ-B6 --risk R1 --worker developer --model test --provider test-provider --reasoning-effort high --allow 'auth/**' --protect 'auth/**' --protected-risk R3 >/dev/null
printf 'security change\n' >> "$B6/auth/session.txt"
python3 "$DL" --repo "$B6" record --check auth-regression --status PASS >/dev/null
set +e; python3 "$DL" --repo "$B6" check-boundary --json > "$TMP/b6.json"; rc=$?; set -e
[ "$rc" -eq 2 ] || fail "protected path must require review"
python3 - "$TMP/b6.json" <<'PY'
import json,sys
d=json.load(open(sys.argv[1])); assert d['effectiveRisk']=='R3',d; assert d['protected']==['auth/session.txt'],d
PY
python3 "$DL" --repo "$B6" review-boundary --reviewer security-reviewer --reviewer-model review-model --reviewer-provider review-provider --reviewer-reasoning high >/dev/null
python3 "$DL" --repo "$B6" finish --result PASS >/dev/null

# A requirement-linked expansion fails until its named verification passes.
B7="$(make_boundary_repo boundary-expansion)"
python3 "$DL" --repo "$B7" start --task TASK-B7 --requirement REQ-B7 --risk R1 --worker developer --model test --provider test-provider --reasoning-effort high --allow 'src/**' >/dev/null
printf 'shared dependency\n' >> "$B7/auth/session.txt"
set +e; python3 "$DL" --repo "$B7" expand-scope --path 'auth/session.txt' --reason cleanup --required-by 'REQ-B7 criterion 4' --risk R3 --verification auth-regression >/dev/null 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "generic scope expansion reason must be rejected"
python3 "$DL" --repo "$B7" expand-scope --path 'auth/session.txt' --reason 'REQ-B7 criterion 4 calls the shared session boundary' --required-by 'REQ-B7 criterion 4' --risk R3 --verification auth-regression >/dev/null
python3 "$DL" --repo "$B7" record --check unit --status PASS >/dev/null
set +e; python3 "$DL" --repo "$B7" check-boundary >/dev/null; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "expansion without required verification must fail"
python3 "$DL" --repo "$B7" record --check auth-regression --status PASS >/dev/null
set +e; python3 "$DL" --repo "$B7" check-boundary --json > "$TMP/b7.json"; rc=$?; set -e
[ "$rc" -eq 2 ] || fail "verified scope expansion must require review"
python3 "$DL" --repo "$B7" review-boundary --reviewer integration-reviewer --reviewer-model review-model --reviewer-provider review-provider --reviewer-reasoning high >/dev/null
python3 "$DL" --repo "$B7" finish --result PASS >/dev/null

# Unexpected HEAD movement invalidates the captured baseline.
B12="$(make_boundary_repo boundary-head-move)"
python3 "$DL" --repo "$B12" start --task TASK-B12 --requirement REQ-B12 --risk R1 --worker developer --model test --provider test-provider --reasoning-effort high --allow 'src/**' >/dev/null
printf 'commit during task\n' >> "$B12/src/feature.txt"
git -C "$B12" add src/feature.txt && git -C "$B12" commit -qm unexpected-head-move
python3 "$DL" --repo "$B12" record --check unit --status PASS >/dev/null
set +e; python3 "$DL" --repo "$B12" check-boundary --json > "$TMP/b12.json"; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "HEAD movement must fail the boundary"
grep -q 'repository HEAD moved' "$TMP/b12.json" || fail "HEAD movement reason missing"
python3 "$DL" --repo "$B12" finish --result FAIL >/dev/null

# Pattern matching is case-sensitive and portable across Linux/macOS Python.
B14="$(make_boundary_repo boundary-case)"
printf 'case\n' > "$B14/Case.txt"
python3 "$DL" --repo "$B14" start --task TASK-B14 --requirement REQ-B14 --risk R1 --worker developer --model test --provider test-provider --reasoning-effort high --allow 'case.txt' >/dev/null
printf 'changed\n' >> "$B14/Case.txt"
python3 "$DL" --repo "$B14" record --check portability --status PASS >/dev/null
set +e; python3 "$DL" --repo "$B14" check-boundary >/dev/null; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "boundary patterns must remain case-sensitive"
python3 "$DL" --repo "$B14" finish --result FAIL >/dev/null

# Parallel child evidence is executable: semantic owners cannot overlap, no
# patch integrates while a child is active, and the parent applies finished
# patches one at a time from immutable digest/path evidence.
BC="$(make_boundary_repo boundary-children)"
printf 'second base\n' > "$BC/src/second.txt"
git -C "$BC" add src/second.txt && git -C "$BC" commit -qm child-baseline
python3 "$DL" --repo "$BC" start --task TASK-BC --requirement REQ-BC --risk R2 --worker parent --model test --provider test-provider --reasoning-effort high --allow 'src/**' >/dev/null
git clone -q "$BC" "$TMP/child-a"; git clone -q "$BC" "$TMP/child-b"
printf 'child a\n' >> "$TMP/child-a/src/feature.txt"
git -C "$TMP/child-b" mv src/second.txt 'src/fitur-ä.txt'
printf 'child b\n' >> "$TMP/child-b/src/fitur-ä.txt"
git -C "$TMP/child-a" diff --binary > "$TMP/child-a.patch"
git -C "$TMP/child-b" diff HEAD --binary > "$TMP/child-b.patch"
python3 "$DL" --repo "$BC" start-child --child child-a --task TASK-BC-A --risk R1 --model child-model --provider child-provider --reasoning-effort medium --allow 'src/feature.txt' --owner identity.session --invariant 'feature behavior remains observable' >/dev/null
set +e; python3 "$DL" --repo "$BC" start-child --child collision --task TASK-BC-C --risk R1 --model child-model --provider child-provider --reasoning-effort medium --allow 'src/second.txt' --owner identity.session --invariant 'different path, same semantic owner' >/dev/null 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "semantic owner overlap must reject disjoint-path children"
python3 "$DL" --repo "$BC" start-child --child child-b --task TASK-BC-B --risk R1 --model child-model --provider child-provider --reasoning-effort medium --allow 'src/second.txt' --allow 'src/fitur-ä.txt' --owner commerce.pricing --invariant 'second behavior remains observable' >/dev/null
python3 "$DL" --repo "$BC" record-child --child child-a --check regression-a --status PASS >/dev/null
python3 "$DL" --repo "$BC" finish-child --child child-a --result PASS --patch "$TMP/child-a.patch" >/dev/null
set +e; python3 "$DL" --repo "$BC" integrate-child --child child-a --patch "$TMP/child-a.patch" >/dev/null 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "integration must wait until every parallel child finishes"
python3 "$DL" --repo "$BC" record-child --child child-b --check regression-b --status PASS >/dev/null
python3 "$DL" --repo "$BC" finish-child --child child-b --result PASS --patch "$TMP/child-b.patch" >/dev/null
printf 'parent work\n' >> "$BC/src/feature.txt"
set +e; python3 "$DL" --repo "$BC" integrate-child --child child-a --patch "$TMP/child-a.patch" >/dev/null 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "child integration must not overlap current parent work"
printf 'feature base\n' > "$BC/src/feature.txt"
python3 "$DL" --repo "$BC" integrate-child --child child-a --patch "$TMP/child-a.patch" >/dev/null
python3 "$DL" --repo "$BC" integrate-child --child child-b --patch "$TMP/child-b.patch" >/dev/null
grep -q 'child a' "$BC/src/feature.txt" || fail "first child patch was not applied"
grep -q 'child b' "$BC/src/fitur-ä.txt" || fail "renamed Unicode child patch was not applied"
[ ! -e "$BC/src/second.txt" ] || fail "child rename retained the old path"
python3 "$DL" --repo "$BC" record --check integration-regression --status PASS >/dev/null
python3 "$DL" --repo "$BC" check-boundary >/dev/null
python3 "$DL" --repo "$BC" finish --result PASS >/dev/null

# Routing provenance is required evidence for every R1-R4 run; R0 stays inferable.
