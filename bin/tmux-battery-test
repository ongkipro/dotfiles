#!/usr/bin/env bash
# tmux-battery renders into the status line. It must never emit an error into
# the bar, and must exit 0 on a machine with no battery at all.
set -uo pipefail
ROOT="${1:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
CMD="$ROOT/bin/tmux-battery"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
f=0; ok(){ printf '  ✓ %s\n' "$1"; }; bad(){ echo "  FAIL $1" >&2; f=$((f+1)); }

out="$(bash "$CMD" 2>/dev/null)"; rc=$?
[ "$rc" -eq 0 ] && ok "it exits 0 on this machine" || bad "exited $rc"
printf '%s' "$out" | grep -qiE 'error|not found|no such|traceback' \
  && bad "an error string reached the status line: $out" || ok "no error text in the output"
[ "$(printf '%s' "$out" | wc -l)" -le 1 ] && ok "it emits a single line" || bad "multi-line output"

# On a host with no battery reader it must still exit 0 and print nothing,
# rather than leave an error where the percentage should be. Strip the readers
# from PATH but keep a usable shell — an empty PATH loses bash itself and the
# 127 that produces is the harness failing, not the command.
mkdir -p "$TMP/slim"
for u in bash awk cat uname grep sed; do
  p="$(command -v "$u" 2>/dev/null)" && ln -sf "$p" "$TMP/slim/$u"
done
out2="$(PATH="$TMP/slim" bash "$CMD" 2>/dev/null)"; rc2=$?
[ "$rc2" -eq 0 ] && ok "no battery reader on PATH still exits 0" || bad "stripped PATH exited $rc2"

# The dispatch must end in a branch that cannot fail, on every platform.
grep -qE '\*\)\s*true' "$CMD" && ok "an unknown platform falls through cleanly" \
  || bad "no catch-all branch: an unrecognised OS would surface an error"

# What the bar shows for each power state, read from fixtures rather than this
# machine's hardware: stubs answer for uname, pmset and the sysfs lookup.
STUB="$TMP/stub"; mkdir -p "$STUB"
printf '#!/bin/sh\necho "$FAKE_OS"\n' > "$STUB/uname"
printf '#!/bin/sh\ncat "$PMSET_FILE"\n' > "$STUB/pmset"
printf '#!/bin/sh\necho "$FAKE_BAT"\n' > "$STUB/find"
chmod +x "$STUB/uname" "$STUB/pmset" "$STUB/find"
mac() { printf '%b' "$1" > "$TMP/pmset.txt"; PATH="$STUB:$PATH" FAKE_OS=Darwin PMSET_FILE="$TMP/pmset.txt" bash "$CMD" 2>/dev/null; }

[ "$(mac "Now drawing from 'AC Power'\n -InternalBattery-0 (id=1)\t80%; charging; 0:40 remaining present: true\n")" = '⚡ 80%' ] \
  && ok "macOS on AC and charging shows the charging mark" || bad "macOS charging rendered wrong"
[ "$(mac "Now drawing from 'AC Power'\n -InternalBattery-0 (id=1)\t100%; charged; 0:00 remaining present: true\n")" = '🔌 100%' ] \
  && ok "macOS on AC and charged shows the plug" || bad "macOS charged rendered wrong"
[ "$(mac "Now drawing from 'Battery Power'\n -InternalBattery-0 (id=1)\t85%; discharging; 3:12 remaining present: true\n")" = '🔋 85% (3:12)' ] \
  && ok "macOS on battery shows the time remaining" || bad "macOS on battery lost the estimate"
[ "$(mac "Now drawing from 'Battery Power'\n -InternalBattery-0 (id=1)\t85%; discharging; (no estimate) present: true\n")" = '🔋 85%' ] \
  && ok "macOS on battery without an estimate shows only the percentage" || bad "macOS without an estimate rendered wrong"

BAT="$TMP/BAT0"; mkdir -p "$BAT"; printf '77\n' > "$BAT/capacity"; printf 'Charging\n' > "$BAT/status"
[ "$(PATH="$STUB:$PATH" FAKE_OS=Linux FAKE_BAT="$BAT" bash "$CMD" 2>/dev/null)" = 'Charging 77%' ] \
  && ok "Linux sysfs shows status and capacity" || bad "Linux sysfs lost the charging status"
rm -f "$BAT/status"
[ "$(PATH="$STUB:$PATH" FAKE_OS=Linux FAKE_BAT="$BAT" bash "$CMD" 2>/dev/null)" = '77%' ] \
  && ok "Linux sysfs without a status shows the capacity alone" || bad "Linux sysfs without status rendered wrong"

[ "$f" -eq 0 ] && { echo "tmux-battery-test: PASS"; exit 0; }
echo "tmux-battery-test: $f case(s) failed" >&2; exit 1
