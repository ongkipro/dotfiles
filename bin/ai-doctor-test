#!/usr/bin/env bash
# ai-doctor is 658 lines and every other gate defers to it. It ran --self-test
# over everyone else's tests and was itself judged by nothing.
set -uo pipefail
ROOT="${1:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
CMD="$ROOT/bin/ai-doctor"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
f=0; ok(){ printf '  ✓ %s\n' "$1"; }; bad(){ echo "  FAIL $1" >&2; f=$((f+1)); }

# The report must work on CI without a real Claude installation or user profile.
export HOME="$TMP/home"
export PATH="$HOME/.local/bin:$PATH"
unset CLAUDE_CONFIG_DIR CLAUDE_SETTINGS TOOLCHAIN_NODE_BIN
mkdir -p "$HOME/.claude" "$HOME/.local/bin"
printf '#!/usr/bin/env bash\nprintf invoked > "$HOME/claude-probed"\n' > "$HOME/.local/bin/claude"
chmod +x "$HOME/.local/bin/claude"
printf '%s\n' '{"permissions":{"deny":["Read(.env*)"]}}' > "$HOME/.claude/settings.json"
"$ROOT/bin/ai-hooks-install" --settings "$HOME/.claude/settings.json" --dotfiles "$ROOT" >/dev/null \
  || { echo "failed to install fixture hooks" >&2; exit 1; }

BEFORE="$(git -C "$ROOT" status --porcelain | sort)"
OUT="$(DOTFILES_DIR="$ROOT" bash "$CMD" 2>&1)"
[ -s "$HOME/claude-probed" ] && ok "the fixture launcher is used" \
  || bad "the report bypassed the fixture launcher"
# Deliberately NOT asserting exit 0. An earlier version did, which pinned THIS
# machine's health rather than the subject's contract: in any relocated copy the
# report exits 1, so the test failed unmutated and its mutation-sweep verdict was
# unearned. On a device where ai-doctor legitimately reports one finding it would
# also fail and take ai-doctor --self-test down with it.
[ "$(git -C "$ROOT" status --porcelain | sort)" = "$BEFORE" ] \
  && ok "the report writes nothing" || bad "ai-doctor modified the repository"

# The .env deny check is enforced even in bypass mode and silently skipped a
# profile with no settings.json until 2026-09-04. Require the PASS marker: a bare
# grep for the string also matched the warning line, so neutralising the check
# entirely still passed.
printf '%s' "$OUT" | grep -q '✓.*permissions.deny' && ok "the .env deny rule is reported as satisfied" \
  || bad "no passing permissions.deny line — a bare string match also accepts the warning"
printf '%s' "$OUT" | grep -q '✓.*Claude hooks:' && ok "it reports on hook wiring" || bad "no hook line"

# A missing settings.json must be named, not passed over. Point the check at a
# profile that does not exist and require it to complain.
OUT2="$(CLAUDE_CONFIG_DIR="$TMP/absent" DOTFILES_DIR="$ROOT" bash "$CMD" 2>&1)"
printf '%s' "$OUT2" | grep -Fq "Claude settings: $TMP/absent/settings.json TIDAK ADA" && ok "an absent profile settings.json is named" \
  || bad "an absent settings.json was passed over silently"
printf '%s' "$OUT2" | grep -qi 'bukan ~/.claude\|CLAUDE_CONFIG_DIR' && ok "a redirected profile is named" \
  || bad "a profile outside ~/.claude was not reported"

# --self-test must say that it found no suite, not merely fail for some other
# reason. An empty root fails on eight unrelated checks, so the earlier version
# proved nothing: removing the discovery guard entirely still "passed".
mkdir -p "$TMP/nosuite/bin"
printf '#!/usr/bin/env bash\nexit 0\n' > "$TMP/nosuite/bin/placeholder"
chmod +x "$TMP/nosuite/bin/placeholder"
OUT3="$(DOTFILES_DIR="$TMP/nosuite" bash "$CMD" --self-test 2>&1)"
printf '%s' "$OUT3" | grep -q 'tidak ditemukan' \
  && ok "--self-test names an empty fixture suite instead of reporting health" \
  || bad "--self-test did not report that no tests were found"

# A health report is used by device-verify, so an installed launcher that hangs
# must degrade to the existing warning within the macOS fallback bound instead
# of stalling every dependent gate.
HANG_BIN="$TMP/hang-bin"; mkdir -p "$HANG_BIN"
HANG_HOME="$TMP/hang-home"; mkdir -p "$HANG_HOME"
printf '#!/usr/bin/env bash\ntrap "" TERM\nsleep 30\n' > "$HANG_BIN/claude"
chmod +x "$HANG_BIN/claude"
started=$(date +%s)
# Use the empty fixture root: scanning the real repository is unrelated to
# bounding the launcher and made this assertion depend on repository size/load.
OUT_HANG="$(env -u TOOLCHAIN_NODE_BIN HOME="$HANG_HOME" PATH="$HANG_BIN:$PATH" DOTFILES_DIR="$TMP/nosuite" bash "$CMD" 2>&1)"
elapsed=$(( $(date +%s) - started ))
[ "$elapsed" -lt 15 ] && ok "a hanging Claude launcher is bounded" \
  || bad "a hanging Claude launcher took ${elapsed}s"
printf '%s' "$OUT_HANG" | grep -q 'launcher ada tetapi native binary gagal' \
  && ok "a hanging Claude launcher is reported as unhealthy" \
  || bad "a hanging Claude launcher was not reported"


[ "$f" -eq 0 ] && { echo "ai-doctor-test: PASS"; exit 0; }
echo "ai-doctor-test: $f case(s) failed" >&2; exit 1
