#!/usr/bin/env bash
# ai-doctor is 658 lines and every other gate defers to it. It ran --self-test
# over everyone else's tests and was itself judged by nothing.
set -uo pipefail
ROOT="${1:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
CMD="$ROOT/bin/ai-doctor"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
f=0; ok(){ printf '  ✓ %s\n' "$1"; }; bad(){ echo "  FAIL $1" >&2; f=$((f+1)); }

BEFORE="$(git -C "$ROOT" status --porcelain | sort)"
OUT="$(DOTFILES_DIR="$ROOT" bash "$CMD" 2>&1)"; rc=$?
[ "$rc" -eq 0 ] && ok "the default report succeeds on a healthy tree" || bad "default run exited $rc"
[ "$(git -C "$ROOT" status --porcelain | sort)" = "$BEFORE" ] \
  && ok "the report writes nothing" || bad "ai-doctor modified the repository"

# The .env deny check is the one this file's own comments call load-bearing: it
# is enforced even in bypass mode, and it silently skipped a profile with no
# settings.json until 2026-09-04.
printf '%s' "$OUT" | grep -q 'permissions.deny' && ok "it reports on the .env deny rule" \
  || bad "no permissions.deny line"
printf '%s' "$OUT" | grep -qi 'hook' && ok "it reports on hook wiring" || bad "no hook line"

# A missing settings.json must be named, not passed over. Point the check at a
# profile that does not exist and require it to complain.
OUT2="$(CLAUDE_CONFIG_DIR="$TMP/absent" DOTFILES_DIR="$ROOT" bash "$CMD" 2>&1)"
printf '%s' "$OUT2" | grep -q 'TIDAK ADA' && ok "an absent profile settings.json is named" \
  || bad "an absent settings.json was passed over silently"
printf '%s' "$OUT2" | grep -qi 'bukan ~/.claude\|CLAUDE_CONFIG_DIR' && ok "a redirected profile is named" \
  || bad "a profile outside ~/.claude was not reported"

# --self-test must actually discover the fixture suite, not report health from
# an empty glob.
OUT3="$(DOTFILES_DIR="$TMP/nothing" bash "$CMD" --self-test 2>&1)"; rc3=$?
[ "$rc3" -ne 0 ] && ok "a root with no tests fails --self-test" \
  || bad "--self-test passed with no tests to run"

[ "$f" -eq 0 ] && { echo "ai-doctor-test: PASS"; exit 0; }
echo "ai-doctor-test: $f case(s) failed" >&2; exit 1
