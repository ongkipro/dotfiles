#!/usr/bin/env python3
"""ai-policy-lint — Structural linter for the tracked AI control plane.

Verifies GitHub workflows, capability routing, agent frontmatter metadata,
skill structures, memory links, project templates, and policy canaries across
dotfiles.
"""

from pathlib import Path
import json
import os
import re
import subprocess
import sys


def find_dotfiles_root():
    current = Path(__file__).resolve().parent
    while current != current.parent:
        if (current / "config" / "ai" / "AGENTS.md").is_file():
            return current
        current = current.parent
    return Path.home() / "dotfiles"


ROOT = find_dotfiles_root()
AI_DIR = ROOT / "config" / "ai"
TEMPLATES_DIR = ROOT / "config" / "templates"
# The same 120 lines `ai-doctor` has always warned about, now enforced.
AGENTS_LINE_BUDGET = 120

errors = []
warnings = []


def err(msg):
    errors.append(msg)


def warn(msg):
    warnings.append(msg)


def check_agents_policy():
    agents_md = AI_DIR / "AGENTS.md"
    if not agents_md.is_file():
        err(f"Missing canonical policy file: {agents_md}")
        return

    content = agents_md.read_text(encoding="utf-8")
    required_terms = ["Approval gates", "secrets", "sudo", "wrangler deploy", "git reset --hard"]
    for term in required_terms:
        if term not in content:
            warn(f"AGENTS.md policy missing expected keyword: '{term}'")

    goal_contract = {
        "goal section": "### OMP autonomous repository goals",
        "canonical task queue": "`TASKS.md` is the canonical execution",
        "capability routing": "Route by capability:",
        "visual lane": "designer/vision capability before editing",
        "review independence": "separate actual agent",
        "security lane": "sensitive/security review",
        "model eligibility": "Use any available capable model/provider",
        "approval boundary": "Product, scope, secrets and live-operation approvals remain.",
        "git authority": "Committing and pushing remain explicit user actions",
    }
    for label, anchor in goal_contract.items():
        if anchor not in content:
            err(f"AGENTS.md autonomous-goal contract missing {label}: '{anchor}'")


def run_canonical_gate(label, command, extra_env=None):
    try:
        environment = os.environ.copy()
        # Prefer the runtime mise actually installed over its shim: a dangling
        # shim cannot repair itself when GitHub rate-limits mise's version
        # lookup, which is exactly what the Mac hit on 2026-09-01.
        import glob
        import subprocess as _sp
        # Same order as device-verify and dev-ready, deliberately: the shim
        # resolves the configured version, installs are the fallback, newest
        # first, and only a binary that actually answers --version is used. The
        # first attempt let an old install shadow the shim, and the bash and
        # python copies disagreed about which version they picked.
        def _ver(path):
            m = re.search(r"/node/([^/]+)/bin", path)
            key = m.group(1) if m else ""
            return [int(x) if x.isdigit() else -1 for x in re.split(r"[.\-]", key)]
        installs = sorted(glob.glob(os.path.expanduser(
            "~/.local/share/mise/installs/node/*/bin/node")), key=_ver, reverse=True)
        for cand in [os.path.expanduser("~/.local/share/mise/shims/node")] + installs:
            if not os.access(cand, os.X_OK):
                continue
            try:
                if _sp.run([cand, "--version"], stdout=_sp.DEVNULL,
                           stderr=_sp.DEVNULL, timeout=10).returncode != 0:
                    continue
            except Exception:
                continue
            d = os.path.dirname(cand)
            parts = environment.get("PATH", "").split(os.pathsep)
            if d not in parts:
                environment["PATH"] = d + os.pathsep + environment.get("PATH", "")
            break
        environment.update(extra_env or {})
        result = subprocess.run(
            [str(part) for part in command],
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            env=environment,
            check=False,
        )
    except FileNotFoundError:
        # Only a bare external tool name can be "absent on this device". A path
        # under the repository is tracked content: if it is missing, the checkout
        # is broken and every device is broken with it. Warning there would turn
        # a deleted or renamed gate into a permanent green — reported by
        # independent review as a new dead gate inside the very commit that was
        # removing them.
        if os.sep in str(command[0]):
            err(f"{label} could not start: {command[0]} is missing from the repository")
            return
        # A tool this device does not have cannot judge anything, and saying so
        # is the only honest verdict: failing would make one machine's missing
        # formula a repository error, and passing would claim a check that never
        # ran. The Mac reported actionlint as an ERROR on 2026-09-01 while its
        # workflows were never examined at all.
        warn(f"{label} not validated here: {command[0]} is not installed on this device")
        return
    except OSError as error:
        err(f"{label} could not start: {error}")
        return

    if result.returncode != 0:
        detail = result.stdout.strip() or f"exit {result.returncode}"
        err(f"{label} failed:\n{detail}")
    else:
        lines = result.stdout.splitlines()
        for line in lines:
            if any(token in line.upper() for token in ("WARNING", "PARTIAL")):
                print(f"  {label}: {line}")
        summary = next((line for line in reversed(lines) if line.strip()), "OK")
        print(f"  OK  {label}: {summary}")


def report_memory_hygiene():
    """Report hygiene findings against the real corpus, not just its regression test.

    Until 2026-08-16 the only hygiene invocation anywhere in CI was
    ai-memory-hygiene-test, which runs against synthetic fixtures. Nothing ever
    ran the tool over the memory that actually ships, so live findings had zero
    automated visibility — twenty-five of them had accumulated unseen.

    This is advisory on purpose. The corpus carries pre-existing warnings, and
    failing the lint on them would turn a green build red for debt nobody is
    being asked to pay in this change. It reports the count and the kinds so the
    number is in front of someone; the hard gate lives in `ai-learn promote`,
    where new memory actually enters.
    """
    tool = ROOT / "bin" / "ai-memory-hygiene"
    if not os.access(tool, os.X_OK):
        print("  WARN  memory hygiene: ai-memory-hygiene is not executable")
        return
    result = subprocess.run([str(tool), "--root", str(ROOT), "--json"],
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
    if result.returncode != 0:
        print(f"  WARN  memory hygiene: tool failed: {result.stderr.strip()[:120]}")
        return
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        print("  WARN  memory hygiene: unreadable JSON output")
        return
    issues = data.get("issues", [])
    if not issues:
        print("  OK  memory hygiene corpus: clean")
        return
    kinds = ", ".join(f"{k}x{v}" for k, v in sorted(data.get("counts", {}).items()))
    print(f"  note  memory hygiene corpus: {len(issues)} advisory finding(s) — {kinds}")
    print("        run `ai-memory-hygiene` for detail; promotion is gated separately")


def check_templates():
    if not TEMPLATES_DIR.is_dir():
        err(f"Missing templates directory: {TEMPLATES_DIR}")
        return

    required_templates = ["AGENTS.md", "PRD.md", "TASKS.md", "STATUS.md", "BUILD-LOG.md", "ARCHITECTURE.md", "DECISIONS.md", "RELEASE.md", "OBSERVABILITY.md"]
    for t in required_templates:
        if not (TEMPLATES_DIR / t).is_file():
            err(f"Missing required project template: {t}")

    # Derived from the same obligations `check_task_contracts` enforces per task,
    # not a second hand-maintained list — a field added to REQUIRED_TASK_FIELDS
    # now automatically has to be documented in the template too, closing the
    # gap where the two could silently drift apart. Every alias spelling is
    # checked, not just the first: taking only the primary name silently
    # stopped requiring "Change Surface" / "Protected Surface" / "Shared Owner"
    # to appear anywhere, even though `check_task_contracts` still accepts a
    # task written with those spellings.
    #
    # This teaching-completeness check applies ONLY to the template, not to
    # root TASKS.md. Root TASKS.md's actual task entries are already validated
    # per-task, per-field by `check_task_contracts` below, which correctly
    # accepts any listed spelling. Requiring every alias to additionally appear
    # SOMEWHERE in the whole live document would create a trap this repo's own
    # archival pattern walks straight into: archiving the one remaining task
    # that happens to use a given alias spelling (exactly what this task did
    # to TASK-015/TASK-016) would fail the lint on an otherwise-correct
    # repository for a reason with nothing to do with that change.
    for task_file in (ROOT / "TASKS.md", TEMPLATES_DIR / "TASKS.md"):
        if not task_file.is_file():
            err(f"Missing task contract: {task_file}")

    template_fields = [name for names in (*REQUIRED_TASK_FIELDS, PROTECTED_TASK_FIELD) for name in names]
    template_tasks_file = TEMPLATES_DIR / "TASKS.md"
    if template_tasks_file.is_file():
        content = template_tasks_file.read_text(encoding="utf-8")
        for field in template_fields:
            if f"**{field}:**" not in content:
                err(f"{template_tasks_file.relative_to(ROOT)} missing task boundary field: {field}")


# ── Task execution contract ──────────────────────────────────────────────────
# `check_templates` only proves the field *names* appear somewhere in the file,
# which a single fenced template satisfies for every task beneath it. These
# checks read each declared task instead, so an R1-R4 task that silently drops
# its boundary, owner, or escalation contract fails here.

TASK_HEADING = re.compile(r"^###\s+(TASK-[A-Za-z0-9._-]+)\b")
TASK_FIELD = re.compile(r"^-\s+\*\*(.+?):\*\*\s*(.*)$")
RISK_VALUE = re.compile(r"^R([0-4])\b")

# Each entry is one contract obligation; any listed spelling satisfies it.
# "Change Surface", "Protected Surface", and "Shared Owner" are the compatibility
# aliases config/templates/TASKS.md documents. "Regression Checks" and
# "Verification" are grouped because the obligation is one runnable completion
# check under either heading, not because the template calls them aliases.
REQUIRED_TASK_FIELDS = (
    ("Requirement",),
    ("Risk Level",),
    ("Allowed Paths", "Change Surface"),
    ("Canonical Contract Owners", "Shared Owner"),
    ("Accepted Invariants",),
    ("Regression Checks", "Verification"),
    ("Reopen Conditions",),
    ("Non-Scope",),
    ("Escalation Conditions", "Escalation Condition"),
)
PROTECTED_TASK_FIELD = ("Protected Paths", "Protected Surface")
# Same extensions the delivery ledger uses to demand browser evidence, so a task
# and its run agree on what "browser-visible" means.
BROWSER_VISIBLE_SUFFIXES = (".tsx", ".jsx", ".vue", ".svelte", ".astro", ".css", ".scss", ".html")
VISUAL_CONTRACT_FIELD = ("Visual Contract", "Visual Acceptance")
# "Modern UI", "clean design", "nice looking" — a brief that cannot be failed.
PLACEHOLDER_VISUAL = re.compile(
    r"^\s*(\[.*\]|tbd|todo|n/?a|modern|clean|nice|good|better|improved|polished)\s*(ui|design|look)?\s*\.?\s*$",
    re.I,
)
# Conditional: required only where it applies, but never allowed to be empty.
CONDITIONAL_TASK_FIELDS = (
    ("Depends On",),
    PROTECTED_TASK_FIELD,
    ("Runtime Evidence",),
    ("Rollback/Migration State",),
    ("Producers",),
    ("Consumers",),
)


def parse_task_contracts(text):
    """Return (tasks, unbalanced_fence_line), ignoring fenced templates.

    An odd number of fences would otherwise swallow every task after it and the
    file would lint clean by having been mostly unread, so the caller is told.
    """
    tasks = []
    fence_opened_at = None
    fenced = False
    current = None
    for number, line in enumerate(text.splitlines(), start=1):
        if line.lstrip().startswith(("```", "~~~")):
            fence_opened_at = None if fenced else number
            fenced = not fenced
            continue
        if fenced:
            continue
        heading = TASK_HEADING.match(line)
        if heading:
            current = (heading.group(1), number, {})
            tasks.append(current)
            continue
        if current is None:
            continue
        if line.startswith("#"):
            current = None
            continue
        field = TASK_FIELD.match(line)
        if field:
            current[2][field.group(1).strip()] = field.group(2).strip()
    return tasks, fence_opened_at


def lint_task_contracts(label, text):
    """Return a list of contract violations for one TASKS.md body."""
    problems = []
    seen = {}
    tasks, fence_opened_at = parse_task_contracts(text)
    if fence_opened_at is not None:  # unbalanced-fence guard
        problems.append(
            "{}:{}: unclosed code fence; every task below it is invisible to the "
            "contract lint".format(label, fence_opened_at)
        )
    for task_id, number, fields in tasks:
        if task_id in seen:
            problems.append(
                "{}:{}: duplicate task ID {} (first declared at line {}); "
                "delivery evidence cannot be matched to a repeated ID".format(
                    label, number, task_id, seen[task_id]
                )
            )
        else:
            seen[task_id] = number

        def value_of(names):
            for name in names:
                if name in fields:
                    return fields[name]
            return None

        risk = value_of(("Risk Level",)) or ""
        match = RISK_VALUE.match(risk)
        if not match:
            problems.append("{}:{}: {} has no parsable Risk Level".format(label, number, task_id))
            continue
        if int(match.group(1)) == 0:
            continue
        for names in REQUIRED_TASK_FIELDS:  # required-field guard
            value = value_of(names)
            if value is None:
                problems.append(
                    "{}:{}: {} is missing required field: {}".format(
                        label, number, task_id, " or ".join(names)
                    )
                )
            elif not value:
                problems.append(
                    "{}:{}: {} declares an empty {}".format(label, number, task_id, names[0])
                )
        # A task that changes a rendered surface needs stated visual criteria, or
        # "modern UI" is the whole brief and review has nothing to measure. The
        # trigger is the declared change surface, matching the ledger's browser
        # evidence gate: paths decide, not the author's own account of the work.
        surface = value_of(("Allowed Paths", "Change Surface")) or ""
        rendered = [ext for ext in BROWSER_VISIBLE_SUFFIXES if ext in surface]
        if rendered:
            visual = value_of(VISUAL_CONTRACT_FIELD)
            if visual is None:
                problems.append(
                    "{}:{}: {} changes a rendered surface ({}) and must declare {}".format(
                        label, number, task_id, ", ".join(sorted(rendered)),
                        " or ".join(VISUAL_CONTRACT_FIELD),
                    )
                )
            elif not visual or PLACEHOLDER_VISUAL.match(visual):
                problems.append(
                    "{}:{}: {} declares a placeholder {} — name the surface, the "
                    "states, and what would be rejected".format(
                        label, number, task_id, VISUAL_CONTRACT_FIELD[0]
                    )
                )
        if int(match.group(1)) >= 3 and value_of(PROTECTED_TASK_FIELD) is None:
            problems.append(
                "{}:{}: {} is R{} and must declare {}".format(
                    label, number, task_id, match.group(1), " or ".join(PROTECTED_TASK_FIELD)
                )
            )
        for names in CONDITIONAL_TASK_FIELDS:
            for name in names:
                if name in fields and not fields[name]:
                    problems.append(
                        "{}:{}: {} declares {} with no value; state it or omit it".format(
                            label, number, task_id, name
                        )
                    )
    return problems


def check_task_contracts():
    for task_file in (ROOT / "TASKS.md", TEMPLATES_DIR / "TASKS.md"):
        if not task_file.is_file():
            continue
        label = str(task_file.relative_to(ROOT))
        for problem in lint_task_contracts(label, task_file.read_text(encoding="utf-8")):
            err(problem)


def check_hot_context():
    limit = 12 * 1024
    for relative in ("TASKS.md", "config/omp/BUILD-LOG.md"):
        path = ROOT / relative
        if not path.is_file():
            err(f"Missing hot-context owner: {relative}")
            continue
        size = path.stat().st_size
        if size > limit:
            err(f"Hot-context budget exceeded: {relative} is {size} bytes (limit {limit}); archive history before adding more")

    # AGENTS.md is the hottest file in the system — every request, in every
    # installed CLI — and until now it was the only one whose budget was merely a
    # warning in `ai-doctor`, while colder files failed CI outright. A warning
    # loses: this file sat at exactly 120 lines, and the very session that added
    # the delivery-evidence rules pushed it to 122 without failing anything.
    #
    # Lines, not bytes, because that is the threshold the tooling already agreed
    # on and because the cost here is prose the model must read, not disk. A
    # paragraph that must exist belongs in the document that owns it, with one
    # anchoring sentence left here.
    agents = AI_DIR / "AGENTS.md"
    if agents.is_file():
        lines = len(agents.read_text(encoding="utf-8").splitlines())
        if lines > AGENTS_LINE_BUDGET:
            err(f"Hot-context budget exceeded: config/ai/AGENTS.md is {lines} lines "
                f"(limit {AGENTS_LINE_BUDGET}); it is read on every request in every CLI — "
                f"move the detail to the document that owns it and leave an anchor")


def _task_graph_parser():
    """Borrow resume-brief's parser rather than reimplementing it.

    The first version of this check reimplemented the rule and the two drifted
    immediately: the lint validated edges on bullet-shaped tasks that
    resume-brief could not even read, and attributed a bullet task's dependency
    to whatever heading preceded it. Two readers of one human-written line under
    two rules is the split-truth failure the design forbids, so there is now one
    parser and this is its second caller.
    """
    import importlib.util
    from importlib.machinery import SourceFileLoader
    # An extensionless executable has no registered loader, so name one: the
    # default spec_from_file_location returns a spec with loader=None and the
    # import silently yields nothing.
    path = str(ROOT / "bin" / "resume-brief")
    spec = importlib.util.spec_from_file_location(
        "resume_brief", path, loader=SourceFileLoader("resume_brief", path))
    if spec is None or spec.loader is None:
        return None
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def check_task_dependencies():
    """A dependency edge is the one part of the task lifecycle a human writes.

    Everything else `resume-brief` reports is derived from ledger evidence, and
    derived facts cannot go stale. This one can: a typo in `Depends On:` names a
    task that will never reach PASS, so the dependent waits forever and nothing
    says why.
    """
    tasks_md = ROOT / "TASKS.md"
    if not tasks_md.is_file():
        return
    try:
        rb = _task_graph_parser()
    except Exception as error:
        err(f"task dependency graph could not be checked: {error}")
        return
    if rb is None or not hasattr(rb, "parse_task_graph"):
        err("task dependency graph could not be checked: bin/resume-brief "
            "does not expose parse_task_graph")
        return

    anomalies = []
    graph = rb.parse_task_graph(tasks_md.read_text(), anomalies)
    known = set(graph)
    # Harvest RECORDS from the archive, not every token in it. Scanning all text
    # pulled in GPT-5, CI-01, H-01..M-08 and every other id-shaped fragment, so a
    # digit-slip landing anywhere in archived prose passed as a real dependency.
    archive = ROOT / "docs" / "archive"
    if archive.is_dir():
        for f in sorted(archive.glob("*.md")):
            text = f.read_text()
            known |= set(rb.parse_task_graph(text))
            known |= set(re.findall(r"^\|\s*(TASK-[0-9]+)\s*\|", text, re.M))

    bad = list(anomalies)
    for task, deps in graph.items():
        for dep in deps:
            if dep == task:
                bad.append(f"{task} depends on itself")
            elif dep not in known:
                bad.append(f"{task} depends on {dep}, which no task record defines")
    if bad:
        err("task dependency graph has problems:\n  " + "\n  ".join(bad))
    else:
        print(f"  OK  task dependency graph: {sum(len(d) for d in graph.values())} "
              f"edge(s) across {len(graph)} task record(s) resolve")


def check_command_manifest():
    """Both directions, because checking one is how the gap survived.

    `installer-link-test` proves every manifest entry resolves to an executable.
    Nothing proved the reverse, so a command could exist in `bin/` and never be
    linked into `~/.local/bin` on any device — invisible on the machine that wrote
    it, absent everywhere else. TASK-022 fixed four such commands and still missed
    `omp-runtime-report`, because its own check compared `bin/*-test` against the
    manifest's `-test` entries and a non-test command was outside the question.

    A command has no file extension; a helper another command sources does
    (`pi-9router-sync.js`). That is the repository's actual convention, not a rule
    invented here — one file in eighty carries a suffix, and it is the one that is
    not a command.
    """
    manifest = AI_DIR / "runtime-commands.txt"
    bin_dir = ROOT / "bin"
    if not manifest.is_file() or not bin_dir.is_dir():
        return
    listed = {line.strip() for line in manifest.read_text(encoding="utf-8").splitlines()
              if line.strip() and not line.startswith("#")}
    commands = {p.name for p in bin_dir.iterdir()
                if p.is_file() and os.access(p, os.X_OK) and "." not in p.name}
    for name in sorted(commands - listed):
        err(f"bin/{name} is an executable command that no installer links: "
            f"add it to config/ai/runtime-commands.txt or give it a suffix if it is a helper")
    print(f"  OK  command manifest: {len(commands)} command(s) in bin/, all listed")


def check_memory_routing_coverage():
    """Every project-memory file is reachable, or says why not.

    The router is the only way memory reaches a session — the hook calls it on
    every prompt and this repository's own memory forbids scanning the
    directory — so a file no key and no lesson names is invisible, not merely
    deprioritised. On 2026-09-04, 43 of 69 were in that state: five tokophi
    notes beside the one routed tokophi.md, all four pixsgo notes, and the
    convention lessons about commit identity and AI trailers. Nothing checked,
    because size was the only property anything measured.

    A file may be routed by a project key, named by a lesson trigger, or listed
    in `unrouted` with a reason. Silence is the one thing it may not be.
    """
    manifest_path = AI_DIR / "memory-router.json"
    memory_dir = AI_DIR / "project-memory"
    # Not `return`. A missing manifest breaks the router outright — load_manifest
    # raises — so staying green there would report health for a repository whose
    # memory reaches no session at all, which is the loudest failure this file
    # could be silent about.
    if not manifest_path.is_file():
        err(f"memory router manifest is missing: {manifest_path.relative_to(ROOT)}")
        return
    if not memory_dir.is_dir():
        err(f"project memory directory is missing: {memory_dir.relative_to(ROOT)}")
        return
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        err(f"memory routing coverage could not be checked: {error}")
        return

    routed: set[str] = set()
    for value in manifest.get("projects", {}).values():
        for entry in ([value] if isinstance(value, str) else value or []):
            path = entry if isinstance(entry, str) else entry.get("path")
            if path:
                routed.add(path)
    routed |= {e["path"] for e in manifest.get("lessons", []) if e.get("path")}
    declared_unrouted = {
        e["path"] if isinstance(e, dict) else e
        for e in manifest.get("unrouted", [])
    }

    on_disk = {
        f"config/ai/project-memory/{p.name}"
        for p in memory_dir.glob("*.md")
        if p.name != "MEMORY.md"
    }
    missing = sorted(on_disk - routed - declared_unrouted)
    for rel in missing:
        err(f"{rel} is reachable through no project key, no lesson trigger, and no "
            f"`unrouted` entry — the hook can never select it")
    # A key naming a file that no longer exists is the same defect facing the
    # other way: the route resolves to nothing and reports a match. An `unrouted`
    # entry for a file that is gone is stale bookkeeping, and one with no reason
    # is an exemption nobody has to justify.
    dangling = sorted(r for r in (routed | declared_unrouted)
                      if r.startswith("config/ai/project-memory/")
                      and not (ROOT / r).is_file())
    for rel in dangling:
        err(f"memory router names {rel}, which does not exist")
    unreasoned = sorted(e for e in manifest.get("unrouted", []) if isinstance(e, str))
    for rel in unreasoned:
        err(f"`unrouted` entry {rel} carries no reason; use "
            f'{{"path": ..., "reason": ...}}')
    if not missing and not dangling and not unreasoned:
        print(f"  OK  memory routing coverage: {len(on_disk)} project-memory file(s), "
              f"{len(on_disk & routed)} routed, {len(declared_unrouted)} declared unrouted")


def check_skill_map():
    """The map of the skill set must be what a fresh render produces.

    `skill-map` derives `skills/local/README.md` from frontmatter. Nothing stops
    a hand edit or a forgotten re-render, and a map that disagrees with the
    directory is worse than none: it is read as authority. The check names the
    skill that differs rather than only reporting staleness.
    """
    script = ROOT / "bin" / "skill-map"
    if not script.is_file():
        return
    proc = subprocess.run([sys.executable, str(script), "--root", str(ROOT), "--check"],
                          capture_output=True, text=True)
    if proc.returncode == 0:
        print(f"  OK  skill map: {proc.stdout.strip().split(': ', 1)[-1]}")
    else:
        detail = (proc.stderr or proc.stdout).strip().replace("\n", "\n  ")
        err(f"skill map is not current:\n  {detail}")


def check_skill_routing_graph():
    """Every skill a routing table hands work to must exist.

    The specialist graph — `full-stack-development` sending schema work to
    `postgres-drizzle`, browser evidence to `ui-validation` — is prose, and prose
    with a typo routes nowhere. A rename silently breaks capability routing while
    every existing gate reports clean: `skill-surface-check` is report-only and
    checks command references, not skill references, and a deliberately misspelled
    `nextjs-devlopment` passed both it and this lint before this existed.

    Scope is a routing-table cell whose entire content is code spans — the shape
    `| Next.js App Router … | \\`nextjs-development\\` |`. Prose mentions are left
    alone on purpose: they name npm packages (`postal-mime`), dotfiles commands
    (`ai-memory-lifecycle`) and YAML keys (`max-parallel`), and flagging those
    would train people to ignore this check. Across the current corpus the narrow
    rule finds 65 references and zero false positives.
    """
    skills_root = ROOT / "skills" / "local"
    if not skills_root.is_dir():
        return
    installed = {p.name for p in skills_root.iterdir() if (p / "SKILL.md").is_file()}
    cell = re.compile(
        r"^\|.*\|\s*((?:`[a-z0-9-]+`(?:\s*(?:plus|and|,|then|->|→)\s*)?)+)\s*\|\s*$", re.M)
    token = re.compile(r"`([a-z0-9-]+)`")
    checked = 0
    for skill_file in sorted(skills_root.glob("*/SKILL.md")):
        for match in cell.finditer(skill_file.read_text(encoding="utf-8")):
            for name in token.findall(match.group(1)):
                checked += 1
                if name not in installed:
                    err(f"{skill_file.parent.name}: routing table hands work to "
                        f"'{name}', which is not an installed skill")
    print(f"  OK  skill routing graph: {checked} routing reference(s) resolve to installed skills")


def main():
    print("ai-policy-lint: Auditing dotfiles policy, routing, skills, and templates...")
    print("─" * 60)

    check_agents_policy()
    run_canonical_gate("GitHub workflows", ["actionlint"])
    run_canonical_gate("OMP routing", [ROOT / "bin" / "omp-routing-test", ROOT])
    run_canonical_gate("owned skills", [ROOT / "skills" / "agents-bin" / "skill-check"], {"SKILL_SOURCE": str(ROOT / "skills" / "local")})
    check_skill_routing_graph()
    check_command_manifest()
    check_task_dependencies()
    run_canonical_gate("memory and Markdown links", [ROOT / "bin" / "ai-memory-check", ROOT])
    run_canonical_gate("memory hygiene regression", [ROOT / "bin" / "ai-memory-hygiene-test", ROOT])
    report_memory_hygiene()
    check_templates()
    check_task_contracts()
    check_memory_routing_coverage()
    check_skill_map()
    check_hot_context()

    if warnings:
        print("WARNINGS:")
        for w in warnings:
            print(f"  ! {w}")

    if errors:
        print("ERRORS:")
        for e in errors:
            print(f"  ✗ {e}")
        print("─" * 60)
        print(f"ai-policy-lint: FAILED ({len(errors)} errors found)", file=sys.stderr)
        sys.exit(1)

    print("─" * 60)
    print("ai-policy-lint: PASSED (tracked policy, routing, skills, memory, and templates are valid)")
    sys.exit(0)


if __name__ == "__main__":
    # Narrow entry point so the task-contract rules can be exercised against
    # fixtures without standing up a whole fake dotfiles root. Same code path.
    if len(sys.argv) > 2 and sys.argv[1] == "--task-contracts":
        findings = []
        for name in sys.argv[2:]:
            findings.extend(lint_task_contracts(name, Path(name).read_text(encoding="utf-8")))
        for finding in findings:
            print(finding)
        sys.exit(1 if findings else 0)
    main()
