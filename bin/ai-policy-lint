#!/usr/bin/env python3
"""ai-policy-lint — Structural linter for the tracked AI control plane.

Verifies model role alignment, agent frontmatter metadata, skill structures,
memory links, project templates, and policy canaries across dotfiles.
"""

from pathlib import Path
import json
import os
import subprocess
import sys


def find_dotfiles_root():
    current = Path(__file__).resolve().parent
    while current != current.parent:
        if (current / "config" / "ai" / "AGENTS.md").is_file():
            return current
        current = current.parent
    return Path.home() / "dotfiles"


ROOT = find_dotfiles_root()
AI_DIR = ROOT / "config" / "ai"
TEMPLATES_DIR = ROOT / "config" / "templates"

errors = []
warnings = []


def err(msg):
    errors.append(msg)


def warn(msg):
    warnings.append(msg)


def check_agents_policy():
    agents_md = AI_DIR / "AGENTS.md"
    if not agents_md.is_file():
        err(f"Missing canonical policy file: {agents_md}")
        return

    content = agents_md.read_text(encoding="utf-8")
    required_terms = ["Approval gates", "secrets", "sudo", "wrangler deploy", "git reset --hard"]
    for term in required_terms:
        if term not in content:
            warn(f"AGENTS.md policy missing expected keyword: '{term}'")


def run_canonical_gate(label, command, extra_env=None):
    try:
        environment = os.environ.copy()
        environment.update(extra_env or {})
        result = subprocess.run(
            [str(part) for part in command],
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            env=environment,
            check=False,
        )
    except OSError as error:
        err(f"{label} could not start: {error}")
        return

    if result.returncode != 0:
        detail = result.stdout.strip() or f"exit {result.returncode}"
        err(f"{label} failed:\n{detail}")
    else:
        lines = result.stdout.splitlines()
        for line in lines:
            if any(token in line.upper() for token in ("WARNING", "PARTIAL")):
                print(f"  {label}: {line}")
        summary = next((line for line in reversed(lines) if line.strip()), "OK")
        print(f"  OK  {label}: {summary}")


def report_memory_hygiene():
    """Report hygiene findings against the real corpus, not just its regression test.

    Until 2026-08-16 the only hygiene invocation anywhere in CI was
    ai-memory-hygiene-test, which runs against synthetic fixtures. Nothing ever
    ran the tool over the memory that actually ships, so live findings had zero
    automated visibility — twenty-five of them had accumulated unseen.

    This is advisory on purpose. The corpus carries pre-existing warnings, and
    failing the lint on them would turn a green build red for debt nobody is
    being asked to pay in this change. It reports the count and the kinds so the
    number is in front of someone; the hard gate lives in `ai-learn promote`,
    where new memory actually enters.
    """
    tool = ROOT / "bin" / "ai-memory-hygiene"
    if not os.access(tool, os.X_OK):
        print("  WARN  memory hygiene: ai-memory-hygiene is not executable")
        return
    result = subprocess.run([str(tool), "--root", str(ROOT), "--json"],
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
    if result.returncode != 0:
        print(f"  WARN  memory hygiene: tool failed: {result.stderr.strip()[:120]}")
        return
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        print("  WARN  memory hygiene: unreadable JSON output")
        return
    issues = data.get("issues", [])
    if not issues:
        print("  OK  memory hygiene corpus: clean")
        return
    kinds = ", ".join(f"{k}x{v}" for k, v in sorted(data.get("counts", {}).items()))
    print(f"  note  memory hygiene corpus: {len(issues)} advisory finding(s) — {kinds}")
    print("        run `ai-memory-hygiene` for detail; promotion is gated separately")


def check_templates():
    if not TEMPLATES_DIR.is_dir():
        err(f"Missing templates directory: {TEMPLATES_DIR}")
        return

    required_templates = ["AGENTS.md", "PRD.md", "TASKS.md", "STATUS.md", "BUILD-LOG.md", "ARCHITECTURE.md", "DECISIONS.md", "RELEASE.md", "OBSERVABILITY.md"]
    for t in required_templates:
        if not (TEMPLATES_DIR / t).is_file():
            err(f"Missing required project template: {t}")

    task_fields = (
        "Change Surface", "Protected Surface", "Accepted Invariants",
        "Shared Owner", "Regression Checks", "Reopen Conditions",
    )
    for task_file in (ROOT / "TASKS.md", TEMPLATES_DIR / "TASKS.md"):
        if not task_file.is_file():
            err(f"Missing task contract: {task_file}")
            continue
        content = task_file.read_text(encoding="utf-8")
        for field in task_fields:
            if f"**{field}:**" not in content:
                err(f"{task_file.relative_to(ROOT)} missing task boundary field: {field}")


def check_hot_context():
    limit = 12 * 1024
    for relative in ("TASKS.md", "config/omp/BUILD-LOG.md"):
        path = ROOT / relative
        if not path.is_file():
            err(f"Missing hot-context owner: {relative}")
            continue
        size = path.stat().st_size
        if size > limit:
            err(f"Hot-context budget exceeded: {relative} is {size} bytes (limit {limit}); archive history before adding more")


def main():
    print("ai-policy-lint: Auditing dotfiles policy, routing, skills, and templates...")
    print("─" * 60)

    check_agents_policy()
    run_canonical_gate("OMP routing", [ROOT / "bin" / "omp-routing-test", ROOT])
    run_canonical_gate("owned skills", [ROOT / "skills" / "agents-bin" / "skill-check"], {"SKILL_SOURCE": str(ROOT / "skills" / "local")})
    run_canonical_gate("memory and Markdown links", [ROOT / "bin" / "ai-memory-check", ROOT])
    run_canonical_gate("memory hygiene regression", [ROOT / "bin" / "ai-memory-hygiene-test", ROOT])
    report_memory_hygiene()
    check_templates()
    check_hot_context()

    if warnings:
        print("WARNINGS:")
        for w in warnings:
            print(f"  ! {w}")

    if errors:
        print("ERRORS:")
        for e in errors:
            print(f"  ✗ {e}")
        print("─" * 60)
        print(f"ai-policy-lint: FAILED ({len(errors)} errors found)", file=sys.stderr)
        sys.exit(1)

    print("─" * 60)
    print("ai-policy-lint: PASSED (tracked policy, routing, skills, memory, and templates are valid)")
    sys.exit(0)


if __name__ == "__main__":
    main()
