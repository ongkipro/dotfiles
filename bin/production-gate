#!/usr/bin/env python3
"""production-gate — deterministic pre-deploy release readiness aggregator.

Requires committed release content, valid RELEASE.md, full project verification,
security scan, release-boundary diff risk, migration risk, rollback readiness,
delivery-ledger integrity, and independent review for effective R3/R4 releases.
Never deploys.

Exit codes: 0 PRODUCTION_READY, 1 BLOCKED, 2 UNVERIFIED.
"""
from __future__ import annotations
import argparse, json, re, shutil, subprocess, sys
from pathlib import Path

READY,BLOCKED,UNVERIFIED=0,1,2
RISK_ORDER={f"R{i}":i for i in range(5)}
UNSET={None,"","UNSET","TBD","NONE"}

def run(cmd,cwd): return subprocess.run(cmd,cwd=cwd,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,check=False)
def locate(name):
    found=shutil.which(name)
    if found:return found
    local=Path(__file__).resolve().parent/name
    return str(local) if local.is_file() else None

def status_field(repo,name):
    p=repo/"STATUS.md"
    if not p.is_file():return None
    m=re.search(rf"(?im)^{re.escape(name)}:\s*(.+?)\s*$",p.read_text(encoding="utf-8",errors="replace"))
    return m.group(1).strip() if m else None

def command_gate(cmd,repo):
    r=run(cmd,repo); out=(r.stdout+"\n"+r.stderr).strip()
    return ("PASS" if r.returncode==0 else "UNVERIFIED" if r.returncode==2 else "FAIL",out)

def clean_tree(repo):
    r=run(["git","status","--porcelain"],repo)
    if r.returncode!=0:return "UNVERIFIED",r.stderr.strip() or "git status failed"
    if r.stdout.strip():return "FAIL","Working tree is not clean"
    return "PASS","Working tree clean"

def head(repo):
    r=run(["git","rev-parse","HEAD^{commit}"],repo)
    return r.stdout.strip() if r.returncode==0 else None

def tasks_gate(repo):
    p=repo/"TASKS.md"
    if not p.is_file():return "UNVERIFIED","TASKS.md missing"
    text=p.read_text(encoding="utf-8",errors="replace")
    for heading in ("In progress","Pending"):
        sec=re.search(rf"(?ims)^##\s+{re.escape(heading)}\s*$([\s\S]*?)(?=^##\s+|\Z)",text)
        if not sec:return "UNVERIFIED",f"TASKS.md missing {heading} section"
        if re.search(r"(?im)^\s*(?:###\s+TASK-|[-*]\s*\[\s\]|[-*]\s+TASK-)",sec.group(1)):return "FAIL",f"{heading} contains unfinished work"
    return "PASS","No unfinished task entries"

def state_gate(repo):
    state=status_field(repo,"State")
    if not state:return "UNVERIFIED","STATUS.md missing State"
    if state not in {"INTEGRATING","PRODUCTION_READY","AWAITING_DEPLOY_APPROVAL"}:return "FAIL",f"State={state}; pre-deploy gate not valid"
    return "PASS",f"State={state}"

def json_tool(name,args,repo):
    binary=locate(name)
    if not binary:return "UNVERIFIED",None,f"{name} unavailable"
    r=run([binary,"--json",*args,str(repo)],repo)
    try:data=json.loads(r.stdout) if r.stdout.strip() else None
    except Exception:return "UNVERIFIED",None,f"{name} returned invalid JSON"
    if r.returncode==0:return "PASS",data,"ok"
    if r.returncode==2:return "UNVERIFIED",data,(r.stderr or r.stdout).strip()
    return "FAIL",data,(r.stderr or r.stdout).strip()

def main()->int:
    p=argparse.ArgumentParser();p.add_argument("directory",nargs="?",default=".");p.add_argument("--json",action="store_true");a=p.parse_args()
    repo=Path(a.directory).resolve()
    if not repo.is_dir():print(f"ERROR: Directory not found: {repo}",file=sys.stderr);return BLOCKED
    results={}; initial_head=head(repo)
    def add(name,status,detail):results[name]={"status":status,"detail":detail}

    s,d=clean_tree(repo);add("clean_tree",s,d)
    pc,sc,dl=locate("project-check"),locate("security-check"),locate("delivery-ledger")
    s,d=command_gate([pc,"--full",str(repo)],repo) if pc else ("UNVERIFIED","project-check unavailable");add("project_check",s,d)
    s,d=command_gate([sc,str(repo)],repo) if sc else ("UNVERIFIED","security-check unavailable");add("security",s,d)
    s,d=command_gate([dl,"--repo",str(repo),"verify","--json"],repo) if dl else ("UNVERIFIED","delivery-ledger unavailable");add("delivery_ledger",s,d)
    s,d=tasks_gate(repo);add("tasks",s,d)
    s,d=state_gate(repo);add("state",s,d)

    ms,manifest,mdetail=json_tool("release-manifest",[],repo);add("release_manifest",ms,mdetail)
    fields=manifest.get("fields",{}) if isinstance(manifest,dict) else {}
    base=fields.get("Base"); declared=fields.get("Declared-Risk")
    environment=fields.get("Environment")
    add("release_environment","PASS" if environment=="production" else "FAIL" if environment else "UNVERIFIED",f"Environment={environment}" if environment else "Release environment unavailable")

    ds,diffdata,ddetail=json_tool("diff-risk",["--base",base],repo) if base else ("UNVERIFIED",None,"release Base unavailable")
    diff_risk=diffdata.get("risk") if isinstance(diffdata,dict) else None
    add("diff_risk",ds,f"diff-risk={diff_risk}" if diff_risk else ddetail)

    mig_status,migdata,migdetail=json_tool("migration-risk",["--base",base],repo) if base else ("UNVERIFIED",None,"release Base unavailable")
    migration=migdata.get("risk") if isinstance(migdata,dict) else None
    add("migration_risk",mig_status,f"migration-risk={migration}" if migration else migdetail)

    rb_status,rbdata,rbdetail=json_tool("rollback-check",["--migration-risk",migration or "M0"],repo)
    add("rollback",rb_status,"Rollback evidence valid" if rb_status=="PASS" else rbdetail)

    review=status_field(repo,"Review-Risk")
    add("review_risk","PASS" if review in RISK_ORDER else "UNVERIFIED",f"review={review}" if review else "STATUS.md missing Review-Risk")
    risks=[r for r in (declared,diff_risk,review) if r in RISK_ORDER]
    effective=max(risks,key=lambda r:RISK_ORDER[r]) if risks else None
    add("effective_risk","PASS" if effective else "UNVERIFIED",f"Effective-Risk={effective}" if effective else "No reliable risk inputs")
    if effective in {"R3","R4"}:
        ir=status_field(repo,"Independent-Review")
        reviewer=status_field(repo,"Independent-Reviewer")
        review_head=status_field(repo,"Independent-Review-Head")
        primary=status_field(repo,"Primary-Worker")
        review_errors=[]
        if ir!="PASS": review_errors.append(f"Independent-Review={ir or 'missing'}")
        if reviewer in UNSET: review_errors.append("Independent-Reviewer missing")
        # Case- and space-insensitive: these are self-declared names, so "Ongki"
        # and "ongki" are one person satisfying an independence check by typing
        # two different strings. The gate cannot bind identity — nothing here is
        # signed — but it should at least not be defeated by the shift key.
        if primary not in UNSET and reviewer.strip().casefold().replace(" ", "") == primary.strip().casefold().replace(" ", ""):
            review_errors.append("reviewer must differ from Primary-Worker")
        if review_head in UNSET: review_errors.append("Independent-Review-Head missing")
        else:
            resolved=run(["git","rev-parse","--verify",f"{review_head}^{{commit}}"],repo)
            if resolved.returncode!=0: review_errors.append("Independent-Review-Head is invalid")
            else:
                reviewed=resolved.stdout.strip(); ancestor=run(["git","merge-base","--is-ancestor",reviewed,"HEAD"],repo)
                if ancestor.returncode!=0: review_errors.append("Independent-Review-Head is not an ancestor of HEAD")
                else:
                    changed=run(["git","diff","--name-only",reviewed,"HEAD"],repo)
                    allowed={"STATUS.md"}
                    unexpected=[x for x in changed.stdout.splitlines() if x and x not in allowed and not x.startswith(".delivery/reviews/")]
                    if unexpected: review_errors.append("release content changed after review: "+", ".join(unexpected[:5]))
        add("independent_review","FAIL" if review_errors else "PASS","; ".join(review_errors) if review_errors else f"reviewer={reviewer} head={review_head}")
    elif effective:add("independent_review","PASS",f"Effective-Risk={effective}; independent review not mandatory")

    final_clean,final_clean_detail=clean_tree(repo)
    if initial_head!=head(repo): final_clean,final_clean_detail="FAIL","HEAD changed while production checks were running"
    add("clean_tree_after_checks",final_clean,final_clean_detail)
    statuses=[v["status"] for v in results.values()]
    final="BLOCKED" if "FAIL" in statuses else "UNVERIFIED" if "UNVERIFIED" in statuses else "PRODUCTION_READY"
    payload={"result":final,"effectiveRisk":effective,"migrationRisk":migration,"releaseBase":base,"gates":results}
    if a.json:print(json.dumps(payload,indent=2))
    else:
        print("production-gate\n"+"-"*60)
        for name,item in results.items():
            print(f"{name:20} {item['status']}")
            if item["detail"]:print(f"  {str(item['detail']).splitlines()[-1]}")
        print("-"*60+f"\nPRODUCTION_GATE={final}")
    return READY if final=="PRODUCTION_READY" else UNVERIFIED if final=="UNVERIFIED" else BLOCKED

if __name__=="__main__":raise SystemExit(main())
