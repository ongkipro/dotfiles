#!/usr/bin/env python3
"""ai-memory-lifecycle - advisory retention/merge recommendations from actual memory usage."""
from __future__ import annotations
import argparse, json, subprocess, sys
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path


def parse_time(s): return datetime.fromisoformat(s.replace('Z','+00:00'))
def tracked(dot: Path):
    out=[]
    for rel in ('config/ai/memory','config/ai/project-memory'):
        root=dot/rel
        if root.is_dir(): out += sorted(p for p in root.rglob('*.md') if p.is_file())
    return out

def load_usage(telemetry: Path):
    meta=telemetry/'meta.json'; started=None; events=[]
    if meta.is_file():
        try: started=parse_time(json.loads(meta.read_text())['startedAt'])
        except Exception: pass
    p=telemetry/'events.jsonl'
    if p.is_file():
        for no,line in enumerate(p.read_text(encoding='utf-8').splitlines(),1):
            if not line.strip(): continue
            try: events.append(json.loads(line))
            except json.JSONDecodeError as e: raise ValueError(f'events.jsonl:{no}: {e}')
    return started,events

def main():
    p=argparse.ArgumentParser(); p.add_argument('--dotfiles'); p.add_argument('--telemetry-dir'); p.add_argument('--cold-days',type=int,default=90); p.add_argument('--min-observation-days',type=int,default=30); p.add_argument('--never-used-days',type=int,default=60); p.add_argument('--json',action='store_true'); p.add_argument('--today')
    a=p.parse_args(); dot=Path(a.dotfiles or Path(__file__).resolve().parent.parent).resolve(); tele=Path(a.telemetry_dir or Path.home()/'.config/ai-local/memory-usage').expanduser().resolve()
    try:
        now=datetime.fromisoformat(a.today+'T00:00:00+00:00') if a.today else datetime.now(timezone.utc)
        started,events=load_usage(tele); counts=Counter(); last={}
        for e in events:
            try: t=parse_time(e['time'])
            except Exception: continue
            for item in e.get('selected',[]):
                path=item.get('path');
                if not path: continue
                counts[path]+=1
                if path not in last or t>last[path]: last[path]=t
        observed_days=(now-started).days if started else 0
        rows=[]
        for f in tracked(dot):
            rel=f.relative_to(dot).as_posix(); uses=counts[rel]; lu=last.get(rel); age=(now-lu).days if lu else None
            status='INSUFFICIENT_OBSERVATION'; recommendation='retain'
            if started and observed_days>=a.min_observation_days:
                if uses==0 and observed_days>=a.never_used_days: status='NEVER_USED'; recommendation='archive-review'
                elif age is not None and age>=a.cold_days: status='COLD'; recommendation='archive-review'
                elif uses>=5 and (age is None or age<30): status='ACTIVE'; recommendation='retain'
                else: status='LOW_USE'; recommendation='retain-review'
            rows.append({'path':rel,'uses':uses,'lastUsed':lu.isoformat().replace('+00:00','Z') if lu else None,'ageDays':age,'status':status,'recommendation':recommendation})
        # Duplicate-aware merge review. Only advisory; choose lower-use side when hygiene identifies a pair.
        hygiene=dot/'bin'/'ai-memory-hygiene'
        if hygiene.is_file():
            r=subprocess.run(['python3',str(hygiene),'--json'],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,check=False)
            if r.returncode in (0,1):
                try:
                    h=json.loads(r.stdout); by={x['path']:x for x in rows}
                    for issue in h.get('issues',[]):
                        if issue.get('kind')!='SEMANTIC_DUPLICATE' or not issue.get('relatedPath'): continue
                        try:
                            l=Path(issue['path']).resolve().relative_to(dot).as_posix(); rr=Path(issue['relatedPath']).resolve().relative_to(dot).as_posix()
                        except ValueError: continue
                        if l in by and rr in by:
                            loser=l if by[l]['uses']<=by[rr]['uses'] else rr
                            if by[loser]['recommendation']!='archive-review': by[loser]['recommendation']='merge-review'
                            by[loser]['duplicateWith']=rr if loser==l else l
                except json.JSONDecodeError: pass
        payload={'observationStartedAt':started.isoformat().replace('+00:00','Z') if started else None,'observationDays':observed_days,'files':rows,'counts':dict(Counter(x['status'] for x in rows))}
        if a.json: print(json.dumps(payload,indent=2))
        else:
            print(f"ai-memory-lifecycle: observation={observed_days}d files={len(rows)}")
            for x in rows:
                if x['recommendation']!='retain': print(f"  {x['status']:24} {x['path']} uses={x['uses']} -> {x['recommendation']}")
        return 0
    except (OSError,ValueError) as e:
        print(f'ai-memory-lifecycle: ERROR: {e}',file=sys.stderr); return 1
if __name__=='__main__': raise SystemExit(main())
