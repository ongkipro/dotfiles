#!/usr/bin/env bash
# vps-pgdump — tarik backup Postgres + config stack KELUAR dari sebuah VPS.
#
# Kenapa ada: snapshot Vultr GAGAL SENYAP (2026-07-14, dicoba 2x: pending lalu
# lenyap, 404, tanpa pesan error). Backup tidak boleh bergantung pada fitur
# provider yang tidak bisa dipercaya. Ini menarik data KELUAR — jadi jalan di
# Vultr, Hetzner, atau VPS mana pun yang menjalankan Postgres di Docker.
#
# `pg_dump` yang jalan DI DALAM server, disimpan di disk yang sama, BUKAN backup.
# Kalau instance-nya hilang, dump-nya ikut hilang. Backup harus keluar dari mesinnya.
#
# Pakai:
#   vps-pgdump root@<host>                    # TokoΦ (Coolify @ Vultr); the
#                                             # address is device-local, in
#                                             # ~/.config/ai-local/project-credentials.md
#   vps-pgdump root@1.2.3.4 -i ~/.ssh/keyname # kunci non-default
#
# Read-only di sisi server: cuma `docker ps` + `pg_dump`. Tidak mengubah apa pun.
set -euo pipefail

# Dumps and stack configuration contain database credentials. Apply the private
# creation mask before creating the output directory or any file within it.
umask 077

HOST="${1:-}"
shift || true
SSH_OPTS_COUNT=$#
SSH_OPTS=("$@")   # mis. -i ~/.ssh/tokophi_dev

[ -n "$HOST" ] || { echo "Usage: vps-pgdump user@host [ssh-opts...]" >&2; exit 1; }

STAMP=$(date +%Y%m%d-%H%M%S)
BACKUPS="$HOME/Documents/work/backups"
mkdir -p "$BACKUPS"
HOST_LABEL="$(printf '%s' "$HOST" | LC_ALL=C sed 's/[^a-zA-Z0-9_.-]/_/g')"
OUT="$(mktemp -d "$BACKUPS/$HOST_LABEL-$STAMP.XXXXXX")"
printf 'INCOMPLETE\n' > "$OUT/backup.status"

# Backup berisi SECRET (env, kredensial DB). JANGAN pernah masuk repo.
case "$OUT" in
  "$HOME/dotfiles"/*) echo "TOLAK: output di dalam dotfiles = risiko secret ter-commit." >&2; exit 1 ;;
esac

say() { printf '\n\033[1m%s\033[0m\n' "$1"; }
run() {
  # Bash 3.2 + nounset cannot safely expand an empty array. Keep the zero-option
  # branch expansion-free while preserving caller options before fixed options.
  if [ "$SSH_OPTS_COUNT" -eq 0 ]; then
    ssh -o BatchMode=yes -o ConnectTimeout=10 "$HOST" "$@"
  else
    ssh "${SSH_OPTS[@]}" -o BatchMode=yes -o ConnectTimeout=10 "$HOST" "$@"
  fi
}

say "1. Koneksi"
run 'echo "  ✓ SSH OK — $(hostname), uptime$(uptime -p | sed s/up//)"'

say "2. Container yang jalan"
run 'docker ps --format "  {{.Names}}\t{{.Image}}\t{{.Status}}"' | tee "$OUT/containers.txt"

say "3. Cari container Postgres"
# JANGAN tebak dari nama/image. Coolify menjalankan sidecar `backup-*` yang PAKAI
# image postgres:16-alpine tapi TIDAK menjalankan server DB — memilihnya bikin
# psql gagal ("socket ... No such file or directory"). Jadi: tanya tiap kandidat
# apakah benar-benar MELAYANI Postgres, pakai pg_isready. Kandidat pertama yang
# menjawab = server DB yang asli.
PGS=()
if ! INVENTORY=$(run 'docker ps --format "{{.Names}}\t{{.Image}}"'); then
  echo "  ✗ container enumeration failed — backup INCOMPLETE: $OUT" >&2
  exit 1
fi
CANDS=$(printf '%s\n' "$INVENTORY" | awk 'tolower($0) ~ /postgres|pgvector/ { print $1 }')
for c in $CANDS; do
  case "$c" in ''|.|..|-*|*[!a-zA-Z0-9_.-]*) echo "Invalid container identity" >&2; exit 1 ;; esac
  printf '  %-52s ' "$c"
  if run "docker exec $c sh -c 'pg_isready -U \"\$POSTGRES_USER\" -q'" 2>/dev/null; then
    echo "✓ melayani Postgres"
    PGS+=("$c")
  else
    echo "– bukan server DB (lewati)"
  fi
done
if [ ${#PGS[@]} -eq 0 ]; then
  echo "  ✗ Tak ada container yang benar-benar melayani Postgres. Lihat $OUT/containers.txt." >&2
  exit 1
fi
echo "  → ${#PGS[@]} server DB akan di-dump SEMUA."

# Dump SETIAP server Postgres, bukan cuma yang pertama. Di Coolify ada dua yang
# dua-duanya penting: DB aplikasi, DAN `coolify-db` (definisi app, env, config
# deploy). Tanpa coolify-db, server yang hilang berarti menyusun ulang seluruh
# setup deploy dari nol.
say "4-5. Dump semua database (custom format) + verifikasi"
PG_RESTORE_AVAILABLE=1
if ! command -v pg_restore >/dev/null 2>&1; then
  PG_RESTORE_AVAILABLE=0
  echo "  ! pg_restore lokal tidak tersedia — dump akan disimpan tetapi ditandai BELUM TERVERIFIKASI."
fi
FAIL=0
UNVERIFIED=0
DISCOVERED=0
DUMPED=0
VERIFIED=0
for PG in "${PGS[@]}"; do
  echo "  [$PG]"
  if ! DBS=$(run "docker exec $PG sh -c 'psql -U \"\$POSTGRES_USER\" -d \"\$POSTGRES_DB\" -tAc \"SELECT datname FROM pg_database WHERE datistemplate=false AND datname<>'\"'\"'postgres'\"'\"';\"'"); then
    echo "    ✗ database enumeration failed — backup INCOMPLETE" >&2
    FAIL=1
    continue
  fi
  if [ -z "$DBS" ]; then
    echo "    ✗ no databases discovered — backup INCOMPLETE" >&2
    FAIL=1
    continue
  fi
  mkdir -p "$OUT/$PG"
  INDEX=0
  while IFS= read -r db; do
    [ -n "$db" ] || continue
    DISCOVERED=$((DISCOVERED + 1))
    INDEX=$((INDEX + 1))
    # The ordinal prevents collisions after filename sanitization. Keep the
    # original identity in a private manifest, and pass it as one remote arg.
    label="$(printf '%s' "$db" | LC_ALL=C sed 's/[^a-zA-Z0-9_.-]/_/g')"
    dumpfile="$OUT/$PG/$INDEX-$label.dump"
    printf '%s\t%s\n' "$INDEX-$label.dump" "$db" >> "$OUT/$PG/databases.tsv"
    quoted_db="'$(printf '%s' "$db" | sed "s/'/'\\\\''/g")'"
    printf '    %-22s ' "$db"
    if ! run "docker exec $PG sh -c 'pg_dump -Fc -U \"\$POSTGRES_USER\" -- \"\$1\"' sh $quoted_db" > "$dumpfile.partial"; then
      echo "✗ pg_dump failed — partial output retained, backup INCOMPLETE"
      FAIL=1
      continue
    fi
    mv "$dumpfile.partial" "$dumpfile"
    DUMPED=$((DUMPED + 1))
    sz=$(du -h "$dumpfile" | cut -f1)
    # Archive readability is not a restore drill. Missing tooling preserves
    # the archive but never counts it as verified.
    if [ "$PG_RESTORE_AVAILABLE" -eq 0 ]; then
      echo "! $sz — DISIMPAN, BELUM TERVERIFIKASI (pg_restore lokal tidak ada)"
      UNVERIFIED=1
    elif pg_restore -l "$dumpfile" >/dev/null 2>&1; then
      VERIFIED=$((VERIFIED + 1))
      echo "✓ $sz — archive readable by pg_restore (restore not tested)"
    else
      echo "✗ $sz — RUSAK menurut pg_restore. JANGAN dianggap backup."
      mv "$dumpfile" "$dumpfile.invalid"; FAIL=1
    fi
  done <<EOF
$DBS
EOF
done
printf '  Databases: discovered=%s dumped=%s archive-verified=%s\n' "$DISCOVERED" "$DUMPED" "$VERIFIED"
[ "$FAIL" -eq 0 ] && [ "$DISCOVERED" -gt 0 ] && [ "$DUMPED" -eq "$DISCOVERED" ] || {
  echo "  ✗ backup INCOMPLETE — successful dumps retained at $OUT" >&2
  exit 1
}
[ "$UNVERIFIED" -eq 0 ] \
  || echo "  ! Satu atau lebih dump dipertahankan tetapi integritasnya BELUM TERVERIFIKASI."

say "6. Config stack (compose + Coolify; archive dapat memuat .env)"
run 'find /data/coolify -maxdepth 3 -name "docker-compose*.y*ml" 2>/dev/null | head -20' > "$OUT/compose-files.txt" || true
run 'tar czf - /data/coolify/applications /data/coolify/databases 2>/dev/null' > "$OUT/coolify-config.tar.gz" 2>/dev/null || \
  echo "  ! /data/coolify tidak terbaca — lewati (dump DB tetap aman)"
[ -s "$OUT/coolify-config.tar.gz" ] && echo "  ✓ coolify-config.tar.gz ($(du -h "$OUT/coolify-config.tar.gz" | cut -f1))" || rm -f "$OUT/coolify-config.tar.gz"

if [ "$UNVERIFIED" -eq 0 ]; then
  printf 'DATABASE_ARCHIVES_VERIFIED; RESTORE_NOT_TESTED\n' > "$OUT/backup.status"
else
  printf 'DATABASE_DUMPS_UNVERIFIED\n' > "$OUT/backup.status"
fi
say "SELESAI"
echo "  Lokasi : $OUT"
du -sh "$OUT" | awk '{print "  Ukuran : " $1}'
echo
echo "  🔒 Isinya SECRET (kredensial DB, env). JANGAN commit, JANGAN taruh di dotfiles."
echo "  Restore nanti: pg_restore -d <db> --clean --if-exists <file>.dump"
