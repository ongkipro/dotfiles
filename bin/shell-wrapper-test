#!/usr/bin/env bash
# Regression checks for OMP shell wrapper routing and credential scope.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/shell-wrapper-test.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

extract_function() {
  local file="$1" name="$2"
  awk -v signature="$name() {" '
    $0 == signature { inside = 1 }
    inside { print }
    inside && $0 == "}" { exit }
  ' "$file"
}

mkdir -p "$TMP/home/.pi/agent" "$TMP/bin"
printf '%s\n' '{"9router-fantastico":{"key":"test-only"}}' > "$TMP/home/.pi/agent/auth.json"

cat > "$TMP/bin/curl" <<'EOF'
#!/usr/bin/env bash
[ -z "${FAIL_CURL:-}" ] || exit 22
printf '%s\n' 'printf "update-dispatch:PASS\\n"'
EOF
cat > "$TMP/bin/jq" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' 'test-only'
EOF
cat > "$TMP/bin/omp" <<'EOF'
#!/usr/bin/env bash
if [ -n "${NINEROUTER_REMOTE_KEY:-}" ]; then
  printf 'binary:%s:key-set\n' "$*"
else
  printf 'binary:%s:key-unset\n' "$*"
fi
EOF
chmod +x "$TMP/bin/curl" "$TMP/bin/jq" "$TMP/bin/omp"

check_wrapper() {
  local file="$1" function_code
  function_code="$(extract_function "$file" omp)"
  [ -n "$function_code" ] || { echo "missing omp() in $file" >&2; return 1; }

  (
    export HOME="$TMP/home"
    export PATH="$TMP/bin:/usr/bin:/bin"
    unset NINEROUTER_REMOTE_KEY
    eval "$function_code"

    [ "$(omp hello world)" = "binary:hello world:key-set" ]
    [ -z "${NINEROUTER_REMOTE_KEY:-}" ]
    [ "$(omp update)" = "update-dispatch:PASS" ]
    ! (export FAIL_CURL=1; omp update >/dev/null 2>&1)
  )

  printf '✓ %s:omp wrapper\n' "${file#$ROOT/}"
}


[ -z "$(bash -c '. "$1"' _ "$ROOT/config/shell-tools.sh")" ]
echo "✓ config/shell-tools.sh: quiet non-interactive source"
check_wrapper "$ROOT/config/shell-tools.sh"
check_wrapper "$ROOT/config/bashrc.tools.sh"
check_wrapper "$ROOT/config/zshrc.tools.sh"
echo "shell-wrapper-test: OK"
