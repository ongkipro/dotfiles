#!/usr/bin/env bash
# Regression fixtures for cross-shell setup and transparent OMP execution.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/shell-wrapper-test.XXXXXX")"
trap 'find "$TMP" -depth -delete 2>/dev/null || true' EXIT

extract_function() {
  local file="$1" name="$2"
  awk -v signature="$name() {" '
    $0 == signature { inside = 1 }
    inside { print }
    inside && $0 == "}" { exit }
  ' "$file"
}

precedence_secret="fixture-precedence-secret"
mkdir -p "$TMP/home/.local/bin" "$TMP/bin"
cat > "$TMP/bin/omp" <<EOF
#!/usr/bin/env bash
case "\${NINEROUTER_REMOTE_KEY-}" in
  "$precedence_secret") source=precedence ;;
  "") source=unset ;;
  *) source=other ;;
esac
printf 'binary:%s:source-%s:config-%s\\n' \
  "\$*" "\$source" "\${PI_CONFIG_FILES-unset}"
EOF
chmod +x "$TMP/bin/omp"
ln -s "$TMP/bin/omp" "$TMP/home/.local/bin/omp"

check_native_omp() {
  local file="$1" shell="$2" output
  output="$(
    HOME="$TMP/home" PATH="$TMP/bin:/usr/bin:/bin" PRECEDENCE_SECRET="$precedence_secret" \
      "$shell" -c '
        set -eu
        . "$1"
        unset NINEROUTER_REMOTE_KEY PI_CONFIG_FILES
        [ "$(omp hello world)" = "binary:hello world:source-unset:config-unset" ]
        NINEROUTER_REMOTE_KEY="$PRECEDENCE_SECRET" PI_CONFIG_FILES=/explicit/config.yml \
          omp passthrough
      ' _ "$file"
  )"
  [ "$output" = "binary:passthrough:source-precedence:config-/explicit/config.yml" ] || {
    printf '%s\n' "$output" >&2
    return 1
  }
  printf '✓ %s: omp remains an upstream-native command under %s\n' \
    "${file#$ROOT/}" "$(basename "$shell")"
}

shell_name_code="$(extract_function "$ROOT/config/shell-tools.sh" _shell_name)"
[ -n "$shell_name_code" ]
(
  export SHELL=/bin/zsh
  unset ZSH_VERSION
  eval "$shell_name_code"
  [ "$(_shell_name)" = "bash" ]
)
echo "✓ config/shell-tools.sh: detects the running shell"

check_quiet_source() {
  local shell="$1" login_shell="$2" output
  if ! output="$(SHELL="$login_shell" "$shell" -c '. "$1"' _ "$ROOT/config/shell-tools.sh" 2>&1)"; then
    printf '%s\n' "$output" >&2
    return 1
  fi
  [ -z "$output" ] || { printf '%s\n' "$output" >&2; return 1; }
  printf '✓ config/shell-tools.sh: quiet %s source\n' "$(basename "$shell")"
}

check_quiet_source bash /bin/zsh
check_native_omp "$ROOT/config/shell-tools.sh" bash
grep -qxF 'source "$HOME/dotfiles/config/shell-tools.sh"' "$ROOT/config/bashrc.tools.sh"
echo "✓ config/bashrc.tools.sh: delegates to the canonical cross-shell source"
mise_activation_count="$(
  grep -cF 'eval "$(mise activate "$(_shell_name)")"' "$ROOT/config/shell-tools.sh" || true
)"
[ "$mise_activation_count" -eq 1 ] || {
  echo "config/shell-tools.sh must be the single tracked mise activation owner" >&2
  exit 1
}
echo "✓ config/shell-tools.sh: single tracked mise activation owner"

linux_installer_fn="$TMP/install.ensure_shell_source"
linux_rc="$TMP/bashrc"
extract_function "$ROOT/install.sh" ensure_shell_source > "$linux_installer_fn"
printf '%s\n' \
  'export KEEP_ME=1' \
  'eval "$(~/.local/bin/mise activate bash)"' \
  > "$linux_rc"
(
  # shellcheck source=/dev/null
  source "$linux_installer_fn"
  ensure_shell_source "$linux_rc" "shell-tools.sh" "dev-tools setup (ongkipro/dotfiles)" >/dev/null
)
if grep -qF 'mise activate' "$linux_rc"; then
  echo "install.sh left a standalone mise activation in migrated bashrc" >&2
  exit 1
fi
grep -qxF 'export KEEP_ME=1' "$linux_rc"
grep -qxF 'source "$HOME/dotfiles/config/shell-tools.sh"' "$linux_rc"
echo "✓ install.sh: migrates standalone mise activation to the tracked source"

mac_installer_fn="$TMP/install-macos.ensure_line"
mac_rc="$TMP/zshrc"
extract_function "$ROOT/install-macos.sh" ensure_line > "$mac_installer_fn"
printf '%s\n' \
  'export KEEP_ME=1' \
  'eval "$($HOME/.local/bin/mise activate zsh)"' \
  > "$mac_rc"
(
  say() { :; }
  # shellcheck source=/dev/null
  source "$mac_installer_fn"
  ensure_line 'source "$HOME/dotfiles/config/zshrc.tools.sh"' "$mac_rc"
)
if grep -qF 'mise activate' "$mac_rc"; then
  echo "install-macos.sh left a standalone mise activation in migrated zshrc" >&2
  exit 1
fi
grep -qxF 'export KEEP_ME=1' "$mac_rc"
grep -qxF 'source "$HOME/dotfiles/config/zshrc.tools.sh"' "$mac_rc"
echo "✓ install-macos.sh: migrates standalone mise activation to the tracked source"
if command -v zsh >/dev/null 2>&1; then
  check_quiet_source zsh /bin/bash
  check_native_omp "$ROOT/config/shell-tools.sh" zsh
  grep -qxF 'source "$HOME/dotfiles/config/shell-tools.sh"' "$ROOT/config/zshrc.tools.sh"
  echo "✓ config/zshrc.tools.sh: delegates to the canonical cross-shell source"
else
  echo "SKIP: optional Zsh execution fixture is not applicable on this device"
fi

echo "shell-wrapper-test: OK"
