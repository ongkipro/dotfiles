#!/usr/bin/env bash
# Regression fixtures for Bash/Zsh OMP wrapper routing and credential scope.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/shell-wrapper-test.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

extract_function() {
  local file="$1" name="$2"
  awk -v signature="$name() {" '
    $0 == signature { inside = 1 }
    inside { print }
    inside && $0 == "}" { exit }
  ' "$file"
}

neutral_secret="fixture-neutral-secret"
precedence_secret="fixture-precedence-secret"
legacy_pi_secret="fixture-legacy-pi-secret"
credential_dir="$TMP/home/.config/ai-local/credentials"
mkdir -p "$credential_dir" "$TMP/home/.pi/agent" "$TMP/bin"
printf '%s\n' "$neutral_secret" > "$credential_dir/9router-remote-key"
printf '%s\n' "{\"9router-fantastico\":{\"key\":\"$legacy_pi_secret\"}}" \
  > "$TMP/home/.pi/agent/auth.json"

cat > "$TMP/bin/curl" <<'EOF'
#!/usr/bin/env bash
[ -z "${FAIL_CURL:-}" ] || exit 22
printf '%s\n' 'printf "update-dispatch:PASS\\n"'
EOF
cat > "$TMP/bin/omp" <<EOF
#!/usr/bin/env bash
case "\${NINEROUTER_REMOTE_KEY-}" in
  "$neutral_secret") source=neutral ;;
  "$precedence_secret") source=precedence ;;
  "$legacy_pi_secret") source=legacy-pi ;;
  "") source=unset ;;
  *) source=other ;;
esac
printf 'binary:%s:source-%s\\n' "\$*" "\$source"
EOF
chmod +x "$TMP/bin/curl" "$TMP/bin/omp"

check_wrapper() {
  local file="$1" shell="$2" function_file output
  function_file="$TMP/$(basename "$file").omp"
  extract_function "$file" omp > "$function_file"
  [ -s "$function_file" ] || { echo "missing omp() in $file" >&2; return 1; }

  output="$({
    HOME="$TMP/home" \
    PATH="$TMP/bin:/usr/bin:/bin" \
    NEUTRAL_SECRET="$neutral_secret" \
    PRECEDENCE_SECRET="$precedence_secret" \
    CREDENTIAL_FILE="$credential_dir/9router-remote-key" \
      "$shell" -c '
        set -eu
        . "$1"

        unset NINEROUTER_REMOTE_KEY
        first="$(omp hello world)"
        [ "$first" = "binary:hello world:source-neutral" ]
        [ "${NINEROUTER_REMOTE_KEY+x}" != x ]

        export NINEROUTER_REMOTE_KEY="$PRECEDENCE_SECRET"
        second="$(omp precedence)"
        [ "$second" = "binary:precedence:source-precedence" ]
        [ "$NINEROUTER_REMOTE_KEY" = "$PRECEDENCE_SECRET" ]

        unset NINEROUTER_REMOTE_KEY
        rm -f "$CREDENTIAL_FILE"
        third="$(omp without-neutral-file)"
        [ "$third" = "binary:without-neutral-file:source-unset" ]
        [ "${NINEROUTER_REMOTE_KEY+x}" != x ]
        printf "%s\\n" "$NEUTRAL_SECRET" > "$CREDENTIAL_FILE"

        [ "$(omp update)" = "update-dispatch:PASS" ]
        ! (export FAIL_CURL=1; omp update >/dev/null 2>&1)

        printf "%s\\n%s\\n%s\\n" "$first" "$second" "$third"
      ' _ "$function_file"
  } 2>&1)"

  case "$output" in
    *"$neutral_secret"*|*"$precedence_secret"*|*"$legacy_pi_secret"*)
      echo "credential value escaped wrapper output for $file under $shell" >&2
      return 1
      ;;
  esac
  printf '✓ %s: omp wrapper under %s\n' "${file#$ROOT/}" "$(basename "$shell")"
}

shell_name_code="$(extract_function "$ROOT/config/shell-tools.sh" _shell_name)"
[ -n "$shell_name_code" ]
(
  export SHELL=/bin/zsh
  unset ZSH_VERSION
  eval "$shell_name_code"
  [ "$(_shell_name)" = "bash" ]
)
echo "✓ config/shell-tools.sh: detects the running shell"

check_quiet_source() {
  local shell="$1" login_shell="$2" output
  if ! output="$(SHELL="$login_shell" "$shell" -c '. "$1"' _ "$ROOT/config/shell-tools.sh" 2>&1)"; then
    printf '%s\n' "$output" >&2
    return 1
  fi
  [ -z "$output" ] || { printf '%s\n' "$output" >&2; return 1; }
  printf '✓ config/shell-tools.sh: quiet %s source\n' "$(basename "$shell")"
}

check_quiet_source bash /bin/zsh
check_wrapper "$ROOT/config/shell-tools.sh" bash
grep -qxF 'source "$HOME/dotfiles/config/shell-tools.sh"' "$ROOT/config/bashrc.tools.sh"
echo "✓ config/bashrc.tools.sh: delegates to the canonical cross-shell source"
mise_activation_count="$(
  grep -cF 'eval "$(mise activate "$(_shell_name)")"' "$ROOT/config/shell-tools.sh" || true
)"
[ "$mise_activation_count" -eq 1 ] || {
  echo "config/shell-tools.sh must be the single tracked mise activation owner" >&2
  exit 1
}
echo "✓ config/shell-tools.sh: single tracked mise activation owner"

linux_installer_fn="$TMP/install.ensure_shell_source"
linux_rc="$TMP/bashrc"
extract_function "$ROOT/install.sh" ensure_shell_source > "$linux_installer_fn"
printf '%s\n' \
  'export KEEP_ME=1' \
  'eval "$(~/.local/bin/mise activate bash)"' \
  > "$linux_rc"
(
  # shellcheck source=/dev/null
  source "$linux_installer_fn"
  ensure_shell_source "$linux_rc" "shell-tools.sh" "dev-tools setup (ongkipro/dotfiles)" >/dev/null
)
if grep -qF 'mise activate' "$linux_rc"; then
  echo "install.sh left a standalone mise activation in migrated bashrc" >&2
  exit 1
fi
grep -qxF 'export KEEP_ME=1' "$linux_rc"
grep -qxF 'source "$HOME/dotfiles/config/shell-tools.sh"' "$linux_rc"
echo "✓ install.sh: migrates standalone mise activation to the tracked source"

mac_installer_fn="$TMP/install-macos.ensure_line"
mac_rc="$TMP/zshrc"
extract_function "$ROOT/install-macos.sh" ensure_line > "$mac_installer_fn"
printf '%s\n' \
  'export KEEP_ME=1' \
  'eval "$($HOME/.local/bin/mise activate zsh)"' \
  > "$mac_rc"
(
  say() { :; }
  # shellcheck source=/dev/null
  source "$mac_installer_fn"
  ensure_line 'source "$HOME/dotfiles/config/zshrc.tools.sh"' "$mac_rc"
)
if grep -qF 'mise activate' "$mac_rc"; then
  echo "install-macos.sh left a standalone mise activation in migrated zshrc" >&2
  exit 1
fi
grep -qxF 'export KEEP_ME=1' "$mac_rc"
grep -qxF 'source "$HOME/dotfiles/config/zshrc.tools.sh"' "$mac_rc"
echo "✓ install-macos.sh: migrates standalone mise activation to the tracked source"
if command -v zsh >/dev/null 2>&1; then
  check_quiet_source zsh /bin/bash
  check_wrapper "$ROOT/config/shell-tools.sh" zsh
  grep -qxF 'source "$HOME/dotfiles/config/shell-tools.sh"' "$ROOT/config/zshrc.tools.sh"
  echo "✓ config/zshrc.tools.sh: delegates to the canonical cross-shell source"
else
  echo "WARNING: PARTIAL shell-wrapper-test: zsh unavailable; Zsh execution fixtures skipped"
fi

echo "shell-wrapper-test: OK"
