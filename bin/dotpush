#!/usr/bin/env bash
# Commit & push semua perubahan dotfiles (config + memori + skill) dalam 1 perintah.
# Aman lintas-mesin: auto-sync dgn remote dulu (snapshot mesin → merge 'ours'),
# scan secret sebelum commit. Pakai: dotpush [--yes] ["pesan commit"]
set -euo pipefail

AUTO_YES=0
if [ "${1:-}" = "--yes" ]; then
  AUTO_YES=1
  shift
fi
MESSAGE="${1:-update: $(date '+%Y-%m-%d %H:%M' 2>/dev/null || echo sync)}"

cd ~/dotfiles

# Aktifkan driver merge 'ours' (dipakai .gitattributes utk file snapshot mesin). Idempotent.
git config merge.ours.driver true

# Refresh snapshot config yang ditulis tool / mesin-spesifik (biar selalu current).
cp -f ~/.gitconfig                      home/gitconfig              2>/dev/null || true
cp -f ~/.config/mise/config.toml        config/mise-config.toml     2>/dev/null || true
cp -f ~/.zshrc                          home/zshrc.snapshot         2>/dev/null || true
cp -f ~/.bashrc                         home/bashrc.snapshot        2>/dev/null || true
# VSCode settings: Linux (~/.config/...) vs macOS (~/Library/Application Support/...)
for vs in "$HOME/Library/Application Support/Code/User/settings.json" ~/.config/Code/User/settings.json; do
  [ -f "$vs" ] && { cp -f "$vs" config/vscode-settings.json; break; }
done

git add -A
if git diff --cached --quiet; then
  echo "Tidak ada perubahan lokal untuk di-commit."
else
  git -c core.pager=cat status --short
  echo ""
  echo "Staged preview:"
  git -c core.pager=cat diff --cached --stat

  ai_changed="$(git diff --cached --name-only -- \
    config/ai \
    skills/local \
    bin/ai-doctor \
    bin/pi-update-safe \
    config/bashrc.tools.sh \
    config/zshrc.tools.sh \
    config/shell-tools.sh \
    2>/dev/null || true)"
  if [ -n "$ai_changed" ]; then
    echo ""
    echo "AI plumbing touched:"
    printf '%s\n' "$ai_changed" | sed 's/^/  - /'
  fi

  # Scan secret SETELAH `git add -A`, SEBELUM commit.
  # Urutannya penting: sebelum staging, file baru yang belum ter-track tidak
  # terlihat oleh scanner sama sekali — jadi ia lolos lalu ikut ter-push.
  scanner=./bin/security-check
  if [ ! -x "$scanner" ]; then
    echo "✗ security-check tidak ada atau tidak executable; commit DIBATALKAN." >&2
    echo "  Perubahan tetap ter-stage untuk direview. Batalkan staging dengan: git reset" >&2
    exit 1
  fi
  if ! scan_output="$("$scanner" "$PWD" 2>&1)"; then
    echo "✗ security-check menemukan kemungkinan secret atau gagal memindai — commit DIBATALKAN." >&2
    printf '%s\n' "$scan_output" >&2
    echo "  Perubahan tetap ter-stage untuk direview. Batalkan staging dengan: git reset" >&2
    exit 1
  fi

  machine_snapshots="$(git diff --cached --name-only -- \
    home/gitconfig \
    config/mise-config.toml \
    home/zshrc.snapshot \
    home/bashrc.snapshot \
    config/vscode-settings.json)"
  if [ -n "$machine_snapshots" ] && [ "$AUTO_YES" -ne 1 ]; then
    echo ""
    echo "Snapshot yang disalin dari mesin ini ikut ter-stage:"
    printf '%s\n' "$machine_snapshots" | sed 's/^/  - /'
    if [ ! -t 0 ]; then
      echo "✗ Konfirmasi diperlukan; jalankan ulang dengan --yes setelah mereview staged diff." >&2
      exit 1
    fi
    printf 'Commit snapshot mesin di atas? [y/N] '
    read -r answer
    case "$answer" in
      y|Y|yes|YES) ;;
      *) echo "Commit dibatalkan; perubahan tetap ter-stage."; exit 1 ;;
    esac
  fi

  git commit -q -m "$MESSAGE"
fi

# Auto-sync dgn remote dulu agar push tak ditolak (snapshot mesin auto-'ours' via .gitattributes).
git fetch -q origin
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
if git rev-parse --verify -q "origin/$BRANCH" >/dev/null; then
  if [ -n "$(git rev-list "HEAD..origin/$BRANCH" 2>/dev/null)" ]; then
    echo "↓ Remote ada commit baru — sync (merge) dulu..."
    if ! git merge --no-edit "origin/$BRANCH"; then
      echo "✗ Konflik non-snapshot saat sync. Selesaikan manual:"
      git -c core.pager=cat diff --name-only --diff-filter=U
      echo "  lalu: git commit && dotpush"
      exit 1
    fi
  fi
fi

# Tak ada yg perlu di-push? (mis. cuma sync tanpa commit lokal & sudah sejajar)
if [ -z "$(git rev-list "origin/$BRANCH..HEAD" 2>/dev/null)" ]; then
  echo "Sudah sinkron dgn remote — tidak ada yang di-push."
  exit 0
fi

git push -q
echo "✓ dotfiles ter-push ke github.com/ongkipro/dotfiles"
