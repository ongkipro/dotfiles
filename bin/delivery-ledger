#!/usr/bin/env python3
"""delivery-ledger — repository-local execution evidence and resume ledger.

STATUS.md remains the workflow-state authority. The ledger is evidence/projection,
not a second state machine. Run events are append-only and hash-chained; release
snapshots are immutable and self-hashed.

Commands:
  init
  start --task TASK-001 --requirement REQ-001 --risk R1 --allow 'src/cart/**'
  expand-scope --path path --reason reason --required-by criterion --risk R3 --verification test-name
  check-boundary [--json]
  review-boundary --reviewer reviewer-id
  record --check name --status PASS|FAIL|UNVERIFIED [--detail text]
  checkpoint [--note text]
  finish --result PASS|FAIL|BLOCKED [--detail text]
  snapshot-release --release-id REL-...
  status [--json]
  verify [--json]
"""
from __future__ import annotations

import argparse
from contextlib import contextmanager
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from uuid import uuid4

OK, FAILED, UNVERIFIED = 0, 1, 2
RISK = {f"R{i}" for i in range(5)}
RISK_ORDER = {f"R{i}": i for i in range(5)}
CHECK_STATUS = {"PASS", "FAIL", "UNVERIFIED"}
RUN_RESULT = {"PASS", "FAIL", "BLOCKED"}
SAFE_ID = re.compile(r"^[A-Za-z0-9._-]+$")
GENERIC_EXPANSION_REASONS = {"cleanup", "refactor", "while here", "better architecture"}


def now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def canonical(data: dict) -> str:
    return json.dumps(data, sort_keys=True, separators=(",", ":"), ensure_ascii=True)


def digest(data: dict) -> str:
    return hashlib.sha256(canonical(data).encode("utf-8")).hexdigest()


def git_result(repo: Path, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["git", *args], cwd=repo, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)


def git(repo: Path, *args: str) -> str | None:
    r = git_result(repo, *args)
    return r.stdout.strip() if r.returncode == 0 else None


def git_bytes(repo: Path, *args: str, input_bytes: bytes | None = None) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(
        ["git", *args], cwd=repo, input=input_bytes, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, check=False,
    )


def base_head(repo: Path) -> str | None:
    return git(repo, "rev-parse", "--verify", "HEAD^{commit}")


def decode_path(raw: bytes) -> str:
    return raw.decode("utf-8", errors="surrogateescape")


def name_status_paths(raw: bytes) -> set[str]:
    fields = raw.split(b"\0")
    if fields and fields[-1] == b"":
        fields.pop()
    paths: set[str] = set()
    i = 0
    while i < len(fields):
        status_code = decode_path(fields[i]); i += 1
        count = 2 if status_code[:1] in {"R", "C"} else 1
        if i + count > len(fields):
            raise ValueError("malformed git name-status output")
        paths.update(decode_path(value) for value in fields[i:i + count])
        i += count
    return paths


def dirty_paths(repo: Path) -> list[str]:
    """Return tracked and untracked dirty paths, preserving both sides of renames."""
    diff_args = ["diff", "--name-status", "-z", "--no-ext-diff", "--no-textconv"]
    if base_head(repo):
        diff_args.append("HEAD")
    else:
        diff_args.append("--cached")
    changed = git_bytes(repo, *diff_args)
    if changed.returncode != 0:
        raise ValueError(changed.stderr.decode(errors="replace").strip() or "could not inspect tracked changes")
    paths = name_status_paths(changed.stdout)
    untracked = git_bytes(repo, "ls-files", "--others", "--exclude-standard", "-z")
    if untracked.returncode != 0:
        raise ValueError(untracked.stderr.decode(errors="replace").strip() or "could not inspect untracked paths")
    paths.update(decode_path(raw) for raw in untracked.stdout.split(b"\0") if raw)
    return sorted(path for path in paths if path != ".delivery" and not path.startswith(".delivery/"))


def fingerprint(repo: Path, relative: str) -> dict:
    path = repo / relative
    try:
        info = path.lstat()
    except FileNotFoundError:
        return {"kind": "missing"}
    mode = stat.S_IMODE(info.st_mode)
    if stat.S_ISLNK(info.st_mode):
        raw = os.fsencode(os.readlink(path)); kind = "symlink"
    elif stat.S_ISREG(info.st_mode):
        h = hashlib.sha256()
        with path.open("rb") as stream:
            for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                h.update(chunk)
        return {"kind": "file", "mode": mode, "sha256": h.hexdigest(), "bytes": info.st_size}
    else:
        return {"kind": "unknown", "mode": mode}
    return {"kind": kind, "mode": mode, "sha256": hashlib.sha256(raw).hexdigest(), "bytes": len(raw)}


def snapshot_dirty(repo: Path) -> list[dict]:
    return [{"path": path, "fingerprint": fingerprint(repo, path)} for path in dirty_paths(repo)]


def surface_of(repo: Path, relatives: list[str]) -> str:
    """Content identity of a fixed set of paths, independent of commit state.

    `head` alone cannot answer this: an agent edits the working tree for a whole
    run without committing, so HEAD never moves while the code under test changes
    completely.

    The path list must be fixed by the caller and re-measured later, never
    recollected. Collecting "currently dirty" at both ends compares two different
    questions: committing the verified work empties that set without touching a
    byte, and a first attempt at this rule duly declared every commit-then-finish
    run stale — a workflow that is not merely legal but the correct one.

    Known limit: a file created *after* the check is not in the recorded list, so
    it does not mark the check stale here. The boundary check owns new paths.
    """
    return digest([{"path": path, "fingerprint": fingerprint(repo, path)} for path in relatives])


def validate_pattern(pattern: str) -> str:
    if not pattern or pattern.startswith("/") or "\\" in pattern:
        raise ValueError(f"invalid boundary pattern: {pattern!r}")
    parts = pattern.split("/")
    if any(part in {"", ".", ".."} for part in parts):
        raise ValueError(f"invalid boundary pattern: {pattern!r}")
    return pattern

OWNER = re.compile(r"^[a-z][a-z0-9-]*(?:\.[a-z][a-z0-9-]*)+$")


def child_boundary(pattern: str) -> dict:
    """Normalize a child boundary to an exact path or terminal subtree."""
    pattern = validate_pattern(pattern)
    if pattern.endswith("/**"):
        root = pattern[:-3]
        if not root or any(token in root for token in "*?[]"):
            raise ValueError(f"parallel child boundary must be an exact path or terminal subtree: {pattern!r}")
        return {"kind": "subtree", "root": root, "pattern": pattern}
    if any(token in pattern for token in "*?[]"):
        raise ValueError(f"parallel child boundary must be an exact path or terminal subtree: {pattern!r}")
    return {"kind": "exact", "root": pattern, "pattern": pattern}


def child_boundaries_overlap(left: dict, right: dict) -> bool:
    if left["kind"] == right["kind"] == "exact":
        return left["root"] == right["root"]
    if left["kind"] == "subtree" and right["kind"] == "subtree":
        return left["root"] == right["root"] or left["root"].startswith(right["root"] + "/") or right["root"].startswith(left["root"] + "/")
    subtree, exact = (left, right) if left["kind"] == "subtree" else (right, left)
    # `src/auth` and `src/auth/**` are the same surface: the exact path is the
    # subtree root itself, so equality collides just as containment does.
    return exact["root"] == subtree["root"] or exact["root"].startswith(subtree["root"] + "/")  # subtree-root guard


UNRESOLVED_PROVENANCE = {"", "unknown", "none", "n/a"}
UNAVAILABLE_PREFIX = "unavailable:"


def provenance_key(value: str | None) -> str:
    """Fold a route or identity to its comparison form.

    Reviewer identity comparisons must not be fooled by presentation:
    `Developer` and `developer` identify the same worker. Model/provider
    provenance is recorded, but does not determine review eligibility.
    """
    return (value or "").strip().casefold()


def ascii_provenance(value: str | None, label: str) -> None:
    """Reject a non-ASCII identity or route value.

    Case and whitespace folding cannot see a homoglyph: `develοper` with a Greek
    omicron survives casefold as a different string, which is enough to pass the
    self-review check and to smuggle a look-alike `unknown` past the provenance
    guard. Confusable tables are not in the standard library, and these fields
    are machine names rather than prose, so the whole class is closed by
    refusing non-ASCII here.
    """
    if not (value or "").strip().isascii():  # ascii-provenance guard
        raise ValueError(f"{label} must be ASCII; a look-alike character is not a second identity: {value!r}")


def resolved_provenance(value: str | None) -> bool:
    """Routing provenance is evidence; `unknown` is the absence of it.

    A metric that genuinely does not exist — a deterministic script has no model
    route — is recorded as `unavailable: <reason>`. That is a statement someone
    made and can be argued with; `unknown` is a field nobody filled in. Refusing
    the second while accepting the first is what stops the guard from pushing
    callers into inventing a plausible route.
    """
    if not value:
        return False
    normalized = value.strip().lower()
    if normalized.startswith(UNAVAILABLE_PREFIX):
        return bool(normalized[len(UNAVAILABLE_PREFIX):].strip())
    return normalized not in UNRESOLVED_PROVENANCE


def canonical_owner(value: str) -> str:
    owner = value.strip()
    if not OWNER.fullmatch(owner):
        raise ValueError(f"invalid canonical owner: {value!r}")
    return owner


def owners_overlap(left: str, right: str) -> bool:
    return left == right or left.startswith(right + ".") or right.startswith(left + ".")


def boundary_touches_pattern(boundary: dict, pattern: str) -> bool:
    if boundary["kind"] == "exact":
        return matches(boundary["root"], [pattern])
    return matches(boundary["root"], [pattern]) or matches(boundary["root"] + "/.delivery-ledger-probe", [pattern])

def glob_regex(pattern: str) -> re.Pattern[str]:
    pattern = validate_pattern(pattern)
    out = ""
    i = 0
    while i < len(pattern):
        char = pattern[i]
        if char == "*":
            if i + 1 < len(pattern) and pattern[i + 1] == "*":
                i += 1
                if i + 1 < len(pattern) and pattern[i + 1] == "/":
                    i += 1; out += "(?:.*/)?"
                else:
                    out += ".*"
            else:
                out += "[^/]*"
        elif char == "?":
            out += "[^/]"
        else:
            out += re.escape(char)
        i += 1
    return re.compile(f"^{out}$")


def matches(path: str, patterns: list[str]) -> bool:
    return any(glob_regex(pattern).fullmatch(path) for pattern in patterns)


def risk_max(*values: str) -> str:
    return max(values, key=lambda value: RISK_ORDER[value])


def state(repo: Path) -> str | None:
    p = repo / "STATUS.md"
    if not p.is_file():
        return None
    m = re.search(r"(?im)^State:\s*([A-Z_]+)\s*$", p.read_text(encoding="utf-8", errors="replace"))
    return m.group(1) if m else None


def atomic_json(path: Path, data: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, sort_keys=True)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


@contextmanager
def ledger_lock(repo: Path):
    lock_path = repo / ".delivery" / "ledger.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def read_events(path: Path) -> list[dict]:
    events = []
    for lineno, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        if not raw.strip():
            continue
        try:
            event = json.loads(raw)
        except json.JSONDecodeError as exc:
            raise ValueError(f"{path.name}:{lineno}: invalid JSON: {exc}") from exc
        if not isinstance(event, dict):
            raise ValueError(f"{path.name}:{lineno}: event must be an object")
        events.append(event)
    return events


def append_event(path: Path, event: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    previous = None
    if path.is_file() and path.stat().st_size:
        existing = read_events(path)
        previous = existing[-1].get("eventHash") if existing else None
    event["prevEventHash"] = previous
    unsigned = dict(event)
    unsigned.pop("eventHash", None)
    event["eventHash"] = digest(unsigned)
    with path.open("a", encoding="utf-8") as f:
        f.write(canonical(event) + "\n")
        f.flush()
        os.fsync(f.fileno())


def verify_run(path: Path) -> list[str]:
    problems = []
    try:
        events = read_events(path)
    except ValueError as exc:
        return [str(exc)]
    expected_run = path.stem
    previous = None
    for index, event in enumerate(events, start=1):
        if event.get("runId") != expected_run:
            problems.append(f"{path.name}:{index}: runId mismatch")
        if event.get("prevEventHash") != previous:
            problems.append(f"{path.name}:{index}: broken previous-event hash")
        supplied = event.get("eventHash")
        unsigned = dict(event); unsigned.pop("eventHash", None)
        calculated = digest(unsigned)
        if supplied != calculated:
            problems.append(f"{path.name}:{index}: event hash mismatch")
        previous = supplied
    if not events:
        problems.append(f"{path.name}: empty run evidence")
        return problems
    starts = [index for index, event in enumerate(events) if event.get("type") == "run_started"]
    finishes = [index for index, event in enumerate(events) if event.get("type") == "run_finished"]
    if starts != [0]:
        problems.append(f"{path.name}: run must contain exactly one initial run_started event")
    if len(finishes) > 1 or (finishes and finishes[0] != len(events) - 1):
        problems.append(f"{path.name}: run_finished must occur once and be the final event")
    if finishes:
        finish = events[finishes[0]]
        checks = [event for event in events[:finishes[0]] if event.get("type") == "verification"]
        if finish.get("result") == "PASS":
            if not checks:
                problems.append(f"{path.name}: PASS requires at least one verification event")
            elif unresolved_failures(checks):
                problems.append(
                    f"{path.name}: PASS requires every check to end resolved: "
                    + "; ".join(unresolved_failures(checks)))
            start = events[0] if events else {}
            if start.get("boundary"):
                boundary_checks = [event for event in events[:finishes[0]] if event.get("type") == "boundary_check"]
                if not boundary_checks:
                    problems.append(f"{path.name}: bounded PASS requires boundary_check evidence")
                else:
                    latest = boundary_checks[-1]
                    bound = finish.get("boundary") or {}
                    if bound.get("boundaryCheckEventHash") != latest.get("eventHash") or bound.get("surfaceDigest") != latest.get("surfaceDigest"):
                        problems.append(f"{path.name}: finished boundary evidence does not bind the latest check")
                    if latest.get("result") == "FAIL":
                        problems.append(f"{path.name}: PASS cannot follow failed boundary check")
                    if latest.get("result") == "REVIEW_REQUIRED" and not any(event.get("type") == "boundary_review" and event.get("boundaryCheckEventHash") == latest.get("eventHash") and event.get("status") == "APPROVED" for event in events[:finishes[0]]):
                        problems.append(f"{path.name}: review-required boundary lacks approval")
    # Reviews recorded before the provenance contract existed carry no evidence
    # digest. They stay valid history: the chain still covers them, and `finish`
    # separately refuses a PASS unless some approval has an intact digest, so a
    # stripped digest cannot buy anything going forward.
    run_head = events[0]
    for index, event in enumerate(events, start=1):
        if event.get("type") != "boundary_review" or "reviewEvidenceDigest" not in event:
            continue
        if event.get("reviewEvidenceDigest") != review_evidence_digest(event):
            problems.append(f"{path.name}:{index}: boundary review evidence digest does not match its recorded fields")
        identity = ("reviewer", "reviewerModel", "reviewerProvider", "reviewerReasoningEffort")
        if any(not resolved_provenance(event.get(key)) for key in identity):
            problems.append(f"{path.name}:{index}: boundary review carries unknown reviewer provenance")
        if any(not str(event.get(key) or "").isascii() for key in identity):
            problems.append(f"{path.name}:{index}: boundary review carries a non-ASCII reviewer identity or route")
        if provenance_key(event.get("reviewer")) == provenance_key(run_head.get("worker")):
            problems.append(f"{path.name}:{index}: boundary review was performed by the implementer")
    return problems


def paths(repo: Path):
    root = repo / ".delivery"
    return root, root / "current.json", root / "runs", root / "releases"


def initial(repo: Path) -> dict:
    return {
        "schemaVersion": 1,
        "project": repo.name,
        "statusAuthority": "STATUS.md",
        "activeRun": None,
        "observedState": state(repo),
        "observedHead": git(repo, "rev-parse", "HEAD"),
        "updatedAt": now(),
    }


def load_current(repo: Path) -> dict:
    _, current, _, _ = paths(repo)
    if not current.is_file():
        raise FileNotFoundError(".delivery/current.json missing; run delivery-ledger init")
    data = json.loads(current.read_text(encoding="utf-8"))
    if data.get("schemaVersion") != 1 or data.get("statusAuthority") != "STATUS.md":
        raise ValueError("unsupported or invalid delivery ledger schema")
    return data


def save_current(repo: Path, data: dict) -> None:
    _, current, _, _ = paths(repo)
    data["observedState"] = state(repo)
    data["observedHead"] = git(repo, "rev-parse", "HEAD")
    data["updatedAt"] = now()
    atomic_json(current, data)


def event_base(repo: Path, kind: str, run_id: str | None) -> dict:
    return {
        "eventId": uuid4().hex,
        "time": now(),
        "type": kind,
        "runId": run_id,
        "state": state(repo),
        "head": git(repo, "rev-parse", "HEAD"),
    }


def require_id(value: str, label: str) -> None:
    if not SAFE_ID.fullmatch(value):
        raise ValueError(f"invalid {label}: use letters, numbers, dot, underscore, or dash")


def cmd_init(repo: Path) -> int:
    root, current, runs, releases = paths(repo)
    root.mkdir(exist_ok=True); runs.mkdir(exist_ok=True); releases.mkdir(exist_ok=True)
    ignore = root / ".gitignore"
    if not ignore.exists():
        try:
            with ignore.open("x", encoding="utf-8") as stream:
                stream.write("ledger.lock\n")
        except FileExistsError:
            pass
    if not current.exists():
        atomic_json(current, initial(repo))
    print(f"delivery-ledger: READY ({current})")
    return OK


def active(repo: Path) -> tuple[dict, str, Path]:
    data = load_current(repo)
    run_id = data.get("activeRun")
    if not run_id:
        raise ValueError("no active run")
    _, _, runs, _ = paths(repo)
    run_path = runs / f"{run_id}.jsonl"
    if not run_path.is_file():
        raise ValueError(f"active run evidence missing: {run_path.name}")
    return data, run_id, run_path


def cmd_start(repo: Path, a) -> int:
    data = load_current(repo)
    if data.get("activeRun"):
        raise ValueError(f"run already active: {data['activeRun']}")
    if a.risk not in RISK:
        raise ValueError("risk must be R0-R4")
    require_id(a.task, "task"); require_id(a.requirement, "requirement")
    allowed = [validate_pattern(pattern) for pattern in a.allow]
    owners = sorted(set(canonical_owner(value) for value in a.owner if value.strip()))
    protected = [validate_pattern(pattern) for pattern in a.protect]
    accepted_dirty_patterns = [validate_pattern(pattern) for pattern in a.accept_dirty]
    if a.protected_risk not in RISK:
        raise ValueError("protected risk must be R0-R4")
    if a.risk != "R0" and not allowed:
        raise ValueError("R1-R4 runs require at least one --allow change-surface pattern")
    for label, value in (("worker", a.worker), ("model", a.model), ("provider", a.provider), ("reasoningEffort", a.reasoning_effort)):
        ascii_provenance(value, label)
    if a.risk != "R0":  # routing-provenance guard
        unresolved = [
            label for label, value in (("model", a.model), ("provider", a.provider), ("reasoningEffort", a.reasoning_effort))
            if not resolved_provenance(value)
        ]
        if unresolved:
            raise ValueError(
                "R1-R4 runs require resolved routing provenance; record the real route or stop: "
                + ", ".join(f"{label}=unknown" for label in unresolved)
            )
    baseline = snapshot_dirty(repo)
    overlaps = [entry["path"] for entry in baseline if matches(entry["path"], allowed)]
    unaccepted = [path for path in overlaps if not matches(path, accepted_dirty_patterns)]
    if unaccepted:
        raise ValueError("allowed surface overlaps pre-existing dirty work; review it or repeat --accept-dirty for: " + ", ".join(unaccepted))
    boundary = None
    if allowed:
        boundary = {
            "schemaVersion": 1,
            "baseHead": base_head(repo),
            "preexistingDirty": baseline,
            "allowedPaths": allowed,
            "protectedPaths": [{"pattern": pattern, "minimumRisk": a.protected_risk} for pattern in protected],
            "acceptedDirtyPaths": sorted(overlaps),
            "declaredRisk": a.risk,
        }
    run_id = datetime.now(timezone.utc).strftime("RUN-%Y%m%dT%H%M%SZ-") + uuid4().hex[:8]
    _, _, runs, _ = paths(repo)
    event = event_base(repo, "run_started", run_id)
    event.update({"task": a.task, "requirement": a.requirement, "risk": a.risk, "job": a.job, "capability": a.capability, "worker": a.worker, "model": a.model, "provider": a.provider, "reasoningEffort": a.reasoning_effort, "owners": owners, "boundary": boundary})
    append_event(runs / f"{run_id}.jsonl", event)
    data.update({"activeRun": run_id, "activeTask": a.task, "requirement": a.requirement, "risk": a.risk, "job": a.job, "capability": a.capability, "worker": a.worker, "model": a.model, "provider": a.provider, "reasoningEffort": a.reasoning_effort})
    save_current(repo, data)
    print(f"delivery-ledger: STARTED {run_id}")
    return OK


def cmd_record(repo: Path, a) -> int:
    data, run_id, run_path = active(repo)
    executed = None
    if a.command:
        # Executed evidence. `--status` is refused here because the command
        # decides: an agent that may both run the check and name its result can
        # skip the first half, and this ledger has already accepted a PASS
        # detailed "pending run below" — recorded before the check ran, by the
        # session building these very gates. Freshness catches stale evidence;
        # nothing caught invented evidence, because nothing could.
        if a.status:
            raise ValueError("--status cannot accompany --command; the command's exit code is the status")
        result = subprocess.run(a.command, shell=True, cwd=repo, text=True,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        status = "PASS" if result.returncode == 0 else "FAIL"
        tail = [line for line in result.stdout.splitlines() if line.strip()][-1:] or [""]
        executed = {"command": a.command, "exitCode": result.returncode,
                    "outputTail": tail[0][:400]}
        a.detail = a.detail or f"{tail[0][:200]} (exit {result.returncode})"
    else:
        if not a.status:
            raise ValueError("record needs --status, or --command to derive one")
        status = a.status
    if status not in CHECK_STATUS:
        raise ValueError("check status must be PASS, FAIL, or UNVERIFIED")
    e = event_base(repo, "verification", run_id)
    checked_paths = dirty_paths(repo)
    e.update({"check": a.check, "status": status, "detail": a.detail,
              "executed": executed,
              "checkedPaths": checked_paths,
              "checkedDigest": surface_of(repo, checked_paths)})
    append_event(run_path, e); save_current(repo, data)
    print(f"delivery-ledger: RECORDED {a.check}={status}" + (f" (ran: exit {executed['exitCode']})" if executed else ""))
    return OK


def cmd_checkpoint(repo: Path, a) -> int:
    data = load_current(repo); run_id = data.get("activeRun")
    e = event_base(repo, "checkpoint", run_id); e["note"] = a.note
    if run_id:
        _, _, runs, _ = paths(repo); append_event(runs / f"{run_id}.jsonl", e)
    data["lastCheckpoint"] = e
    save_current(repo, data)
    print("delivery-ledger: CHECKPOINTED")
    return OK


def run_start(events: list[dict]) -> dict:
    starts = [event for event in events if event.get("type") == "run_started"]
    if len(starts) != 1:
        raise ValueError("run boundary requires exactly one run_started event")
    return starts[0]


def unresolved_failures(checks):
    """Check names whose LATEST record is not a resolution of an earlier failure.

    Owner decision, 2026-09-01: a check that failed, was fixed, and passed again
    no longer blocks PASS. The old rule refused any run containing a FAIL at all,
    which three times in one day rejected finished work whose only failure was
    TASKS.md crossing its size budget before being archived. Worse, it taught the
    obvious lesson to any agent under it: do not record a failure you intend to
    fix. An append-only evidence log exists to make failures cheap to record.

    What still blocks, deliberately:
      - a check that failed and was never re-run;
      - a check whose latest record is still FAIL;
      - an UNVERIFIED check not explicitly marked pre-existing.
    Freshness is enforced separately and unchanged: the passing evidence must
    still describe the surface being shipped, so a re-run against different code
    does not launder an earlier failure.
    """
    latest, ever_failed = {}, set()
    for check in checks:
        name = check.get("check")
        status = check.get("status")
        if status == "FAIL":
            ever_failed.add(name)
        latest[name] = check
    blocking = []
    for name, check in latest.items():
        status = check.get("status")
        if status == "FAIL":
            blocking.append(f"{name} last recorded FAIL")
        elif status == "UNVERIFIED" and not check.get("detail", "").lower().startswith("pre-existing"):
            blocking.append(f"{name} is UNVERIFIED and not marked pre-existing")
    return blocking


def child_runs(events: list[dict]) -> dict[str, dict]:
    """Derive child state from the parent's immutable event stream."""
    children: dict[str, dict] = {}
    for event in events:
        child = event.get("child")
        if event.get("type") == "child_started":
            if child in children:
                raise ValueError(f"duplicate child run: {child}")
            children[child] = {"start": event, "checks": [], "finish": None, "integration": None}
        elif child in children and event.get("type") == "child_verification":
            children[child]["checks"].append(event)
        elif child in children and event.get("type") == "child_finished":
            children[child]["finish"] = event
        elif child in children and event.get("type") == "child_integrated":
            children[child]["integration"] = event
    return children


def patch_paths(repo: Path, patch: Path) -> list[str]:
    """Ask Git for patch paths through an isolated temporary index."""
    fd, index_name = tempfile.mkstemp(prefix="delivery-patch-index.")
    os.close(fd); os.unlink(index_name)
    environment = os.environ.copy(); environment["GIT_INDEX_FILE"] = index_name
    try:
        for command in (["git", "read-tree", "HEAD"], ["git", "apply", "--cached", str(patch)]):
            result = subprocess.run(command, cwd=repo, env=environment, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
            if result.returncode != 0:
                raise ValueError(result.stderr.decode(errors="replace").strip() or "patch cannot be inspected against base HEAD")
        changed = subprocess.run(
            ["git", "diff", "--cached", "--name-status", "-z", "--no-ext-diff", "--no-textconv", "HEAD"],
            cwd=repo, env=environment, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
        )
        if changed.returncode != 0:
            raise ValueError(changed.stderr.decode(errors="replace").strip() or "could not inspect patch paths")
        paths = sorted(validate_pattern(path) for path in name_status_paths(changed.stdout))
        if not paths:
            raise ValueError("patch contains no Git changes")
        return paths
    finally:
        for suffix in ("", ".lock"):
            try:
                os.unlink(index_name + suffix)
            except FileNotFoundError:
                pass

def cmd_claim_owner(repo: Path, a) -> int:
    owners = sorted(set(canonical_owner(value) for value in a.owner if value.strip()))
    if not owners:
        raise ValueError("parent owner claim requires --owner")
    data, run_id, run_path = active(repo)
    children = child_runs(read_events(run_path))
    active_owners = [
        owner for child in children.values() if child["integration"] is None
        for owner in child["start"]["owners"]
    ]
    for owner in owners:
        if any(owners_overlap(owner, child_owner) for child_owner in active_owners):
            raise ValueError(f"semantic owner overlap with active child: {owner}")
    event = event_base(repo, "parent_owner_claimed", run_id)
    event["owners"] = owners
    append_event(run_path, event); save_current(repo, data)
    print("delivery-ledger: PARENT OWNER CLAIMED")
    return OK


def cmd_start_child(repo: Path, a) -> int:
    require_id(a.child, "child id"); require_id(a.task, "task")
    if a.risk not in RISK:
        raise ValueError("risk must be R0-R4")
    for label, value in (("model", a.model), ("provider", a.provider), ("reasoningEffort", a.reasoning_effort)):
        ascii_provenance(value, label)
    if a.risk != "R0":  # child-routing-provenance guard
        unresolved = [
            label for label, value in (("model", a.model), ("provider", a.provider), ("reasoningEffort", a.reasoning_effort))
            if not resolved_provenance(value)
        ]
        if unresolved:
            raise ValueError(
                "R1-R4 child runs require resolved routing provenance; record the real route or stop: "
                + ", ".join(f"{label}=unknown" for label in unresolved)
            )
    boundaries = [child_boundary(value) for value in a.allow]
    if not boundaries:
        raise ValueError("child run requires at least one --allow boundary")
    owners = sorted(set(canonical_owner(value) for value in a.owner if value.strip()))
    invariants = sorted(set(value.strip() for value in a.invariant if value.strip()))
    if not owners or not invariants:
        raise ValueError("child run requires --owner and --invariant evidence")
    data, run_id, run_path = active(repo)
    events = read_events(run_path)
    children = child_runs(events)
    if a.child in children:
        raise ValueError(f"child already exists: {a.child}")
    dependencies = sorted(set(a.depends_on))
    for dependency in dependencies:
        require_id(dependency, "child dependency")
        item = children.get(dependency)
        if not item:
            raise ValueError(f"unknown child dependency: {dependency}")
        if not item["finish"] or item["finish"]["result"] != "PASS" or item["integration"] is None:
            raise ValueError(f"child dependency is not successfully integrated: {dependency}")
    parent_owners = list(run_start(events).get("owners") or [])
    parent_owners.extend(
        owner for event in events if event.get("type") == "parent_owner_claimed"
        for owner in event.get("owners", [])
    )
    for owner in owners:
        if any(owners_overlap(owner, parent_owner) for parent_owner in parent_owners):
            raise ValueError(f"semantic owner overlap with parent: {owner}")
    for child, child_state in children.items():
        if child_state["integration"] is not None:
            continue
        for boundary in boundaries:
            if any(child_boundaries_overlap(boundary, prior) for prior in child_state["start"]["boundaries"]):
                raise ValueError(f"path boundary overlap with active child {child}: {boundary['pattern']}")
        for owner in owners:
            if any(owners_overlap(owner, prior) for prior in child_state["start"]["owners"]):
                raise ValueError(f"semantic owner overlap with active child {child}: {owner}")
    for boundary in boundaries:
        parent_overlap = [
            path for path in dirty_paths(repo)
            if (boundary["kind"] == "exact" and path == boundary["root"])
            or (boundary["kind"] == "subtree" and path.startswith(boundary["root"] + "/"))
        ]
        if parent_overlap:
            raise ValueError("child boundary overlaps current parent work: " + ", ".join(parent_overlap))
    parent_boundary = run_start(events).get("boundary") or {}
    for rule in parent_boundary.get("protectedPaths", []):
        if any(boundary_touches_pattern(boundary, rule["pattern"]) for boundary in boundaries) and RISK_ORDER[a.risk] < RISK_ORDER[rule["minimumRisk"]]:
            raise ValueError(f"child risk {a.risk} is insufficient for protected boundary {rule['pattern']}")
    event = event_base(repo, "child_started", run_id)
    event.update({"child": a.child, "task": a.task, "risk": a.risk, "model": a.model, "provider": a.provider, "reasoningEffort": a.reasoning_effort, "allowedPaths": [boundary["pattern"] for boundary in boundaries], "boundaries": boundaries, "owners": owners, "dependencies": dependencies, "acceptedInvariants": invariants})
    append_event(run_path, event); save_current(repo, data)
    print(f"delivery-ledger: CHILD STARTED {a.child}")
    return OK


def cmd_record_child(repo: Path, a) -> int:
    require_id(a.child, "child id"); require_id(a.check, "check")
    if a.status not in CHECK_STATUS:
        raise ValueError("check status must be PASS, FAIL, or UNVERIFIED")
    data, run_id, run_path = active(repo)
    children = child_runs(read_events(run_path))
    if a.child not in children or children[a.child]["finish"] is not None:
        raise ValueError("child is missing or already finished")
    event = event_base(repo, "child_verification", run_id)
    event.update({"child": a.child, "check": a.check, "status": a.status, "detail": a.detail})
    append_event(run_path, event); save_current(repo, data)
    print(f"delivery-ledger: CHILD RECORDED {a.child} {a.check}={a.status}")
    return OK


def cmd_finish_child(repo: Path, a) -> int:
    require_id(a.child, "child id")
    if a.result not in RUN_RESULT:
        raise ValueError("result must be PASS, FAIL, or BLOCKED")
    data, run_id, run_path = active(repo)
    children = child_runs(read_events(run_path)); child = children.get(a.child)
    if not child or child["finish"] is not None:
        raise ValueError("child is missing or already finished")
    event = event_base(repo, "child_finished", run_id)
    event.update({"child": a.child, "result": a.result, "detail": a.detail})
    if a.result == "PASS":
        if not child["checks"] or any(check["status"] != "PASS" for check in child["checks"]):
            raise ValueError("child PASS requires only passing verification evidence")
        patch = Path(a.patch).expanduser().resolve() if a.patch else None
        if not patch or not patch.is_file():
            raise ValueError("child PASS requires --patch")
        paths = patch_paths(repo, patch)
        unexplained = [path for path in paths if not matches(path, child["start"]["allowedPaths"])]
        if unexplained:
            raise ValueError("child patch escapes its boundary: " + ", ".join(unexplained))
        event.update({"patchSha256": hashlib.sha256(patch.read_bytes()).hexdigest(), "patchPaths": paths})
    append_event(run_path, event); save_current(repo, data)
    print(f"delivery-ledger: CHILD FINISHED {a.child} result={a.result}")
    return OK


def cmd_integrate_child(repo: Path, a) -> int:
    require_id(a.child, "child id")
    data, run_id, run_path = active(repo)
    events = read_events(run_path); children = child_runs(events); child = children.get(a.child)
    if not child or not child["finish"] or child["finish"]["result"] != "PASS":
        raise ValueError("only a successfully finished child can be integrated")
    if child["integration"] is not None:
        raise ValueError("child is already integrated")
    unfinished = sorted(name for name, item in children.items() if item["finish"] is None)
    if unfinished:
        raise ValueError("all parallel children must finish before parent integration: " + ", ".join(unfinished))
    patch = Path(a.patch).expanduser().resolve()
    if not patch.is_file() or hashlib.sha256(patch.read_bytes()).hexdigest() != child["finish"].get("patchSha256"):
        raise ValueError("patch is missing or differs from finished child evidence")
    if patch_paths(repo, patch) != child["finish"].get("patchPaths"):
        raise ValueError("patch path evidence changed")
    integrated_paths = {path for item in children.values() if item["integration"] for path in item["integration"]["patchPaths"]}
    overlap = sorted(integrated_paths & set(child["finish"]["patchPaths"]))
    if overlap:
        raise ValueError("child patch overlaps an already integrated patch: " + ", ".join(overlap))
    dirty_overlap = sorted(set(dirty_paths(repo)) & set(child["finish"]["patchPaths"]))
    if dirty_overlap:
        raise ValueError("child patch would overlap current parent work: " + ", ".join(dirty_overlap))
    check = subprocess.run(["git", "apply", "--check", str(patch)], cwd=repo, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    if check.returncode != 0:
        raise ValueError("child patch does not apply cleanly: " + check.stderr.strip())
    applied = subprocess.run(["git", "apply", str(patch)], cwd=repo, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    if applied.returncode != 0:
        raise ValueError("child patch integration failed: " + applied.stderr.strip())
    event = event_base(repo, "child_integrated", run_id)
    event.update({"child": a.child, "patchSha256": child["finish"]["patchSha256"], "patchPaths": child["finish"]["patchPaths"]})
    append_event(run_path, event); save_current(repo, data)
    print(f"delivery-ledger: CHILD INTEGRATED {a.child}")
    return OK


def task_path_risk(repo: Path, paths: list[str]) -> dict:
    if not paths:
        return {"risk": "R0", "flaggedReasons": [], "files": [], "classificationMode": "explicit-paths"}
    command = [sys.executable, str(Path(__file__).with_name("diff-risk")), "--json"]
    for path in paths:
        command.append(f"--path={path}")
    command.append(str(repo))
    result = subprocess.run(command, cwd=repo, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
    if result.returncode != 0:
        raise ValueError(result.stderr.strip() or "diff-risk failed for task-owned paths")
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise ValueError("diff-risk returned invalid JSON") from exc


def expansion_for(path: str, expansions: list[dict]) -> dict | None:
    for event in reversed(expansions):
        if matches(path, [event["path"]]):
            return event
    return None


def evaluate_boundary(repo: Path, events: list[dict]) -> dict:
    start = run_start(events)
    boundary = start.get("boundary")
    if not boundary:
        raise ValueError("active run has no task change boundary")
    current_head = base_head(repo)
    current_entries = snapshot_dirty(repo)
    current = {entry["path"]: entry["fingerprint"] for entry in current_entries}
    baseline_entries = boundary.get("preexistingDirty")
    if not isinstance(baseline_entries, list):
        raise ValueError("invalid boundary baseline")
    baseline = {entry["path"]: entry["fingerprint"] for entry in baseline_entries}
    allowed = boundary.get("allowedPaths") or []
    protected_rules = boundary.get("protectedPaths") or []
    accepted_dirty = set(boundary.get("acceptedDirtyPaths") or [])
    expansions = [event for event in events if event.get("type") == "scope_expansion"]
    verifications = [event for event in events if event.get("type") == "verification"]
    checks_by_name: dict[str, list[str]] = {}
    for event in verifications:
        checks_by_name.setdefault(str(event.get("check")), []).append(str(event.get("status")))

    changes = []
    preexisting_unchanged = []
    touched_preexisting = []
    unknown = []
    protected = []
    out_of_scope = []
    for path in sorted(set(current) | set(baseline)):
        before = baseline.get(path)
        after = current[path] if path in current else fingerprint(repo, path)
        if path in baseline and before == after:
            preexisting_unchanged.append(path)
            continue
        is_preexisting = path in baseline
        is_allowed = matches(path, allowed)
        matching_protected = [rule for rule in protected_rules if matches(path, [rule["pattern"]])]
        is_unknown = after.get("kind") == "unknown"
        classification = "PREEXISTING" if is_preexisting else "UNKNOWN" if is_unknown else "PROTECTED" if matching_protected else "ALLOWED" if is_allowed else "OUT_OF_SCOPE"
        entry = {"path": path, "classification": classification, "before": before, "after": after}
        changes.append(entry)
        if is_preexisting:
            touched_preexisting.append(path)
        if is_unknown:
            unknown.append(path)
        if matching_protected:
            protected.append(path)
        if not is_allowed:
            out_of_scope.append(path)

    task_paths = [entry["path"] for entry in changes]
    risk_data = task_path_risk(repo, task_paths)
    protected_risk = "R0"
    for path in protected:
        for rule in protected_rules:
            if matches(path, [rule["pattern"]]):
                protected_risk = risk_max(protected_risk, rule["minimumRisk"])
    effective_risk = risk_max(boundary["declaredRisk"], risk_data["risk"], protected_risk)

    unexplained = []
    used_expansions = []
    missing_verification = []
    for path in out_of_scope:
        expansion = expansion_for(path, expansions)
        if not expansion:
            unexplained.append(path)
            continue
        used_expansions.append(expansion)
        effective_risk = risk_max(effective_risk, expansion["risk"])
        for check in expansion["verification"]:
            statuses = checks_by_name.get(check, [])
            if not statuses or any(status != "PASS" for status in statuses):
                missing_verification.append({"path": path, "check": check})

    head_moved = current_head != boundary.get("baseHead")
    unaccepted_touched = [path for path in touched_preexisting if path not in accepted_dirty]
    review_reasons = []
    if used_expansions:
        review_reasons.append("accepted scope expansion")
    if protected:
        review_reasons.append("protected surface touched")
    if touched_preexisting:
        review_reasons.append("accepted pre-existing dirty path changed")
    if RISK_ORDER[effective_risk] >= RISK_ORDER["R3"]:
        review_reasons.append("effective risk requires independent review")
    if RISK_ORDER[effective_risk] > RISK_ORDER[boundary["declaredRisk"]]:
        review_reasons.append("risk escalated above declared floor")

    failures = []
    if head_moved:
        failures.append("repository HEAD moved after baseline capture")
    if unknown:
        failures.append("unknown filesystem object changed")
    if unaccepted_touched:
        failures.append("pre-existing user work changed without accepted overlap")
    if unexplained:  # unexplained-scope guard
        failures.append("unexplained out-of-scope changes")
    if missing_verification:
        failures.append("scope expansion lacks required passing verification")
    result = "FAIL" if failures else "REVIEW_REQUIRED" if review_reasons else "PASS"
    surface = {
        "head": current_head,
        "currentDirty": current_entries,
        "taskOwnedChanges": changes,
    }
    return {
        "result": result,
        "baseHead": boundary.get("baseHead"),
        "currentHead": current_head,
        "preexistingDirty": sorted(baseline),
        "preexistingUnchanged": preexisting_unchanged,
        "taskOwnedChanges": changes,
        "outOfScope": out_of_scope,
        "unexplainedOutOfScope": unexplained,
        "protected": protected,
        "touchedPreexisting": touched_preexisting,
        "unknown": unknown,
        "acceptedExpansions": sorted({event["path"] for event in used_expansions}),
        "missingVerification": missing_verification,
        "declaredRisk": boundary["declaredRisk"],
        "diffRisk": risk_data["risk"],
        "protectedRisk": protected_risk,
        "effectiveRisk": effective_risk,
        "riskFindings": risk_data.get("flaggedReasons", []),
        "reviewReasons": sorted(set(review_reasons)),
        "failures": failures,
        "surfaceDigest": digest(surface),
    }


def cmd_expand_scope(repo: Path, a) -> int:
    data, run_id, run_path = active(repo)
    start = run_start(read_events(run_path))
    path = validate_pattern(a.path)
    reason = " ".join(a.reason.lower().split())
    if len(reason) < 12 or reason in GENERIC_EXPANSION_REASONS:
        raise ValueError("scope expansion reason must name the requirement dependency, not cleanup/refactor prose")
    if not a.required_by.strip():
        raise ValueError("scope expansion requires --required-by")
    if not any(identifier and identifier in a.required_by for identifier in (start.get("task"), start.get("requirement"))):
        raise ValueError("--required-by must name the active task or requirement")
    if a.risk not in RISK:
        raise ValueError("scope expansion risk must be R0-R4")
    if not a.verification:
        raise ValueError("scope expansion requires at least one --verification check name")
    for check in a.verification:
        require_id(check, "verification check")
    event = event_base(repo, "scope_expansion", run_id)
    event.update({"path": path, "reason": a.reason.strip(), "requiredBy": a.required_by.strip(), "risk": a.risk, "verification": sorted(set(a.verification))})
    append_event(run_path, event); save_current(repo, data)
    print(f"delivery-ledger: SCOPE EXPANDED {path}")
    return OK


def cmd_check_boundary(repo: Path, as_json: bool) -> int:
    data, run_id, run_path = active(repo)
    report = evaluate_boundary(repo, read_events(run_path))
    event = event_base(repo, "boundary_check", run_id)
    event.update(report)
    append_event(run_path, event); save_current(repo, data)
    if as_json:
        print(json.dumps(report, indent=2))
    else:
        print(f"delivery-ledger: BOUNDARY {report['result']} effectiveRisk={report['effectiveRisk']}")
        for failure in report["failures"]:
            print(f"  - {failure}")
        for reason in report["reviewReasons"]:
            print(f"  - review: {reason}")
    return FAILED if report["result"] == "FAIL" else UNVERIFIED if report["result"] == "REVIEW_REQUIRED" else OK


REVIEW_EVIDENCE_KEYS = (
    "boundaryCheckEventHash", "surfaceDigest", "effectiveRisk",
    "reviewer", "reviewerModel", "reviewerProvider", "reviewerReasoningEffort",
    "implementerWorker", "implementerModel", "implementerProvider",
)


def review_evidence_digest(event: dict) -> str:
    return digest({key: event.get(key) for key in REVIEW_EVIDENCE_KEYS})


def cmd_review_boundary(repo: Path, a) -> int:
    require_id(a.reviewer, "reviewer")
    data, run_id, run_path = active(repo)
    events = read_events(run_path)
    start = run_start(events)
    reviewer = {
        "reviewer": a.reviewer,
        "reviewerModel": a.reviewer_model,
        "reviewerProvider": a.reviewer_provider,
        "reviewerReasoningEffort": a.reviewer_reasoning,
    }
    for label, value in reviewer.items():
        ascii_provenance(value, label)
    unresolved = sorted(label for label, value in reviewer.items() if not resolved_provenance(value))
    if unresolved:
        raise ValueError(
            "independent review requires resolved reviewer provenance; unknown: " + ", ".join(unresolved)
        )
    if provenance_key(a.reviewer) == provenance_key(start.get("worker")):  # review-independence guard
        raise ValueError("boundary reviewer must be independent from the worker")
    checks = [event for event in events if event.get("type") == "boundary_check"]
    if not checks or checks[-1].get("result") != "REVIEW_REQUIRED":
        raise ValueError("latest boundary check is not REVIEW_REQUIRED")
    current = evaluate_boundary(repo, events)
    latest = checks[-1]
    if current["result"] != "REVIEW_REQUIRED" or current["surfaceDigest"] != latest.get("surfaceDigest"):
        raise ValueError("change surface moved after boundary check; run check-boundary again")
    # Model/provider are provenance, not eligibility. The caller must obtain
    # review from a separate actual agent; a renamed self-review is not valid.
    event = event_base(repo, "boundary_review", run_id)
    event.update(reviewer)
    event.update({
        "boundaryCheckEventHash": latest["eventHash"],
        "surfaceDigest": current["surfaceDigest"],
        "effectiveRisk": current["effectiveRisk"],
        "implementerWorker": start.get("worker"),
        "implementerModel": start.get("model"),
        "implementerProvider": start.get("provider"),
        "status": "APPROVED",
    })
    event["reviewEvidenceDigest"] = review_evidence_digest(event)
    append_event(run_path, event); save_current(repo, data)
    print(f"delivery-ledger: BOUNDARY APPROVED reviewer={a.reviewer}")
    return OK


def cmd_finish(repo: Path, a) -> int:
    if a.result not in RUN_RESULT:
        raise ValueError("result must be PASS, FAIL, or BLOCKED")
    data, run_id, run_path = active(repo)
    events = read_events(run_path)
    checks = [event for event in events if event.get("type") == "verification"]
    boundary_evidence = None
    if a.result == "PASS":
        children = child_runs(events)
        incomplete = sorted(name for name, child in children.items() if child["finish"] is None or child["finish"].get("result") != "PASS" or child["integration"] is None)
        if incomplete:
            raise ValueError("PASS requires every child to finish successfully and be integrated: " + ", ".join(incomplete))
        if not checks:
            raise ValueError("PASS requires at least one verification event")
        blocking_checks = unresolved_failures(checks)
        if blocking_checks:
            raise ValueError(
                "PASS requires every check to end resolved: " + "; ".join(blocking_checks))
        # Evidence must describe the code being shipped. A suite that passed
        # before the last three edits proves nothing about what is on disk now —
        # and nothing here noticed, because `head` does not move while an agent
        # works uncommitted. The boundary check has been guarded this way all
        # along ("change surface moved after boundary check"); its verification
        # evidence was not.
        #
        # Not every check must match: work legitimately interleaves editing and
        # testing. At least one PASS must have been produced against the final
        # surface, which is what "the suite was green when I stopped" means.
        dated = [check for check in checks if check.get("checkedDigest") is not None]
        if dated and not any(
            check.get("status") == "PASS"
            and check.get("checkedDigest") == surface_of(repo, check.get("checkedPaths") or [])
            for check in dated
        ):
            raise ValueError("every passing verification is stale: the files it ran against changed afterwards, so re-run a check before PASS")
        start = run_start(events)
        if start.get("boundary"):
            report = evaluate_boundary(repo, events)
            boundary_checks = [event for event in events if event.get("type") == "boundary_check"]
            if not boundary_checks:
                raise ValueError("PASS requires a final check-boundary event")
            latest = boundary_checks[-1]
            if latest.get("surfaceDigest") != report["surfaceDigest"] or latest.get("result") != report["result"]:
                raise ValueError("change surface moved after boundary check")
            if report["result"] == "FAIL":
                raise ValueError("PASS denied by task change boundary")
            if report["result"] == "REVIEW_REQUIRED":
                reviews = [event for event in events if event.get("type") == "boundary_review" and event.get("boundaryCheckEventHash") == latest.get("eventHash") and event.get("status") == "APPROVED"]
                if not reviews:
                    raise ValueError("PASS requires approved boundary review")
                if not any(event.get("reviewEvidenceDigest") == review_evidence_digest(event) for event in reviews):
                    raise ValueError("PASS requires approved boundary review with intact reviewer evidence")
            boundary_evidence = {"result": report["result"], "effectiveRisk": report["effectiveRisk"], "surfaceDigest": report["surfaceDigest"], "boundaryCheckEventHash": latest.get("eventHash")}
    e = event_base(repo, "run_finished", run_id); e.update({"result": a.result, "detail": a.detail, "boundary": boundary_evidence})
    append_event(run_path, e)
    data["lastRun"] = {"runId": run_id, "result": a.result, "finishedAt": e["time"]}
    for key in ("activeRun", "activeTask", "requirement", "risk", "job", "capability", "worker", "model", "provider", "reasoningEffort"):
        data.pop(key, None)
    data["activeRun"] = None
    save_current(repo, data)
    print(f"delivery-ledger: FINISHED {run_id} result={a.result}")
    return OK


def release_fields(repo: Path) -> dict:
    p = repo / "RELEASE.md"
    if not p.is_file():
        raise ValueError("RELEASE.md missing")
    text = p.read_text(encoding="utf-8", errors="replace")
    fields = {}
    for name in ("Release-ID", "Base", "Environment", "Declared-Risk", "Rollback-Ref", "Rollback-Command", "Backup-Proof", "Status"):
        m = re.search(rf"(?im)^{re.escape(name)}:\s*(.+?)\s*$", text)
        fields[name] = m.group(1).strip() if m else None
    return fields


def cmd_snapshot(repo: Path, a) -> int:
    require_id(a.release_id, "release id")
    data = load_current(repo)
    fields = release_fields(repo)
    if fields.get("Release-ID") != a.release_id:
        raise ValueError(f"release id mismatch: RELEASE.md has {fields.get('Release-ID')!r}")
    _, _, _, releases = paths(repo)
    target = releases / f"{a.release_id}.json"
    if target.exists():
        raise ValueError("release snapshot already exists; snapshots are immutable")
    snapshot = {
        "schemaVersion": 1,
        "releaseId": a.release_id,
        "capturedAt": now(),
        "head": git(repo, "rev-parse", "HEAD"),
        "state": state(repo),
        "release": fields,
        "ledger": data,
    }
    snapshot["snapshotHash"] = digest(snapshot)
    atomic_json(target, snapshot)
    print(f"delivery-ledger: SNAPSHOT {target}")
    return OK


def head_relation(repo: Path, observed: str | None, actual: str | None) -> str:
    if not observed or not actual:
        return "unknown"
    if observed == actual:
        return "same"
    r = git_result(repo, "merge-base", "--is-ancestor", observed, actual)
    if r.returncode == 0:
        return "descendant"
    if r.returncode == 1:
        return "diverged"
    return "unknown"


def verify_snapshot(path: Path) -> list[str]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return [f"{path.name}: invalid snapshot: {exc}"]
    supplied = data.get("snapshotHash")
    unsigned = dict(data); unsigned.pop("snapshotHash", None)
    if supplied != digest(unsigned):
        return [f"{path.name}: snapshot hash mismatch"]
    if data.get("releaseId") != path.stem:
        return [f"{path.name}: releaseId mismatch"]
    return []


def inspect(repo: Path) -> tuple[dict | None, list[str]]:
    problems = []
    try:
        data = load_current(repo)
    except Exception as exc:
        return None, [str(exc)]
    actual_state, actual_head = state(repo), git(repo, "rev-parse", "HEAD")
    if data.get("observedState") != actual_state:
        problems.append(f"state drift: ledger={data.get('observedState')} STATUS.md={actual_state}")
    relation = head_relation(repo, data.get("observedHead"), actual_head)
    if relation == "diverged":
        problems.append(f"history drift: observed HEAD {data.get('observedHead')} is not an ancestor of {actual_head}")
    elif relation == "unknown" and data.get("observedHead") != actual_head:
        problems.append("HEAD relationship could not be verified")
    _, _, runs, releases = paths(repo)
    if runs.is_dir():
        for path in sorted(runs.glob("RUN-*.jsonl")):
            problems.extend(verify_run(path))
    run_id = data.get("activeRun")
    if run_id and not (runs / f"{run_id}.jsonl").is_file():
        problems.append(f"active run evidence missing: {run_id}")
    if releases.is_dir():
        for path in sorted(releases.glob("*.json")):
            problems.extend(verify_snapshot(path))
    return data, problems


def cmd_status(repo: Path, as_json: bool, verify: bool) -> int:
    data, problems = inspect(repo)
    payload = {"result": "VERIFIED" if not problems else "DRIFT", "current": data, "problems": problems}
    if as_json:
        print(json.dumps(payload, indent=2))
    else:
        print(f"delivery-ledger: {payload['result']}")
        if data:
            print(f"  activeRun={data.get('activeRun')}")
            print(f"  state={data.get('observedState')}")
            print(f"  observedHead={data.get('observedHead')}")
        for problem in problems:
            print(f"  - {problem}")
    return UNVERIFIED if verify and problems else OK


def main() -> int:
    p = argparse.ArgumentParser(); p.add_argument("--repo", default=".")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("init")
    s=sub.add_parser("start"); s.add_argument("--task",required=True); s.add_argument("--requirement",required=True); s.add_argument("--risk",required=True); s.add_argument("--job",default="implementation"); s.add_argument("--capability",default="unattributed"); s.add_argument("--worker",default="unknown"); s.add_argument("--model",default="unknown"); s.add_argument("--provider",default="unknown"); s.add_argument("--reasoning-effort",default="unknown"); s.add_argument("--allow",action="append",default=[]); s.add_argument("--owner",action="append",default=[]); s.add_argument("--protect",action="append",default=[]); s.add_argument("--protected-risk",default="R3"); s.add_argument("--accept-dirty",action="append",default=[])
    sc=sub.add_parser("start-child"); sc.add_argument("--child",required=True); sc.add_argument("--task",required=True); sc.add_argument("--risk",required=True); sc.add_argument("--model",default="unknown"); sc.add_argument("--provider",default="unknown"); sc.add_argument("--reasoning-effort",default="unknown"); sc.add_argument("--allow",action="append",default=[]); sc.add_argument("--owner",action="append",default=[]); sc.add_argument("--invariant",action="append",default=[]); sc.add_argument("--depends-on",action="append",default=[])
    po=sub.add_parser("claim-owner"); po.add_argument("--owner",action="append",default=[])
    rc=sub.add_parser("record-child"); rc.add_argument("--child",required=True); rc.add_argument("--check",required=True); rc.add_argument("--status",required=True); rc.add_argument("--detail",default="")
    fc=sub.add_parser("finish-child"); fc.add_argument("--child",required=True); fc.add_argument("--result",required=True); fc.add_argument("--patch"); fc.add_argument("--detail",default="")
    ic=sub.add_parser("integrate-child"); ic.add_argument("--child",required=True); ic.add_argument("--patch",required=True)
    r=sub.add_parser("record"); r.add_argument("--check",required=True); r.add_argument("--status"); r.add_argument("--detail",default=""); r.add_argument("--command",help="run this and derive the status from its exit code; the evidence is then executed, not asserted")
    e=sub.add_parser("expand-scope"); e.add_argument("--path",required=True); e.add_argument("--reason",required=True); e.add_argument("--required-by",required=True); e.add_argument("--risk",required=True); e.add_argument("--verification",action="append",default=[])
    b=sub.add_parser("check-boundary"); b.add_argument("--json",action="store_true")
    v=sub.add_parser("review-boundary"); v.add_argument("--reviewer",required=True); v.add_argument("--reviewer-model",required=True); v.add_argument("--reviewer-provider",required=True); v.add_argument("--reviewer-reasoning",required=True)
    c=sub.add_parser("checkpoint"); c.add_argument("--note",default="")
    f=sub.add_parser("finish"); f.add_argument("--result",required=True); f.add_argument("--detail",default="")
    x=sub.add_parser("snapshot-release"); x.add_argument("--release-id",required=True)
    for name in ("status","verify"):
        q=sub.add_parser(name); q.add_argument("--json",action="store_true")
    a=p.parse_args(); repo=Path(a.repo).resolve()
    if not repo.is_dir(): print(f"delivery-ledger: ERROR: repo not found: {repo}",file=sys.stderr); return FAILED
    try:
        if a.cmd in {"init","start","claim-owner","start-child","record-child","finish-child","integrate-child","record","expand-scope","check-boundary","review-boundary","checkpoint","finish","snapshot-release"}:
            with ledger_lock(repo):
                if a.cmd=="init": return cmd_init(repo)
                if a.cmd=="start": return cmd_start(repo,a)
                if a.cmd=="claim-owner": return cmd_claim_owner(repo,a)
                if a.cmd=="start-child": return cmd_start_child(repo,a)
                if a.cmd=="record-child": return cmd_record_child(repo,a)
                if a.cmd=="finish-child": return cmd_finish_child(repo,a)
                if a.cmd=="integrate-child": return cmd_integrate_child(repo,a)
                if a.cmd=="record": return cmd_record(repo,a)
                if a.cmd=="expand-scope": return cmd_expand_scope(repo,a)
                if a.cmd=="check-boundary": return cmd_check_boundary(repo,a.json)
                if a.cmd=="review-boundary": return cmd_review_boundary(repo,a)
                if a.cmd=="checkpoint": return cmd_checkpoint(repo,a)
                if a.cmd=="finish": return cmd_finish(repo,a)
                if a.cmd=="snapshot-release": return cmd_snapshot(repo,a)
        if a.cmd=="status": return cmd_status(repo,a.json,False)
        if a.cmd=="verify": return cmd_status(repo,a.json,True)
    except (ValueError, FileNotFoundError, json.JSONDecodeError, OSError) as exc:
        print(f"delivery-ledger: ERROR: {exc}",file=sys.stderr); return FAILED
    return FAILED

if __name__ == "__main__": raise SystemExit(main())
