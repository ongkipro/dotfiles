#!/usr/bin/env bash
# Smoke-test OMP's own defaults in an isolated agent directory.
set -euo pipefail

if ! command -v omp >/dev/null 2>&1; then
  echo 'omp-effective-routing-test: SKIP (omp unavailable)'
  exit 0
fi
if ! command -v jq >/dev/null 2>&1; then
  echo 'omp-effective-routing-test: SKIP (jq unavailable)'
  exit 0
fi

fixture="$(mktemp -d "${TMPDIR:-/tmp}/omp-upstream-defaults.XXXXXX")"
trap 'find "$fixture" -depth -delete 2>/dev/null || true' EXIT
mkdir -p "$fixture/agent"

env -u PI_CONFIG_FILES -u OMP_RUNTIME_LEGACY_OVERLAY \
  PI_CODING_AGENT_DIR="$fixture/agent" \
  "$(command -v omp)" config list --json > "$fixture/config.json"

jq -e '
  .setupVersion.type == "number" and
  .modelRoles.type == "record" and
  .["task.maxConcurrency"].type == "number"
' "$fixture/config.json" >/dev/null || {
  echo 'FAIL: isolated upstream OMP settings did not resolve expected native schema' >&2
  exit 1
}

echo 'omp-effective-routing-test: OK (isolated upstream-native settings resolve)'
