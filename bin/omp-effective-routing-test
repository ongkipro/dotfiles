#!/usr/bin/env bash
# Smoke-test OMP's own defaults and the explicit dotfiles reference in isolated
# agent directories. The reference is never installed or auto-loaded.
set -euo pipefail

SELF="$(readlink -f "$0" 2>/dev/null || realpath "$0")"
ROOT="${1:-$(cd "$(dirname "$SELF")/.." && pwd)}"

if ! command -v omp >/dev/null 2>&1; then
  echo 'omp-effective-routing-test: SKIP (omp unavailable)'
  exit 0
fi
if ! command -v jq >/dev/null 2>&1; then
  echo 'omp-effective-routing-test: SKIP (jq unavailable)'
  exit 0
fi

omp_version="$("$(command -v omp)" --version | sed -nE 's#^omp/([0-9]+\.[0-9]+\.[0-9]+).*#\1#p')"
if [[ -z "$omp_version" ]]; then
  echo 'FAIL: OMP returned an unrecognized version string' >&2
  exit 1
fi
awk -F. '
  {
    split("18.0.9", minimum, ".")
    if (($1 + 0) > minimum[1] ||
        (($1 + 0) == minimum[1] && ($2 + 0) > minimum[2]) ||
        (($1 + 0) == minimum[1] && ($2 + 0) == minimum[2] && ($3 + 0) >= minimum[3])) exit 0
    exit 1
  }
' <<<"$omp_version" || {
  echo "omp-effective-routing-test: SKIP (OMP $omp_version is older than required 18.0.9)"
  exit 0
}

fixture="$(mktemp -d "${TMPDIR:-/tmp}/omp-upstream-defaults.XXXXXX")"
trap 'find "$fixture" -depth -delete 2>/dev/null || true' EXIT
mkdir -p "$fixture/agent"

env -u PI_CONFIG_FILES -u OMP_RUNTIME_LEGACY_OVERLAY \
  PI_CODING_AGENT_DIR="$fixture/agent" \
  "$(command -v omp)" config list --json > "$fixture/config.json"

jq -e '
  .setupVersion.type == "number" and
  .modelRoles.type == "record" and
  .["task.maxConcurrency"].type == "number"
' "$fixture/config.json" >/dev/null || {
  echo 'FAIL: isolated upstream OMP settings did not resolve expected native schema' >&2
  exit 1
}

env -u OMP_RUNTIME_LEGACY_OVERLAY \
  PI_CONFIG_FILES="$ROOT/config/omp/config.yml" \
  PI_CODING_AGENT_DIR="$fixture/reference-agent" \
  "$(command -v omp)" config list --json > "$fixture/reference.json"

# Deliberately NOT under PI_CODING_AGENT_DIR. The model registry is a function of
# which providers this device has authenticated, and an isolated agent dir has
# authenticated none — it answered with **zero** models while the real registry
# held 94. Combined with the missing `-e` below, that made the selector checks
# unfireable in both directions: every lookup returned null, the block evaluated
# to `false`, and jq still exited 0. A gate that cannot fail is not a gate.
env -u OMP_RUNTIME_LEGACY_OVERLAY \
  PI_CONFIG_FILES="$ROOT/config/omp/config.yml" \
  "$(command -v omp)" models --json > "$fixture/models.json"

# CI has no provider auth (RELEASE contract: repository-owned checks must not
# require paid accounts). Say so out loud rather than passing silently.
if [[ "$(jq '.models | length' "$fixture/models.json")" -eq 0 ]]; then
  echo 'omp-effective-routing-test: SKIP selector validation (no authenticated provider registry)' >&2
  skip_selector_validation=1
else
  skip_selector_validation=0
fi

jq -e '
  .modelRoles.value as $roles |
  .["retry.fallbackChains"].value as $fallbacks |
  .["task.agentModelOverrides"].value as $agents |
  ($roles | length) == 15 and
  ($fallbacks | length) == 15 and
  ($agents | length) == 7 and
  $roles.default == "openai-codex/gpt-5.6-terra:medium" and
  $roles.task == "openai-codex/gpt-5.6-sol:high" and
  $roles.slow == "openai-codex/gpt-5.6-sol:high" and
  $roles.plan == "anthropic/claude-fable-5:high" and
  $roles.orchestrator == "anthropic/claude-fable-5:high" and
  $roles.smol == "google-antigravity/gemini-3.7-flash:medium" and
  $roles.tiny == "google-antigravity/gemini-3.7-flash:low" and
  $roles.vision == "anthropic/claude-opus-5:high" and
  $roles.designer == "google-antigravity/gemini-3.7-flash:high" and
  $roles.commit == "openai-codex/gpt-5.6-luna:low" and
  $roles.title == "google-antigravity/gemini-3.7-flash:low" and
  $roles.research == "openai-codex/gpt-5.6-terra:medium" and
  $roles.discovery == "openai-codex/gpt-5.6-terra:medium" and
  $roles.advisor == "anthropic/claude-opus-5:high" and
  $roles["advisor-xhigh"] == "anthropic/claude-opus-5:xhigh" and
  ($roles | has("advisor-max") | not) and
  ($fallbacks | has("advisor-max") | not) and
  ([$roles | to_entries[] | select(.value | contains("claude-fable-5")) | .key] | sort) == ["orchestrator", "plan"] and
  ([$roles | to_entries[] | select(.value | contains("gemini-3.7-flash")) | .key] | sort) == ["designer", "smol", "tiny", "title"] and
  ([$fallbacks | to_entries[].value[] | select(contains("claude-fable-5"))] | length) == 0 and
  ([$fallbacks | to_entries[] | select(any(.value[]; contains("gemini-3.7-flash"))) | .key] | sort) == ["commit"] and
  .["advisor.enabled"].value == false and
  .["prewalk.enabled"].value == false and
  .["goal.enabled"].value == true and
  .["goal.statusInFooter"].value == true and
  .["goal.continuationModes"].value == ["interactive"] and
  .["todo.enabled"].value == true and
  .["todo.reminders"].value == true and
  .["todo.eager"].value == "preferred" and
  .["task.eager"].value == "preferred" and
  .["task.batch"].value == true and
  .["task.enableEffort"].value == true and
  .["task.showResolvedModelBadge"].value == true and
  .["task.isolation.mode"].value == "auto" and
  .["task.isolation.apply"].value == false and
  .["task.maxConcurrency"].value == 4 and
  .["task.maxRecursionDepth"].value == 1 and
  .["task.softRequestBudget"].value == 200 and
  .defaultThinkingLevel.value == "high" and
  .["task.enableLsp"].value == true and
  .["task.prewalk"].value == false and
  $agents == {
    "designer":"@designer",
    "librarian":"@research",
    "reviewer":"@advisor",
    "scout":"@discovery",
    "security-reviewer":"@advisor-xhigh",
    "sonic":"@smol",
    "task":"@task"
  } and
  $agents.reviewer == "@advisor" and
  $roles.advisor == "anthropic/claude-opus-5:high" and
  $agents["security-reviewer"] == "@advisor-xhigh" and
  $roles["advisor-xhigh"] == "anthropic/claude-opus-5:xhigh" and
  ([$agents[] | select(. == "@advisor-max")] | length) == 0
' "$fixture/reference.json" >/dev/null || {
  echo 'FAIL: cross-device OMP reference did not resolve its canonical role graph' >&2
  exit 1
}

if [[ "$skip_selector_validation" -eq 0 ]]; then
# The reference is intentionally portable. A device that does not authenticate
# every reference provider cannot judge those selectors, but it must still fail
# for a bad selector, effort, or visual fallback under a provider it does know.
# `-e` remains load-bearing: a false jq result must fail this shell gate.
verdict="$(jq -e -n --slurpfile c "$fixture/reference.json" --slurpfile m "$fixture/models.json" '
  ([$m[0].models[].provider] | unique) as $known |
  def refs:
    ($c[0].modelRoles.value | to_entries[] | .value),
    ($c[0]["retry.fallbackChains"].value | to_entries[].value[]);
  def visual_refs:
    $c[0].modelRoles.value.vision,
    $c[0].modelRoles.value.designer,
    $c[0]["retry.fallbackChains"].value.vision[],
    $c[0]["retry.fallbackChains"].value.designer[];
  [refs | capture("^(?<provider>[^/]+)/(?<id>.+):(?<effort>[^:]+)$")] as $all |
  ($all | map(select(.provider as $p | $known | index($p) | not)) | length) as $unjudged |
  [$all[] | select(.provider as $p | $known | index($p)) |
    . as $ref |
    ([$m[0].models[] | select(.provider == $ref.provider and .id == $ref.id)][0]) as $model |
    select(
      ($model == null) or
      (($model.thinking // []) as $levels |
        ($levels | length) > 0 and ($levels | index($ref.effort) | not))
    ) | "\($ref.provider)/\($ref.id):\($ref.effort)"
  ] as $broken |
  [visual_refs | capture("^(?<provider>[^/]+)/(?<id>.+):(?<effort>[^:]+)$") |
    select(.provider as $p | $known | index($p)) |
    . as $ref |
    ([$m[0].models[] | select(.provider == $ref.provider and .id == $ref.id)][0]) as $model |
    select(($model == null) or (($model.input // []) | index("image") | not)) |
    "\($ref.provider)/\($ref.id):\($ref.effort)"
  ] as $visual_broken |
  "\($unjudged) \($broken | length) \($visual_broken | length) \(($broken + $visual_broken) | unique | join(","))"
')" || {
  echo 'FAIL: could not evaluate the portable OMP reference against the authenticated registry' >&2
  exit 1
}
read -r unjudged broken visual_broken detail <<<"${verdict//\"/}"
if [[ "$broken" -ne 0 || "$visual_broken" -ne 0 ]]; then
  echo "FAIL: OMP reference names ${broken} unusable selector(s) or ${visual_broken} non-visual visual selector(s) under a provider this device does have: ${detail}" >&2
  exit 1
fi
if [[ "$unjudged" -gt 0 ]]; then
  echo "omp-effective-routing-test: note reference — ${unjudged} selector(s) unjudged (provider not authenticated here)" >&2
fi
fi

# The tracked reference is a recommendation, not a mandate: OMP owns device-local
# capacity choices, and a device legitimately routes to what it can actually
# reach. This machine's Anthropic and Codex accounts do not exist on the Mac,
# whose registry carries no Claude 5 family at all — so demanding the two configs
# match would be wrong, and would push a device toward selectors it cannot use.
#
# What must hold on *every* device is narrower, and until now was checked on no
# device at all: the reference above is validated, the native config never was.
# Found by pointing these same three rules at the Mac: its `vision` fallback is
# `gpt-5.6-sol`, which does not accept image input — so a failed visual primary
# fell back to a model that cannot see, silently.
if [[ "$skip_selector_validation" -eq 0 ]]; then
  env -u PI_CONFIG_FILES -u OMP_RUNTIME_LEGACY_OVERLAY \
    "$(command -v omp)" config list --json > "$fixture/native.json"

  jq -e -n --slurpfile c "$fixture/native.json" --slurpfile m "$fixture/models.json" '
    def refs:
      ($c[0].modelRoles.value | to_entries[] | .value),
      ($c[0]["retry.fallbackChains"].value // {} | to_entries[].value[]);
    def visual_refs:
      ($c[0].modelRoles.value | to_entries[] | select(.key == "vision" or .key == "designer") | .value),
      ($c[0]["retry.fallbackChains"].value // {} | to_entries[] | select(.key == "vision" or .key == "designer") | .value[]);
    ([refs |
        capture("^(?<provider>[^/]+)/(?<id>.+):(?<effort>[^:]+)$") as $ref |
        ([$m[0].models[] | select(.provider == $ref.provider and .id == $ref.id)][0]) as $model |
        select(
          ($model == null) or
          (($model.thinking // []) as $levels |
            ($levels | length) > 0 and ($levels | index($ref.effort) | not))
        ) | $ref
      ] | length == 0) and
    ([visual_refs |
        capture("^(?<provider>[^/]+)/(?<id>.+):(?<effort>[^:]+)$") as $ref |
        ([$m[0].models[] | select(.provider == $ref.provider and .id == $ref.id)][0]) as $model |
        select(($model == null) or (($model.input // []) | index("image") | not)) | $ref
      ] | length == 0)
  ' >/dev/null || {
    echo 'FAIL: this device'"'"'s native OMP config names a selector, thinking level, or non-visual visual-role model its own registry does not support' >&2
    exit 1
  }
fi

# `config/omp/overlays/` holds one profile per provider shape, because devices
# deliberately differ — the Mac authenticates Google Antigravity alone and reaches
# GPT only through 9router, which this machine has never had. Nothing checked
# them at all, so a typo in an overlay stayed invisible until the day someone
# selected it.
#
# The rule cannot be "every overlay must resolve here": four of five reference
# providers this device does not authenticate, and demanding otherwise is the
# same mistake as demanding the Mac match this config. So it splits on the
# **provider**: if the registry knows that provider at all, an unknown model or
# an undeclared level under it is a real defect; if the provider is absent
# entirely, the device simply cannot judge, and says how many it skipped.
if [[ "$skip_selector_validation" -eq 0 ]]; then
  for overlay in "$ROOT"/config/omp/overlays/*.yml; do
    [[ -e "$overlay" ]] || continue
    name="$(basename "$overlay")"
    if ! env -u OMP_RUNTIME_LEGACY_OVERLAY PI_CONFIG_FILES="$overlay" \
        "$(command -v omp)" config list --json > "$fixture/overlay.json" 2>/dev/null; then
      echo "FAIL: overlay $name did not resolve to a usable OMP configuration" >&2
      exit 1
    fi
    verdict="$(jq -n --slurpfile c "$fixture/overlay.json" --slurpfile m "$fixture/models.json" '
      ([$m[0].models[].provider] | unique) as $known |
      def refs:
        ($c[0].modelRoles.value | to_entries[] | .value),
        ($c[0]["retry.fallbackChains"].value // {} | to_entries[].value[]);
      [refs | capture("^(?<provider>[^/]+)/(?<id>.+):(?<effort>[^:]+)$")] as $all |
      ($all | map(select(.provider as $p | $known | index($p) | not)) | length) as $unreachable |
      [$all[] | select(.provider as $p | $known | index($p)) |
        . as $ref |
        ([$m[0].models[] | select(.provider == $ref.provider and .id == $ref.id)][0]) as $model |
        select(
          ($model == null) or
          (($model.thinking // []) as $levels |
            ($levels | length) > 0 and ($levels | index($ref.effort) | not))
        ) | "\($ref.provider)/\($ref.id):\($ref.effort)"
      ] as $broken |
      "\($unreachable) \($broken | length) \($broken | join(","))"')"
    read -r unreachable broken detail <<<"${verdict//\"/}"
    if [[ "$broken" -ne 0 ]]; then
      echo "FAIL: overlay $name names ${broken} unusable selector(s) under a provider this device does have: ${detail}" >&2
      exit 1
    fi
    if [[ "$unreachable" -gt 0 ]]; then
      echo "omp-effective-routing-test: note $name — ${unreachable} selector(s) unjudged (provider not authenticated here)" >&2
    fi
  done
fi

echo 'omp-effective-routing-test: OK (upstream defaults + cross-device reference + this device'"'"'s native config + overlays resolve)'
