#!/usr/bin/env bash
# Smoke-test OMP's own defaults and the explicit dotfiles reference (which must add
# no override) in isolated agent directories. The reference is never installed or
# auto-loaded.
set -euo pipefail

SELF="$(readlink -f "$0" 2>/dev/null || realpath "$0")"
ROOT="${1:-$(cd "$(dirname "$SELF")/.." && pwd)}"

if ! command -v omp >/dev/null 2>&1; then
  echo 'omp-effective-routing-test: SKIP (omp unavailable)'
  exit 0
fi
if ! command -v jq >/dev/null 2>&1; then
  echo 'omp-effective-routing-test: SKIP (jq unavailable)'
  exit 0
fi

omp_version="$("$(command -v omp)" --version | sed -nE 's#^omp/([0-9]+\.[0-9]+\.[0-9]+).*#\1#p')"
if [[ -z "$omp_version" ]]; then
  echo 'FAIL: OMP returned an unrecognized version string' >&2
  exit 1
fi
awk -F. '
  {
    split("18.0.9", minimum, ".")
    if (($1 + 0) > minimum[1] ||
        (($1 + 0) == minimum[1] && ($2 + 0) > minimum[2]) ||
        (($1 + 0) == minimum[1] && ($2 + 0) == minimum[2] && ($3 + 0) >= minimum[3])) exit 0
    exit 1
  }
' <<<"$omp_version" || {
  echo "omp-effective-routing-test: SKIP (OMP $omp_version is older than required 18.0.9)"
  exit 0
}

fixture="$(mktemp -d "${TMPDIR:-/tmp}/omp-upstream-defaults.XXXXXX")"
trap 'find "$fixture" -depth -delete 2>/dev/null || true' EXIT
mkdir -p "$fixture/agent"

env -u PI_CONFIG_FILES -u OMP_RUNTIME_LEGACY_OVERLAY \
  PI_CODING_AGENT_DIR="$fixture/agent" \
  "$(command -v omp)" config list --json > "$fixture/config.json"

jq -e '
  .setupVersion.type == "number" and
  .modelRoles.type == "record" and
  .["task.maxConcurrency"].type == "number"
' "$fixture/config.json" >/dev/null || {
  echo 'FAIL: isolated upstream OMP settings did not resolve expected native schema' >&2
  exit 1
}

env -u OMP_RUNTIME_LEGACY_OVERLAY \
  PI_CONFIG_FILES="$ROOT/config/omp/config.yml" \
  PI_CODING_AGENT_DIR="$fixture/reference-agent" \
  "$(command -v omp)" config list --json > "$fixture/reference.json"

# Deliberately NOT under PI_CODING_AGENT_DIR. The model registry is a function of
# which providers this device has authenticated, and an isolated agent dir has
# authenticated none — it answered with **zero** models while the real registry
# held 94. Combined with the missing `-e` below, that made the selector checks
# unfireable in both directions: every lookup returned null, the block evaluated
# to `false`, and jq still exited 0. A gate that cannot fail is not a gate.
env -u OMP_RUNTIME_LEGACY_OVERLAY \
  PI_CONFIG_FILES="$ROOT/config/omp/config.yml" \
  "$(command -v omp)" models --kind all --json > "$fixture/models.json"

# CI has no provider auth (RELEASE contract: repository-owned checks must not
# require paid accounts). Say so out loud rather than passing silently.
if [[ "$(jq '.models | length' "$fixture/models.json")" -eq 0 ]]; then
  echo 'omp-effective-routing-test: SKIP selector validation (no authenticated provider registry)' >&2
  skip_selector_validation=1
else
  skip_selector_validation=0
fi

# The reference must not change anything: OMP runs on upstream defaults (owner
# decision 2026-10-31). Comparing resolved values is not enough, because an
# explicit key equal to today's default still becomes policy the day upstream
# changes it. So the file must be exactly an empty mapping once comments and
# blank lines are removed.
reference_body="$(grep -v -E '^[[:space:]]*(#|$)' "$ROOT/config/omp/config.yml" || true)"
if [[ "$reference_body" != '{}' ]]; then
  echo 'FAIL: tracked OMP reference must contain no setting (expected exactly `{}`); OMP runs on upstream defaults' >&2
  exit 1
fi

# A key this repo sets that is absent from the upstream schema is drift, and OMP will
# not say so: verified 2026-09-04 that a bogus key resolves with exit 0 and empty
# stderr. It is drift in two different ways, and the difference is not visible here.
# `task.isolation.mode` was one: OMP 18.1.4 exposed it as canonical, while
# OMP 18.1.10 restored `task.isolation.enabled`. A genuinely retired key
# would likewise be ignored outright. Both cases want the same answer - move to the
# canonical name - so flag any leaf missing from the schema and let the reader
# establish which kind it is.
if unknown_keys="$(python3 - "$ROOT/config/omp/config.yml" "$fixture/config.json" <<'PYEOF'
import json, sys
try:
    import yaml
except ModuleNotFoundError:
    sys.exit(9)

tracked = yaml.safe_load(open(sys.argv[1])) or {}
schema = json.load(open(sys.argv[2]))
# A record-typed setting (modelRoles, task.agentModelOverrides) owns free-form
# children by design; its keys are data, not schema.
records = {k for k, v in schema.items() if isinstance(v, dict) and v.get("type") == "record"}

def leaves(node, path=()):
    if isinstance(node, dict):
        dotted = ".".join(path)
        if dotted in records:
            return
        for k, v in node.items():
            yield from leaves(v, path + (str(k),))
    else:
        yield ".".join(path)

print("\n".join(k for k in leaves(tracked) if k not in schema))
PYEOF
)"; then
  if [[ -n "$unknown_keys" ]]; then
    echo 'FAIL: tracked OMP reference sets keys absent from the upstream schema (retired, or a legacy alias OMP normalizes away - either way use the canonical name):' >&2
    printf '  %s\n' $unknown_keys >&2
    exit 1
  fi
elif [[ "$?" -eq 9 ]]; then
  echo 'omp-effective-routing-test: SKIP retired-key audit (PyYAML unavailable)' >&2
else
  echo 'FAIL: retired-key audit could not read the tracked OMP reference' >&2
  exit 1
fi

# The tracked reference is a recommendation, not a mandate: OMP owns device-local
# capacity choices, and a device legitimately routes to what it can actually
# reach. This machine's Anthropic and Codex accounts do not exist on the Mac,
# whose registry carries no Claude 5 family at all — so demanding the two configs
# match would be wrong, and would push a device toward selectors it cannot use.
#
# What must hold on *every* device is narrower, and until now was checked on no
# device at all: the reference above is validated, the native config never was.
# Found by pointing these same three rules at the Mac: its `vision` fallback is
# `gpt-5.6-sol`, which does not accept image input — so a failed visual primary
# fell back to a model that cannot see, silently.
if [[ "$skip_selector_validation" -eq 0 ]]; then
  # Reuse the diagnostic's native selector grammar and all-kind catalog. Bare
  # image selectors and auto/off effort are runtime features, not bad routes.
  env -u PI_CONFIG_FILES -u OMP_RUNTIME_LEGACY_OVERLAY \
    "$ROOT/bin/omp-runtime-report" > "$fixture/native-report.txt" || {
    cat "$fixture/native-report.txt" >&2
    echo 'FAIL: native OMP routing failed the runtime report' >&2
    exit 1
  }
  if ! grep -q '^omp-runtime-report: OK' "$fixture/native-report.txt"; then
    cat "$fixture/native-report.txt" >&2
    echo 'FAIL: native OMP routing was not verified (runtime report skipped)' >&2
    exit 1
  fi
fi

# Retired overlays are historical evidence, not loaded configuration. Check that
# their YAML still loads, but do not certify old provider catalogs as live routes.
# An explicitly selected overlay is judged by omp-runtime-report in that session.
for overlay in "$ROOT"/config/omp/overlays/*.yml; do
  [[ -f "$overlay" ]] || continue
  env -u OMP_RUNTIME_LEGACY_OVERLAY PI_CONFIG_FILES="$overlay" \
    PI_CODING_AGENT_DIR="$fixture/historical-agent" \
    "$(command -v omp)" config list --json > "$fixture/overlay.json" 2>/dev/null || {
    echo "FAIL: historical overlay $(basename "$overlay") no longer loads as settings" >&2
    exit 1
  }
done
echo 'omp-effective-routing-test: note retired overlays — settings load only; live selectors not certified'
echo 'omp-effective-routing-test: OK (reference adds no override; upstream defaults + native config resolve)'
