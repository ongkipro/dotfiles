#!/usr/bin/env python3
"""ai-mcp-sync - reconcile global MCP server configurations across runtimes.

Declared in config/ai/mcp-servers.json and synchronized idempotently to:
  - Claude Code: ~/.claude.json ("mcpServers")
  - Antigravity: ~/.gemini/config/mcp_config.json ("mcpServers")
  - Codex CLI:   ~/.codex/config.toml ("[mcp_servers.<name>]")
  - OMP:         ~/.omp/agent/mcp.json ("mcpServers")
  - Pi:          ~/.pi/agent/mcp.json ("mcpServers")

Usage:
  ai-mcp-sync             install or repair missing MCP servers
  ai-mcp-sync --check     report status, write nothing, non-zero if drift
  ai-mcp-sync --dotfiles P specify dotfiles repository root
"""
import argparse
import json
import os
import re
import sys
from pathlib import Path


def find_dotfiles(override: str | None = None) -> Path:
    if override:
        return Path(override).expanduser().resolve()
    env = os.environ.get("DOTFILES")
    if env:
        return Path(env).expanduser().resolve()
    home = Path.home()
    if (home / "dotfiles").is_dir():
        return home / "dotfiles"
    script = Path(__file__).resolve().parent.parent
    if (script / "config" / "ai").is_dir():
        return script
    raise RuntimeError("Cannot locate dotfiles directory")


def load_manifest(dotfiles: Path) -> dict:
    manifest_path = dotfiles / "config" / "ai" / "mcp-servers.json"
    if not manifest_path.is_file():
        raise FileNotFoundError(f"Manifest not found: {manifest_path}")
    with manifest_path.open("r", encoding="utf-8") as f:
        data = json.load(f)
    return data.get("mcpServers", {})


def get_home(override: str | None = None) -> Path:
    if override:
        return Path(override).expanduser().resolve()
    return Path.home()


def atomic_write(target: Path, content: str) -> None:
    import stat
    import tempfile
    if target.is_symlink() or (target.exists() and (not target.is_file() or target.stat().st_nlink != 1)):
        raise ValueError("configuration must be a regular file without links")
    mode = (stat.S_IMODE(target.stat().st_mode) & 0o600) if target.exists() else 0o600
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix="." + target.name + ".", dir=target.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            os.fchmod(f.fileno(), mode)
            f.write(content); f.flush(); os.fsync(f.fileno())
        os.replace(tmp, target)
    finally:
        if os.path.exists(tmp): os.unlink(tmp)


def managed_spec(spec: dict, claude=False) -> dict:
    result = {"command": spec["command"], "args": spec.get("args", []), "env": spec.get("env", {})}
    if claude: result["type"] = "stdio"
    return result


def sync_json(target: Path, manifest: dict, check_only: bool, claude=False) -> tuple[bool, str]:
    data = json.loads(target.read_text(encoding="utf-8")) if target.exists() else {}
    servers = data.setdefault("mcpServers", {})
    changed = not target.exists()
    for name, spec in manifest.items():
        current = servers.get(name, {})
        needed = managed_spec(spec, claude)
        if name not in servers or any(current.get(k, {} if k == "env" else None) != v for k, v in needed.items()):
            servers[name] = {**current, **needed}
            changed = True
    if not changed: return True, "in sync"
    if check_only: return False, "drift detected"
    atomic_write(target, json.dumps(data, indent=2) + "\n")
    return True, "updated"


def sync_claude(home: Path, manifest: dict, check_only: bool) -> tuple[bool, str]:
    if not (home / ".claude.json").exists() and not (home / ".claude").exists():
        return True, "skipped (Claude Code not configured on this device)"
    return sync_json(home / ".claude.json", manifest, check_only, claude=True)


def sync_antigravity(home: Path, manifest: dict, check_only: bool) -> tuple[bool, str]:
    if not (home / ".gemini").exists():
        return True, "skipped (Antigravity not configured on this device)"
    return sync_json(home / ".gemini/config/mcp_config.json", manifest, check_only)


def toml_value(value):
    # Values retained inside a managed table; all unrelated tables stay verbatim.
    from datetime import date, time
    if isinstance(value, str): return json.dumps(value, ensure_ascii=False)
    if isinstance(value, bool): return str(value).lower()
    if isinstance(value, (int, float)): return repr(value)
    if isinstance(value, (date, time)): return value.isoformat()
    if isinstance(value, list): return "[" + ", ".join(map(toml_value, value)) + "]"
    if isinstance(value, dict): return "{ " + ", ".join(json.dumps(k) + " = " + toml_value(v) for k, v in value.items()) + " }"
    raise ValueError("unsupported TOML value")


def sync_codex(home: Path, manifest: dict, check_only: bool) -> tuple[bool, str]:
    import copy
    import tomllib
    if not (home / ".codex").exists():
        return True, "skipped (Codex CLI not configured on this device)"
    target = home / ".codex/config.toml"
    content = target.read_text(encoding="utf-8") if target.exists() else ""
    data = tomllib.loads(content)
    expected = copy.deepcopy(data)
    servers = expected.setdefault("mcp_servers", {})
    changed = []
    for name, spec in manifest.items():
        current = servers.get(name, {})
        needed = managed_spec(spec)
        if name not in servers or any(current.get(k, {} if k == "env" else None) != v for k, v in needed.items()):
            servers[name] = {**current, **needed}
            changed.append(name)
    if not changed: return True, "in sync"
    if check_only: return False, "drift detected"

    # Rewrite only complete managed tables (including their child tables).
    # Parsing the result and comparing the entire object prevents an unusual
    # inline/dotted/multiline representation from losing unrelated settings.
    header = re.compile(r"(?m)^\s*\[[^\n]+\][ \t]*(?:#[^\n]*)?$")
    matches = list(header.finditer(content))
    ranges = []
    for index, match in enumerate(matches):
        try:
            section = tomllib.loads(match.group() + "\n")
            managed = section.get("mcp_servers", {})
            owned = any(name in managed for name in changed)
        except (ValueError, AttributeError):
            owned = False
        if owned: ranges.append((match.start(), matches[index + 1].start() if index + 1 < len(matches) else len(content)))
    for start, end in reversed(ranges): content = content[:start] + content[end:]
    for name in changed:
        content = content.rstrip() + "\n\n[mcp_servers." + (name if re.fullmatch(r"[A-Za-z0-9_-]+", name) else json.dumps(name)) + "]\n"
        for key, value in servers[name].items():
            content += json.dumps(key) + " = " + toml_value(value) + "\n"
    if tomllib.loads(content) != expected:
        raise ValueError("unsupported managed TOML layout; configuration was preserved")
    atomic_write(target, content)
    return True, "updated"


def sync_json_mcp(target_dir: Path, runtime_name: str, manifest: dict, check_only: bool) -> tuple[bool, str]:
    if not target_dir.parent.exists():
        return True, f"skipped ({runtime_name} not configured on this device)"
    return sync_json(target_dir / "mcp.json", manifest, check_only)


def main() -> int:
    parser = argparse.ArgumentParser(description="Reconcile global MCP server configurations across runtimes.")
    parser.add_argument("--check", action="store_true", help="Report drift without modifying files")
    parser.add_argument("--dotfiles", type=str, help="Dotfiles repository root path")
    parser.add_argument("--home", type=str, help="User home directory path (for testing)")
    args = parser.parse_args()

    try:
        dotfiles = find_dotfiles(args.dotfiles)
        manifest = load_manifest(dotfiles)
        home = get_home(args.home)
    except Exception as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return 2

    runtimes = [
        ("Claude Code", lambda: sync_claude(home, manifest, args.check)),
        ("Antigravity", lambda: sync_antigravity(home, manifest, args.check)),
        ("Codex CLI", lambda: sync_codex(home, manifest, args.check)),
        ("OMP", lambda: sync_json_mcp(home / ".omp" / "agent", "OMP", manifest, args.check)),
        ("Pi", lambda: sync_json_mcp(home / ".pi" / "agent", "Pi", manifest, args.check)),
    ]

    all_ok = True
    for name, runner in runtimes:
        try:
            ok, msg = runner()
        except (OSError, ValueError, TypeError, AttributeError, KeyError) as exc:
            ok, msg = False, f"configuration error ({type(exc).__name__}); file preserved"
        symbol = "✓" if ok else "✗"
        print(f"  {symbol} {name}: {msg}")
        if not ok:
            all_ok = False

    if not all_ok:
        print("\nMCP synchronization incomplete; resolve reported drift or configuration errors.", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
