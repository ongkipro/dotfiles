#!/usr/bin/env bash
# Restore runtime-neutral 9Router config and its user service on macOS or Linux.
# Safe to run repeatedly. This script does not configure optional AI CLIs.
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
OS="$(uname -s)"
AUTOSTART_DESKTOP="$HOME/.config/autostart/9router.desktop"

say()  { printf '\033[1;32m→\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m⚠\033[0m  %s\n' "$*" >&2; }

ensure_linux_systemd_owns_9router() {
  [ "$OS" = "Linux" ] || return 0
  [ -f "$AUTOSTART_DESKTOP" ] || return 0
  if grep -q '9router/cli\.js --tray' "$AUTOSTART_DESKTOP" 2>/dev/null; then
    python3 - <<'PY'
from pathlib import Path

path = Path.home() / ".config/autostart/9router.desktop"
text = path.read_text()
for old, new in {
    "Hidden=false": "Hidden=true",
    "NoDisplay=false": "NoDisplay=true",
    "X-GNOME-Autostart-enabled=true": "X-GNOME-Autostart-enabled=false",
}.items():
    text = text.replace(old, new)
path.write_text(text)
PY
    say "Disabled the 9Router tray autostart; systemd owns the service"
  fi
}

mkdir -p "$HOME/.9router/runtime"
aliases_source="$DOTFILES_DIR/config/9router/aliases.json"
aliases_destination="$HOME/.9router/aliases.json"
if [ -f "$aliases_source" ]; then
  # `-ef` is true for a symlink pointing at the source, so the old branch framed
  # "the destination is a link into the tracked repo" as success and preserved
  # it. The 9Router service writes to this file; through a link those writes land
  # in the repository. Remove any link first, then install a real copy.
  rm -f "$aliases_destination"
  cp "$aliases_source" "$aliases_destination"
  say "Restored 9Router aliases"
else
  warn "Missing config/9router/aliases.json"
fi
runtime_source="$DOTFILES_DIR/config/9router/runtime-package.json"
runtime_destination="$HOME/.9router/runtime/package.json"
if [ -f "$runtime_source" ]; then
  # Same shape as the aliases above, and this destination matters more: `npm`
  # runs inside ~/.9router/runtime and rewrites package.json.
  rm -f "$runtime_destination"
  cp "$runtime_source" "$runtime_destination"
  say "Restored the 9Router runtime package manifest"
else
  warn "Missing config/9router/runtime-package.json"
fi

NODE_BIN="$(command -v node || true)"
ROUTER_BIN="$(command -v 9router || true)"
if [ -z "$NODE_BIN" ] || [ -z "$ROUTER_BIN" ]; then
  warn "node or 9router is unavailable; restored config but skipped service setup"
  warn "Install 9Router separately before rerunning this helper"
  exit 0
fi

ROUTER_CLI="$(readlink -f "$ROUTER_BIN" 2>/dev/null || realpath "$ROUTER_BIN" 2>/dev/null || printf '%s\n' "$ROUTER_BIN")"
APP_DIR="$(dirname "$ROUTER_CLI")/app"
RUNTIME_NM="$HOME/.9router/runtime/node_modules"
BUNDLED_NM="$APP_DIR/node_modules"
NODE_PATH_COMBINED="$RUNTIME_NM:$BUNDLED_NM"
PORT="${NINEROUTER_PORT:-20128}"
HOST="${NINEROUTER_HOST:-127.0.0.1}"
mkdir -p "$HOME/.9router/logs"

case "$OS" in
  Darwin)
    stray="$HOME/Library/LaunchAgents/com.9router.autostart.plist"
    if [ -e "$stray" ]; then
      launchctl bootout "gui/$(id -u)/com.9router.autostart" 2>/dev/null \
        || launchctl unload "$stray" 2>/dev/null \
        || true
      mkdir -p "$HOME/.local/share/9router-disabled"
      mv -f "$stray" "$HOME/.local/share/9router-disabled/"
      say "Moved the conflicting tray autostart to ~/.local/share/9router-disabled/"
    fi

    plist="$HOME/Library/LaunchAgents/com.9router.gateway.plist"
    cat > "$plist" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.9router.gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>$NODE_BIN</string>
    <string>$APP_DIR/custom-server.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PORT</key>
    <string>$PORT</string>
    <key>HOSTNAME</key>
    <string>$HOST</string>
    <key>NODE_PATH</key>
    <string>$NODE_PATH_COMBINED</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>$APP_DIR</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$HOME/.9router/logs/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>$HOME/.9router/logs/stderr.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
PLISTEOF

    launchctl unload "$plist" 2>/dev/null || true
    launchctl load "$plist"
    say "Restored the 9Router launchd service at $plist"
    ;;

  Linux)
    ensure_linux_systemd_owns_9router
    systemd_user_dir="$HOME/.config/systemd/user"
    service_path="$systemd_user_dir/9router.service"
    mkdir -p "$systemd_user_dir"
    cat > "$service_path" <<SERVICEEOF
[Unit]
Description=9Router AI Gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=$APP_DIR
Environment=NODE_ENV=production
Environment=HOME=%h
Environment=PORT=$PORT
Environment=HOSTNAME=$HOST
Environment=NODE_PATH=$NODE_PATH_COMBINED
ExecStartPre=/bin/sleep 2
ExecStart=$NODE_BIN $APP_DIR/custom-server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
SERVICEEOF

    systemctl --user daemon-reload
    systemctl --user enable 9router.service >/dev/null
    systemctl --user restart 9router.service
    say "Restored the 9Router systemd service at $service_path"
    ;;

  *)
    warn "Unsupported operating system: $OS; restored config but skipped service setup"
    exit 0
    ;;
esac

health_url="http://${HOST}:${PORT}/api/health"
if curl -fsS "$health_url" >/dev/null 2>&1; then
  say "9Router is healthy at $health_url"
else
  warn "The service was restored, but its health endpoint is not ready at $health_url"
fi
