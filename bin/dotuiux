#!/usr/bin/env node
/**
 * dotuiux — non-slop UI/UX workflow: brief → references → DESIGN.md → check.
 *
 * Subcommands:
 *   init [dir]
 *     Scaffold design/brief.md, design/refs/, and a DESIGN.md skeleton. Never overwrites.
 *   teardown <url...> [--out design/refs]
 *     Screenshots at 360/768/1440 + facts.json per URL (research input, not judgement).
 *   check <url|file> [--design DESIGN.md] [--json] [--checkout-handoff]
 *     Render at 360/768/1440 and run the gates. FAIL = floor (exit 1); WARN = slop signal,
 *     overridable in DESIGN.md with `allow: <id> — <reason>`.
 *   validate [dir]
 *     Check design/brief.md and DESIGN.md headings and allow: lines.
 *
 * Gate list and tiers: ~/Documents/work/research/dotuiux/03-dotuiux-brief.md §3 (evidence:
 * 02-round2-synthesis.md there; § numbers below cite those files, kept outside this repo).
 * Browser: reuses design-taste/scripts/ui-ref.mjs (DevTools over node: builtins + installed
 * Chrome), resolved from $DOTFILES, this script's checkout, then ~/dotfiles. Read-only: it only loads pages.
 * Exit: 0 ok · 1 FAIL gate or invalid project · 2 usage/error · 3 no working browser.
 */

import fs from "node:fs";
import path from "node:path";
import os from "node:os";
import { pathToFileURL, fileURLToPath } from "node:url";
import { createServer } from "node:http";

// ---- thresholds (each points to its spec section) -------------------------------------
// Viewports: §12 step 5 / §13 / brief §3. Heights are common device sizes.
const VIEWPORTS = [
  { width: 360, height: 800, mobile: true },
  { width: 768, height: 1024, mobile: true },
  { width: 1440, height: 900, mobile: false },
];
const DESKTOP_MIN_WIDTH = 1024; // "desktop" for h1 line count (§4 "H1 ≤3 lines desktop")
const REDUCED_MOTION_WIDTH = 360; // one extra render under prefers-reduced-motion (§4, §11)
const SETTLE_MS = 1200; // wait after load before measuring (as admin-geometry)
const EVAL_TIMEOUT_MS = 90000; // a page script that never settles must not hang check
const SCAN_MS = 45000; // contrast scan budget per viewport, well inside EVAL_TIMEOUT_MS
const SCROLL_STEPS = 120; // contrast scan: screens per viewport (0.8 vh apart; ~77-86k px); a real 84k px brief page needed > 40

// Floor (fail) — §17 tier 1, brief §3
const CONTRAST_MIN = 4.5; // §4 text contrast
const CONTRAST_LARGE_MIN = 3; // §4 large text (≥24px, or ≥18.66px bold)
const TEXT_MIN_PX = 12; // §16 "nothing <12 px anywhere" — owner convention; no standard sets a minimum size
const TARGET_MIN_PX = 24; // §4 "Targets ≥24 fail"
const INPUT_MIN_PX = 16; // §4 "Mobile input ≥16 px" (iOS zoom), checked at 360
const INPUT_ZOOM_MAX_WIDTH = 360;
const CONTACT_MAX = 1; // §14 + preferences.md: one contact CTA per page (D9)
const LOOP_MAX_MS = 5000; // §4 "Loops >5 s have pause" (WCAG 2.2.2)
const MOTION_TINY_PX = 32; // loops/animations on elements smaller than this (spinners, dots) are exempt
const GENERIC_ALT = /^(image|img|photo|picture|pic|hero|banner|placeholder|untitled|graphic|thumbnail|logo)\s*\d*$|\.(jpe?g|png|webp|gif|svg|avif)$/i; // §16
const PLACEHOLDER_RE = /lorem ipsum|dolor sit amet|\bacme\b|\bjohn doe\b|\bjane doe\b/gi; // §4 "No placeholder brands / lorem"

// Slop signals (warn) — §17 tier 2, brief §3
const PRIMARY_PER_VIEWPORT_MAX = 1; // §14 "≤1 primary-styled button per viewport"
const FIRST_VIEWPORT_BUTTONS_MAX = 3; // §14/§16 "≤3 button-styled elements in first viewport"
const DUPLICATE_HREF_MAX = 2; // §14 "same href linked >2 times" (nav/header/footer excluded)
const BODY_MIN_PX = 16; // §16 "public body ≥16 px"
const FIRST_VIEWPORT_WORDS_MAX = 60; // §16 "first viewport ≤ ~60 words"
const H1_WORDS_MAX = 10; // §16 "H1 ≤ ~10 words"
const H1_LINES_MAX = 3; // §4/§16 "≤3 lines desktop"
const NAV_LABEL_CHARS_MAX = 16; // §16 "≤ ~16 chars, one line"
const SIDEBAR_GROUP_MAX = 7; // §16 "≤ ~7 items per sidebar group"
const MARKERS_PER_VIEWPORT_MAX = 2; // §16 "≤2 badges/chips/stickers per viewport"
const EMPHASIS_RUNS_MAX = 1; // §16 "≤1 bold/highlight run per paragraph"
const EMPHASIS_ALL_BOLD_WORDS = 8; // §16 "no all-bold sentences": bold paragraph this long
const ICON_RATIO_MAX = 0.5; // §16 ">50% of list items/headings carrying an icon"
const ICON_MIN_CARRIERS = 4; // ratio needs a sample; fewer headings/items = not judged
const HERO_VIEWPORT_RATIO = 0.85; // §16 "hero >~85% of viewport with no next-section peek"
const STOCK_RE = /(images\.unsplash\.com|unsplash\.com\/photos|images\.pexels\.com|pexels\.com\/photo|freepik\.com|istockphoto\.com|shutterstock\.com|gettyimages\.)/i; // §16
const IMAGE_REUSE_MIN_PX = 48; // icons/logos below this may repeat legitimately
const BLUR_WARN_PX = 8; // D4 (accepted 2026-10-31): warn >8 px …
const BLUR_FAIL_PX = 10; // … and fail >10 px; `allow: blur` covers only the warn band
const WHATSAPP_RE = /^(https?:\/\/(wa\.me|api\.whatsapp\.com)\b|whatsapp:)/i; // D9 checkout-handoff exception
const DISPLAY_PX = 24; // D2 (accepted 2026-10-31): display text is ≥24 px …
const DISPLAY_TRACKING_MIN_EM = -0.02; // … with letter-spacing no tighter than −0.02em; tighter only via DESIGN.md allow:
const DURATION_SMALL_MS = 300; // §4 "Durations ≤300 small"
const DURATION_LARGE_MS = 500; // §4 "≤500 large"
const LARGE_AREA_RATIO = 0.25; // "large" element = ≥25% of the viewport area

// Teardown: galleries are owner-picked mood, not measurement targets (brief §4, §19, D5).
const GALLERY_HOST_RE = /(^|\.)(dribbble\.com|behance\.net|v0\.app|v0\.dev|awwwards\.com|regards\.design|pinterest\.[a-z.]+)$/i;

// WCAG 2.x contrast on sRGB [r, g, b, a?] 0–255. Pure; also injected into the page by call().
export const relLum = (c) => { const f = (v) => { v /= 255; return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; }; return 0.2126 * f(c[0]) + 0.7152 * f(c[1]) + 0.0722 * f(c[2]); };
export const contrastRatio = (a, b) => { const x = relLum(a), y = relLum(b); return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05); };
export const blendOver = (t, b) => [0, 1, 2].map((i) => t[i] * t[3] + b[i] * (1 - t[3])).concat(1);

// One text fact → "fail" | "pass" | null (not measurable). Exact ratio, or a gradient [min, max] range.
export function contrastVerdict(x) {
  const lim = x.large ? CONTRAST_LARGE_MIN : CONTRAST_MIN;
  if (x.ratio != null) return x.ratio < lim ? "fail" : "pass";
  if (!x.range) return null;
  return x.range[1] < lim ? "fail" : x.range[0] >= lim ? "pass" : null;
}

// ---- rules ---------------------------------------------------------------------------
// judge(facts) → offenders [{el, v}] for one viewport, or null when it could not be measured.
const has = (x) => Array.isArray(x);
const off = (el, v) => ({ el, v });
const maxPerBucket = (items) => {
  const m = new Map();
  for (const i of items) m.set(i.bucket, [...(m.get(i.bucket) || []), i]);
  return [...m.values()];
};

// WCAG 2.5.8: a small target passes when a ${TARGET_MIN_PX}px circle on its centre touches no
// other target and no other small target's circle. Targets: {x, y, w, h} in page coordinates.
export function undersizedTargets(targets) {
  const r = TARGET_MIN_PX / 2, small = targets.filter((t) => Math.min(t.w, t.h) < TARGET_MIN_PX);
  const c = (t) => [t.x + t.w / 2, t.y + t.h / 2];
  const distToRect = ([px, py], t) => Math.hypot(Math.max(t.x - px, 0, px - (t.x + t.w)), Math.max(t.y - py, 0, py - (t.y + t.h)));
  return small.filter((t) => targets.some((o) => o !== t && (distToRect(c(t), o) < r
    || (small.includes(o) && Math.hypot(c(t)[0] - c(o)[0], c(t)[1] - c(o)[1]) < TARGET_MIN_PX))));
}

export const RULES = [
  // Floor: harm only (§17). Not overridable.
  { id: "contrast", tier: "fail", spec: "§4", desc: `text contrast < ${CONTRAST_MIN}:1 (large < ${CONTRAST_LARGE_MIN}:1)`,
    // Measured offenders always fail; with none, any unmeasured text (over an image, gradient, overlay,
    // off-screen) leaves the rule NOT CHECKED rather than vouched for. Disabled text is exempt (WCAG 1.4.3).
    // Over a gradient the ratio is a [min, max] range: it fails only when even the best case fails,
    // passes only when even the worst case passes, and is unmeasured in between.
    judge: (f) => {
      const t = has(f.texts) ? f.texts.filter((x) => !x.exempt) : [];
      if (!t.length) return null;
      const r2 = (v) => Math.floor(v * 100) / 100;
      const o = t.filter((x) => contrastVerdict(x) === "fail").map((x) => off(x.el, x.ratio != null ? `${r2(x.ratio)}:1` : `≤ ${r2(x.range[1])}:1 over a gradient`));
      return o.length || t.every((x) => contrastVerdict(x) != null) ? o : null;
    } },
  { id: "tiny-text", tier: "fail", spec: "§16", desc: `visible text < ${TEXT_MIN_PX}px`,
    judge: (f) => has(f.texts) ? f.texts.filter((t) => t.px < TEXT_MIN_PX).map((t) => off(t.el, `${t.px}px`)) : null },
  { id: "overflow-x", tier: "fail", spec: "§4", desc: "horizontal scroll",
    judge: (f) => f.scrollWidth == null || (f.overflowClipped && f.scrollWidth > f.width + 1) ? null : f.scrollWidth > f.width + 1
      ? [off(`document ${f.scrollWidth}px wide`, `+${f.scrollWidth - f.width}px`), ...(f.overflowEls || []).map((el) => off(el, "past right edge"))] : [] },
  { id: "target-size", tier: "fail", spec: "§4", desc: `interactive target < ${TARGET_MIN_PX}px (inline links and WCAG 2.5.8 spacing exempt)`,
    judge: (f) => has(f.targets) ? undersizedTargets(f.targets).map((t) => off(t.el, `${t.w}x${t.h}`)) : null },
  { id: "input-zoom", tier: "fail", spec: "§4", desc: `form control font < ${INPUT_MIN_PX}px at ${INPUT_ZOOM_MAX_WIDTH}`,
    applies: (f) => f.width <= INPUT_ZOOM_MAX_WIDTH,
    judge: (f) => !has(f.controls) ? null : f.controls.filter((c) => c.px < INPUT_MIN_PX).map((c) => off(c.el, `${c.px}px`)) },
  { id: "img-alt", tier: "fail", spec: "§16", desc: "<img> without alt, or generic alt",
    judge: (f) => has(f.images) ? f.images.filter((i) => i.alt == null || GENERIC_ALT.test(i.alt.trim())).map((i) => off(i.el, i.alt == null ? "no alt" : `alt="${i.alt}"`)) : null },
  { id: "contact-count", tier: "fail", spec: "§14", desc: `> ${CONTACT_MAX} contact link (wa.me, whatsapp:, tel:, mailto:, m.me, t.me) per page`,
    judge: (f) => has(f.contacts) ? (f.contacts.length > CONTACT_MAX ? f.contacts.map((c) => off(c.el, c.href)) : []) : null },
  { id: "contact-placement", tier: "fail", spec: "§14", desc: "contact link in header/nav, hero, fixed/sticky, dialog, or repeated items",
    // D9: with --checkout-handoff a WhatsApp link may sit in the hero; every other placement still fails.
    judge: (f, o) => has(f.contacts) ? f.contacts
      .map((c) => ({ c, p: o.checkoutHandoff && WHATSAPP_RE.test(c.href) ? c.placement.filter((x) => x !== "hero") : c.placement }))
      .filter(({ p }) => p.length).map(({ c, p }) => off(c.el, p.join(", "))) : null },
  { id: "floating-widget", tier: "fail", spec: "§14", desc: "fixed bottom-corner chat/WhatsApp bubble",
    judge: (f) => has(f.floating) ? f.floating.map((el) => off(el, "fixed bottom corner")) : null },
  { id: "placeholder-content", tier: "fail", spec: "§4", desc: "lorem ipsum / Acme / John Doe placeholders",
    judge: (f) => has(f.placeholders) ? f.placeholders.map((p) => off("page text", `"${p}"`)) : null },
  { id: "lcp-entrance", tier: "fail", spec: "§4, §11", desc: "LCP element (or an ancestor) starts hidden (opacity 0, clip, visibility) in an entrance animation",
    judge: (f) => !f.lcp ? null : f.lcp.animated ? [off(f.lcp.el, f.lcp.how)] : [] },
  { id: "reduced-motion", tier: "fail", spec: "§4, §11", desc: "transform/size animation still running under prefers-reduced-motion",
    applies: (f) => f.width === REDUCED_MOTION_WIDTH,
    judge: (f) => has(f.reducedMotion) ? f.reducedMotion.map((a) => off(a.el, a.props)) : null },
  { id: "loop-pause", tier: "fail", spec: "§4", desc: `animation/video longer than ${LOOP_MAX_MS / 1000}s with no pause control`,
    judge: (f) => !f.loops ? null : f.loops.pauseControl ? [] : f.loops.items.map((l) => off(l.el, l.v)) },

  // Slop signals: warn, overridable with `allow: <id> — <reason>` (§17).
  { id: "primary-actions", tier: "warn", spec: "§14", desc: `> ${PRIMARY_PER_VIEWPORT_MAX} primary per viewport, > ${FIRST_VIEWPORT_BUTTONS_MAX} button-like in first viewport`,
    judge: (f) => {
      if (!has(f.buttons)) return null;
      const o = [];
      for (const b of maxPerBucket(f.buttons.filter((b) => b.primary))) if (b.length > PRIMARY_PER_VIEWPORT_MAX) o.push(off(b.map((x) => x.el).join(" + "), `${b.length} primary in screen ${b[0].bucket + 1}`));
      const first = f.buttons.filter((b) => b.bucket === 0);
      if (first.length > FIRST_VIEWPORT_BUTTONS_MAX) o.push(off(first.map((x) => x.el).join(" + "), `${first.length} button-like in first viewport`));
      return o;
    } },
  // Hygiene, not harm: browsers imply noopener on target=_blank (owner, 2026-10-31).
  { id: "blank-noopener", tier: "warn", spec: "§14", desc: "target=_blank without noopener/noreferrer",
    judge: (f) => has(f.blank) ? f.blank.map((b) => off(b.el, `rel="${b.rel}"`)) : null },
  { id: "whatsapp-green", tier: "warn", spec: "§14", desc: "WhatsApp brand-green (#25D366 family) on the contact CTA",
    judge: (f) => has(f.contacts) ? f.contacts.filter((c) => c.green).map((c) => off(c.el, "brand green")) : null },
  { id: "duplicate-href", tier: "warn", spec: "§14", desc: `same href > ${DUPLICATE_HREF_MAX} times outside nav/header/footer`,
    judge: (f) => {
      if (!has(f.hrefs)) return null;
      const n = new Map(); for (const h of f.hrefs) n.set(h, (n.get(h) || 0) + 1);
      return [...n].filter(([, c]) => c > DUPLICATE_HREF_MAX).map(([h, c]) => off(h, `${c} times`));
    } },
  { id: "body-size", tier: "warn", spec: "§16", desc: `dominant paragraph text < ${BODY_MIN_PX}px`,
    judge: (f) => {
      if (!has(f.texts)) return null;
      const prose = f.texts.filter((t) => t.prose); if (!prose.length) return null;
      const w = new Map(); for (const t of prose) w.set(t.px, (w.get(t.px) || 0) + t.chars);
      const [px] = [...w].sort((a, b) => b[1] - a[1])[0];
      return px < BODY_MIN_PX ? [off("body copy", `${px}px`)] : [];
    } },
  { id: "first-viewport-words", tier: "warn", spec: "§16", desc: `> ${FIRST_VIEWPORT_WORDS_MAX} words in the first viewport`,
    judge: (f) => f.firstViewportWords == null ? null : f.firstViewportWords > FIRST_VIEWPORT_WORDS_MAX ? [off("first viewport", `${f.firstViewportWords} words`)] : [] },
  { id: "h1-length", tier: "warn", spec: "§4, §16", desc: `H1 > ${H1_WORDS_MAX} words, or > ${H1_LINES_MAX} lines on desktop`,
    judge: (f) => has(f.h1s) ? f.h1s.filter((h) => h.words > H1_WORDS_MAX || (f.width >= DESKTOP_MIN_WIDTH && h.lines > H1_LINES_MAX))
      .map((h) => off(h.el, `${h.words} words, ${h.lines} lines`)) : null },
  { id: "nav-label", tier: "warn", spec: "§16", desc: `nav/tab label > ${NAV_LABEL_CHARS_MAX} chars or wraps`,
    judge: (f) => has(f.navLabels) ? f.navLabels.filter((l) => l.chars > NAV_LABEL_CHARS_MAX || l.lines > 1).map((l) => off(l.el, `${l.chars} chars, ${l.lines} line(s)`)) : null },
  { id: "sidebar-group", tier: "warn", spec: "§16", desc: `nav group > ${SIDEBAR_GROUP_MAX} items`,
    judge: (f) => has(f.navGroups) ? f.navGroups.filter((g) => g.items > SIDEBAR_GROUP_MAX).map((g) => off(g.el, `${g.items} items`)) : null },
  { id: "marker-count", tier: "warn", spec: "§16", desc: `> ${MARKERS_PER_VIEWPORT_MAX} badges/chips per viewport`,
    judge: (f) => has(f.markers) ? maxPerBucket(f.markers).filter((b) => b.length > MARKERS_PER_VIEWPORT_MAX)
      .map((b) => off(b.slice(0, 4).map((x) => x.el).join(" + "), `${b.length} in screen ${b[0].bucket + 1}`)) : null },
  { id: "emphasis", tier: "warn", spec: "§16", desc: `> ${EMPHASIS_RUNS_MAX} bold/highlight run per paragraph, or all-bold paragraph`,
    judge: (f) => has(f.emphasis) ? f.emphasis.filter((e) => e.runs > EMPHASIS_RUNS_MAX || (e.allBold && e.words >= EMPHASIS_ALL_BOLD_WORDS))
      .map((e) => off(e.el, e.allBold ? "all bold" : `${e.runs} runs`)) : null },
  { id: "icon-overload", tier: "warn", spec: "§16", desc: `> ${ICON_RATIO_MAX * 100}% of headings/list items carry icons; icon tiles`,
    judge: (f) => {
      if (!f.icons) return null;
      const o = f.icons.tiles.map((el) => off(el, "icon tile"));
      const { total, withIcon } = f.icons;
      if (total >= ICON_MIN_CARRIERS && withIcon / total > ICON_RATIO_MAX) o.push(off("headings/list items", `${withIcon}/${total} carry an icon`));
      return o;
    } },
  { id: "card-in-card", tier: "warn", spec: "§16", desc: "bordered/shadowed/filled box inside another (dialog, table exempt)",
    judge: (f) => has(f.nestedCards) ? f.nestedCards.map((c) => off(c.el, `inside ${c.outer}`)) : null },
  { id: "hero-height", tier: "warn", spec: "§16", desc: `hero > ${HERO_VIEWPORT_RATIO * 100}% of viewport with no next-section peek`,
    judge: (f) => !f.hero ? null : f.hero.h > f.height * HERO_VIEWPORT_RATIO && f.hero.bottom >= f.height
      ? [off(f.hero.el, `${f.hero.h}px of ${f.height}px viewport`)] : [] },
  { id: "stock-image", tier: "warn", spec: "§16", desc: "image from a stock CDN (unsplash/pexels/freepik/istock…)",
    judge: (f) => has(f.images) ? f.images.filter((i) => STOCK_RE.test(i.src || "")).map((i) => off(i.el, i.src.slice(0, 80))) : null },
  { id: "image-reuse", tier: "warn", spec: "§16", desc: "same image used more than once",
    judge: (f) => {
      if (!has(f.images)) return null;
      const n = new Map();
      for (const i of f.images) if (i.src && i.w >= IMAGE_REUSE_MIN_PX && i.h >= IMAGE_REUSE_MIN_PX) n.set(i.src, (n.get(i.src) || 0) + 1);
      return [...n].filter(([, c]) => c > 1).map(([s, c]) => off(s.slice(0, 80), `${c} times`));
    } },
  // One id, two bands: > BLUR_FAIL_PX offenders carry sev "fail", which no allow: line can cover.
  { id: "blur", tier: "warn", spec: "D4", desc: `filter/backdrop blur > ${BLUR_WARN_PX}px warns, > ${BLUR_FAIL_PX}px fails`,
    judge: (f) => has(f.blurs) ? f.blurs.filter((b) => b.px > BLUR_WARN_PX)
      .map((b) => b.px > BLUR_FAIL_PX ? { ...off(b.el, `${b.px}px (> ${BLUR_FAIL_PX}px fail band)`), sev: "fail" } : off(b.el, `${b.px}px`)) : null },
  // D2: the brand may go tighter, but only as a recorded decision (allow: display-tracking — <reason>).
  { id: "display-tracking", tier: "warn", spec: "D2", desc: `display text (≥ ${DISPLAY_PX}px) letter-spacing tighter than ${DISPLAY_TRACKING_MIN_EM}em`,
    judge: (f) => has(f.texts) ? f.texts.filter((t) => t.px >= DISPLAY_PX && t.em != null && t.em < DISPLAY_TRACKING_MIN_EM - 1e-4)
      .map((t) => off(t.el, `${Math.round(t.em * 1000) / 1000}em at ${t.px}px`)) : null },
  // Real case 2026-10-31 (dotads storefront: h1 → h3). WCAG 1.3.1 advises, does not require, sequential levels.
  { id: "heading-skip", tier: "warn", spec: "WCAG 1.3.1 (advisory)", desc: "heading level skipped (e.g. h1 → h3)",
    judge: (f) => has(f.headingSkips) ? f.headingSkips.map((h) => off(h.el, h.v)) : null },
  { id: "transition-all", tier: "warn", spec: "§4", desc: "transition: all",
    judge: (f) => has(f.transitionAll) ? f.transitionAll.map((el) => off(el, "transition-property: all")) : null },
  // Owner decision D1, not a standard: Material 3 uses accelerate curves for exits. Deliberate exits: allow: ease-in.
  { id: "ease-in", tier: "warn", spec: "D1 (owner)", desc: "ease-in timing on UI motion (owner preference; exits may use it — allow: if deliberate)",
    judge: (f) => has(f.easeIn) ? f.easeIn.map((e) => off(e.el, e.v)) : null },
  { id: "duration", tier: "warn", spec: "§4", desc: `motion > ${DURATION_SMALL_MS}ms (small) / > ${DURATION_LARGE_MS}ms (large)`,
    judge: (f) => has(f.durations) ? f.durations.filter((d) => d.ms > (d.large ? DURATION_LARGE_MS : DURATION_SMALL_MS))
      .map((d) => off(d.el, `${d.ms}ms${d.large ? " (large)" : ""}`)) : null },
];
export const FLOOR_IDS = RULES.filter((r) => r.tier === "fail").map((r) => r.id);
export const WARN_IDS = RULES.filter((r) => r.tier === "warn").map((r) => r.id);

// ---- pure: allow lines, evaluation, validation -----------------------------------------
// Blank out HTML comments and fenced code so documented examples never count,
// keeping line numbers intact for error messages.
const stripDocs = (text) => text
  .replace(/<!--[\s\S]*?-->/g, (m) => m.replace(/[^\n]/g, " "))
  .replace(/^```[\s\S]*?^```/gm, (m) => m.replace(/[^\n]/g, " "));

const ALLOW_RE = /^\s*(?:[-*]\s+)?allow:\s*([a-z0-9-]+)\s+(?:—|–|--)\s+(\S.*?)\s*$/i;

export function parseAllows(text) {
  const allows = new Map(); const errors = [];
  stripDocs(String(text)).split("\n").forEach((line, i) => {
    if (!/^\s*(?:[-*]\s+)?allow:/i.test(line)) return;
    const m = ALLOW_RE.exec(line);
    const at = `line ${i + 1}`;
    if (!m) return errors.push(`${at}: malformed, expected "allow: <rule-id> — <reason>": ${line.trim()}`);
    const id = m[1].toLowerCase();
    if (FLOOR_IDS.includes(id)) return errors.push(`${at}: "${id}" is a floor (fail) rule and cannot be overridden`);
    if (!WARN_IDS.includes(id)) return errors.push(`${at}: unknown rule id "${id}" (warn ids: ${WARN_IDS.join(", ")})`);
    allows.set(id, m[2]);
  });
  return { allows, errors };
}

// factsByWidth: [{width, height, ...facts}] → one result per rule, worst status across widths.
// A pass needs every applicable width measured: one measured width never vouches for another.
// opts.checkoutHandoff: D9 exception (see contact-placement).
export function evaluate(factsByWidth, allows = new Map(), opts = {}) {
  return RULES.map((rule) => {
    const byKey = new Map(); let checked = 0; const unmeasuredAt = [];
    for (const f of factsByWidth) {
      if (rule.applies && !rule.applies(f)) continue;
      const o = rule.judge(f, opts);
      if (o == null) { unmeasuredAt.push(f.width); continue; }
      checked++;
      // Same element + value at several widths is one finding with several widths.
      for (const x of o) { const k = `${x.el}\u0000${x.v}`; if (byKey.has(k)) byKey.get(k).widths.push(f.width); else byKey.set(k, { widths: [f.width], ...x }); }
    }
    const offenders = [...byKey.values()];
    let status = offenders.length ? (rule.tier === "fail" || offenders.some((x) => x.sev === "fail") ? "fail" : "warn")
      : !checked || unmeasuredAt.length ? "not-checked" : "pass";
    if (status === "warn" && allows.has(rule.id)) status = "allowed";
    return { id: rule.id, tier: rule.tier, spec: rule.spec, desc: rule.desc, status,
      ...(status === "allowed" ? { reason: allows.get(rule.id) } : {}),
      ...(checked && unmeasuredAt.length ? { unmeasuredAt } : {}), offenders };
  });
}

export const BRIEF_HEADINGS = ["Niche", "Audience", "Primary job", "Primary action", "References wanted", "Non-goals"];
export const DESIGN_HEADINGS = ["Tokens", "Allow"];

// Section bodies keyed by "## Heading", comments removed.
function sections(text) {
  const out = new Map(); let cur = null;
  for (const line of stripDocs(text).split("\n")) {
    const h = /^##\s+(.+?)\s*$/.exec(line);
    if (h) { cur = h[1].toLowerCase(); out.set(cur, ""); } else if (cur && !/^#\s/.test(line)) out.set(cur, out.get(cur) + line + "\n");
  }
  return out;
}

export function validateProject(dir) {
  const errors = [], warnings = [];
  const brief = path.join(dir, "design", "brief.md"), design = path.join(dir, "DESIGN.md");
  for (const [file, heads, warnEmpty] of [[brief, BRIEF_HEADINGS, true], [design, DESIGN_HEADINGS, false]]) {
    if (!fs.existsSync(file)) { errors.push(`missing ${path.relative(dir, file) || file} (run: dotuiux init)`); continue; }
    const s = sections(fs.readFileSync(file, "utf8"));
    for (const h of heads) {
      if (!s.has(h.toLowerCase())) errors.push(`${path.basename(file)}: missing heading "## ${h}"`);
      else if (warnEmpty && !s.get(h.toLowerCase()).trim()) warnings.push(`${path.basename(file)}: "## ${h}" is still empty`);
    }
  }
  if (fs.existsSync(design)) for (const e of parseAllows(fs.readFileSync(design, "utf8")).errors) errors.push(`DESIGN.md ${e}`);
  return { ok: !errors.length, errors, warnings };
}

