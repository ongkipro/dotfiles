// ---- browser layer (reuses ui-ref.mjs) -------------------------------------------------
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const within = (p, ms) => Promise.race([p, sleep(ms).then(() => null)]); // ui-ref does not export this

async function loadUiRef() {
  // $DOTFILES first, then the checkout this script lives in (CI checks out outside
  // ~/dotfiles; realpath follows a ~/.local/bin link), then ~/dotfiles.
  const own = path.resolve(path.dirname(fs.realpathSync(fileURLToPath(import.meta.url))), "..");
  const roots = [process.env.DOTFILES, own, path.join(os.homedir(), "dotfiles")].filter(Boolean);
  const rel = path.join("skills", "local", "design-taste", "scripts", "ui-ref.mjs");
  const file = roots.map((r) => path.join(r, rel)).find((f) => fs.existsSync(f));
  if (!file) throw new Error(`ui-ref.mjs not found under ${roots.join(", ")} (set DOTFILES)`);
  return import(pathToFileURL(file).href);
}

function toUrl(arg) {
  if (fs.existsSync(arg) && fs.statSync(arg).isFile()) return pathToFileURL(path.resolve(arg)).href;
  if (/^(https?|file):\/\//i.test(arg)) return arg;
  throw new Error(`not a URL or existing file: ${arg}`);
}

// A file:// page is served from its folder over loopback HTTP: snap Chromium has a
// private /tmp and cannot read most local paths, and HTTP matches how pages ship.
const MIME = { ".html": "text/html", ".htm": "text/html", ".css": "text/css", ".js": "text/javascript", ".mjs": "text/javascript",
  ".json": "application/json", ".svg": "image/svg+xml", ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg",
  ".webp": "image/webp", ".avif": "image/avif", ".gif": "image/gif", ".woff2": "font/woff2", ".woff": "font/woff", ".ico": "image/x-icon" };
async function serveFile(url) {
  if (!url.startsWith("file:")) return { url, close: () => {} };
  const file = fileURLToPath(url), root = path.dirname(file);
  const server = createServer((req, res) => {
    const miss = (code = 404) => { res.writeHead(code); res.end(); };
    let rel; try { rel = decodeURIComponent(new URL(req.url, "http://x").pathname); } catch { return miss(400); }
    const p = path.join(root, rel), type = MIME[path.extname(p).toLowerCase()];
    // Page scripts can fetch anything served: never dotfiles (.env, .git/…) or types outside the web set.
    if (!type || !p.startsWith(root + path.sep) || path.relative(root, p).split(path.sep).some((seg) => seg.startsWith("."))) return miss();
    fs.readFile(p, (err, data) => { if (err) return miss(); res.writeHead(200, { "content-type": type }); res.end(data); });
  }).listen(0, "127.0.0.1");
  await new Promise((r) => server.once("listening", r));
  return { url: `http://127.0.0.1:${server.address().port}/${encodeURIComponent(path.basename(file))}`, close: () => server.close() };
}

// Runs before any page script: records entrance animations and the LCP element.
function pageRecorder() {
  const rec = (window.__dotuiux = { anims: [], lcp: null });
  // Record which properties each animation touches, so a background tint is not an entrance.
  const META = new Set(["offset", "computedOffset", "easing", "composite"]);
  const keys = (anims) => [...new Set(anims.flatMap((a) => (a.effect && a.effect.getKeyframes ? a.effect.getKeyframes() : []).flatMap((k) => Object.keys(k)).filter((k) => !META.has(k))))];
  // web.dev LCP: opacity-0 content is not a candidate, a moving/resizing one is. Record whether the first
  // keyframe hides it; false = it starts visible (a transform-only or fade-from-visible entrance).
  const startsHidden = (anims) => anims.some((a) => { const k = a.effect && a.effect.getKeyframes ? a.effect.getKeyframes()[0] : null;
    return !k || (k.opacity != null && +k.opacity < 0.05) || k.clipPath != null || k.visibility === "hidden"; });
  document.addEventListener("animationstart", (e) => rec.anims.push({ t: e.target, name: e.animationName, ts: performance.now(),
    ...((as) => ({ props: keys(as), hidden: startsHidden(as) }))(e.target.getAnimations ? e.target.getAnimations().filter((a) => a.animationName === e.animationName) : []) }), true);
  // A transition's from-value is not exposed: an opacity/clip transition on load is treated as a reveal (lazy: may over-report a partial fade).
  document.addEventListener("transitionrun", (e) => rec.anims.push({ t: e.target, name: "transition", props: [e.propertyName], hidden: true, ts: performance.now() }), true);
  const animate = Element.prototype.animate;
  Element.prototype.animate = function (...a) { const anim = animate.apply(this, a);
    rec.anims.push({ t: this, name: "element.animate()", props: keys([anim]), hidden: startsHidden([anim]), ts: performance.now() }); return anim; };
  try { new PerformanceObserver((l) => { for (const e of l.getEntries()) rec.lcp = e; }).observe({ type: "largest-contentful-paint", buffered: true }); } catch {}
}

// Runs inside the page. Returns geometry, computed styles and short labels only —
// no cookies, storage, or form values. Thresholds stay in Node; this only measures.
async function pageCollect(o) {
  // Intended viewport from Node: mobile emulation widens innerWidth to fit overflowing content.
  const vw = o.width, vh = o.height;
  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
  const rec = window.__dotuiux || { anims: [], lcp: null };
  const cs = (el) => getComputedStyle(el);
  // Wholly above the document, or left of it on an LTR page (a skip link parked at top:-60px until focus), is not visible.
  const ltr = getComputedStyle(document.documentElement).direction !== "rtl";
  const visible = (el) => { const r = el.getBoundingClientRect(); if (r.width < 2 || r.height < 2) return false;
    if (r.bottom + scrollY <= 0 || (ltr && r.right + scrollX <= 0)) return false;
    const s = cs(el); return s.visibility !== "hidden" && s.display !== "none" && +s.opacity > 0; };
  const label = (el) => { const t = (el.getAttribute("aria-label") || (el.tagName === "IMG" ? el.getAttribute("alt") || el.getAttribute("src") : el.textContent) || "")
    .replace(/[\x00-\x1f\x7f]/g, " ").trim().replace(/\s+/g, " ").slice(0, 40); return el.tagName.toLowerCase() + (t ? ` "${t}"` : ""); };
  const rgba = (c) => { const m = /^rgba?\(([^)]+)\)$/.exec(c || ""); if (!m) return null;
    const p = m[1].split(/[\s,/]+/).filter(Boolean).map(parseFloat); return [p[0], p[1], p[2], p.length > 3 ? p[3] : 1]; };
  const ratio = contrastRatio, blend = blendOver; // injected by call()
  const hsl = (c) => { const [r, g, b] = c.slice(0, 3).map((v) => v / 255); const mx = Math.max(r, g, b), mn = Math.min(r, g, b), l = (mx + mn) / 2, d = mx - mn;
    const s = d === 0 ? 0 : d / (1 - Math.abs(2 * l - 1));
    const h = d === 0 ? 0 : mx === r ? 60 * (((g - b) / d) % 6) : mx === g ? 60 * ((b - r) / d + 2) : 60 * ((r - g) / d + 4);
    return { h: (h + 360) % 360, s, l, d }; };
  const colourful = (c) => { const x = rgba(c); if (!x || x[3] <= 0.1) return false; const { s, d } = hsl(x); return d * 255 > 12 && s > 0.5; };
  // Background behind an element via ancestors only (for button/card fills).
  const ancestorBg = (el) => { const layers = [];
    for (let e = el; e; e = e.parentElement) { const c = rgba(cs(e).backgroundColor); if (c && c[3] > 0) { layers.push(c); if (c[3] >= 1) break; } }
    let bg = [255, 255, 255, 1]; for (const l of layers.reverse()) bg = blend(l, bg); return bg; };
  // Paint stack under a point; null when an image sits behind (unknown), undefined when covered.
  const MEDIA = new Set(["IMG", "VIDEO", "CANVAS", "PICTURE", "IFRAME", "svg", "SVG"]);
  // ::before/::after bands are invisible to elementsFromPoint. Every painted band on the page is collected once
  // (bandRegions, after the element list): text whose point falls inside a band's containing block is unmeasured.
  // Exempt: a plain line (≤ 4px, untransformed, no border/shadow/outline growing it) such as an underline bar.
  // lazy: the region is the containing block, not the band's own box (transforms, margins and insets made box maths
  // misjudge in review); over-marking means NOT CHECKED, never a wrong verdict.
  const px = (v) => (/^-?[\d.]+px$/.test(v) ? parseFloat(v) : null);
  const edged = (s) => ["Top", "Right", "Bottom", "Left"].some((k) => parseFloat(s[`border${k}Width`]) > 0 && s[`border${k}Style`] !== "none")
    || s.boxShadow !== "none" || (parseFloat(s.outlineWidth) > 0 && s.outlineStyle !== "none");
  const bandOf = (e, p) => { const s = getComputedStyle(e, p);
    if (s.content === "none" || s.content === "normal" || s.display === "none") return null;
    // In flow, a pseudo is an overlay only as a grid item (grid-area stacking); inline icons and bullets are not.
    const placed = /absolute|fixed/.test(s.position) || /grid/.test(cs(e).display);
    const c = rgba(s.backgroundColor);
    if (!placed || !(s.backgroundImage !== "none" || !c || c[3] > 0 || edged(s))) return null;
    const w = px(s.width), h = px(s.height), plain = [s.transform, s.translate, s.scale, s.rotate, s.filter].every((v) => !v || v === "none") && !edged(s);
    if (plain && ((w != null && w <= 4) || (h != null && h <= 4))) return null;
    let cb = e; // containing block: the host when it is in flow or positioned, else the nearest positioned/transformed ancestor
    if (s.position === "absolute") while (cb.parentElement && cs(cb).position === "static" && cs(cb).transform === "none") cb = cb.parentElement;
    if (s.position === "fixed") cb = document.documentElement;
    return { cb, fixed: s.position === "fixed" }; };
  let bands = [];
  // Rect read live (viewport space): content loading above a band during the scan moves it.
  const inBand = (x, y) => bands.some((b) => { if (b.fixed) return true; const r = b.cb.getBoundingClientRect();
    return x >= r.left && x <= r.right && y >= r.top && y <= r.bottom; });
  // Top-level comma split that respects nested parentheses (rgba() inside gradient()).
  const layersOf = (v) => { const out = []; let d = 0, cur = "";
    for (const ch of v) { if (ch === "(") d++; if (ch === ")") d--; if (ch === "," && !d) { out.push(cur.trim()); cur = ""; } else cur += ch; }
    return [...out, cur.trim()]; };
  // Colour stops of one gradient layer; null for url()/image-set, unparsable colours or an `in <space>` hint.
  const gradientStops = (img) => { if (/url\(|image-set|element\(|cross-fade|paint\(|\bin\s+[a-z]/.test(img)) return null;
    const cols = (img.match(/rgba?\([^)]*\)/g) || []).map(rgba);
    const unknown = /\b(oklch|oklab|lab|lch|color|hsla?|hwb)\(/.test(img.replace(/rgba?\([^)]*\)/g, ""));
    return !cols.length || unknown || cols.some((c) => !c) ? null : cols; };
  // The meta tag sets the used scheme without changing html's computed color-scheme.
  const darkCanvas = /dark/.test(`${cs(document.documentElement).colorScheme} ${document.querySelector("meta[name=color-scheme]")?.content || ""}`);
  // Returns {lo, hi}: per-channel bounds of every colour that can sit behind the point. A solid stack
  // gives lo = hi. A gradient layer adds its stops plus "not covered here" (size/repeat unknown).
  // Interpolation and compositing are linear in premultiplied colour, so the bounds hold between stops.
  const backdrop = (el, x, y) => {
    const stack = document.elementsFromPoint(x, y), i = stack.indexOf(el);
    if (i < 0) return undefined;
    if (inBand(x, y)) return null;
    const layers = []; let opaque = false; // top-down; each layer is a list of colours, null = layer absent
    for (const e of stack.slice(i)) {
      if (e !== el && MEDIA.has(e.tagName)) return null;
      // Live too, as before the page-wide list: a band a reveal class switches on mid-scan is in the stack.
      if (bandOf(e, "::before") || bandOf(e, "::after")) return null;
      const s = cs(e);
      if (s.backgroundImage !== "none") {
        // background-clip:text paints the glyphs, not a backdrop.
        if (/text/.test(s.backgroundClip || s.webkitBackgroundClip || "")) return null;
        // Each image layer is its own layer (first listed = top); size/repeat/position lists cycle per layer.
        // A layer covers the box when it repeats both ways, or fills it from the origin; otherwise the layer below can show.
        const imgs = layersOf(s.backgroundImage), sz = layersOf(s.backgroundSize), rp = layersOf(s.backgroundRepeat), ps = layersOf(s.backgroundPosition);
        for (let k = 0; k < imgs.length; k++) {
          const stops = gradientStops(imgs[k]); if (!stops) return null;
          const z = sz[k % sz.length], rr = rp[k % rp.length], pos = ps[k % ps.length];
          const covers = /^repeat( repeat)?$/.test(rr) || (/^(auto|auto auto|cover|100% 100%)$/.test(z) && /^0(%|px)? 0(%|px)?$/.test(pos));
          layers.push(covers ? stops : [...stops, null]);
          if (covers && stops.every((c) => c[3] >= 1)) { opaque = true; break; } // nothing below this layer shows
        }
        if (opaque) break;
      }
      const c = rgba(s.backgroundColor); if (!c) return null;
      if (c[3] > 0) { layers.push([c]); if (c[3] >= 1) { opaque = true; break; } }
    }
    // No opaque layer: the canvas shows. It is white only for a light colour scheme.
    if (!opaque && darkCanvas) return null;
    let lo = [255, 255, 255, 1], hi = [255, 255, 255, 1];
    for (const layer of layers.reverse()) {
      const outs = layer.flatMap((t) => (t ? [blend(t, lo), blend(t, hi)] : [lo, hi]));
      lo = [0, 1, 2].map((k) => Math.min(...outs.map((o) => o[k]))).concat(1);
      hi = [0, 1, 2].map((k) => Math.max(...outs.map((o) => o[k]))).concat(1);
    }
    return { lo, hi };
  };
  // Contrast bounds of an opaque foreground over a backdrop box (luminance is monotonic per channel).
  const ratioRange = (fg, { lo, hi }) => {
    const L = (c) => relLum(c), lf = L(fg), a = L(lo), b = L(hi), r = (l) => (Math.max(lf, l) + 0.05) / (Math.min(lf, l) + 0.05);
    return [lf >= a && lf <= b ? 1 : Math.min(r(a), r(b)), Math.max(r(a), r(b))];
  };
  const docTop = (el) => el.getBoundingClientRect().top + scrollY;
  const bucket = (el) => Math.max(0, Math.floor(docTop(el) / vh));
  // Page chrome = banner header / contentinfo footer, not a <header> inside a section or article.
  const BANNER = "header:not(:is(article,aside,main,nav,section) header),[role=banner]";
  const CONTENTINFO = "footer:not(:is(article,aside,main,nav,section) footer),[role=contentinfo]";
  const inChrome = (el) => !!el.closest(`nav,[role=navigation],${BANNER},${CONTENTINFO}`);
  const interactive = (el) => !!el.closest("a[href],button,input,select,textarea,label,summary,[role=button],[role=tab],[role=link]");
  const CONTACT = /^(https?:\/\/(wa\.me|api\.whatsapp\.com|(www\.)?m\.me|t\.me)\b|whatsapp:|tel:|mailto:)/i;
  const longAnim = (a) => { const t = a.effect && a.effect.getComputedTiming ? a.effect.getComputedTiming() : null; return t && (t.endTime === Infinity || t.endTime > o.loopMaxMs); };
  const animTarget = (a) => a.effect && a.effect.target;
  const tiny = (el) => { const r = el.getBoundingClientRect(); return r.width < o.tinyPx && r.height < o.tinyPx; };
  const f = { width: vw, height: vh };

  // 1. Motion, at scroll 0 before anything else moves the page.
  const lcpEl = rec.lcp && rec.lcp.element;
  if (lcpEl) {
    const HIDES = /^(opacity|clip-path|clipPath|visibility)$/;
    // Hidden content is no LCP candidate, so a hero that fades in from 0 hands LCP to smaller text: also count
    // a hidden-start entrance on a first-viewport element at least as large as the reported LCP element.
    const area = (e) => { const r = e.getBoundingClientRect(); return r.width * r.height; }, lcpArea = area(lcpEl);
    // Only what can itself be an LCP candidate: an image/video/poster, a url() background, or a block with its own text.
    // A fading header, nav or decorative glow is not (no false FAIL on a container).
    const candidate = (e) => /^(IMG|VIDEO|image)$/.test(e.tagName) || /url\(/.test(cs(e).backgroundImage)
      || ([...e.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim()) && !e.closest("header,nav,[role=banner],[role=navigation]"));
    const hit = rec.anims.find((a) => a.t && a.ts < 4000 && a.hidden && a.props.some((p) => HIDES.test(p))
      && (a.t === lcpEl || (a.t.contains && a.t.contains(lcpEl)) || (a.t.isConnected && candidate(a.t) && visible(a.t) && docTop(a.t) < vh && area(a.t) >= lcpArea)));
    f.lcp = { el: label(lcpEl), animated: !!hit, how: hit ? `${hit.name} (${hit.props.join(", ")}) on ${hit.t === lcpEl ? "LCP element" : hit.t.contains(lcpEl) ? label(hit.t) : `${label(hit.t)}, larger than the reported LCP`}` : "" };
  }
  const pauseControl = [...document.querySelectorAll("button,[role=button]")].some((b) =>
    /\b(pause|stop|jeda|hentikan)\b/i.test(`${b.getAttribute("aria-label") || ""} ${b.title || ""} ${b.textContent || ""}`));
  const loops = [];
  for (const a of document.getAnimations()) { const t = animTarget(a);
    if (a.playState === "running" && longAnim(a) && t && t.isConnected && visible(t) && !tiny(t)) loops.push({ el: label(t), v: a.animationName || a.transitionProperty || "animation" }); }
  for (const v of document.querySelectorAll("video")) if (!v.paused && (v.loop || v.duration > o.loopMaxMs / 1000) && !v.controls && visible(v)) loops.push({ el: label(v), v: "autoplay video" });
  f.loops = { items: loops.slice(0, 20), pauseControl };

  // 2. Scroll pass: loads lazy content and measures text contrast as each line enters view.
  const all = [...document.body.querySelectorAll("*")].slice(0, 8000);
  // html and body pseudos too (a fixed body::before dark layer is a common landing-page backdrop).
  bands = [document.documentElement, document.body, ...all].flatMap((e) => ["::before", "::after"].map((p) => bandOf(e, p)).filter(Boolean));
  const textEls = [];
  for (const el of all) {
    const node = [...el.childNodes].find((n) => n.nodeType === 3 && n.textContent.trim().length > 1);
    if (node && visible(el)) { const range = document.createRange(); range.selectNodeContents(node); textEls.push({ el, range }); }
  }
  // contrast: el → [min, max] ratio (equal for a solid backdrop) or null when it cannot be bounded.
  const contrast = new Map();
  const H = () => document.documentElement.scrollHeight;
  let scanned = 0; const deadline = performance.now() + o.scanMs; // stop early and say so, rather than lose the whole check
  for (let y = 0, i = 0; i < o.scrollSteps && y < H() && performance.now() < deadline; y += vh * 0.8, i++) {
    // instant: html{scroll-behavior:smooth} would still be animating when the screen is measured (real 84k px page).
    scrollTo({ top: y, left: 0, behavior: "instant" }); await sleep(i < 40 ? 120 : 40); scanned = Math.min(H(), y + vh);
    for (const t of textEls) {
      if (contrast.has(t.el)) continue;
      const r = t.range.getClientRects()[0]; if (!r || r.top < 0 || r.bottom > vh || r.left < 0 || r.right > vw) continue;
      const bg = backdrop(t.el, r.left + r.width / 2, r.top + r.height / 2);
      if (bg === undefined) continue;
      const s = cs(t.el); let fg = rgba(s.color);
      if (bg === null || !fg || fg[3] === 0 || t.el.closest(":disabled,[aria-disabled=true]")) { contrast.set(t.el, null); continue; }
      const solid = bg.lo.every((v, k) => v === bg.hi[k]);
      if (fg[3] < 1) { if (!solid) { contrast.set(t.el, null); continue; } fg = blend(fg, bg.lo); }
      const x = solid ? ratio(fg, bg.lo) : null;
      contrast.set(t.el, solid ? [x, x] : ratioRange(fg, bg)); // raw: 4.495 must fail 4.5
    }
  }
  scrollTo({ top: 0, left: 0, behavior: "instant" }); await sleep(300);

  // 3. Static facts.
  const texts = [], fam = {}, size = {}, tcol = {}, bgc = {}, markers = [], cards = new Set(), blurs = [], transitionAll = [], easeIn = [], durations = [];
  const tally = (m, k, w) => { m[k] = (m[k] || 0) + w; };
  const top = (m, n) => Object.entries(m).sort((a, b) => b[1] - a[1]).slice(0, n).map(([v, c]) => ({ v, c: Math.round(c) }));
  const split = (v) => v.split(/,(?![^(]*\))/).map((x) => x.trim());
  const ms = (v) => (v.endsWith("ms") ? parseFloat(v) : parseFloat(v) * 1000) || 0;
  const easeInFn = (fn) => fn === "ease-in" || (/^cubic-bezier/.test(fn) && (([x1, y1, x2, y2]) => x1 > 0.2 && y1 < 0.1 && x2 >= 0.9 && y2 >= 0.9)(fn.match(/-?[\d.]+/g).map(Number)));
  for (const { el } of textEls) {
    const s = cs(el), px = parseFloat(s.fontSize), w = parseInt(s.fontWeight, 10), chars = el.textContent.trim().length;
    // letter-spacing computes to "normal" or px; only display sizes carry it (D2).
    const em = px >= o.displayPx && s.letterSpacing !== "normal" ? parseFloat(s.letterSpacing) / px : null;
    const cr = contrast.get(el) || null, exact = cr && cr[0] === cr[1];
    texts.push({ el: label(el), px, weight: w, em, ratio: exact ? cr[0] : null, ...(cr && !exact ? { range: cr } : {}), large: px >= 24 || (px >= 18.66 && w >= 700),
      exempt: !!el.closest(":disabled,[aria-disabled=true]"),
      prose: /^(P|LI|DD|BLOCKQUOTE|TD)$/.test(el.tagName) && !inChrome(el), chars });
    tally(fam, s.fontFamily.split(",")[0].replace(/["']/g, "").trim(), chars); tally(size, s.fontSize, chars); tally(tcol, s.color, chars);
    // Badge/chip: short non-interactive painted label.
    const r = el.getBoundingClientRect(), bg = rgba(s.backgroundColor);
    const painted = (bg && bg[3] > 0.1 && ratio(bg, ancestorBg(el.parentElement || el)) > 1.1) || parseFloat(s.borderTopWidth) >= 1;
    if (chars <= 24 && r.height <= 32 && r.width <= 200 && painted && parseFloat(s.borderTopLeftRadius) >= 2 && !interactive(el) && !/^H[1-6]$/.test(el.tagName))
      markers.push({ el: label(el), bucket: bucket(el) });
  }
  for (const el of all) {
    if (!visible(el)) continue;
    const s = cs(el), r = el.getBoundingClientRect();
    const b = rgba(s.backgroundColor); if (b && b[3] > 0 && r.width * r.height > vw * vh * 0.01) tally(bgc, s.backgroundColor, r.width * r.height);
    for (const p of [s.filter, s.backdropFilter]) { const m = /blur\(([\d.]+)px\)/.exec(p || ""); if (m) blurs.push({ el: label(el), px: +m[1] }); }
    const tp = split(s.transitionProperty), td = split(s.transitionDuration).map(ms), tf = split(s.transitionTimingFunction);
    const big = r.width * r.height >= vw * vh * o.largeArea;
    let longest = 0;
    tp.forEach((p, i) => { const d = td[i % td.length]; if (!d) return; longest = Math.max(longest, d);
      if (p === "all" && transitionAll.length < 30) transitionAll.push(label(el));
      if (easeInFn(tf[i % tf.length]) && easeIn.length < 30) easeIn.push({ el: label(el), v: `transition ${p} ${tf[i % tf.length]}` }); });
    if (s.animationName !== "none") {
      const ad = split(s.animationDuration).map(ms), ai = split(s.animationIterationCount), af = split(s.animationTimingFunction);
      split(s.animationName).forEach((n, i) => { if (ai[i % ai.length] !== "infinite") longest = Math.max(longest, ad[i % ad.length]);
        if (easeInFn(af[i % af.length]) && easeIn.length < 30) easeIn.push({ el: label(el), v: `animation ${n} ${af[i % af.length]}` }); });
    }
    if (longest && durations.length < 60) durations.push({ el: label(el), ms: Math.round(longest), large: big });
    // Card: a box with border on all sides, a shadow, or a fill different from what is behind it.
    if (r.width >= 80 && r.height >= 40 && r.width < vw - 2 && !interactive(el) && !MEDIA.has(el.tagName)
      && !/^(TABLE|THEAD|TBODY|TFOOT|TR|TD|TH|PRE|CODE|DIALOG|HTML|BODY)$/.test(el.tagName) && !el.closest("table,dialog,[role=dialog]") && el.textContent.trim()) {
      const border = ["Top", "Right", "Bottom", "Left"].every((k) => parseFloat(s[`border${k}Width`]) >= 1 && s[`border${k}Style`] !== "none");
      const fill = b && b[3] >= 0.1 && el.parentElement && ratio(blend(b, ancestorBg(el.parentElement)), ancestorBg(el.parentElement)) > 1.05;
      if (border || s.boxShadow !== "none" || fill) cards.add(el);
    }
  }
  const nestedCards = [];
  for (const c of cards) { for (let p = c.parentElement; p; p = p.parentElement) if (cards.has(p)) { nestedCards.push({ el: label(c), outer: label(p) }); break; }
    if (nestedCards.length >= 20) break; }

  const targets = [], controls = [];
  const inlineLink = (a) => a.tagName === "A" && [...(a.parentElement ? a.parentElement.childNodes : [])].some((n) => n !== a && n.nodeType === 3 && n.textContent.trim());
  for (const el of document.querySelectorAll("a[href],button,input:not([type=hidden]),select,textarea,summary,[role=button],[role=link],[role=tab],[role=checkbox],[role=menuitem]")) {
    if (!visible(el) || inlineLink(el)) continue;
    if (/^(checkbox|radio)$/.test(el.type) && (el.closest("label") || (el.id && document.querySelector(`label[for="${CSS.escape(el.id)}"]`)))) continue;
    // WCAG 2.5.8 user-agent exception: a native checkbox/radio still at the browser's own size (13px in Chromium).
    // lazy: an author rule that sets exactly 13px is also exempt; upgrade = compare against a pristine control.
    if (/^(checkbox|radio)$/.test(el.type) && cs(el).appearance !== "none") {
      const r = el.getBoundingClientRect(); if (Math.abs(r.width - 13) < 0.5 && Math.abs(r.height - 13) < 0.5) continue; }
    const r = el.getBoundingClientRect();
    targets.push({ el: label(el), x: Math.round(r.left), y: Math.round(r.top + scrollY), w: Math.round(r.width), h: Math.round(r.height) });
    if (/^(SELECT|TEXTAREA)$/.test(el.tagName) || (el.tagName === "INPUT" && !/^(checkbox|radio|submit|button|reset|range|color|file|image)$/.test(el.type)))
      controls.push({ el: label(el), px: parseFloat(cs(el).fontSize) });
  }

  const images = [...document.images].filter((i) => i.getBoundingClientRect().width > 1).map((i) => { const r = i.getBoundingClientRect();
    return { el: label(i), src: i.currentSrc || i.src, alt: i.getAttribute("alt"), w: Math.round(r.width), h: Math.round(r.height) }; });

  // Hero: the block around the first h1, up to (not including) a parent that holds another heading.
  let hero = null, heroEl = null;
  const h1 = document.querySelector("h1");
  if (h1 && visible(h1)) {
    heroEl = h1;
    while (heroEl.parentElement && heroEl.parentElement !== document.body && heroEl.parentElement.tagName !== "MAIN"
      && heroEl.parentElement.querySelectorAll("h1,h2,h3,h4,h5,h6").length <= 1 && heroEl.parentElement.getBoundingClientRect().height <= vh * 2) heroEl = heroEl.parentElement;
    const r = heroEl.getBoundingClientRect();
    hero = { el: label(heroEl).slice(0, 30), h: Math.round(r.height), bottom: Math.round(r.bottom + scrollY) };
  }
  const fixedAncestor = (el) => { for (let e = el; e && e !== document.body; e = e.parentElement) if (/fixed|sticky/.test(cs(e).position)) return true; return false; };
  const contactLinks = [...document.querySelectorAll("a[href]")].filter((a) => CONTACT.test(a.getAttribute("href").trim()) && visible(a));
  const repeated = (a) => { for (let e = a.parentElement, i = 0; e && e.parentElement && i < 6; e = e.parentElement, i++) {
      const sib = [...e.parentElement.children].filter((s) => s.tagName === e.tagName && s.className === e.className);
      if (sib.length >= 3 && sib.filter((s) => contactLinks.some((c) => s.contains(c))).length >= 2) return true; } return false; };
  const greenIn = (a) => [a, ...a.querySelectorAll("*")].some((e) => { const c = rgba(cs(e).backgroundColor); if (!c || c[3] < 0.5) return false;
    const { h, s, l } = hsl(c); return h >= 130 && h <= 155 && s >= 0.5 && l >= 0.3 && l <= 0.65; });
  const contacts = contactLinks.map((a) => { const placement = [];
    if (a.closest(`${BANNER},nav,[role=navigation]`)) placement.push("header/nav");
    if (fixedAncestor(a)) placement.push("fixed/sticky");
    if (a.closest("dialog,[role=dialog]")) placement.push("dialog");
    if (heroEl && heroEl.contains(a) && docTop(a) < vh) placement.push("hero");
    if (repeated(a)) placement.push("repeated items");
    return { el: label(a), href: a.getAttribute("href").slice(0, 60), placement, green: /whatsapp|wa\.me/i.test(a.href) && greenIn(a) }; });

  const floating = [];
  for (const el of all) { if (cs(el).position !== "fixed" || !visible(el)) continue;
    const r = el.getBoundingClientRect();
    if (r.width <= 160 && r.height <= 160 && vh - r.bottom <= 48 && (r.left <= 48 || vw - r.right <= 48)
      && (el.tagName === "IFRAME" || el.querySelector("iframe") || contactLinks.some((c) => el === c || el.contains(c))
        || /chat|whatsapp|messenger|intercom|tawk|crisp|livechat|zendesk/i.test(`${el.id} ${el.className}`))) floating.push(label(el)); }

  const blank = [...document.querySelectorAll("a[target=_blank]")].filter((a) => !/\bno(opener|referrer)\b/i.test(a.rel))
    .map((a) => ({ el: label(a), rel: a.rel })).slice(0, 30);
  const placeholders = [...new Set((document.body.innerText.match(o.placeholderRe) || []).map((m) => m.toLowerCase()))].slice(0, 5);

  // Cookie/consent banners are not the page's actions.
  const consent = (el) => { for (let e = el; e && e !== document.body; e = e.parentElement)
    if (/cookie|consent|gdpr/i.test(`${e.id} ${typeof e.className === "string" ? e.className : ""} ${e.getAttribute("aria-label") || ""}`)) return true; return false; };
  const buttons = [];
  for (const el of document.querySelectorAll("button,[role=button],input[type=submit],input[type=button],a[href]")) {
    if (!visible(el) || inlineLink(el) || !(el.textContent || el.value || "").trim() || consent(el)) continue;
    const s = cs(el), bg = rgba(s.backgroundColor);
    const filled = (bg && bg[3] >= 0.5) || s.backgroundImage.includes("gradient");
    if (el.tagName === "A" && !(filled || (parseFloat(s.borderTopWidth) >= 1 && parseFloat(s.paddingLeft) >= 8))) continue;
    const primary = s.backgroundImage.includes("gradient") || (bg && bg[3] >= 0.5 && ratio(bg, ancestorBg(el.parentElement || el)) >= 2);
    buttons.push({ el: label(el), bucket: bucket(el), primary: !!primary });
  }

  let firstViewportWords = 0;
  const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
  const vis = new Map();
  for (let n = walker.nextNode(); n; n = walker.nextNode()) {
    const t = n.textContent.trim(); if (!t || !n.parentElement) continue;
    const p = n.parentElement; if (!vis.has(p)) vis.set(p, visible(p)); if (!vis.get(p)) continue;
    const range = document.createRange(); range.selectNodeContents(n); const r = range.getBoundingClientRect();
    if (r.top < vh && r.bottom > 0) firstViewportWords += t.split(/\s+/).length;
  }
  // Rendered lines = distinct line-box tops of the element's visible text (icons and padding ignored).
  const lines = (el) => { const tops = new Set(), w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    for (let n = w.nextNode(); n; n = w.nextNode()) { if (!n.textContent.trim()) continue; const r = document.createRange(); r.selectNodeContents(n);
      for (const q of r.getClientRects()) if (q.width > 1 && q.height > 1) tops.add(Math.round(q.top / 4)); }
    return Math.max(1, tops.size); };
  const words = (el) => el.textContent.trim().split(/\s+/).filter(Boolean).length;
  const h1s = [...document.querySelectorAll("h1")].filter(visible).map((h) => ({ el: label(h), words: words(h), lines: lines(h) }));
  // Heading outline: a level jump of more than one (h1 → h3) in visible document order.
  const headingSkips = []; let prevLevel = 0;
  for (const h of document.querySelectorAll("h1,h2,h3,h4,h5,h6")) { if (!visible(h)) continue; const lv = +h.tagName[1];
    if (prevLevel && lv > prevLevel + 1 && headingSkips.length < 20) headingSkips.push({ el: label(h), v: `h${prevLevel} → h${lv}` }); prevLevel = lv; }
  const navScope = "nav,[role=navigation],[role=tablist],aside";
  const navLabels = [...document.querySelectorAll(`:is(${navScope}) :is(a,button,[role=tab])`)]
    .filter((e) => visible(e) && !e.closest("footer,[role=contentinfo]") && e.textContent.trim())
    .map((e) => ({ el: label(e), chars: e.textContent.trim().replace(/\s+/g, " ").length, lines: lines(e) })).slice(0, 80);
  const navGroups = [...document.querySelectorAll(`:is(${navScope}) :is(ul,ol)`)].filter((l) => visible(l) && !l.closest("footer,[role=contentinfo]"))
    .map((l) => ({ el: label(l).slice(0, 30), items: [...l.children].filter((c) => c.tagName === "LI" && visible(c)).length }));
  const emphasis = [...document.querySelectorAll("p,li")].filter((p) => visible(p) && !inChrome(p)).map((p) => {
    const runs = p.querySelectorAll("strong,b,mark").length, w = words(p);
    const boldText = [...p.querySelectorAll("strong,b")].map((b) => b.textContent.trim()).join(" ");
    return { el: label(p), runs, words: w, allBold: parseInt(cs(p).fontWeight, 10) >= 600 || (runs === 1 && boldText === p.textContent.trim()) };
  }).filter((e) => e.runs > 0 || e.allBold).slice(0, 200);
  const carriers = [...document.querySelectorAll("h2,h3,h4,h5,h6,li")].filter((e) => visible(e) && !inChrome(e));
  const withIcon = carriers.filter((e) => [...e.querySelectorAll("svg,img,i,[class*=icon]")].some((i) => { const r = i.getBoundingClientRect(); return r.width > 0 && r.width <= 48 && r.height <= 48; })).length;
  const tiles = all.filter((el) => { if (!visible(el)) return false; const r = el.getBoundingClientRect(), s = cs(el);
    return r.width >= 20 && r.width <= 64 && Math.abs(r.width - r.height) <= 4 && parseFloat(s.borderTopLeftRadius) > 0 && colourful(s.backgroundColor)
      && el.querySelector("svg,img") && !el.textContent.trim() && !interactive(el); }).map(label).slice(0, 20);
  const hrefs = [...document.querySelectorAll("a[href]")].filter((a) => visible(a) && !inChrome(a) && !/^(#|javascript:)/i.test(a.getAttribute("href").trim()))
    .map((a) => a.href);
  const outbound = [...document.querySelectorAll("a[href]")].filter((a) => /^https?:$/.test(a.protocol) && a.host !== location.host).length;

  Object.assign(f, {
    scrollWidth: Math.max(document.documentElement.scrollWidth, innerWidth),
    overflowClipped: [document.documentElement, document.body].some((e) => /hidden|clip/.test(cs(e).overflowX)),
    overflowEls: all.filter((el) => { const r = el.getBoundingClientRect(); return r.right > vw + 1 && r.width > 0 && visible(el); }).slice(0, 3).map(label),
    texts: texts.slice(0, 2000), targets: targets.slice(0, 600), controls, images: images.slice(0, 300), contacts, floating, blank, placeholders,
    buttons, firstViewportWords, h1s, navLabels, navGroups, markers: markers.slice(0, 200), emphasis, icons: { total: carriers.length, withIcon, tiles },
    nestedCards, hero, hrefs: hrefs.slice(0, 1000), blurs: blurs.slice(0, 30), transitionAll, easeIn, durations, scanned, headingSkips,
    ref: { height: H(), title: document.title.slice(0, 80), fonts: top(fam, 4), sizes: top(size, 8), palette: { text: top(tcol, 6), background: top(bgc, 6) },
      navLabels: navLabels.map((l) => l.chars), buttons: buttons.length, primaryButtons: buttons.filter((b) => b.primary).length,
      outboundLinks: outbound, images: images.length, h1: h1s[0] || null },
  });
  return f;
}

// Under emulated prefers-reduced-motion: animations that still move or resize things.
function pageReducedMotion(o) {
  const MOVE = /^(transform|translate|rotate|scale|width|height|top|left|right|bottom|margin.*|inset.*|offsetPath|offsetDistance)$/;
  const out = [];
  for (const a of document.getAnimations()) {
    const t = a.effect && a.effect.target; if (a.playState !== "running" || !t || !t.isConnected) continue;
    const r = t.getBoundingClientRect(); if (r.width < o.tinyPx && r.height < o.tinyPx) continue;
    const props = [...new Set((a.effect.getKeyframes ? a.effect.getKeyframes() : []).flatMap((k) => Object.keys(k)).filter((k) => MOVE.test(k)))];
    if (props.length) out.push({ el: t.tagName.toLowerCase() + (t.className && typeof t.className === "string" ? "." + t.className.split(/\s+/)[0] : ""), props: props.join(", ") });
  }
  return out.slice(0, 20);
}

const pageOpts = () => ({ loopMaxMs: LOOP_MAX_MS, tinyPx: MOTION_TINY_PX, largeArea: LARGE_AREA_RATIO, placeholderRe: PLACEHOLDER_RE, displayPx: DISPLAY_PX, scrollSteps: SCROLL_STEPS, scanMs: SCAN_MS });
// Page functions run via Runtime.evaluate as source text (our own code, not page input).
// RegExp cannot cross JSON, so it is rebuilt in the page.
const call = (fn, arg) => {
  const json = JSON.stringify(arg, (k, v) => (v instanceof RegExp ? { __re: v.source, flags: v.flags } : v));
  const helpers = `const relLum = ${relLum}; const contrastRatio = ${contrastRatio}; const blendOver = ${blendOver};`;
  return `(() => { ${helpers} return (${fn.toString()})(JSON.parse(${JSON.stringify(json)}, (k, v) => v && v.__re ? new RegExp(v.__re, v.flags) : v)); })()`;
};

async function navigate(b, url, vp, label, assertAllowed = () => {}) {
  await b.send("Emulation.setDeviceMetricsOverride", { width: vp.width, height: vp.height, deviceScaleFactor: 1, mobile: vp.mobile });
  await b.send("Emulation.setTouchEmulationEnabled", vp.width < 768 ? { enabled: true, maxTouchPoints: 5 } : { enabled: false });
  const loaded = b.once("Page.loadEventFired", 30000);
  const docs = [], stop = b.on((m) => { if (m.method === "Network.responseReceived" && m.params.type === "Document") docs.push(m.params); });
  try {
    const nav = await within(b.send("Page.navigate", { url }), 30000);
    assertAllowed();
    if (nav && nav.errorText) throw new Error(`could not load ${url}: ${nav.errorText}`);
    if (!(await loaded)) process.stderr.write(`dotuiux: ${label} ${vp.width}px load event not seen in 30s; measuring what rendered\n`);
    // An error page renders fine and would pass every gate.
    const doc = docs.find((d) => nav && d.loaderId === nav.loaderId) || docs[0];
    if (doc && doc.response.status >= 400) throw new Error(`HTTP ${doc.response.status} for ${url}`);
  } finally { stop(); }
  await sleep(SETTLE_MS);
  assertAllowed(); // a script or meta refresh may navigate during the settle
}

async function evalIn(b, expression, what) {
  const r = await within(b.send("Runtime.evaluate", { expression, awaitPromise: true, returnByValue: true }), EVAL_TIMEOUT_MS);
  if (!r) throw new Error(`${what} timed out after ${EVAL_TIMEOUT_MS / 1000}s`);
  const { result, exceptionDetails } = r;
  if (exceptionDetails) throw new Error(`${what} failed: ${exceptionDetails.exception?.description ?? exceptionDetails.text}`);
  return result.value;
}

// Kills the browser if the process dies mid-render (ui-ref only cleans up on SIGINT/SIGTERM).
let closeBrowser = null;

const galleryHost = (host) => GALLERY_HOST_RE.test(host.replace(/\.$/, ""));
const GALLERY_REFUSAL = "Galleries are owner-picked mood, not teardown targets; tear down live shipped sites instead.";

// Render url at each viewport; onViewport(browser, facts, vp) may take screenshots.
// refuseHost(hostname): main-frame documents on such hosts — redirect hops included — are
// blocked before any request leaves the browser, and the render stops with an error.
async function render(target, { reducedMotion = false, onViewport, refuseHost } = {}) {
  const { withBrowser } = await loadUiRef();
  const facts = [];
  const served = await serveFile(target), url = served.url;
  try { await withBrowser(async (b) => {
    closeBrowser = b.close;
    // alert()/confirm() would block every later DevTools call: accept them.
    b.on((m) => { if (m.method === "Page.javascriptDialogOpening") b.send("Page.handleJavaScriptDialog", { accept: true }).catch(() => {}); });
    await b.send("Network.enable");
    let refused = null;
    const assertAllowed = () => { if (refused) throw new Error(`refusing gallery URL ${refused} (reached from ${target}). ${GALLERY_REFUSAL}`); };
    if (refuseHost) {
      const main = (await b.send("Page.getFrameTree")).frameTree.frame.id;
      b.on((m) => {
        if (m.method !== "Fetch.requestPaused") return;
        const { requestId, request, frameId } = m.params;
        let host = ""; try { host = new URL(request.url).hostname; } catch {}
        if (frameId === main && refuseHost(host)) { refused ||= request.url; b.send("Fetch.failRequest", { requestId, errorReason: "BlockedByClient" }).catch(() => {}); }
        else b.send("Fetch.continueRequest", { requestId }).catch(() => {});
      });
      await b.send("Fetch.enable", { patterns: [{ resourceType: "Document", requestStage: "Request" }] });
    }
    await b.send("Page.addScriptToEvaluateOnNewDocument", { source: `(${pageRecorder.toString()})()` });
    for (const vp of VIEWPORTS) {
      await navigate(b, url, vp, "", assertAllowed);
      const f = await evalIn(b, call(pageCollect, { ...pageOpts(), width: vp.width, height: vp.height }), `measurement at ${vp.width}px`);
      assertAllowed();
      if (onViewport) await onViewport(b, f, vp);
      facts.push(f);
    }
    if (reducedMotion) {
      const vp = VIEWPORTS.find((v) => v.width === REDUCED_MOTION_WIDTH);
      await b.send("Emulation.setEmulatedMedia", { features: [{ name: "prefers-reduced-motion", value: "reduce" }] });
      await navigate(b, url, vp, "reduced-motion", assertAllowed);
      facts.find((f) => f.width === vp.width).reducedMotion = await evalIn(b, call(pageReducedMotion, pageOpts()), "reduced-motion probe");
      await b.send("Emulation.setEmulatedMedia", { features: [] });
    }
  }, { throwOnUnavailable: true }); } finally { closeBrowser = null; served.close(); }
  return facts;
}

// ---- commands ------------------------------------------------------------------------
function usage(exitCode = 0) {
  const text = `Usage: dotuiux <subcommand> [options]

Non-slop UI/UX workflow: brief → references → DESIGN.md → build → check.

Subcommands:
  init [dir]
      Scaffold design/brief.md, design/refs/, and DESIGN.md (tokens + allow: overrides).
      Never overwrites existing files.

  teardown <url...> [--out design/refs]
      Screenshots at ${VIEWPORTS.map((v) => v.width).join("/")} and facts.json per URL (fonts, sizes, palette,
      nav label lengths, buttons, outbound links, images) into <out>/<host>/. Research input, not judgement.
      Gallery hosts (dribbble, behance, v0, awwwards, regards.design, pinterest) are refused, also when a
      redirect or script lands there (e.g. pin.it share links): mood is owner-picked.

  check <url|file> [--design DESIGN.md] [--json] [--checkout-handoff]
      Render at ${VIEWPORTS.map((v) => v.width).join("/")} (+ reduced motion at ${REDUCED_MOTION_WIDTH}) and run the gates.
      FAIL = floor, harm only (exit 1). WARN = slop signal; "allow: <id> — <reason>" in DESIGN.md
      reports it as allowed. NOT CHECKED = could not be measured on this page.
      --checkout-handoff: only for the step where WhatsApp IS the task's action (D9). One wa.me /
      api.whatsapp.com / whatsapp: link may sit in the hero; header/nav, fixed/sticky, floating,
      dialog and repeated placements still FAIL, and the page still allows one contact link.
      Floor: ${FLOOR_IDS.join(", ")}
      Warn:  ${WARN_IDS.join(", ")}
      blur escalates: > ${BLUR_WARN_PX}px warns, > ${BLUR_FAIL_PX}px fails (allow: blur covers only the warn band).

  validate [dir]
      Check design/brief.md and DESIGN.md exist with required headings and well-formed allow: lines.

  help
      Show this help.

Browser: ui-ref.mjs from $DOTFILES, this checkout, or ~/dotfiles (skills/local/design-taste/scripts); Chrome via $CHROME_BIN or auto-detect.
Exit: 0 ok, 1 FAIL gate / invalid project, 2 usage or error, 3 no working browser.
`;
  (exitCode === 0 ? process.stdout : process.stderr).write(text);
  process.exit(exitCode);
}

class UsageError extends Error {}

function parse(argv, flags) {
  const pos = [], opts = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (!a.startsWith("--")) { pos.push(a); continue; }
    if (!(a in flags)) throw new UsageError(`unknown option: ${a}`);
    if (flags[a]) { const v = argv[++i]; if (v == null) throw new UsageError(`${a} requires a value`); opts[a] = v; } else opts[a] = true;
  }
  return { pos, opts };
}

function cmdInit(argv) {
  const { pos } = parse(argv, {});
  if (pos.length > 1) throw new UsageError("init takes at most one directory");
  const root = path.resolve(pos[0] || ".");
  fs.mkdirSync(path.join(root, "design", "refs"), { recursive: true });
  for (const [rel, body] of [["design/brief.md", BRIEF_TEMPLATE], ["DESIGN.md", DESIGN_TEMPLATE]]) {
    const file = path.join(root, rel);
    try { fs.writeFileSync(file, body, { flag: "wx" }); console.log(`created ${file}`); }
    catch (e) { if (e.code !== "EEXIST") throw e; console.log(`kept    ${file} (exists)`); }
  }
  console.log(`ready   ${path.join(root, "design", "refs")}/\nnext: fill design/brief.md, then dotuiux teardown <3-5 urls>`);
}

function cmdValidate(argv) {
  const { pos } = parse(argv, {});
  const dir = path.resolve(pos[0] || ".");
  const r = validateProject(dir);
  for (const e of r.errors) console.error(`  ✗ ${e}`);
  for (const w of r.warnings) console.log(`  ⚠ ${w}`);
  console.log(r.ok ? `validate PASSED for ${dir}` : `validate FAILED for ${dir}`);
  process.exit(r.ok ? 0 : 1);
}

function refDir(out, url) {
  const u = new URL(url);
  const host = u.protocol === "file:" ? path.basename(u.pathname).replace(/\.[^.]+$/, "") : u.host.replace(/\.(?=:|$)/, "").replace(/:/g, "_");
  const slug = u.protocol === "file:" ? "" : u.pathname.replace(/^\/+|\/+$/g, "").replace(/[^a-z0-9]+/gi, "-").slice(0, 40);
  return path.join(out, slug ? `${host}-${slug}` : host);
}

async function cmdTeardown(argv) {
  const { pos, opts } = parse(argv, { "--out": true });
  if (!pos.length) throw new UsageError("teardown requires at least one URL");
  const out = path.resolve(opts["--out"] || "design/refs");
  const urls = pos.map(toUrl);
  const galleries = urls.filter((u) => galleryHost(new URL(u).hostname));
  if (galleries.length) throw new UsageError(`refusing gallery URL(s): ${galleries.join(", ")}. ${GALLERY_REFUSAL}`);
  for (const url of urls) {
    const dir = refDir(out, url);
    const viewports = {};
    // The directory is created on the first capture, so a refused redirect leaves nothing behind;
    // a later failure (e.g. a timer that reaches a gallery after 360 px) removes a directory this run created.
    // lazy: a pre-existing dir keeps whatever this run overwrote; upgrade = capture into a temp dir and rename.
    const existed = fs.existsSync(dir);
    try {
      await render(url, { refuseHost: galleryHost, onViewport: async (b, f, vp) => {
        fs.mkdirSync(dir, { recursive: true });
        const shot = await b.send("Page.captureScreenshot", { format: "png", captureBeyondViewport: true,
          clip: { x: 0, y: 0, width: vp.width, height: Math.min(f.ref.height, 16000), scale: 1 } });
        fs.writeFileSync(path.join(dir, `${vp.width}.png`), Buffer.from(shot.data, "base64"));
        viewports[vp.width] = f.ref;
      } });
    } catch (e) { if (!existed) fs.rmSync(dir, { recursive: true, force: true }); throw e; }
    fs.writeFileSync(path.join(dir, "facts.json"), JSON.stringify({ url, capturedAt: new Date().toISOString(), viewports }, null, 2) + "\n");
    const d = viewports[1440] || Object.values(viewports)[0];
    console.log(`${url}\n  → ${dir}/ (facts.json, ${Object.keys(viewports).map((w) => `${w}.png`).join(", ")})`);
    console.log(`  fonts ${d.fonts.map((x) => x.v).join(" / ")} · h1 ${d.h1 ? d.h1.words + " words" : "-"} · buttons ${d.buttons} (${d.primaryButtons} primary) · outbound ${d.outboundLinks} · images ${d.images}`);
  }
}

function report(url, results, notes, handoff = false) {
  const L = [`dotuiux check ${url}`, `viewports ${VIEWPORTS.map((v) => v.width).join("/")} · reduced motion at ${REDUCED_MOTION_WIDTH}`];
  if (handoff) L.push("mode: --checkout-handoff (D9): one WhatsApp link may sit in the hero; other contact rules unchanged");
  L.push("");
  const order = { fail: 0, warn: 1, allowed: 2, "not-checked": 3, pass: 4 };
  for (const r of [...results].sort((a, b) => order[a.status] - order[b.status])) {
    if (r.status === "pass") continue;
    const tag = r.status.toUpperCase().replace("-", " ");
    L.push(`${tag.padEnd(11)} ${r.id.padEnd(20)} ${r.desc} (${r.spec})`);
    if (r.status === "allowed") L.push(`            allowed: ${r.reason}`);
    if (r.unmeasuredAt) L.push(`            not measured at ${r.unmeasuredAt.join("/")}px`);
    if (r.status === "fail" || r.status === "warn") {
      for (const o of r.offenders.slice(0, 5)) L.push(`            ${o.widths.join("/")}px ${o.el} — ${o.v}`);
      if (r.offenders.length > 5) L.push(`            … ${r.offenders.length - 5} more`);
    }
  }
  const pass = results.filter((r) => r.status === "pass").map((r) => r.id);
  if (pass.length) L.push(`PASS        ${pass.join(", ")}`);
  for (const n of notes) L.push(`note: ${n}`);
  const c = (s) => results.filter((r) => r.status === s).length;
  L.push("", `summary: ${c("fail")} fail · ${c("warn")} warn · ${c("allowed")} allowed · ${c("not-checked")} not checked · ${c("pass")} pass`);
  L.push("Gates measure harm and slop signals, not taste: review the live render before sign-off.");
  return L.join("\n") + "\n";
}

async function cmdCheck(argv) {
  const { pos, opts } = parse(argv, { "--design": true, "--json": false, "--checkout-handoff": false });
  const handoff = !!opts["--checkout-handoff"];
  if (pos.length !== 1) throw new UsageError("check requires exactly one URL or file");
  const url = toUrl(pos[0]);
  const designPath = opts["--design"] || (fs.existsSync("DESIGN.md") ? "DESIGN.md" : null);
  if (opts["--design"] && !fs.existsSync(designPath)) throw new Error(`--design file not found: ${designPath}`);
  const notes = [];
  let allows = new Map();
  if (designPath) {
    const p = parseAllows(fs.readFileSync(designPath, "utf8"));
    allows = p.allows;
    for (const e of p.errors) notes.push(`${designPath} ${e} — ignored`);
  }
  const facts = await render(url, { reducedMotion: true });
  for (const f of facts) if (f.overflowClipped && f.scrollWidth > f.width + 1)
    notes.push(`overflow-x not checked at ${f.width}px: html/body overflow-x hidden/clip hides ${f.scrollWidth - f.width}px of content (mobile browsers may still pan to it); check off-canvas elements by hand`);
  for (const f of facts) {
    if (f.scanned && f.ref && f.scanned < f.ref.height) notes.push(`contrast scan stopped at ${f.scanned}px of a ${f.ref.height}px page at ${f.width}px (limit ${SCROLL_STEPS} screens / ${SCAN_MS / 1000}s); text below it is not measured`);
    const u = (f.texts || []).filter((t) => contrastVerdict(t) == null && !t.exempt);
    if (u.length) notes.push(`contrast not measured at ${f.width}px for ${u.length} text element(s) over an image, gradient, video, overlay, or off-screen: ${u.slice(0, 3).map((t) => t.el).join(", ")}${u.length > 3 ? ", …" : ""}; check them by hand`);
  }
  const results = evaluate(facts, allows, { checkoutHandoff: handoff });
  if (opts["--json"]) {
    const c = (s) => results.filter((r) => r.status === s).length;
    console.log(JSON.stringify({ url, design: designPath, checkoutHandoff: handoff, viewports: VIEWPORTS.map((v) => v.width), results, notes,
      summary: { fail: c("fail"), warn: c("warn"), allowed: c("allowed"), notChecked: c("not-checked"), pass: c("pass") } }, null, 2));
  } else process.stdout.write(report(url, results, notes, handoff));
  process.exit(results.some((r) => r.status === "fail") ? 1 : 0);
}

async function main() {
  const [sub, ...rest] = process.argv.slice(2);
  if (!sub || sub === "help" || sub === "-h" || sub === "--help") usage(0);
  try {
    switch (sub) {
      case "init": cmdInit(rest); break;
      case "teardown": await cmdTeardown(rest); break;
      case "check": await cmdCheck(rest); break;
      case "validate": cmdValidate(rest); break;
      default: console.error(`Unknown subcommand: ${sub}`); usage(2);
    }
  } catch (err) {
    if (err.code === "BROWSER_UNAVAILABLE") { console.error(`dotuiux: ${err.message}`); process.exit(3); }
    console.error(`dotuiux error: ${err.message}`);
    if (err instanceof UsageError) console.error("Run: dotuiux help");
    process.exit(2);
  }
}

// CLI only when run directly, so tests can import the pure parts.
if (process.argv[1] && import.meta.url === pathToFileURL(fs.realpathSync(process.argv[1])).href) {
  // A crash is not a FAIL verdict: exit 2, and never leave Chrome running.
  process.on("exit", () => { if (closeBrowser) closeBrowser(); }); // its first step (kill) is synchronous
  for (const ev of ["uncaughtException", "unhandledRejection"]) process.on(ev, async (e) => {
    console.error(`dotuiux error: ${e && e.stack ? e.stack : e}`);
    if (closeBrowser) { const c = closeBrowser; closeBrowser = null; await c(); }
    process.exit(2);
  });
  await main();
}
