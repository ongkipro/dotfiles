#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SPIN="$ROOT/skills/local/turnstile-spin"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/turnstile-secret-test.XXXXXX")"
trap 'chmod -R u+w "$TMP" 2>/dev/null || true; rm -rf "$TMP"' EXIT

mkdir -p "$TMP/bin"
cat > "$TMP/bin/curl" <<'MOCK'
#!/usr/bin/env bash
set -euo pipefail
output=""
while [ "$#" -gt 0 ]; do
  if [ "$1" = "-o" ]; then output="$2"; shift 2; else shift; fi
done
body='{"success":true,"result":{"sitekey":"public-sitekey","secret":"NEVER_PRINT_THIS","clearance_level":"no_clearance","domains":["example.com"]}}'
if [ -n "$output" ]; then
  printf '%s' "$body" > "$output"
  printf '200'
else
  printf '%s' "$body"
fi
MOCK
chmod +x "$TMP/bin/curl"

widget_output="$(
  PATH="$TMP/bin:$PATH" CLOUDFLARE_API_TOKEN=test \
    "$SPIN/scripts/widget-create.sh" \
      --account-id account --name project --domains example.com
)"
metadata_output="$(
  PATH="$TMP/bin:$PATH" CLOUDFLARE_API_TOKEN=test \
    "$SPIN/scripts/fetch-secret.sh" \
      --account-id account --sitekey public-sitekey
)"

for output in "$widget_output" "$metadata_output"; do
  case "$output" in
    *NEVER_PRINT_THIS*|*'"secret"'*)
      echo "turnstile-secret-test: secret leaked to stdout" >&2
      exit 1
      ;;
  esac
done

grep -q '"sitekey":"public-sitekey"' <<< "$widget_output"
grep -q '"clearance_level":"no_clearance"' <<< "$metadata_output"
if rg -n 'WIDGET_SECRET|wrangler secret put' "$SPIN/scripts/worker-deploy.sh" >/dev/null; then
  echo "turnstile-secret-test: worker deploy still handles the secret" >&2
  exit 1
fi

echo "turnstile-secret-test: OK"
