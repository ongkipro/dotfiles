#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SPIN="$ROOT/skills/local/turnstile-spin"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/turnstile-secret-test.XXXXXX")"
trap 'chmod -R u+w "$TMP" 2>/dev/null || true; rm -rf "$TMP"' EXIT

mkdir -p "$TMP/bin" "$TMP/capture" "$TMP/runtime/home" "$TMP/runtime/tmp"
LEAK_SENTINEL="synthetic-sensitive-value-${RANDOM}-$$"

cat > "$TMP/bin/curl" <<'MOCK'
#!/usr/bin/env bash
set -euo pipefail
output=""
write_out=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    -o|--output) output="$2"; shift 2 ;;
    -w|--write-out) write_out="$2"; shift 2 ;;
    *) shift ;;
  esac
done
body="$(printf '{"success":true,"result":{"sitekey":"public-sitekey","secret":"%s","clearance_level":"no_clearance","domains":["example.com"]}}' "$LEAK_SENTINEL")"
if [ -n "$output" ]; then
  printf '%s' "$body" > "$output"
  printf '200'
else
  printf '%s' "$body"
  if [ -n "$write_out" ]; then
    printf '\n200'
  fi
fi
MOCK
chmod +x "$TMP/bin/curl"

(
  cd "$TMP/runtime"
  PATH="$TMP/bin:$PATH" \
    HOME="$TMP/runtime/home" \
    TMPDIR="$TMP/runtime/tmp" \
    LEAK_SENTINEL="$LEAK_SENTINEL" \
    CLOUDFLARE_API_TOKEN=test \
    "$SPIN/scripts/widget-create.sh" \
      --account-id account --name project --domains example.com \
      >"$TMP/capture/widget.stdout" 2>"$TMP/capture/widget.stderr"
)
(
  cd "$TMP/runtime"
  PATH="$TMP/bin:$PATH" \
    HOME="$TMP/runtime/home" \
    TMPDIR="$TMP/runtime/tmp" \
    LEAK_SENTINEL="$LEAK_SENTINEL" \
    CLOUDFLARE_API_TOKEN=test \
    "$SPIN/scripts/fetch-secret.sh" \
      --account-id account --sitekey public-sitekey \
      >"$TMP/capture/metadata.stdout" 2>"$TMP/capture/metadata.stderr"
)

for stream in \
  "$TMP/capture/widget.stdout" \
  "$TMP/capture/widget.stderr" \
  "$TMP/capture/metadata.stdout" \
  "$TMP/capture/metadata.stderr"
do
  if grep -Fq -- "$LEAK_SENTINEL" "$stream"; then
    echo "turnstile-secret-test: synthetic secret leaked through captured output" >&2
    exit 1
  fi
done
if grep -R -F -q -- "$LEAK_SENTINEL" "$TMP/runtime"; then
  echo "turnstile-secret-test: synthetic secret persisted in temporary runtime files" >&2
  exit 1
fi
if [[ -s "$TMP/capture/widget.stderr" || -s "$TMP/capture/metadata.stderr" ]]; then
  echo "turnstile-secret-test: successful helpers emitted unexpected stderr" >&2
  exit 1
fi

python3 -I -c '
import json
import sys

actual = json.load(sys.stdin)
expected = {
    "status": "ok",
    "sitekey": "public-sitekey",
    "secret_configuration": "required_by_user",
}
raise SystemExit(0 if actual == expected else 1)
' < "$TMP/capture/widget.stdout"
python3 -I -c '
import json
import sys

actual = json.load(sys.stdin)
expected = {
    "status": "ok",
    "clearance_level": "no_clearance",
    "domains": ["example.com"],
    "secret_configuration": "required_by_user",
}
raise SystemExit(0 if actual == expected else 1)
' < "$TMP/capture/metadata.stdout"

if grep -En 'WIDGET_SECRET|wrangler secret put' "$SPIN/scripts/worker-deploy.sh" >/dev/null; then
  echo "turnstile-secret-test: worker deploy still handles the secret" >&2
  exit 1
fi

echo "turnstile-secret-test: OK"
