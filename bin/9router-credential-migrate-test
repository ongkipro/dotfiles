#!/usr/bin/env bash
# This command moves a live API key between stores. Its test must never read,
# print, or move a real secret: only the refusal paths and the help surface are
# exercised, and the absence of any real credential is itself asserted.
set -uo pipefail
ROOT="${1:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
CMD="$ROOT/bin/9router-credential-migrate"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
f=0; ok(){ printf '  ✓ %s\n' "$1"; }; bad(){ echo "  FAIL $1" >&2; f=$((f+1)); }

# It takes no flags. An unknown one must print usage and fail, not be ignored —
# a credential command that silently accepts an argument it does not understand
# is a command that might act on the wrong store.
out="$(bash "$CMD" --not-a-flag 2>&1)"; rc=$?
[ "$rc" -ne 0 ] && ok "an unknown flag fails rather than being ignored" \
  || bad "an unknown flag was accepted (exit $rc)"
printf '%s' "$out" | grep -qi 'usage' && ok "it prints usage on misuse" || bad "no usage on misuse"

# It is opt-in: running it with no source credential must not invent one.
out2="$(env HOME="$TMP" bash "$CMD" 2>&1)"; rc2=$?
[ "$rc2" -ne 0 ] || printf '%s' "$out2" | grep -qiE 'no|not found|tidak|skip' \
  && ok "with no source credential it declines rather than proceeds" \
  || bad "it proceeded with nothing to migrate"

# The secret must never reach stdout. Assert the command contains no echo of a
# resolved key value — a printed key ends up in scrollback and history.
grep -nE 'echo .*\$(KEY|TOKEN|SECRET)|printf .*\$(KEY|TOKEN|SECRET)' "$CMD" \
  && bad "the script prints a credential value" || ok "no credential value is printed"

# And the test itself must leave no key behind.
[ ! -s "$TMP/.config/ai-local/secrets.env" ] && ok "the fixture holds no secret" \
  || bad "a secret was written into the fixture"

[ "$f" -eq 0 ] && { echo "9router-credential-migrate-test: PASS"; exit 0; }
echo "9router-credential-migrate-test: $f case(s) failed" >&2; exit 1
