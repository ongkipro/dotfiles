#!/usr/bin/env python3
"""Keep docs/DOTFILES_SITEMAP.md complete and its numbers true.

The sitemap is curated prose: groupings and one-line explanations stay
hand-written. What drifted was everything derivable. On 2026-10-25 it still
said 8 devices correctly but omitted lenovo from its table, linked none of
seven commands including ai-workflow-eval, missed a template and fourteen
top-level documents, and five project memories were absent from MEMORY.md.

So only the inventory block between the markers is rendered, and --check
fails when a tracked member of a covered collection is unlinked, when a
project memory is missing from its own index, or when a relative link in the
sitemap resolves to nothing. Each collection has one index: project memory is
listed by config/ai/project-memory/MEMORY.md, so the sitemap links that index
rather than duplicating it. Members are what is on disk and not ignored:
tracked, modified, renamed, or new files all count, deleted tracked paths do
not, so the gate reports the worktree a reader actually sees instead of
rewarding `git add`.

Entries keep the llms.txt shape, `- [name](path): note` or a table row with a
link, so the map is also a dictionary: --find ranks entries against a query
the way aider ranks its repo map, path and name hits over note hits, with the
hand-written "Quick find" intents first. It reads the page; no index or
generated copy exists to drift. An entry without a note cannot be found by
what it does, so --check rejects one.

  system-map              rewrite the inventory block
  system-map --check      exit 1 on a stale block, unlinked member, unindexed
                          memory, broken link or noteless entry; writes nothing
                          (ai-policy-lint)
  system-map --stdout     print the rendered sitemap without writing
  system-map --find T...  print the best entries for the terms (--limit, --json)
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path, PurePosixPath
import re
import subprocess
import sys

SITEMAP = "docs/DOTFILES_SITEMAP.md"
MEMORY_INDEX = "config/ai/project-memory/MEMORY.md"
KELOLA_INDEX = "config/ai/project-memory-kelola/MEMORY.md"
# --find reads these in order; each collection keeps its one index.
SOURCES = (SITEMAP, MEMORY_INDEX, KELOLA_INDEX, "skills/local/README.md")
START = "<!-- system-map:inventory:start (rendered by bin/system-map; do not edit) -->"
END = "<!-- system-map:inventory:end -->"
LINK = re.compile(r"\]\(([^)\s]+)\)")
NAMED_LINK = re.compile(r"\[([^\]]+)\]\(([^)\s]+)\)")
QUICK_FIND = "Quick find"
RETIRED = re.compile(r"\b(historical|retired|superseded|not installed|archived)\b", re.I)
# Same list as ai-memory-harvest, plus question words a lookup starts with.
STOP = {"a", "an", "and", "are", "as", "at", "be", "by", "for", "from", "in", "is", "it",
        "of", "on", "or", "that", "the", "this", "to", "with", "when", "where", "which",
        "will", "am", "do", "does", "how", "what", "who", "why", "can", "my", "me"}


def tracked(root: Path) -> list[str]:
    """Worktree members: tracked files still on disk plus untracked, non-ignored
    files. The old index-only view called an unstaged rename both "tracked but
    not linked" (old name) and "not tracked" (new name) until someone staged
    it, which pushed agents toward `git add` to turn a gate green. Deleted
    tracked paths are dropped; ignored files never count."""
    def run(*args: str) -> set[str]:
        out = subprocess.run(["git", "-C", str(root), *args], capture_output=True, check=True).stdout
        return {p for p in out.decode().split("\0") if p}
    files = run("ls-files", "-z") - run("ls-files", "-z", "--deleted")
    files |= run("ls-files", "-z", "--others", "--exclude-standard")
    return sorted(files)


def collections(files: list[str]) -> list[tuple[str, str, list[str], str]]:
    """(label, path, members, owner): members are what must be linked, if owned."""
    def under(prefix: str, suffix: str = "") -> list[str]:
        return [f for f in files if f.startswith(prefix) and "/" not in f[len(prefix):]
                and f.endswith(suffix)]
    bin_files = under("bin/")
    return [
        ("Durable memory", "config/ai/memory/", under("config/ai/memory/", ".md"), "sitemap"),
        ("Project memory", "config/ai/project-memory/",
         [f for f in under("config/ai/project-memory/", ".md") if f != MEMORY_INDEX], MEMORY_INDEX),
        ("Kelola memory", "config/ai/project-memory-kelola/",
         [f for f in under("config/ai/project-memory-kelola/", ".md") if f != KELOLA_INDEX], KELOLA_INDEX),
        ("Owned skills", "skills/local/",
         [f for f in files if re.fullmatch(r"skills/local/[^/]+/SKILL\.md", f)], "sitemap"),
        ("Commands", "bin/", [f for f in bin_files if not f.endswith("-test")
                              and not PurePosixPath(f).name.startswith("_")], "sitemap"),
        ("Command tests", "bin/", [f for f in bin_files if f.endswith("-test")], "sitemap"),
        ("Device profiles", "devices/",
         [f for f in under("devices/", ".md") if not f.endswith("/README.md")], "sitemap"),
        ("Project templates", "config/templates/", under("config/templates/", ".md"), "sitemap"),
        ("Top-level docs", "docs/", [f for f in under("docs/", ".md") if f != SITEMAP], "sitemap"),
        ("AI control files", "config/ai/",
         [f for f in files if f.startswith("config/ai/") and (f.count("/") == 2 or
          f.split("/")[2] in ("adapters", "context", "hooks", "evals", "policies",
                                "claude-home-memory"))], "sitemap"),
        ("Runtime references", "config/omp/",
         [f for f in files if f.startswith(("config/omp/", "config/pi/"))], "sitemap"),
        ("Skill commands", "skills/agents-bin/", under("skills/agents-bin/"), "sitemap"),
        ("Skill tooling", "skills/local/", under("skills/local/"), "sitemap"),
        ("Registry indexes", "devices/", [f for f in files if f == "devices/README.md"], "sitemap"),
        ("Command helpers", "bin/", [f for f in bin_files
                                    if PurePosixPath(f).name.startswith("_")], "sitemap"),
        ("Research records", "docs/research/", under("docs/research/"), "sitemap"),
        ("Environment and bootstrap", "config/",
         [f for f in files if "/" not in f or f.startswith(("home/", ".github/workflows/"))
          or (f.startswith("docs/") and f.count("/") == 1 and not f.endswith(".md"))
          or (f.startswith("config/") and not f.startswith(
              ("config/ai/", "config/templates/", "config/omp/", "config/pi/")))], "sitemap"),
        ("Device reports", "docs/device-reports/", under("docs/device-reports/"), "count"),
        ("Archived task records", "docs/archive/", under("docs/archive/"), "count"),
    ]


# Owned by something other than a collection: the ledger writes .delivery/,
# and a skill's own files are reached through its SKILL.md.
UNMAPPED_OK = re.compile(r"^(\.delivery/|skills/local/[^/]+/)")


def render_block(files: list[str]) -> str:
    rows = [START, "", "| Collection | Path | Tracked | Completeness enforced by |",
            "|---|---|---|---|"]
    owners = {"sitemap": "linked from this page", "count": "count only"}
    for label, path, members, owner in collections(files):
        if not members:
            continue
        enforced = owners.get(owner) or f"[`{PurePosixPath(owner).name}`](../{owner})"
        rows.append(f"| {label} | [`{path}`](../{path}) | {len(members)} | {enforced} |")
    return "\n".join(rows + ["", END])


def links(text: str, base: str) -> set[str]:
    return set(_targets(text, base))


def _targets(text: str, base: str) -> list[str]:
    """Relative link targets, repository-relative, in the order they appear."""
    found: list[str] = []
    for target in LINK.findall(text):
        if re.match(r"^[a-z]+:|^#", target):
            continue
        path = target.split("#", 1)[0].rstrip("/")
        if path and _norm(f"{base}/{path}") not in found:
            found.append(_norm(f"{base}/{path}"))
    return found


def _norm(path: str) -> str:
    parts: list[str] = []
    for part in PurePosixPath(path).parts:
        if part == "..":
            if parts:
                parts.pop()
        elif part != ".":
            parts.append(part)
    return "/".join(parts)


def problems(root: Path, text: str, files: list[str]) -> list[str]:
    found = []
    targets = links(text, "docs")
    for label, _, members, owner in collections(files):
        if owner == "sitemap":
            for member in members:
                accepted = {member, str(PurePosixPath(member).parent)} if label == "Owned skills" else {member}
                if not accepted & targets:
                    found.append(f"{member} is tracked but not linked from {SITEMAP} ({label})")
        elif owner != "count" and owner in files:
            indexed = links((root / owner).read_text(encoding="utf-8"), str(PurePosixPath(owner).parent))
            found += [f"{m} is not listed in {owner}" for m in members if m not in indexed]
    claimed = {m for *_, members, _ in collections(files) for m in members}
    claimed |= {SITEMAP, MEMORY_INDEX, KELOLA_INDEX}
    found += [f"{f} is tracked but belongs to no collection; add one in bin/system-map"
              for f in files if f not in claimed and not UNMAPPED_OK.match(f)]
    for item in entries(text):
        if not item["note"]:
            found.append(f"{SITEMAP}:{item['line']} entry {item['name']!r} has no note; "
                         "say what it is for after the link")
    slugs, fenced = set(), False
    for line in text.splitlines():
        fenced ^= line.lstrip().startswith("```")
        heading = None if fenced else re.match(r"^#{1,6} (.+)$", line)
        if heading:
            slug, n = _slug(heading.group(1)), 1
            while slug in slugs:  # GitHub suffixes repeats: name, name-1, ...
                slug, n = f"{_slug(heading.group(1))}-{n}", n + 1
            slugs.add(slug)
    for anchor in sorted(set(re.findall(r"\]\(#([^)\s]+)\)", text))):
        if anchor not in slugs:
            found.append(f"{SITEMAP} links #{anchor}, which no heading on the page produces")
    # Tracked, not on disk: a link to an ignored or uncommitted file passes
    # locally and breaks on every fresh clone.
    for target in sorted(targets):
        if target not in files and not any(f.startswith(target + "/") for f in files):
            found.append(f"{SITEMAP} links {target}, which is not tracked")
    return found


def entries(text: str, base: str = "docs") -> list[dict]:
    """List items and table rows holding a link, outside the rendered block and
    code fences. A link-first item is named by its link; a labelled item
    (`- **Label:** [..]`) by its label. Indented lines continue the note."""
    found: list[dict] = []
    heads: list[str] = []
    inside = fenced = False
    for number, line in enumerate(text.splitlines(), 1):
        if START in line or END in line:
            inside = START in line
            continue
        if line.lstrip().startswith("```"):
            fenced = not fenced
            continue
        if inside or fenced:
            continue
        head = re.match(r"^(#{2,6}) (.*)", line)
        if head:
            heads = heads[:len(head.group(1)) - 2] + [head.group(2).strip()]
            continue
        if found and found[-1]["open"] and re.match(r"^\s{2,}\S", line) \
                and not re.match(r"^\s*[-*] ", line):
            found[-1]["note"] = f"{found[-1]['note']} {_plain(line)}".strip()
            continue
        if found:
            found[-1]["open"] = False
        if re.match(r"^[-*] \[", line):
            body = NAMED_LINK.sub(lambda m: m.group(1), line[2:])
            # The note starts at whichever comes first: the sitemap's ":" or
            # MEMORY.md's " — "; a hook may itself contain a colon.
            cut = min((i for i in (body.find(":"), body.find(" — ")) if i >= 0), default=-1)
            note = body[cut:].lstrip(":— ") if cut >= 0 else ""
            found.append(_entry(line, _plain(note), heads, number, True, base))
        elif re.match(r"^[-*] ", line) and NAMED_LINK.search(line):
            cut = NAMED_LINK.search(line).start()
            label = _plain(line[2:cut]).rstrip(":").strip()
            note = _plain(NAMED_LINK.sub(lambda m: m.group(1), line[cut:]))
            found.append(_entry(line, note, heads, number, True, base, label))
        elif line.startswith("|") and NAMED_LINK.search(line):
            cells = [c.strip() for c in line.strip().strip("|").split("|")]
            first = next(i for i, c in enumerate(cells) if NAMED_LINK.search(c))
            note = " — ".join(_plain(NAMED_LINK.sub(lambda m: m.group(1), c))
                              for i, c in enumerate(cells) if i != first and c)
            found.append(_entry(cells[first], note, heads, number, False, base))
    for item in found:
        del item["open"]
    return found


def candidates(root: Path) -> list[dict]:
    """One candidate per link: the page it names, its own link text, and the
    entry's shared label, note, and section. A page grouped with others in one
    entry is then found by its own name, not hidden behind the first link."""
    out = []
    for order, source in enumerate(SOURCES):
        path = root / source
        if not path.is_file():
            continue
        base = str(PurePosixPath(source).parent)
        for item in entries(path.read_text(encoding="utf-8"), base):
            first = item["links"][0][1] if item["links"] else None
            for text, target in item["links"]:
                name = item["name"] if target == first else f"{item['label']} {text}".strip()
                out.append({**item, "name": name, "page": target, "source": source,
                            "rank": (order, item["line"])})
    return out


def _entry(source: str, note: str, heads: list[str], number: int, is_item: bool,
           base: str, label: str = "") -> dict:
    name = label or NAMED_LINK.search(source).group(1)
    pairs = [(_plain(text), _targets(f"]({target})", base)) for text, target in NAMED_LINK.findall(source)]
    return {"name": _plain(name), "paths": _targets(source, base), "note": note, "label": label,
            "links": [(text, hit[0]) for text, hit in pairs if hit],
            "section": " > ".join(heads), "line": number, "open": is_item}


def _plain(text: str) -> str:
    return re.sub(r"\s+", " ", re.sub(r"[`*]", "", text)).strip()


def _stem(word: str) -> str:
    # lazy: suffix stripping, not a stemmer; route/router/routing/routes meet.
    # Upgrade to a real stemmer only if queries in another language arrive.
    # Repeat until stable so workers -> worker -> work meets worker -> work.
    while True:
        for suffix, keep in (("ies", "y"), ("ing", ""), ("er", ""), ("es", ""),
                             ("ed", ""), ("e", ""), ("s", "")):
            if word.endswith(suffix) and len(word) - len(suffix) >= 3:
                word = word[: -len(suffix)] + keep
                break
        else:
            return word


def _words(text: str) -> set[str]:
    return {_stem(w) for w in re.findall(r"[a-z0-9]+", text.lower()) if len(w) > 1 and w not in STOP}


def find(root: Path, terms: list[str], limit: int) -> list[dict]:
    """Path or name hit 10 (a term also matches inside a longer name), section
    hit 3, note hit 1. Entries matching more distinct terms rank first. Quick
    find intents double; a test page halves unless the query asks for a test,
    so a subject outranks its test, and a page under a historical or retired
    heading or label halves. Each page appears once, and each entry
    once (its other pages are listed under `also`). Weights were picked
    on the live query set in system-map-test, not tuned per query."""
    query = _words(" ".join(terms))
    ranked = []
    for item in candidates(root):
        where = {"name": _words(item["name"] + " " + item["page"]),
                 "section": _words(item["section"]), "note": _words(item["note"])}
        # A name also matches inside a longer word: sync finds dotsync.
        named = {t for t in query if t in where["name"]
                 or (len(t) >= 3 and any(t in w for w in where["name"]))}
        hits = [t for t in query if t in named or t in where["section"] or t in where["note"]]
        if not hits:
            continue
        score = sum(10 * (t in named) + 3 * (t in where["section"])
                    + (t in where["note"]) for t in hits)
        if QUICK_FIND in item["section"]:
            score *= 2
        is_test = bool(re.search(r"[-.]test(\.sh)?$", item["page"]))
        if is_test and "test" not in query:
            score /= 2
        # Backstage keeps spec.lifecycle; here the heading or label says so.
        if RETIRED.search(f"{item['section']} {item['label']}"):
            score /= 2
        ranked.append((-len(hits), -score, item["rank"], {**item, "score": score, "test": is_test}))
    best, seen = [], set()
    for *_, item in sorted(ranked, key=lambda r: r[:3]):
        # A `(+ test)` page shares its subject's entry but not its slot.
        entry = (item["source"], item["line"], item["test"])
        if item["page"] not in seen and entry not in seen:
            seen |= {item["page"], entry}
            best.append({k: item[k] for k in ("page", "name", "note", "section", "source", "score")}
                        | {"also": [p for p in item["paths"] if p != item["page"]][:4]})
    return best[:limit]


def _slug(heading: str) -> str:
    """GitHub's heading anchor: lowercase, punctuation dropped, spaces to hyphens."""
    return re.sub(r"[^\w\- ]", "", heading.strip().lower()).replace(" ", "-")


def render(text: str, block: str) -> str:
    if START not in text or END not in text:
        raise ValueError(f"{SITEMAP} has no inventory markers; add {START!r} and {END!r}")
    head, rest = text.split(START, 1)
    return head + block + rest.split(END, 1)[1]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true")
    mode.add_argument("--stdout", action="store_true")
    mode.add_argument("--find", nargs="+", metavar="TERM")
    parser.add_argument("--limit", type=lambda v: max(1, int(v)), default=8)
    parser.add_argument("--json", action="store_true")
    a = parser.parse_args()
    root = a.root.resolve()
    target = root / SITEMAP
    try:
        files = tracked(root)
        current = target.read_text(encoding="utf-8")
        fresh = render(current, render_block(files))
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        print(f"system-map: {exc}", file=sys.stderr)
        return 2
    if a.stdout:
        sys.stdout.write(fresh)
        return 0
    if a.find:
        hits = find(root, a.find, a.limit)
        if a.json:
            print(json.dumps(hits, indent=2))
        for hit in [] if a.json else hits:
            also = f"\n    also: {', '.join(hit['also'])}" if hit["also"] else ""
            where = hit["section"] or hit["source"]
            print(f"{hit['page']}\n    {hit['name']}: {hit['note'][:160]}{also}\n    [{where}]")
        return 0 if hits else 1
    if a.check:
        issues = problems(root, current, files)
        if current != fresh:
            issues.insert(0, "inventory block is stale; run `system-map`")
        for issue in issues:
            print(f"system-map: {issue}", file=sys.stderr)
        if issues:
            return 1
        print(f"system-map: {SITEMAP} is complete and current "
              f"({sum(len(c[2]) for c in collections(files))} tracked members)")
        return 0
    target.write_text(fresh, encoding="utf-8")
    print(f"system-map: wrote inventory in {SITEMAP}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
