#!/usr/bin/env python3
"""Keep docs/DOTFILES_SITEMAP.md complete and its numbers true.

The sitemap is curated prose: groupings and one-line explanations stay
hand-written. What drifted was everything derivable. On 2026-10-25 it still
said 8 devices correctly but omitted lenovo from its table, linked none of
seven commands including ai-workflow-eval, missed a template and fourteen
top-level documents, and five project memories were absent from MEMORY.md.

So only the inventory block between the markers is rendered, and --check
fails when a tracked member of a covered collection is unlinked, when a
project memory is missing from its own index, or when a relative link in the
sitemap resolves to nothing. Each collection has one index: project memory is
listed by config/ai/project-memory/MEMORY.md, so the sitemap links that index
rather than duplicating it. Only tracked files count, so uncommitted work never
fails the gate.

Entries keep the llms.txt shape, `- [name](path): note` or a table row with a
link, so the map is also a dictionary: --find ranks entries against a query
the way aider ranks its repo map, path and name hits over note hits, with the
hand-written "Quick find" intents first. It reads the page; no index or
generated copy exists to drift. An entry without a note cannot be found by
what it does, so --check rejects one.

  system-map              rewrite the inventory block
  system-map --check      exit 1 on a stale block, unlinked member, unindexed
                          memory, broken link or noteless entry; writes nothing
                          (ai-policy-lint)
  system-map --stdout     print the rendered sitemap without writing
  system-map --find T...  print the best entries for the terms (--limit, --json)
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path, PurePosixPath
import re
import subprocess
import sys

SITEMAP = "docs/DOTFILES_SITEMAP.md"
MEMORY_INDEX = "config/ai/project-memory/MEMORY.md"
START = "<!-- system-map:inventory:start (rendered by bin/system-map; do not edit) -->"
END = "<!-- system-map:inventory:end -->"
LINK = re.compile(r"\]\(([^)\s]+)\)")
NAMED_LINK = re.compile(r"\[([^\]]+)\]\(([^)\s]+)\)")
QUICK_FIND = "Quick find"


def tracked(root: Path) -> list[str]:
    out = subprocess.run(["git", "-C", str(root), "ls-files", "-z"],
                         capture_output=True, check=True).stdout
    return sorted(p for p in out.decode().split("\0") if p)


def collections(files: list[str]) -> list[tuple[str, str, list[str], str]]:
    """(label, path, members, owner): members are what must be linked, if owned."""
    def under(prefix: str, suffix: str = "") -> list[str]:
        return [f for f in files if f.startswith(prefix) and "/" not in f[len(prefix):]
                and f.endswith(suffix)]
    bin_files = under("bin/")
    return [
        ("Durable memory", "config/ai/memory/", under("config/ai/memory/", ".md"), "sitemap"),
        ("Project memory", "config/ai/project-memory/",
         [f for f in under("config/ai/project-memory/", ".md") if f != MEMORY_INDEX], "MEMORY.md"),
        ("Owned skills", "skills/local/",
         [f for f in files if re.fullmatch(r"skills/local/[^/]+/SKILL\.md", f)], "sitemap"),
        ("Commands", "bin/", [f for f in bin_files if not f.endswith("-test")
                              and not PurePosixPath(f).name.startswith("_")], "sitemap"),
        ("Command tests", "bin/", [f for f in bin_files if f.endswith("-test")], "count"),
        ("Device profiles", "devices/",
         [f for f in under("devices/", ".md") if not f.endswith("/README.md")], "sitemap"),
        ("Project templates", "config/templates/", under("config/templates/", ".md"), "sitemap"),
        ("Top-level docs", "docs/", [f for f in under("docs/", ".md") if f != SITEMAP], "sitemap"),
        ("Archived task records", "docs/archive/", under("docs/archive/"), "count"),
    ]


def render_block(files: list[str]) -> str:
    rows = [START, "", "| Collection | Path | Tracked | Completeness enforced by |",
            "|---|---|---|---|"]
    owners = {"sitemap": "linked from this page", "MEMORY.md": f"[`MEMORY.md`](../{MEMORY_INDEX})",
              "count": "count only"}
    for label, path, members, owner in collections(files):
        rows.append(f"| {label} | [`{path}`](../{path}) | {len(members)} | {owners[owner]} |")
    return "\n".join(rows + ["", END])


def links(text: str, base: str) -> set[str]:
    return set(_targets(text, base))


def _targets(text: str, base: str) -> list[str]:
    """Relative link targets, repository-relative, in the order they appear."""
    found: list[str] = []
    for target in LINK.findall(text):
        if re.match(r"^[a-z]+:|^#", target):
            continue
        path = target.split("#", 1)[0].rstrip("/")
        if path and _norm(f"{base}/{path}") not in found:
            found.append(_norm(f"{base}/{path}"))
    return found


def _norm(path: str) -> str:
    parts: list[str] = []
    for part in PurePosixPath(path).parts:
        if part == "..":
            if parts:
                parts.pop()
        elif part != ".":
            parts.append(part)
    return "/".join(parts)


def problems(root: Path, text: str, files: list[str]) -> list[str]:
    found = []
    targets = links(text, "docs")
    for label, _, members, owner in collections(files):
        if owner != "sitemap":
            continue
        for member in members:
            accepted = {member, str(PurePosixPath(member).parent)} if label == "Owned skills" else {member}
            if not accepted & targets:
                found.append(f"{member} is tracked but not linked from {SITEMAP} ({label})")
    if MEMORY_INDEX in files:
        indexed = links((root / MEMORY_INDEX).read_text(encoding="utf-8"), "config/ai/project-memory")
        for member in collections(files)[1][2]:
            if member not in indexed:
                found.append(f"{member} is not listed in {MEMORY_INDEX}")
    for item in entries(text):
        if not item["note"]:
            found.append(f"{SITEMAP}:{item['line']} entry {item['name']!r} has no note; "
                         "say what it is for after the link")
    # Tracked, not on disk: a link to an ignored or uncommitted file passes
    # locally and breaks on every fresh clone.
    for target in sorted(targets):
        if target not in files and not any(f.startswith(target + "/") for f in files):
            found.append(f"{SITEMAP} links {target}, which is not tracked")
    return found


def entries(text: str) -> list[dict]:
    """List items and table rows holding a link, outside the rendered block and
    code fences. A link-first item is named by its link; a labelled item
    (`- **Label:** [..]`) by its label. Indented lines continue the note."""
    found: list[dict] = []
    heads: list[str] = []
    inside = fenced = False
    for number, line in enumerate(text.splitlines(), 1):
        if START in line or END in line:
            inside = START in line
            continue
        if line.lstrip().startswith("```"):
            fenced = not fenced
            continue
        if inside or fenced:
            continue
        head = re.match(r"^(#{2,6}) (.*)", line)
        if head:
            heads = heads[:len(head.group(1)) - 2] + [head.group(2).strip()]
            continue
        if found and found[-1]["open"] and re.match(r"^\s{2,}\S", line) \
                and not re.match(r"^\s*[-*] ", line):
            found[-1]["note"] = f"{found[-1]['note']} {_plain(line)}".strip()
            continue
        if found:
            found[-1]["open"] = False
        if re.match(r"^[-*] \[", line):
            body = NAMED_LINK.sub(lambda m: m.group(1), line[2:])
            note = body.split(":", 1)[1] if ":" in body else ""
            found.append(_entry(line, _plain(note), heads, number, True))
        elif re.match(r"^[-*] ", line) and NAMED_LINK.search(line):
            cut = NAMED_LINK.search(line).start()
            label = _plain(line[2:cut]).rstrip(":").strip()
            note = _plain(NAMED_LINK.sub(lambda m: m.group(1), line[cut:]))
            found.append(_entry(line, note, heads, number, True, label))
        elif line.startswith("|") and NAMED_LINK.search(line):
            cells = [c.strip() for c in line.strip().strip("|").split("|")]
            first = next(i for i, c in enumerate(cells) if NAMED_LINK.search(c))
            note = " — ".join(_plain(NAMED_LINK.sub(lambda m: m.group(1), c))
                              for i, c in enumerate(cells) if i != first and c)
            found.append(_entry(cells[first], note, heads, number, False))
    for item in found:
        del item["open"]
    return found


def _entry(source: str, note: str, heads: list[str], number: int, is_item: bool,
           label: str = "") -> dict:
    name = label or NAMED_LINK.search(source).group(1)
    return {"name": _plain(name), "paths": _targets(source, "docs"), "note": note,
            "section": " > ".join(heads), "line": number, "open": is_item}


def _plain(text: str) -> str:
    return re.sub(r"\s+", " ", re.sub(r"[`*]", "", text)).strip()


def _stem(word: str) -> str:
    # lazy: suffix stripping, not a stemmer; route/router/routing/routes meet.
    # Upgrade to a real stemmer only if queries in another language arrive.
    for suffix, keep in (("ies", "y"), ("ing", ""), ("er", ""), ("es", ""),
                         ("ed", ""), ("e", ""), ("s", "")):
        if word.endswith(suffix) and len(word) - len(suffix) >= 3:
            return word[: -len(suffix)] + keep
    return word


def _words(text: str) -> set[str]:
    return {_stem(w) for w in re.findall(r"[a-z0-9]+", text.lower()) if len(w) > 1}


def find(text: str, terms: list[str], limit: int) -> list[dict]:
    """Path or name hit 10, section hit 3, note hit 1; Quick find intents
    double. Entries matching more distinct terms always rank first, and each
    page appears once, under its best entry."""
    query = _words(" ".join(terms))
    ranked = []
    for item in entries(text):
        where = {"name": _words(item["name"] + " " + " ".join(item["paths"])),
                 "section": _words(item["section"]), "note": _words(item["note"])}
        hits = [t for t in query if any(t in w for w in where.values())]
        if not hits:
            continue
        score = sum(10 * (t in where["name"]) + 3 * (t in where["section"])
                    + (t in where["note"]) for t in hits)
        if QUICK_FIND in item["section"]:
            score *= 2
        ranked.append((-len(hits), -score, item["line"], {**item, "score": score}))
    best, seen = [], set()
    for *_, item in sorted(ranked, key=lambda r: r[:3]):
        key = item["paths"][0] if item["paths"] else item["name"]
        if key not in seen:
            seen.add(key)
            best.append(item)
    return best[:limit]


def render(text: str, block: str) -> str:
    if START not in text or END not in text:
        raise ValueError(f"{SITEMAP} has no inventory markers; add {START!r} and {END!r}")
    head, rest = text.split(START, 1)
    return head + block + rest.split(END, 1)[1]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true")
    mode.add_argument("--stdout", action="store_true")
    mode.add_argument("--find", nargs="+", metavar="TERM")
    parser.add_argument("--limit", type=lambda v: max(1, int(v)), default=8)
    parser.add_argument("--json", action="store_true")
    a = parser.parse_args()
    root = a.root.resolve()
    target = root / SITEMAP
    try:
        files = tracked(root)
        current = target.read_text(encoding="utf-8")
        fresh = render(current, render_block(files))
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        print(f"system-map: {exc}", file=sys.stderr)
        return 2
    if a.stdout:
        sys.stdout.write(fresh)
        return 0
    if a.find:
        hits = find(current, a.find, a.limit)
        if a.json:
            print(json.dumps(hits, indent=2))
        for hit in [] if a.json else hits:
            path = hit["paths"][0] if hit["paths"] else "-"
            also = f"\n    also: {', '.join(hit['paths'][1:5])}" if len(hit["paths"]) > 1 else ""
            print(f"{path}\n    {hit['name']}: {hit['note'][:160]}{also}\n    [{hit['section']}]")
        return 0 if hits else 1
    if a.check:
        issues = problems(root, current, files)
        if current != fresh:
            issues.insert(0, "inventory block is stale; run `system-map`")
        for issue in issues:
            print(f"system-map: {issue}", file=sys.stderr)
        if issues:
            return 1
        print(f"system-map: {SITEMAP} is complete and current "
              f"({sum(len(c[2]) for c in collections(files))} tracked members)")
        return 0
    target.write_text(fresh, encoding="utf-8")
    print(f"system-map: wrote inventory in {SITEMAP}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
