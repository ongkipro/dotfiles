#!/usr/bin/env bash
# ai-doctor — read-only health report for dotfiles AI runtime wiring.
#
# Default mode never repairs links, installs binaries, or runs tests that create
# temporary files. Use --self-test to run repository regression checks that are
# isolated under temporary directories.
set -uo pipefail

DOT="${DOTFILES_DIR:-$HOME/dotfiles}"

# A dangling mise shim took out ai-learn and ai-memory-check on macOS while
# device-verify beside them resolved node correctly, because the node-resolution
# fix lived in three copies and this file had none. There is now one definition.
[ -f "$DOT/bin/_toolchain-path.sh" ] && . "$DOT/bin/_toolchain-path.sh" \
  && toolchain_export_path
AI="$HOME/.config/ai"
fail=0; warn=0
MODE="${1:-}"
case "$MODE" in
  ""|--self-test) ;;
  --runtime)
    # What OMP will actually run here, and whether it can. Separate from
    # --self-test on purpose: that proves the repository's contracts, this
    # reports this device's resolved routing, which legitimately differs per
    # machine. Exits non-zero when a selector, thinking level, or visual-role
    # model does not hold up against this device's own registry.
    exec "$DOT/bin/omp-runtime-report"
    ;;
  --help|-h)
    echo "Usage: ai-doctor [--self-test|--runtime]"
    exit 0
    ;;
  *)
    echo "ERROR: unknown option: $MODE" >&2
    exit 2
    ;;
esac

ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
bad()  { printf '  \033[31m✗\033[0m %s\n' "$1"; fail=$((fail+1)); }
wrn()  { printf '  \033[33m!\033[0m %s\n' "$1"; warn=$((warn+1)); }
hdr()  { printf '\n\033[1m%s\033[0m\n' "$1"; }

resolve_path() {
  local path="$1" link hops=0 dir
  while [ -L "$path" ]; do
    link="$(readlink "$path")"
    case "$link" in
      /*) path="$link" ;;
      *) path="$(dirname "$path")/$link" ;;
    esac
    hops=$((hops + 1))
    [ "$hops" -le 40 ] || return 1
  done
  dir="$(cd -P "$(dirname "$path")" 2>/dev/null && pwd)" || return 1
  printf '%s/%s\n' "$dir" "$(basename "$path")"
}

# Keep the regression suite separate from the device-health report: CI can run
# repository fixtures without requiring an installed runtime, while the default
# mode remains a fast, read-only inspection of this device.
run_self_test_command() {
  local label="$1" log status
  shift
  log="$(mktemp "${TMPDIR:-/tmp}/ai-doctor.XXXXXX")" || {
    bad "$label: tidak bisa membuat log sementara"
    return
  }
  if "$@" >"$log" 2>&1; then
    # A gate can exit 0 while having skipped most of its work — omp-routing-test
    # does exactly that when the omp binary is absent, printing PARTIAL and
    # naming what it could not check. Swallowing the log turned that into a
    # clean "lulus" in CI, which is how a reduced run became indistinguishable
    # from a full one. Surface the reason instead of hiding it.
    if grep -qE '(^|[^A-Za-z])(PARTIAL|WARNING)([^A-Za-z]|$)' "$log"; then
      wrn "$label: lulus SEBAGIAN — cakupan berkurang:"
      grep -E '(^|[^A-Za-z])(PARTIAL|WARNING)([^A-Za-z]|$)' "$log" | sed 's/^/    /' >&2
    else
      ok "$label: lulus"
    fi
  else
    status=$?
    bad "$label: GAGAL (exit $status)"
    sed 's/^/    /' "$log" >&2
  fi
  rm -f "$log"
}

run_self_test_gate() {
  local gate="$1" test_script found turnstile_seen
  case "$gate" in
    memory-default)
      run_self_test_command "ai-memory-check (canonical)" "$DOT/bin/ai-memory-check"
      ;;
    memory-fixtures)
      run_self_test_command "ai-memory-check --self-test" "$DOT/bin/ai-memory-check" --self-test
      ;;
    memory-repository)
      run_self_test_command "ai-memory-check (all Markdown)" "$DOT/bin/ai-memory-check" "$DOT"
      ;;
    security)
      run_self_test_command "security-check" "$DOT/bin/security-check" "$DOT"
      ;;
    policy)
      run_self_test_command "ai-policy-lint" "$DOT/bin/ai-policy-lint"
      ;;
    fixture-tests)
      found=0
      turnstile_seen=0
      for test_script in "$DOT"/bin/*-test; do
        [ -e "$test_script" ] || continue
        found=1
        [ "$(basename "$test_script")" = "turnstile-secret-test" ] && turnstile_seen=1
        if [ -x "$test_script" ]; then
          run_self_test_command "$(basename "$test_script")" "$test_script" "$DOT"
        else
          bad "$(basename "$test_script"): tidak executable"
        fi
      done
      [ "$found" -eq 1 ] || bad "fixture tests: bin/*-test tidak ditemukan"
      [ "$turnstile_seen" -eq 1 ] || bad "turnstile-secret-test: tidak tersedia"
      ;;
    git-guard)
      test_script="$DOT/config/ai/hooks/git-guard.test.sh"
      if [ -x "$test_script" ]; then
        run_self_test_command "git-guard.test.sh" "$test_script"
      else
        bad "git-guard.test.sh: tidak executable atau tidak tersedia"
      fi
      ;;
    *)
      bad "self-test gate tidak dikenal: $gate"
      ;;
  esac
}

if [ "$MODE" = "--self-test" ]; then
  hdr "Repository self-test"
  # This is the authoritative gate manifest. Fixture discovery intentionally
  # includes future bin/*-test additions, including bin/omp-routing-test.
  SELF_TEST_GATES=(
    memory-default
    memory-fixtures
    memory-repository
    security
    policy
    fixture-tests
    git-guard
  )
  for gate in "${SELF_TEST_GATES[@]}"; do
    run_self_test_gate "$gate"
  done

  printf '\n────────────────────────────────────────\n'
  if [ "$fail" -eq 0 ]; then
    printf '\033[32mSELF-TEST LULUS\033[0m — semua gate kritis lulus.\n'
    exit 0
  fi
  printf '\033[31mSELF-TEST GAGAL\033[0m — %d gate gagal.\n' "$fail"
  exit 1
fi


# ── 1. Repo ───────────────────────────────────────────────────────────────────
hdr "1. Dotfiles repo"
if [ -d "$DOT/.git" ]; then
  branch=$(git -C "$DOT" rev-parse --abbrev-ref HEAD 2>/dev/null)
  dirty=$(git -C "$DOT" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  remote_ref=$(git -C "$DOT" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
  if [ -z "$remote_ref" ] && git -C "$DOT" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    remote_ref="origin/$branch"
  fi
  ok "$DOT (branch $branch)"
  [ "$dirty" -eq 0 ] && ok "working tree bersih" || wrn "$dirty file belum di-commit — review dengan: lg"
  if [ -n "$remote_ref" ]; then
    read -r ahead behind <<< "$(git -C "$DOT" rev-list --left-right --count "HEAD...$remote_ref")"
    if [ "$ahead" = "0" ] && [ "$behind" = "0" ]; then
      ok "sinkron dengan $remote_ref"
    else
      [ "$ahead" = "0" ] || wrn "$ahead commit lokal belum ada di $remote_ref"
      [ "$behind" = "0" ] || wrn "$behind commit $remote_ref belum ada di lokal"
    fi
  else
    wrn "branch belum punya upstream atau origin/$branch"
  fi
else
  bad "$DOT bukan git repo. Clone: git clone git@github.com:ongkipro/dotfiles.git ~/dotfiles"
fi

# ── 2. Layer 1: rules reach every installed CLI ───────────────────────────────
hdr "2. Aturan (AGENTS.md) — harus sampai ke SEMUA CLI yang terpasang"
SRC="$AI/AGENTS.md"
if [ -f "$SRC" ]; then
  ok "sumber: ~/.config/ai/AGENTS.md ($(wc -l < "$SRC") baris)"
  [ "$(wc -l < "$SRC")" -le 120 ] || wrn "AGENTS.md >120 baris — ini dibaca TIAP request di 5 CLI. Pindahkan detail ke skill."
else
  bad "~/.config/ai/AGENTS.md TIDAK ADA — inti sistem hilang."
fi

check_link() { # $1=cli  $2=path  $3=parent-that-must-exist
  if [ ! -d "$3" ]; then wrn "$1: belum terpasang di device ini (lewati)"; return; fi
  if [ -L "$2" ] && [ "$(resolve_path "$2")" = "$(resolve_path "$SRC")" ]; then
    ok "$1: $(printf '%s' "${2/#$HOME/\~}") → AGENTS.md"
  else
    bad "$1: ${2/#$HOME/\~} TIDAK ter-link ke AGENTS.md. Perbaiki: ai-memory-link"
  fi
}
check_link claude "$HOME/.claude/CLAUDE.md"          "$HOME/.claude"
check_link codex  "$HOME/.codex/AGENTS.md"           "$HOME/.codex"
check_link agy    "$HOME/.antigravity/AGENTS.md"     "$HOME/.antigravity"
check_link "agy compatibility (~/.gemini)" "$HOME/.gemini/GEMINI.md" "$HOME/.gemini"
check_link omp    "$HOME/.omp/agent/AGENTS.md"        "$HOME/.omp/agent"
# ~/AGENTS.md harus TIDAK ADA. Ia pernah muncul sebagai salinan tak ter-manage,
# melenceng 5 hari, lalu rusak kena find-replace (semua "Claude" jadi "Codex")
# tanpa ada yang tahu. Dan karena CLI naik dari cwd mencari AGENTS.md, file ini
# membuat aturan yang sama dimuat dua kali di tiap sesi di bawah ~.
if [ -e "$HOME/AGENTS.md" ] || [ -L "$HOME/AGENTS.md" ]; then
  wrn "~/AGENTS.md muncul lagi — seharusnya TIDAK ADA (aturan dobel + rawan melenceng). Hapus: rm ~/AGENTS.md"
fi
# Canary isi. Symlink utuh cuma membuktikan PIPA-nya nyambung, bukan isinya benar.
# Approval-gate adalah satu-satunya aturan yang kalau terhapus TIDAK menimbulkan
# gejala apa pun yang bisa diamati: semua CLI tetap jalan, tetap terasa normal,
# cuma diam-diam berhenti minta konfirmasi sebelum hal destruktif/produksi.
# Satu frasa saja — canary kedua cuma menambah bising tanpa menambah informasi.
if [ -f "$SRC" ]; then
  if grep -qF 'Permission allowed is not user approval' "$SRC"; then
    ok "canary: aturan approval-gate masih utuh di AGENTS.md"
  else
    bad "canary HILANG: frasa 'Permission allowed is not user approval' tidak ada di ~/.config/ai/AGENTS.md — approval gate terhapus, semua CLI berhenti minta konfirmasi TANPA gejala. Pulihkan dari git: git -C $DOT diff config/ai/AGENTS.md"
  fi
fi

if command -v pi >/dev/null 2>&1; then
  # Wrapper pi() saat ini dipelihara di file dotfiles shell-tools; shell rc tinggal
  # men-source file itu. Jadi cek SUMBER-nya, jangan berasumsi wrapper hidup di
  # satu rc tertentu.
  grep -qs "config/ai/AGENTS.md" \
      "$DOT/config/zshrc.tools.sh" "$DOT/config/bashrc.tools.sh" "$DOT/config/shell-tools.sh" \
      "$HOME/.zshrc" "$HOME/.bashrc" 2>/dev/null \
    && ok "pi: wrapper pi() masih append AGENTS.md" \
    || wrn "pi: wrapper pi() tak menyebut AGENTS.md — cek $DOT/config/{zshrc,bashrc,shell}.tools.sh"

  if [ -x "$DOT/bin/pi-update-safe" ]; then
    grep -qs "pi-update-safe" \
        "$DOT/config/zshrc.tools.sh" "$DOT/config/bashrc.tools.sh" "$DOT/config/shell-tools.sh" \
        "$HOME/.zshrc" "$HOME/.bashrc" 2>/dev/null \
      && ok "pi: update diroute ke pi-update-safe (auto-arsip backup skill)" \
      || wrn "pi: wrapper update belum meroute ke pi-update-safe — backup skill bisa bocor lagi ke ~/.pi/agent/skills"
  else
    wrn "pi: $DOT/bin/pi-update-safe tidak executable — wrapper update aman mati. Perbaiki: chmod +x $DOT/bin/pi-update-safe"
  fi
fi

if [ "$(uname -s)" = "Linux" ]; then
  shell_source='source "$HOME/dotfiles/config/shell-tools.sh"'
  check_linux_shell_source() {
    local rc="$1" label count
    label="${rc/#$HOME/\~}"
    count="$(grep -cxF "$shell_source" "$rc" 2>/dev/null || true)"
    if grep -qF '# >>> dev-tools setup (ongkipro/dotfiles) >>>' "$rc" 2>/dev/null; then
      bad "$label masih memakai copied dev-tools block — jalankan install.sh untuk migrasi"
    elif [ "$count" -eq 1 ]; then
      ok "$label → tracked config/shell-tools.sh exactly once"
    elif [ "$count" -gt 1 ]; then
      bad "$label men-source config/shell-tools.sh $count kali — jalankan install.sh untuk normalisasi"
    else
      bad "$label tidak men-source config/shell-tools.sh — jalankan install.sh"
    fi
  }
  check_linux_shell_source "$HOME/.bashrc"
  if [ "${SHELL##*/}" = "zsh" ]; then
    check_linux_shell_source "$HOME/.zshrc"
  fi
fi

for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
  if [ -f "$rc" ] && grep -qE '^[[:space:]]*export[[:space:]]+NINEROUTER_REMOTE_KEY=' "$rc"; then
    bad "${rc/#$HOME/\~} mengekspor NINEROUTER_REMOTE_KEY ke semua child process — gunakan auth native runtime atau helper yang scope-nya satu child"
  fi
done

# ── 3. Layer 2: memory ────────────────────────────────────────────────────────
hdr "3. Memori"
if [ -d "$AI/memory" ]; then
  n=$(find "$AI/memory" -maxdepth 1 -name '*.md' | wc -l | tr -d ' ')
  ok "$n file di ~/.config/ai/memory/"
  [ -L "$HOME/.config/ai" ] && ok "~/.config/ai → $(readlink "$HOME/.config/ai" | sed "s|$HOME|~|")" \
    || bad "~/.config/ai BUKAN symlink ke dotfiles — memori tidak akan ter-sync antar device!"
else
  bad "~/.config/ai/memory/ TIDAK ADA"
fi

# Claude's home-scoped project entry receives only a small bootstrap. Loading the
# entire project-memory directory here leaks unrelated project context into every
# terminal started from $HOME.
# Nama direktori project Claude Code = $HOME dengan '/' → '-'. Di Mac jadi
# '-Users-ongki', di Linux '-home-<user>'. Turunkan dari $HOME, jangan hardcode,
# supaya cek ini ikut berlaku di cuan.
PMEM_SOURCE="$DOT/config/ai/claude-home-memory/MEMORY.md"
project_slug="$(printf '%s' "$HOME" | tr '/' '-')"
for cfg in "$HOME/.claude" "$HOME"/.claude-accounts/*/; do
  [ -d "$cfg" ] || continue
  cfg="${cfg%/}"
  cfg_key="$(printf '%s' "$cfg" | tr '/ ' '--')"
  PMEM="$cfg/projects/$project_slug/memory"
  PMEM_EXPECTED="$HOME/.config/ai-local/claude-home-bootstrap/$cfg_key"
  if [ -L "$PMEM" ] \
     && [ "$(resolve_path "$PMEM" 2>/dev/null)" = "$(resolve_path "$PMEM_EXPECTED" 2>/dev/null)" ] \
     && [ -f "$PMEM/MEMORY.md" ] \
     && cmp -s "$PMEM_SOURCE" "$PMEM/MEMORY.md"; then
    n=$(find "$PMEM/" -maxdepth 1 -name '*.md' | wc -l | tr -d ' ')
    dir_mode="$(stat -c '%a' "$PMEM_EXPECTED" 2>/dev/null || stat -f '%Lp' "$PMEM_EXPECTED")"
    file_mode="$(stat -c '%a' "$PMEM/MEMORY.md" 2>/dev/null || stat -f '%Lp' "$PMEM/MEMORY.md")"
    if [ "$n" -eq 1 ] && [ "$dir_mode" = 500 ] && [ "$file_mode" = 400 ]; then
      ok "Claude home memory ($cfg): device-local read-only bootstrap"
    else
      bad "Claude home memory ($cfg) must contain one mode-400 file in a mode-500 directory"
    fi
  else
    bad "Claude home memory ($cfg) is not the managed read-only bootstrap — run: ai-memory-link"
  fi
done

if [ -x "$DOT/bin/ai-memory-check" ]; then
  # Exit 127 means the interpreter is missing, not that the references are
  # broken. The Mac reported "referensi memori menggantung" for three gates on
  # 2026-09-01 when the real cause was node absent from a non-interactive PATH —
  # a diagnosis that sends the reader to inspect memory files that were fine.
  "$DOT/bin/ai-memory-check" >/dev/null 2>&1
  case "$?" in
    0)   ok "referensi memori: Markdown links + wikilinks utuh" ;;
    127) bad "ai-memory-check tidak bisa jalan (interpreter hilang, exit 127) — referensi memori TIDAK terperiksa; cek: mise which node" ;;
    *)   bad "referensi memori menggantung/ambigu — jalankan: ai-memory-check" ;;
  esac
else
  wrn "bin/ai-memory-check tidak ada"
fi

if [ -x "$DOT/bin/ai-learn" ]; then
  LEARN_ACTUAL="$(command -v ai-learn 2>/dev/null || true)"
  if [ -n "$LEARN_ACTUAL" ] \
     && [ "$(resolve_path "$LEARN_ACTUAL" 2>/dev/null)" = "$(resolve_path "$DOT/bin/ai-learn")" ]; then
    ok "ai-learn PATH → canonical capture → review → promote"
  else
    bad "ai-learn PATH tidak menunjuk $DOT/bin/ai-learn — jalankan installer"
  fi
  LEARN_INBOX="${AI_MEMORY_INBOX_DIR:-$HOME/.config/ai-local/memory-inbox}"
  pending=0
  if [ -d "$LEARN_INBOX" ]; then
    pending=$(find "$LEARN_INBOX" -maxdepth 1 -type f -name '*.md' | wc -l | tr -d ' ')
  fi
  [ "$pending" -eq 0 ] \
    && ok "lesson inbox bersih — tidak ada candidate menunggu review" \
    || wrn "$pending lesson candidate menunggu review — jalankan: ai-learn list"
else
  bad "bin/ai-learn tidak ada atau tidak executable"
fi

# ── 4. Layer 3: skills ────────────────────────────────────────────────────────
hdr "4. Skills — source custom + runtime dirs managed"
SK="$DOT/skills/local"
SHARED="$HOME/.agents/repos/shared-skills"
if [ -d "$SK" ]; then
  n=$(find "$SK" -mindepth 2 -maxdepth 2 -name SKILL.md | wc -l | tr -d ' ')
  ok "sumber custom: $n skill di ~/dotfiles/skills/local/"
  if [ -x "$DOT/skills/agents-bin/skill-check" ]; then
    ok "skill-check tersedia (jalankan eksplisit atau gunakan ai-doctor --self-test)"
  else
    wrn "skill-check belum tersedia"
  fi
  if [ -x "$DOT/bin/skill-surface-check" ]; then
    if surface_out="$("$DOT/bin/skill-surface-check" "$DOT" 2>&1)"; then
      case "$surface_out" in
        *"skill-surface-check: CLEAN"*) ok "$surface_out" ;;
        *) wrn "$(printf '%s' "$surface_out" | tr '\n' ' ')" ;;
      esac
    else
      wrn "skill-surface-check gagal membuat laporan: $(printf '%s' "$surface_out" | tr '\n' ' ')"
    fi
  else
    wrn "skill-surface-check belum tersedia"
  fi
  for pair in "claude:$HOME/.claude/skills:$HOME/.claude" "pi:$HOME/.pi/agent/skills:$HOME/.pi/agent" "omp:$HOME/.omp/agent/skills:$HOME/.omp/agent" "agy:$HOME/.gemini/config/skills:$HOME/.gemini/config"; do
    cli=${pair%%:*}; rest=${pair#*:}; path=${rest%%:*}; parent=${rest#*:}
    if [ ! -d "$parent" ]; then wrn "$cli: belum terpasang (lewati)"; continue; fi
    if [ ! -d "$path" ]; then bad "$cli: ${path/#$HOME/\~} tidak ada. Perbaiki: skill-update"; continue; fi

    # Model baru: path itu sendiri adalah symlink root ke skills/local
    if [ -L "$path" ]; then
      root_tgt=$(resolve_path "$path" 2>/dev/null || true)
      if [ "$root_tgt" = "$(resolve_path "$SK" 2>/dev/null)" ]; then
        n_skills=$(find -L "$path" -maxdepth 1 -mindepth 1 -type d | wc -l | tr -d ' ')
        ok "$cli: ${path/#$HOME/\~} → skills/local ($n_skills skill)"
      else
        bad "$cli: ${path/#$HOME/\~} symlink ke $root_tgt, bukan skills/local. Perbaiki: skill-update"
      fi
    else
      # Model lama: dir berisi per-skill symlinks
      total_links=0; local_links=0; shared_links=0
      while IFS= read -r l; do
        total_links=$((total_links + 1))
        tgt=$(resolve_path "$l" 2>/dev/null || true)
        case "$tgt" in
          "$SK"/*) local_links=$((local_links + 1)) ;;
          "$SHARED"/*) shared_links=$((shared_links + 1)) ;;
        esac
      done < <(find "$path" -maxdepth 1 -type l 2>/dev/null)

      backups_note=""
      shared_note=""
      [ "$shared_links" -gt 0 ] && shared_note="; $shared_links → shared-skills"

      if [ "$total_links" -gt 0 ] && [ "$local_links" -gt 0 ]; then
        wrn "$cli: ${path/#$HOME/\~} memakai legacy per-skill layout ($total_links symlink; $local_links → skills/local$shared_note). Jalankan: skill-update"
      else
        bad "$cli: ${path/#$HOME/\~} tidak berisi symlink skill custom ke skills/local. Perbaiki: skill-update"
      fi
    fi

    # Backup folders hanya relevan di model per-skill symlink (old model)
    if [ ! -L "$path" ]; then
      backups=$(find "$path" -maxdepth 1 -name '*.backup.*' | wc -l | tr -d ' ')
      if [ "$backups" -eq 0 ]; then
        ok "$cli: tidak ada folder *.backup.* di runtime skills"
      else
        wrn "$cli: ada $backups folder backup di ${path/#$HOME/\~} — wrapper update aman kebypass. Rapikan: $DOT/bin/pi-update-safe --help >/dev/null"
      fi
    fi
  done

  CODEX_ROOT="$HOME/.codex/skills"
  if [ -d "$HOME/.codex" ]; then
    [ -d "$CODEX_ROOT/.system" ] \
      && ok "codex: runtime-owned ~/.codex/skills/.system preserved" \
      || bad "codex: ~/.codex/skills/.system missing"
    codex_owned=0
    codex_bad=0
    while IFS= read -r skill_file; do
      skill_dir="$(dirname "$skill_file")"
      name="$(basename "$skill_dir")"
      target="$CODEX_ROOT/$name"
      if [ -L "$target" ] && [ "$(resolve_path "$target" 2>/dev/null)" = "$skill_dir" ]; then
        codex_owned=$((codex_owned + 1))
      else
        codex_bad=$((codex_bad + 1))
      fi
    done < <(find "$SK" -mindepth 2 -maxdepth 2 -name SKILL.md)
    [ "$codex_bad" -eq 0 ] \
      && ok "codex: $codex_owned owned skills visible beside .system" \
      || bad "codex: $codex_bad owned skills missing/stale. Perbaiki: skill-update"
  else
    wrn "codex: belum terpasang (lewati)"
  fi

  UPDATE_EXPECTED="$DOT/skills/agents-bin/skill-update"
  UPDATE_ACTUAL="$(command -v skill-update 2>/dev/null || true)"
  if [ -n "$UPDATE_ACTUAL" ] \
     && [ "$(resolve_path "$UPDATE_ACTUAL" 2>/dev/null)" = "$(resolve_path "$UPDATE_EXPECTED")" ]; then
    ok "skill-update PATH → canonical implementation"
  else
    # "PATH does not point at X" is the wrong diagnosis when nothing is
    # installed at all — the Mac reported it on 2026-09-01 while
    # ~/.local/bin/skill-update simply did not exist, sending the reader to
    # inspect a PATH that was fine.
    if [ -z "$UPDATE_ACTUAL" ]; then
      bad "skill-update belum terpasang di PATH (tidak ada di ~/.local/bin) — jalankan installer dotfiles di device ini"
    else
      bad "skill-update PATH menunjuk $UPDATE_ACTUAL, bukan $UPDATE_EXPECTED"
    fi
  fi
else
  bad "$SK TIDAK ADA"
fi

# ── 5. Dangling symlinks anywhere in the wiring ───────────────────────────────
hdr "5. Symlink menggantung"
d=0
for base in "$HOME/.claude" "$HOME/.codex" "$HOME/.antigravity" "$HOME/.gemini/config" "$HOME/.pi/agent" "$HOME/.omp/agent" "$HOME/.agents" "$HOME/.agents/bin" "$HOME/.local/bin" "$HOME/.config"; do
  [ -d "$base" ] || continue
  while IFS= read -r l; do
    [ -e "$l" ] || { bad "MATI: ${l/#$HOME/\~} → $(readlink "$l")"; d=1; }
  done < <(find "$base" -maxdepth 1 -type l 2>/dev/null)
done
[ $d -eq 0 ] && ok "tidak ada yang menggantung"

# ── 6. Guards ─────────────────────────────────────────────────────────────────
hdr "6. Guard"
if [ -x "$DOT/bin/security-check" ]; then
  ok "security-check tersedia (jalankan eksplisit; doctor default tetap read-only)"
else
  wrn "bin/security-check tidak ada"
fi


# Claude Code settings.json BUKAN symlink (device-local, tidak ikut dotfiles), jadi
# perlindungan .env tidak otomatis ikut ke device baru. permissions.deny ditegakkan
# HARD bahkan di bypassPermissions mode (bukan cuma prosa approval-gate). Cek di sini
# supaya cuan tahu harus menambahkannya — dan supaya reset settings tidak lolos senyap.
# ⚠️ Cek profil yang SEDANG AKTIF, bukan cuma ~/.claude. Dotfiles pindah ke "single native
# profile" 2026-07-29; di `Fantastico` residu switcher-nya (bin/akun, claude-kerja,
# claude-personal, ~/.claude-accounts/, slash /akun) baru benar-benar dihapus 2026-09-04 —
# sebelum itu masih ada profil kedua tanpa settings.json sama sekali yang sempat menerima
# tulisan sesi. Mekanisme CLAUDE_CONFIG_DIR sendiri milik Claude Code, bukan milik dotfiles,
# jadi ia tetap bisa dipakai kapan pun: cek ini SENGAJA mengikuti profil aktif. Kalau
# CLAUDE_CONFIG_DIR tak disetel, ini persis sama dengan versi single-profile.
CC_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
CC_SETTINGS="$CC_DIR/settings.json"
if command -v claude >/dev/null 2>&1; then
  [ "$CC_DIR" != "$HOME/.claude" ] && \
    wrn "Claude profil aktif BUKAN ~/.claude melainkan $CC_DIR (CLAUDE_CONFIG_DIR disetel). Dotfiles mengasumsikan satu profil native; pastikan profil ini punya deny .env + hook yang sama."
  if [ ! -f "$CC_SETTINGS" ]; then
    # Kasus paling berisik justru yang dulu paling senyap: sampai 2026-09-04 blok ini
    # dijaga `[ -f "$CC_SETTINGS" ]`, jadi profil TANPA settings.json — nol deny .env,
    # nol hook — lolos tanpa sepatah kata. Persis yang terjadi pada ~/.claude-accounts/personal.
    wrn "Claude settings: $CC_SETTINGS TIDAK ADA — profil ini jalan tanpa permissions.deny dan tanpa hook. Buat file itu (lalu jalankan ai-hooks-install) sebelum dipakai."
  elif grep -qE 'Read\((\*\*/)?\.env' "$CC_SETTINGS" 2>/dev/null; then
    ok "Claude settings: permissions.deny memblokir baca .env (ditegakkan bahkan di bypass)"
  else
    wrn "Claude settings: TIDAK ada permissions.deny untuk .env — agent bisa membaca secret di bypass mode. Tambahkan blok \"permissions\":{\"deny\":[\"Read(.env*)\",\"Read(**/.env*)\",\"Read(.dev.vars*)\",\"Read(~/.ssh/**)\",\"Read(~/.aws/**)\"]} ke $CC_SETTINGS"
  fi
  # Detektor regresi residu multi-akun: direktori ini tidak lagi punya pemilik di dotfiles,
  # jadi kalau ia muncul lagi artinya ada yang menghidupkan profil kedua tanpa settings.
  [ -d "$HOME/.claude-accounts" ] && \
    wrn "Residu multi-akun muncul lagi: ~/.claude-accounts ada. Profil itu tidak dikelola dotfiles (tanpa deny .env / hook). Hapus, atau lengkapi settings.json-nya kalau memang disengaja."
fi

# Hook WIRING, bukan cuma hook-nya ada. Sampai 2026-08-16 doctor hanya menjalankan
# git-guard.test.sh — itu membuktikan skripnya benar, BUKAN bahwa ada entri di
# settings.json yang memanggilnya. Device baru dapat git-guard.sh dari clone dotfiles
# lalu tetap hijau di sini walau hook-nya tidak pernah terpasang: alarm yang menguji
# benda yang salah, persis pola yang sama dengan cek .env di atas.
# settings.json device-local (ada `model`, `theme`, plugin), jadi tidak bisa di-symlink —
# `ai-hooks-install` yang merekonsiliasi entri dari config/ai/claude-hooks.json.
if command -v claude >/dev/null 2>&1 && [ -x "$DOT/bin/ai-hooks-install" ]; then
  if hook_out="$(CLAUDE_SETTINGS="$CC_SETTINGS" "$DOT/bin/ai-hooks-install" --check --dotfiles "$DOT" 2>&1)"; then
    ok "Claude hooks: semua hook canonical terpasang di $CC_SETTINGS"
  else
    wrn "Claude hooks: ada yang BELUM terpasang — perbaiki dengan: ai-hooks-install. Detail: $(printf '%s' "$hook_out" | tr '\n' ' ')"
  fi
fi

# ── 7. CLI + login ────────────────────────────────────────────────────────────
hdr "7. AI CLI di device ini"
for c in claude codex pi agy omp; do
  if command -v "$c" >/dev/null 2>&1; then
    case "$c" in
      codex) [ -f "$HOME/.codex/auth.json" ] && ok "codex: terpasang + login" \
               || wrn "codex: terpasang tapi BELUM LOGIN → jalankan: codex login" ;;
      claude)
        # `claude --version` OK sekarang tidak berarti aman ke depan: npm 12+ memblokir
        # postinstall-nya (allowScripts) kecuali di-allowlist, dan blokir itu kena LAGI
        # tiap kali paket ter-upgrade — termasuk upgrade yang ter-trigger otomatis oleh
        # CLI-nya sendiri, bukan cuma sekali di instalasi awal. install.sh/install-macos.sh
        # sudah mengatur allowlist ini; device yang di-bootstrap sebelum perbaikan itu ada
        # tidak dapat allowlist-nya walau native binary-nya kebetulan masih utuh sekarang.
        if claude --version >/dev/null 2>&1; then
          if command -v npm >/dev/null 2>&1; then
            # `--location=user` baca eksplisit apa yang tertulis di ~/.npmrc, bukan nilai
            # gabungan efektif — .npmrc proyek di cwd lain bisa menyembunyikan entri user.
            allowed="$(npm config get allow-scripts --location=user 2>/dev/null || true)"
            # ignore-scripts=true (efektif, dari layer manapun) MEMBATALKAN allow-scripts
            # sepenuhnya — allowlist di atas jadi percuma kalau ini aktif.
            ignore_scripts="$(npm config get ignore-scripts 2>/dev/null || true)"
            case ",$allowed," in
              *,@anthropic-ai/claude-code,*)
                if [ "$ignore_scripts" = "true" ]; then
                  wrn "claude: npm allow-scripts terpasang tapi npm ignore-scripts=true MEMBATALKANNYA — postinstall tetap tidak akan jalan. Perbaiki: npm config delete ignore-scripts (atau set false)"
                else
                  ok "claude: terpasang + native binary OK + npm allow-scripts terpasang"
                fi ;;
              *)
                wrn "claude: native binary OK sekarang, tapi npm allow-scripts BELUM mengizinkan @anthropic-ai/claude-code — upgrade berikutnya (manual atau otomatis) berisiko memblokir postinstall-nya lagi. Perbaiki: npm config set allow-scripts=@anthropic-ai/claude-code --location=user" ;;
            esac
          else
            ok "claude: terpasang + native binary OK"
          fi
        else
          wrn "claude: launcher ada tetapi native binary gagal; doctor tidak memperbaiki otomatis. Perbaiki: node \"\$(npm root -g)/@anthropic-ai/claude-code/install.cjs\""
        fi ;;
      pi)    ok "pi: terpasang (capability opsional, bukan control plane OMP)" ;;
      *)     ok "$c: terpasang" ;;
    esac
  else
    wrn "$c: belum terpasang di device ini"
  fi
done

# ── 8. OMP configuration ──────────────────────────────────────────────────────
hdr "8. OMP"
for name in config.yml models.yml agents; do
  live="$HOME/.omp/agent/$name"
  tracked="$DOT/config/omp/$name"
  if [ -L "$live" ] && [ "$(readlink "$live" 2>/dev/null)" = "$tracked" ]; then
    bad "OMP $name masih memakai legacy dotfiles override — jalankan installer migration"
  else
    ok "OMP $name dimiliki runtime/upstream"
  fi
done

if grep -qE '^[[:space:]]*(function[[:space:]]+)?omp[[:space:]]*\(\)' "$DOT/config/shell-tools.sh" \
   || grep -q 'PI_CONFIG_FILES' "$DOT/config/shell-tools.sh"; then
  bad "shell-tools masih mengubah command atau config discovery OMP"
else
  ok "OMP command dan config discovery tetap upstream-native"
fi

if command -v omp-routing-test >/dev/null 2>&1 \
   && command -v omp-effective-routing-test >/dev/null 2>&1 \
   && command -v omp-workspace-test >/dev/null 2>&1; then
  ok "OMP native-boundary regression tests tersedia di PATH"
else
  bad "OMP native-boundary regression tests belum lengkap di PATH — jalankan installer"
fi

if [ -e "$HOME/.omp/agent/mcp.json" ] || [ -L "$HOME/.omp/agent/mcp.json" ]; then
  ok "OMP user MCP config tersedia dan tetap dikelola melalui native path"
else
  ok "OMP memakai native/project MCP discovery; shared user MCP belum dikonfigurasi"
fi

# ── 9. Memory drift ───────────────────────────────────────────────────────────
hdr "9. Memori vs disk (aturan: disk menang)"
if [ -d "$AI/memory" ]; then
  drift=0
  while IFS='|' read -r pat note; do
    hits=$(grep -rn -- "$pat" "$AI/memory" "$AI/project-memory" "$AI/AGENTS.md" 2>/dev/null \
      | grep -viE "TIDAK ADA|DOES NOT EXIST|USANG|STALE|OLD|SALAH|WRONG|BUKAN|jangan|dead|REMOVED|OBSOLETE|⚠️|BACA DULU" \
      | wc -l | tr -d ' ')
    if [ "$hits" -gt 0 ]; then
      wrn "memori masih menunjuk $note ($hits baris) — pat: $pat"
      drift=1
    fi
  # `/home/fantastico` was on this list as a dead user. The device `Fantastico`
  # (ThinkPad X280) joined devices/ on 2026-08-15, so the pattern now flags a
  # live machine's own paths as drift — the check inverted into the error it
  # exists to catch. A drift pattern is a claim about disk: retire it when disk
  # changes, and confirm against devices/ before adding a per-user path here.
  done <<'PATS'
~/.ai/|direktori yang tidak ada
Documents/memori ai|folder yang tidak ada
~/.gemini/skills|obsolete Antigravity skill path
97 per-skill|obsolete external skill layout
jezweb|obsolete external skill source
neither has a skill directory|obsolete manual skill discovery claim
PATS
  [ $drift -eq 0 ] && ok "tidak ada path mati yang dirujuk memori"
fi

# ── Verdict ───────────────────────────────────────────────────────────────────
printf '\n────────────────────────────────────────\n'
if [ $fail -eq 0 ] && [ $warn -eq 0 ]; then
  printf '\033[32mSEHAT\033[0m — rantai AI ↔ device ↔ memori utuh.\n'
elif [ $fail -eq 0 ]; then
  printf '\033[33mOK dengan %d catatan\033[0m — jalan, tapi ada yang belum lengkap (lihat ! di atas).\n' "$warn"
else
  printf '\033[31m%d RUSAK\033[0m, %d catatan — perbaiki yang ✗ dulu.\n' "$fail" "$warn"
  exit 1
fi
