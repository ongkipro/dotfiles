#!/usr/bin/env bash
set -euo pipefail
ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd)}"
PC="$ROOT/bin/project-check"; PG="$ROOT/bin/production-gate"; TMP="$(mktemp -d "${TMPDIR:-/tmp}/delivery-gate-test.XXXXXX")"; trap 'rm -rf "$TMP"' EXIT
fail(){ echo "FAIL: $*" >&2; exit 1; }

mkdir -p "$TMP/unknown"
set +e; "$PC" "$TMP/unknown" >"$TMP/unknown.log" 2>&1; rc=$?; set -e
[ "$rc" -eq 2 ] || fail "unknown project should be UNVERIFIED"

mkdir -p "$TMP/bad-node"; printf '{not-json}\n' >"$TMP/bad-node/package.json"
set +e; "$PC" --full "$TMP/bad-node" >/dev/null 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "invalid package.json should fail"

mkdir -p "$TMP/node"; cd "$TMP/node"; git init -q; git config user.email test@example.invalid; git config user.name test
cat > package.json <<'JSON'
{"scripts":{"test":"node -e \"process.exit(0)\"","build":"node -e \"process.exit(0)\""}}
JSON
cat > TASKS.md <<'EOF'
# Tasks
## In progress
No task is in progress.
## Pending
No implementation task has been accepted.
## Done
### TASK-001
Completed.
EOF
git add . && git commit -qm baseline; BASE="$(git rev-parse HEAD)"
printf 'release\n' > feature.txt
cat > STATUS.md <<'EOF'
# Status
State: INTEGRATING
Review-Risk: R1
Independent-Review: PENDING
Smoke-URL: TBD
Smoke-Contains: TBD
EOF
cat > RELEASE.md <<EOF
# Release Manifest
Release-ID: REL-TEST-001
Base: $BASE
Environment: production
Declared-Risk: R1
Rollback-Ref: $BASE
Rollback-Command: git checkout $BASE -- .
Backup-Proof: NOT_REQUIRED
Status: READY
EOF
git add . && git commit -qm release
"$PC" --full . >/dev/null || fail "node fixture should verify"
"$PG" . >"$TMP/prod.log" 2>&1 || { cat "$TMP/prod.log" >&2; fail "production fixture should pass"; }
grep -q 'PRODUCTION_GATE=PRODUCTION_READY' "$TMP/prod.log" || fail "production-ready result missing"

python3 - <<'PY'
from pathlib import Path
p=Path('STATUS.md'); p.write_text(p.read_text().replace('Review-Risk: R1','Review-Risk: R3'))
PY
git add STATUS.md && git commit -qm semantic-risk
set +e; "$PG" . >"$TMP/r3.log" 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "R3 without independent review should block"

echo 'delivery-gate-test: PASS'
