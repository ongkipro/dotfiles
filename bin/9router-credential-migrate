#!/usr/bin/env bash
# Opt-in migration of the legacy Pi-held 9Router key to runtime-neutral storage.
set -euo pipefail

if [ "$#" -ne 0 ]; then
  printf 'usage: 9router-credential-migrate\n' >&2
  exit 2
fi

source_file="$HOME/.pi/agent/auth.json"
credential_dir="$HOME/.config/ai-local/credentials"
destination="$credential_dir/9router-remote-key"
temp_file=""

if ! command -v jq >/dev/null 2>&1; then
  printf '9router-credential-migrate: jq is required\n' >&2
  exit 1
fi
if [ ! -r "$source_file" ]; then
  printf '9router-credential-migrate: legacy Pi auth is not readable; nothing migrated\n' >&2
  exit 1
fi
if [ -e "$destination" ]; then
  printf '9router-credential-migrate: destination already exists; refusing to overwrite it\n' >&2
  exit 1
fi

umask 077
mkdir -p "$credential_dir"
temp_file="$(mktemp "$credential_dir/.9router-remote-key.XXXXXX")"
trap 'rm -f "$temp_file"' EXIT HUP INT TERM
chmod 600 "$temp_file"

if ! jq -er '."9router-fantastico".key | select(type == "string" and length > 0)' \
  "$source_file" > "$temp_file"; then
  printf '9router-credential-migrate: legacy Pi auth has no usable 9Router key\n' >&2
  exit 1
fi

if ! ln "$temp_file" "$destination"; then
  printf '9router-credential-migrate: destination appeared during migration; refusing to overwrite it\n' >&2
  exit 1
fi
rm -f "$temp_file"
temp_file=""
trap - EXIT HUP INT TERM

printf '9router-credential-migrate: credential copied to %s with mode 0600; source left unchanged\n' "$destination"
