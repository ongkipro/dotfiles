#!/usr/bin/env bash
set -euo pipefail
SELF="$(readlink -f "$0" 2>/dev/null || realpath "$0")"
ROOT="${1:-$(cd "$(dirname "$SELF")/.." && pwd)}"
ROUTER="$ROOT/bin/ai-memory-route"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/ai-memory-route-test.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
fail(){ echo "FAIL: $*" >&2; exit 1; }

python3 - "$ROOT/config/ai/memory-router.json" <<'PY'
import json,sys
defaults=json.load(open(sys.argv[1]))['defaults']
assert defaults['maxFiles']==3 and defaults['maxBytes']==12000, defaults
assert 'freshnessDays' not in defaults, defaults
PY


python3 "$ROUTER" 'format and tone preference' --json > "$TMP/shared.json"
python3 - "$TMP/shared.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1]))
assert p['needed'] is True
assert any(x['path'].endswith('preferences.md') for x in p['files'])
assert len(p['files']) <= 3
assert p['budget']['usedBytes'] <= p['budget']['maxBytes']
PY

python3 "$ROUTER" 'completely unrelated ephemeral arithmetic' --json > "$TMP/none.json"
python3 - "$TMP/none.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1]))
assert p['needed'] is False
assert p['files'] == []
PY

REPO="$TMP/volumup"; mkdir -p "$REPO/.delivery"

IDENTITY_REPO="$TMP/unmapped-local-name"
mkdir -p "$IDENTITY_REPO"
git -C "$IDENTITY_REPO" init -q
git -C "$IDENTITY_REPO" remote add origin git@github.com:example/stable-repo-id.git
python3 "$ROUTER" 'project reference' --repo "$IDENTITY_REPO" --json > "$TMP/identity.json"
python3 - "$TMP/identity.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1]))
assert p['project'] == 'stable-repo-id', p
assert not any(x['scope'] == 'project' for x in p['files']), p
PY
cat > "$REPO/STATUS.md" <<'EOF'
State: IMPLEMENTING
EOF
cat > "$REPO/TASKS.md" <<'EOF'
# Tasks
EOF
cat > "$REPO/.delivery/current.json" <<'EOF'
{"schemaVersion":1}
EOF
python3 "$ROUTER" 'what is 2 + 2?' --repo "$REPO" --json > "$TMP/self-contained.json"
python3 - "$TMP/self-contained.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); assert p['needed'] is False; assert p['files']==[]
PY
# Everyday Indonesian continuation must find local execution truth, while
# unrelated words and self-contained work must not trigger a whole workflow.
python3 - "$ROUTER" "$REPO" <<'PY'
import json, subprocess, sys
router, repo = sys.argv[1:]
for query in ('lanjut yang tadi','lanjutin yg tadi','lanjt task tadi','status pekerjaan sekarang','apa langkah berikutnya?'):
    p=json.loads(subprocess.check_output([sys.executable,router,query,'--repo',repo,'--json'],text=True))
    assert any(f['scope']=='execution' for f in p['files']), (query,p)
    assert not any(f['scope']=='project' for f in p['files']), (query,p)
for query in ('hitung 2 tambah 2','ubah warna tombol ini','currentlyrical taskmaster nextjs curriculum','cerita berlanjut di kota',
              'apa angka berikutnya dari 2, 4, 6?','lanjutkan cerita fiksi ini satu paragraf','apa langkah berikutnya untuk merebus telur?'):
    p=json.loads(subprocess.check_output([sys.executable,router,query,'--repo',repo,'--json'],text=True))
    assert not any(f['scope']=='execution' for f in p['files']), (query,p)
for query in ('tolong lanjut audit repo ini','lanjutkan tugas yang tadi'):
    p=json.loads(subprocess.check_output([sys.executable,router,query,'--repo',repo,'--json'],text=True))
    assert any(f['scope']=='execution' for f in p['files']), (query,p)
PY
python3 "$ROUTER" 'digital painting techniques' --json > "$TMP/token-boundary.json"
python3 - "$TMP/token-boundary.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); assert not any(x['path'].endswith('workflow.md') for x in p['files'])
PY
BUDGET_ROOT="$TMP/budget-dotfiles"
mkdir -p "$BUDGET_ROOT/bin" "$BUDGET_ROOT/config/ai/memory"
cp "$ROUTER" "$BUDGET_ROOT/bin/ai-memory-route"
cat >"$BUDGET_ROOT/config/ai/memory-router.json" <<'EOF'
{"schemaVersion":1,"defaults":{"maxFiles":3,"maxBytes":1000},"shared":[{"path":"config/ai/memory/environment.md","priority":40,"triggers":["environment"]}],"projects":{},"lessons":[]}
EOF
python3 - "$BUDGET_ROOT/config/ai/memory/environment.md" <<'PY'
from pathlib import Path
import sys
Path(sys.argv[1]).write_bytes(b'x' * 1500)
PY
python3 "$BUDGET_ROOT/bin/ai-memory-route" 'environment' --json > "$TMP/budget.json"
python3 - "$TMP/budget.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); assert p['budget']['usedBytes'] == 0
assert any(x.startswith('UNROUTABLE environment.md ') for x in p['reason']), p['reason']
PY
python3 "$BUDGET_ROOT/bin/ai-memory-route" 'environment' >"$TMP/budget.txt"
grep -qF 'WARNING UNROUTABLE environment.md' "$TMP/budget.txt"
python3 "$ROUTER" 'continue current task and tell me next blocker' --repo "$REPO" --project volumup --json > "$TMP/project.json"
python3 - "$TMP/project.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1]))
scopes={x['scope'] for x in p['files']}
assert 'execution' in scopes
assert p['project']=='volumup'
PY
KEL_REPO="$TMP/kelola"; mkdir -p "$KEL_REPO"
python3 "$ROUTER" 'load stable Kelola project reference' --repo "$KEL_REPO" --project kelola --json > "$TMP/kelola.json"
python3 - "$TMP/kelola.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); assert any(x['path'].endswith('project-memory-kelola/MEMORY.md') for x in p['files'])
PY

# ── Multi-file project keys (TASK-051) ───────────────────────────────────────
# A key used to name exactly one file. Six of seven tokophi notes and all four
# pixsgo notes were unreachable because of it, in a repository whose own memory
# forbids scanning the directory — unrouted meant invisible, not deprioritised.
MULTI="$TMP/multi"
mkdir -p "$MULTI/bin" "$MULTI/config/ai/project-memory"
cp "$ROUTER" "$MULTI/bin/ai-memory-route"
MROUTE="$MULTI/bin/ai-memory-route"
MANIFEST="$MULTI/config/ai/memory-router.json"
printf 'base note\n' > "$MULTI/config/ai/project-memory/demo.md"
printf 'deploy note with enough body to be distinct\n' > "$MULTI/config/ai/project-memory/demo-deploy.md"
printf 'domain note\n' > "$MULTI/config/ai/project-memory/demo-domain.md"
DEMO="$TMP/demo"; mkdir -p "$DEMO"

cat > "$MANIFEST" <<'JSON'
{"schemaVersion":1,"defaults":{"maxFiles":3,"maxBytes":12000},"shared":[],"lessons":[],
 "projects":{"demo":[
   "config/ai/project-memory/demo.md",
   {"path":"config/ai/project-memory/demo-deploy.md","triggers":["deploy","release"]},
   "config/ai/project-memory/demo-domain.md"]}}
JSON

# A bare project query keeps the historic answer first: list order is priority.
python3 "$MROUTE" 'project memory' --repo "$DEMO" --project demo --scope project --json > "$TMP/multi-bare.json"
python3 - "$TMP/multi-bare.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); paths=[f['path'] for f in p['files']]
assert len(paths)==3, paths
assert paths[0].endswith('/demo.md'), paths
PY

# A trigger lifts its own file above list order — the point of the shape, and
# what lets "deploy" reach a deploy note instead of the project index.
python3 "$MROUTE" 'deploy steps' --repo "$DEMO" --project demo --scope project --json > "$TMP/multi-trig.json"
python3 - "$TMP/multi-trig.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); paths=[f['path'] for f in p['files']]
assert paths[0].endswith('demo-deploy.md'), paths
assert any('trigger' in f.get('reason','') for f in p['files']), p['files']
PY

# The old single-string shape must keep working; this change is additive.
cat > "$MANIFEST" <<'JSON'
{"schemaVersion":1,"defaults":{"maxFiles":3,"maxBytes":12000},"shared":[],"lessons":[],
 "projects":{"demo":"config/ai/project-memory/demo.md"}}
JSON
python3 "$MROUTE" 'project memory' --repo "$DEMO" --project demo --scope project --json > "$TMP/multi-str.json"
python3 - "$TMP/multi-str.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); paths=[f['path'] for f in p['files']]
assert len(paths)==1 and paths[0].endswith('/demo.md'), paths
PY

# An entry naming a file that is gone is skipped, not crashed on, and does not
# stop the surviving entries from routing.
cat > "$MANIFEST" <<'JSON'
{"schemaVersion":1,"defaults":{"maxFiles":3,"maxBytes":12000},"shared":[],"lessons":[],
 "projects":{"demo":["config/ai/project-memory/gone.md","config/ai/project-memory/demo.md"]}}
JSON
python3 "$MROUTE" 'project memory' --repo "$DEMO" --project demo --scope project --json > "$TMP/multi-gone.json"
python3 - "$TMP/multi-gone.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); paths=[f['path'] for f in p['files']]
assert len(paths)==1 and paths[0].endswith('/demo.md'), paths
PY

echo "  ✓ multi-file project keys: list order, trigger lift, string form, missing entry"

# Path triggers remain candidates, but large path-only files cannot monopolize
# the budget (TASK-156). Explicit topic requests still admit the same file.
PT="$TMP/pathrepo"; mkdir -p "$PT/src"; git -C "$PT" init -q; printf 'a{}\n' > "$PT/src/x.css"
python3 "$ROUTER" 'fix this please' --repo "$PT" --json > "$TMP/path.json"
python3 - "$TMP/path.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1]))
assert not any(x['path'].endswith('ui-lessons.md') for x in p['files']), p
assert any('deferred ui-lessons.md' in r for r in p['reason']), p
PY
python3 "$ROUTER" 'fix headless ui portal' --repo "$PT" --json > "$TMP/explicit-ui.json"
python3 - "$TMP/explicit-ui.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1]))
assert any(x['path'].endswith('ui-lessons.md') for x in p['files']), p
PY
rm -f "$PT/src/x.css"; mkdir -p "$PT/components/ui"; printf 'x\n' > "$PT/components/ui/my button.tsx"
python3 "$ROUTER" 'fix this please' --repo "$PT" --json > "$TMP/root.json"
python3 - "$TMP/root.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1]))
assert not any(x['path'].endswith('ui-lessons.md') for x in p['files']), p
assert any('deferred ui-lessons.md' in r for r in p['reason']), p
PY
rm -rf "$PT/components"; printf 'x\n' > "$PT/notes.txt"
python3 "$ROUTER" 'fix this please' --repo "$PT" --json > "$TMP/nopath.json"
python3 - "$TMP/nopath.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1]))
assert not any(x['path'].endswith('development-lessons.md') for x in p['files']), p
PY
echo "  ✓ path triggers route from changed files and stay quiet otherwise"
# Deterministic precision cases: current-project triggers, no unrelated fallback,
# scope filtering, foreign ownership, and path budget starvation.
python3 - "$ROUTER" "$TMP" <<'PY'
import runpy,sys
from pathlib import Path
m=runpy.run_path(sys.argv[1]); root=Path(sys.argv[2])/'precision'; root.mkdir()
repo=root/'shop'; repo.mkdir()
for name,size in [('slug.md',60),('other.md',50),('shared.md',200),('large.md',500),('small.md',200)]:
    (root/name).write_text('x'*size)
manifest={'projects':{'shop':[{'path':'slug.md','triggers':['slug']}],
                      'other':[{'path':'other.md','triggers':['slug']}]},
          'shared':[{'path':'shared.md','triggers':['slug'],'priority':90},
                    {'path':'other.md','triggers':['slug'],'priority':99}], 'lessons':[]}
def route(q,scope='auto',budget=1000,references=()):
    return m['select'](root,manifest,q,scope,repo,None,3,budget,references)
def names(r): return [Path(f['path']).name for f in r['files']]
r=route('perbaiki slug produk',budget=100)
assert names(r)==['slug.md'],r
assert not route('hitung 2 tambah 2')['files']
assert 'other.md' not in names(route('slug'))
for q in ('slug reference other','jangan pakai other slug','without other slug','kelola slug produk','pi slug'):
    assert 'other.md' not in names(route(q)),q
assert 'other.md' in names(route('slug',references=['other']))
# A project-owned note registered only as a lesson is still owned: prose cannot admit it.
manifest['lessons']=[{'path':'other.md','triggers':['slug'],'priority':100}]
assert 'other.md' not in names(route('slug'))
assert 'other.md' in names(route('slug',references=['other']))
manifest['lessons']=[]
manifest['projects']['other'][0]['path']='./other.md'
(root/'alias.md').symlink_to(root/'other.md')
manifest['lessons']=[{'path':'alias.md','triggers':['slug'],'priority':100}]
assert 'other.md' not in names(route('slug')) and 'alias.md' not in names(route('slug'))
assert 'other.md' in names(route('slug',references=['other']))
manifest['lessons']=[]
try: route('slug',references=['missing'])
except ValueError: pass
else: raise AssertionError('unknown reference accepted')
for scope in ('shared','lesson','execution'):
    assert not any(f['scope']=='reference' for f in route('reference other',scope)['files'])
(repo/'STATUS.md').write_text('State: READY\n')
assert route('current slug')['files'][0]['scope']=='execution'
# Replace path discovery only: exercise real selection and real file sizes.
m['select'].__globals__['changed_paths']=lambda repo:['src/file.css']
manifest={'projects':{},'lessons':[], 'shared':[
    {'path':'large.md','paths':['**/*.css'],'priority':99},
    {'path':'small.md','paths':['**/*.css'],'priority':98},
    {'path':'shared.md','paths':['**/*.css'],'priority':97}]}
assert names(route('fix this'))==['small.md']
# A path-only candidate that does not fit the remaining budget cannot consume
# the one-file allowance and suppress a later smaller candidate.
manifest['shared'].insert(0,{'path':'large.md','triggers':['explicit'],'priority':100})
(root/'small.md').write_text('x'*400); (root/'shared.md').write_text('x'*100)
assert names(route('explicit',budget=800))==['large.md','shared.md']
print('ai-memory-route-test: project isolation, scopes, path budget PASS')
PY

# Current repository truth retains priority when three durable topics match.
python3 - "$ROUTER" "$TMP" <<'PY'
import runpy,sys
from pathlib import Path
m=runpy.run_path(sys.argv[1]);root=Path(sys.argv[2]);repo=root/'truth';repo.mkdir()
(repo/'STATUS.md').write_text('State: READY\n');(repo/'TASKS.md').write_text('# Tasks\n')
items=[]
for i in range(3):
 p=root/f'topic{i}.md';p.write_text('stable note\n');items.append({'path':p.name,'priority':99,'triggers':['status','current','topic']})
manifest={'shared':items}
r=m['select'](root,manifest,'current status topic','auto',repo,None,3,12000)
assert [Path(f['path']).name for f in r['files'][:2]]==['STATUS.md','TASKS.md'],r
r=m['select'](root,manifest,'topic','auto',repo,None,3,12000)
assert all(f['scope']=='shared' for f in r['files']) and len(r['files'])==3
print('ai-memory-route-test: execution priority under competing triggers PASS')
PY
echo 'ai-memory-route-test: PASS'
