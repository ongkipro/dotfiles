#!/usr/bin/env bash
set -euo pipefail
SELF="$(readlink -f "$0" 2>/dev/null || realpath "$0")"
ROOT="${1:-$(cd "$(dirname "$SELF")/.." && pwd)}"
ROUTER="$ROOT/bin/ai-memory-route"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/ai-memory-route-test.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
fail(){ echo "FAIL: $*" >&2; exit 1; }

python3 - "$ROOT/config/ai/memory-router.json" <<'PY'
import json,sys
defaults=json.load(open(sys.argv[1]))['defaults']
assert defaults['maxFiles']==3 and defaults['maxBytes']==12000, defaults
assert 'freshnessDays' not in defaults, defaults
PY


python3 "$ROUTER" 'format and tone preference' --json > "$TMP/shared.json"
python3 - "$TMP/shared.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1]))
assert p['needed'] is True
assert any(x['path'].endswith('preferences.md') for x in p['files'])
assert len(p['files']) <= 3
assert p['budget']['usedBytes'] <= p['budget']['maxBytes']
PY

python3 "$ROUTER" 'completely unrelated ephemeral arithmetic' --json > "$TMP/none.json"
python3 - "$TMP/none.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1]))
assert p['needed'] is False
assert p['files'] == []
PY

REPO="$TMP/volumup"; mkdir -p "$REPO/.delivery"

IDENTITY_REPO="$TMP/unmapped-local-name"
mkdir -p "$IDENTITY_REPO"
git -C "$IDENTITY_REPO" init -q
git -C "$IDENTITY_REPO" remote add origin git@github.com:example/stable-repo-id.git
python3 "$ROUTER" 'project reference' --repo "$IDENTITY_REPO" --json > "$TMP/identity.json"
python3 - "$TMP/identity.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1]))
assert p['project'] == 'stable-repo-id', p
assert not any(x['scope'] == 'project' for x in p['files']), p
PY
cat > "$REPO/STATUS.md" <<'EOF'
State: IMPLEMENTING
EOF
cat > "$REPO/TASKS.md" <<'EOF'
# Tasks
EOF
cat > "$REPO/.delivery/current.json" <<'EOF'
{"schemaVersion":1}
EOF
python3 "$ROUTER" 'what is 2 + 2?' --repo "$REPO" --json > "$TMP/self-contained.json"
python3 - "$TMP/self-contained.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); assert p['needed'] is False; assert p['files']==[]
PY
python3 "$ROUTER" 'digital painting techniques' --json > "$TMP/token-boundary.json"
python3 - "$TMP/token-boundary.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); assert not any(x['path'].endswith('workflow.md') for x in p['files'])
PY
BUDGET_ROOT="$TMP/budget-dotfiles"
mkdir -p "$BUDGET_ROOT/bin" "$BUDGET_ROOT/config/ai/memory"
cp "$ROUTER" "$BUDGET_ROOT/bin/ai-memory-route"
cat >"$BUDGET_ROOT/config/ai/memory-router.json" <<'EOF'
{"schemaVersion":1,"defaults":{"maxFiles":3,"maxBytes":1000},"shared":[{"path":"config/ai/memory/environment.md","priority":40,"triggers":["environment"]}],"projects":{},"lessons":[]}
EOF
python3 - "$BUDGET_ROOT/config/ai/memory/environment.md" <<'PY'
from pathlib import Path
import sys
Path(sys.argv[1]).write_bytes(b'x' * 1500)
PY
python3 "$BUDGET_ROOT/bin/ai-memory-route" 'environment' --json > "$TMP/budget.json"
python3 - "$TMP/budget.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); assert p['budget']['usedBytes'] == 0
assert any(x.startswith('UNROUTABLE environment.md ') for x in p['reason']), p['reason']
PY
python3 "$BUDGET_ROOT/bin/ai-memory-route" 'environment' >"$TMP/budget.txt"
grep -qF 'WARNING UNROUTABLE environment.md' "$TMP/budget.txt"
python3 "$ROUTER" 'continue current task and tell me next blocker' --repo "$REPO" --project volumup --json > "$TMP/project.json"
python3 - "$TMP/project.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1]))
scopes={x['scope'] for x in p['files']}
assert 'execution' in scopes
assert p['project']=='volumup'
PY
KEL_REPO="$TMP/kelola"; mkdir -p "$KEL_REPO"
python3 "$ROUTER" 'load stable Kelola project reference' --repo "$KEL_REPO" --project kelola --json > "$TMP/kelola.json"
python3 - "$TMP/kelola.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); assert any(x['path'].endswith('project-memory-kelola/MEMORY.md') for x in p['files'])
PY

# ── Multi-file project keys (TASK-051) ───────────────────────────────────────
# A key used to name exactly one file. Six of seven tokophi notes and all four
# pixsgo notes were unreachable because of it, in a repository whose own memory
# forbids scanning the directory — unrouted meant invisible, not deprioritised.
MULTI="$TMP/multi"
mkdir -p "$MULTI/bin" "$MULTI/config/ai/project-memory"
cp "$ROUTER" "$MULTI/bin/ai-memory-route"
MROUTE="$MULTI/bin/ai-memory-route"
MANIFEST="$MULTI/config/ai/memory-router.json"
printf 'base note\n' > "$MULTI/config/ai/project-memory/demo.md"
printf 'deploy note with enough body to be distinct\n' > "$MULTI/config/ai/project-memory/demo-deploy.md"
printf 'domain note\n' > "$MULTI/config/ai/project-memory/demo-domain.md"
DEMO="$TMP/demo"; mkdir -p "$DEMO"

cat > "$MANIFEST" <<'JSON'
{"schemaVersion":1,"defaults":{"maxFiles":3,"maxBytes":12000},"shared":[],"lessons":[],
 "projects":{"demo":[
   "config/ai/project-memory/demo.md",
   {"path":"config/ai/project-memory/demo-deploy.md","triggers":["deploy","release"]},
   "config/ai/project-memory/demo-domain.md"]}}
JSON

# A bare project query keeps the historic answer first: list order is priority.
python3 "$MROUTE" 'project memory' --repo "$DEMO" --project demo --scope project --json > "$TMP/multi-bare.json"
python3 - "$TMP/multi-bare.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); paths=[f['path'] for f in p['files']]
assert len(paths)==3, paths
assert paths[0].endswith('/demo.md'), paths
PY

# A trigger lifts its own file above list order — the point of the shape, and
# what lets "deploy" reach a deploy note instead of the project index.
python3 "$MROUTE" 'deploy steps' --repo "$DEMO" --project demo --scope project --json > "$TMP/multi-trig.json"
python3 - "$TMP/multi-trig.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); paths=[f['path'] for f in p['files']]
assert paths[0].endswith('demo-deploy.md'), paths
assert any('trigger' in f.get('reason','') for f in p['files']), p['files']
PY

# The old single-string shape must keep working; this change is additive.
cat > "$MANIFEST" <<'JSON'
{"schemaVersion":1,"defaults":{"maxFiles":3,"maxBytes":12000},"shared":[],"lessons":[],
 "projects":{"demo":"config/ai/project-memory/demo.md"}}
JSON
python3 "$MROUTE" 'project memory' --repo "$DEMO" --project demo --scope project --json > "$TMP/multi-str.json"
python3 - "$TMP/multi-str.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); paths=[f['path'] for f in p['files']]
assert len(paths)==1 and paths[0].endswith('/demo.md'), paths
PY

# An entry naming a file that is gone is skipped, not crashed on, and does not
# stop the surviving entries from routing.
cat > "$MANIFEST" <<'JSON'
{"schemaVersion":1,"defaults":{"maxFiles":3,"maxBytes":12000},"shared":[],"lessons":[],
 "projects":{"demo":["config/ai/project-memory/gone.md","config/ai/project-memory/demo.md"]}}
JSON
python3 "$MROUTE" 'project memory' --repo "$DEMO" --project demo --scope project --json > "$TMP/multi-gone.json"
python3 - "$TMP/multi-gone.json" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); paths=[f['path'] for f in p['files']]
assert len(paths)==1 and paths[0].endswith('/demo.md'), paths
PY

echo "  ✓ multi-file project keys: list order, trigger lift, string form, missing entry"

echo 'ai-memory-route-test: PASS'
