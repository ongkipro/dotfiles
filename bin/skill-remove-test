#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/skill-remove-test.XXXXXX")"
trap 'chmod -R u+w "$TMP" 2>/dev/null || true; rm -rf "$TMP"' EXIT

mkdir -p "$TMP/repo/skills/agents-bin" "$TMP/repo/skills/local/demo" "$TMP/home"
cp "$ROOT/skills/agents-bin/skill-remove" "$TMP/repo/skills/agents-bin/skill-remove"
chmod +x "$TMP/repo/skills/agents-bin/skill-remove"
printf '%s\n' '# Demo' > "$TMP/repo/skills/local/demo/SKILL.md"
mkdir -p "$TMP/repo/outside"
printf '%s\n' 'keep' > "$TMP/repo/outside/marker"

if HOME="$TMP/home" "$TMP/repo/skills/agents-bin/skill-remove" ../outside >/dev/null 2>&1; then
  echo "skill-remove-test: traversal was accepted" >&2
  exit 1
fi
[ "$(cat "$TMP/repo/outside/marker")" = "keep" ]

printf 'y\n' | HOME="$TMP/home" "$TMP/repo/skills/agents-bin/skill-remove" demo >/dev/null
[ ! -e "$TMP/repo/skills/local/demo" ]
restored="$(find "$TMP/home/.local/share/dotfiles-trash/skills" -mindepth 1 -maxdepth 1 -type d -name 'demo.*' -print -quit)"
[ -n "$restored" ] && [ -f "$restored/SKILL.md" ]

echo "skill-remove-test: OK"
