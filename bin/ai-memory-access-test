#!/usr/bin/env bash
set -euo pipefail
ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd)}"; TMP="$(mktemp -d "${TMPDIR:-/tmp}/ai-memory-access-test.XXXXXX")"; trap 'rm -rf "$TMP"' EXIT
DOT="$TMP/dot"; TEL="$TMP/tel"; mkdir -p "$DOT/bin" "$DOT/config/ai/memory"; echo x > "$DOT/config/ai/memory/preferences.md"
cat > "$DOT/bin/ai-memory-route" <<EOF
#!/usr/bin/env python3
import json
print(json.dumps({'needed':True,'project':None,'files':[{'path':'$DOT/config/ai/memory/preferences.md','scope':'shared','bytes':2}],'budget':{'maxFiles':3,'maxBytes':12000,'usedBytes':2},'reason':['test']}))
EOF
chmod +x "$DOT/bin/ai-memory-route"
python3 "$ROOT/bin/ai-memory-access" --help >"$TMP/help.txt"
python3 - "$TMP/help.txt" "$TMP/help-normalized.txt" <<'PY'
from pathlib import Path
import sys
Path(sys.argv[2]).write_text(' '.join(Path(sys.argv[1]).read_text().split()), encoding='utf-8')
PY
grep -qF 'selected durable-memory path, scope, and byte count' "$TMP/help-normalized.txt"
grep -qF 'never stores query text, query hashes, or memory content' "$TMP/help-normalized.txt"
python3 "$ROOT/bin/ai-memory-access" 'my preferred tone' --dotfiles "$DOT" --telemetry-dir "$TEL" --json >/dev/null
python3 - "$TEL/meta.json" "$TEL/events.jsonl" <<'PY'
import json,sys
m=json.load(open(sys.argv[1])); e=json.loads(open(sys.argv[2]).read()); assert m['schemaVersion']==1; assert m['privacy']=='selected durable-memory paths only; query text, query hashes, and memory content are not stored'; assert e['selected'][0]['path']=='config/ai/memory/preferences.md'; assert 'queryHash' not in e; assert 'query' not in e
PY

# Human-readable routing is context advice, never an access-control decision.
python3 "$ROOT/bin/ai-memory-access" 'my preferred tone' --dotfiles "$DOT" --telemetry-dir "$TEL" >"$TMP/selected.txt"
python3 - "$TMP/selected.txt" <<'PY'
from pathlib import Path
import sys
lines = Path(sys.argv[1]).read_text().splitlines()
assert lines[0] == 'ai-memory-routing: 1 file(s) selected; 1 durable memory use(s) recorded', lines
assert lines[-1] == 'Context selection is advisory; it does not grant or deny memory access.', lines
PY

cat > "$DOT/bin/ai-memory-route" <<'PY'
#!/usr/bin/env python3
import json
print(json.dumps({'needed': False, 'project': None, 'files': [], 'budget': {'maxFiles': 3, 'maxBytes': 12000, 'usedBytes': 0}, 'reason': ['no match']}))
PY
python3 "$ROOT/bin/ai-memory-access" 'unrelated request' --dotfiles "$DOT" --telemetry-dir "$TEL" >"$TMP/empty.txt"
python3 "$ROOT/bin/ai-memory-access" 'unrelated request' --dotfiles "$DOT" --telemetry-dir "$TEL" --json >"$TMP/empty.json"
python3 - "$TMP/empty.txt" "$TMP/empty.json" <<'PY'
from pathlib import Path
import json, sys
lines = Path(sys.argv[1]).read_text().splitlines()
assert lines == [
    'ai-memory-routing: no files selected for this request.',
    'Context selection is advisory; it does not grant or deny memory access.',
], lines
result = json.loads(Path(sys.argv[2]).read_text())
assert result['needed'] is False and result['files'] == [], result
assert result['budget']['usedBytes'] == 0, result
PY
echo 'ai-memory-access-test: PASS'

python3 - "$ROOT/bin/ai-memory-access" "$DOT" "$TMP" <<'PY'
from pathlib import Path
import os,stat,subprocess,sys
script,dot=map(Path,sys.argv[1:3]);root=Path(sys.argv[3]).resolve()
victim=root/'victim';victim.write_text('foreign data');victim.chmod(0o640)
def run(path):return subprocess.run([sys.executable,str(script),'query','--dotfiles',str(dot),'--telemetry-dir',str(path)],capture_output=True)
for kind in ['events-symlink','events-hardlink','meta-symlink','parent-symlink','unsafe-parent','unsafe-directory']:
 folder=root/kind;folder.mkdir(mode=0o700)
 target=folder/'usage'
 if kind=='parent-symlink':
  actual=root/'actual';actual.mkdir(mode=0o700);target.symlink_to(actual,target_is_directory=True)
 elif kind=='unsafe-parent':
  folder.chmod(0o777)
 elif kind=='unsafe-directory':
  target.mkdir(mode=0o755)
 else:
  target.mkdir(mode=0o700);file=target/('meta.json' if kind=='meta-symlink' else 'events.jsonl')
  if kind=='events-hardlink':os.link(victim,file)
  else:file.symlink_to(victim)
 assert run(target).returncode!=0,kind
 assert victim.read_text()=='foreign data',kind
 assert stat.S_IMODE(victim.stat().st_mode)==0o640,kind
 if kind=='unsafe-parent':folder.chmod(0o700)
# Independent writers append complete JSON lines through the validated file.
target=root/'concurrent'; jobs=[subprocess.Popen([sys.executable,str(script),'query','--dotfiles',str(dot),'--telemetry-dir',str(target)],stdout=subprocess.DEVNULL) for _ in range(4)]
assert all(j.wait()==0 for j in jobs)
import json
assert len([json.loads(line) for line in (target/'events.jsonl').read_text().splitlines()])==4
assert stat.S_IMODE((target/'events.jsonl').stat().st_mode)==0o600
# A parent replaced after validation cannot redirect descriptor-relative writes.
import runpy
module=runpy.run_path(str(script));target=root/'descriptor';target.mkdir(mode=0o700)
fd=module['telemetry_directory'](target)
kept=root/'kept';target.rename(kept);target.symlink_to(root/'actual',target_is_directory=True)
try:module['telemetry_file'](fd,'events.jsonl',{'safe':True},append=True)
finally:os.close(fd)
assert (kept/'events.jsonl').is_file() and not (root/'actual/events.jsonl').exists()
print('ai-memory-access-test: link/parent guards, descriptor stability, and concurrent append PASS')
PY
