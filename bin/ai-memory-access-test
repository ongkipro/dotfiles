#!/usr/bin/env bash
set -euo pipefail
ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd)}"; TMP="$(mktemp -d "${TMPDIR:-/tmp}/ai-memory-access-test.XXXXXX")"; trap 'rm -rf "$TMP"' EXIT
DOT="$TMP/dot"; TEL="$TMP/tel"; mkdir -p "$DOT/bin" "$DOT/config/ai/memory"; echo x > "$DOT/config/ai/memory/preferences.md"
cat > "$DOT/bin/ai-memory-route" <<EOF
#!/usr/bin/env python3
import json
print(json.dumps({'needed':True,'project':None,'files':[{'path':'$DOT/config/ai/memory/preferences.md','scope':'shared','bytes':2}],'budget':{'maxFiles':3,'maxBytes':12000,'usedBytes':2},'reason':['test']}))
EOF
chmod +x "$DOT/bin/ai-memory-route"
python3 "$ROOT/bin/ai-memory-access" 'my preferred tone' --dotfiles "$DOT" --telemetry-dir "$TEL" --json >/dev/null
python3 - "$TEL/meta.json" "$TEL/events.jsonl" <<'PY'
import json,sys
m=json.load(open(sys.argv[1])); e=json.loads(open(sys.argv[2]).read()); assert m['schemaVersion']==1; assert e['selected'][0]['path']=='config/ai/memory/preferences.md'; assert len(e['queryHash'])==64; assert 'query' not in e
PY
echo 'ai-memory-access-test: PASS'
