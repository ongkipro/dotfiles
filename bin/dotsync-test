#!/usr/bin/env bash
# dotsync-test — pin what the sync tool promises before anyone changes it.
#
# dotsync runs `git add -A`, `git commit` and `git push`. It had no test, which
# put the repository's most destructive command in the same position as
# ai-memory-link: verified by reading. Every case here runs a COPY inside a
# scratch repository; the real dotfiles repo is never reachable from this file.
#
# Two of its properties are load-bearing and easy to break by accident:
#   - it operates on the repository the SCRIPT lives in, never the caller's cwd,
#     which is what keeps `git add -A` away from the $HOME/.git that exists on
#     this machine by accident;
#   - without a TTY and without --yes it refuses to mutate anything.
set -uo pipefail
ROOT="${DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
# macOS temp lives under /var -> /private/var; realpath output must compare equal.
TMP="$(cd "$TMP" && pwd -P)"
# Fixture git must not read the caller's config (signing, hooksPath, templates);
# it gets a throwaway global holding only an identity.
printf '[user]\n\tname = fixture\n\temail = fixture@example.invalid\n' > "$TMP/gitconfig"
export GIT_CONFIG_GLOBAL="$TMP/gitconfig" GIT_CONFIG_NOSYSTEM=1
fails=0
say()   { printf '  %-4s %s\n' "$1" "$2"; }
check() { if [ "$2" = "$3" ]; then say ok "$1"; else
  say FAIL "$1"; printf '       expected %q, got %q\n' "$3" "$2"; fails=$((fails + 1)); fi; }
has()   { if printf '%s' "$OUT" | grep -qF "$2"; then say ok "$1"; else
  say FAIL "$1"; printf '       wanted: %s\n' "$2"; fails=$((fails + 1)); fi; }

# A scratch dotfiles root holding a copy of dotsync and a stub security-check.
# dotsync snapshots real dotfiles out of $HOME into the repository, so every
# case runs with HOME pointed at a scratch directory. The first version of this
# file did not, and the linker copied this machine's actual .gitconfig and
# .bashrc into the fixture — a "clean tree" that was never clean.
export HOME="$TMP/home"; mkdir -p "$HOME"

fake_root() {
  local d="$1"; mkdir -p "$d/bin"
  cp "$ROOT/bin/dotsync" "$d/bin/dotsync"; chmod +x "$d/bin/dotsync"
  printf '#!/usr/bin/env bash\necho "security-check: stub ran"\n' > "$d/bin/security-check"
  chmod +x "$d/bin/security-check"
  git -C "$d" init -q
  git -C "$d" config user.email t@t; git -C "$d" config user.name t
  printf 'tracked\n' > "$d/file.txt"
  git -C "$d" add -A >/dev/null 2>&1
  git -C "$d" commit -qm init >/dev/null 2>&1
}
commits() { git -C "$1" rev-list --count HEAD; }

D="$TMP/dot"; fake_root "$D"

# 1. It acts on its own repository, not the caller's working directory. Run it
#    from a DIFFERENT repository and it must still report its own.
OTHER="$TMP/other"; mkdir -p "$OTHER" && git -C "$OTHER" init -q
OUT="$(cd "$OTHER" && "$D/bin/dotsync" status 2>&1)"
has "status names its own repository, not the caller's cwd" "$D"

# 2. Nothing to commit is not an error and creates no commit.
before="$(commits "$D")"
OUT="$(cd "$OTHER" && "$D/bin/dotsync" --yes commit 2>&1)"
has "a clean tree reports nothing to commit" "Tidak ada perubahan"
check "and creates no commit" "$(commits "$D")" "$before"

# 3. Without a TTY and without --yes, a mutating verb must refuse.
printf 'new\n' > "$D/added.txt"
before="$(commits "$D")"
OUT="$(cd "$OTHER" && "$D/bin/dotsync" commit 2>&1 </dev/null)"; rc=$?
check "a non-interactive commit without --yes refuses" "$rc" "1"
has "and says so" "Batal commit"
check "and creates no commit" "$(commits "$D")" "$before"

# 4. The scanner is REQUIRED, not merely invoked. Its stdout goes to /dev/null,
#    so the observable guarantee is that its absence blocks the commit.
before="$(commits "$D")"
mv "$D/bin/security-check" "$TMP/scanner.away"
OUT="$(cd "$OTHER" && "$D/bin/dotsync" --yes commit 2>&1)"
has "a missing security-check refuses the commit" "menolak commit tanpa pemindaian"
check "and no commit is created" "$(commits "$D")" "$before"
mv "$TMP/scanner.away" "$D/bin/security-check"

# A scanner that reports a finding must also block.
printf '#!/usr/bin/env bash\necho "possible secret"; exit 1\n' > "$D/bin/security-check"
chmod +x "$D/bin/security-check"
OUT="$(cd "$OTHER" && "$D/bin/dotsync" --yes commit 2>&1)"
has "a failing security-check aborts the commit" "commit dibatalkan"
check "and still no commit is created" "$(commits "$D")" "$before"
printf '#!/usr/bin/env bash\nexit 0\n' > "$D/bin/security-check"; chmod +x "$D/bin/security-check"

OUT="$(cd "$OTHER" && "$D/bin/dotsync" --yes commit 2>&1)"
check "--yes commits once the scanner passes" "$(commits "$D")" "$((before + 1))"

# 5. `git add -A` sweeps EVERYTHING, including work the operator did not touch.
#    That is the tool's design — a dotfiles sync — and the confirmation prompt is
#    what covers it. Pinned here so the hazard is visible in a test rather than
#    discovered on a shared machine, and so --yes never quietly grows a filter
#    (or loses one) without this failing.
printf 'someone else was editing this\n' > "$D/unrelated.txt"
(cd "$OTHER" && "$D/bin/dotsync" --yes commit >/dev/null 2>&1)
check "--yes sweeps unrelated work into the commit" \
  "$(git -C "$D" show --stat --name-only HEAD | grep -c '^unrelated.txt$')" "1"

# 6. push refuses the same way.
OUT="$(cd "$OTHER" && "$D/bin/dotsync" push 2>&1 </dev/null)"; rc=$?
check "a non-interactive push without --yes refuses" "$rc" "1"
has "and says so" "Batal push"

# 7. A bare invocation stays read-only.
before="$(commits "$D")"
printf 'more\n' > "$D/another.txt"
OUT="$(cd "$OTHER" && "$D/bin/dotsync" 2>&1 </dev/null)"
check "a bare invocation commits nothing" "$(commits "$D")" "$before"

# 8. Without a TTY, an answer piped on stdin is still not consent: only --yes is.
before="$(commits "$D")"
OUT="$(cd "$OTHER" && printf 'y\n' | "$D/bin/dotsync" commit 2>&1)"; rc=$?
check "a piped 'y' without a TTY does not confirm a commit" "$(commits "$D")" "$before"
check "and the refusal is a failure" "$rc" "1"

# 9. An unknown verb is an error, not a silent no-op.
(cd "$OTHER" && "$D/bin/dotsync" frobnicate >/dev/null 2>&1); rc=$?
check "an unknown command exits non-zero" "$([ "$rc" -ne 0 ] && echo refused)" "refused"

# 10. Outside a git repository nothing is touched: the snapshot copy that commit
#     performs must not run before the repository check refuses.
N="$TMP/norepo"; mkdir -p "$N/bin" "$TMP/h2"
cp "$ROOT/bin/dotsync" "$N/bin/dotsync"; chmod +x "$N/bin/dotsync"
printf '[user]\n\tname = snapshot-me\n' > "$TMP/h2/.gitconfig"
(cd "$OTHER" && GIT_CEILING_DIRECTORIES="$TMP" HOME="$TMP/h2" "$N/bin/dotsync" --yes commit >/dev/null 2>&1); rc=$?
check "commit outside a git repository exits non-zero" "$([ "$rc" -ne 0 ] && echo refused)" "refused"
check "and copies no snapshot into the non-repository" "$([ -e "$N/home/gitconfig" ] && echo copied || echo untouched)" "untouched"

# 11. Invoked through a symlink (how install.sh exposes it in ~/.local/bin), it
#     still resolves its own repository — with realpath, and with readlink -f
#     alone when realpath is missing.
mkdir -p "$TMP/link/bin" "$TMP/noreadlink" "$TMP/minpath"
ln -s "$D/bin/dotsync" "$TMP/link/bin/dotsync"
printf '#!/bin/sh\nexit 1\n' > "$TMP/noreadlink/readlink"; chmod +x "$TMP/noreadlink/readlink"
OUT="$(cd "$OTHER" && PATH="$TMP/noreadlink:$PATH" "$TMP/link/bin/dotsync" status 2>&1)"
has "via a symlink, realpath resolves the real repository" "dotfiles: $D"
for t in bash git dirname readlink uname; do
  p="$(command -v "$t")" && ln -s "$p" "$TMP/minpath/$t"
done
OUT="$(cd "$OTHER" && PATH="$TMP/minpath" "$TMP/link/bin/dotsync" status 2>&1)"
has "via a symlink without realpath, readlink -f resolves it" "dotfiles: $D"

# 12. doctor tells a present shared-memory target from a missing one.
mkdir -p "$HOME/.config/ai"
OUT="$(cd "$OTHER" && "$D/bin/dotsync" doctor 2>&1)"
has "doctor reports a present target as OK" "OK  $HOME/.config/ai"
has "doctor reports an absent target as MISS" "MISS $HOME/.claude/CLAUDE.md"

# 13. pull and sync against a local bare remote — no network. P starts one
#     commit behind origin.
P="$TMP/p"; fake_root "$P"; R="$TMP/remote.git"; W="$TMP/w"
git -C "$P" branch -M main
git init -q --bare "$R"
git -C "$P" remote add origin "$R"
git -C "$P" push -q -u origin main >/dev/null 2>&1
git clone -q "$R" "$W" >/dev/null 2>&1
git -C "$W" config user.email t@t; git -C "$W" config user.name t
printf 'upstream\n' > "$W/upstream.txt"; git -C "$W" add upstream.txt
git -C "$W" commit -qm upstream; git -C "$W" push -q origin HEAD:main >/dev/null 2>&1
head_p() { git -C "$P" rev-parse HEAD; }

h="$(head_p)"
(cd "$OTHER" && "$P/bin/dotsync" pull >/dev/null 2>&1 </dev/null); rc=$?
check "a non-interactive pull without --yes does not pull" "$(head_p)" "$h"
check "and the refusal is a failure" "$rc" "1"

printf 'local edit\n' >> "$P/file.txt"
(cd "$OTHER" && "$P/bin/dotsync" --yes pull >/dev/null 2>&1); rc=$?
check "pull refuses a dirty working tree" "$(head_p)" "$h"
check "and the refusal is a failure" "$rc" "1"
git -C "$P" checkout -q -- file.txt

printf '#!/usr/bin/env bash\necho "ok: unchanged link"\necho "backup: kept old file"\n' > "$P/bin/ai-memory-link"
chmod +x "$P/bin/ai-memory-link"
OUT="$(cd "$OTHER" && "$P/bin/dotsync" --yes pull 2>&1)"; rc=$?
check "a clean --yes pull fast-forwards to origin" "$(head_p)" "$(git -C "$R" rev-parse main)"
check "and succeeds" "$rc" "0"
has "after a pull, ai-memory-link runs and its warnings stay visible" "backup: kept old file"
check "while its no-op ok: lines are hidden" \
  "$(printf '%s' "$OUT" | grep -c '^ok: unchanged link')" "0"
printf '#!/usr/bin/env bash\necho "cannot link"; exit 3\n' > "$P/bin/ai-memory-link"
printf 'upstream 2\n' > "$W/upstream.txt"; git -C "$W" commit -qam upstream2
git -C "$W" push -q origin HEAD:main >/dev/null 2>&1
(cd "$OTHER" && "$P/bin/dotsync" --yes pull >/dev/null 2>&1); rc=$?
check "a failing relink after pull fails the pull" "$([ "$rc" -ne 0 ] && echo failed)" "failed"
rm -f "$P/bin/ai-memory-link"

printf 'to sync\n' > "$P/sync.txt"
(cd "$OTHER" && "$P/bin/dotsync" --yes sync "fixture sync message" >/dev/null 2>&1)
check "sync uses the given message for the commit" "$(git -C "$P" log -1 --format=%s)" "fixture sync message"
check "--yes sync pushes the commit to origin" "$(git -C "$R" rev-parse main)" "$(head_p)"

# 14. autopull: background-safe, fast-forward only, never commits or pushes.
export XDG_STATE_HOME="$TMP/state"
ap() { (cd "$OTHER" && DOTSYNC_AUTOPULL_INTERVAL="${1:-0}" "$P/bin/dotsync" autopull >/dev/null 2>&1 </dev/null); }
last() { cat "$XDG_STATE_HOME/dotsync/last-result" 2>/dev/null; }
upstream() { { git -C "$W" fetch -q origin && git -C "$W" reset -q --hard origin/main; } || echo "fixture: W sync failed" >&2
  printf '%s\n' "$1" > "$W/upstream.txt"; git -C "$W" add upstream.txt; git -C "$W" commit -qm "$1"
  git -C "$W" push -q origin HEAD:main >/dev/null 2>&1 || echo "fixture: W push failed" >&2; }
ap; rc=$?
check "autopull when up to date succeeds" "$rc" "0"
has_last() { if last | grep -qF "$2"; then say ok "$1"; else say FAIL "$1"; printf '       last: %s\n' "$(last)"; fails=$((fails + 1)); fi; }
has_last "and records up to date" "ok: up to date"
upstream "auto 1"
ap; rc=$?
check "autopull fast-forwards to origin" "$(head_p)" "$(git -C "$R" rev-parse main)"
check "without creating a merge commit" "$(git -C "$P" rev-list --parents -n1 HEAD | wc -w | tr -d ' ')" "2"
has_last "and records the pulled range" "ok: pulled"
upstream "auto 2"; h="$(head_p)"; l="$(last)"
ap 3600
check "autopull is throttled within its interval" "$(head_p)" "$h"
check "and a throttled run records nothing" "$(last)" "$l"
mkdir "$XDG_STATE_HOME/dotsync/lock"
ap
check "autopull skips while another run holds the lock" "$(head_p)" "$h"
rmdir "$XDG_STATE_HOME/dotsync/lock"
mkdir "$XDG_STATE_HOME/dotsync/lock"; touch -t 200001010000 "$XDG_STATE_HOME/dotsync/lock"
upstream "auto stale lock"; ap
check "a lock left by a crashed run (>10 min) is reclaimed" "$(head_p)" "$(git -C "$R" rev-parse main)"
h="$(head_p)"
# ssh: our batch-mode command applies only when the device chose none.
SSH_BIN="$TMP/ssh-bin"; mkdir -p "$SSH_BIN"
printf '#!/bin/sh\necho "$*" > "%s/ssh-args"; exit 1\n' "$TMP" > "$SSH_BIN/ssh"; chmod +x "$SSH_BIN/ssh"
printf '#!/bin/sh\necho own > "%s/own-ssh"; exit 1\n' "$TMP" > "$SSH_BIN/own-ssh"; chmod +x "$SSH_BIN/own-ssh"
git -C "$P" remote set-url origin "ssh://git@example.invalid/x.git"
(cd "$OTHER" && PATH="$SSH_BIN:$PATH" DOTSYNC_AUTOPULL_INTERVAL=0 "$P/bin/dotsync" autopull >/dev/null 2>&1 </dev/null)
has_ssh() { if grep -qF "$2" "$3" 2>/dev/null; then say ok "$1"; else say FAIL "$1"; fails=$((fails + 1)); fi; }
has_ssh "autopull runs ssh in batch mode with keepalives" "BatchMode=yes" "$TMP/ssh-args"
git -C "$P" config core.sshCommand "$SSH_BIN/own-ssh"
(cd "$OTHER" && PATH="$SSH_BIN:$PATH" DOTSYNC_AUTOPULL_INTERVAL=0 "$P/bin/dotsync" autopull >/dev/null 2>&1 </dev/null)
has_ssh "a device's own core.sshCommand is respected" "own" "$TMP/own-ssh"
git -C "$P" config --unset core.sshCommand; git -C "$P" remote set-url origin "$R"; rm -f "$XDG_STATE_HOME/dotsync/fail-count"
printf '#!/usr/bin/env bash\necho ran > "%s/relinked"\n' "$TMP" > "$P/bin/ai-memory-link"; chmod +x "$P/bin/ai-memory-link"
upstream "auto relink"; ap
check "after a fast-forward, autopull relinks the runtimes" "$(cat "$TMP/relinked" 2>/dev/null)" "ran"
rm -f "$P/bin/ai-memory-link"
check "the lock is released after a run" "$([ -d "$XDG_STATE_HOME/dotsync/lock" ] && echo held || echo free)" "free"
upstream "auto blocked"; h="$(head_p)"
printf 'local untracked\n' > "$P/upstream.txt.tmp"; mv "$P/upstream.txt.tmp" "$P/blocker.txt"
git -C "$W" rm -q upstream.txt >/dev/null 2>&1; printf 'x\n' > "$W/blocker.txt"; git -C "$W" add blocker.txt
git -C "$W" commit -qm blocker; git -C "$W" push -q origin HEAD:main >/dev/null 2>&1
ap; rc=$?
check "an untracked file in the way stops the fast-forward" "$(head_p)" "$h"
check "and keeps the local untracked file" "$(cat "$P/blocker.txt")" "local untracked"
has_last "and records that it cannot fast-forward" "cannot fast-forward"
rm -f "$P/blocker.txt"; ap
check "once the file is gone, autopull catches up" "$(head_p)" "$(git -C "$R" rev-parse main)"
h="$(head_p)"
printf 'dirty\n' >> "$P/file.txt"
ap
check "autopull leaves a dirty tree alone" "$(head_p)" "$h"
has_last "and records why it skipped" "skip: local changes"
git -C "$P" checkout -q -- file.txt
git -C "$P" checkout -q -b side
ap
check "autopull does nothing off main" "$(head_p)" "$h"
has_last "and says which branch" "skip: on branch side"
git -C "$P" checkout -q main
printf 'local only\n' > "$P/local.txt"; git -C "$P" add local.txt; git -C "$P" commit -qm local
upstream "auto 3"
h="$(head_p)"; o="$(git -C "$R" rev-parse main)"
ap; rc=$?
check "autopull refuses a diverged history" "$(head_p)" "$h"
check "and reports failure" "$rc" "1"
check "and never pushes" "$(git -C "$R" rev-parse main)" "$o"
has_last "and records the divergence" "cannot fast-forward"
git -C "$P" reset -q --hard origin/main
git -C "$P" remote set-url origin "$TMP/missing.git"
ap; rc=$?
check "a failed fetch is reported as failure" "$rc" "1"
has_last "and recorded as fail" "fail: fetch"
ap; ap
check "consecutive fetch failures are counted" "$(cat "$XDG_STATE_HOME/dotsync/fail-count")" "3"
printf 'garbage\n' > "$XDG_STATE_HOME/dotsync/fail-count"; ap
check "a garbage failure count restarts at one" "$(cat "$XDG_STATE_HOME/dotsync/fail-count")" "1"
git -C "$P" remote set-url origin "$R"; ap
check "a success clears the failure count" "$([ -f "$XDG_STATE_HOME/dotsync/fail-count" ] && echo kept || echo cleared)" "cleared"

echo
[ "$fails" -eq 0 ] && { echo "dotsync-test: all cases hold"; exit 0; }
echo "dotsync-test: $fails case(s) failed"; exit 1
