#!/usr/bin/env bash
# dotsync-test — pin what the sync tool promises before anyone changes it.
#
# dotsync runs `git add -A`, `git commit` and `git push`. It had no test, which
# put the repository's most destructive command in the same position as
# ai-memory-link: verified by reading. Every case here runs a COPY inside a
# scratch repository; the real dotfiles repo is never reachable from this file.
#
# Two of its properties are load-bearing and easy to break by accident:
#   - it operates on the repository the SCRIPT lives in, never the caller's cwd,
#     which is what keeps `git add -A` away from the $HOME/.git that exists on
#     this machine by accident;
#   - without a TTY and without --yes it refuses to mutate anything.
set -uo pipefail
ROOT="${DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
fails=0
say()   { printf '  %-4s %s\n' "$1" "$2"; }
check() { if [ "$2" = "$3" ]; then say ok "$1"; else
  say FAIL "$1"; printf '       expected %q, got %q\n' "$3" "$2"; fails=$((fails + 1)); fi; }
has()   { if printf '%s' "$OUT" | grep -qF "$2"; then say ok "$1"; else
  say FAIL "$1"; printf '       wanted: %s\n' "$2"; fails=$((fails + 1)); fi; }

# A scratch dotfiles root holding a copy of dotsync and a stub security-check.
# dotsync snapshots real dotfiles out of $HOME into the repository, so every
# case runs with HOME pointed at a scratch directory. The first version of this
# file did not, and the linker copied this machine's actual .gitconfig and
# .bashrc into the fixture — a "clean tree" that was never clean.
export HOME="$TMP/home"; mkdir -p "$HOME"

fake_root() {
  local d="$1"; mkdir -p "$d/bin"
  cp "$ROOT/bin/dotsync" "$d/bin/dotsync"; chmod +x "$d/bin/dotsync"
  printf '#!/usr/bin/env bash\necho "security-check: stub ran"\n' > "$d/bin/security-check"
  chmod +x "$d/bin/security-check"
  git -C "$d" init -q
  git -C "$d" config user.email t@t; git -C "$d" config user.name t
  printf 'tracked\n' > "$d/file.txt"
  git -C "$d" add -A >/dev/null 2>&1
  git -C "$d" commit -qm init >/dev/null 2>&1
}
commits() { git -C "$1" rev-list --count HEAD; }

D="$TMP/dot"; fake_root "$D"

# 1. It acts on its own repository, not the caller's working directory. Run it
#    from a DIFFERENT repository and it must still report its own.
OTHER="$TMP/other"; mkdir -p "$OTHER" && git -C "$OTHER" init -q
OUT="$(cd "$OTHER" && "$D/bin/dotsync" status 2>&1)"
has "status names its own repository, not the caller's cwd" "$D"

# 2. Nothing to commit is not an error and creates no commit.
before="$(commits "$D")"
OUT="$(cd "$OTHER" && "$D/bin/dotsync" --yes commit 2>&1)"
has "a clean tree reports nothing to commit" "Tidak ada perubahan"
check "and creates no commit" "$(commits "$D")" "$before"

# 3. Without a TTY and without --yes, a mutating verb must refuse.
printf 'new\n' > "$D/added.txt"
before="$(commits "$D")"
OUT="$(cd "$OTHER" && "$D/bin/dotsync" commit 2>&1 </dev/null)"; rc=$?
check "a non-interactive commit without --yes refuses" "$rc" "1"
has "and says so" "Batal commit"
check "and creates no commit" "$(commits "$D")" "$before"

# 4. The scanner is REQUIRED, not merely invoked. Its stdout goes to /dev/null,
#    so the observable guarantee is that its absence blocks the commit.
before="$(commits "$D")"
mv "$D/bin/security-check" "$TMP/scanner.away"
OUT="$(cd "$OTHER" && "$D/bin/dotsync" --yes commit 2>&1)"
has "a missing security-check refuses the commit" "menolak commit tanpa pemindaian"
check "and no commit is created" "$(commits "$D")" "$before"
mv "$TMP/scanner.away" "$D/bin/security-check"

# A scanner that reports a finding must also block.
printf '#!/usr/bin/env bash\necho "possible secret"; exit 1\n' > "$D/bin/security-check"
chmod +x "$D/bin/security-check"
OUT="$(cd "$OTHER" && "$D/bin/dotsync" --yes commit 2>&1)"
has "a failing security-check aborts the commit" "commit dibatalkan"
check "and still no commit is created" "$(commits "$D")" "$before"
printf '#!/usr/bin/env bash\nexit 0\n' > "$D/bin/security-check"; chmod +x "$D/bin/security-check"

OUT="$(cd "$OTHER" && "$D/bin/dotsync" --yes commit 2>&1)"
check "--yes commits once the scanner passes" "$(commits "$D")" "$((before + 1))"

# 5. `git add -A` sweeps EVERYTHING, including work the operator did not touch.
#    That is the tool's design — a dotfiles sync — and the confirmation prompt is
#    what covers it. Pinned here so the hazard is visible in a test rather than
#    discovered on a shared machine, and so --yes never quietly grows a filter
#    (or loses one) without this failing.
printf 'someone else was editing this\n' > "$D/unrelated.txt"
(cd "$OTHER" && "$D/bin/dotsync" --yes commit >/dev/null 2>&1)
check "--yes sweeps unrelated work into the commit" \
  "$(git -C "$D" show --stat --name-only HEAD | grep -c '^unrelated.txt$')" "1"

# 6. push refuses the same way.
OUT="$(cd "$OTHER" && "$D/bin/dotsync" push 2>&1 </dev/null)"; rc=$?
check "a non-interactive push without --yes refuses" "$rc" "1"
has "and says so" "Batal push"

# 7. A bare invocation stays read-only.
before="$(commits "$D")"
printf 'more\n' > "$D/another.txt"
OUT="$(cd "$OTHER" && "$D/bin/dotsync" 2>&1 </dev/null)"
check "a bare invocation commits nothing" "$(commits "$D")" "$before"

echo
[ "$fails" -eq 0 ] && { echo "dotsync-test: all cases hold"; exit 0; }
echo "dotsync-test: $fails case(s) failed"; exit 1
