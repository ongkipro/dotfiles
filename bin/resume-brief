#!/usr/bin/env python3
"""resume-brief — answer "where am I?" from repository state alone.

A session that resumes from chat history resumes from the one source that does
not survive a crash, a new machine, or a different agent. Everything needed is
already on disk: the ledger knows which run is open, which checks passed and
whether they were executed or merely asserted, and which tasks have never
finished. This prints that, and nothing it cannot read.

It asks the evidence, never the agent. Read-only.

Usage: resume-brief [REPO]
"""
import json
import pathlib
import re
import subprocess
import sys


# One parser, imported by ai-policy-lint, because two readers of the same
# human-written line under two different rules is the split-truth failure this
# whole design exists to prevent — and it is exactly what shipped first: the
# live-record rule accepted 2-4 hashes or a contract bullet, while the
# dependency rule split on the substring "### TASK-nnn:" anywhere in the file.
# A `##` task, a bullet-only task, and a prose line quoting a heading each
# produced a different wrong answer.
TASK_ID = r"[A-Z]+-[0-9]+"
_HEADING = re.compile(r"^#{2,4}\s+(" + TASK_ID + r")(?![0-9])")
_BULLET = re.compile(r"^\s*-\s+\*\*(" + TASK_ID + r")(?![0-9])")
_ANY_HEADING = re.compile(r"^#{1,6}\s")
_DEPENDS = re.compile(r"^\s*-\s+\*\*Depends On:\*\*\s*(.+)", re.I)


def parse_task_graph(text, anomalies=None):
    """Map every task RECORD in a TASKS.md-shaped document to its dependencies.

    A record is a heading or a contract bullet, anchored to the start of a line.
    Prose naming a task is not a record: one sentence reading "Completed task
    contracts through TASK-023 are archived in:" was enough to resurrect an
    archived task as a live candidate.

    Pass `anomalies` (a list) to collect edges that were WRITTEN but not read.
    A dependency is the one human-authored fact here, so an edge that silently
    evaporates — mis-indented, oddly spaced, before any record, or overwritten
    by a second line — is worse than a wrong one: nothing anywhere says it was
    ignored.
    """
    graph, current, fenced = {}, None, False
    for line in text.splitlines():
        # A fenced example is documentation, not a record. The archive already
        # contains "### TASK-000: [Short Task Title]" inside a fence, which put
        # TASK-000 into the lint's set of real tasks.
        if line.lstrip().startswith("```"):
            fenced = not fenced
            continue
        if fenced:
            continue
        h = _HEADING.match(line)
        b = _BULLET.match(line)
        if h or b:
            current = (h or b).group(1)
            graph.setdefault(current, [])
            continue
        # Any other heading ends the current task's scope. Without this, a
        # "## Historical closure" section carrying a stray Depends On line had
        # it attributed to the last task above — a live task falsely blocked by
        # archived prose, which is the stale signal this command removes.
        if _ANY_HEADING.match(line):
            current = None
            continue
        d = _DEPENDS.match(line)
        if d and current:
            if graph[current] and anomalies is not None:
                anomalies.append(f"{current} has more than one Depends On line; "
                                 f"only the last is read")
            graph[current] = re.findall(TASK_ID, d.group(1))
            continue
        if anomalies is not None and "Depends On" in line and not d:
            anomalies.append(f"line not read as a dependency: {line.strip()[:70]}")
        elif anomalies is not None and d and current is None:
            anomalies.append(f"dependency line before any task record: "
                             f"{line.strip()[:70]}")
    return graph


def git(repo, *args):
    r = subprocess.run(["git", "-C", str(repo), *args], text=True,
                       stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    return r.stdout.strip() if r.returncode == 0 else ""


def events(path):
    out = []
    try:
        for line in path.read_text().splitlines():
            if line.strip():
                out.append(json.loads(line))
    except (OSError, json.JSONDecodeError):
        return []
    return out


def main():
    repo = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else ".").resolve()
    top = git(repo, "rev-parse", "--show-toplevel")
    if not top:
        print(f"resume-brief: {repo} is not a git repository", file=sys.stderr)
        return 2
    repo = pathlib.Path(top).resolve()
    delivery = repo / ".delivery"

    print(f"RESUME BRIEF — {repo.name}")
    print(f"HEAD: {git(repo, 'log', '--oneline', '-1') or '(no commits)'}")
    # Porcelain v1 is "XY<space>PATH", but a staged rename and an unmerged entry
    # both shift what follows; lstrip after the two status columns handles every
    # form. The ledger writes .delivery/ itself, so it is never the user's work.
    dirty = [l for l in git(repo, "status", "--porcelain").splitlines()
             if l and not l[2:].lstrip().startswith(".delivery/")]
    print(f"Worktree: {'clean' if not dirty else f'{len(dirty)} path(s) dirty'}")
    for line in dirty[:8]:
        print(f"  {line}")

    if not delivery.is_dir():
        print("\nNo delivery ledger in this repository; resume authority is Git state only.")
        return 0

    try:
        current = json.loads((delivery / "current.json").read_text())
    except (OSError, json.JSONDecodeError):
        print("\nLedger present but current.json is unreadable — the chain cannot be resumed.",
              file=sys.stderr)
        return 1

    # Latest outcome per task, taken from evidence rather than from any claim.
    outcomes, run_files = {}, sorted((delivery / "runs").glob("*.jsonl")) if (delivery / "runs").is_dir() else []
    for f in run_files:
        ev = events(f)
        if not ev:
            continue
        start = next((e for e in ev if e.get("type") == "run_started"), None)
        fin = next((e for e in reversed(ev) if e.get("type") == "run_finished"), None)
        if start and start.get("task"):
            outcomes[start["task"]] = (fin.get("result") if fin else "OPEN", f.stem)

    active = current.get("activeRun")
    if active:
        run_id = active.get("runId") if isinstance(active, dict) else active
        ev = events(delivery / "runs" / f"{run_id}.jsonl")
        start = next((e for e in ev if e.get("type") == "run_started"), {})
        print(f"\nActive run: {run_id}")
        print(f"  task {start.get('task', '?')} / {start.get('requirement', '?')} "
              f"/ risk {start.get('risk', '?')}")
        allowed = (start.get("boundary") or {}).get("allowedPaths") or []
        print(f"  declared surface: {', '.join(allowed) or '(none)'}")
        checks = [e for e in ev if e.get("type") == "verification"]
        if checks:
            print("  checks recorded:")
            for c in checks:
                how = "executed" if c.get("executed") else "asserted"
                print(f"    {c.get('status')}  {c.get('check')}  ({how})")
        else:
            print("  checks recorded: none — nothing yet justifies a PASS")
        bc = [e for e in ev if e.get("type") == "boundary_check"]
        if bc:
            last = bc[-1]
            print(f"  last boundary: {last.get('result', '?')} "
                  f"effectiveRisk={last.get('effectiveRisk', '?')}")
            for item in (last.get("failures") or [])[:4]:
                print(f"    - {item}")
        else:
            print("  last boundary: never checked")
        print("  to finish: record any missing check, run check-boundary, "
              "then finish (review first if REVIEW_REQUIRED)")
    else:
        last = current.get("lastRun") or {}
        print(f"\nNo active run. Last: {last.get('runId', '(none)')} "
              f"-> {last.get('result', '?')} at {last.get('finishedAt', '?')}")
        note = (current.get("lastCheckpoint") or {}).get("note")
        if note:
            print(f"  checkpoint: {note.split('. ')[0][:160]}")

    # A task the archive has already retired will never reach PASS, and listing
    # it as a resume candidate is worse than listing nothing: TASK-023 was
    # superseded on 2026-08-24 and still appeared here on 2026-09-01, which is
    # precisely the stale signal this command exists to remove.
    live = (repo / "TASKS.md").read_text() if (repo / "TASKS.md").is_file() else ""
    archived = ""
    arch_dir = repo / "docs" / "archive"
    if arch_dir.is_dir():
        for a in sorted(arch_dir.glob("*.md")):
            archived += a.read_text()

    def mentions(text, task):
        # Right-bounded so TASK-02 stops matching TASK-023 — a substring test
        # here deleted live work, caught by independent review rather than by
        # this file's tests.
        return re.search(re.escape(task) + r"(?![0-9])", text) is not None

    live_graph = parse_task_graph(live)
    retired = {t for t in outcomes
               if t not in live_graph and mentions(archived, t)}

    # §9 asks for a task lifecycle. The state is DERIVED, never written down:
    # a hand-maintained status field goes stale exactly the way TASK-013's
    # "blocked on billing" did, and the way the repository-visibility note did —
    # both wrong on 2026-09-01, both discovered by asking reality instead of
    # reading the file. Only the dependency edge is human-authored, because only
    # a human knows it; everything else is computed from ledger evidence.
    # A contract with no run at all was invisible here. `outcomes` is built from
    # .delivery/runs, so a task nobody has started was simply not in it, and a
    # freshly accepted queue reported "0 ready to start" while eight contracts
    # waited — the brief answering "nothing to do" for the one state it exists
    # to surface. Only a `###` contract counts: a bullet is a prose note, and
    # TASK-012 is dormant by design until five delivery records exist, so
    # listing it as ready would be noise dressed as a queue.
    accepted = {t for t in re.findall(r"(?m)^#{2,4}\s+(" + TASK_ID + r")(?![0-9])", live)}
    unfinished = sorted(
        {t for t, (res, _) in outcomes.items() if res != "PASS" and t not in retired}
        | {t for t in accepted if t not in outcomes and t not in retired}
    )
    # A dependency is met when its evidence ends in PASS. Two other shapes are
    # neither met nor a reason to deadlock, and saying which is which is the
    # difference between an actionable queue and a permanent stall: a dependency
    # the archive retired was superseded, and one with no ledger run at all has
    # no evidence rather than failing evidence. Both are reported by name.
    blocked_by, superseded_dep = {}, {}
    for t in unfinished:
        unmet = []
        for d in live_graph.get(t, []):
            state = outcomes.get(d, (None, ""))[0]
            if state == "PASS":
                continue
            if d not in live_graph and mentions(archived, d):
                superseded_dep.setdefault(t, []).append(d)
                continue
            if state is None:
                # "no ledger run" misstates the problem when nothing defines the
                # task at all, and resume-brief also runs where the lint does not.
                known_anywhere = d in live_graph or mentions(archived, d)
                unmet.append(f"{d} (no ledger run)" if known_anywhere
                             else f"{d} (no task defines it)")
            else:
                unmet.append(d)
        if unmet:
            blocked_by[t] = unmet
    if unfinished:
        print("\nTasks not finished: no run yet, or evidence not ending in PASS:")
        for t in unfinished:
            res, run = outcomes.get(t, ("no run", ""))
            title = ""
            tasks_md = repo / "TASKS.md"
            if tasks_md.is_file():
                for line in tasks_md.read_text().splitlines():
                    m = re.match(r"^#{2,4}\s+" + re.escape(t) + r"(?![0-9])\s*:?\s*(.*)", line)
                    if m:
                        title = m.group(1).strip()
                        break
            state = "waiting" if t in blocked_by else "READY"
            print(f"  {t:<10} {state:<8} {res:<10} {title[:56]}")
            if t in blocked_by:
                print(f"             needs first: {', '.join(blocked_by[t])}")
            if t in superseded_dep:
                print(f"             superseded dependency, not blocking: "
                      f"{', '.join(superseded_dep[t])}")
        ready = [t for t in unfinished if t not in blocked_by]
        print(f"\n{len(ready)} ready to start, {len(blocked_by)} waiting on a dependency.")
        print("These are the resume candidates. Repository evidence decides, not memory.")
    else:
        print("\nEvery accepted contract has evidence, and all of it ends in PASS.")

    if retired:
        print(f"\nRetired in docs/archive, not candidates: {', '.join(sorted(retired))}")

    # CI is part of resume authority and was the gap that made this worth adding:
    # on 2026-08-31 nine commits went out while two CI runs were red, because
    # nothing in the working session ever looked. Best effort only — gh may be
    # missing, unauthenticated, or offline, and none of that is a reason to fail.
    head = git(repo, "rev-parse", "HEAD")
    if head:
        r = subprocess.run(
            ["gh", "run", "list", "--limit", "8", "--json",
             "headSha,conclusion,status,displayTitle"],
            cwd=repo, text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        if r.returncode == 0:
            try:
                runs = json.loads(r.stdout)
            except json.JSONDecodeError:
                runs = []
            mine = [x for x in runs if x.get("headSha") == head]
            print("\nCI for this HEAD:", end=" ")
            if not mine:
                print("no run found (not pushed, or none triggered)")
            for x in mine:
                state = x.get("conclusion") or x.get("status") or "?"
                print(f"{state}")
                if state not in ("success", "in_progress", "queued"):
                    print("  CI is not green on the commit you are resuming from.")
        else:
            print("\nCI for this HEAD: unknown (gh unavailable or not authenticated)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
