#!/usr/bin/env bash
# Regression check for config/ai/hooks/memory-usage.sh — the UserPromptSubmit
# hook. Run it after touching the hook:
#   ./bin/memory-usage-hook-test
#
# The hook runs on EVERY user prompt and receives arbitrary user text, so the
# properties that matter are: it never blocks, it never leaks tool internals
# into the turn, it never treats prompt text as flags, and it never writes
# outside its telemetry directory. Telemetry is redirected into a sandbox here,
# so the real ~/.config/ai-local/memory-usage is untouched.
set -uo pipefail

DOT="$(cd "$(dirname "$0")/.." && pwd)"
HOOK="$DOT/config/ai/hooks/memory-usage.sh"
[ -x "$HOOK" ] || { echo "not executable: $HOOK" >&2; exit 2; }

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# Give the hook an isolated HOME whose installed-path candidate is the exact
# repository binary under test. A real ~/.local/bin from another checkout must
# never influence this fixture.
mkdir -p "$TMP/home/.local/bin"
ln -s "$DOT/bin/ai-memory-access" "$TMP/home/.local/bin/ai-memory-access"

fail() { echo "FAIL: $*" >&2; exit 1; }

# Feed a prompt and capture stdout. HOME injects the exact ai-memory-access under
# test; AI_MEMORY_USAGE_DIR keeps telemetry in the sandbox.
feed() {
  printf '%s' "$1" | \
    HOME="$TMP/home" \
    AI_MEMORY_USAGE_DIR="$TMP/telemetry" \
    "$HOOK" 2>"$TMP/err"
}
payload() { python3 -c 'import json,sys;print(json.dumps({"prompt":sys.argv[1]}))' "$1"; }

# The bound must exist on a machine WITHOUT GNU timeout — which is every stock
# macOS. The function was called `bounded` and ran unbounded there, so a stall in
# the routing path hung device-verify for 17 minutes and never ended. Simulated
# here by hiding `timeout` behind a PATH that has only the interpreters.
slow_home="$TMP/slow"; mkdir -p "$slow_home/.local/bin"
# The delay must not need `sleep`, which is absent from the fixture PATH by
# design. Two earlier attempts silently produced a child that finished instantly
# — `sleep` not found, then `read -t` returning at once on a consumed stdin — so
# the case passed no matter what the hook did.
printf '#!/usr/bin/env bash\nexec perl -e "sleep 30"\n' \
  > "$slow_home/.local/bin/ai-memory-access"
chmod +x "$slow_home/.local/bin/ai-memory-access"
# A directory holding ONLY the interpreters, so `timeout` is genuinely absent.
# The first attempt used $(dirname python3), which on Linux is /usr/bin — where
# GNU timeout also lives, so the fallback branch was never reached and a mutation
# disabling it passed.
nogtimeout="$TMP/nopath"; mkdir -p "$nogtimeout"
for c in python3 perl cat sed bash env; do
  src="$(command -v "$c" 2>/dev/null)" && ln -sf "$src" "$nogtimeout/$c"
done
command -v timeout >/dev/null && [ ! -e "$nogtimeout/timeout" ] \
  || true   # asserted below: the fixture PATH must not provide it
minimal_path="$nogtimeout"
PATH="$minimal_path" command -v timeout >/dev/null 2>&1 \
  && fail "fixture PATH still provides timeout; the fallback would not be exercised"
start=$(date +%s)
printf '%s' '{"prompt":"hello"}' | env -i \
  PATH="$minimal_path" \
  HOME="$slow_home" \
  AI_MEMORY_USAGE_DIR="$TMP/telemetry-slow" \
  "$HOOK" >/dev/null 2>&1
elapsed=$(( $(date +%s) - start ))
[ "$elapsed" -lt 20 ] \
  || fail "hook ran unbounded without GNU timeout: ${elapsed}s for a 30s child"

# --- never exits non-zero, whatever it is given ------------------------------
for p in '' 'hello' '-h' '--help' '--telemetry-dir=/tmp/should-not-exist' '{"malformed'; do
  feed "$(payload "$p" 2>/dev/null || printf '%s' "$p")" >/dev/null
  rc=$?
  [ "$rc" -eq 0 ] || fail "hook exited $rc on prompt: $p (it must always fail open)"
done
feed '' >/dev/null || fail "hook must exit 0 on an empty payload"
feed 'not json at all' >/dev/null || fail "hook must exit 0 on a non-JSON payload"

# --- a flag-shaped prompt must not leak tool internals into the turn ---------
# `-h` once matched argparse's help flag and dumped the whole usage block into
# stdout, i.e. straight into the conversation.
for p in '-h' '--help'; do
  out="$(feed "$(payload "$p")")"
  case "$out" in
    *usage:*|*"optional arguments"*|*options:*)
      fail "prompt '$p' leaked argparse usage into hook stdout: $out" ;;
  esac
done

# --- a flag-shaped prompt must not steer the tool ----------------------------
feed "$(payload '--telemetry-dir=/tmp/should-not-exist')" >/dev/null
[ ! -e /tmp/should-not-exist ] || fail "a prompt redirected telemetry outside the sandbox"

# --- routing still works, including for a prompt that starts with a dash -----
out="$(feed "$(payload 'what are my preferences')")"
case "$out" in *preferences.md*) ;; *) fail "an ordinary prompt no longer routes: $out" ;; esac
out="$(feed "$(payload '-x what are my preferences')")"
case "$out" in *preferences.md*) ;; *) fail "a dash-prefixed prompt lost routing: $out" ;; esac

# --- telemetry lands in the sandbox and records no prompt text ---------------
events="$TMP/telemetry/events.jsonl"
[ -s "$events" ] || fail "no telemetry was recorded in the sandbox"
grep -qi 'preferences.md' "$events" || fail "telemetry did not record the selected memory path"
grep -qi 'what are my preferences' "$events" \
  && fail "PROMPT TEXT was written to telemetry — it must record paths and byte counts only"

# --- a large prompt completes promptly and does not hang ---------------------
# Build the payload in-process; passing 200KB through argv hits ARG_MAX and
# would be testing the test harness rather than the hook.
python3 -c 'import json,sys;sys.stdout.write(json.dumps({"prompt":"preference "*20000}))' > "$TMP/big.json"
start=$(date +%s)
HOME="$TMP/home" AI_MEMORY_USAGE_DIR="$TMP/telemetry" \
  "$HOOK" < "$TMP/big.json" >/dev/null 2>&1 \
  || fail "hook failed on a very large prompt"
[ $(( $(date +%s) - start )) -le 15 ] || fail "hook took too long on a large prompt"

echo "memory-usage-hook-test: PASS"
