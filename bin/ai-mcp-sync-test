#!/usr/bin/env bash
# Regression check for ai-mcp-sync.
# Runs in an isolated temporary sandbox without touching real user files.
set -euo pipefail

DOT="$(cd "$(dirname "$0")/.." && pwd)"
SYNC="$DOT/bin/ai-mcp-sync"
[ -x "$SYNC" ] || { echo "not executable: $SYNC" >&2; exit 2; }

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

fail() { echo "FAIL: $*" >&2; exit 1; }

run_sync() { "$SYNC" --dotfiles "$DOT" --home "$TMP" "$@"; }

# 1. Manifest must be valid JSON
python3 -m json.tool "$DOT/config/ai/mcp-servers.json" >/dev/null \
  || fail "config/ai/mcp-servers.json is not valid JSON"

# 2. Test sandbox initial sync with repo manifest (preserves existing user config)
mkdir -p "$TMP/.claude" "$TMP/.gemini/config" "$TMP/.codex" "$TMP/.omp/agent" "$TMP/.pi/agent"
printf '{"mcpServers":{"existing-tool":{"command":"echo"}}}' > "$TMP/.claude.json"
printf 'model = "gpt-5"\n' > "$TMP/.codex/config.toml"

run_sync >/dev/null || fail "initial sync failed"

# 3. Check Claude preserves existing-tool and does not inject removed shadcn MCP
python3 -c "import json; d=json.load(open('$TMP/.claude.json')); assert 'existing-tool' in d['mcpServers'] and 'shadcn' not in d['mcpServers']" \
  || fail "Claude MCP lost existing-tool or still injected shadcn"

# 4. Check Antigravity
python3 -c "import json; d=json.load(open('$TMP/.gemini/config/mcp_config.json')); assert 'mcpServers' in d and 'shadcn' not in d['mcpServers']" \
  || fail "Antigravity MCP invalid or still injected shadcn"

# 5. Check Codex
grep -q 'model = "gpt-5"' "$TMP/.codex/config.toml" \
  || fail "Codex config lost existing model setting"
if grep -q '\[mcp_servers\.shadcn\]' "$TMP/.codex/config.toml"; then
  fail "Codex config still injected [mcp_servers.shadcn]"
fi

# 6. Check OMP
python3 -c "import json; d=json.load(open('$TMP/.omp/agent/mcp.json')); assert 'mcpServers' in d and 'shadcn' not in d['mcpServers'] and 'description' not in d['mcpServers']['playwright']" \
  || fail "OMP MCP invalid or still injected shadcn"

# 7. Check Pi
python3 -c "import json; p=json.load(open('$TMP/.pi/agent/mcp.json'))['mcpServers']['playwright']; assert '--prefix' in p['args'] and '--isolated' in p['args'] and p.get('description') and p.get('toolExposure',{}).get('browser_run_code_unsafe')=='hidden'" \
  || fail "Pi MCP invalid or missing Playwright prefix/isolation/description/toolExposure"

# 7b. Astro docs MCP: pinned stdio bridge in every runtime, npx isolated from project
# engines, auth/state kept out of $HOME, and no credential anywhere (TASK-215).
python3 - "$TMP" <<'PY' || fail "astro-docs MCP missing, unpinned, or leaking state into \$HOME"
import json, sys, tomllib
home = sys.argv[1]
def check(spec, where):
    a = spec["args"]
    assert spec["command"] == "npx", where
    assert a[:2] == ["--prefix", "/tmp"], where
    assert any(x.startswith("mcp-remote@") and x.split("@", 1)[1][:1].isdigit() for x in a), (where, "unpinned")
    assert "https://mcp.docs.astro.build/mcp" in a, where
    assert spec.get("env", {}).get("MCP_REMOTE_CONFIG_DIR", "").startswith("/tmp/"), where
    assert not any(k for k in spec.get("env", {}) if "TOKEN" in k or "KEY" in k), where
check(json.load(open(f"{home}/.claude.json"))["mcpServers"]["astro-docs"], "claude")
check(json.load(open(f"{home}/.gemini/config/mcp_config.json"))["mcpServers"]["astro-docs"], "antigravity")
check(json.load(open(f"{home}/.omp/agent/mcp.json"))["mcpServers"]["astro-docs"], "omp")
check(json.load(open(f"{home}/.pi/agent/mcp.json"))["mcpServers"]["astro-docs"], "pi")
check(tomllib.load(open(f"{home}/.codex/config.toml", "rb"))["mcp_servers"]["astro-docs"], "codex")
PY

# 8. Check --check reports in-sync
run_sync --check >/dev/null || fail "ai-mcp-sync --check should return 0 when in sync"

# 9. Missing file drift check & repair
rm -f "$TMP/.omp/agent/mcp.json"
if run_sync --check >/dev/null 2>&1; then
  fail "ai-mcp-sync --check should return non-zero on missing runtime MCP file"
fi

# Repair
run_sync >/dev/null || fail "repair sync failed"
run_sync --check >/dev/null || fail "in sync after repair"

echo "ai-mcp-sync-test: PASS"

# Full managed drift, preserved unrelated values, private writes, and failures.
python3 - "$SYNC" "$TMP" <<'PY'
import json,os,stat,subprocess,sys,tomllib
from pathlib import Path
sync=Path(sys.argv[1]); root=Path(sys.argv[2]); dot=root/'manifest'; (dot/'config/ai').mkdir(parents=True)
manifest=dot/'config/ai/mcp-servers.json'
manifest.write_text(json.dumps({'mcpServers':{'demo':{'command':'new-command','args':['new'], 'env':{'MODE':'new'}}}}))
home=root/'drift';home.mkdir()
paths=['.claude.json','.gemini/config/mcp_config.json','.omp/agent/mcp.json','.pi/agent/mcp.json']
for rel in paths:
 p=home/rel;p.parent.mkdir(parents=True,exist_ok=True);p.write_text(json.dumps({'keep':'value','mcpServers':{'demo':{'command':'old','args':['old'],'env':{'MODE':'old'},'timeout':99},'foreign':{'command':'keep'}}}));p.chmod(0o600)
p=home/'.codex/config.toml';p.parent.mkdir();p.write_text('model = "keep"\n# untouched comment\n[mcp_servers.demo]\ncommand="old"\nargs=["old"]\ntimeout=99\n[mcp_servers.demo.env]\nMODE="old"\n[mcp_servers.foreign]\ncommand="keep"\n');p.chmod(0o600)
cmd=[str(sync),'--dotfiles',str(dot),'--home',str(home)]
def run(*args):return subprocess.run(cmd+list(args),capture_output=True,text=True)
assert run('--check').returncode==1
old=os.umask(0o002)
try: assert run().returncode==0
finally:os.umask(old)
assert run('--check').returncode==0
for rel in paths:
 p=home/rel;d=json.loads(p.read_text());assert d['keep']=='value';assert d['mcpServers']['foreign']['command']=='keep';assert d['mcpServers']['demo']['env']=={'MODE':'new'};assert d['mcpServers']['demo']['timeout']==99;assert stat.S_IMODE(p.stat().st_mode)==0o600
p=home/'.codex/config.toml';d=tomllib.loads(p.read_text());assert d['model']=='keep';assert d['mcp_servers']['demo']=={'command':'new-command','args':['new'],'env':{'MODE':'new'},'timeout':99};assert d['mcp_servers']['foreign']=={'command':'keep'};assert '# untouched comment' in p.read_text();assert stat.S_IMODE(p.stat().st_mode)==0o600
before={q:q.read_bytes() for q in [home/x for x in paths]+[p]};assert run().returncode==0;assert all(q.read_bytes()==v for q,v in before.items())
# env-only drift is detected in every runtime, including removal from manifest.
manifest.write_text(json.dumps({'mcpServers':{'demo':{'command':'new-command','args':['new']}}}));assert run('--check').returncode==1;assert run().returncode==0;assert run('--check').returncode==0
for rel in paths+['.codex/config.toml']:
 p=home/rel;original=p.read_bytes();p.write_text('broken {')
 assert run().returncode==1 and run('--check').returncode==1
 assert p.read_text()=='broken {'
 p.write_bytes(original)
# An unsupported inline table cannot lose unrelated TOML content during repair.
p=home/'.codex/config.toml';p.write_text('mcp_servers = { demo = {command="old", args=[]}, foreign={command="keep"} }\n');original=p.read_bytes()
assert run().returncode==1 and p.read_bytes()==original
print('ai-mcp-sync-test: drift, privacy, idempotence, parse/layout failure regressions PASS')
PY

# Retired servers (retiredMcpServers): removed from every runtime and every
# Claude project scope; their $HOME paths go, links are unlinked not followed;
# unrelated servers, settings and files survive; unsafe paths are refused.
python3 - "$SYNC" "$TMP" <<'PY'
import json,subprocess,sys,tomllib
from pathlib import Path
sync=Path(sys.argv[1]); root=Path(sys.argv[2])/'retired'; dot=root/'dot'; (dot/'config/ai').mkdir(parents=True)
manifest=dot/'config/ai/mcp-servers.json'
def write_manifest(retired):
    manifest.write_text(json.dumps({'mcpServers':{'keep':{'command':'k'}},'retiredMcpServers':retired}))
write_manifest({'old':{'paths':['.local/bin/old-mcp','.local/opt/old','.local/bin/old-link']}})
home=root/'home'; home.mkdir()
paths=['.gemini/config/mcp_config.json','.omp/agent/mcp.json','.pi/agent/mcp.json']
for rel in paths:
    p=home/rel;p.parent.mkdir(parents=True,exist_ok=True);p.write_text(json.dumps({'x':1,'mcpServers':{'old':{'command':'o'},'other':{'command':'z'}}}))
(home/'.claude').mkdir()
(home/'.claude.json').write_text(json.dumps({'mcpServers':{'old':{'command':'o'}},'projects':{'/p':{'mcpServers':{'old':{'command':'o'},'mine':{'command':'m'}}}}}))
(home/'.codex').mkdir()
(home/'.codex/config.toml').write_text('model = "keep"\n[mcp_servers.old]\ncommand = "o"\n[mcp_servers.old.env]\nA = "1"\n[mcp_servers.other]\ncommand = "z"\n')
(home/'.local/bin').mkdir(parents=True); (home/'.local/bin/old-mcp').write_text('x'); (home/'.local/bin/unrelated').write_text('u')
(home/'.local/opt/old/sub').mkdir(parents=True); (home/'.local/opt/old/sub/f').write_text('x')
outside=root/'outside'; outside.mkdir(); (outside/'precious').write_text('p')
(home/'.local/bin/old-link').symlink_to(outside)
cmd=[str(sync),'--dotfiles',str(dot),'--home',str(home)]
run=lambda *a: subprocess.run(cmd+list(a),capture_output=True,text=True)
assert run('--check').returncode==1, 'retired entries must be reported as drift'
r=run(); assert r.returncode==0, r.stdout+r.stderr
assert run('--check').returncode==0
for rel in paths:
    d=json.loads((home/rel).read_text()); assert 'old' not in d['mcpServers'] and d['mcpServers']['other']=={'command':'z'} and d['x']==1
c=json.loads((home/'.claude.json').read_text()); assert 'old' not in c['mcpServers'] and c['projects']['/p']['mcpServers']=={'mine':{'command':'m'}}
t=tomllib.loads((home/'.codex/config.toml').read_text()); assert t['model']=='keep' and t['mcp_servers']['other']=={'command':'z'} and 'old' not in t['mcp_servers'], t
assert not (home/'.local/bin/old-mcp').exists() and not (home/'.local/opt/old').exists() and not (home/'.local/bin/old-link').is_symlink()
assert (outside/'precious').read_text()=='p', 'a retired symlink must never be followed'
assert (home/'.local/bin/unrelated').exists()
# A symlinked PARENT must not be traversed: nothing outside $HOME is deleted,
# the run reports failure, and --check keeps reporting it.
home2=root/'home2'; (home2/'.local').mkdir(parents=True); shared=root/'shared'; (shared/'old').mkdir(parents=True); (shared/'old/keep').write_text('k')
(home2/'.local/opt').symlink_to(shared)
write_manifest({'old':{'paths':['.local/opt/old']}})
cmd2=[str(sync),'--dotfiles',str(dot),'--home',str(home2)]
r=subprocess.run(cmd2,capture_output=True,text=True); assert r.returncode==1 and 'symlinked parent' in r.stdout, r.stdout
assert (shared/'old/keep').read_text()=='k', 'deleted through a symlinked parent'
assert subprocess.run(cmd2+['--check'],capture_output=True,text=True).returncode==1
write_manifest({'old':{'paths':['.local/bin/old-mcp','.local/opt/old','.local/bin/old-link']}})
before=(home/'.codex/config.toml').read_bytes(); assert run().returncode==0 and (home/'.codex/config.toml').read_bytes()==before
for bad in ['/etc/passwd','~/.x','../escape','.local/../../escape','']:
    write_manifest({'old':{'paths':[bad]}}); r=run(); assert r.returncode==2, (bad, r.stdout, r.stderr)
manifest.write_text(json.dumps({'mcpServers':{'old':{'command':'o'}},'retiredMcpServers':{'old':{}}})); assert run().returncode==2
print('ai-mcp-sync-test: retired servers, retired paths, symlink safety, path guard PASS')
PY

# The shipped manifest retires FigCraft and keeps its paths inside $HOME.
python3 -c "import json; r=json.load(open('$DOT/config/ai/mcp-servers.json'))['retiredMcpServers']; assert '.local/bin/figcraft-mcp' in r['figcraft']['paths']" \
  || fail "manifest no longer retires figcraft"
