#!/usr/bin/env bash
set -euo pipefail
ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd)}"
RC="$ROOT/bin/release-check"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/release-check-test.XXXXXX")"
cleanup(){
  if [ -n "${SERVER_PID:-}" ]; then
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
  rm -rf "$TMP"
}
trap cleanup EXIT
fail(){ echo "FAIL: $*" >&2; exit 1; }

# urllib honours runner proxy variables. Loopback is the fixture boundary and
# must never leave the runner, regardless of its global proxy configuration.
export HTTP_PROXY="http://127.0.0.1:1"
export HTTPS_PROXY="$HTTP_PROXY"
export ALL_PROXY="$HTTP_PROXY"
export NO_PROXY="127.0.0.1,localhost"
export no_proxy="$NO_PROXY"

mkdir -p "$TMP/www" "$TMP/repo"
printf 'app-ok release-marker database=ok workers=ok critical_errors=0\n' > "$TMP/www/index.html"
PORT="$(python3 - <<'PY'
import socket
s=socket.socket(); s.bind(('127.0.0.1',0)); print(s.getsockname()[1]); s.close()
PY
)"
python3 -m http.server "$PORT" --bind 127.0.0.1 --directory "$TMP/www" >"$TMP/server.log" 2>&1 &
SERVER_PID=$!
if ! python3 - <<PY
import socket,time
for _ in range(200):
    try:
        with socket.create_connection(('127.0.0.1',$PORT), timeout=.1): break
    except OSError: time.sleep(.05)
else: raise SystemExit(1)
PY
then
  cat "$TMP/server.log" >&2
  fail "fixture server did not become ready"
fi

cat > "$TMP/repo/STATUS.md" <<'EOF'
# Status
State: SMOKE_TESTING
EOF
cat > "$TMP/repo/OBSERVABILITY.md" <<EOF
# Observability Contract
Probe: app|http://127.0.0.1:$PORT/|200|release-marker|5000
Probe: database|http://127.0.0.1:$PORT/|200-299|database=ok|5000
Probe: background-jobs|http://127.0.0.1:$PORT/|200-299|workers=ok|5000
Probe: critical-errors|http://127.0.0.1:$PORT/|200-299|critical_errors=0|5000
Probe: expected-not-found|http://127.0.0.1:$PORT/missing|404|TBD|5000
EOF

set +e; "$RC" --json "$TMP/repo" >"$TMP/private.json" 2>&1; rc=$?; set -e
[ "$rc" -eq 2 ] || fail "private probe target should require explicit local override"
"$RC" --allow-private --json "$TMP/repo" >"$TMP/pass.json" || { cat "$TMP/pass.json" >&2; fail "all probes should verify"; }
grep -q '"result": "VERIFIED"' "$TMP/pass.json" || fail "VERIFIED result missing"
grep -q '"name": "database"' "$TMP/pass.json" || fail "database probe missing"
grep -q '"name": "background-jobs"' "$TMP/pass.json" || fail "background-jobs probe missing"

sed 's/critical_errors=0/critical_errors=9/' "$TMP/repo/OBSERVABILITY.md" > "$TMP/repo/OBSERVABILITY.tmp" && mv "$TMP/repo/OBSERVABILITY.tmp" "$TMP/repo/OBSERVABILITY.md"
set +e; "$RC" --allow-private --json "$TMP/repo" >"$TMP/fail.json" 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || { cat "$TMP/fail.json" >&2; fail "marker mismatch should fail"; }
grep -q '"result": "FAILED"' "$TMP/fail.json" || fail "FAILED result missing"

cat > "$TMP/repo/OBSERVABILITY.md" <<'EOF'
# Observability Contract
Probe: broken|TBD|200-299|TBD|1000
EOF
set +e; "$RC" --allow-private --json "$TMP/repo" >"$TMP/unverified.json" 2>&1; rc=$?; set -e
[ "$rc" -eq 2 ] || { cat "$TMP/unverified.json" >&2; fail "invalid probe contract should be UNVERIFIED"; }

cat > "$TMP/repo/STATUS.md" <<'EOF'
# Status
State: INTEGRATING
EOF
set +e; "$RC" --allow-private --json "$TMP/repo" >"$TMP/state.json" 2>&1; rc=$?; set -e
[ "$rc" -eq 2 ] || { cat "$TMP/state.json" >&2; fail "pre-deploy state should be UNVERIFIED"; }

echo 'release-check-test: PASS'
