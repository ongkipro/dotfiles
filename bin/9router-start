#!/usr/bin/env bash
# 9router-start - launch 9router AI gateway (macOS + Linux)
# Usage:
#   9router-start           # start 9router
#   9router-start --daemon  # non-interactive: start if not running
#   9router-start --status  # check health only
#   9router-start --stop    # stop running 9router
set -euo pipefail

say()  { printf '\033[1;32m->\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m⚠\033[0m  %s\n' "$*" >&2; }
err()  { printf '\033[1;31mx\033[0m %s\n' "$*" >&2; }

PORT=20128
HOST=127.0.0.1
HEALTH_URL="http://${HOST}:${PORT}/api/health"

cmd_status() {
  if curl -fsS "$HEALTH_URL" >/dev/null 2>&1; then
    say "9router RUNNING on $HEALTH_URL"
    return 0
  else
    warn "9router NOT running on $HEALTH_URL"
    return 1
  fi
}

cmd_start() {
  if cmd_status >/dev/null 2>&1; then
    say "9router sudah jalan - tidak perlu start ulang."
    return 0
  fi

  if ! command -v 9router >/dev/null 2>&1; then
    err "9router CLI tidak ditemukan. Install: npm i -g 9router"
    return 1
  fi

  local node_bin
  node_bin="$(command -v node)"
  local router_bin
  router_bin="$(command -v 9router)"
  local app_dir
  app_dir="$(dirname "$(readlink -f "$router_bin" 2>/dev/null || realpath "$router_bin" 2>/dev/null || echo "$router_bin")")/app"

  say "Starting 9router on $HOST:$PORT..."

  case "$(uname -s)" in
    Darwin)
      local plist="$HOME/Library/LaunchAgents/com.9router.gateway.plist"

      cat > "$plist" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.9router.gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>$node_bin</string>
    <string>$app_dir/custom-server.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PORT</key>
    <string>$PORT</string>
    <key>HOSTNAME</key>
    <string>$HOST</string>
    <key>NODE_PATH</key>
    <string>${HOME}/.9router/runtime/node_modules:${app_dir}/node_modules</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>$app_dir</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>${HOME}/.9router/logs/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>${HOME}/.9router/logs/stderr.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
PLISTEOF

      mkdir -p "$HOME/.9router/logs"
      launchctl unload "$plist" 2>/dev/null || true
      launchctl load "$plist"
      say "9router launchd service terdaftar - auto-start + restart"
      ;;

    Linux)
      local service_file="$HOME/.config/systemd/user/9router.service"
      if [ -f "$service_file" ]; then
        systemctl --user daemon-reload
        systemctl --user enable 9router.service 2>/dev/null || true
        systemctl --user restart 9router.service
        say "9router systemd service restarted"
      else
        warn "systemd service file tidak ditemukan di $service_file"
        warn "jalankan: ~/dotfiles/bin/pi-9router-restore untuk generate service"
      fi
      ;;
  esac

  # Tunggu health check
  for i in $(seq 1 10); do
    if curl -fsS "$HEALTH_URL" >/dev/null 2>&1; then
      say "9router SIAP di $HEALTH_URL"
      return 0
    fi
    sleep 1
  done

  warn "9router mungkin masih starting - cek logs di ~/.9router/logs/"
  return 1
}

cmd_stop() {
  case "$(uname -s)" in
    Darwin)
      local plist="$HOME/Library/LaunchAgents/com.9router.gateway.plist"
      launchctl unload "$plist" 2>/dev/null || true
      say "9router launchd service di-stop"
      ;;
    Linux)
      systemctl --user stop 9router.service 2>/dev/null || true
      say "9router systemd service di-stop"
      ;;
  esac
}

cmd_daemon() {
  if ! cmd_status >/dev/null 2>&1; then
    cmd_start
  fi
}

# CLI parsing
case "${1:-}" in
  status|--status|-s)  cmd_status ;;
  stop|--stop|-k)      cmd_stop ;;
  daemon|--daemon|-d)  cmd_daemon ;;
  start|--start|"")    cmd_start ;;
  help|-h|--help)
    echo "Usage: 9router-start [start|status|stop|daemon|help]"
    echo ""
    echo "  start    Start 9router (default). Uses launchd (macOS) or systemd (Linux)."
    echo "  status   Check if 9router is running (health check)."
    echo "  stop     Stop 9router service."
    echo "  daemon   Start only if not running (non-interactive)."
    ;;
  *)
    err "Unknown command: $1"
    exit 1
    ;;
esac
