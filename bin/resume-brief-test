#!/usr/bin/env bash
# resume-brief-test — §25's scenario, executed rather than described.
#
# Start a task, record partial verified state, throw the session away, and ask a
# fresh process where it is. It must answer from the repository: the open run,
# the check that already passed, the boundary it has not reached yet, and the
# tasks whose evidence does not end in PASS. Nothing here consults chat history,
# because the whole point is that there isn't any.
set -uo pipefail
ROOT="${DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
RB="$ROOT/bin/resume-brief"
DL="$ROOT/bin/delivery-ledger"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
R="$TMP/repo"; fails=0

say() { printf '  %-4s %s\n' "$1" "$2"; }
want() { # want <name> <substring>
  if printf '%s' "$BRIEF" | grep -qF "$2"; then say ok "$1"
  else say FAIL "$1"; printf '       wanted: %s\n' "$2"; fails=$((fails + 1)); fi
}
wantre() { if printf '%s' "$BRIEF" | grep -qE "$2"; then say ok "$1"
           else say FAIL "$1"; printf '       wanted /%s/\n' "$2"; fails=$((fails + 1)); fi; }
wantnot() {
  if printf '%s' "$BRIEF" | grep -qF "$2"; then
    say FAIL "$1"; printf '       should not contain: %s\n' "$2"; fails=$((fails + 1))
  else say ok "$1"; fi
}

mkdir -p "$R" && git -C "$R" init -q
printf 'contract\n' > "$R/AGENTS.md"
printf '### TASK-900: the one that is still open\n' > "$R/TASKS.md"
git -C "$R" add -A >/dev/null 2>&1
git -C "$R" -c user.email=t@t -c user.name=t commit -qm init >/dev/null 2>&1

"$DL" --repo "$R" init >/dev/null 2>&1
"$DL" --repo "$R" start --task TASK-900 --requirement REQ-9 --risk R1 \
  --job implementation --capability tooling --worker task \
  --model m --provider p --reasoning-effort high --allow 'src/**' >/dev/null 2>&1 \
  || { echo "resume-brief-test: could not start a run"; exit 1; }
"$DL" --repo "$R" record --check partial-suite --command 'true' >/dev/null 2>&1

# The session ends here. Everything below is a fresh process reading disk.
BRIEF="$("$RB" "$R" 2>&1)"

want "names the active run"                 "Active run:"
want "names the task being resumed"         "task TASK-900"
want "names the requirement"                "REQ-9"
want "reports the declared surface"         "declared surface: src/**"
want "reports the check that already passed" "PASS  partial-suite"
want "distinguishes executed from asserted" "(executed)"
want "says the boundary was never reached"  "last boundary: never checked"
want "states what finishing still needs"    "check-boundary"
want "lists the task as not ending in PASS" "TASK-900"
want "carries the task title from TASKS.md" "the one that is still open"

# An asserted check must not be dressed up as an executed one.
"$DL" --repo "$R" record --check claimed-only --status PASS --detail x >/dev/null 2>&1
BRIEF="$("$RB" "$R" 2>&1)"
want "shows an asserted check as asserted"  "claimed-only  (asserted)"

# A task the archive has retired must not be offered as a resume candidate:
# TASK-023 was superseded in 2026-08 and still appeared in the list, which is the
# exact stale signal this command exists to remove.
mkdir -p "$R/docs/archive"
printf '| TASK-901 | retired | superseded by TASK-902 |\n' > "$R/docs/archive/old.md"
# The TASK-900 run is still open; a second start is refused while it is, and a
# refused start leaves no evidence for this case to judge. Close it first.
"$DL" --repo "$R" finish --result BLOCKED >/dev/null 2>&1
"$DL" --repo "$R" start --task TASK-901 --requirement REQ-9 --risk R1 \
  --job implementation --capability tooling --worker task \
  --model m --provider p --reasoning-effort high --allow 'nowhere/**' >/dev/null 2>&1
"$DL" --repo "$R" finish --result BLOCKED >/dev/null 2>&1
BRIEF="$("$RB" "$R" 2>&1)"
want "names the retired task as retired"    "Retired in docs/archive"
if printf '%s' "$BRIEF" | sed -n '/Tasks whose/,/^$/p' | grep -q "TASK-901"; then
  say FAIL "a retired task is not offered as a candidate"; fails=$((fails + 1))
else say ok "a retired task is not offered as a candidate"; fi
if printf '%s' "$BRIEF" | grep -qE "CI for this HEAD: (success|failure|no run found|unknown|in_progress|queued|completed)"; then
  say ok "the CI line names a real state"
else say FAIL "the CI line names a real state"; fails=$((fails + 1)); fi

# Independent review found that `TASK-02` matched an archive line mentioning
# `TASK-023`, and that only `### TASK-nnn:` counted as live. Together they
# deleted real unfinished work from the candidate list — the opposite of this
# command's purpose, delivered by the commit that claimed to sharpen it.
N="$TMP/narrow"; mkdir -p "$N/docs/archive" && git -C "$N" init -q
printf 'contract\n' > "$N/AGENTS.md"
printf '## TASK-02: a live task recorded as h2\n' > "$N/TASKS.md"
printf '| TASK-023 | retired | superseded |\n' > "$N/docs/archive/old.md"
git -C "$N" add -A >/dev/null 2>&1
git -C "$N" -c user.email=t@t -c user.name=t commit -qm init >/dev/null 2>&1
"$DL" --repo "$N" init >/dev/null 2>&1
"$DL" --repo "$N" start --task TASK-02 --requirement REQ-N --risk R1 \
  --job implementation --capability tooling --worker task \
  --model m --provider p --reasoning-effort high --allow 'x/**' >/dev/null 2>&1
"$DL" --repo "$N" finish --result BLOCKED >/dev/null 2>&1
BRIEF="$("$RB" "$N" 2>&1)"
if printf '%s' "$BRIEF" | sed -n '/Tasks whose/,/^$/p' | grep -q "TASK-02"; then
  say ok "a live task is not retired by an unrelated longer ID"
else
  say FAIL "a live task is not retired by an unrelated longer ID"; fails=$((fails + 1))
fi
want "its h2 title is still read"  "a live task recorded as h2"
wantnot "it is not listed as retired" "Retired in docs/archive, not candidates: TASK-02"

# The archive side, isolated: TASK-02 appears NOWHERE except as a prefix of the
# archived TASK-023. Substring matching calls it retired and deletes it; it is
# not retired, it is simply unmentioned, and must stay a candidate. The first
# attempt at this case put TASK-02 in TASKS.md, which made both the broken and
# the fixed rule agree — a test that could not fail, found by mutating the fix.
P="$TMP/prefix"; mkdir -p "$P/docs/archive" && git -C "$P" init -q
printf 'contract\n' > "$P/AGENTS.md"; printf 'no tasks here\n' > "$P/TASKS.md"
printf '| TASK-023 | retired | superseded |\n' > "$P/docs/archive/old.md"
git -C "$P" add -A >/dev/null 2>&1
git -C "$P" -c user.email=t@t -c user.name=t commit -qm init >/dev/null 2>&1
"$DL" --repo "$P" init >/dev/null 2>&1
"$DL" --repo "$P" start --task TASK-02 --requirement REQ-P --risk R1 \
  --job implementation --capability tooling --worker task \
  --model m --provider p --reasoning-effort high --allow 'x/**' >/dev/null 2>&1
"$DL" --repo "$P" finish --result BLOCKED >/dev/null 2>&1
BRIEF="$("$RB" "$P" 2>&1)"
if printf '%s' "$BRIEF" | sed -n '/Tasks whose/,/^$/p' | grep -q "TASK-02"; then
  say ok "a shorter ID is not retired by a longer archived one"
else
  say FAIL "a shorter ID is not retired by a longer archived one"; fails=$((fails + 1))
fi

# The live side, isolated: a task named by its exact ID in BOTH the archive and
# TASKS.md, where TASKS.md records it as a bullet rather than a heading. This is
# the real shape — TASK-013 lived as a bullet in the Pending section while an
# archived audit referenced it — and demanding "### TASK-013:" declared the most
# active task in the repository retired.
L="$TMP/bullet"; mkdir -p "$L/docs/archive" && git -C "$L" init -q
printf 'contract\n' > "$L/AGENTS.md"
printf '## Pending\n\n- **TASK-05 / AUDIT-X — still open (R1).** Details.\n' > "$L/TASKS.md"
printf 'Historical note referencing TASK-05 as prior context.\n' > "$L/docs/archive/old.md"
git -C "$L" add -A >/dev/null 2>&1
git -C "$L" -c user.email=t@t -c user.name=t commit -qm init >/dev/null 2>&1
"$DL" --repo "$L" init >/dev/null 2>&1
"$DL" --repo "$L" start --task TASK-05 --requirement REQ-L --risk R1 \
  --job implementation --capability tooling --worker task \
  --model m --provider p --reasoning-effort high --allow 'x/**' >/dev/null 2>&1
"$DL" --repo "$L" finish --result BLOCKED >/dev/null 2>&1
BRIEF="$("$RB" "$L" 2>&1)"
if printf '%s' "$BRIEF" | sed -n '/Tasks whose/,/^$/p' | grep -q "TASK-05"; then
  say ok "a live task recorded as a bullet is not retired"
else
  say FAIL "a live task recorded as a bullet is not retired"; fails=$((fails + 1))
fi

# Prose naming a task is not a record of it. One sentence in TASKS.md
# ("Completed task contracts through TASK-023 are archived in:") resurrected an
# archived task as a live candidate the moment the mention rule was loosened.
M="$TMP/prose"; mkdir -p "$M/docs/archive" && git -C "$M" init -q
printf 'contract\n' > "$M/AGENTS.md"
printf 'Completed contracts through TASK-77 are archived in docs/archive.\n' > "$M/TASKS.md"
printf '### TASK-77: done long ago\n' > "$M/docs/archive/old.md"
git -C "$M" add -A >/dev/null 2>&1
git -C "$M" -c user.email=t@t -c user.name=t commit -qm init >/dev/null 2>&1
"$DL" --repo "$M" init >/dev/null 2>&1
"$DL" --repo "$M" start --task TASK-77 --requirement REQ-M --risk R1 \
  --job implementation --capability tooling --worker task \
  --model m --provider p --reasoning-effort high --allow 'x/**' >/dev/null 2>&1
"$DL" --repo "$M" finish --result BLOCKED >/dev/null 2>&1
BRIEF="$("$RB" "$M" 2>&1)"
want "a prose mention does not keep a task live" "Retired in docs/archive"

# §9: the lifecycle is derived. Only the dependency edge is written by hand, so
# only it can be wrong; a written-down status could not be, which is exactly how
# TASK-013 sat recording a blocker that had stopped being true.
D="$TMP/deps"; mkdir -p "$D" && git -C "$D" init -q
printf 'contract\n' > "$D/AGENTS.md"
cat > "$D/TASKS.md" <<'MD'
### TASK-10: the one that must go first
- **Risk Level:** R1

### TASK-11: the one that waits
- **Depends On:** TASK-10
- **Risk Level:** R1

### TASK-12: the one that waits on nothing real
- **Depends On:** TASK-99
- **Risk Level:** R1
MD
git -C "$D" add -A >/dev/null 2>&1
git -C "$D" -c user.email=t@t -c user.name=t commit -qm init >/dev/null 2>&1
"$DL" --repo "$D" init >/dev/null 2>&1
for t in TASK-10 TASK-11 TASK-12; do
  "$DL" --repo "$D" start --task $t --requirement REQ-D --risk R1 \
    --job implementation --capability tooling --worker task \
    --model m --provider p --reasoning-effort high --allow 'x/**' >/dev/null 2>&1
  "$DL" --repo "$D" finish --result BLOCKED >/dev/null 2>&1
done
BRIEF="$("$RB" "$D" 2>&1)"
wantre "an unmet dependency marks a task waiting"  "^ +TASK-11 +waiting"
want "the blocking task is named"                 "needs first: TASK-10"
want "a dependency that does not exist is unmet"  "needs first: TASK-99"
wantre "a task with no dependency is READY"        "^ +TASK-10 +READY"
want "the counts are reported"                    "1 ready to start, 2 waiting"

# The core promise had no test: deleting the "is it PASS" condition entirely —
# so every dependency is always unmet — passed the whole suite, because all three
# fixture tasks finished BLOCKED. A met dependency must release its dependent.
R2D="$TMP/deps2"; mkdir -p "$R2D" && git -C "$R2D" init -q
printf 'contract\n' > "$R2D/AGENTS.md"
cat > "$R2D/TASKS.md" <<'MD'
### TASK-20: the finished one
- **Risk Level:** R1

### TASK-21: released once TASK-20 passes
- **Depends On:** TASK-20
- **Risk Level:** R1

## TASK-22: a task headed with two hashes
- **Depends On:** TASK-96
- **Risk Level:** R1

## Done

- **TASK-23 / REQ-Z — a bullet-shaped record.**
- **Depends On:** TASK-99
MD
git -C "$R2D" add -A >/dev/null 2>&1
git -C "$R2D" -c user.email=t@t -c user.name=t commit -qm init >/dev/null 2>&1
"$DL" --repo "$R2D" init >/dev/null 2>&1
start_run() { "$DL" --repo "$R2D" start --task "$1" --requirement REQ-Z --risk R1 \
  --job implementation --capability tooling --worker task \
  --model m --provider p --reasoning-effort high --allow 'x/**' >/dev/null 2>&1; }
start_run TASK-20
"$DL" --repo "$R2D" record --check t --command 'true' >/dev/null 2>&1
"$DL" --repo "$R2D" check-boundary >/dev/null 2>&1
"$DL" --repo "$R2D" finish --result PASS >/dev/null 2>&1
for t in TASK-21 TASK-22 TASK-23; do start_run $t; "$DL" --repo "$R2D" finish --result BLOCKED >/dev/null 2>&1; done
BRIEF="$("$RB" "$R2D" 2>&1)"
wantre "a met dependency releases its dependent"   "^ +TASK-21 +READY"
# Depends on something UNMET on purpose: with a met dependency this case passed
# whether or not the two-hash rule worked, which a mutation exposed.
wantre "a two-hash task still carries its edge"    "^ +TASK-22 +waiting"
want   "the two-hash task names its blocker"       "needs first: TASK-96"
wantre "a bullet-shaped record carries its edge"   "^ +TASK-23 +waiting"
want   "the bullet task names its blocker"         "needs first: TASK-99"

# A `## ` section starting after a `### ` task must end that task's scan. The
# first parser only broke on `### `, so a stray Depends On line under `## Done`
# was attributed to the last three-hash task above it.
L2="$TMP/leak"; mkdir -p "$L2" && git -C "$L2" init -q
printf 'contract\n' > "$L2/AGENTS.md"
cat > "$L2/TASKS.md" <<'MD'
### TASK-30: has no dependency of its own
- **Risk Level:** R1

## Historical closure

- **Depends On:** TASK-98
MD
git -C "$L2" add -A >/dev/null 2>&1
git -C "$L2" -c user.email=t@t -c user.name=t commit -qm init >/dev/null 2>&1
"$DL" --repo "$L2" init >/dev/null 2>&1
"$DL" --repo "$L2" start --task TASK-30 --requirement REQ-L --risk R1 \
  --job implementation --capability tooling --worker task \
  --model m --provider p --reasoning-effort high --allow 'x/**' >/dev/null 2>&1
"$DL" --repo "$L2" finish --result BLOCKED >/dev/null 2>&1
BRIEF="$("$RB" "$L2" 2>&1)"
wantre "a later section does not leak its edge upward" "^ +TASK-30 +READY"
wantnot "the leaked blocker is not attributed"         "needs first: TASK-98"

# Prose quoting a heading must not hijack the scan. Splitting on the substring
# "### TASK-nnn:" found the quote first and stopped before the real record.
Q="$TMP/quote"; mkdir -p "$Q" && git -C "$Q" init -q
printf 'contract\n' > "$Q/AGENTS.md"
{ printf 'An earlier draft heading read `### TASK-40: old name` before renaming.\n\n'
  printf '### TASK-40: the real record\n- **Depends On:** TASK-97\n'; } > "$Q/TASKS.md"
git -C "$Q" add -A >/dev/null 2>&1
git -C "$Q" -c user.email=t@t -c user.name=t commit -qm init >/dev/null 2>&1
"$DL" --repo "$Q" init >/dev/null 2>&1
"$DL" --repo "$Q" start --task TASK-40 --requirement REQ-Q --risk R1 \
  --job implementation --capability tooling --worker task \
  --model m --provider p --reasoning-effort high --allow 'x/**' >/dev/null 2>&1
"$DL" --repo "$Q" finish --result BLOCKED >/dev/null 2>&1
BRIEF="$("$RB" "$Q" 2>&1)"
want "prose quoting a heading does not hijack the scan" "needs first: TASK-97"

# Finding 4's remediation had no test at all: three separate mutations of it
# passed the whole suite. Same defect class as the coverage hole one round
# earlier, recurring on the code written to close that hole.
A2="$TMP/deps3"; mkdir -p "$A2/docs/archive" && git -C "$A2" init -q
printf 'contract\n' > "$A2/AGENTS.md"
cat > "$A2/TASKS.md" <<'MD'
### TASK-40: waits on something the archive retired
- **Depends On:** TASK-41

### TASK-42: waits on a record that never ran
- **Depends On:** TASK-43

### TASK-43: has a record and no ledger run

### TASK-44: waits on something nothing defines
- **Depends On:** TASK-45

### TASK-46: waits on a task that is BOTH live and archived
- **Depends On:** TASK-47

### TASK-47: still live despite appearing in the archive
MD
printf '### TASK-41: retired long ago\n### TASK-47: also mentioned here\n' > "$A2/docs/archive/old.md"
git -C "$A2" add -A >/dev/null 2>&1
git -C "$A2" -c user.email=t@t -c user.name=t commit -qm init >/dev/null 2>&1
"$DL" --repo "$A2" init >/dev/null 2>&1
for t in TASK-40 TASK-42 TASK-44 TASK-46 TASK-47; do
  "$DL" --repo "$A2" start --task $t --requirement REQ-A --risk R1 \
    --job implementation --capability tooling --worker task \
    --model m --provider p --reasoning-effort high --allow 'x/**' >/dev/null 2>&1
  "$DL" --repo "$A2" finish --result BLOCKED >/dev/null 2>&1
done
BRIEF="$("$RB" "$A2" 2>&1)"
wantre "a retired dependency does not block"        "^ +TASK-40 +READY"
want   "and it is named as superseded"              "superseded dependency, not blocking: TASK-41"
wantre "a record with no ledger run still blocks"   "^ +TASK-42 +waiting"
want   "and the reason says there is no run"        "TASK-43 (no ledger run)"
want   "a dependency nothing defines says so"       "TASK-45 (no task defines it)"
wantre "a live task that is also archived blocks"   "^ +TASK-46 +waiting"
wantnot "it is not waved through as superseded"     "superseded dependency, not blocking: TASK-47"

# A fenced example is documentation, not a task record. The archive carries
# "### TASK-000: [Short Task Title]" inside a fence, which put TASK-000 into the
# lint's set of real tasks.
# Observable only because the fenced id is ALSO archived and has a run: if the
# fence is parsed it counts as a live record and the task stops being retired.
# The first version of this case asserted things that held either way.
F="$TMP/fence"; mkdir -p "$F/docs/archive" && git -C "$F" init -q
printf 'contract\n' > "$F/AGENTS.md"
{ printf '### TASK-50: the real one\n\n'
  printf 'Template:\n\n%s\n' '```'
  printf '### TASK-000: [Short Task Title]\n- **Depends On:** TASK-001\n'
  printf '%s\n' '```'; } > "$F/TASKS.md"
printf '### TASK-000: retired template residue\n' > "$F/docs/archive/old.md"
git -C "$F" add -A >/dev/null 2>&1
git -C "$F" -c user.email=t@t -c user.name=t commit -qm init >/dev/null 2>&1
"$DL" --repo "$F" init >/dev/null 2>&1
for t in TASK-50 TASK-000; do
  "$DL" --repo "$F" start --task $t --requirement REQ-F --risk R1 \
    --job implementation --capability tooling --worker task \
    --model m --provider p --reasoning-effort high --allow 'x/**' >/dev/null 2>&1
  "$DL" --repo "$F" finish --result BLOCKED >/dev/null 2>&1
done
BRIEF="$("$RB" "$F" 2>&1)"
wantre "a real task beside a fenced example is READY" "^ +TASK-50 +READY"
want   "a fenced id is not a live record"            "Retired in docs/archive, not candidates: TASK-000"

# A repository with no ledger still resumes on Git state instead of erroring.
mkdir -p "$TMP/plain" && git -C "$TMP/plain" init -q
BRIEF="$("$RB" "$TMP/plain" 2>&1)"
want "a ledger-less repository still answers" "resume authority is Git state only"
wantnot "does not invent a run"               "Active run:"

# Not a repository at all: exit 2, not a confident wrong answer.
mkdir -p "$TMP/nogit"; "$RB" "$TMP/nogit" >/dev/null 2>&1; code=$?
[ "$code" = 2 ] && say ok "a non-repository exits 2" \
  || { say FAIL "a non-repository exits 2 (got $code)"; fails=$((fails + 1)); }

echo
[ "$fails" -eq 0 ] && { echo "resume-brief-test: all cases hold"; exit 0; }
echo "resume-brief-test: $fails case(s) failed"; exit 1
