#!/usr/bin/env python3
"""Deterministic regression test suite for bin/rea-skill-sync."""

from __future__ import annotations

import json
from pathlib import Path
import subprocess
import sys
import tempfile

DOT = Path(__file__).resolve().parent.parent
BIN = DOT / "bin" / "rea-skill-sync"


def run_sync(*args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [sys.executable, str(BIN), *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )


def main() -> int:
    if not BIN.is_file():
        print(f"FAIL: missing {BIN}", file=sys.stderr)
        return 1

    with tempfile.TemporaryDirectory(prefix="rea-skill-sync-test-") as tmp_str:
        tmp = Path(tmp_str)
        root = tmp / "dotfiles"
        up = tmp / "rea-upstream"

        # 1. Create synthetic dotfiles + upstream fixture
        local_refs = root / "skills" / "local" / "black-magic" / "references"
        local_refs.mkdir(parents=True)
        integration_file = local_refs / "dotfiles-integration.md"
        integration_file.write_text(
            "# Local Dotfiles Integration\nKeep this file intact.\n",
            encoding="utf-8",
        )

        up_refs = up / ".agents" / "skills" / "reverse-engineer-anything" / "references"
        up_refs.mkdir(parents=True)
        (up / "src").mkdir(parents=True)
        (up / "package.json").write_text(
            json.dumps({"name": "rea-agents", "version": "6.7.0"}),
            encoding="utf-8",
        )
        (up / "src" / "cliCommandNames.ts").write_text(
            'export const BROWSER_OBSERVATION_CLI_COMMAND_NAMES = ["list-browser-targets"] as const;\n'
            'export const ELECTRON_OBSERVATION_CLI_COMMAND_NAMES = ["list-electron-targets"] as const;\n'
            'export const PRIMARY_CLI_COMMAND_NAMES = ["doctor", "setup", "open-binary"] as const;\n'
            'export const MCP_ONLY_BINARY_SESSION_TOOL_NAMES = ["binary_session", "get_xrefs"] as const;\n',
            encoding="utf-8",
        )
        upstream_body = (
            "# REA\n\nUpstream body line 1.\n"
            "See [references/runtime-observation.md](references/runtime-observation.md).\n"
        )
        (up / ".agents" / "skills" / "reverse-engineer-anything" / "SKILL.md").write_text(
            '---\nname: reverse-engineer-anything\ndescription: Upstream desc.\nmetadata:\n  version: "43"\n---\n\n'
            + upstream_body,
            encoding="utf-8",
        )
        (up_refs / "runtime-observation.md").write_text(
            "# Runtime Observation\nUpstream ref content.\n",
            encoding="utf-8",
        )
        (up_refs / "legacy-guide.md").write_text(
            "# Legacy Guide\nTo be removed later.\n",
            encoding="utf-8",
        )

        # 2. Initial --check before sync must report DRIFT (exit 1)
        chk0 = run_sync("--root", str(root), "--upstream-dir", str(up), "--check", "--json")
        assert chk0.returncode == 1, f"expected exit 1 on initial check, got {chk0.returncode}: {chk0.stderr}"
        rep0 = json.loads(chk0.stdout)
        assert rep0["status"] == "DRIFT", rep0
        assert "SKILL.md" in rep0["driftedFiles"], rep0

        # 3. Initial sync writes SKILL.md, references, .source, .local-fork
        sync1 = run_sync("--root", str(root), "--upstream-dir", str(up), "--json")
        assert sync1.returncode == 0, f"sync1 failed: {sync1.stderr}"
        rep1 = json.loads(sync1.stdout)
        assert rep1["status"] == "UPDATED", rep1
        assert rep1["reaVersion"] == "6.7.0", rep1
        assert rep1["skillVersion"] == "43", rep1
        assert rep1["primaryCliCommandCount"] == 5, rep1
        assert rep1["mcpOnlyToolCount"] == 2, rep1

        skill_md_path = root / "skills" / "local" / "black-magic" / "SKILL.md"
        skill_text = skill_md_path.read_text(encoding="utf-8")
        assert "name: black-magic\n" in skill_text, skill_text
        # Verify exact byte-for-byte preservation of upstream_body
        fm_end = skill_text.index("\n---\n\n") + len("\n---\n\n")
        dotfiles_marker = "\n## Dotfiles integration and sibling handoffs\n"
        marker_idx = skill_text.index(dotfiles_marker)
        preserved_body = skill_text[fm_end:marker_idx]
        assert preserved_body == upstream_body, (
            f"body mismatch:\nexpected={upstream_body!r}\ngot={preserved_body!r}"
        )
        # Codex cuts descriptions near 250 characters, so the Not/Not for boundary must start before 240.
        # Measured on the parsed YAML value, the way skill-check does, so a folded (>-) scalar counts too.
        import re as _re

        frontmatter = _re.match(r"^---\n(.*?)\n---", skill_text, _re.S).group(1)
        try:
            import yaml as _yaml

            desc_raw = str(_yaml.safe_load(frontmatter)["description"])
        except ModuleNotFoundError:
            # No PyYAML: a folded/plain scalar is its indented continuation lines joined by spaces.
            m = _re.search(r"^description:[ \t]*(?:>-?|\|-?)?[ \t]*(.*(?:\n[ \t]+.*)*)", frontmatter, _re.M)
            desc_raw = m.group(1).strip().strip("'\"")
        desc_value = " ".join(desc_raw.split())
        boundary = _re.search(r"\b(NOT|Not)\b|\bnot for\b", desc_value)
        assert boundary and boundary.start() < 240, f"boundary clause starts at {boundary and boundary.start()}"

        # 4. Idempotent check: set an old date in .source/.local-fork and verify --check stays IN_SYNC when content matches
        src_file = root / "skills" / "local" / "black-magic" / ".source"
        fork_file = root / "skills" / "local" / "black-magic" / ".local-fork"
        src_file.write_text(
            src_file.read_text(encoding="utf-8").replace(
                src_file.read_text(encoding="utf-8").splitlines()[1],
                "vendored: 2020-01-01",
            ),
            encoding="utf-8",
        )
        fork_file.write_text(
            fork_file.read_text(encoding="utf-8").replace(
                fork_file.read_text(encoding="utf-8").splitlines()[1],
                "verified: 2020-01-01",
            ),
            encoding="utf-8",
        )
        chk1 = run_sync("--root", str(root), "--upstream-dir", str(up), "--check", "--json")
        assert chk1.returncode == 0, f"expected exit 0 after sync, got {chk1.returncode}: {chk1.stdout}"
        assert "vendored: 2020-01-01" in src_file.read_text(encoding="utf-8")

        # 5. Simulate upstream release: bump version to 6.8.0 / v44, add new ref, remove legacy-guide.md
        (up / "package.json").write_text(
            json.dumps({"name": "rea-agents", "version": "6.8.0"}),
            encoding="utf-8",
        )
        (up / ".agents" / "skills" / "reverse-engineer-anything" / "SKILL.md").write_text(
            '---\nname: reverse-engineer-anything\ndescription: Upstream desc.\nmetadata:\n  version: "44"\n---\n\n'
            "# REA\n\nUpstream body line 1.\nUpstream added v44 capability.\n",
            encoding="utf-8",
        )
        (up_refs / "quantum-binaries.md").write_text(
            "# Quantum Binaries\nNew upstream reference.\n",
            encoding="utf-8",
        )
        (up_refs / "legacy-guide.md").unlink()

        chk2 = run_sync("--root", str(root), "--upstream-dir", str(up), "--check", "--json")
        assert chk2.returncode == 1, "expected drift exit 1 after upstream update"
        rep2 = json.loads(chk2.stdout)
        assert "SKILL.md" in rep2["driftedFiles"], rep2
        assert "references/quantum-binaries.md" in rep2["driftedFiles"], rep2
        assert "references/legacy-guide.md" in rep2["driftedFiles"], rep2

        # 6. Apply sync and verify new ref added, stale ref removed, and local integration preserved
        sync2 = run_sync("--root", str(root), "--upstream-dir", str(up), "--json")
        assert sync2.returncode == 0, f"sync2 failed: {sync2.stderr}"
        assert (local_refs / "quantum-binaries.md").is_file()
        assert not (local_refs / "legacy-guide.md").exists()
        assert integration_file.read_text(encoding="utf-8") == "# Local Dotfiles Integration\nKeep this file intact.\n"
        assert 'rea_version: "6.8.0"' in skill_md_path.read_text(encoding="utf-8")

        # 7. Verify upstream collision with references/dotfiles-integration.md is refused (exit 2)
        (up_refs / "dotfiles-integration.md").write_text(
            "# Malicious Upstream Collision\n",
            encoding="utf-8",
        )
        coll = run_sync("--root", str(root), "--upstream-dir", str(up), "--json")
        assert coll.returncode == 2, f"expected exit 2 on collision, got {coll.returncode}"
        assert "collides with protected local file" in coll.stdout, coll.stdout
        assert integration_file.read_text(encoding="utf-8") == "# Local Dotfiles Integration\nKeep this file intact.\n"
        (up_refs / "dotfiles-integration.md").unlink()

        # 8. Verify CRLF preservation across body and references without perpetual DRIFT
        crlf_body = "# REA\r\n\r\nCRLF body line 1.\r\n"
        (up / ".agents" / "skills" / "reverse-engineer-anything" / "SKILL.md").write_bytes(
            (
                '---\r\nname: reverse-engineer-anything\r\ndescription: Upstream desc.\r\nmetadata:\r\n  version: "45"\r\n---\r\n\r\n'
                + crlf_body
            ).encode("utf-8")
        )
        (up_refs / "runtime-observation.md").write_bytes(
            b"# Runtime Observation\r\nCRLF ref line.\r\n"
        )
        sync3 = run_sync("--root", str(root), "--upstream-dir", str(up), "--json")
        assert sync3.returncode == 0, f"sync3 failed: {sync3.stderr}"
        raw_skill = skill_md_path.read_bytes().decode("utf-8")
        fm_end3 = raw_skill.index("\n---\n\n") + len("\n---\n\n")
        marker_idx3 = raw_skill.index("\n## Dotfiles integration and sibling handoffs\n")
        assert raw_skill[fm_end3:marker_idx3] == crlf_body, (
            f"CRLF body altered: {raw_skill[fm_end3:marker_idx3]!r}"
        )
        assert (local_refs / "runtime-observation.md").read_bytes() == b"# Runtime Observation\r\nCRLF ref line.\r\n"
        chk3 = run_sync("--root", str(root), "--upstream-dir", str(up), "--check", "--json")
        assert chk3.returncode == 0, f"expected IN_SYNC on CRLF check, got {chk3.returncode}: {chk3.stdout}"

        # 9. Verify malformed JSON in package.json and invalid UTF-8 exit 2 (not 1) with structured JSON error
        (up / "package.json").write_text("{corrupt json", encoding="utf-8")
        bad_json = run_sync("--root", str(root), "--upstream-dir", str(up), "--check", "--json")
        assert bad_json.returncode == 2, f"expected exit 2 on corrupt JSON, got {bad_json.returncode}"
        err_rep = json.loads(bad_json.stdout)
        assert err_rep["status"] == "ERROR", err_rep

        (up / "package.json").write_text('{"name":"rea-agents","version":"6.8.0"}', encoding="utf-8")
        (up_refs / "runtime-observation.md").write_bytes(b"\xff\xfeinvalid-utf8")
        bad_utf8 = run_sync("--root", str(root), "--upstream-dir", str(up), "--check", "--json")
        assert bad_utf8.returncode == 2, f"expected exit 2 on invalid UTF-8, got {bad_utf8.returncode}"
        assert json.loads(bad_utf8.stdout)["status"] == "ERROR"

        # 10. Verify http.client.IncompleteRead in fetch_text raises SyncError (exit 2)
        import http.client
        import importlib.machinery
        import importlib.util
        import unittest.mock

        loader = importlib.machinery.SourceFileLoader("rea_skill_sync_mod", str(BIN))
        spec = importlib.util.spec_from_loader("rea_skill_sync_mod", loader)
        assert spec and spec.loader
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        with unittest.mock.patch(
            "urllib.request.urlopen",
            side_effect=http.client.IncompleteRead(b"partial", 100),
        ):
            try:
                mod.fetch_text("https://example.invalid/SKILL.md")
                raise AssertionError("expected SyncError on IncompleteRead")
            except mod.SyncError as exc:
                assert "IncompleteRead" in str(exc)

        # 11. Real upstream layouts. Fixtures copy the shape of tagged releases of morluto/rea, so a
        # layout move cannot pass here while failing against upstream (it did: the file moved from
        # src/ to src/contracts/ in 6.10.0 and the old fixture could not notice).
        array_layout = (  # rea-agents 6.8.0 / 6.9.0: names listed in arrays or one frozen object
            'export const CLI_COMMANDS = Object.freeze({\n'
            '  analyze: "analyze",\n  inspect: "inspect",\n  doctor: "doctor",\n'
            '});\n'
        )
        contract_layout = (  # rea-agents >= 6.10.0: partial list, the rest come from contracts
            'export const cliCommandFor = <Name extends string>(name: Name) => name.replaceAll("_", "-");\n'
            'export const CLI_COMMANDS = Object.freeze({\n'
            '  analyze: "analyze",\n  inspect: "inspect",\n'
            '});\n'
        )
        assert mod.parse_cli_counts(array_layout) == (3, 0), mod.parse_cli_counts(array_layout)
        assert mod.parse_cli_counts(contract_layout) == (None, None), (
            "a contract-derived file lists only part of the commands; reporting its entries as the total is wrong"
        )

        def count_via(rel_path: str, text: str, label: str) -> dict:
            work = tmp / f"layout-{label}"
            names_file = work / rel_path
            names_file.parent.mkdir(parents=True, exist_ok=True)
            names_file.write_text(text, encoding="utf-8")
            skill_ref = work / ".agents" / "skills" / "reverse-engineer-anything"
            (skill_ref / "references").mkdir(parents=True)
            (work / "package.json").write_text('{"name":"rea-agents","version":"6.10.1"}', encoding="utf-8")
            (skill_ref / "SKILL.md").write_text(
                '---\nname: reverse-engineer-anything\nmetadata:\n  version: "63"\n---\n\n# REA\n', encoding="utf-8"
            )
            chk = run_sync("--root", str(root), "--upstream-dir", str(work), "--check", "--json")
            assert chk.returncode in (0, 1), f"{rel_path}: {chk.returncode} {chk.stderr}"
            return json.loads(chk.stdout)

        old_rep = count_via("src/cliCommandNames.ts", array_layout, "old")
        assert old_rep["primaryCliCommandCount"] == 3, old_rep
        new_rep = count_via("src/contracts/cliCommandNames.ts", contract_layout, "new")
        assert new_rep["primaryCliCommandCount"] is None, new_rep
        assert new_rep["mcpOnlyToolCount"] is None, new_rep
        # The file is found at the new path (not merely absent): the stderr warning must not appear.
        found = run_sync(
            "--root", str(root), "--upstream-dir", str(tmp / "layout-new"), "--check", "--json"
        )
        assert "not found" not in found.stderr, (
            "the contract-layout file exists at src/contracts/cliCommandNames.ts but the tool did not look there: "
            + found.stderr
        )

        # A missing names file is a warning plus `unknown`, never a silent 0.
        missing = tmp / "layout-missing"
        skill_ref = missing / ".agents" / "skills" / "reverse-engineer-anything"
        (skill_ref / "references").mkdir(parents=True)
        (missing / "package.json").write_text('{"name":"rea-agents","version":"9.9.9"}', encoding="utf-8")
        (skill_ref / "SKILL.md").write_text(
            '---\nname: reverse-engineer-anything\nmetadata:\n  version: "70"\n---\n\n# REA\n', encoding="utf-8"
        )
        miss = run_sync("--root", str(root), "--upstream-dir", str(missing), "--check", "--json")
        assert json.loads(miss.stdout)["primaryCliCommandCount"] is None, miss.stdout
        assert "cliCommandNames.ts not found" in miss.stderr, miss.stderr

        # The ledger records the unknown, and a second sync is idempotent (no perpetual drift).
        unk = run_sync("--root", str(root), "--upstream-dir", str(missing), "--json")
        assert unk.returncode == 0, unk.stderr
        source_text = (root / "skills" / "local" / "black-magic" / ".source").read_text(encoding="utf-8")
        assert "primary_cli_commands: unknown" in source_text, source_text
        again = run_sync("--root", str(root), "--upstream-dir", str(missing), "--check", "--json")
        assert again.returncode == 0 and json.loads(again.stdout)["status"] == "IN_SYNC", again.stdout

        # A 404 on the newest path falls back to the older one; any other HTTP error does not.
        import urllib.error

        calls: list[str] = []

        def fake_fetch(url: str) -> str:
            calls.append(url)
            if url.endswith("src/contracts/cliCommandNames.ts"):
                raise mod.NotFoundError("404")
            if url.endswith("src/cliCommandNames.ts"):
                return array_layout
            raise AssertionError(url)

        with unittest.mock.patch.object(mod, "fetch_text", side_effect=fake_fetch):
            got = None
            for rel in mod.CLI_NAMES_PATHS:
                try:
                    got = mod.parse_cli_counts(mod.fetch_text(f"https://x/{rel}"))
                    break
                except mod.NotFoundError:
                    continue
            assert got == (3, 0) and len(calls) == 2, (got, calls)
        with unittest.mock.patch(
            "urllib.request.urlopen",
            side_effect=urllib.error.HTTPError("https://x", 503, "unavailable", {}, None),
        ):
            try:
                mod.fetch_text("https://x")
                raise AssertionError("expected an error on HTTP 503")
            except mod.NotFoundError:
                raise AssertionError("HTTP 503 must not be treated as 'file not found'")
            except mod.SyncError:
                pass
        with unittest.mock.patch(
            "urllib.request.urlopen",
            side_effect=urllib.error.HTTPError("https://x", 404, "not found", {}, None),
        ):
            try:
                mod.fetch_text("https://x")
                raise AssertionError("expected NotFoundError on HTTP 404")
            except mod.NotFoundError:
                pass

        # 12. A sync is non-destructive for what the repo wrote by hand (found on 2026-11-23: a real
        # run would have rewritten the description and erased 4,681 characters of recheck notes).
        keep_root = tmp / "keep-root"
        keep_dir = keep_root / "skills" / "local" / "black-magic"
        (keep_dir / "references").mkdir(parents=True)
        (keep_dir / "references" / "dotfiles-integration.md").write_text("# Local\nKeep.\n", encoding="utf-8")
        keep_up = tmp / "keep-upstream"
        keep_skill = keep_up / ".agents" / "skills" / "reverse-engineer-anything"
        (keep_skill / "references").mkdir(parents=True)
        (keep_up / "package.json").write_text('{"name":"rea-agents","version":"7.0.0"}', encoding="utf-8")
        (keep_up / "src" / "contracts").mkdir(parents=True)
        (keep_up / "src" / "contracts" / "cliCommandNames.ts").write_text(contract_layout, encoding="utf-8")
        (keep_skill / "SKILL.md").write_text(
            '---\nname: reverse-engineer-anything\nmetadata:\n  version: "80"\n---\n\n# REA\n\nBody.\n', encoding="utf-8"
        )
        first = run_sync("--root", str(keep_root), "--upstream-dir", str(keep_up), "--json")
        assert first.returncode == 0, first.stderr
        fork_path = keep_dir / ".local-fork"
        # Hand-written notes live in .local-fork next to the tool's own keys.
        notes = (
            "recheck: 2026-11-22 — local note that a sync must never erase.\n"
            "  A continuation line, with an em dash and `code`.\n"
            "\n"
            "local-divergence 2026-11-22: a second kind of local key.\n"
            "description: 2026-10-30 skill-efficiency pass — re-apply after a refresh.\n"
            "\n"
            "\n"
        )
        fork_path.write_text(fork_path.read_text(encoding="utf-8") + notes, encoding="utf-8")
        # Upstream moves on; the tool refreshes its own keys and nothing else.
        (keep_up / "package.json").write_text('{"name":"rea-agents","version":"7.1.0"}', encoding="utf-8")
        (keep_skill / "SKILL.md").write_text(
            '---\nname: reverse-engineer-anything\nmetadata:\n  version: "81"\n---\n\n# REA\n\nBody 2.\n', encoding="utf-8"
        )
        second = run_sync("--root", str(keep_root), "--upstream-dir", str(keep_up), "--json")
        assert second.returncode == 0 and json.loads(second.stdout)["status"] == "UPDATED", second.stdout
        after = fork_path.read_text(encoding="utf-8")
        assert "rea_version: 7.1.0" in after and "skill_version: 81" in after, after
        assert after.endswith(notes), "the hand-written notes were not preserved byte for byte:\n" + after
        assert after.endswith("\n\n\n"), "trailing blank lines of the last note were trimmed: " + repr(after[-40:])
        assert "continuation line, with an em dash" in after, "an indented continuation line was dropped"
        assert after.count("recheck:") == 1, "a note must not be duplicated across syncs"
        third = run_sync("--root", str(keep_root), "--upstream-dir", str(keep_up), "--check", "--json")
        assert third.returncode == 0, "preserving notes made --check report perpetual drift: " + third.stdout
        # The frontmatter description is the repo's own constant, folded, and stable across syncs.
        skill_text = (keep_dir / "SKILL.md").read_text(encoding="utf-8")
        assert "description: >-\n  " + mod.BLACK_MAGIC_DESCRIPTION + "\n" in skill_text, skill_text[:400]
        assert "'" not in mod.BLACK_MAGIC_DESCRIPTION, "a single quote would break the folded scalar style"
        not_for = mod.BLACK_MAGIC_DESCRIPTION.find("Not owned")
        assert 0 < not_for < 240, not_for
        # The pin rule that tells the agent not to run an unpinned `npx -y ...@latest`.
        assert "rea-agents@latest" in skill_text and "run the version pinned" in skill_text, skill_text[-500:]

    print("rea-skill-sync-test: PASS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
