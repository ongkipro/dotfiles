#!/usr/bin/env bash
# The report must be able to say NO. A diagnostic that always exits 0 is a
# decoration, which is exactly the failure this repository just spent a day
# removing from omp-effective-routing-test.
set -euo pipefail
ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd)}"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/omp-runtime-report-test.XXXXXX")"; trap 'rm -rf "$TMP"' EXIT
REPORT="$ROOT/bin/omp-runtime-report"

fail() { echo "omp-runtime-report-test: FAIL: $1" >&2; exit 1; }

# A stub `omp` lets every branch be exercised without provider auth, so this
# runs in CI. The real binary is covered by using it below when present.
make_omp() {
  local dir="$1" config="$2" models="$3"
  mkdir -p "$dir"
  cat > "$dir/omp" <<EOF
#!/usr/bin/env bash
case "\$1 \$2" in
  "config list") cat '$config' ;;
  "models --kind") [ "\$3 \$4" = "all --json" ] || exit 1; cat '$models' ;;
  *) exit 1 ;;
esac
EOF
  chmod +x "$dir/omp"
}

cat > "$TMP/models.json" <<'EOF'
{"models":[
 {"provider":"p","id":"seer","thinking":["low","high"],"input":["text","image"]},
 {"provider":"p","id":"blind","thinking":["low","high"],"input":["text"]}
]}
EOF

healthy() {
  cat > "$1" <<'EOF'
{"modelRoles":{"value":{"vision":"p/seer:high","designer":"p/seer:high","task":"p/blind:high"}},
 "retry.fallbackChains":{"value":{"vision":["p/seer:low"]}},
 "task.agentModelOverrides":{"value":{"designer":"@designer"}},
 "task.maxConcurrency":{"value":4},
 "task.isolation.enabled":{"value":true}}
EOF
}

healthy "$TMP/ok.json"
make_omp "$TMP/bin-ok" "$TMP/ok.json" "$TMP/models.json"
PATH="$TMP/bin-ok:$PATH" "$REPORT" > "$TMP/ok.out" 2>&1 \
  || fail "a coherent config must exit 0"
grep -q 'omp-runtime-report: OK' "$TMP/ok.out" || fail "a healthy run must say so"
grep -q 'isolasi subagen.*true' "$TMP/ok.out" || fail "native isolation.enabled must be reported"
grep -q 'live request' "$TMP/ok.out" || fail "registry checks must not imply live inference"
# A non-visual model in a non-visual role is fine and must not be flagged.
grep -q 'MASALAH' "$TMP/ok.out" && fail "task on a text-only model is not a problem"

# A visual role that cannot see. This is the live defect on the Mac: its `vision`
# fallback takes no image, so a failed visual primary falls back to a model that
# is blind, and nothing else anywhere reports it.
sed 's|"vision":\["p/seer:low"\]|"vision":["p/blind:high"]|' "$TMP/ok.json" > "$TMP/blind.json"
make_omp "$TMP/bin-blind" "$TMP/blind.json" "$TMP/models.json"
set +e; PATH="$TMP/bin-blind:$PATH" "$REPORT" > "$TMP/blind.out" 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "a blind visual fallback must exit 1"
grep -q 'tidak menerima image' "$TMP/blind.out" || fail "the refusal must name the reason"

# A concrete effort the model does not declare must still fail. Native auto
# selects effort dynamically; it is not a missing concrete provider level.
sed 's|"task":"p/blind:high"|"task":"p/blind:ultra"|' "$TMP/ok.json" > "$TMP/level.json"
make_omp "$TMP/bin-level" "$TMP/level.json" "$TMP/models.json"
set +e; PATH="$TMP/bin-level:$PATH" "$REPORT" > "$TMP/level.out" 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "an undeclared thinking level must exit 1"
grep -q "level 'ultra' tidak dideklarasikan" "$TMP/level.out" || fail "the refusal must name the level"

sed 's|"task":"p/blind:high"|"task":"p/blind:auto","image":"p/painter"|' "$TMP/ok.json" > "$TMP/native.json"
cat > "$TMP/all.json" <<'EOF'
{"models":[
 {"provider":"p","id":"seer","kind":"chat","thinking":["low","high"],"input":["text","image"]},
 {"provider":"p","id":"blind","kind":"chat","thinking":["low","high"],"input":["text"]},
 {"provider":"p","id":"painter","kind":"image","input":["text"]},
 {"provider":"p","id":"tagged:latest","kind":"chat","thinking":["low","high"],"input":["text"]}
]}
EOF
make_omp "$TMP/bin-native" "$TMP/native.json" "$TMP/all.json"
PATH="$TMP/bin-native:$PATH" "$REPORT" > "$TMP/native.out" 2>&1 \
  || fail "native auto effort and bare image selector must pass"
sed 's|p/blind:auto|p/blind:off|' "$TMP/native.json" > "$TMP/off.json"
make_omp "$TMP/bin-off" "$TMP/off.json" "$TMP/all.json"
PATH="$TMP/bin-off:$PATH" "$REPORT" > "$TMP/off.out" 2>&1 \
  || fail "native off effort must pass"
sed 's|p/blind:auto|p/tagged:latest|' "$TMP/native.json" > "$TMP/tagged.json"
make_omp "$TMP/bin-tagged" "$TMP/tagged.json" "$TMP/all.json"
PATH="$TMP/bin-tagged:$PATH" "$REPORT" > "$TMP/tagged.out" 2>&1 \
  || fail "an exact model id containing a colon must pass"

# Native clamps valid effort on nonthinking models; unknown suffixes still fail.
sed 's/"thinking":\["low","high"\]/"thinking":[]/g' "$TMP/models.json" > "$TMP/plain-models.json"
make_omp "$TMP/bin-plain" "$TMP/ok.json" "$TMP/plain-models.json"
PATH="$TMP/bin-plain:$PATH" "$REPORT" > "$TMP/plain.out" 2>&1 \
  || fail "valid effort on a nonthinking model may clamp natively"
sed 's|p/blind:high|p/blind:garbage|' "$TMP/ok.json" > "$TMP/garbage.json"
make_omp "$TMP/bin-garbage" "$TMP/garbage.json" "$TMP/plain-models.json"
set +e; PATH="$TMP/bin-garbage:$PATH" "$REPORT" > "$TMP/garbage.out" 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "unknown suffix on a nonthinking model must fail"

# A selector this device cannot reach at all.
sed 's|"p/seer:high"|"p/absent:high"|' "$TMP/ok.json" > "$TMP/absent.json"
make_omp "$TMP/bin-absent" "$TMP/absent.json" "$TMP/models.json"
set +e; PATH="$TMP/bin-absent:$PATH" "$REPORT" > "$TMP/absent.out" 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "a selector missing from the registry must exit 1"

# No authenticated provider: CI. Selector validation cannot run, so it must be
# announced and must not be reported as health.
echo '{"models":[]}' > "$TMP/empty.json"
make_omp "$TMP/bin-empty" "$TMP/blind.json" "$TMP/empty.json"
PATH="$TMP/bin-empty:$PATH" "$REPORT" > "$TMP/empty.out" 2>&1 \
  || fail "an empty registry is not a failure, it is an unknown"
grep -q 'registry model kosong' "$TMP/empty.out" || fail "an empty registry must be announced"

grep -q 'omp-runtime-report: SKIP' "$TMP/empty.out" || fail "empty registry must end with SKIP"
if grep -q 'omp-runtime-report: OK' "$TMP/empty.out"; then
  fail "empty registry must never claim selector health"
fi

echo '{"models":[{"provider":"web","id":"public","kind":"search"}]}' > "$TMP/aux-only.json"
make_omp "$TMP/bin-aux" "$TMP/ok.json" "$TMP/aux-only.json"
PATH="$TMP/bin-aux:$PATH" "$REPORT" > "$TMP/aux.out" 2>&1 \
  || fail "auxiliary catalog without chat auth must skip"
grep -q 'omp-runtime-report: SKIP' "$TMP/aux.out" || fail "auxiliary catalog must not prove chat health"

# No omp at all.
mkdir -p "$TMP/bin-none"
PATH="$TMP/bin-none:/usr/bin:/bin" "$REPORT" 2>&1 | grep -q 'SKIP' \
  || fail "a machine without omp must skip, not fail"

echo 'omp-runtime-report-test: PASS'
