#!/usr/bin/env bash
# Run the design-tool behavioral suites; surface optional coverage gaps.
set -euo pipefail
ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd)}"
SCRIPTS="$ROOT/skills/local/design-taste/scripts"
partial=0
python3 "$SCRIPTS/test-contrast.py"
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
for suite in "$SCRIPTS/test-ui-ref.sh" "$ROOT/skills/local/admin-dashboard/scripts/test-admin-geometry.sh"; do
  if bash "$suite" >"$log" 2>&1; then
    cat "$log"
    if grep -q 'NOT CHECKED' "$log"; then
      echo "WARNING: browser fixtures in $(basename "$suite") were not checked; coverage is partial."
      partial=1
    fi
  else
    cat "$log" >&2
    exit 1
  fi
done
if [ "$partial" -ne 0 ] && [ "${DESIGN_TEST_REQUIRE_FULL:-0}" = 1 ]; then
  echo 'FAIL: full design-tool coverage required.' >&2
  exit 1
fi
echo 'design-tools-test: completed (see coverage warnings above, if any)'
