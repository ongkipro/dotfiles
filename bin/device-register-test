#!/usr/bin/env bash
# device-register writes devices/<host>.md and regenerates devices/README.md —
# files that get committed and read by every other machine. It has a --dry-run,
# so the write path can be proven without one.
set -uo pipefail
ROOT="${1:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
CMD="$ROOT/bin/device-register"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
f=0; ok(){ printf '  ✓ %s\n' "$1"; }; bad(){ echo "  FAIL $1" >&2; f=$((f+1)); }

# Point the subject at a scratch copy and DELETE the record it would write, so
# absence is the assertion. Measuring git status in $ROOT proved nothing twice
# over: the subject acted on ~/dotfiles regardless, and a rewrite producing
# byte-identical content is invisible to git anyway.
SCRATCH="$TMP/dotfiles"; mkdir -p "$SCRATCH"
git -C "$ROOT" archive HEAD | tar -x -C "$SCRATCH"
HOST="$(hostname -s 2>/dev/null || hostname)"
rm -f "$SCRATCH/devices/$HOST.md"
OUT="$(DOTFILES_DIR="$SCRATCH" bash "$CMD" --dry-run 2>&1)"; rc=$?
[ "$rc" -eq 0 ] && ok "--dry-run succeeds" || bad "--dry-run exited $rc"
[ ! -e "$SCRATCH/devices/$HOST.md" ] \
  && ok "--dry-run writes no device record" || bad "--dry-run created devices/$HOST.md"
[ "$(git -C "$ROOT" status --porcelain | sort)" = "$(git -C "$ROOT" status --porcelain | sort)" ] || true

for section in '## Identitas' '## Hardware' '## AI CLI' '## Profil Claude Code' '## Symlink dotfiles'; do
  printf '%s' "$OUT" | grep -qF "$section" && ok "it emits $section" || bad "missing section $section"
done

# The Claude-profile table is the part TASK-048's sibling work added so the
# registry answers "is this machine clean?" without logging in. It must report a
# verdict for each row, never a blank.
printf '%s' "$OUT" | sed -n '/## Profil Claude Code/,/## Symlink/p' | grep -qE 'Profil aktif' \
  && ok "the profile table names the active profile" || bad "no active-profile row"
printf '%s' "$OUT" | sed -n '/## Profil Claude Code/,/## Symlink/p' | grep -qE 'residu switcher' \
  && ok "the profile table reports switcher residue" || bad "no residue row"

# ── Fixture machine: a fake HOME, profile and PATH, so each verdict is decided
# by a known state instead of whatever this device happens to have installed.
FH="$TMP/home"; CC="$TMP/cc"; STUBS="$TMP/stubs"
mkdir -p "$FH/.config" "$CC" "$STUBS"
printf 'set -g mouse on\n' > "$TMP/tmux.conf"
ln -s "$TMP/tmux.conf" "$FH/.tmux.conf"                 # healthy symlink
ln -s "$TMP/gone" "$FH/.gitignore_global"               # dangling symlink
printf 'local\n' > "$FH/.config/starship.toml"          # plain file, not a link
mkdir -p "$FH/.claude-accounts"                         # retired switcher residue
printf '{"permissions":{"deny":["Read(**/.env)"]}}\n' > "$CC/settings.json"
printf '#!/bin/sh\nexit 0\n' > "$STUBS/claude"
printf '#!/bin/sh\nexit 0\n' > "$STUBS/ai-hooks-install"
chmod +x "$STUBS/claude" "$STUBS/ai-hooks-install"
fixture() { HOME="$FH" CLAUDE_CONFIG_DIR="$CC" PATH="$STUBS:$PATH" DOTFILES_DIR="$SCRATCH" bash "$CMD" "$@" 2>&1; }
row() { printf '%s\n' "$FOUT" | grep -F "$1"; }
FOUT="$(fixture --dry-run)"

row '`claude`' | grep -q 'terpasang' \
  && ok "a CLI on PATH is reported installed" || bad "an installed CLI was reported missing"
row 'tmux' | grep -q '✅ ok' \
  && ok "a healthy symlink is reported ok" || bad "a healthy symlink was not reported ok"
row 'gitignore global' | grep -q 'PUTUS' \
  && ok "a dangling symlink is reported broken" || bad "a dangling symlink was not reported broken"
row 'starship' | grep -q 'bukan symlink' \
  && ok "a plain file is reported as not a symlink" || bad "a plain file was not told apart from a link"
row 'lazygit' | grep -q 'belum ada' \
  && ok "an absent path is reported absent" || bad "an absent path was not reported absent"
row 'deny baca' | grep -q '✅' \
  && ok "a .env read deny is recognised" || bad "a settings.json with a .env deny was reported without one"
row 'hook canonical' | grep -q '✅' \
  && ok "a passing ai-hooks-install --check is reported installed" || bad "passing hook check not reported installed"
row 'residu switcher' | grep -q 'masih ada' \
  && ok "switcher residue is reported" || bad "switcher residue was reported clean"

printf '{"permissions":{"deny":[]}}\n' > "$CC/settings.json"
printf '#!/bin/sh\nexit 1\n' > "$STUBS/ai-hooks-install"
FOUT="$(fixture --dry-run)"
row 'deny baca' | grep -q '❌' \
  && ok "a settings.json without a .env deny is flagged" || bad "a missing .env deny went unflagged"
row 'hook canonical' | grep -q '❌' \
  && ok "a failing ai-hooks-install --check is flagged" || bad "a failing hook check went unflagged"
rm -f "$CC/settings.json"
FOUT="$(fixture --dry-run)"
row 'settings.json' | grep -q '❌' \
  && ok "a profile with no settings.json is flagged" || bad "a missing settings.json went unflagged"

# ── A checkout behind its upstream must be warned about before the index is
# regenerated from it. A local branch serves as the upstream: no network.
DREPO="$TMP/dotrepo"; mkdir -p "$DREPO"
g() { GIT_CONFIG_NOSYSTEM=1 HOME="$FH" git -C "$DREPO" -c user.name=t -c user.email=t@example.invalid "$@" >/dev/null 2>&1; }
g init -q; g commit -q --allow-empty -m base; g branch up; g checkout -q up
g commit -q --allow-empty -m ahead; g checkout -q -; g branch -q -u up
BOUT="$(HOME="$FH" CLAUDE_CONFIG_DIR="$CC" PATH="$STUBS:$PATH" DOTFILES_DIR="$DREPO" bash "$CMD" 2>&1)"
printf '%s\n' "$BOUT" | grep -q 'tertinggal 1 commit' \
  && ok "a checkout behind its upstream is warned about" || bad "no warning for a checkout 1 commit behind"
g branch -q -f up HEAD
BOUT="$(HOME="$FH" CLAUDE_CONFIG_DIR="$CC" PATH="$STUBS:$PATH" DOTFILES_DIR="$DREPO" bash "$CMD" 2>&1)"
printf '%s\n' "$BOUT" | grep -q 'tertinggal' \
  && bad "an up-to-date checkout was warned about" || ok "an up-to-date checkout is not warned about"

# The parallel-capacity section is read from ai-capacity: present with real numbers when the tool exists, absent when it does not.
if command -v ai-capacity >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
  printf '%s' "$OUT" | grep -qF '## Kapasitas AI paralel' && ok "capacity section present when ai-capacity exists" || bad "capacity section missing"
  printf '%s' "$OUT" | sed -n '/## Kapasitas AI paralel/,/## Symlink/p' | grep -qE '^\| Terminal AI \(nyaman / maksimum\) \| [0-9]+ / [0-9]+ \|' \
    && ok "capacity section carries numeric terminals" || bad "capacity terminals row malformed"
fi
# Absence is proven only when the generator otherwise succeeds: same PATH of symlinks, with python3 present and ai-capacity not.
mkpath() { local d="$1"; shift; mkdir -p "$d"; for c in bash git tar mktemp mkdir date hostname sed awk grep cut tr head tail sort uname cat ls readlink dirname basename id wc rm ln cp mv env python3 "$@"; do p="$(command -v "$c" 2>/dev/null)" && ln -sf "$p" "$d/$c"; done; }
mkpath "$TMP/nocap"
[ -x "$TMP/nocap/python3" ] && [ ! -e "$TMP/nocap/ai-capacity" ] && ok "fixture has python3 and no ai-capacity" || bad "fixture PATH is not what the test claims"
OUT2="$(PATH="$TMP/nocap" DOTFILES_DIR="$SCRATCH" bash "$CMD" --dry-run 2>&1)"; rc2=$?
[ "$rc2" -eq 0 ] && ok "generator succeeds without ai-capacity" || bad "generator exited $rc2 without ai-capacity"
printf '%s' "$OUT2" | grep -qF '## Hardware' && printf '%s' "$OUT2" | grep -qF '## Symlink dotfiles' && ok "record is complete without ai-capacity" || bad "record incomplete without ai-capacity"
printf '%s' "$OUT2" | grep -qF '## Kapasitas AI paralel' && bad "capacity section appeared without ai-capacity" || ok "capacity section absent without ai-capacity"

# A failing ai-capacity must not leave a section behind, even when it printed valid JSON first.
mkpath "$TMP/failcap"
printf '#!/bin/sh\necho %s\nexit 3\n' "'{\"terminals\":{\"comfortable\":9,\"max\":9},\"heavy\":{\"slots\":9,\"memory_max_gb\":9},\"subagents\":{\"total_target\":9},\"costs\":{\"source\":\"measured\"},\"degraded\":false}'" > "$TMP/failcap/ai-capacity"; chmod +x "$TMP/failcap/ai-capacity"
OUT3="$(PATH="$TMP/failcap" DOTFILES_DIR="$SCRATCH" bash "$CMD" --dry-run 2>&1)"; rc3=$?
[ "$rc3" -eq 0 ] && ok "generator survives a failing ai-capacity" || bad "generator exited $rc3 on a failing ai-capacity"
printf '%s' "$OUT3" | grep -qF '## Kapasitas AI paralel' && bad "failing ai-capacity left its section" || ok "failing ai-capacity leaves no section"
mkpath "$TMP/badjson"; printf '#!/bin/sh\necho not-json\n' > "$TMP/badjson/ai-capacity"; chmod +x "$TMP/badjson/ai-capacity"
OUT4="$(PATH="$TMP/badjson" DOTFILES_DIR="$SCRATCH" bash "$CMD" --dry-run 2>&1)"; rc4=$?
[ "$rc4" -eq 0 ] && ! printf '%s' "$OUT4" | grep -qF '## Kapasitas AI paralel' && ok "malformed ai-capacity output leaves no section" || bad "malformed output handled wrongly (rc=$rc4)"

[ "$f" -eq 0 ] && { echo "device-register-test: PASS"; exit 0; }
echo "device-register-test: $f case(s) failed" >&2; exit 1
