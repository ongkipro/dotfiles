#!/usr/bin/env bash
set -euo pipefail

battery_macos() {
  # Output: "🔋 85%" (discharging) / "⚡ 80%" (charging) / "🔌 100%" (charged)
  local batt_info pct status
  batt_info="$(pmset -g batt 2>/dev/null)"
  [ -z "$batt_info" ] && return

  # Cek AC vs Battery
  if echo "$batt_info" | grep -q "Now drawing from 'AC Power'"; then
    # Sedang charging atau full
    pct="$(echo "$batt_info" | grep -oE '[0-9]+%' | head -1)"
    if echo "$batt_info" | grep -q 'charging'; then
      printf '⚡ %s' "$pct"
    else
      printf '🔌 %s' "$pct"
    fi
  else
    # Battery power
    pct="$(echo "$batt_info" | grep -oE '[0-9]+%' | head -1)"
    # Estimasi waktu
    local remaining="$(echo "$batt_info" | grep -oE '[0-9]+:[0-9]+ remaining' | head -1)"
    if [ -n "$remaining" ]; then
      printf '🔋 %s (%s)' "$pct" "${remaining% remaining}"
    else
      printf '🔋 %s' "$pct"
    fi
  fi
}

battery_linux_sysfs() {
  local bat_dir
  bat_dir="$(find /sys/class/power_supply -maxdepth 1 -type d -name 'BAT*' 2>/dev/null | head -n 1 || true)"
  [ -n "$bat_dir" ] || return 1
  local cap status
  cap="$(cat "$bat_dir/capacity" 2>/dev/null || true)"
  status="$(cat "$bat_dir/status" 2>/dev/null || true)"
  [ -n "$cap" ] || return 1
  if [ -n "$status" ]; then
    printf '%s %s%%\n' "$status" "$cap"
  else
    printf '%s%%\n' "$cap"
  fi
}

battery_linux_upower() {
  command -v upower >/dev/null 2>&1 || return 1
  local dev
  dev="$(upower -e 2>/dev/null | grep -m1 battery || true)"
  [ -n "$dev" ] || return 1
  upower -i "$dev" 2>/dev/null | awk -F': *' '
    /^  state/ {state=$2}
    /^  percentage/ {pct=$2}
    END {
      if (pct != "") {
        if (state != "") printf "%s %s\n", state, pct;
        else print pct;
      }
    }
  '
}

case "$(uname -s)" in
  Darwin) battery_macos || true ;;
  Linux) battery_linux_sysfs || battery_linux_upower || true ;;
  *) true ;;
esac
