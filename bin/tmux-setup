#!/usr/bin/env bash
# tmux-setup: install + konfigurasi tmux LENGKAP dari nol.
# Cakupan: binary tmux, clipboard tool, link tmux.conf + tmux-clip, TPM, plugin.
# Idempotent (aman dijalankan ulang) & cross-platform (macOS + Linux).
# Bagian WAJIB bootstrap dotfiles — dipanggil dari install.sh & install-macos.sh.
set -euo pipefail

DOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
say()  { printf '==> %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }

OS="$(uname -s)"
SUDO=""
if [ "$(id -u)" -ne 0 ] && have sudo; then SUDO="sudo"; fi

# ── 1) Binary tmux ────────────────────────────────────────────────────────────
if have tmux; then
  say "tmux sudah ada: $(tmux -V)"
else
  say "Install tmux..."
  case "$OS" in
    Darwin)
      have brew || { echo "ERROR: Homebrew belum ada. Install dulu: https://brew.sh"; exit 1; }
      brew install tmux ;;
    Linux)
      if   have apt-get; then $SUDO apt-get update -qq && $SUDO apt-get install -y tmux
      elif have dnf;     then $SUDO dnf install -y tmux
      elif have pacman;  then $SUDO pacman -S --noconfirm tmux
      elif have zypper;  then $SUDO zypper install -y tmux
      else echo "ERROR: package manager tak dikenal — install tmux manual."; exit 1; fi ;;
    *) echo "ERROR: OS '$OS' tak didukung."; exit 1 ;;
  esac
  say "tmux terpasang: $(tmux -V)"
fi

# ── 2) Clipboard tool (dipakai bin/tmux-clip) ─────────────────────────────────
# macOS: pbcopy bawaan. Linux: butuh wl-clipboard (Wayland) atau xclip/xsel (X11).
if [ "$OS" = "Linux" ] && ! have wl-copy && ! have xclip && ! have xsel; then
  say "Install clipboard tool (wl-clipboard + xclip)..."
  if   have apt-get; then $SUDO apt-get install -y wl-clipboard xclip || true
  elif have dnf;     then $SUDO dnf install -y wl-clipboard xclip || true
  elif have pacman;  then $SUDO pacman -S --noconfirm wl-clipboard xclip || true
  elif have zypper;  then $SUDO zypper install -y wl-clipboard xclip || true
  fi
fi

# ── 3) Link config + helpers ─────────────────────────────────────────────────
mkdir -p "$HOME/.local/bin"
link_to_repo() {
  local src="$1" dst="$2"
  local backup
  if [ -L "$dst" ] && [ "$(readlink "$dst" 2>/dev/null)" = "$src" ]; then return 0; fi
  if [ -L "$dst" ]; then
    unlink "$dst"
  elif [ -e "$dst" ]; then
    backup="$dst.bak.$(date +%Y%m%d-%H%M%S 2>/dev/null || echo old).$$"
    mv "$dst" "$backup"
    say "backup $dst -> $backup"
  fi
  ln -s "$src" "$dst"; say "link $dst -> $src"
}
link_to_repo "$DOT/config/tmux.conf"  "$HOME/.tmux.conf"
link_to_repo "$DOT/bin/tmux-clip"     "$HOME/.local/bin/tmux-clip"
link_to_repo "$DOT/bin/tmux-battery"  "$HOME/.local/bin/tmux-battery"

# ── 4) TPM (Tmux Plugin Manager) ──────────────────────────────────────────────
TPM_DIR="$HOME/.tmux/plugins/tpm"
TPM_COMMIT="e261deb1b47614eed3400089ce7197dc68acc4eb"
TPM_READY=0
if [ ! -d "$TPM_DIR/.git" ]; then
  if [ -e "$TPM_DIR" ]; then
    echo "WARNING: TPM path ada tetapi bukan Git checkout; plugin dilewati: $TPM_DIR" >&2
  else
    say "Clone TPM..."
    if ! git clone -q https://github.com/tmux-plugins/tpm "$TPM_DIR"; then
      echo "WARNING: TPM tidak dapat di-clone; bootstrap tmux lanjut tanpa plugin." >&2
    fi
  fi
fi

if [ -d "$TPM_DIR/.git" ]; then
  TPM_HEAD=""
  if TPM_HEAD="$(git -C "$TPM_DIR" rev-parse HEAD 2>/dev/null)" &&
     [ "$TPM_HEAD" = "$TPM_COMMIT" ]; then
    TPM_READY=1
  else
    if ! git -C "$TPM_DIR" cat-file -e "$TPM_COMMIT^{commit}" 2>/dev/null; then
      say "Fetch TPM pin $TPM_COMMIT..."
      if ! git -C "$TPM_DIR" fetch -q origin "$TPM_COMMIT"; then
        echo "WARNING: TPM pin tidak dapat diambil; checkout yang belum terverifikasi tidak akan dijalankan." >&2
      fi
    fi
    if git -C "$TPM_DIR" cat-file -e "$TPM_COMMIT^{commit}" 2>/dev/null; then
      if git -C "$TPM_DIR" checkout -q --detach "$TPM_COMMIT"; then
        TPM_READY=1
      else
        echo "WARNING: TPM pin tersedia tetapi checkout gagal; plugin dilewati." >&2
      fi
    fi
  fi
fi

# ── 5) Install/aktifkan plugin (non-interaktif) ───────────────────────────────
if [ "$TPM_READY" -eq 1 ]; then
  say "TPM pinned: $TPM_COMMIT"
  say "Install/update plugin tmux (sensible, yank, resurrect, continuum, prefix-highlight, open)..."
  if ! "$TPM_DIR/bin/install_plugins"; then
    echo "WARNING: TPM plugin install/update gagal; lihat output di atas." >&2
  fi
  if ! "$TPM_DIR/bin/clean_plugins"; then
    echo "WARNING: TPM plugin cleanup gagal; lihat output di atas." >&2
  fi
else
  echo "WARNING: TPM pin tidak siap; bootstrap tmux lanjut dan plugin dilewati." >&2
fi

# ── 6) Reload kalau ada server tmux yang jalan ────────────────────────────────
if tmux info >/dev/null 2>&1; then
  if tmux source-file "$HOME/.tmux.conf"; then
    say "Server tmux aktif → config di-reload."
  else
    echo "WARNING: config tmux gagal di-reload; server tetap berjalan." >&2
  fi
fi

say "tmux SIAP. Mulai sesi: 'tmux'. Di dalam tmux: prefix (Ctrl+a) lalu r = reload, I = update plugin."
