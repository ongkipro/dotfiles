#!/usr/bin/env bash
# dev-ready — the cheap gate that runs BEFORE autonomous development starts.
#
# Every expensive failure this repository has recorded shares one shape: work
# began before anyone checked whether the machine could finish it. A missing
# provider, an un-discoverable test command, an uninitialised ledger, or a dirty
# worktree overlapping the task surface are all knowable in under two seconds,
# and all of them are discovered mid-run instead — where the cost is a wasted
# route, a contaminated boundary, or a silent downgrade to a model that cannot
# do the job.
#
# Read-only. It repairs nothing and installs nothing. A blocker here is a
# precise instruction to the caller, never a reason to proceed anyway.
#
# Usage: dev-ready [--runtime auto|claude|codex|agy|pi|omp] [REPO]
set -uo pipefail

runtime=auto; repo_arg=.; repo_seen=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --runtime) [ "$#" -ge 2 ] || { echo 'dev-ready: --runtime needs a value'; exit 2; }; runtime="$2"; shift 2 ;;
    --help|-h) echo 'Usage: dev-ready [--runtime auto|claude|codex|agy|pi|omp] [REPO]'; exit 0 ;;
    --*) echo "dev-ready: unknown option: $1"; exit 2 ;;
    *) [ "$repo_seen" -eq 0 ] || { echo 'dev-ready: only one repository allowed'; exit 2; }; repo_arg="$1"; repo_seen=1; shift ;;
  esac
done
case "$runtime" in auto|claude|codex|agy|pi|omp) ;; *) echo "dev-ready: unsupported runtime: $runtime"; exit 2 ;; esac
REPO="$(cd "$repo_arg" 2>/dev/null && pwd -P)" || { echo "dev-ready: no such directory: $repo_arg"; exit 2; }
ROOT="${DOTFILES_DIR:-$HOME/dotfiles}"
# One definition of the toolchain path, shared with every other owned command.
. "$ROOT/bin/_toolchain-path.sh"
toolchain_export_path


blockers=(); degraded=(); lines=()
pass()  { lines+=("- $1: PASS${2:+ ($2)}"); }
soft()  { lines+=("- $1: degraded ($2)"); degraded+=("$1: $2"); }
skip()  { lines+=("- $1: not required${2:+ ($2)}"); }
fail()  { lines+=("- $1: BLOCKED ($2)"); blockers+=("$1: $2"); }

# macOS reaches TMPDIR through /var, a symlink to /private/var, so `pwd` and
# `git rev-parse --show-toplevel` name the same directory differently and every
# temporary repository was reported as nested inside itself. Compare physical
# paths on both sides.
git_repo() { local t; t="$(git -C "$REPO" rev-parse --show-toplevel 2>/dev/null)" || return 1
  [ -n "$t" ] && (cd "$t" && pwd -P); }

# 1. repo authority — the repository, not personal memory, must own its truth.
top="$(git_repo)"
if [ -z "$top" ]; then
  fail "repo authority" "not a git repository; repository contracts cannot be owned"
elif [ "$top" != "$REPO" ]; then
  fail "repo authority" "$REPO is inside $top, not its root; run from the repository root"
else
  # A contract document need not sit at the root: this repository keeps its own
  # under config/ai/. Ask Git what the repository tracks rather than guessing at
  # a layout — an empty or contract-less repository still fails, which is the
  # only property that matters here.
  owned="$(git -C "$REPO" ls-files 2>/dev/null \
    | grep -E '(^|/)(AGENTS|PRD|ARCHITECTURE)\.md$|^docs/spec/' | head -3 | tr '\n' ' ')"
  owned="${owned% }" 
  if [ -n "$owned" ]; then pass "repo authority" "$owned"
  else fail "repo authority" "no AGENTS.md, PRD.md, ARCHITECTURE.md or docs/spec; nothing in-repo defines the contract"; fi
fi

# 2. task queue — a queue with no actionable entry cannot select a next task.
if [ ! -f "$REPO/TASKS.md" ]; then
  fail "task queue" "no TASKS.md; there is no canonical execution queue"
elif ! grep -qE '^#{2,4} +[A-Z]+-[0-9]+' "$REPO/TASKS.md"; then
  fail "task queue" "TASKS.md has no '### TASK-nnn' entry; nothing is selectable"
else
  n="$(grep -cE '^#{2,4} +[A-Z]+-[0-9]+' "$REPO/TASKS.md" | tr -d " ")"
  pass "task queue" "$n entries"
fi

# 3. Runtime identity is not provider health. Native child markers are hints,
# not credentials; conflicting/inherited markers remain explicitly ambiguous.
# Sources: code.claude.com/docs/en/env-vars (CLAUDECODE),
# github.com/openai/codex/blob/main/codex-rs/protocol/src/shell_environment.rs.
runtime_cmd() {
  case "$1" in
    claude) printf '%s' "${DEV_READY_CLAUDE:-claude}" ;;
    codex) printf '%s' "${DEV_READY_CODEX:-codex}" ;;
    agy) printf '%s' "${DEV_READY_AGY:-agy}" ;;
    pi) printf '%s' "${DEV_READY_PI:-pi}" ;;
    omp) printf '%s' "${DEV_READY_OMP:-omp}" ;;
  esac
}
# All native probes have a deadline; never spawn inference or inspect auth/session
# files. Suppress failed probe output because it may contain environment details.
probe() {
  python3 - "$@" <<'PYPROBE'
import subprocess, sys
try:
    result = subprocess.run(sys.argv[1:], capture_output=True, text=True, timeout=8)
    if result.returncode: sys.exit(1)
    print(result.stdout, end="")
except (OSError, subprocess.TimeoutExpired):
    sys.exit(1)
PYPROBE
}
if [ "$runtime" = auto ]; then
  hints=()
  [ -n "${CODEX_THREAD_ID:-}" ] && hints+=(codex)
  [ "${CLAUDECODE:-}" = 1 ] && hints+=(claude)
  if [ "${#hints[@]}" -eq 1 ]; then
    runtime="${hints[0]}"
  elif [ "${#hints[@]}" -gt 1 ]; then
    runtime=unknown
  else
    available=()
    for candidate in claude codex agy pi omp; do
      type -P "$(runtime_cmd "$candidate")" >/dev/null 2>&1 && available+=("$candidate")
    done
    if [ "${#available[@]}" -eq 1 ]; then runtime="${available[0]}"; else runtime=unknown; fi
  fi
fi
if [ "$runtime" = unknown ]; then
  soft "runtime identity" "unknown or ambiguous; select --runtime explicitly"
  soft "runtime routing" "unverified until runtime is selected"
  soft "required providers" "unverified; no runtime selected"
else
  cli="$(runtime_cmd "$runtime")"
  if ! type -P "$cli" >/dev/null 2>&1; then
    fail "runtime executable" "$runtime executable not on PATH"
  elif version="$(probe "$cli" --version)" && [ -n "$version" ]; then
    pass "runtime executable" "$runtime: $(printf '%s' "$version" | head -1 | cut -c1-100)"
  else
    fail "runtime executable" "$runtime --version failed, timed out or returned no version"
  fi
  # Existence proves wiring only, not that a running model consumed the context.
  case "$runtime" in
    claude) native_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"; instruction="$native_dir/CLAUDE.md"; native_skills="$native_dir/skills" ;;
    codex) native_dir="${CODEX_HOME:-$HOME/.codex}"; instruction="$native_dir/AGENTS.md"; native_skills="$native_dir/skills" ;;
    agy) instruction="$HOME/.gemini/GEMINI.md"; native_skills="$HOME/.gemini/config/skills" ;;
    pi) instruction="$ROOT/config/ai/context/pi.md"; native_skills="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/skills" ;;
    omp) native_dir="${PI_CODING_AGENT_DIR:-$HOME/.omp/agent}"; instruction="$native_dir/AGENTS.md"; native_skills="$native_dir/skills" ;;
  esac
  if [ -s "$instruction" ]; then
    pass "runtime instructions" "file exists; consumption unverified"
  else
    soft "runtime instructions" "shared instructions missing; run ai-memory-link"
  fi
  [ "$runtime" != pi ] || soft "runtime instructions injection" "Pi wrapper injection must be checked in the calling shell"
  if [ -d "$native_skills" ] && find -L "$native_skills" -mindepth 2 -maxdepth 2 -name SKILL.md -print -quit 2>/dev/null | grep -q .; then
    pass "runtime skill discovery" "entrypoints exist; consumption unverified"
  else
    soft "runtime skill discovery" "no native skill entrypoints found; run skill-update"
  fi
  if [ "$runtime" = omp ]; then
    if [ ! -x "$ROOT/bin/omp-runtime-report" ]; then
      soft "runtime routing" "omp-runtime-report not installed; routing is unverified"
    elif out="$(probe "$ROOT/bin/omp-runtime-report" 2>&1)"; then
      if printf '%s\n' "$out" | grep -q '^omp-runtime-report: OK'; then pass "runtime routing"
      else soft "runtime routing" "report skipped or produced no OK evidence; routing unverified"; fi
    else
      fail "runtime routing" "OMP report failed or timed out; run omp-runtime-report for details"
    fi
    # Only OMP owns this catalog API. One provider is a valid native setup:
    # redundancy is optional, not a prerequisite for doing useful work.
    provs="$(probe "$cli" models --json | python3 -c 'import json,sys
try: print(",".join(sorted({m["provider"] for m in json.load(sys.stdin)["models"] if m.get("kind", "chat") == "chat"})))
except Exception: print("")' 2>/dev/null)"
    if [ -n "$provs" ]; then pass "required providers" "$provs (catalog only; inference unverified)"
    else soft "required providers" "chat catalog unavailable or empty; provider health unverified"; fi
  else
    soft "runtime routing" "$runtime native settings and model route unverified; no OMP dependency"
    soft "required providers" "$runtime provider health unverified; version is not authentication evidence"
  fi
fi

# 5. skills discovery — the routing table is worthless if its cells name skills
#    that are not installed. ai-policy-lint owns that graph; reuse it.
if [ -d "$ROOT/skills/local" ]; then
  n="$(find "$ROOT/skills/local" -mindepth 2 -maxdepth 2 -name SKILL.md | wc -l | tr -d " ")"
  if [ "$n" -gt 0 ]; then pass "skills discovery" "$n owned skills"
  else fail "skills discovery" "$ROOT/skills/local has no SKILL.md; no owned capability is discoverable"; fi
else
  fail "skills discovery" "$ROOT/skills/local missing; owned capabilities have no source"
fi

# 6. delivery ledger — only where the repository opted in. Absent .delivery/ in a
#    repository that never used it is not a blocker; a broken one is. Reuse the
#    canonical verifier rather than maintaining a second partial parser here.
if [ -d "$REPO/.delivery" ]; then
  cur="$REPO/.delivery/current.json"
  run_count="$(find "$REPO/.delivery" -type f -name 'RUN-*.jsonl' 2>/dev/null | wc -l | tr -d ' ')"
  if [ ! -f "$cur" ] && [ "$run_count" -eq 0 ]; then
    fail "delivery ledger" ".delivery/ exists with no current.json and no runs; the chain is uninitialised, not clean"
  elif [ ! -f "$cur" ]; then
    fail "delivery ledger" "current.json missing while $run_count run file(s) exist; the chain head is lost"
  else
    ledger="${DEV_READY_LEDGER:-$ROOT/bin/delivery-ledger}"
    if [ ! -x "$ledger" ]; then
      fail "delivery ledger" "delivery-ledger verifier is unavailable"
    elif out="$("$ledger" --repo "$REPO" verify 2>&1)"; then
      pass "delivery ledger" "hash chain, state authority and snapshots verified"
    else
      reason="$(printf '%s\n' "$out" | grep -m1 '^  - ' | sed 's/^  - //' | cut -c1-120)"
      [ -n "$reason" ] || reason="$(printf '%s\n' "$out" | tail -n 1 | cut -c1-120)"
      fail "delivery ledger" "verification failed; the chain cannot be read or extended ($reason)"
    fi
  fi
else
  skip "delivery ledger" "repository does not use it"
fi

# 7. test commands discovered — "verify it" needs a command that exists. Naming
#    the file is not enough: package.json with no scripts block verifies nothing.
cmds=""
if [ -f "$REPO/package.json" ]; then
  s="$(python3 -c 'import json,sys
try: print(",".join(list(json.load(open(sys.argv[1]))["scripts"])[:6]))
except Exception: print("")' "$REPO/package.json" 2>/dev/null)"
  [ -n "$s" ] && cmds="package.json: $s"
fi
[ -z "$cmds" ] && [ -f "$REPO/Makefile" ] && grep -qE '^(test|check):' "$REPO/Makefile" && cmds="Makefile"
[ -z "$cmds" ] && [ -f "$REPO/pyproject.toml" ] \
  && grep -qE '\[tool\.(pytest|tox|hatch|poetry)|\[project\.scripts\]|pytest' "$REPO/pyproject.toml" \
  && cmds="pyproject.toml"
if [ -z "$cmds" ]; then
  for t in "$REPO"/bin/*-test; do [ -x "$t" ] && { cmds="bin/*-test"; break; }; done
fi
if [ -n "$cmds" ]; then pass "test commands discovered" "$cmds"
else fail "test commands discovered" "no package.json scripts, Makefile test target, pyproject, or bin/*-test; nothing can verify a change"; fi

# 8. browser runner — required only when the repository contains browser-visible
#    surface. Claiming a change works without opening it is the failure this
#    guards; claiming a browser is needed for a shell repo is noise.
if git -C "$REPO" ls-files 2>/dev/null | grep -qE '\.(tsx|jsx|vue|svelte|astro|css|scss|html)$'; then
  # The browser list is overridable so the failure path is testable: PATH cannot
  # un-find a binary, and a check whose failure branch never runs is not a check.
  b="$(command -v ${DEV_READY_BROWSERS:-google-chrome chromium chromium-browser} 2>/dev/null | head -1)"
  # macOS ships browsers as .app bundles that are never on PATH, so a PATH-only
  # probe reports every Mac as unable to verify anything visual. Found by running
  # this on the Mac, which is the entire argument for running it there. The
  # bundle search is skipped when the caller names the browsers, or the test's
  # failure case could never fail on a machine that has Chrome installed.
  if [ -z "$b" ] && [ -z "${DEV_READY_BROWSERS:-}" ]; then
    for app in "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
               "/Applications/Chromium.app/Contents/MacOS/Chromium" \
               "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge" \
               "$HOME/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"; do
      [ -x "$app" ] && { b="$app"; break; }
    done
  fi
  if [ -n "$b" ]; then pass "browser runner" "$b"
  else fail "browser runner" "repository has browser-visible files but no chrome/chromium; visual claims would be unverifiable"; fi
else
  skip "browser runner" "no browser-visible files"
fi

# 9. dirty worktree boundary — pre-existing work is not a blocker, but starting
#    without knowing it is. The boundary refuses a run whose surface overlaps it.
if [ -n "$top" ]; then
  dirty="$(git -C "$REPO" status --porcelain 2>/dev/null | grep -v '^.. \.delivery/' | wc -l | tr -d ' ')"
  if [ "$dirty" -eq 0 ]; then pass "dirty worktree boundary" "clean"
  else soft "dirty worktree boundary" "$dirty path(s) already dirty; declare --accept-dirty or avoid them"; fi
else
  lines+=("- dirty worktree boundary: BLOCKED (no git repository)")
fi

if [ "${#blockers[@]}" -eq 0 ]; then echo "PROJECT READY"; else echo "PROJECT NOT READY"; fi
printf '%s\n' "${lines[@]}"
if [ "${#degraded[@]}" -gt 0 ]; then
  echo
  echo "Degraded — usable, but route accordingly:"
  printf '  %s\n' "${degraded[@]}"
fi
if [ "${#blockers[@]}" -gt 0 ]; then
  echo
  echo "Blockers — resolve or route to a valid fallback. Do not downgrade the task:"
  printf '  %s\n' "${blockers[@]}"
  exit 1
fi
exit 0
