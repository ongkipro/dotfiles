#!/usr/bin/env python3
"""diff-risk — deterministic Git diff risk classifier.

Classifies the current change set into R0-R4. When --base is supplied, the
change set is everything from that commit to the current working tree, plus
untracked files. Invalid repositories or refs fail closed.

Exit codes:
  0 classification produced
  1 invalid repository/ref or Git failure
"""
from __future__ import annotations

import argparse
import json
from pathlib import Path
import re
import subprocess
import sys

RISK_ORDER = {"R0": 0, "R1": 1, "R2": 2, "R3": 3, "R4": 4}

PATH_RULES = [
    (r"(?:^|/)(?:auth|oauth|sessions?|login|passwords?|permissions?|rbac|acl)(?:/|\.|$)|(?:jwt|token)", "Authentication / Authorization", "R3"),
    (r"(?:payment|stripe|billing|checkout|money|currency|transaction)", "Payment / Financial", "R3"),
    (r"(?:^|/)(?:migrations?|schema)(?:/|\.|$)|(?:prisma|drizzle)|\.sql$", "Database Schema / Migration", "R3"),
    (r"(?:^|/)\.env(?:\..*)?$|(?:secret|vault|private[_-]?key|cert)", "Secrets / Cryptography", "R4"),
    (r"(?:^|/)(?:package\.json|pyproject\.toml|go\.mod|Cargo\.toml|composer\.json)$", "Dependency / Build Manifest", "R2"),
    (r"(?:^|/)(?:pnpm-lock\.yaml|package-lock\.json|yarn\.lock|bun\.lockb?|Cargo\.lock|composer\.lock)$", "Dependency Lockfile", "R2"),
    (r"(?:^|/)\.github/workflows/|(?:docker|terraform|coolify|k8s|kubernetes|nginx|caddy|vultr)", "CI / Infrastructure / Deployment", "R3"),
]

DOC_EXTENSIONS = {".md", ".txt", ".rst", ".png", ".jpg", ".jpeg", ".svg", ".webp", ".gif"}


def git(args: list[str], cwd: Path, stdin: str | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args], cwd=cwd, input=stdin, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, text=True, check=False,
    )


def require_git_repo(repo: Path) -> None:
    res = git(["rev-parse", "--is-inside-work-tree"], repo)
    if res.returncode != 0 or res.stdout.strip() != "true":
        raise RuntimeError(f"{repo} is not a Git work tree")


def resolve_commit(repo: Path, ref: str) -> str:
    res = git(["rev-parse", "--verify", f"{ref}^{{commit}}"], repo)
    if res.returncode != 0:
        raise RuntimeError(f"invalid base ref: {ref}")
    return res.stdout.strip()


def head_exists(repo: Path) -> bool:
    return git(["rev-parse", "--verify", "HEAD^{commit}"], repo).returncode == 0


def empty_tree(repo: Path) -> str:
    res = git(["hash-object", "-t", "tree", "--stdin"], repo, "")
    if res.returncode != 0:
        raise RuntimeError(res.stderr.strip() or "could not create empty-tree hash")
    return res.stdout.strip()


def lines_from_diff(diff_text: str) -> tuple[int, int]:
    added = deleted = 0
    for line in diff_text.splitlines():
        if line.startswith("+") and not line.startswith("+++"):
            added += 1
        elif line.startswith("-") and not line.startswith("---"):
            deleted += 1
    return added, deleted


def analyze_diff(repo: Path, base_ref: str | None = None) -> dict:
    require_git_repo(repo)
    has_head = head_exists(repo)
    status = git(["status", "--porcelain"], repo)
    if status.returncode != 0:
        raise RuntimeError(status.stderr.strip() or "git status failed")
    dirty = bool(status.stdout.strip())

    base = None
    if base_ref:
        base = resolve_commit(repo, base_ref)
    elif not dirty:
        if has_head and git(["rev-parse", "--verify", "HEAD~1^{commit}"], repo).returncode == 0:
            base = resolve_commit(repo, "HEAD~1")
        elif has_head:
            base = empty_tree(repo)

    if base:
        diff = git(["diff", "--no-ext-diff", "--no-textconv", base], repo)
        names = git(["diff", "--name-only", "--no-ext-diff", base], repo)
    elif has_head:
        diff = git(["diff", "--no-ext-diff", "--no-textconv", "HEAD"], repo)
        names = git(["diff", "--name-only", "--no-ext-diff", "HEAD"], repo)
    else:
        diff = subprocess.CompletedProcess([], 0, "", "")
        names = subprocess.CompletedProcess([], 0, "", "")

    if diff.returncode not in (0, 1):
        raise RuntimeError(diff.stderr.strip() or "git diff failed")
    if names.returncode != 0:
        raise RuntimeError(names.stderr.strip() or "git diff --name-only failed")

    untracked = git(["ls-files", "--others", "--exclude-standard"], repo)
    if untracked.returncode != 0:
        raise RuntimeError(untracked.stderr.strip() or "git ls-files failed")

    files = []
    seen = set()
    for path in [*names.stdout.splitlines(), *untracked.stdout.splitlines()]:
        path = path.strip()
        if path and path not in seen:
            seen.add(path)
            files.append(path)

    added, deleted = lines_from_diff(diff.stdout)
    total = added + deleted

    flagged: list[dict[str, str]] = []
    path_risk = "R0"
    for path in files:
        for pattern, label, minimum in PATH_RULES:
            if re.search(pattern, path, re.IGNORECASE):
                flagged.append({"path": path, "reason": label, "minimumRisk": minimum})
                if RISK_ORDER[minimum] > RISK_ORDER[path_risk]:
                    path_risk = minimum

    doc_only = bool(files) and all(Path(path).suffix.lower() in DOC_EXTENSIONS for path in files)

    if not files:
        size_risk, rationale = "R0", "No changed or untracked files detected."
    elif doc_only and len(files) <= 5 and path_risk == "R0":
        size_risk, rationale = "R0", "Small documentation or static-asset change set."
    elif len(files) > 10 or total > 500:
        size_risk, rationale = "R3", f"Large change set ({len(files)} files, {total} tracked line changes)."
    elif len(files) > 3 or total > 150:
        size_risk, rationale = "R2", f"Moderate change set ({len(files)} files, {total} tracked line changes)."
    else:
        size_risk, rationale = "R1", f"Bounded change set ({len(files)} files, {total} tracked line changes)."

    risk = max((size_risk, path_risk), key=lambda value: RISK_ORDER[value])
    if path_risk != "R0" and RISK_ORDER[path_risk] >= RISK_ORDER[size_risk]:
        labels = sorted({entry["reason"] for entry in flagged if entry["minimumRisk"] == path_risk})
        rationale = f"Sensitive path class requires at least {path_risk}: {', '.join(labels)}."

    lane_map = {
        "R0": ("volume / cheap-dev", "@smol"),
        "R1": ("volume / cheap-dev", "@task"),
        "R2": ("precision lane", "@slow"),
        "R3": ("precision + independent review", "@slow / @advisor-xhigh"),
        "R4": ("judgment lane / architect review", "@advisor-max / @architect"),
    }
    lane, role = lane_map[risk]

    return {
        "risk": risk, "rationale": rationale, "baseRef": base_ref,
        "resolvedBase": base, "dirtyWorkingTree": dirty,
        "filesCount": len(files), "linesAdded": added, "linesDeleted": deleted,
        "totalLineChanges": total, "flaggedReasons": flagged, "files": files,
        "recommendedLane": lane, "recommendedRole": role,
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--base", dest="base_ref")
    parser.add_argument("target", nargs="?", default=".")
    parser.add_argument("legacy_base", nargs="?")
    args = parser.parse_args()

    target = Path(args.target).expanduser()
    base_ref = args.base_ref or args.legacy_base
    if not target.is_dir() and args.target != "." and not args.legacy_base and not args.base_ref:
        base_ref = args.target
        target = Path.cwd()

    repo = target.resolve()
    try:
        data = analyze_diff(repo, base_ref)
    except Exception as exc:
        if args.json:
            print(json.dumps({"error": str(exc)}))
        else:
            print(f"diff-risk: ERROR: {exc}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(data, indent=2))
        return 0

    print(f"diff-risk: Risk Level {data['risk']}")
    print("-" * 60)
    print(f"Rationale:         {data['rationale']}")
    print(f"Base:              {data['baseRef'] or '(auto)'}")
    print(f"Working tree:      {'dirty' if data['dirtyWorkingTree'] else 'clean'}")
    print(f"Files Modified:    {data['filesCount']}")
    print(f"Lines Changed:     +{data['linesAdded']} / -{data['linesDeleted']} (tracked total {data['totalLineChanges']})")
    print(f"Recommended Lane:  {data['recommendedLane']} ({data['recommendedRole']})")
    if data["flaggedReasons"]:
        print("\nFlagged Risk Factors:")
        for entry in data["flaggedReasons"]:
            print(f"  - {entry['minimumRisk']} {entry['reason']}: {entry['path']}")
    if data["files"]:
        print("\nModified Files:")
        for path in data["files"][:15]:
            print(f"  - {path}")
        if len(data["files"]) > 15:
            print(f"  ... and {len(data['files']) - 15} more files")
    print("-" * 60)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
