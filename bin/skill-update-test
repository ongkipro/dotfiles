#!/usr/bin/env bash
# Bait test for skills/agents-bin/skill-update.
#
# Why this exists: skill-update carries a HARD SAFETY guard (see its comment
# block) that refuses to touch any target resolving INSIDE the skill source tree.
# That guard is not paranoia — it replaces a version that, when a target base was
# already a whole-dir symlink into the source, `mv`-ed every real skill directory
# inside dotfiles to *.backup.<ts> and left self-referencing symlinks behind.
# It already destroyed data once. It had zero tests.
#
# So: this plants a target that resolves inside the source and asserts
# skill-update REFUSES — exits non-zero, and moves nothing.
#
# SAFETY: this never runs against the real ~/dotfiles or the real $HOME. It
# builds a throwaway source tree + a throwaway $HOME under mktemp -d, copies
# skill-update into the same layout it expects (<dir>/../local), and runs it
# there. If the guard ever regresses, the damage lands in the temp dir.
set -euo pipefail

REPO="${1:-$HOME/dotfiles}"
REAL="$REPO/skills/agents-bin/skill-update"
fail=0

[ -f "$REAL" ] || { echo "ERROR: skill-update tidak ditemukan di $REAL" >&2; exit 1; }

# pwd -P: on macOS mktemp may return /var/... while physical resolution uses
# /private/var/... . Compare physical paths or every assert lies.
TMP="$(cd "$(mktemp -d "${TMPDIR:-/tmp}/skill-update-test.XXXXXX")" && pwd -P)"
cleanup() { chmod -R u+w "$TMP" 2>/dev/null || true; rm -rf "$TMP"; }
trap cleanup EXIT

# Mirror the layout skill-update derives SRC from: <script>/../local
FAKE_HOME="$TMP/home"
SRC="$TMP/skills/local"
mkdir -p "$TMP/skills/agents-bin" "$SRC/demo-skill" \
  "$FAKE_HOME/.claude" "$FAKE_HOME/.pi/agent" "$FAKE_HOME/.codex/skills/.system"
cp "$REAL" "$TMP/skills/agents-bin/skill-update"
chmod +x "$TMP/skills/agents-bin/skill-update"
echo '# demo' > "$SRC/demo-skill/SKILL.md"

run_it() { HOME="$FAKE_HOME" bash "$TMP/skills/agents-bin/skill-update" 2>&1; }

echo "1. healthy targets must be linked (baseline: the script still works)"
out="$(run_it || true)"
if [ -L "$FAKE_HOME/.pi/agent/skills" ] \
   && [ "$(readlink "$FAKE_HOME/.pi/agent/skills")" = "$SRC" ] \
   && [ -d "$FAKE_HOME/.claude/skills" ] && [ ! -L "$FAKE_HOME/.claude/skills" ] \
   && [ "$(readlink "$FAKE_HOME/.claude/skills/demo-skill")" = "$SRC/demo-skill" ]; then
  echo "   ✓ linked (Pi directory link, Claude per-skill links)"
else
  echo "   ✗ FAIL: skill-update tidak membuat symlink yang benar"
  printf '%s\n' "$out" | sed 's/^/     /'
  fail=1
fi

echo "2. re-run must be a silent no-op (idempotent, and NOT a guard trip)"
out="$(run_it || true)"
if printf '%s\n' "$out" | grep -q '^  ok  ' \
   && [ "$(readlink "$FAKE_HOME/.pi/agent/skills")" = "$SRC" ] \
   && ! printf '%s\n' "$out" | grep -q 'migrate'; then
  echo "   ✓ no-op"
else
  echo "   ✗ FAIL: run kedua bukan no-op — guard salah menangkap kasus normal"
  printf '%s\n' "$out" | sed 's/^/     /'
  fail=1
fi

echo "2b. old Claude directory link migrates; Claude-synced content leaves the source"
rm -rf "$FAKE_HOME/.claude/skills"
ln -sfn "$SRC" "$FAKE_HOME/.claude/skills"
mkdir -p "$SRC/synced/bucket/cloud-skill"
echo '# cloud' > "$SRC/synced/bucket/cloud-skill/SKILL.md"
out="$(run_it || true)"
if [ ! -L "$FAKE_HOME/.claude/skills" ] \
   && [ -f "$FAKE_HOME/.claude/skills/synced/bucket/cloud-skill/SKILL.md" ] \
   && [ ! -e "$SRC/synced" ] \
   && [ "$(readlink "$FAKE_HOME/.claude/skills/demo-skill")" = "$SRC/demo-skill" ] \
   && [ -z "$(find -L "$FAKE_HOME/.pi/agent/skills" -path '*synced*' -name SKILL.md)" ]; then
  echo "   ✓ migrated; synced/ is Claude-only"
else
  echo "   ✗ FAIL: Claude migration wrong"
  printf '%s\n' "$out" | sed 's/^/     /'
  find "$FAKE_HOME/.claude" "$SRC" -maxdepth 3 | sed 's/^/     /'
  fail=1
fi

echo "2c. Claude writing a new runtime entry stays out of the source"
mkdir -p "$FAKE_HOME/.claude/skills/claude-own"
echo '# own' > "$FAKE_HOME/.claude/skills/claude-own/SKILL.md"
out="$(run_it || true)"
if [ ! -e "$SRC/claude-own" ] && [ -f "$FAKE_HOME/.claude/skills/claude-own/SKILL.md" ]; then
  echo "   ✓ runtime-owned entry preserved, source untouched"
else
  echo "   ✗ FAIL: runtime entry leaked or was removed"
  fail=1
fi
rm -rf "$FAKE_HOME/.claude/skills/claude-own"

echo "2d. interrupted migration: Claude root already real, synced/ still in source, name clash"
mkdir -p "$SRC/synced/b2/again" && echo '# again' > "$SRC/synced/b2/again/SKILL.md"
out="$(run_it || true)"
if [ ! -e "$SRC/synced" ] \
   && [ -f "$FAKE_HOME/.claude/skills/synced/bucket/cloud-skill/SKILL.md" ] \
   && ls -d "$FAKE_HOME/.claude/skills"/synced.migrated.* >/dev/null 2>&1; then
  echo "   ✓ evacuated without overwriting Claude's copy"
else
  echo "   ✗ FAIL: synced/ left in source or Claude copy overwritten"
  printf '%s\n' "$out" | sed 's/^/     /'
  fail=1
fi

echo "3. Codex adapter must preserve .system and expose owned skills"
if [ -d "$FAKE_HOME/.codex/skills/.system" ] \
   && [ -L "$FAKE_HOME/.codex/skills/demo-skill" ] \
   && [ "$(readlink "$FAKE_HOME/.codex/skills/demo-skill")" = "$SRC/demo-skill" ]; then
  echo "   ✓ Codex native root preserved"
else
  echo "   ✗ FAIL: Codex adapter did not preserve .system or link owned skill"
  fail=1
fi

echo "4. removed owned skill must disappear from Codex deterministically"
mv "$SRC/demo-skill" "$SRC/removed-skill"
out="$(run_it || true)"
if [ ! -e "$FAKE_HOME/.codex/skills/demo-skill" ] \
   && [ -L "$FAKE_HOME/.codex/skills/removed-skill" ]; then
  echo "   ✓ stale owned link removed"
else
  echo "   ✗ FAIL: Codex reconciliation left stale state"
  printf '%s\n' "$out" | sed 's/^/     /'
  fail=1
fi
mv "$SRC/removed-skill" "$SRC/demo-skill"
run_it >/dev/null

echo "5. target resolving INSIDE the source must be REFUSED"
# This is the shape that ate the skills directory: the target points at a path
# *within* SRC, so the "move it aside" branch would mv a real skill out of the
# source tree. Guard must abort before reaching that branch.
rm -rf "$FAKE_HOME/.claude/skills"
ln -sfn "$SRC/demo-skill" "$FAKE_HOME/.claude/skills"

set +e
out="$(run_it)"
rc=$?
set -e

if [ "$rc" -eq 0 ]; then
  echo "   ✗ FAIL: skill-update EXIT 0 untuk target di dalam source — guard mati"
  fail=1
elif ! printf '%s\n' "$out" | grep -q 'Refusing to touch it'; then
  echo "   ✗ FAIL: exit non-zero tapi bukan karena guard:"
  printf '%s\n' "$out" | sed 's/^/     /'
  fail=1
else
  echo "   ✓ refused (exit $rc)"
fi

echo "6. and it must have moved NOTHING inside the source"
# The actual damage signature of the old bug: skills renamed to *.backup.<ts>.
if [ -f "$SRC/demo-skill/SKILL.md" ] \
   && [ -z "$(find "$SRC" "$FAKE_HOME/.claude" -maxdepth 2 -name '*.backup.*' 2>/dev/null)" ]; then
  echo "   ✓ source utuh"
else
  echo "   ✗ FAIL: source tree DIUBAH — bug perusak data itu kembali:"
  find "$SRC" "$FAKE_HOME/.claude" -maxdepth 2 2>/dev/null | sed 's/^/     /'
  fail=1
fi

echo
[ "$fail" -eq 0 ] && echo "skill-update-test: OK" || { echo "skill-update-test: FAILED"; exit 1; }
