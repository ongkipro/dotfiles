#!/usr/bin/env bash
# secrets-env — read the canonical development secrets without spilling them.
#
# One file holds every development credential: ~/.config/ai-local/secrets.env,
# mode 0600, outside every git repository. Before it existed the same values
# lived in five places — two project files and three under ai-local — and two of
# those were group- and world-readable.
#
# The rule this tool exists to enforce: secrets reach a child process and stop
# there. Sourcing the file into an interactive shell would put every credential
# into the environment of everything you launch for the rest of the session,
# including processes that dump their environment on crash. `run` scopes the
# injection to one command, which is the same discipline the pi() and omp()
# shell wrappers already use for the 9Router key.
#
# `list` prints names only. Values leave this tool through exactly two doors:
# `get`, which you ask for by name, and `run`, which hands them to one child.
set -euo pipefail

SECRETS="${SECRETS_ENV_FILE:-$HOME/.config/ai-local/secrets.env}"

usage() {
  cat <<'EOF'
usage: secrets-env <command>

  list              variable names and their group — never values
  get <VAR>         one value on stdout, for scripting
  run -- <cmd>...   run <cmd> with the secrets in its environment only
  check             audit permissions, location, and leftover copies

The file is $HOME/.config/ai-local/secrets.env unless SECRETS_ENV_FILE is set.
EOF
}

die() { printf 'secrets-env: %s\n' "$*" >&2; exit 1; }

file_mode() {
  local path="$1" mode
  if mode="$(stat -c '%a' "$path" 2>/dev/null)"; then
    :
  elif mode="$(stat -f '%Lp' "$path" 2>/dev/null)"; then
    :
  else
    return 1
  fi
  case "$mode" in
    [0-7][0-7][0-7]|[0-7][0-7][0-7][0-7]) printf '%s\n' "$mode" ;;
    *) return 1 ;;
  esac
}

require_file() {
  [ -f "$SECRETS" ] || die "no secrets file at $SECRETS"
  # A readable-by-others secrets file is a finding, not a warning to scroll past.
  local mode
  mode="$(file_mode "$SECRETS")" \
    || die "cannot determine permissions for $SECRETS with GNU or BSD stat; refusing to read it"
  case "$mode" in
    600|400) ;;
    *) die "$SECRETS is mode $mode; expected 600. Fix it: chmod 600 '$SECRETS'" ;;
  esac
  # Mode bits are not the whole permission story. A POSIX ACL can grant another
  # user read access while the numeric mode still reports 600 — `ls -l` marks it
  # with a trailing `+`. Checking only the mode would print OK over a readable
  # file, which is the failure this check exists to prevent.
  case "$(ls -ld "$SECRETS" 2>/dev/null | cut -c11)" in
    '+') die "$SECRETS carries a POSIX ACL that may grant access beyond its mode. Inspect it: getfacl '$SECRETS'" ;;
  esac
}

cmd_list() {
  require_file
  local group="(ungrouped)" line
  while IFS= read -r line; do
    case "$line" in
      '# --- '*)
        group=${line#'# --- '}; group=${group%% -*}
        printf '\n%s\n' "$group" ;;
      [A-Za-z_]*=*)
        printf '  %s\n' "${line%%=*}" ;;
    esac
  done < "$SECRETS"
  printf '\n%s variable(s). Values are not printed by list — use `get <VAR>`.\n' \
    "$(grep -cE '^[A-Za-z_][A-Za-z0-9_]*=' "$SECRETS")"
}

cmd_get() {
  require_file
  [ $# -eq 1 ] || die 'get takes exactly one variable name'
  local want="$1" line
  while IFS= read -r line; do
    line=${line%$'\r'}
    case "$line" in
      "$want"=*) printf '%s\n' "${line#*=}"; return 0 ;;
    esac
  done < "$SECRETS"
  die "no such variable: $want"
}

cmd_run() {
  require_file
  [ $# -gt 0 ] || die 'run needs a command; use: secrets-env run -- npm run dev'
  # Read the file as data, never as shell.
  #
  # The obvious implementation is `set -a; . "$SECRETS"` — and it is wrong. That
  # makes bash *interpret* every value: a key containing `$` expands as a
  # variable, backticks execute, and under `set -u` an unbound expansion aborts
  # the run. A secrets loader must never let a secret become code. Caught here
  # on the first real run, on a value containing `$`.
  #
  # The export builtin receives each NAME=VALUE as one quoted argument, so the
  # value stays literal. Export in this short-lived process, then exec the child
  # directly: no intermediate `env NAME=VALUE ...` process exposes credentials
  # in its argument vector.
  local -a vars=()
  local line name seen=""
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}          # a CRLF file otherwise glues \r onto every value
    case "$line" in
      ''|'#'*) continue ;;
      [A-Za-z_]*=*) ;;
      *) continue ;;
    esac
    name=${line%%=*}
    # A value can no longer become code — but a NAME still can. `env FOO=bar cmd`
    # happily sets BASH_ENV, LD_PRELOAD, or PATH, and the child then executes
    # whatever they point at before running a line of its own. Demonstrated with
    # a working BASH_ENV payload during review. The file is data, so treat a
    # name that steers an interpreter as corruption, not configuration.
    case "$name" in
      PATH|IFS|ENV|BASH_ENV|SHELLOPTS|BASHOPTS|PS4|CDPATH|GLOBIGNORE \
      |LD_*|DYLD_*|NODE_OPTIONS|PERL5LIB|PERL5OPT|PYTHONPATH|PYTHONSTARTUP \
      |RUBYOPT|GEM_PATH|GIT_SSH_COMMAND|GIT_EXTERNAL_DIFF|GIT_PAGER)
        die "refusing to inject '$name': that name steers an interpreter, so it is code, not a credential. Remove it from $SECRETS." ;;
    esac
    # A duplicate is a merge error. `get` returns the first and `env` keeps the
    # last, so silently allowing one means the value you audit is not the value
    # the child receives.
    case " $seen " in
      *" $name "*) die "'$name' is defined more than once in $SECRETS; remove the duplicate" ;;
    esac
    seen="$seen $name"
    vars+=("$line")
  done < "$SECRETS"
  [ ${#vars[@]} -gt 0 ] || die "no variables found in $SECRETS"
  for line in "${vars[@]}"; do
    export "$line"
  done
  exec "$@"
}

cmd_check() {
  local rc=0
  if [ -f "$SECRETS" ]; then
    local mode
    if ! mode="$(file_mode "$SECRETS")"; then
      printf '  FAIL  cannot determine permissions for %s with GNU or BSD stat\n' "$SECRETS"
      rc=1
    elif [ "$(ls -ld "$SECRETS" 2>/dev/null | cut -c11)" = '+' ]; then
      printf '  FAIL  %s carries a POSIX ACL; mode %s understates who can read it\n' "$SECRETS" "$mode"; rc=1
    elif [ "$mode" = 600 ] || [ "$mode" = 400 ]; then
      printf '  OK    %s is mode %s, no ACL\n' "$SECRETS" "$mode"
    else
      printf '  FAIL  %s is mode %s; expected 600\n' "$SECRETS" "$mode"; rc=1
    fi
  else
    printf '  FAIL  no secrets file at %s\n' "$SECRETS"; return 1
  fi

  # A secrets file inside a git work tree is one `git add -A` from being
  # committed. It must live outside every repository, not merely be gitignored.
  if git -C "$(dirname "$SECRETS")" rev-parse --show-toplevel >/dev/null 2>&1; then
    local top; top=$(git -C "$(dirname "$SECRETS")" rev-parse --show-toplevel)
    if git -C "$top" check-ignore -q "$SECRETS" 2>/dev/null; then
      printf '  OK    inside git work tree %s, but ignored there\n' "$top"
    else
      printf '  FAIL  inside git work tree %s and NOT ignored\n' "$top"; rc=1
    fi
  else
    printf '  OK    outside any git work tree\n'
  fi

  # The old scattered copies are the real risk now: same values, weaker modes,
  # and no reason to still exist.
  local found=0 p
  for p in "$HOME/.config/ai-local/cmsads-env-backup/.env" \
           "$HOME/.config/ai-local/cmsads-env-backup/.dev.vars" \
           "$HOME/.config/ai-local/coolify.env" \
           "$HOME/.config/ai-local/credentials/9router-remote-key"; do
    [ -f "$p" ] || continue
    found=1
    local m
    if ! m="$(file_mode "$p")"; then
      printf '  FAIL  cannot determine permissions for superseded copy: %s\n' "$p"; rc=1
    elif [ "$m" = 600 ] || [ "$m" = 400 ]; then
      printf '  note  superseded copy still present (mode %s): %s\n' "$m" "$p"
    else
      printf '  FAIL  superseded copy is mode %s, readable beyond you: %s\n' "$m" "$p"; rc=1
    fi
  done
  [ "$found" -eq 0 ] && printf '  OK    no superseded copies left\n'

  [ "$rc" -eq 0 ] && printf 'secrets-env: OK\n' || printf 'secrets-env: %s problem(s)\n' "$rc"
  return "$rc"
}

case "${1:-}" in
  list)  shift; cmd_list "$@" ;;
  get)   shift; cmd_get "$@" ;;
  run)   shift; [ "${1:-}" = -- ] && shift; cmd_run "$@" ;;
  check) shift; cmd_check "$@" ;;
  -h|--help|help|'') usage ;;
  *) usage >&2; exit 2 ;;
esac
