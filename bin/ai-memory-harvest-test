#!/usr/bin/env bash
set -euo pipefail
ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd)}"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/ai-memory-harvest-test.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
TMP="$(cd "$TMP" && pwd -P)"
REPO="$TMP/repo"; DOT="$TMP/dot"; INBOX="$TMP/inbox"; mkdir -p "$REPO/.delivery/learning" "$REPO/.delivery/runs" "$DOT/config/ai/memory" "$DOT/config/ai/project-memory" "$DOT/bin"
cp "$ROOT/bin/delivery-learning" "$DOT/bin/delivery-learning"
cat > "$DOT/config/ai/memory/existing.md" <<'EOF'
Prefer small deterministic changes and verify the owning boundary before adding retries.
EOF
python3 - "$REPO/.delivery/learning/RUN-test.json" <<'PY'
import hashlib,json,sys
p=sys.argv[1]
d={'schemaVersion':1,'runId':'RUN-test','capturedAt':'2026-08-15T00:00:00Z','scope':'methodology','recommendedDestination':'skill','reusabilityScore':95,'lesson':{'title':'Retry boundary discipline','symptom':'Retries obscured the first failure.','rootCause':'Retry logic was outside the owning integration boundary.','invariant':'Keep retry behavior at the owning integration boundary and retain deterministic failure evidence.','fix':'Move retries to the integration adapter.','check':'Run the regression and inspect the first failure.'},'provenance':{'task':'TASK-1','requirement':'REQ-1','risk':'R1','worker':'coder','model':'model-a','sourceHead':'abc123','finishedAt':'2026-08-15T00:03:00Z','verification':[{'check':'unit','status':'PASS','detail':'ok'}]}}
d['signalHash']=hashlib.sha256(json.dumps(d,sort_keys=True,separators=(',',':'),ensure_ascii=True).encode()).hexdigest(); json.dump(d,open(p,'w'),indent=2,sort_keys=True)
PY
python3 - "$REPO/.delivery/runs/RUN-test.jsonl" <<'PY'
import hashlib,json,sys
events=[
 {'schemaVersion':1,'eventId':'1','time':'2026-08-15T00:00:00Z','type':'run_started','runId':'RUN-test','state':'IMPLEMENTING','head':'abc123','task':'TASK-1','requirement':'REQ-1','risk':'R1','worker':'coder','model':'model-a'},
 {'schemaVersion':1,'eventId':'2','time':'2026-08-15T00:02:00Z','type':'verification','runId':'RUN-test','state':'VERIFYING','head':'abc123','check':'unit','status':'PASS','detail':'ok'},
 {'schemaVersion':1,'eventId':'3','time':'2026-08-15T00:03:00Z','type':'run_finished','runId':'RUN-test','state':'DONE','head':'abc123','result':'PASS','detail':'done'},
]
previous=None
with open(sys.argv[1],'w') as f:
 for event in events:
  event['prevEventHash']=previous
  event['eventHash']=hashlib.sha256(json.dumps(event,sort_keys=True,separators=(',',':'),ensure_ascii=True).encode()).hexdigest()
  previous=event['eventHash']; f.write(json.dumps(event,sort_keys=True,separators=(',',':'))+'\n')
PY
python3 "$ROOT/bin/ai-memory-harvest" --repo "$REPO" --run RUN-test --dotfiles "$DOT" --inbox "$INBOX" --json > "$TMP/out.json"
python3 - "$TMP/out.json" "$INBOX/learning-RUN-test.md" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); text=open(sys.argv[2]).read(); r=p['results'][0]; assert r['created'] is True; assert r['recommendation']=='skill'; assert r['reusabilityScore']==95; assert 'source_run: RUN-test' in text; assert '### Provenance' in text
PY
python3 "$ROOT/bin/ai-memory-harvest" --repo "$REPO" --run RUN-test --dotfiles "$DOT" --inbox "$INBOX" --json > "$TMP/out2.json"
python3 - "$TMP/out2.json" <<'PY'
import json,sys
assert json.load(open(sys.argv[1]))['results'][0]['created'] is False
PY
# Concurrent harvest publishes one complete candidate, never a partial overwrite.
cp "$INBOX/learning-RUN-test.md" "$TMP/candidate.backup"
rm "$INBOX/learning-RUN-test.md"
python3 "$ROOT/bin/ai-memory-harvest" --repo "$REPO" --run RUN-test --dotfiles "$DOT" --inbox "$INBOX" --json > "$TMP/concurrent1.json" &
first_pid=$!
python3 "$ROOT/bin/ai-memory-harvest" --repo "$REPO" --run RUN-test --dotfiles "$DOT" --inbox "$INBOX" --json > "$TMP/concurrent2.json" &
second_pid=$!
wait "$first_pid"; wait "$second_pid"
python3 - "$TMP/concurrent1.json" "$TMP/concurrent2.json" "$INBOX" <<'PYTEST'
import json,stat,sys
from pathlib import Path
created=[json.load(open(p))['results'][0]['created'] for p in sys.argv[1:3]]
assert sorted(created)==[False,True]
inbox=Path(sys.argv[3]); candidate=inbox/'learning-RUN-test.md'
assert stat.S_IMODE(candidate.stat().st_mode)==0o600
assert '### Regression check' in candidate.read_text()
assert not list(inbox.glob('.learning-*.tmp'))
PYTEST
# Existing foreign content is preserved even if it occupies the expected name.
rm "$INBOX/learning-RUN-test.md"
printf 'precious\n' > "$TMP/victim.md"
ln -s "$TMP/victim.md" "$INBOX/learning-RUN-test.md"
if python3 "$ROOT/bin/ai-memory-harvest" --repo "$REPO" --run RUN-test --dotfiles "$DOT" --inbox "$INBOX" >/dev/null 2>&1; then echo 'FAIL symlink candidate accepted' >&2; exit 1; fi
[ "$(cat "$TMP/victim.md")" = precious ]
unlink "$INBOX/learning-RUN-test.md"
printf 'unrelated review candidate\n' > "$INBOX/learning-RUN-test.md"
if python3 "$ROOT/bin/ai-memory-harvest" --repo "$REPO" --run RUN-test --dotfiles "$DOT" --inbox "$INBOX" >/dev/null 2>&1; then echo 'FAIL candidate provenance collision accepted' >&2; exit 1; fi
[ "$(cat "$INBOX/learning-RUN-test.md")" = 'unrelated review candidate' ]
cp "$TMP/candidate.backup" "$INBOX/learning-RUN-test.md"
cp -R "$REPO" "$TMP/other-repo"
if python3 "$ROOT/bin/ai-memory-harvest" --repo "$TMP/other-repo" --run RUN-test --dotfiles "$DOT" --inbox "$INBOX" >/dev/null 2>&1; then echo 'FAIL cross-repository candidate collision accepted' >&2; exit 1; fi
cmp "$TMP/candidate.backup" "$INBOX/learning-RUN-test.md"
# Private storage must never chmod or write through an existing foreign path.
mkdir "$TMP/public-inbox"; chmod 755 "$TMP/public-inbox"
ln -s "$TMP/public-inbox" "$TMP/inbox-link"
ln -s "$TMP/public-inbox" "$TMP/inbox-parent"
for unsafe_inbox in "$TMP/public-inbox" "$TMP/inbox-link" "$TMP/inbox-parent/new-inbox"; do
  if python3 "$ROOT/bin/ai-memory-harvest" --repo "$REPO" --run RUN-test --dotfiles "$DOT" --inbox "$unsafe_inbox" >/dev/null 2>&1; then echo 'FAIL unsafe inbox accepted' >&2; exit 1; fi
done
python3 - "$TMP/public-inbox" <<'PYTEST'
import stat,sys
from pathlib import Path
p=Path(sys.argv[1]); assert stat.S_IMODE(p.stat().st_mode)==0o755; assert list(p.iterdir())==[]
PYTEST
rm "$INBOX/learning-RUN-test.md"
cp "$TMP/candidate.backup" "$TMP/hardlink-source.md"
ln "$TMP/hardlink-source.md" "$INBOX/learning-RUN-test.md"
if python3 "$ROOT/bin/ai-memory-harvest" --repo "$REPO" --run RUN-test --dotfiles "$DOT" --inbox "$INBOX" >/dev/null 2>&1; then echo 'FAIL hardlink candidate accepted' >&2; exit 1; fi
cmp "$TMP/candidate.backup" "$TMP/hardlink-source.md"
unlink "$INBOX/learning-RUN-test.md"
cp "$TMP/candidate.backup" "$INBOX/learning-RUN-test.md"
chmod 644 "$INBOX/learning-RUN-test.md"
if python3 "$ROOT/bin/ai-memory-harvest" --repo "$REPO" --run RUN-test --dotfiles "$DOT" --inbox "$INBOX" >/dev/null 2>&1; then echo 'FAIL public candidate accepted' >&2; exit 1; fi
python3 - "$INBOX/learning-RUN-test.md" <<'PYTEST'
import stat,sys
from pathlib import Path
assert stat.S_IMODE(Path(sys.argv[1]).stat().st_mode)==0o644
PYTEST
chmod 600 "$INBOX/learning-RUN-test.md"
# A path traversal selector is not an alternative source of verified evidence.
if python3 "$ROOT/bin/ai-memory-harvest" --repo "$REPO" --run ../outside --dotfiles "$DOT" --inbox "$INBOX" >/dev/null 2>&1; then echo 'FAIL traversal run accepted' >&2; exit 1; fi
rm "$DOT/bin/delivery-learning"
set +e
python3 "$ROOT/bin/ai-memory-harvest" --repo "$REPO" --run RUN-test --dotfiles "$DOT" --inbox "$INBOX" >/dev/null 2>&1
rc=$?
set -e
[ "$rc" -eq 1 ] || { echo 'harvest must fail when source verifier is unavailable' >&2; exit 1; }
echo 'ai-memory-harvest-test: PASS'
