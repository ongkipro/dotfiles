#!/usr/bin/env python3
"""Behavioral scheduler checks using isolated HOME, SQLite and local Git only."""
import fcntl
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import signal
import sqlite3
import subprocess
import tempfile
import unittest

ROOT = Path(__file__).resolve().parent.parent
COMMAND = ROOT / 'bin/ai-schedule'


class SchedulerTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix='ai-schedule-test-')
        self.addCleanup(self.temp.cleanup)
        self.base = Path(self.temp.name).resolve()
        self.home = self.base / 'home'
        self.home.mkdir()
        self.state = self.base / 'state'
        self.repo = self.base / 'repo'
        self.repo.mkdir()
        self.env = dict(os.environ, HOME=str(self.home), GIT_CONFIG_GLOBAL=os.devnull,
                        GIT_CONFIG_NOSYSTEM='1', GIT_AUTHOR_NAME='Fixture',
                        GIT_COMMITTER_NAME='Fixture', GIT_AUTHOR_EMAIL='fixture@example.invalid',
                        GIT_COMMITTER_EMAIL='fixture@example.invalid')
        self.git('init', '-q')
        (self.repo / 'tracked.txt').write_text('before\n')
        self.git('add', 'tracked.txt')
        self.git('commit', '-qm', 'fixture')

    def git(self, *args):
        return subprocess.run(['git', '-C', str(self.repo), *args], env=self.env,
                              capture_output=True, check=True)

    def call(self, *args, success=True):
        result = subprocess.run([str(COMMAND), '--state-dir', str(self.state), *args],
                                env=self.env, capture_output=True, text=True, timeout=10)
        if success:
            self.assertEqual(result.returncode, 0, result.stderr)
        else:
            self.assertNotEqual(result.returncode, 0, result.stdout)
        return result

    def add(self, name='audit', paused=False):
        return self.call('add', name, '--kind', 'repo-status', '--repo', str(self.repo),
                         '--every', '3600', *(['--paused'] if paused else []))

    def database(self):
        return sqlite3.connect(self.state / 'schedule.sqlite3')

    def test_help_is_read_only(self):
        result = subprocess.run([str(COMMAND), '--help'], env=self.env, capture_output=True)
        self.assertEqual(result.returncode, 0)
        self.assertFalse(self.state.exists())
        self.assertFalse((self.home / '.config').exists())

    def test_lifecycle_due_deduplication_and_read_only_target(self):
        self.add(paused=True)
        self.assertEqual(json.loads(self.call('tick').stdout), [])
        self.call('run', 'audit', success=False)
        (self.repo / 'tracked.txt').write_text('changed\n')
        before = self.git('status', '--porcelain').stdout
        head = self.git('rev-parse', 'HEAD').stdout
        self.call('resume', 'audit')
        report = json.loads(self.call('tick').stdout)[0]
        self.assertEqual(report['status'], 'PASS')
        self.assertEqual(report['result']['changedTrackedFiles'], 1)
        self.assertEqual(json.loads(self.call('tick').stdout), [])
        self.assertEqual(self.git('status', '--porcelain').stdout, before)
        self.assertEqual(self.git('rev-parse', 'HEAD').stdout, head)
        self.assertEqual((self.repo / 'tracked.txt').read_text(), 'changed\n')
        self.call('pause', 'audit')
        self.call('run', 'audit', success=False)
        self.call('remove', 'audit')
        self.assertEqual(json.loads(self.call('list').stdout), [])
        self.assertEqual(len(json.loads(self.call('history').stdout)), 1)

    def test_commands_and_intervals_are_not_arbitrary(self):
        for kind in ('shell', 'deploy', 'python'):
            self.call('add', 'unsafe', '--kind', kind, '--repo', str(self.repo),
                      '--every', '3600', success=False)
        self.call('add', 'bad;touch-marker', '--kind', 'repo-status', '--repo', str(self.repo),
                  '--every', '3600', success=False)
        self.call('add', 'audit', '--kind', 'repo-status', '--repo', str(self.repo),
                  '--every', '0', success=False)
        self.add()
        self.add_duplicate()
        self.assertEqual(len(json.loads(self.call('list').stdout)), 1)

    def add_duplicate(self):
        self.call('add', 'audit', '--kind', 'repo-status', '--repo', str(self.repo),
                  '--every', '3600', success=False)

    def test_tampered_job_is_denied_without_blocking_other_jobs(self):
        self.add('bad')
        self.add('good')
        with self.database() as db:
            db.execute("UPDATE jobs SET kind='shell' WHERE name='bad'")
        results = json.loads(self.call('tick', success=False).stdout)
        self.assertEqual({row['name']: row['status'] for row in results}, {'bad': 'FAIL', 'good': 'PASS'})

    def test_private_state_and_unknown_database_refusal(self):
        self.add()
        self.assertEqual(self.state.stat().st_mode & 0o777, 0o700)
        self.assertEqual((self.state / 'schedule.sqlite3').stat().st_mode & 0o777, 0o600)
        other = self.base / 'other'
        other.mkdir(mode=0o700)
        with sqlite3.connect(other / 'schedule.sqlite3') as db:
            db.execute('CREATE TABLE precious(value TEXT)')
        (other / 'schedule.sqlite3').chmod(0o600)
        self.state = other
        self.call('list', success=False)
        with self.database() as db:
            self.assertEqual(db.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall(), [('precious',)])
        empty = self.base / 'foreign-empty-database'
        empty.mkdir(mode=0o700)
        with sqlite3.connect(empty / 'schedule.sqlite3') as db:
            db.execute('PRAGMA user_version=7')
        (empty / 'schedule.sqlite3').chmod(0o600)
        self.state = empty
        self.call('list', success=False)
        with self.database() as db:
            self.assertEqual(db.execute('PRAGMA user_version').fetchone()[0], 7)
            self.assertEqual(db.execute('PRAGMA application_id').fetchone()[0], 0)

    def test_foreign_paths_and_permissions_are_preserved(self):
        foreign = self.base / 'foreign'
        foreign.mkdir(mode=0o755)
        (foreign / 'precious').write_text('untouched')
        self.state.symlink_to(foreign, target_is_directory=True)
        self.call('list', success=False)
        self.assertEqual(foreign.stat().st_mode & 0o777, 0o755)
        self.assertEqual((foreign / 'precious').read_text(), 'untouched')
        self.state.unlink()
        self.state.mkdir(mode=0o755)
        self.call('list', success=False)
        self.assertEqual(self.state.stat().st_mode & 0o777, 0o755)
        self.state.chmod(0o700)
        (self.state / 'schedule.sqlite3').symlink_to(foreign / 'precious')
        self.call('list', success=False)
        self.assertEqual((foreign / 'precious').read_text(), 'untouched')
        parent = self.base / 'redirected-parent'
        parent.symlink_to(foreign, target_is_directory=True)
        self.state = parent / 'child'
        self.call('list', success=False)
        self.assertFalse((foreign / 'child').exists())
        self.assertEqual(foreign.stat().st_mode & 0o777, 0o755)

    def test_lock_serializes_checks_and_abandoned_attempts_are_visible(self):
        self.add()
        with (self.state / '.lock').open('a') as handle:
            fcntl.flock(handle, fcntl.LOCK_EX)
            result = self.call('run', 'audit', success=False)
            self.assertIn('busy', result.stderr)
        with self.database() as db:
            db.execute("INSERT INTO runs(name,started,status) VALUES('audit',0,'RUNNING')")
            db.execute("UPDATE jobs SET status='RUNNING',next_run=999999999999")
        self.assertEqual(json.loads(self.call('tick').stdout), [])
        self.assertEqual(json.loads(self.call('history').stdout)[0]['status'], 'UNKNOWN')

    def test_environment_does_not_forward_credentials_or_startup_hooks(self):
        loader = importlib.machinery.SourceFileLoader('scheduler_fixture', str(COMMAND))
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
        import sys
        previous = sys.dont_write_bytecode
        sys.dont_write_bytecode = True
        try:
            loader.exec_module(module)
        finally:
            sys.dont_write_bytecode = previous
        from unittest.mock import patch
        with patch.dict(os.environ, {'ACCESS_TOKEN': 'synthetic', 'NODE_OPTIONS': '--require=fixture',
                                     'GIT_DIR': '/outside', 'BASH_ENV': '/outside'}):
            environment = module.safe_environment()
        for key in ('ACCESS_TOKEN', 'NODE_OPTIONS', 'GIT_DIR', 'BASH_ENV'):
            self.assertNotIn(key, environment)

    def test_dotads_validation_is_offline_and_workspace_confined(self):
        subprocess.run([str(ROOT / 'bin/dotads-meta'), 'init', str(self.repo)], env=self.env,
                       capture_output=True, check=True)
        media = self.repo / 'media/hero.jpg'
        media.write_bytes(b'fixture-image')
        manifest = self.repo / 'campaigns/sample-campaign.json'
        original = manifest.read_text()
        self.call('add', 'ads', '--kind', 'dotads-validate', '--repo', str(self.repo),
                  '--manifest', str(manifest), '--every', '3600')
        result = json.loads(self.call('tick').stdout)[0]
        self.assertEqual(result['status'], 'PASS')
        self.assertEqual(manifest.read_text(), original)
        self.assertFalse((self.repo / '.meta-state.json').exists())
        outside = self.base / 'outside.jpg'
        outside.write_bytes(b'outside')
        changed = json.loads(original)
        changed['creatives'][0]['image'] = str(outside)
        manifest.write_text(json.dumps(changed))
        self.call('run', 'ads', success=False)
        media.unlink()
        media.symlink_to(outside)
        manifest.write_text(original)
        self.call('run', 'ads', success=False)
        self.add('good')
        with self.database() as db:
            db.execute("UPDATE jobs SET next_run=0 WHERE name='ads'")
        results = json.loads(self.call('tick', success=False).stdout)
        self.assertEqual({row['name']: row['status'] for row in results}, {'ads': 'FAIL', 'good': 'PASS'})
        history = json.loads(self.call('history').stdout)
        self.assertEqual(next(row for row in history if row['name'] == 'ads')['status'], 'FAIL')

    def test_foreground_scheduler_stops_without_installing_a_service(self):
        self.add(paused=True)
        process = subprocess.Popen([str(COMMAND), '--state-dir', str(self.state), 'serve', '--poll', '1'],
                                   env=self.env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        try:
            self.assertEqual(process.stdout.readline().strip(), '[]')
            process.send_signal(signal.SIGINT)
            self.assertEqual(process.wait(timeout=5), 0)
        finally:
            if process.poll() is None:
                process.kill()
                process.wait()
            process.stdout.close()
            process.stderr.close()
        self.assertFalse((self.home / '.config/systemd').exists())


if __name__ == '__main__':
    unittest.main(argv=[str(Path(__file__).name)], verbosity=2)
