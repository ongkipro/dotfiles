#!/usr/bin/env bash
# Regression check for secrets-env. Run it after touching the tool:
#   ./bin/secrets-env-test
# Self-contained: every fixture lives in a mktemp sandbox and SECRETS_ENV_FILE
# points there, so the real ~/.config/ai-local/secrets.env is never read.
set -uo pipefail

DOT="$(cd "$(dirname "$0")/.." && pwd)"
TOOL="$DOT/bin/secrets-env"
[ -x "$TOOL" ] || { echo "not executable: $TOOL" >&2; exit 2; }

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
FIX="$TMP/secrets.env"

fail() { echo "FAIL: $*" >&2; exit 1; }
run() { SECRETS_ENV_FILE="$FIX" "$TOOL" "$@"; }

# A value containing $, backticks, spaces and quotes is the whole point: an
# implementation that sources the file would expand or execute these.
cat > "$FIX" <<'EOF'
# --- Group One ---------------------------------------------------
PLAIN=simple
DOLLAR=abc$NOT_A_VAR_def
BACKTICK=lit`echo pwned`eral
SPACED=two words here
QUOTED="not actually quoted"
EOF
chmod 600 "$FIX"

# --- list shows names and never values ---------------------------------------
out="$(run list)" || fail 'list should succeed'
for name in PLAIN DOLLAR BACKTICK SPACED QUOTED; do
  case "$out" in *"$name"*) ;; *) fail "list omitted $name" ;; esac
done
case "$out" in
  *simple*|*"two words here"*|*pwned*) fail 'list printed a VALUE; it must print names only' ;;
esac
case "$out" in *'Group One'*) ;; *) fail 'list did not show the group heading' ;; esac

# --- get returns one exact value ---------------------------------------------
[ "$(run get PLAIN)" = "simple" ] || fail 'get PLAIN returned the wrong value'
[ "$(run get SPACED)" = "two words here" ] || fail 'get lost the spaces in a value'
run get NOPE >/dev/null 2>&1 && fail 'get should fail on an unknown variable'

# --- run injects into the child, literally, and not into the parent ----------
got="$(run run -- bash -c 'printf %s "$DOLLAR"')" || fail 'run should succeed'
[ "$got" = 'abc$NOT_A_VAR_def' ] \
  || fail "a \$ in a value was expanded instead of passed literally: got '$got'"

got="$(run run -- bash -c 'printf %s "$BACKTICK"')"
[ "$got" = 'lit`echo pwned`eral' ] \
  || fail "backticks in a value were executed or mangled: got '$got'"
case "$got" in *pwned*) [ "$got" = 'lit`echo pwned`eral' ] || fail 'command substitution ran' ;; esac

got="$(run run -- bash -c 'printf %s "$QUOTED"')"
[ "$got" = '"not actually quoted"' ] \
  || fail "quotes in a value were stripped: got '$got'"

[ "$(run run -- bash -c 'printf %s "$SPACED"')" = 'two words here' ] \
  || fail 'a value with spaces was split'

[ -z "${PLAIN:-}" ] || fail 'run leaked a variable into the parent shell'

run run >/dev/null 2>&1 && fail 'run with no command should fail'

# --- a file readable beyond the owner is refused, not warned about -----------
chmod 644 "$FIX"
run list >/dev/null 2>&1 && fail 'list should refuse a mode-644 secrets file'
run get PLAIN >/dev/null 2>&1 && fail 'get should refuse a mode-644 secrets file'
run run -- true >/dev/null 2>&1 && fail 'run should refuse a mode-644 secrets file'
run check >/dev/null 2>&1 && fail 'check should fail on a mode-644 secrets file'
chmod 600 "$FIX"
run check >/dev/null 2>&1 || fail 'check should pass on a mode-600 file outside a repo'

# --- a missing file is an error, not an empty success ------------------------
rm -f "$FIX"
run list >/dev/null 2>&1 && fail 'list should fail when the secrets file is absent'
run check >/dev/null 2>&1 && fail 'check should fail when the secrets file is absent'

echo 'secrets-env-test: PASS'
