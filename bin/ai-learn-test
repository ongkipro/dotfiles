#!/usr/bin/env bash
set -euo pipefail

SOURCE_DOT="${1:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
TEST_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/ai-learn-test.XXXXXX")"
trap 'rm -rf "$TEST_ROOT"' EXIT

export HOME="$TEST_ROOT/home"
export DOTFILES_DIR="$TEST_ROOT/dotfiles"
export AI_MEMORY_INBOX_DIR="$HOME/.config/ai-local/memory-inbox"
mkdir -p "$DOTFILES_DIR/bin" "$DOTFILES_DIR/config/ai/memory" "$DOTFILES_DIR/config/ai/project-memory"
# ai-memory-hygiene is a hard dependency of promote: it gates the only path
# that mutates tracked memory. The fixture carries it, and its policy, so the
# gate is exercised here rather than stubbed away.
cp "$SOURCE_DOT/bin/ai-learn" "$SOURCE_DOT/bin/ai-memory-check" "$SOURCE_DOT/bin/ai-memory-hygiene" "$DOTFILES_DIR/bin/"
chmod +x "$DOTFILES_DIR/bin/ai-learn" "$DOTFILES_DIR/bin/ai-memory-check" "$DOTFILES_DIR/bin/ai-memory-hygiene"
cp "$SOURCE_DOT/config/ai/memory-hygiene.json" "$DOTFILES_DIR/config/ai/"
printf '# Workflow\n' >"$DOTFILES_DIR/config/ai/memory/workflow.md"
printf '# Project\n' >"$DOTFILES_DIR/config/ai/project-memory/example.md"

learn="$DOTFILES_DIR/bin/ai-learn"
capture_args=(
  capture
  --title "Preserve the source body during partial edits"
  --symptom "Saving metadata replaced the existing body."
  --root-cause "The read model omitted body while the write model replaced every field."
  --invariant "A full-replace form must load every persisted field it writes."
  --fix "Return body from the read model and seed the editor from that value."
  --check "Edit metadata and assert that the stored body remains byte-identical."
  --scope project
  --project example
  --repo /tmp/example
)

"$learn" "${capture_args[@]}" >/dev/null
candidate="$(find "$AI_MEMORY_INBOX_DIR" -maxdepth 1 -type f -name '*.md' -print -quit)"
[ -n "$candidate" ] || { echo "FAIL: capture did not create a candidate" >&2; exit 1; }
[ "$(stat -c '%a' "$AI_MEMORY_INBOX_DIR" 2>/dev/null || stat -f '%Lp' "$AI_MEMORY_INBOX_DIR")" = "700" ] \
  || { echo "FAIL: inbox permissions are not 700" >&2; exit 1; }
[ "$(stat -c '%a' "$candidate" 2>/dev/null || stat -f '%Lp' "$candidate")" = "600" ] \
  || { echo "FAIL: candidate permissions are not 600" >&2; exit 1; }
grep -qF '### Durable invariant' "$candidate"
"$learn" list | grep -qF "$(basename "$candidate")"
"$learn" show "$(basename "$candidate")" | grep -qF 'A full-replace form'

rejected="$AI_MEMORY_INBOX_DIR/rejected-candidate.md"
cat >"$rejected" <<'EOF'
---
status: candidate
---

## Lesson: Keep implementation status in the repository
EOF
chmod 600 "$rejected"
if "$learn" reject rejected-candidate.md --reason "Repository test owns this invariant" >/dev/null 2>&1; then
  echo "FAIL: rejection without --yes succeeded" >&2
  exit 1
fi
"$learn" reject rejected-candidate.md --reason "Repository test owns this invariant" --yes >/dev/null
[ ! -f "$rejected" ]
[ -f "$AI_MEMORY_INBOX_DIR/rejected/rejected-candidate.md" ]
grep -qF 'status: rejected' "$AI_MEMORY_INBOX_DIR/rejected/rejected-candidate.md"
grep -qF 'Rejected: Repository test owns this invariant' "$AI_MEMORY_INBOX_DIR/rejected/rejected-candidate.md"

before_count="$(find "$AI_MEMORY_INBOX_DIR" -maxdepth 1 -type f -name '*.md' | wc -l | tr -d ' ')"
if "$learn" capture --title incomplete >/dev/null 2>&1; then
  echo "FAIL: incomplete capture succeeded" >&2
  exit 1
fi
[ "$(find "$AI_MEMORY_INBOX_DIR" -maxdepth 1 -type f -name '*.md' | wc -l | tr -d ' ')" = "$before_count" ]

secret_label="api_key"
secret_value="example-value-that-must-not-be-stored"
if "$learn" capture \
  --title "Do not store credentials" --symptom "$secret_label=$secret_value" \
  --root-cause "Unsafe copying" --invariant "Secrets stay outside memory" \
  --fix "Summarize only" --check "Scan the candidate" >/dev/null 2>&1; then
  echo "FAIL: secret-like capture succeeded" >&2
  exit 1
fi

before="$(cat "$DOTFILES_DIR/config/ai/project-memory/example.md")"
before_mode="$(stat -c '%a' "$DOTFILES_DIR/config/ai/project-memory/example.md" 2>/dev/null || stat -f '%Lp' "$DOTFILES_DIR/config/ai/project-memory/example.md")"
if "$learn" promote "$(basename "$candidate")" --target project:example >/dev/null 2>&1; then
  echo "FAIL: promotion without --yes succeeded" >&2
  exit 1
fi
[ "$(cat "$DOTFILES_DIR/config/ai/project-memory/example.md")" = "$before" ]
if "$learn" promote "$(basename "$candidate")" --target project:../example --yes >/dev/null 2>&1; then
  echo "FAIL: path traversal target succeeded" >&2
  exit 1
fi

ln -s "$candidate" "$AI_MEMORY_INBOX_DIR/symlink.md"
if "$learn" show symlink.md >/dev/null 2>&1; then
  echo "FAIL: symlink candidate was accepted" >&2
  exit 1
fi
rm "$AI_MEMORY_INBOX_DIR/symlink.md"

printf '\n%s=%s\n' "$secret_label" "$secret_value" >>"$candidate"
if "$learn" promote "$(basename "$candidate")" --target project:example --yes >/dev/null 2>&1; then
  echo "FAIL: manually inserted secret-like content was promoted" >&2
  exit 1
fi
sed -i.bak '$d' "$candidate"
rm "$candidate.bak"

"$learn" promote "$(basename "$candidate")" --target project:example --yes >/dev/null
grep -qF 'A full-replace form must load every persisted field it writes.' \
  "$DOTFILES_DIR/config/ai/project-memory/example.md"
[ ! -f "$candidate" ]
[ -f "$AI_MEMORY_INBOX_DIR/promoted/$(basename "$candidate")" ]
[ "$(stat -c '%a' "$DOTFILES_DIR/config/ai/project-memory/example.md" 2>/dev/null || stat -f '%Lp' "$DOTFILES_DIR/config/ai/project-memory/example.md")" = "$before_mode" ] \
  || { echo "FAIL: promotion changed canonical file permissions" >&2; exit 1; }
"$DOTFILES_DIR/bin/ai-memory-check" "$DOTFILES_DIR/config/ai/project-memory/example.md" >/dev/null

# Two approved candidates targeting one file must both survive. The checker
# wrapper creates a deterministic overlap at the old copy/check/move window.
printf '# Concurrent promotions\n' >"$DOTFILES_DIR/config/ai/project-memory/concurrent.md"
cat >"$AI_MEMORY_INBOX_DIR/concurrent-alpha.md" <<'EOF'
---
status: candidate
---

## Lesson: Preserve amber updates

The amber writer retains every reviewed invariant while updating canonical memory.
EOF
cat >"$AI_MEMORY_INBOX_DIR/concurrent-beta.md" <<'EOF'
---
status: candidate
---

## Lesson: Preserve cobalt updates

The cobalt writer retains every approved constraint while updating canonical memory.
EOF
mv "$DOTFILES_DIR/bin/ai-memory-check" "$DOTFILES_DIR/bin/ai-memory-check.real"
cat >"$DOTFILES_DIR/bin/ai-memory-check" <<'PY'
#!/usr/bin/env python3
import os
from pathlib import Path
import subprocess
import sys
import time

barrier_value = os.environ.get("AI_LEARN_TEST_BARRIER_DIR")
if barrier_value and Path(sys.argv[1]).name.startswith(".ai-learn-preview."):
    barrier = Path(barrier_value)
    barrier.mkdir(parents=True, exist_ok=True)
    (barrier / f"writer-{os.getpid()}").touch()
    deadline = time.monotonic() + 2
    while len(list(barrier.glob("writer-*"))) < 2 and time.monotonic() < deadline:
        time.sleep(0.01)
real = Path(__file__).with_name("ai-memory-check.real")
raise SystemExit(subprocess.run([str(real), *sys.argv[1:]], check=False).returncode)
PY
chmod +x "$DOTFILES_DIR/bin/ai-memory-check"
export AI_LEARN_TEST_BARRIER_DIR="$TEST_ROOT/promotion-barrier"
"$learn" promote concurrent-alpha.md --target project:concurrent --yes >"$TEST_ROOT/alpha.log" 2>&1 &
alpha_pid=$!
"$learn" promote concurrent-beta.md --target project:concurrent --yes >"$TEST_ROOT/beta.log" 2>&1 &
beta_pid=$!
set +e
wait "$alpha_pid"; alpha_rc=$?
wait "$beta_pid"; beta_rc=$?
set -e
if [ "$alpha_rc" -ne 0 ] || [ "$beta_rc" -ne 0 ]; then
  cat "$TEST_ROOT/alpha.log" "$TEST_ROOT/beta.log" >&2
  echo "FAIL: concurrent promotions did not both succeed" >&2
  exit 1
fi
[ "$(find "$AI_LEARN_TEST_BARRIER_DIR" -name 'writer-*' -type f | wc -l | tr -d ' ')" -eq 2 ] \
  || { echo "FAIL: both writers must reach the preview barrier" >&2; exit 1; }
grep -qF 'amber writer retains every reviewed invariant' "$DOTFILES_DIR/config/ai/project-memory/concurrent.md"
grep -qF 'cobalt writer retains every approved constraint' "$DOTFILES_DIR/config/ai/project-memory/concurrent.md"
mv "$DOTFILES_DIR/bin/ai-memory-check.real" "$DOTFILES_DIR/bin/ai-memory-check"
unset AI_LEARN_TEST_BARRIER_DIR


# --- the hygiene gate must actually reject, not merely be wired ---------------
# Promotion is the only path that mutates tracked, committed memory. Before
# 2026-08-16 it ran no hygiene at all, so volatile state entered permanent
# memory whenever the manual step was skipped. These cases prove the gate bites.
dirty="$AI_MEMORY_INBOX_DIR/dirty-candidate.md"
printf -- '---\nstatus: candidate\n---\n\n## Lesson: probe\n\nCurrently the deploy is blocked. Resume here after lunch.\n' >"$dirty"
target_before="$(cat "$DOTFILES_DIR/config/ai/project-memory/example.md")"
if "$learn" promote dirty-candidate.md --target project:example --yes >/dev/null 2>&1; then
  echo "FAIL: hygiene gate accepted a candidate carrying volatile project state" >&2; exit 1
fi
[ "$(cat "$DOTFILES_DIR/config/ai/project-memory/example.md")" = "$target_before" ] \
  || { echo "FAIL: a rejected promotion still mutated tracked memory" >&2; exit 1; }
[ -f "$dirty" ] || { echo "FAIL: a rejected candidate was archived instead of left pending" >&2; exit 1; }
[ -z "$(find "$DOTFILES_DIR/config/ai/project-memory" -name '.ai-learn*' -print -quit)" ] \
  || { echo "FAIL: a rejected promotion left a staging temp behind" >&2; exit 1; }

# A missing hygiene binary must stop the promotion, not silently skip the gate.
mv "$DOTFILES_DIR/bin/ai-memory-hygiene" "$DOTFILES_DIR/bin/ai-memory-hygiene.off"
printf -- '---\nstatus: candidate\n---\n\n## Lesson: bounded ceiling\n\nA bounded retry ceiling beats an unbounded one.\n' >"$AI_MEMORY_INBOX_DIR/nogate.md"
if "$learn" promote nogate.md --target project:example --yes >/dev/null 2>&1; then
  echo "FAIL: promotion proceeded with ai-memory-hygiene absent" >&2; exit 1
fi
mv "$DOTFILES_DIR/bin/ai-memory-hygiene.off" "$DOTFILES_DIR/bin/ai-memory-hygiene"

echo "PASS: ai-learn capture and reviewed promotion"
