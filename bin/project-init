#!/usr/bin/env bash
# project-init — scaffold project documentation + clone repo
# Usage:
#   project-init <repo-name> <category> ["description"]
#   project-init --list                         # list projects with docs
#   project-init --sync                         # sync all repos & update INDEX
#   project-init --gen <repo-name>              # regenerate docs for one project
set -euo pipefail

# Resolve ke file asli (follow symlink) — fix saat script di-link ke ~/.local/bin/
if command -v realpath >/dev/null 2>&1; then
  DOT="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
elif command -v readlink >/dev/null 2>&1 && readlink -f "$0" >/dev/null 2>&1; then
  DOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
else
  DOT="$(cd "$(dirname "$0")/.." && pwd)"
fi
TEMPLATES="$DOT/config/templates"
PROJECTS_DIR="$HOME/projects"
DOCS_DIR="$HOME/Documents/projects"
INDEX_FILE="$DOCS_DIR/INDEX.md"
GITHUB_USER="ongkipro"

# ── helpers ──────────────────────────────────────────────────────────────────
say()    { printf '\033[1;32m→\033[0m %s\n' "$*"; }
warn()   { printf '\033[1;33m⚠\033[0m  %s\n' "$*" >&2; }
err()    { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; }
die()    { err "$1"; exit 1; }
now()    { date '+%Y-%m-%d'; }

replace() {
  local file="$1"
  shift
  local tmp="$file.tmp.$$"
  cp "$file" "$tmp"
  for pair in "$@"; do
    local key="${pair%%=*}" val="${pair#*=}"
    if [[ "$OSTYPE" == "darwin"* ]]; then
      sed -i '' "s|{{${key}}}|${val}|g" "$tmp"
    else
      sed -i "s|{{${key}}}|${val}|g" "$tmp"
    fi
  done
  mv "$tmp" "$file"
}

# ── fetch repo info from GitHub ──────────────────────────────────────────────
get_repo_info() {
  local repo="$1"
  local info
  info="$(gh repo view "$GITHUB_USER/$repo" --json name,description,createdAt,updatedAt,homepageUrl,primaryLanguage,languages --jq '
    "NAME=\(.name)|DESC=\(.description // "—")|CREATED=\(.createdAt // "—")|UPDATED=\(.updatedAt // "—")|URL=\(.homepageUrl // "")|LANG=\(.primaryLanguage.name // "—")|LANGUAGES=\(.languages | map(.name) | join(", ") // "—")"
  ' 2>/dev/null)" || true
  echo "$info"
}

# ── generate docs from templates ─────────────────────────────────────────────
gen_docs() {
  local repo="$1" category="$2" desc="${3:-}"
  local doc_dir="$DOCS_DIR/$repo"

  mkdir -p "$doc_dir"

  # Fetch GitHub info
  say "Fetching info for $repo..."
  local info repo_info lang
  repo_info="$(get_repo_info "$repo")"

  # Parse info
  local name="$repo" created="" updated="$(now)" homepage="" lang=""
  if [ -n "$repo_info" ]; then
    for item in $(echo "$repo_info" | tr '|' '\n'); do
      case "${item%%=*}" in
        NAME)  name="${item#*=}" ;;
        DESC)  [ "${item#*=}" != "—" ] && desc="${item#*=}" ;;
        CREATED) created="${item#*=}"; created="${created:0:10}" ;;
        UPDATED) updated="${item#*=}"; updated="${updated:0:10}" ;;
        URL)   homepage="${item#*=}" ;;
        LANG)  lang="${item#*=}" ;;
      esac
    done
  fi
  [ -z "$desc" ] && desc="Project: $repo"

  # Determine stack from category + language
  local stack=""
  case "$category" in
    ecommerce)     stack="Astro / Shopify / Payment" ;;
    agriculture)   stack="Web App / Dashboard" ;;
    education)     stack="Astro / Static Site" ;;
    agency)        stack="Astro / Three.js / Portfolio" ;;
    affiliate)     stack="Astro / Cloudflare / SEO" ;;
    automotive)    stack="Website / Dealer" ;;
    payment)       stack="API / Documentation" ;;
    web-builder)   stack="Astro / Template" ;;
    tools)         stack="Dev Tools / Script" ;;
    *)             stack="${lang:-TBD}" ;;
  esac

  local status="🟡 In Progress"
  local prod_url="${homepage:-}"
  [ -z "$prod_url" ] && prod_url="—"
  local staging_url="—"
  local local_url="http://localhost:4321"

  # Create each doc from template
  for tmpl in README PRD ARCHITECTURE FLOW SPECS TASKS DECISIONS NOTES; do
    local src="$TEMPLATES/${tmpl}.md"
    local dst="$doc_dir/${tmpl}.md"

    [ -f "$src" ] || { warn "Template $tmpl tidak ada — skip"; continue; }

    # Skip overwriting existing docs
    if [ -f "$dst" ]; then
      say "  ${tmpl}.md sudah ada — skip"
      continue
    fi

    cp "$src" "$dst"

    replace "$dst" \
      "PROJECT_NAME=$name" \
      "REPO_NAME=$repo" \
      "STATUS=$status" \
      "STACK=$stack" \
      "STARTED=$created" \
      "UPDATED=$updated" \
      "DATE=$(now)" \
      "DESCRIPTION=$desc" \
      "CATEGORY=$category" \
      "PROD_URL=$prod_url" \
      "STAGING_URL=$staging_url" \
      "LOCAL_URL=$local_url"

    say "  ✓ ${tmpl}.md"
  done
}

# ── clone repo ───────────────────────────────────────────────────────────────
clone_repo() {
  local repo="$1" category="$2"
  local target="$PROJECTS_DIR/$category/$repo"

  if [ -d "$target/.git" ]; then
    say "Repo $repo sudah ada di $target — pull..."
    git -C "$target" pull --ff-only 2>/dev/null || warn "  Pull gagal (mungkin ada perubahan lokal)"
  else
    say "Clone $repo → $target"
    mkdir -p "$(dirname "$target")"
    gh repo clone "$GITHUB_USER/$repo" "$target" 2>/dev/null || warn "  Clone gagal (repo mungkin private/kosong)"
  fi
}

# ── list projects with docs ──────────────────────────────────────────────────
cmd_list() {
  say "Projects with documentation in $DOCS_DIR:"
  for d in "$DOCS_DIR"/*/; do
    [ -d "$d" ] || continue
    local name="$(basename "$d")"
    local has_readme=""
    [ -f "$d/README.md" ] && has_readme="📄" || has_readme="📝"
    local has_prd=""
    [ -f "$d/PRD.md" ] && has_prd="📋" || true
    printf "  %s %s %s\n" "$has_readme$has_prd" "$name"
  done
}

# ── sync all ──────────────────────────────────────────────────────────────────
cmd_sync() {
  say "Syncing all projects..."
  for d in "$PROJECTS_DIR"/*/; do
    [ -d "$d" ] || continue
    local cat="$(basename "$d")"
    for repo_d in "$d"/*/; do
      [ -d "$repo_d/.git" ] || continue
      local repo="$(basename "$repo_d")"
      say "  Pull $cat/$repo..."
      git -C "$repo_d" pull --ff-only 2>/dev/null || true
    done
  done
  say "✓ Sync selesai"
}

# ── regenerate docs ──────────────────────────────────────────────────────────
cmd_gen() {
  local repo="$1"
  # Try to find category from existing cloned location
  local category="other"
  for d in "$PROJECTS_DIR"/*/; do
    [ -d "$d/${repo}" ] && { category="$(basename "$d")"; break; }
  done
  gen_docs "$repo" "$category" ""
}

# ── main ─────────────────────────────────────────────────────────────────────
COMMAND="${1:-}"

case "$COMMAND" in
  --list|-l)
    cmd_list
    ;;
  --sync|-s)
    cmd_sync
    ;;
  --gen|-g)
    [ -z "${2:-}" ] && die "Usage: project-init --gen <repo-name>"
    cmd_gen "$2"
    ;;
  --help|-h)
    echo "Usage: project-init <repo-name> <category> [description]"
    echo "       project-init --list"
    echo "       project-init --sync"
    echo "       project-init --gen <repo-name>"
    echo ""
    echo "Categories: ecommerce agriculture education agency affiliate automotive payment web-builder other tools"
    ;;
  "")
    cmd_list
    ;;
  *)
    REPO="$COMMAND"
    CATEGORY="${2:-other}"
    DESC="${3:-}"
    gen_docs "$REPO" "$CATEGORY" "$DESC"
    clone_repo "$REPO" "$CATEGORY"
    say "✓ $REPO siap di ~/projects/$CATEGORY/$REPO"
    say "  Docs: ~/Documents/projects/$REPO/"
    ;;
esac
