#!/usr/bin/env bash
# device-verify — run every repository gate on THIS device and write a report
# another device can read.
#
# The gates in this repository were written, run, and proven on one Linux
# machine. That is not evidence they hold on macOS, where `omp` sits in
# /opt/homebrew/bin and is absent from a non-interactive PATH, the model registry
# is whatever that device authenticates, and sed/stat/date are BSD rather than
# GNU. A gate that passes only where it was written is a gate that has been
# tested once.
#
# Read-only apart from the report it writes. It repairs nothing and installs
# nothing: a failure here is a finding to carry back to the repository, not a
# thing to patch locally until the machine goes quiet.
set -uo pipefail

ROOT="${DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0")")/.." && pwd)}"
HOST="$(hostname -s 2>/dev/null || hostname)"
STAMP="$(date -u +%Y-%m-%dT%H%M%SZ)"
OUT_DIR="$ROOT/docs/device-reports"
OUT="$OUT_DIR/${HOST}-${STAMP}.md"
mkdir -p "$OUT_DIR"

# `omp` and the owned commands are frequently outside a non-interactive PATH,
# which is a property of the machine and not a failure of the gate.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

failures=0
rows=""

run_gate() {
  local label="$1"; shift
  local log; log="$(mktemp)"
  local start; start=$(date +%s)
  "$@" >"$log" 2>&1
  local code=$?
  local secs=$(( $(date +%s) - start ))
  # A failing gate's *last* line is usually a separator or a tally. The line the
  # reader needs is the first one naming the problem — the first report of this
  # command carried "────────────" for a real failure, which told nobody
  # anything, and the whole point of the file is that someone else reads it.
  local clean; clean="$(sed 's/\x1b\[[0-9;]*m//g' "$log" | grep -v '^[[:space:]]*$')"
  local tail_line
  tail_line="$(printf '%s\n' "$clean" | grep -m1 -E '✗|ERROR|FAIL|RUSAK' || true)"
  [ -n "$tail_line" ] || tail_line="$(printf '%s\n' "$clean" | tail -1)"
  tail_line="$(printf '%s' "$tail_line" | cut -c1-110)"
  local verdict="PASS"
  [ "$code" -ne 0 ] && { verdict="FAIL"; failures=$((failures + 1)); }
  rows="${rows}| \`${label}\` | ${verdict} | ${code} | ${secs}s | ${tail_line//|/\\|} |"$'\n'
  printf '  %-34s %s (exit %d, %ds)\n' "$label" "$verdict" "$code" "$secs"
  rm -f "$log"
}

fact() { printf '%s\n' "- **$1:** $2"; }

echo "device-verify: $HOST"
run_gate "ai-doctor"                  "$ROOT/bin/ai-doctor"
run_gate "ai-doctor --self-test"      "$ROOT/bin/ai-doctor" --self-test
run_gate "ai-doctor --runtime"        "$ROOT/bin/ai-doctor" --runtime
run_gate "ai-policy-lint"             "$ROOT/bin/ai-policy-lint"
run_gate "delivery-ledger-test"       bash "$ROOT/bin/delivery-ledger-test"
run_gate "omp-effective-routing-test" bash "$ROOT/bin/omp-effective-routing-test"
run_gate "dev-ready-test"           bash "$ROOT/bin/dev-ready-test"

omp_bin="$(command -v omp || echo 'NOT FOUND')"
omp_ver="$([ "$omp_bin" != 'NOT FOUND' ] && omp --version 2>/dev/null || echo '-')"
providers="$([ "$omp_bin" != 'NOT FOUND' ] && omp models --json 2>/dev/null \
  | python3 -c 'import json,sys
try: print(",".join(sorted({m["provider"] for m in json.load(sys.stdin)["models"]})) or "none")
except Exception: print("unreadable")' || echo '-')"
unlinked="$(cd "$ROOT" && grep -v '^#' config/ai/runtime-commands.txt | grep -v '^$' \
  | while read -r c; do [ -x "$HOME/.local/bin/$c" ] || printf '%s ' "$c"; done)"

{
  echo "# Device verification — ${HOST}"
  echo
  echo "Generated by \`device-verify\` at ${STAMP} against $(cd "$ROOT" && git rev-parse --short HEAD)."
  echo "Read-only: this run repaired nothing. A FAIL below is a finding for the"
  echo "repository, not something to patch on this machine."
  echo
  echo "## Gates"
  echo
  echo "| Gate | Verdict | Exit | Time | Last line |"
  echo "| --- | --- | --- | --- | --- |"
  printf '%s' "$rows"
  echo
  echo "## This machine"
  echo
  fact "uname" "$(uname -srm)"
  fact "shell" "${SHELL:-unknown}"
  fact "omp" "$omp_bin ($omp_ver)"
  fact "authenticated providers" "${providers:-none}"
  fact "jq" "$(command -v jq || echo 'NOT FOUND')"
  fact "python3" "$(command -v python3 || echo 'NOT FOUND') $(python3 -V 2>&1)"
  fact "sed flavour" "$(sed --version >/dev/null 2>&1 && echo GNU || echo 'BSD (no --version)')"
  fact "unlinked manifest commands" "${unlinked:-none}"
  echo
  echo "## Verdict"
  echo
  if [ "$failures" -eq 0 ]; then
    echo "**PASS** — every gate holds on this device."
  else
    echo "**${failures} gate(s) FAILED.** Report them as findings; do not weaken a"
    echo "gate locally to make this machine quiet. Attach the failing output."
  fi
} > "$OUT"

echo
echo "device-verify: report written to ${OUT#$ROOT/}"
echo "device-verify: commit and push it so other devices can read the result:"
echo "  git -C \"$ROOT\" add docs/device-reports && git -C \"$ROOT\" commit -m 'report(device): ${HOST} verification' && git -C \"$ROOT\" push"
[ "$failures" -eq 0 ] || echo "device-verify: ${failures} gate(s) FAILED"
exit $(( failures > 0 ? 1 : 0 ))
