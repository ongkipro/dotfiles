#!/usr/bin/env bash
# Regression test for machine-local Pi seeding and the device-configured 9Router boundary.
set -euo pipefail

ROOT="${1:-$HOME/dotfiles}"
RESTORE="$ROOT/bin/pi-9router-restore"
python3 - "$ROOT/config/pi/models.template.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as source:
    providers = json.load(source)["providers"]
if set(providers) != {"9router-fantastico"}:
    raise SystemExit("Pi model template must contain the 9Router compatibility provider")
if providers["9router-fantastico"]["baseUrl"] != "http://127.0.0.1:20128/v1":
    raise SystemExit("Pi seed gateway endpoint drifted")
PY
node --check "$ROOT/bin/pi-9router-sync.js"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/pi-9router-restore-test.XXXXXX")"
cleanup() { chmod -R u+w "$TMP" 2>/dev/null || true; rm -rf "$TMP"; }
trap cleanup EXIT

FAKE_HOME="$TMP/home"
FAKE_DOT="$TMP/dotfiles"
FAKE_BIN="$TMP/bin"
mkdir -p "$FAKE_HOME" "$FAKE_DOT/config/pi" "$FAKE_DOT/bin" "$FAKE_BIN"
printf '%s\n' '{"defaultProvider":"fixture","defaultModel":"safe"}' > "$FAKE_DOT/config/pi/settings.json"
printf '%s\n' '{"providers":{"9router-fantastico":{"baseUrl":"http://127.0.0.1:20128/v1"}}}' > "$FAKE_DOT/config/pi/models.template.json"
printf '%s\n' '#!/usr/bin/env bash' 'printf "Darwin\n"' > "$FAKE_BIN/uname"
chmod +x "$FAKE_BIN/uname"

run_restore() {
  HOME="$FAKE_HOME" DOTFILES_DIR="$FAKE_DOT" PATH="$FAKE_BIN:$PATH" bash "$RESTORE" >/dev/null 2>&1
}

run_restore
[ -f "$FAKE_HOME/.pi/agent/settings.json" ] && [ ! -L "$FAKE_HOME/.pi/agent/settings.json" ]
grep -q 'http://127.0.0.1:20128/v1' "$FAKE_HOME/.pi/agent/models.json"

printf '%s\n' '{"defaultProvider":"local","defaultModel":"preserve"}' > "$FAKE_HOME/.pi/agent/settings.json"
run_restore
grep -q '"defaultProvider":"local"' "$FAKE_HOME/.pi/agent/settings.json"

rm -f "$FAKE_HOME/.pi/agent/settings.json"
ln -s "$FAKE_DOT/config/pi/settings.json" "$FAKE_HOME/.pi/agent/settings.json"
source_before="$(cksum "$FAKE_DOT/config/pi/settings.json")"
run_restore
[ -f "$FAKE_HOME/.pi/agent/settings.json" ] && [ ! -L "$FAKE_HOME/.pi/agent/settings.json" ]
[ "$source_before" = "$(cksum "$FAKE_DOT/config/pi/settings.json")" ]

echo "pi-9router-restore-test: OK"

node --input-type=module - "$ROOT" <<'JS'
import assert from 'node:assert/strict';
import { createServer } from 'node:http';
import { mkdtemp, mkdir, writeFile, readFile, rm } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { execFile } from 'node:child_process';
import { promisify } from 'node:util';
const exec = promisify(execFile);
const root = process.argv[2];
const fixture = await mkdtemp(join(tmpdir(), 'pi-catalog-sync-'));
let mode = 'ok', calls = 0, sentCredential = false;
const server = createServer((req, res) => {
  calls++;
  sentCredential ||= Boolean(req.headers.authorization || req.headers['x-api-key']);
  res.setHeader('content-type', 'application/json');
  if (mode === 'http-error') { res.writeHead(503); res.end('{}'); return; }
  if (mode === 'redirect') { res.writeHead(302, {location:'/other'}); res.end(); return; }
  const rows = [
    {id:'cx/gpt-6.1-sol', context_length:272000,max_completion_tokens:128000,capabilities:{reasoning:true,vision:true}},
    {id:'cc/claude-opus-5-5',context_length:1000000,max_completion_tokens:128000,capabilities:{reasoning:true,vision:true,thinkingFormat:'claude-adaptive'}},
  ];
  if (mode === 'duplicate') rows.push(rows[0]);
  if (mode === 'invalid') rows[0].context_length = -1;
  res.end(JSON.stringify({data:mode === 'empty' ? [] : rows}));
});
await new Promise(resolve => server.listen(0,'127.0.0.1',resolve));
try {
  const dir=join(fixture,'.pi/agent'); await mkdir(dir,{recursive:true});
  const file=join(dir,'models.json');
  const baseUrl=`http://127.0.0.1:${server.address().port}/v1`;
  const original={providers:{'9router-fantastico':{baseUrl,apiKey:'fixture-only-key',custom:'keep',models:[{id:'cx/gpt-6.1-sol',headers:{'x-fixture':'keep'}},{id:'retired'}]},other:{baseUrl:'https://example.invalid',models:[]}}};
  await writeFile(file,JSON.stringify(original));
  const run=()=>exec(process.execPath,[join(root,'bin/pi-9router-sync.js')],{env:{...process.env,HOME:fixture},timeout:15000});
  await run();const synced=JSON.parse(await readFile(file,'utf8'));
  const provider=synced.providers['9router-fantastico'];
  assert.equal(provider.baseUrl,baseUrl);assert.equal(provider.apiKey,'fixture-only-key');
  assert.equal(provider.custom,'keep');assert.equal(provider.authHeader,true);
  assert.deepEqual(synced.providers.other,original.providers.other);
  assert.equal(provider.models.length,2);assert.equal(provider.models[0].contextWindow,272000);
  assert.equal(provider.models[0].maxTokens,128000);assert.equal(provider.models[0].compat.supportsReasoningEffort,true);
  assert.equal(provider.models[0].headers['x-fixture'],'keep');
  assert.equal(provider.models[1].api,'anthropic-messages');assert.equal(provider.models[1].compat.forceAdaptiveThinking,true);
  assert.equal(provider.models[1].compat.supportsStrictTools,false);
  const good=await readFile(file,'utf8');
  for (mode of ['http-error','empty','duplicate','invalid','redirect']) {
    await assert.rejects(run);assert.equal(await readFile(file,'utf8'),good);
  }
  assert.equal(sentCredential,false);assert.equal(calls,6);
  console.log('pi-catalog-sync: PASS (metadata, auth isolation, preservation, and five fail-closed cases)');
} finally {
  await new Promise(resolve=>server.close(resolve));
  await rm(fixture,{recursive:true,force:true});
}
JS
