#!/usr/bin/env bash
# Regression test for machine-local Pi seeding and the device-configured 9Router boundary.
set -euo pipefail

ROOT="${1:-$HOME/dotfiles}"
RESTORE="$ROOT/bin/pi-9router-restore"
python3 - "$ROOT/config/pi/models.template.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as source:
    providers = json.load(source)["providers"]
if set(providers) != {"9router-fantastico"}:
    raise SystemExit("Pi model template must contain the 9Router compatibility provider")
if providers["9router-fantastico"]["baseUrl"] != "http://127.0.0.1:20128/v1":
    raise SystemExit("Pi seed gateway endpoint drifted")
PY
node --check "$ROOT/bin/pi-9router-sync.js"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/pi-9router-restore-test.XXXXXX")"
cleanup() { chmod -R u+w "$TMP" 2>/dev/null || true; rm -rf "$TMP"; }
trap cleanup EXIT

FAKE_HOME="$TMP/home"
FAKE_DOT="$TMP/dotfiles"
FAKE_BIN="$TMP/bin"
mkdir -p "$FAKE_HOME" "$FAKE_DOT/config/pi" "$FAKE_DOT/bin" "$FAKE_BIN"
printf '%s\n' '{"defaultProvider":"fixture","defaultModel":"safe"}' > "$FAKE_DOT/config/pi/settings.json"
printf '%s\n' '{"providers":{"9router-fantastico":{"baseUrl":"http://127.0.0.1:20128/v1"}}}' > "$FAKE_DOT/config/pi/models.template.json"
printf '%s\n' '{"enableHomeDirScanning":false}' > "$FAKE_DOT/config/pi/pi-fff.json"
printf '%s\n' '{"typescript":{"command":["typescript-language-server","--stdio"]}}' > "$FAKE_DOT/config/pi/pi-lsp.json"
mkdir -p "$FAKE_HOME/.pi/extensions/compact-free"
printf '%s\n' '{"name": "compact-free"}' > "$FAKE_HOME/.pi/extensions/compact-free/package.json"
printf '%s\n' '#!/usr/bin/env bash' 'printf "Darwin\n"' > "$FAKE_BIN/uname"
chmod +x "$FAKE_BIN/uname"

run_restore() {
  HOME="$FAKE_HOME" DOTFILES_DIR="$FAKE_DOT" PATH="$FAKE_BIN:$PATH" bash "$RESTORE" >/dev/null 2>&1
}

run_restore
[ -f "$FAKE_HOME/.pi/agent/settings.json" ] && [ ! -L "$FAKE_HOME/.pi/agent/settings.json" ]
grep -q 'http://127.0.0.1:20128/v1' "$FAKE_HOME/.pi/agent/models.json"
grep -q '"enableHomeDirScanning":false' "$FAKE_HOME/.pi/agent/pi-fff.json"
[ ! -e "$FAKE_HOME/.pi/extensions/compact-free" ]
printf '%s\n' '{"warnOnHomeDirScan":false}' > "$FAKE_HOME/.pi/agent/pi-fff.json"
run_restore
grep -q '"warnOnHomeDirScan":false' "$FAKE_HOME/.pi/agent/pi-fff.json"
grep -q 'typescript-language-server' "$FAKE_HOME/.pi/agent/pi-lsp.json"
printf '%s\n' '{"local":{"command":["keep"]}}' > "$FAKE_HOME/.pi/agent/pi-lsp.json"
run_restore
grep -q '"local"' "$FAKE_HOME/.pi/agent/pi-lsp.json"
# The tracked seed must stay valid JSON and declare every package it documents.
python3 - "$ROOT/config/pi/settings.json" "$ROOT/config/pi/pi-lsp.json" <<'PY'
import json, sys
settings = json.load(open(sys.argv[1]))
json.load(open(sys.argv[2]))
packages = settings["packages"]
if len(packages) != len(set(packages)):
    raise SystemExit("duplicate Pi package in the tracked seed")
for required in ("npm:cc-safety-net", "npm:@narumitw/pi-plan-mode", "npm:pi-rewind-hook"):
    if required not in packages:
        raise SystemExit(f"tracked Pi seed lost {required}")
if not settings.get("rewind", {}).get("retention"):
    raise SystemExit("rewind snapshots must stay bounded by retention")
PY

printf '%s\n' '{"defaultProvider":"local","defaultModel":"preserve"}' > "$FAKE_HOME/.pi/agent/settings.json"
run_restore
grep -q '"defaultProvider":"local"' "$FAKE_HOME/.pi/agent/settings.json"
# The review-pairing default reaches a device that has none, and a device's own
# reviewer override is never replaced. The tracked seed carries the default.
python3 -c 'import json,sys; r=json.load(open(sys.argv[1]))["subagents"]["agentOverrides"]["reviewer"]; assert r["model"]=="9router-fantastico/cx/gpt-6.1-sol", r' "$ROOT/config/pi/settings.json"
seed_plain="$(cat "$FAKE_DOT/config/pi/settings.json")"
printf '%s\n' '{"defaultProvider":"fixture","subagents":{"agentOverrides":{"reviewer":{"model":"seed/sol"}}}}' > "$FAKE_DOT/config/pi/settings.json"
run_restore
grep -q '"seed/sol"' "$FAKE_HOME/.pi/agent/settings.json"
printf '%s\n' '{"subagents":{"agentOverrides":{"reviewer":{"model":"local/own"}}}}' > "$FAKE_HOME/.pi/agent/settings.json"
run_restore
grep -q '"local/own"' "$FAKE_HOME/.pi/agent/settings.json"
! grep -q '"seed/sol"' "$FAKE_HOME/.pi/agent/settings.json"
# A tracked agent override the device lacks (oracle) is added beside the
# device's own reviewer, which stays untouched.
python3 -c 'import json,sys; o=json.load(open(sys.argv[1]))["subagents"]["agentOverrides"]["oracle"]; assert o["model"]=="9router-fantastico/ag/gemini-4-carbon-high", o' "$ROOT/config/pi/settings.json"
printf '%s\n' '{"subagents":{"agentOverrides":{"reviewer":{"model":"seed/sol"},"oracle":{"model":"seed/carbon"}}}}' > "$FAKE_DOT/config/pi/settings.json"
run_restore
python3 -c 'import json,sys; o=json.load(open(sys.argv[1]))["subagents"]["agentOverrides"]; assert o["reviewer"]["model"]=="local/own" and o["oracle"]["model"]=="seed/carbon", o' "$FAKE_HOME/.pi/agent/settings.json"
printf '%s\n' "$seed_plain" > "$FAKE_DOT/config/pi/settings.json"
printf '%s\n' '{"defaultProvider":"local","defaultModel":"preserve"}' > "$FAKE_HOME/.pi/agent/settings.json"

# An existing file gains missing tracked packages by name; local pins, extra
# packages, other keys and the file mode are kept, and a re-run adds nothing.
seed_backup="$(cat "$FAKE_DOT/config/pi/settings.json")"
printf '%s\n' '{"defaultProvider":"fixture","hideThinkingBlock":true,"defaultThinkingLevel":"medium","enabledModels":["model-a","model-b"],"packages":["npm:pi-subagents","npm:@scope/tool@2.0.0","npm:new-pkg"],"rewind":{"retention":{"maxSnapshots":5}}}' > "$FAKE_DOT/config/pi/settings.json"
printf '%s\n' '{"defaultProvider":"local","quietStartup":true,"enabledModels":["model-a","model-a"],"packages":["npm:pi-subagents","npm:pi-subagents@0.84.0","npm:@scope/tool","npm:local-only","npm:local-only"]}' > "$FAKE_HOME/.pi/agent/settings.json"
chmod 600 "$FAKE_HOME/.pi/agent/settings.json"
run_restore
python3 - "$FAKE_HOME/.pi/agent/settings.json" <<'PY'
import json, sys
s = json.load(open(sys.argv[1]))
assert s["packages"] == ["npm:pi-subagents@0.84.0", "npm:@scope/tool", "npm:local-only", "npm:new-pkg"], s["packages"]
assert s["defaultProvider"] == "local" and s["quietStartup"] is True, s
assert s["hideThinkingBlock"] is True and s["defaultThinkingLevel"] == "medium", s
assert s["enabledModels"] == ["model-a", "model-b"], s["enabledModels"]
assert s["rewind"]["retention"]["maxSnapshots"] == 5, s
PY
[ "$(stat -c %a "$FAKE_HOME/.pi/agent/settings.json" 2>/dev/null || stat -f %Lp "$FAKE_HOME/.pi/agent/settings.json")" = 600 ]
before_rerun="$(cksum < "$FAKE_HOME/.pi/agent/settings.json")"
run_restore
[ "$before_rerun" = "$(cksum < "$FAKE_HOME/.pi/agent/settings.json")" ]
printf '%s\n' "$seed_backup" > "$FAKE_DOT/config/pi/settings.json"

rm -f "$FAKE_HOME/.pi/agent/settings.json"
ln -s "$FAKE_DOT/config/pi/settings.json" "$FAKE_HOME/.pi/agent/settings.json"
source_before="$(cksum "$FAKE_DOT/config/pi/settings.json")"
run_restore
[ -f "$FAKE_HOME/.pi/agent/settings.json" ] && [ ! -L "$FAKE_HOME/.pi/agent/settings.json" ]
[ "$source_before" = "$(cksum "$FAKE_DOT/config/pi/settings.json")" ]

# Linux: the sync runs from a timer whose unit survives a node patch upgrade.
linux_fail() { echo "pi-9router-restore-test: FAIL (linux timer): $1" >&2; [ -f "${unit:-}" ] && cat "$unit" >&2; exit 1; }
LINUX_HOME="$TMP/linux-home"; LINUX_BIN="$TMP/linux-bin"; mkdir -p "$LINUX_HOME" "$LINUX_BIN"
printf '%s\n' '#!/usr/bin/env bash' 'printf "Linux\n"' > "$LINUX_BIN/uname"
printf '%s\n' '#!/usr/bin/env bash' 'printf "%s\n" "$*" >> "$SYSTEMCTL_LOG"' > "$LINUX_BIN/systemctl"
chmod +x "$LINUX_BIN/uname" "$LINUX_BIN/systemctl"
real_node="$(command -v node)"; node_version="$(node -p 'process.versions.node')"; node_major="${node_version%%.*}"
mkdir -p "$TMP/mise/node/$node_version/bin" "$TMP/mise/node/$node_major/bin"
ln -s "$real_node" "$TMP/mise/node/$node_version/bin/node"
ln -s "$real_node" "$TMP/mise/node/$node_major/bin/node"
cp "$ROOT/bin/pi-9router-sync.js" "$FAKE_DOT/bin/"
HOME="$LINUX_HOME" DOTFILES_DIR="$FAKE_DOT" SYSTEMCTL_LOG="$TMP/systemctl.log" \
  PATH="$LINUX_BIN:$TMP/mise/node/$node_version/bin:$PATH" bash "$RESTORE" > "$TMP/linux.out" 2>&1 \
  || { cat "$TMP/linux.out" >&2; linux_fail "restore exited non-zero"; }
unit="$LINUX_HOME/.config/systemd/user/pi-9router-sync.service"
timer="$LINUX_HOME/.config/systemd/user/pi-9router-sync.timer"
[ -f "$unit" ] && [ -f "$timer" ] || linux_fail "service or timer file not written"
grep -q "^ExecStart=\"$TMP/mise/node/$node_major/bin/node\" " "$unit" || linux_fail "ExecStart does not use the node major alias"
grep -q '^Restart=on-failure' "$unit" || linux_fail "missing Restart=on-failure"
if grep -q '^RemainAfterExit' "$unit"; then linux_fail "RemainAfterExit would stop the timer re-running"; fi
grep -q '^OnUnitActiveSec=1h' "$timer" || linux_fail "timer is not hourly"
grep -q 'enable --now pi-9router-sync.timer' "$TMP/systemctl.log" || linux_fail "timer was not enabled"
# No user bus: the restore still completes, with a warning instead of an abort.
printf '%s\n' '#!/usr/bin/env bash' 'exit 1' > "$LINUX_BIN/systemctl"; chmod +x "$LINUX_BIN/systemctl"
HOME="$LINUX_HOME" DOTFILES_DIR="$FAKE_DOT" PATH="$LINUX_BIN:$PATH" bash "$RESTORE" > "$TMP/nobus.out" 2>&1 \
  || { cat "$TMP/nobus.out" >&2; linux_fail "restore aborted without a user bus"; }
grep -q 'could enable it' "$TMP/nobus.out" || linux_fail "no warning without a user bus"

echo "pi-9router-restore-test: OK"

node --input-type=module - "$ROOT" <<'JS'
import assert from 'node:assert/strict';
import { createServer } from 'node:http';
import { mkdtemp, mkdir, writeFile, readFile, rm } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { execFile } from 'node:child_process';
import { promisify } from 'node:util';
const exec = promisify(execFile);
const root = process.argv[2];
const fixture = await mkdtemp(join(tmpdir(), 'pi-catalog-sync-'));
let mode = 'ok', catalogCalls = 0, sentCredential = false;
const server = createServer((req, res) => {
  sentCredential ||= Boolean(req.headers.authorization || req.headers['x-api-key']);
  res.setHeader('content-type', 'application/json');
  if (req.url.startsWith('/v1/models/info')) {
    const id = new URL(req.url, 'http://x').searchParams.get('id');
    res.end(JSON.stringify({id, kind: id === 'oc/jev-1.13-free' ? 'systemone' : 'llm'})); return;
  }
  catalogCalls++;
  if (mode === 'http-error') { res.writeHead(503); res.end('{}'); return; }
  if (mode === 'redirect') { res.writeHead(302, {location:'/other'}); res.end(); return; }
  const rows = [
    {id:'cx/gpt-6.1-sol', context_length:272000,max_completion_tokens:128000,capabilities:{reasoning:true,vision:true}},
    {id:'cc/claude-opus-5-5',context_length:1000000,max_completion_tokens:128000,capabilities:{reasoning:true,vision:true,thinkingFormat:'claude-adaptive'}},
    {id:'cc/claude-unlisted',context_length:200000,max_completion_tokens:64000,capabilities:{reasoning:true,vision:true,thinkingFormat:'claude-adaptive'}},
    {id:'oc/jev-1.13-free',context_length:200000,max_completion_tokens:64000,capabilities:{reasoning:false,vision:false}},
  ];
  if (mode === 'argon' || mode === 'argon-listed-carbon') rows.push({id:'ag/gemini-4-argon-high',context_length:1048576,max_completion_tokens:65536,capabilities:{reasoning:true,vision:true}});
  if (mode === 'argon-listed-carbon') rows.push({id:'ag/gemini-4-carbon-high',context_length:2000000,max_completion_tokens:65536,capabilities:{reasoning:true,vision:true}});
  if (mode === 'duplicate') rows.push(rows[0]);
  if (mode === 'invalid') rows[0].context_length = -1;
  res.end(JSON.stringify({data:mode === 'empty' ? [] : rows}));
});
await new Promise(resolve => server.listen(0,'127.0.0.1',resolve));
try {
  // Stand-in for Pi's built-in catalogs, shaped like pi-ai's generated modules.
  const official=join(fixture,'official'); await mkdir(official);
  await writeFile(join(official,'anthropic.models.js'),`export const ANTHROPIC_MODELS={'claude-opus-5-5':{id:'claude-opus-5-5',thinkingLevelMap:{low:'low',max:'max'},promptCache:{short:300,long:3600},compat:{forceAdaptiveThinking:true,supportsStrictTools:true,supportsTemperature:false,supportsMidConvoEffort:true,supportsMidConvoSystemMessages:true,supportsMidConvoToolChanges:true,allowedFallbackModels:[]}}};`);
  await writeFile(join(official,'openai-codex.models.js'),`export const OPENAI_CODEX_MODELS={'gpt-6.1-sol':{id:'gpt-6.1-sol',thinkingLevelMap:{xhigh:'xhigh',max:'max'},compat:{supportsToolSearch:true}}};`);
  const dir=join(fixture,'.pi/agent'); await mkdir(dir,{recursive:true});
  const file=join(dir,'models.json');
  const baseUrl=`http://127.0.0.1:${server.address().port}/v1`;
  const original={providers:{'9router-fantastico':{baseUrl,apiKey:'fixture-only-key',custom:'keep',models:[{id:'cx/gpt-6.1-sol',headers:{'x-fixture':'keep'},compat:{supportsReasoningEffort:true},api:'openai-completions'},{id:'retired'}]},other:{baseUrl:'https://example.invalid',models:[]}}};
  await writeFile(file,JSON.stringify(original));
  const run=(officialDir=official)=>exec(process.execPath,[join(root,'bin/pi-9router-sync.js')],{env:{...process.env,HOME:fixture,PI_9ROUTER_OFFICIAL_DIR:officialDir},timeout:15000});
  await run();const synced=JSON.parse(await readFile(file,'utf8'));
  const provider=synced.providers['9router-fantastico'];
  assert.equal(provider.baseUrl,baseUrl);assert.equal(provider.apiKey,'fixture-only-key');
  assert.equal(provider.custom,'keep');assert.equal(provider.authHeader,true);
  assert.deepEqual(synced.providers.other,original.providers.other);
  const byId=Object.fromEntries(provider.models.map(m=>[m.id,m]));
  assert.deepEqual(Object.keys(byId),['cx/gpt-6.1-sol','cc/claude-opus-5-5','cc/claude-unlisted']); // classifier and retired rows dropped
  const sol=byId['cx/gpt-6.1-sol'];
  assert.equal(sol.contextWindow,272000);assert.equal(sol.maxTokens,128000);assert.equal(sol.headers['x-fixture'],'keep');
  assert.equal(sol.api,'openai-responses');assert.deepEqual(sol.compat,{supportsToolSearch:true}); // stale compat replaced
  assert.deepEqual(sol.thinkingLevelMap,{xhigh:'xhigh',max:'max'});
  const opus=byId['cc/claude-opus-5-5'];
  assert.equal(opus.api,'anthropic-messages');assert.equal(opus.baseUrl,baseUrl.replace(/\/v1$/,''));
  assert.deepEqual(opus.compat,{forceAdaptiveThinking:true,supportsStrictTools:true,supportsTemperature:false});
  assert.deepEqual(opus.thinkingLevelMap,{low:'low',max:'max'});assert.deepEqual(opus.promptCache,{short:300,long:3600});
  assert.deepEqual(byId['cc/claude-unlisted'].compat,{supportsStrictTools:false,forceAdaptiveThinking:true});
  assert.equal(byId['cc/claude-unlisted'].thinkingLevelMap,undefined);
  // A run that cannot see Pi's catalog keeps fields an earlier run derived.
  const before=await readFile(file,'utf8');
  await run(join(fixture,'missing'));
  assert.equal(await readFile(file,'utf8'),before);
  // On a fresh file the gateway metadata alone stays conservative.
  await writeFile(file,JSON.stringify(original));
  await run(join(fixture,'missing'));
  const bare=JSON.parse(await readFile(file,'utf8')).providers['9router-fantastico'].models;
  assert.deepEqual(bare.find(m=>m.id==='cc/claude-opus-5-5').compat,{supportsStrictTools:false,forceAdaptiveThinking:true});
  assert.deepEqual(bare.find(m=>m.id==='cx/gpt-6.1-sol').compat,{supportsReasoningEffort:true}); // existing fields kept, not guessed
  // A pi.dev managed install is found with no override: its `pi` is a launcher
  // script, so only ~/.pi/agent/install/current-version leads to the catalog.
  const managed=join(fixture,'.pi/agent/install');
  const providersDir=join(managed,'releases/9.9.9/node_modules/@earendil-works/pi-ai/dist/providers');
  await mkdir(providersDir,{recursive:true});
  for (const name of ['anthropic.models.js','openai-codex.models.js']) await writeFile(join(providersDir,name),await readFile(join(official,name)));
  await writeFile(join(managed,'current-version'),'9.9.9\n');
  await writeFile(file,JSON.stringify(original));
  const env={...process.env,HOME:fixture};
  for (const key of ['PI_9ROUTER_OFFICIAL_DIR','PI_MANAGED_INSTALL_ROOT','PI_CODING_AGENT_DIR']) delete env[key];
  const {stdout}=await exec(process.execPath,[join(root,'bin/pi-9router-sync.js')],{env,timeout:15000});
  assert.equal(JSON.parse(stdout).official,'pi catalog');
  const viaManaged=JSON.parse(await readFile(file,'utf8')).providers['9router-fantastico'].models;
  assert.deepEqual(viaManaged.find(m=>m.id==='cc/claude-opus-5-5').thinkingLevelMap,{low:'low',max:'max'});
  await run();
  const good=await readFile(file,'utf8');
  // Gemini 4 Carbon: served but unlisted by the gateway. It is added from its
  // Argon sibling, never duplicated once the gateway lists it, and absent when
  // Argon is absent (the default fixture above).
  assert.equal(byId['ag/gemini-4-carbon-high'],undefined);
  const carbonRun=async m=>{mode=m;await writeFile(file,JSON.stringify(original));await run();mode='ok';return JSON.parse(await readFile(file,'utf8')).providers['9router-fantastico'].models;};
  let ms=await carbonRun('argon');
  const carbon=ms.find(m=>m.id==='ag/gemini-4-carbon-high');
  assert.ok(carbon,'carbon added from its argon sibling');
  assert.equal(carbon.contextWindow,1048576);assert.equal(carbon.reasoning,true);
  assert.equal(ms.filter(m=>m.id.startsWith('ag/gemini-4-carbon')).length,1); // only siblings that exist
  ms=await carbonRun('argon-listed-carbon');
  assert.equal(ms.filter(m=>m.id==='ag/gemini-4-carbon-high').length,1);
  assert.equal(ms.find(m=>m.id==='ag/gemini-4-carbon-high').contextWindow,2000000); // gateway row wins
  await writeFile(file,good);
  for (mode of ['http-error','empty','duplicate','invalid','redirect']) {
    await assert.rejects(run());assert.equal(await readFile(file,'utf8'),good);
  }
  assert.equal(sentCredential,false);assert.equal(catalogCalls,12);
  console.log('pi-catalog-sync: PASS (official metadata, managed install, unlisted Carbon, fallback, classifier filter, auth isolation, preservation, five fail-closed cases)');
} finally {
  await new Promise(resolve=>server.close(resolve));
  await rm(fixture,{recursive:true,force:true});
}
JS
