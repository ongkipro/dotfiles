#!/usr/bin/env bash
# Guard the upstream-native OMP boundary. Dotfiles may add context, skills, and
# an explicit reference overlay, but must not install or auto-load runtime state.
set -euo pipefail

SELF="$(readlink -f "$0" 2>/dev/null || realpath "$0")"
ROOT="${1:-$(cd "$(dirname "$SELF")/.." && pwd)}"

for installer in "$ROOT/install.sh" "$ROOT/install-macos.sh"; do
  for target in config.yml models.yml agents; do
    if grep -qF "link \"\$DOT/config/omp/$target\"" "$installer"; then
      echo "FAIL: $(basename "$installer") still installs OMP $target" >&2
      exit 1
    fi
  done
done

if grep -qE '^[[:space:]]*(function[[:space:]]+)?omp[[:space:]]*\(\)' "$ROOT/config/shell-tools.sh"; then
  echo 'FAIL: shell-tools.sh still overrides the upstream omp command' >&2
  exit 1
fi
if grep -q 'PI_CONFIG_FILES' "$ROOT/config/shell-tools.sh"; then
  echo 'FAIL: shell-tools.sh still injects a dotfiles-owned OMP config' >&2
  exit 1
fi

grep -qF '"$HOME/.omp/agent/AGENTS.md"' "$ROOT/bin/ai-memory-link" || {
  echo 'FAIL: shared memory is not wired to OMP native context discovery' >&2
  exit 1
}
grep -qF '"$HOME/.omp/agent/skills"' "$ROOT/skills/agents-bin/skill-update" || {
  echo 'FAIL: owned skills are not wired to OMP native skill discovery' >&2
  exit 1
}

for target in config.yml models.yml agents; do
  live="$HOME/.omp/agent/$target"
  tracked="$ROOT/config/omp/$target"
  if [ -L "$live" ] && [ "$(readlink "$live" 2>/dev/null)" = "$tracked" ]; then
    echo "FAIL: live OMP $target points to a dotfiles reference or retired override" >&2
    exit 1
  fi
done

echo 'omp-routing-test: OK (native runtime; explicit reference + shared memory/skills)'
