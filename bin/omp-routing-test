#!/usr/bin/env python3
"""Secret-free structural smoke test for tracked OMP routing and agents."""

import atexit
import json
import os
from pathlib import Path
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile

ROOT = Path(sys.argv[1] if len(sys.argv) > 1 else Path(__file__).resolve().parent.parent).resolve()
OMP_DIR = ROOT / "config" / "omp"
CONFIG_PATH = OMP_DIR / "config.yml"
MODELS_PATH = OMP_DIR / "models.yml"
AGENTS_DIR = OMP_DIR / "agents"


def fail(message):
    print("FAIL: " + message, file=sys.stderr)
    raise SystemExit(1)


def run(command, environment=None):
    return subprocess.run(
        command,
        env=environment,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )


def explicit_yaml_paths(source):
    """Return key paths from the constrained mapping structure in config.yml."""
    paths = set()
    parents = []
    key_pattern = re.compile(r"^(\s*)([A-Za-z][A-Za-z0-9_-]*):(?:\s|$)")
    for raw_line in source.splitlines():
        if not raw_line.strip() or raw_line.lstrip().startswith("#"):
            continue
        match = key_pattern.match(raw_line)
        if not match:
            continue
        indent = len(match.group(1))
        key = match.group(2)
        while parents and parents[-1][0] >= indent:
            parents.pop()
        path = tuple([entry[1] for entry in parents] + [key])
        paths.add(path)
        parents.append((indent, key))
    return paths


def parse_frontmatter(path):
    """Parse scalar keys from the deliberately simple agent frontmatter."""
    lines = path.read_text(encoding="utf-8").splitlines()
    if not lines or lines[0] != "---":
        fail("invalid agent frontmatter: " + str(path))
    metadata = {}
    closed = False
    for line in lines[1:]:
        if line == "---":
            closed = True
            break
        match = re.match(r"^([A-Za-z][A-Za-z0-9_-]*):\s*(.*?)\s*$", line)
        if not match:
            continue
        key, raw_value = match.groups()
        if len(raw_value) >= 2 and raw_value[0] == raw_value[-1] and raw_value[0] in "\"'":
            if raw_value[0] == '"':
                try:
                    raw_value = json.loads(raw_value)
                except json.JSONDecodeError as error:
                    fail("invalid quoted frontmatter in {}: {}".format(path, error))
            else:
                raw_value = raw_value[1:-1].replace("''", "'")
        metadata[key] = raw_value
    if not closed:
        fail("unterminated agent frontmatter: " + str(path))
    return metadata


def parse_custom_provider_models(path):
    """Extract provider -> {model-id: declared contextWindow or None} from models.yml.

    Callers take the smaller of the tracked declaration and a device-local
    catalog entry so a generous cache cannot mask a model that is too small for
    the compaction threshold.
    """
    providers = {}
    current_provider = None
    current_model = None
    in_providers = False
    in_models = False
    provider_pattern = re.compile(r"^  ([A-Za-z0-9_-]+):\s*$")
    model_pattern = re.compile(r'^      - id:\s*["\']?([^"\']+?)["\']?\s*$')
    context_pattern = re.compile(r"^\s+contextWindow:\s*(\d+)\s*$")
    for line in path.read_text(encoding="utf-8").splitlines():
        if line == "providers:":
            in_providers = True
            continue
        if not in_providers:
            continue
        if line and not line.startswith(" ") and not line.startswith("#"):
            break
        provider_match = provider_pattern.match(line)
        if provider_match:
            current_provider = provider_match.group(1)
            providers[current_provider] = {}
            current_model = None
            in_models = False
            continue
        if current_provider and line == "    models:":
            in_models = True
            continue
        if not in_models:
            continue
        model_match = model_pattern.match(line)
        if model_match:
            current_model = model_match.group(1)
            providers[current_provider][current_model] = None
            continue
        context_match = context_pattern.match(line)
        if context_match and current_model:
            providers[current_provider][current_model] = int(context_match.group(1))
    return providers

def parse_scalar_mapping(source, key, header_indent):
    """Parse one direct scalar mapping from the constrained tracked config."""
    lines = source.splitlines()
    header = (" " * header_indent) + key + ":"
    start = next(
        (index for index, line in enumerate(lines) if line.rstrip() == header),
        None,
    )
    if start is None:
        fail("tracked config is missing mapping: " + key)
    values = {}
    child_indent = header_indent + 2
    pattern = re.compile(
        r"^" + (" " * child_indent) + r"([A-Za-z][A-Za-z0-9_-]*):\s*(\S.*?)\s*$"
    )
    for line in lines[start + 1 :]:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        indent = len(line) - len(line.lstrip())
        if indent <= header_indent:
            break
        match = pattern.match(line)
        if not match:
            continue
        child_key, value = match.groups()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = json.loads(value) if value[0] == '"' else value[1:-1]
        values[child_key] = value
    return values


def parse_list_mapping(source, key, header_indent):
    """Parse one mapping of scalar keys to scalar lists from tracked YAML."""
    lines = source.splitlines()
    header = (" " * header_indent) + key + ":"
    start = next(
        (index for index, line in enumerate(lines) if line.rstrip() == header),
        None,
    )
    if start is None:
        fail("tracked config is missing mapping: " + key)
    values = {}
    current_key = None
    child_indent = header_indent + 2
    key_pattern = re.compile(
        r"^" + (" " * child_indent) + r"([^:#][^:]*):\s*$"
    )
    item_pattern = re.compile(
        r"^" + (" " * (child_indent + 2)) + r"-\s+(\S.*?)\s*$"
    )
    for line in lines[start + 1 :]:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        indent = len(line) - len(line.lstrip())
        if indent <= header_indent:
            break
        key_match = key_pattern.match(line)
        if key_match:
            current_key = key_match.group(1)
            values[current_key] = []
            continue
        item_match = item_pattern.match(line)
        if item_match and current_key is not None:
            values[current_key].append(item_match.group(1))
    return values


def parse_scalar_list(source, key, header_indent):
    """Parse one scalar list from the constrained tracked config."""
    lines = source.splitlines()
    header = (" " * header_indent) + key + ":"
    start = next(
        (index for index, line in enumerate(lines) if line.rstrip() == header),
        None,
    )
    if start is None:
        fail("tracked config is missing list: " + key)
    values = []
    item_pattern = re.compile(
        r"^" + (" " * (header_indent + 2)) + r"-\s+(\S.*?)\s*$"
    )
    for line in lines[start + 1 :]:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        indent = len(line) - len(line.lstrip())
        if indent <= header_indent:
            break
        match = item_pattern.match(line)
        if match:
            values.append(match.group(1))
    return values


def provider_of(selector):
    return str(selector).split("/", 1)[0]


def fallback_for(role, selector, fallback_chains):
    """Resolve the role-keyed or model-keyed recovery chain for one role."""
    if role in fallback_chains:
        return fallback_chains[role]
    model_key = selector.rsplit(":", 1)[0]
    matches = [
        values
        for key, values in fallback_chains.items()
        if "*" not in key and key.rstrip(":") == model_key
    ]
    return matches[0] if matches else None



def collect_role_references(value, references):
    if isinstance(value, dict):
        for child in value.values():
            collect_role_references(child, references)
    elif isinstance(value, list):
        for child in value:
            collect_role_references(child, references)
    elif isinstance(value, str) and value.startswith("@"):
        references.append(value)


CATALOG_PATH = Path.home() / ".omp" / "agent" / "models.db"


def load_catalog():
    """Return capability metadata for providers present in OMP's local cache.

    Each entry contains ``context``, ``efforts``, and the authoritative ``input``
    modality list. Provider-backed catalogs can be absent on a device that uses
    an overlay and has no authentication for that provider. Returns None when
    the cache itself is absent; callers separately report configured providers
    that could not be verified on this device.
    """
    if not CATALOG_PATH.is_file():
        return None
    catalog = {}
    try:
        connection = sqlite3.connect("file:{}?mode=ro".format(CATALOG_PATH), uri=True)
        try:
            rows = connection.execute("SELECT provider_id, models FROM model_cache").fetchall()
        finally:
            connection.close()
    except sqlite3.Error as error:
        fail("model catalog is unreadable: " + str(error))
    for provider_id, blob in rows:
        provider = str(provider_id).split(":", 1)[0]
        try:
            entries = json.loads(blob)
        except (TypeError, json.JSONDecodeError):
            continue
        for entry in entries:
            model_id = entry.get("id")
            if not model_id:
                continue
            thinking = entry.get("thinking") or {}
            catalog[(provider, model_id)] = {
                "context": entry.get("contextWindow"),
                "efforts": thinking.get("efforts") or [],
                "input": entry.get("input"),
            }
    return catalog or None


def split_selector(selector):
    """Split provider/model:effort. Model ids may themselves contain a slash."""
    provider, _, remainder = selector.partition("/")
    model_id, _, effort = remainder.rpartition(":")
    if not model_id:
        model_id, effort = remainder, ""
    return provider, model_id, effort

unverified_catalog_providers = set()


def check_selector(
    selector,
    catalog,
    threshold,
    where,
    declared_contexts=None,
    required_inputs=None,
):
    """Verify one selector against the catalog. Silent when it is sound."""
    if not isinstance(selector, str):
        fail("{}: not a provider/model selector: {!r}".format(where, selector))
    provider, model_id, effort = split_selector(selector)
    if not provider or not model_id:
        fail("{}: not a provider/model selector: {!r}".format(where, selector))
    if not effort:
        fail("{}: selector carries no reasoning suffix: {}".format(where, selector))
    if catalog is None:
        return
    entry = catalog.get((provider, model_id))
    if entry is None:
        catalog_providers = {key[0] for key in catalog}
        if provider not in catalog_providers:
            if provider not in unverified_catalog_providers:
                print(
                    "omp-routing-test: WARNING — provider {!r} is absent from this device's "
                    "model catalog; its configured selectors were structurally checked but "
                    "their model capabilities were NOT verified.".format(provider),
                    file=sys.stderr,
                )
                unverified_catalog_providers.add(provider)
            return
        fail("{}: model is absent from the catalog: {}".format(where, selector))
    efforts = entry["efforts"]
    if efforts:
        efforts_valid = isinstance(efforts, list) and all(
            isinstance(item, str) for item in efforts
        )
        if not efforts_valid:
            fail("{}: {} has invalid reasoning-level metadata".format(where, provider + "/" + model_id))
        if effort not in efforts:
            fail(
                "{}: {} does not support reasoning level {!r} (supports {})".format(
                    where, provider + "/" + model_id, effort, ", ".join(efforts)
                )
            )
    context = entry["context"]
    declared = (declared_contexts or {}).get(provider, {}).get(model_id)
    if isinstance(declared, int) and (not isinstance(context, int) or declared < context):
        # Trust the tracked declaration over a more generous cache entry.
        context = declared
    if not isinstance(context, int) or isinstance(context, bool):
        fail("{}: {} has no context-window metadata".format(where, provider + "/" + model_id))
    if context <= threshold:
        fail(
            "{}: {} holds {} tokens, at or below compaction.thresholdTokens ({})".format(
                where, provider + "/" + model_id, context, threshold
            )
        )
    required_inputs = set(required_inputs or ())
    if required_inputs:
        inputs = entry["input"]
        if not isinstance(inputs, list):
            fail(
                "{}: {} has no authoritative input-modality metadata; required {}".format(
                    where, provider + "/" + model_id, ", ".join(sorted(required_inputs))
                )
            )
        missing = {modality for modality in required_inputs if modality not in inputs}
        if missing:
            fail(
                "{}: {} lacks required input modality {}".format(
                    where, provider + "/" + model_id, ", ".join(sorted(missing))
                )
            )


def validate_routing_graph(
    context,
    roles,
    fallback_chains,
    provider_order,
    catalog,
    threshold,
    declared_contexts=None,
):
    """Validate selectors and recovery coverage shared by base and overlays."""
    if not isinstance(roles, dict) or not roles:
        fail("{} modelRoles must be a non-empty map".format(context))
    if (
        not isinstance(provider_order, list)
        or not provider_order
        or any(not isinstance(provider, str) or not provider for provider in provider_order)
    ):
        fail("{} modelProviderOrder must be a non-empty provider list".format(context))
    allowed_providers = set(provider_order)
    for role, selector in roles.items():
        where = "{} role {}".format(context, role)
        check_selector(
            selector,
            catalog,
            threshold,
            where,
            declared_contexts,
            required_inputs={"image"} if role in {"vision", "designer"} else None,
        )
        if provider_of(selector) not in allowed_providers:
            fail(
                "{}: primary provider {!r} is absent from modelProviderOrder {}".format(
                    where, provider_of(selector), provider_order
                )
            )

    if not isinstance(fallback_chains, dict) or not fallback_chains:
        fail("{} retry.fallbackChains must be a non-empty map".format(context))
    for key, selectors in fallback_chains.items():
        if not isinstance(key, str) or not key:
            fail("{} fallback chain has an invalid key: {!r}".format(context, key))
        if key in roles:
            matching_roles = [key]
        else:
            model_key = key[:-1] if key.endswith(":") else key
            key_provider, separator, key_model = model_key.partition("/")
            if "*" in key or not separator or not key_provider or not key_model:
                fail(
                    "{} fallback chain key is neither a configured role nor a model key: {}".format(
                        context, key
                    )
                )
            matching_roles = [
                role
                for role, selector in roles.items()
                if selector.rsplit(":", 1)[0] == model_key
            ]
            if not matching_roles:
                fail(
                    "{} model-keyed fallback chain {} matches no configured role model".format(
                        context, key
                    )
                )
        if not isinstance(selectors, list) or not selectors:
            fail("{} fallback {} must be a non-empty selector list".format(context, key))
        required_inputs = (
            {"image"}
            if any(role in {"vision", "designer"} for role in matching_roles)
            else None
        )
        for position, selector in enumerate(selectors):
            where = "{} fallback {}[{}]".format(context, key, position)
            check_selector(
                selector,
                catalog,
                threshold,
                where,
                declared_contexts,
                required_inputs=required_inputs,
            )
            if provider_of(selector) not in allowed_providers:
                fail(
                    "{}: provider {!r} is absent from modelProviderOrder {}".format(
                        where, provider_of(selector), provider_order
                    )
                )

    for role, selector in roles.items():
        chain = fallback_for(role, selector, fallback_chains)
        if chain is None:
            fail(
                "{} role {} has no fallback path, role-keyed or model-keyed".format(
                    context, role
                )
            )
        if chain[0] == selector:
            fail(
                "{} fallback for role {} repeats its primary selector: {}".format(
                    context, role, selector
                )
            )


for required_path, label in (
    (CONFIG_PATH, "OMP config"),
    (MODELS_PATH, "OMP provider metadata"),
    (AGENTS_DIR, "tracked OMP agents"),
):
    if not required_path.exists():
        fail("missing {}: {}".format(label, required_path))

config_source = CONFIG_PATH.read_text(encoding="utf-8")
explicit_paths = explicit_yaml_paths(config_source)
required_explicit_paths = {
    ("async", "enabled"),
    ("async", "maxJobs"),
    ("task", "batch"),
    ("task", "maxConcurrency"),
    ("task", "maxRecursionDepth"),
    ("task", "enableLsp"),
    ("task", "showResolvedModelBadge"),
    ("task", "isolation", "mode"),
    ("task", "isolation", "apply"),
    ("task", "isolation", "merge"),
    ("bash", "patterns"),
    ("task", "agentModelOverrides"),
    ("secrets", "enabled"),
    ("compaction", "thresholdTokens"),
    ("retry", "fallbackChains"),
}
for path in sorted(required_explicit_paths):
    if path not in explicit_paths:
        fail("tracked config must explicitly define " + ".".join(path))


static_roles = parse_scalar_mapping(config_source, "modelRoles", 0)
required_roles = {"default", "smol", "slow", "plan", "vision", "tiny", "task", "advisor"}
if not required_roles.issubset(static_roles):
    fail(
        "base tracked config is missing model roles: "
        + ", ".join(sorted(required_roles - static_roles))
    )

static_provider_order = parse_scalar_list(config_source, "modelProviderOrder", 0)
direct_providers = {"google-antigravity", "openai-codex", "anthropic"}
if set(static_provider_order) != direct_providers or len(static_provider_order) != len(direct_providers):
    fail(
        "base modelProviderOrder must contain exactly the three direct providers {}: {}".format(
            sorted(direct_providers), static_provider_order
        )
    )

static_fallback_chains = parse_list_mapping(config_source, "fallbackChains", 2)
validate_routing_graph(
    "base",
    static_roles,
    static_fallback_chains,
    static_provider_order,
    None,
    None,
)

# Every normal route starts in one pool and can recover through the other two.
# This is provider diversity, not a claim that any provider is available on a
# particular device.
for role, selector in static_roles.items():
    chain = fallback_for(role, selector, static_fallback_chains)
    route_providers = [provider_of(selector)] + [provider_of(item) for item in chain[:2]]
    if len(chain) < 2 or set(route_providers) != direct_providers:
        fail(
            "base route '{}' must span each direct provider once across its primary and first two "
            "fallback hops; got {}".format(role, route_providers)
        )

# Advisor and discovery primaries must be independent from the execution pool.
# Their first fallback keeps that independence; the execution provider is
# accepted only as the final availability-over-independence recovery hop.
execution_roles = [role for role in ("default", "task", "slow", "plan") if role in static_roles]
execution_providers = {provider_of(static_roles[role]) for role in execution_roles}
independent_roles = [
    role for role in static_roles if role.startswith("advisor") or role == "discovery"
]
for role in independent_roles:
    selector = static_roles[role]
    chain = fallback_for(role, selector, static_fallback_chains)
    if provider_of(selector) in execution_providers:
        fail(
            "independent role '{}' shares its primary provider with execution roles {}".format(
                role, execution_roles
            )
        )
    if provider_of(chain[0]) in execution_providers:
        fail(
            "independent role '{}' falls back to an execution provider before the final hop".format(
                role
            )
        )
    execution_hops = [
        index for index, item in enumerate(chain) if provider_of(item) in execution_providers
    ]
    if execution_hops and execution_hops != [len(chain) - 1]:
        fail(
            "independent role '{}' may use an execution provider only as its final "
            "availability fallback".format(role)
        )

custom_providers = parse_custom_provider_models(MODELS_PATH)
if not custom_providers:
    fail("models.yml contains no custom providers")
if not any(provider.startswith("9router") for provider in custom_providers):
    fail(
        "models.yml must retain an explicit 9Router reserve provider while normal routing "
        "keeps it out of roles and fallback chains"
    )
models_source = MODELS_PATH.read_text(encoding="utf-8")
if "127.0.0.1:20128" in models_source or "localhost:20128" in models_source:
    fail("models.yml must use the remote 9Router reserve, not a local gateway")

static_overrides = parse_scalar_mapping(config_source, "agentModelOverrides", 2)
if not static_overrides:
    fail("task.agentModelOverrides must be a non-empty map")
for agent, reference in static_overrides.items():
    if not reference.startswith("@") or reference[1:] not in static_roles:
        fail("bad @role reference for {}: {}".format(agent, reference))

for required_agent in ("architect", "complex-developer", "debugger"):
    if not (AGENTS_DIR / (required_agent + ".md")).is_file():
        fail("missing tracked custom agent: " + required_agent)
for path in sorted(AGENTS_DIR.glob("*.md")):
    metadata = parse_frontmatter(path)
    name = metadata.get("name")
    model = metadata.get("model")
    if name != path.stem:
        fail("custom agent name does not match its filename: " + str(path))
    if static_overrides.get(name) != model:
        fail("custom agent override does not match frontmatter: " + name)

runtime_manifest = ROOT / "config/ai/runtime-commands.txt"
runtime_commands = set(
    line.strip() for line in runtime_manifest.read_text(encoding="utf-8").splitlines()
    if line.strip() and not line.lstrip().startswith("#")
) if runtime_manifest.is_file() else set()

for installer in (ROOT / "install.sh", ROOT / "install-macos.sh"):
    if not installer.is_file():
        fail("missing installer: " + str(installer))
    source = installer.read_text(encoding="utf-8")
    if not re.search(r'link "\$DOT/config/omp/agents"\s+.*\.omp/agent/agents', source):
        fail("installer does not link tracked custom agents: " + str(installer))
    if "runtime-commands.txt" not in source or "omp-routing-test" not in runtime_commands:
        fail("installer does not link omp-routing-test: " + str(installer))

omp = shutil.which("omp")
if not omp:
    if os.environ.get("CI") == "true":
        print(
            "omp-routing-test: PARTIAL (static CI; roles={}, overrides={})".format(
                len(static_roles), len(static_overrides)
            )
        )
        print(
            "  omp is not installed, so this run checked file structure, @role wiring,"
            " and shared routing invariants only.",
            file=sys.stderr,
        )
        print(
            "  NOT checked: model existence, reasoning levels, context windows, input"
            " modalities, or overlays. Install omp in CI for a full pass.",
            file=sys.stderr,
        )
        raise SystemExit(0)
    fail("omp executable is unavailable")
omp_path = Path(omp)
if not omp_path.is_absolute() or not os.access(str(omp_path), os.X_OK):
    fail("omp does not resolve to an absolute executable path: " + omp)
version_result = run([omp, "--version"])
if version_result.returncode != 0:
    fail("omp executable cannot report its version: " + version_result.stderr.strip())
runtime_temporary = tempfile.TemporaryDirectory(prefix="omp-routing-test.")
atexit.register(runtime_temporary.cleanup)
runtime_root = Path(runtime_temporary.name) / "agent"
runtime_root.mkdir()
# Copy rather than link. The real `omp` binary is pointed at this directory, and
# `omp config list --json` is read-only today — but a test must not be one
# upstream change away from writing into the tracked repository. These files are
# a few kilobytes; the copy costs nothing and removes the hazard entirely.
for tracked_path in (CONFIG_PATH, MODELS_PATH, AGENTS_DIR):
    destination = runtime_root / tracked_path.name
    if tracked_path.is_dir():
        shutil.copytree(tracked_path, destination)
    else:
        shutil.copy2(tracked_path, destination)

runtime_environment = os.environ.copy()
runtime_environment["PI_CODING_AGENT_DIR"] = str(runtime_root)
runtime_result = run([omp, "config", "list", "--json"], runtime_environment)
if runtime_result.returncode != 0:
    fail("OMP rejected the tracked configuration: " + runtime_result.stderr.strip())
try:
    runtime_config = json.loads(runtime_result.stdout)
except json.JSONDecodeError as error:
    fail("OMP config inspection did not return valid JSON: " + str(error))


def runtime_value(key, source=None, where="base OMP parser"):
    entry = (runtime_config if source is None else source).get(key)
    if not isinstance(entry, dict) or "value" not in entry:
        fail("{} does not expose {}".format(where, key))
    return entry["value"]


expected_settings = {
    "async.enabled": True,
    "task.batch": True,
    "task.maxRecursionDepth": 1,
    "task.enableLsp": True,
    "task.showResolvedModelBadge": True,
    "task.isolation.mode": "auto",
    "task.isolation.apply": False,
    "task.isolation.merge": "patch",
    "secrets.enabled": True,
}
for setting, expected in expected_settings.items():
    if runtime_value(setting) != expected:
        fail("OMP did not accept {}={!r}".format(setting, expected))

dangerous_bash_patterns = runtime_value("bash.patterns")
required_denials = {
    "*git push --force*", "*git push -f *", "*git reset --hard*",
    "*git push -f", "*git clean -f*", "*git commit --amend*",
    "*rm -rf *", "*sudo *", "*wrangler deploy*", "*shopify theme push*",
}
if not isinstance(dangerous_bash_patterns, list):
    fail("bash.patterns must be a list")


def missing_required_denials(patterns):
    actual = {
        rule.get("match") for rule in patterns
        if isinstance(rule, dict) and rule.get("approval") == "deny"
    }
    return required_denials - actual


missing_denials = missing_required_denials(dangerous_bash_patterns)
if missing_denials:
    fail("OMP yolo requires tracked bash deny rules: " + ", ".join(sorted(missing_denials)))
# In-process mutation proof: removing one accepted rule must activate the same
# gate. This keeps the assertion from becoming a vacuous schema check.
mutant_patterns = [
    rule for rule in dangerous_bash_patterns
    if not (isinstance(rule, dict) and rule.get("match") == "*git reset --hard*")
]
if "*git reset --hard*" not in missing_required_denials(mutant_patterns):
    fail("bash deny-rule mutation probe did not activate the guard")

async_jobs = runtime_value("async.maxJobs")
task_concurrency = runtime_value("task.maxConcurrency")
if not isinstance(async_jobs, int) or isinstance(async_jobs, bool) or async_jobs <= 0:
    fail("async.maxJobs must be a positive integer")
if not isinstance(task_concurrency, int) or isinstance(task_concurrency, bool) or task_concurrency <= 0:
    fail("task.maxConcurrency must be a positive integer")
if task_concurrency > async_jobs:
    fail("task.maxConcurrency must not exceed async.maxJobs")

roles = runtime_value("modelRoles")
if not isinstance(roles, dict):
    fail("base modelRoles must be a map")
for role in ("default", "smol", "slow", "plan", "vision", "tiny", "task", "advisor"):
    selector = roles.get(role)
    if not isinstance(selector, str) or not selector:
        fail("base config is missing model role: " + role)

expected_role_selectors = {
    "default": "openai-codex/gpt-5.6-terra:medium",
    "task": "openai-codex/gpt-5.6-terra:medium",
    "slow": "openai-codex/gpt-5.6-sol:high",
    "plan": "openai-codex/gpt-5.6-terra:high",
    "tiny": "google-antigravity/gemini-3.7-flash:medium",
    "smol": "google-antigravity/gemini-3.7-flash:medium",
    "research": "google-antigravity/gemini-3.7-flash:minimal",
    "discovery": "google-antigravity/gemini-3.7-flash:high",
}
for role, selector in expected_role_selectors.items():
    if roles.get(role) != selector:
        fail(f"base role {role} must resolve to {selector}, got {roles.get(role)!r}")
if runtime_value("async.maxJobs") != 4 or runtime_value("task.maxConcurrency") != 3:
    fail("base concurrency must resolve to async.maxJobs=4 and task.maxConcurrency=3")

role_references = []
collect_role_references(runtime_value("task.agentModelOverrides"), role_references)
for reference in role_references:
    role = reference[1:]
    if not role or role not in roles:
        fail("bad @role reference: " + reference)

# Read the tracked file, not the runtime view. `runtime_value` returns OMP's
# resolved config, so a field deleted from config.yml comes back as OMP's own
# default and the removal is invisible — which is exactly how this one was
# dropped without anything noticing.
for required_key in ("defaultThinkingLevel", "cycleOrder", "modelProviderOrder"):
    if not re.search(r"^{}\s*:".format(re.escape(required_key)), config_source, re.M):
        fail("{} is missing from the tracked config.yml — it was silently dropped once "
             "before, and OMP's own default hides the loss at runtime".format(required_key))

cycle_order = runtime_value("cycleOrder")
if not isinstance(cycle_order, list) or not cycle_order:
    fail("cycleOrder must be a non-empty list")
for role in cycle_order:
    if role not in roles:
        fail("cycleOrder references missing role: " + str(role))

# ── Structural invariants the shared base config must keep ────────────────────
#
# A device once pushed its own single-provider preference into the shared
# config.yml instead of using an overlay, flattening ten of the thirteen roles
# onto one vendor and dropping `anthropic` from the provider order. Nothing
# caught it: every selector was still individually valid, so this test passed
# while the routing design was gone.
#
# These assert the design, not a model list. Swapping a model is fine; collapsing
# the structure is not. A device that wants one provider already has
# `config/omp/overlays/*.yml` and `omp --config <overlay>` for exactly that.
OVERLAY_HINT = ("If a device wants one provider, use an overlay "
                "(omp --config config/omp/overlays/<name>.yml) rather than editing the shared base.")


provider_order = runtime_value("modelProviderOrder")
if not isinstance(provider_order, list) or not provider_order:
    fail("modelProviderOrder must be a non-empty list")

# This runtime check mirrors primary-selector independence. The static checks
# above additionally enforce first-hop independence and confine an
# availability-over-independence execution-provider hop to the final position.
worker_roles = [r for r in ("default", "task", "slow", "plan") if r in roles]
worker_providers = {provider_of(roles[r]) for r in worker_roles}
for role in [r for r in roles if r.startswith("advisor") or r == "discovery"]:
    if provider_of(roles[role]) in worker_providers:
        fail(
            "vendor independence lost: '{}' resolves to provider '{}', which also runs the worker "
            "roles {}. A review lane sharing a vendor with the work it reviews is not independent. "
            .format(role, provider_of(roles[role]), sorted(worker_providers)) + OVERLAY_HINT
        )

for role, selector in roles.items():
    if provider_of(selector) not in provider_order:
        fail("role '{}' uses provider '{}', absent from modelProviderOrder {} — recovery cannot "
             "reach it. ".format(role, provider_of(selector), provider_order) + OVERLAY_HINT)

# Three capacity pools is the design, not a preference. Concentrating one tier on
# one vendor is a deliberate choice — `default`/`task`/`slow`/`plan` all sit on
# Codex today, by decision. Concentrating *everything* is the collapse this test
# exists to catch, and checking the advisor tier alone did not catch it: a config
# with every worker on one vendor and one anthropic advisor still passed.
role_providers = {provider_of(sel) for sel in roles.values()}
if len(role_providers) < 3:
    fail(
        "the role set spans only {} provider(s) {} — ROUTING.md's design is three capacity "
        "pools (volume, precision, judgment) and collapsing them loses the recovery and "
        "independence the split exists for. ".format(len(role_providers), sorted(role_providers))
        + OVERLAY_HINT
    )


fallback_chains = runtime_value("retry.fallbackChains")

# ── Capability validation ────────────────────────────────────────────────────
# Everything above proves the routing graph refers to itself consistently. None of
# it proves the models named in that graph exist or can do what is asked of them.
# That evidence lives in one place only: OMP's own model cache.
threshold = runtime_value("compaction.thresholdTokens")
if not isinstance(threshold, int) or isinstance(threshold, bool) or threshold <= 0:
    fail("compaction.thresholdTokens must be a positive integer")

catalog = load_catalog()
if catalog is None:
    print(
        "omp-routing-test: WARNING — model catalog {} is unavailable, so model existence,"
        " reasoning levels, context windows, and input modalities were NOT verified. Run"
        " `omp models` once on this device to populate it.".format(CATALOG_PATH),
        file=sys.stderr,
    )

validate_routing_graph(
    "base",
    roles,
    fallback_chains,
    provider_order,
    catalog,
    threshold,
    custom_providers,
)
for selector in list(roles.values()) + [item for chain in fallback_chains.values() for item in chain]:
    if "flash-lite" in selector.lower():
        fail("reachable base routing selector uses Gemini Flash Lite: " + selector)


bundled_directory = Path(runtime_temporary.name) / "bundled-agents"
bundled_directory.mkdir()
unpack_result = run(
    [omp, "agents", "unpack", "--dir", str(bundled_directory), "--force", "--json"]
)
if unpack_result.returncode != 0:
    fail("unable to inspect bundled OMP agents: " + unpack_result.stderr.strip())

available_agents = set()
for path in sorted(bundled_directory.glob("*.md")):
    name = parse_frontmatter(path).get("name")
    if not name:
        fail("bundled agent has no name: " + str(path))
    available_agents.add(name)
if not available_agents:
    fail("OMP unpack returned no bundled agents")

for required_agent in ("architect", "complex-developer", "debugger"):
    if not (AGENTS_DIR / (required_agent + ".md")).is_file():
        fail("missing tracked custom agent: " + required_agent)

overrides = runtime_value("task.agentModelOverrides")
if not isinstance(overrides, dict) or not overrides:
    fail("task.agentModelOverrides must be a non-empty map")

for path in sorted(AGENTS_DIR.glob("*.md")):
    metadata = parse_frontmatter(path)
    name = metadata.get("name")
    model = metadata.get("model")
    if name != path.stem:
        fail("custom agent name does not match its filename: " + str(path))
    if not isinstance(model, str) or not model.startswith("@"):
        fail("custom agent must reference an @role: " + str(path))
    if model[1:] not in roles:
        fail("custom agent {} references missing role: {}".format(name, model))
    if overrides.get(name) != model:
        fail("custom agent override does not match frontmatter: " + name)
    available_agents.add(name)

for agent in overrides:
    if agent not in available_agents:
        fail("agent override target is neither bundled nor tracked: " + agent)

# An agent may declare its own reasoning level, which then has to be a level the
# role's model actually exposes. This is what pins `research` to a model offering
# `minimal`: move the role and librarian breaks, silently, at call time.
if catalog is not None:
    for path in sorted(AGENTS_DIR.glob("*.md")):
        metadata = parse_frontmatter(path)
        declared = metadata.get("thinkingLevel")
        if not declared or declared == "auto":
            continue
        selector = roles.get(str(metadata.get("model", ""))[1:])
        if not selector:
            continue
        provider, model_id, _ = split_selector(selector)
        entry = catalog.get((provider, model_id))
        if entry and entry["efforts"] and declared not in entry["efforts"]:
            fail(
                "agent {} declares thinkingLevel {!r} but its role model {} supports {}".format(
                    metadata.get("name"), declared, provider + "/" + model_id,
                    ", ".join(entry["efforts"]),
                )
            )

# ── Overlays ─────────────────────────────────────────────────────────────────
# Overlays are half the routing surface and were previously unread: deleting one,
# or filling it with invalid YAML, passed green. They cannot go through
# `omp config list --config` because that subcommand rejects the flag, so each is
# handed to OMP as a config.yml of its own and resolved by the same parser.
#
# A single-provider overlay may reduce capability, but it must not quietly
# re-decide which model owns ordinary development. codex-only.yml previously
# flattened `default`/`task` onto Sol — the model the tracked config reserves
# for complex, high-risk work — so an operator opting into one provider also
# opted into a different execution policy without saying so.
OVERLAY_ROLE_EXPECTATIONS = {
    "codex-only.yml": {
        "default": "openai-codex/gpt-5.6-terra:medium",
        "task": "openai-codex/gpt-5.6-terra:medium",
        "slow": "openai-codex/gpt-5.6-sol:high",
        "plan": "openai-codex/gpt-5.6-terra:high",
    },
}
overlays_directory = OMP_DIR / "overlays"
overlay_count = 0
for overlay_path in sorted(overlays_directory.glob("*.yml")):
    overlay_count += 1
    overlay_root = Path(runtime_temporary.name) / ("overlay-" + overlay_path.stem) / "agent"
    overlay_root.mkdir(parents=True)
    shutil.copy2(overlay_path, overlay_root / "config.yml")
    shutil.copy2(MODELS_PATH, overlay_root / "models.yml")
    shutil.copytree(AGENTS_DIR, overlay_root / "agents")
    overlay_environment = os.environ.copy()
    overlay_environment["PI_CODING_AGENT_DIR"] = str(overlay_root)
    overlay_result = run([omp, "config", "list", "--json"], overlay_environment)
    if overlay_result.returncode != 0:
        fail(
            "OMP rejected overlay {}: {}".format(
                overlay_path.name, overlay_result.stderr.strip()
            )
        )
    try:
        overlay_config = json.loads(overlay_result.stdout)
    except json.JSONDecodeError as error:
        fail("overlay {} did not parse: {}".format(overlay_path.name, error))
    overlay_context = "overlay {}".format(overlay_path.name)
    overlay_roles = runtime_value("modelRoles", overlay_config, overlay_context)
    if not isinstance(overlay_roles, dict) or not overlay_roles:
        fail("{} defines no model roles".format(overlay_context))
    missing = sorted(set(roles) - set(overlay_roles))
    if missing:
        # A role absent from an overlay cannot resolve in a single-provider session,
        # so any agent mapped to it fails the moment it is dispatched.
        fail(
            "{} is missing roles defined in config.yml: {}".format(
                overlay_context, ", ".join(missing)
            )
        )
    overlay_provider_order = runtime_value(
        "modelProviderOrder", overlay_config, overlay_context
    )
    if (
        not isinstance(overlay_provider_order, list)
        or len(overlay_provider_order) != 1
        or not isinstance(overlay_provider_order[0], str)
        or not overlay_provider_order[0]
    ):
        fail(
            "{} modelProviderOrder must contain exactly one provider: {}".format(
                overlay_context, overlay_provider_order
            )
        )
    overlay_fallback_chains = runtime_value(
        "retry.fallbackChains", overlay_config, overlay_context
    )
    validate_routing_graph(
        overlay_context,
        overlay_roles,
        overlay_fallback_chains,
        overlay_provider_order,
        catalog,
        threshold,
        custom_providers,
    )
    for selector in list(overlay_roles.values()) + [item for chain in overlay_fallback_chains.values() for item in chain]:
        if "flash-lite" in selector.lower():
            fail("{} reaches Gemini Flash Lite: {}".format(overlay_context, selector))
    for role, selector in OVERLAY_ROLE_EXPECTATIONS.get(overlay_path.name, {}).items():
        if overlay_roles.get(role) != selector:
            fail(
                "{} role {} must resolve to {}, got {!r}".format(
                    overlay_context, role, selector, overlay_roles.get(role)
                )
            )
if overlay_count == 0:
    fail("no overlays found in " + str(overlays_directory))

for installer in (ROOT / "install.sh", ROOT / "install-macos.sh"):
    if not installer.is_file():
        fail("missing installer: " + str(installer))
    source = installer.read_text(encoding="utf-8")
    if not re.search(r'link "\$DOT/config/omp/agents"\s+.*\.omp/agent/agents', source):
        fail("installer does not link tracked custom agents: " + str(installer))
    if "runtime-commands.txt" not in source or "omp-routing-test" not in runtime_commands:
        fail("installer does not link omp-routing-test: " + str(installer))

print(
    "omp-routing-test: OK (roles={}, overrides={}, async={}, overlays={}, catalog={})".format(
        len(roles),
        len(overrides),
        async_jobs,
        overlay_count,
        "{} models".format(len(catalog)) if catalog else "UNVERIFIED",
    )
)
runtime_temporary.cleanup()
