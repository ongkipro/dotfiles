#!/usr/bin/env bash
set -euo pipefail
ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd)}"; TMP="$(mktemp -d "${TMPDIR:-/tmp}/delivery-skill-usage-test.XXXXXX")"; trap 'rm -rf "$TMP"' EXIT
REPO="$TMP/repo"; mkdir -p "$REPO/.delivery/runs"; cd "$REPO"; git init -q; git config user.email test@example.com; git config user.name test; echo 'State: REVIEWING' > STATUS.md; git add STATUS.md; git commit -qm init
python3 - "$REPO/.delivery/runs/RUN-test.jsonl" <<'PY'
import hashlib,json,subprocess,sys
p=sys.argv[1]; head=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(); prev=None
def dig(d): return hashlib.sha256(json.dumps(d,sort_keys=True,separators=(',',':'),ensure_ascii=True).encode()).hexdigest()
def add(e):
 global prev
 e['prevEventHash']=prev; e['eventHash']=dig(e);prev=e['eventHash'];open(p,'a').write(json.dumps(e,sort_keys=True,separators=(',',':'))+'\n')
b={'runId':'RUN-test','state':'REVIEWING','head':head}
add({**b,'eventId':'1','time':'2026-08-15T00:00:00Z','type':'run_started','task':'TASK-1','requirement':'REQ-1','risk':'R1','worker':'coder','model':'m'})
add({**b,'eventId':'2','time':'2026-08-15T00:01:00Z','type':'verification','check':'unit','status':'PASS','detail':'ok'})
add({**b,'eventId':'3','time':'2026-08-15T00:02:00Z','type':'run_finished','result':'PASS','detail':'done'})
PY

# The immutable writer itself is synchronized so this fails deterministically
# with replace semantics: both writers would report success for one pathname.
python3 - "$ROOT/bin/delivery-skill-usage" "$TMP/exclusive.json" <<'PY'
import json,multiprocessing,runpy,sys
write=runpy.run_path(sys.argv[1])['atomic']; target=sys.argv[2]
ctx=multiprocessing.get_context('fork'); barrier=ctx.Barrier(2); results=ctx.Queue()
def worker(name):
    barrier.wait()
    try:
        write(__import__('pathlib').Path(target),{'writer':name})
        results.put(('created',name))
    except ValueError as exc:
        results.put(('rejected',str(exc)))
workers=[ctx.Process(target=worker,args=(name,)) for name in ('alpha','beta')]
for process in workers: process.start()
for process in workers: process.join(5)
assert all(process.exitcode == 0 for process in workers), [process.exitcode for process in workers]
out=[results.get(timeout=1) for _ in workers]
assert [status for status,_ in out].count('created') == 1, out
assert [status for status,_ in out].count('rejected') == 1, out
assert 'immutable' in next(detail for status,detail in out if status == 'rejected')
assert json.load(open(target))['writer'] in {'alpha','beta'}
PY

"$ROOT/bin/delivery-skill-usage" --repo "$REPO" record --run RUN-test --skill cloudflare --skill native-first
python3 "$ROOT/bin/delivery-skill-usage" --repo "$REPO" verify --json > "$TMP/o.json"
python3 - "$TMP/o.json" "$REPO/.delivery/skill-usage/RUN-test.json" <<'PY'
import json,sys
x=json.load(open(sys.argv[1]));d=json.load(open(sys.argv[2]));assert x['result']=='VERIFIED';assert d['skillsUsed']==['cloudflare','native-first'];assert d['result']=='PASS';assert d['verificationFailed'] is False
PY
if "$ROOT/bin/delivery-skill-usage" --repo "$REPO" record --run RUN-test --skill cloudflare >/dev/null 2>&1; then echo FAIL >&2;exit 1;fi
USAGE="$REPO/.delivery/skill-usage/RUN-test.json"
cp "$USAGE" "$TMP/usage.backup"
python3 - "$USAGE" <<'PY'
import hashlib,json,sys
p=sys.argv[1]; d=json.load(open(p)); d['worker']='forged'; d.pop('usageHash')
d['usageHash']=hashlib.sha256(json.dumps(d,sort_keys=True,separators=(',',':'),ensure_ascii=True).encode()).hexdigest(); json.dump(d,open(p,'w'),indent=2,sort_keys=True)
PY
set +e; "$ROOT/bin/delivery-skill-usage" --repo "$REPO" verify >/dev/null 2>&1; rc=$?; set -e
[ "$rc" -eq 2 ] || { echo 'recomputed usage self-hash must not replace source provenance' >&2; exit 1; }
cp "$TMP/usage.backup" "$USAGE"

# Browser-visible work cannot be finished by a green build. A second run changes
# a rendered surface and records skills that do not include ui-validation; the
# gate must refuse it, then accept the same run once the evidence is claimed.
# The trigger is the boundary check's observed paths, not the recorded skills,
# so an agent cannot talk its way past it.
UIREPO="$TMP/uirepo"; mkdir -p "$UIREPO/.delivery/runs"; (cd "$UIREPO"; git init -q; git config user.email t@e.com; git config user.name t; echo x > STATUS.md; git add STATUS.md; git commit -qm init)
python3 - "$UIREPO/.delivery/runs/RUN-ui.jsonl" "$UIREPO" <<'PY'
import hashlib,json,subprocess,sys
p,repo=sys.argv[1],sys.argv[2]
head=subprocess.check_output(['git','-C',repo,'rev-parse','HEAD'],text=True).strip(); prev=None
def dig(d): return hashlib.sha256(json.dumps(d,sort_keys=True,separators=(',',':'),ensure_ascii=True).encode()).hexdigest()
def add(e):
 global prev
 e['prevEventHash']=prev; e['eventHash']=dig(e); prev=e['eventHash']; open(p,'a').write(json.dumps(e,sort_keys=True,separators=(',',':'))+'\n')
b={'runId':'RUN-ui','state':'REVIEWING','head':head}
add({**b,'eventId':'1','time':'2026-08-31T00:00:00Z','type':'run_started','task':'TASK-1','requirement':'REQ-1','risk':'R2','worker':'coder','model':'m'})
add({**b,'eventId':'2','time':'2026-08-31T00:01:00Z','type':'boundary_check','result':'PASS','taskOwnedChanges':[
  {'path':'src/components/Card.tsx','classification':'ALLOWED'},
  {'path':'src/components/Card.test.tsx','classification':'ALLOWED'},
  {'path':'src/lib/money.ts','classification':'ALLOWED'}]})
add({**b,'eventId':'3','time':'2026-08-31T00:02:00Z','type':'verification','check':'unit','status':'PASS','detail':'ok'})
add({**b,'eventId':'4','time':'2026-08-31T00:03:00Z','type':'run_finished','result':'PASS','detail':'done'})
PY
"$ROOT/bin/delivery-skill-usage" --repo "$UIREPO" record --run RUN-ui --skill nextjs-development >/dev/null
set +e; out="$("$ROOT/bin/delivery-skill-usage" --repo "$UIREPO" verify 2>&1)"; rc=$?; set -e
[ "$rc" -eq 2 ] || { echo 'a PASS run that changed a rendered surface must fail without ui-validation' >&2; exit 1; }
grep -q 'Card.tsx' <<<"$out" || { echo 'the refusal must name the rendered path it saw' >&2; exit 1; }
grep -q 'Card.test.tsx' <<<"$out" && { echo 'a component test is not a rendered surface and must not trigger the gate' >&2; exit 1; }

rm "$UIREPO/.delivery/skill-usage/RUN-ui.json"
"$ROOT/bin/delivery-skill-usage" --repo "$UIREPO" record --run RUN-ui --skill nextjs-development --skill ui-validation >/dev/null
"$ROOT/bin/delivery-skill-usage" --repo "$UIREPO" verify >/dev/null || { echo 'claiming ui-validation must clear the gate' >&2; exit 1; }

echo 'delivery-skill-usage-test: PASS'
