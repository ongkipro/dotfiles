#!/usr/bin/env bash
set -euo pipefail
ROOT="${1:-$(cd "$(dirname "$0")/.." && pwd)}"; TMP="$(mktemp -d "${TMPDIR:-/tmp}/delivery-skill-usage-test.XXXXXX")"; trap 'rm -rf "$TMP"' EXIT
REPO="$TMP/repo"; mkdir -p "$REPO/.delivery/runs"; cd "$REPO"; git init -q; git config user.email test@example.com; git config user.name test; echo 'State: REVIEWING' > STATUS.md; git add STATUS.md; git commit -qm init
python3 - "$REPO/.delivery/runs/RUN-test.jsonl" <<'PY'
import hashlib,json,subprocess,sys
p=sys.argv[1]; head=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip(); prev=None
def dig(d): return hashlib.sha256(json.dumps(d,sort_keys=True,separators=(',',':'),ensure_ascii=True).encode()).hexdigest()
def add(e):
 global prev
 e['prevEventHash']=prev; e['eventHash']=dig(e);prev=e['eventHash'];open(p,'a').write(json.dumps(e,sort_keys=True,separators=(',',':'))+'\n')
b={'runId':'RUN-test','state':'REVIEWING','head':head}
add({**b,'eventId':'1','time':'2026-08-15T00:00:00Z','type':'run_started','task':'TASK-1','requirement':'REQ-1','risk':'R1','worker':'coder','model':'m'})
add({**b,'eventId':'2','time':'2026-08-15T00:01:00Z','type':'verification','check':'unit','status':'PASS','detail':'ok'})
add({**b,'eventId':'3','time':'2026-08-15T00:02:00Z','type':'run_finished','result':'PASS','detail':'done'})
PY
"$ROOT/bin/delivery-skill-usage" --repo "$REPO" record --run RUN-test --skill cloudflare --skill native-first
python3 "$ROOT/bin/delivery-skill-usage" --repo "$REPO" verify --json > "$TMP/o.json"
python3 - "$TMP/o.json" "$REPO/.delivery/skill-usage/RUN-test.json" <<'PY'
import json,sys
x=json.load(open(sys.argv[1]));d=json.load(open(sys.argv[2]));assert x['result']=='VERIFIED';assert d['skillsUsed']==['cloudflare','native-first'];assert d['result']=='PASS';assert d['verificationFailed'] is False
PY
if "$ROOT/bin/delivery-skill-usage" --repo "$REPO" record --run RUN-test --skill cloudflare >/dev/null 2>&1; then echo FAIL >&2;exit 1;fi
USAGE="$REPO/.delivery/skill-usage/RUN-test.json"
cp "$USAGE" "$TMP/usage.backup"
python3 - "$USAGE" <<'PY'
import hashlib,json,sys
p=sys.argv[1]; d=json.load(open(p)); d['worker']='forged'; d.pop('usageHash')
d['usageHash']=hashlib.sha256(json.dumps(d,sort_keys=True,separators=(',',':'),ensure_ascii=True).encode()).hexdigest(); json.dump(d,open(p,'w'),indent=2,sort_keys=True)
PY
set +e; "$ROOT/bin/delivery-skill-usage" --repo "$REPO" verify >/dev/null 2>&1; rc=$?; set -e
[ "$rc" -eq 2 ] || { echo 'recomputed usage self-hash must not replace source provenance' >&2; exit 1; }
cp "$TMP/usage.backup" "$USAGE"
echo 'delivery-skill-usage-test: PASS'
