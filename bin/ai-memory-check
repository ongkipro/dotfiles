#!/usr/bin/env node

const assert = require("node:assert/strict");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const repoRoot = path.resolve(path.dirname(fs.realpathSync(__filename)), "..");

function markdownFiles(entry) {
  if (!fs.existsSync(entry)) return [];
  const stat = fs.statSync(entry);
  if (stat.isFile()) return entry.endsWith(".md") ? [entry] : [];
  if (!stat.isDirectory()) return [];

  return fs.readdirSync(entry, { withFileTypes: true }).flatMap((item) =>
    markdownFiles(path.join(entry, item.name)),
  );
}

function visibleLines(markdown) {
  let fence = null;
  return markdown.split(/\r?\n/).map((line) => {
    const match = line.match(/^\s*(`{3,}|~{3,})/);
    if (match) {
      const marker = match[1][0];
      if (fence === marker) fence = null;
      else if (!fence) fence = marker;
      return "";
    }
    if (fence) return "";
    return line.replace(/`[^`]*`/g, "");
  });
}

function linkTarget(raw) {
  let value = raw.trim();
  if (value.startsWith("<") && value.includes(">")) {
    value = value.slice(1, value.indexOf(">"));
  } else {
    value = value.split(/\s+["']/)[0];
  }
  try {
    return decodeURIComponent(value);
  } catch {
    return value;
  }
}

function isExternal(target) {
  return /^(?:[a-z][a-z0-9+.-]*:|\/\/)/i.test(target);
}

function buildBasenameIndex(files) {
  const index = new Map();
  for (const file of files) {
    const key = path.basename(file, ".md").toLowerCase();
    const matches = index.get(key) || [];
    matches.push(file);
    index.set(key, matches);
  }
  return index;
}

function scan(files) {
  const issues = [];
  let checked = 0;
  const basenameIndex = buildBasenameIndex(files);

  for (const file of files) {
    const lines = visibleLines(fs.readFileSync(file, "utf8"));
    lines.forEach((line, index) => {
      const lineNumber = index + 1;

      for (const match of line.matchAll(/!?\[[^\]]*\]\(([^)]+)\)/g)) {
        let target = linkTarget(match[1]);
        if (!target || target.startsWith("#") || isExternal(target)) continue;
        target = target.split("#", 1)[0].split("?", 1)[0];
        if (!target) continue;
        checked += 1;
        const resolved = path.isAbsolute(target)
          ? target
          : path.resolve(path.dirname(file), target);
        if (!fs.existsSync(resolved)) {
          issues.push({ file, lineNumber, target, reason: "missing Markdown target" });
        }
      }

      for (const match of line.matchAll(/\[\[([^\]]+)\]\]/g)) {
        let target = match[1].split("|", 1)[0].split("#", 1)[0].trim();
        if (!target) continue;
        checked += 1;

        let candidates;
        if (target.includes("/") || target.endsWith(".md")) {
          const relative = target.endsWith(".md") ? target : `${target}.md`;
          const resolved = path.resolve(path.dirname(file), relative);
          candidates = fs.existsSync(resolved) ? [resolved] : [];
        } else {
          candidates = basenameIndex.get(target.toLowerCase()) || [];
        }

        if (candidates.length === 0) {
          issues.push({ file, lineNumber, target, reason: "missing wikilink target" });
        } else if (candidates.length > 1) {
          issues.push({ file, lineNumber, target, reason: "ambiguous wikilink target" });
        }
      }
    });
  }

  return { issues, checked };
}

function selfTest() {
  const temp = fs.mkdtempSync(path.join(os.tmpdir(), "ai-memory-check."));
  try {
    fs.mkdirSync(path.join(temp, "memory"));
    fs.writeFileSync(path.join(temp, "memory", "target.md"), "# Target\n");
    fs.writeFileSync(
      path.join(temp, "memory", "good.md"),
      [
        "[target](target.md)",
        "[[target]]",
        "`[[not-a-link]]`",
        "```md",
        "[ignored](missing.md)",
        "```",
        "[external](https://example.com)",
      ].join("\n"),
    );
    let result = scan(markdownFiles(temp));
    assert.equal(result.issues.length, 0);
    assert.equal(result.checked, 2);

    fs.writeFileSync(path.join(temp, "memory", "bad.md"), "[broken](missing.md)\n");
    result = scan(markdownFiles(temp));
    assert.equal(result.issues.length, 1);
    assert.equal(result.issues[0].reason, "missing Markdown target");
    console.log("ai-memory-check --self-test: OK");
  } finally {
    fs.rmSync(temp, { recursive: true, force: true });
  }
}

if (process.argv.includes("--self-test")) {
  selfTest();
  process.exit(0);
}

const requested = process.argv.slice(2);
const entries = requested.length
  ? requested.map((entry) => path.resolve(entry))
  : [
      path.join(repoRoot, "README.md"),
      path.join(repoRoot, "config", "ai"),
      path.join(repoRoot, "config", "claude-memory"),
    ];
const files = [...new Set(entries.flatMap(markdownFiles))].sort();
const result = scan(files);

for (const issue of result.issues) {
  const source = path.relative(repoRoot, issue.file) || issue.file;
  console.error(`${source}:${issue.lineNumber}: ${issue.reason}: ${issue.target}`);
}

if (result.issues.length > 0) {
  console.error(
    `ai-memory-check: FAILED (${result.issues.length} issue(s), ${result.checked} link(s) checked)`,
  );
  process.exit(1);
}

console.log(`ai-memory-check: OK (${files.length} file(s), ${result.checked} link(s) checked)`);
