#!/usr/bin/env bash
# Regression checks for bin/ai-rule-lock (TASK-170): drift is detected, a rename
# is restored, a deleted slot fails, and only the password re-signs a rule change.
set -euo pipefail
DOT="${1:-$(cd "$(dirname "$0")/.." && pwd)}"
T="$(mktemp -d)"; trap 'rm -rf "$T"' EXIT
fail() { echo "FAIL: $*"; exit 1; }
ok() { echo "  ✓ $*"; }

mkdir -p "$T/bin"
cp -R "$DOT/config" "$T/config"
cp "$DOT/bin/ai-rule-lock" "$DOT/bin/ai-memory-link" "$T/bin/"
L="$T/bin/ai-rule-lock"
# Never touch this device's real pin; start from an unsigned copy of the rules.
export AI_RULE_LOCK_PIN="$T/pin/locked-rules.pinned.json"
unset AI_RULE_LOCK_KEY AI_RULE_LOCK_OLD_KEY
python3 - "$T/config/ai/locked-rules.json" <<'PY'
import json, sys; p = sys.argv[1]; d = json.load(open(p))
for k in ("publicKey", "signature", "keyEndorsement"): d.pop(k, None)
d["kdf"]["salt"] = ""; open(p, "w").write(json.dumps(d, indent=2, ensure_ascii=False) + "\n")
PY
CORE="$T/config/ai/CORE.md"

"$L" check --root "$T" >/dev/null 2>&1 || fail "clean copy reports drift"
ok "clean tree: no drift"

# 1. bold rename in CORE
sed -i.bak 's/Address the user as \*\*Paduka Ongki\*\*\./Address the user as **Paduka Olan**./' "$CORE"
grep -q 'Paduka Olan' "$CORE" || fail "fixture rename did not apply"
if "$L" check --root "$T" >/dev/null 2>&1; then fail "rename to Paduka Olan not detected"; fi
"$L" repair --root "$T" >/dev/null 2>&1 || fail "repair failed"
grep -q 'Address the user as \*\*Paduka Ongki\*\*\.' "$CORE" || fail "CORE not restored"
grep -q 'Paduka Olan' "$CORE" && fail "Paduka Olan survived repair"
ok "Paduka Olan in CORE is detected and restored"

# 2. bare name, no period, end of line
python3 - "$CORE" <<'PY'
import re, sys; p = sys.argv[1]; s = open(p).read()
open(p, "w").write(s.replace("Address the user as **Paduka Ongki**.", "Address the user as Olan\n", 1))
PY
"$L" repair --root "$T" >/dev/null 2>&1 || fail "repair of bare name failed"
grep -q 'Address the user as \*\*Paduka Ongki\*\*\.' "$CORE" || fail "bare 'Olan' not restored"
ok "bare 'Olan' is restored"

# 3. memory slot and the Paduka guard
ID="$T/config/ai/memory/identity.md"
sed -i.bak 's/^- Preferred name \/ form of address:.*$/- Preferred name \/ form of address: Olan/' "$ID"
printf '\nNote: Paduka Olan prefers short replies. Paduka adalah sapaan.\n' >> "$T/config/ai/memory/workflow.md"
"$L" repair --root "$T" >/dev/null 2>&1 || fail "repair of memory failed"
grep -q '^- Preferred name / form of address: Paduka Ongki\.$' "$ID" || fail "identity slot not restored"
grep -q 'Note: Paduka Ongki prefers short replies\. Paduka adalah sapaan\.' "$T/config/ai/memory/workflow.md" \
  || fail "forbid guard wrong (must fix 'Paduka Olan', keep lowercase 'Paduka adalah')"
ok "memory slot and 'Paduka <other name>' guard repaired; plain 'Paduka adalah' untouched"

# 4. locked blocks: edited, then markers deleted
MA="$T/config/ai/memory/meta-ads.md"
sed -i.bak 's/There is no "dotads" app repository\./dotads is the commerce app./' "$MA"
"$L" repair --root "$T" >/dev/null 2>&1 || fail "block repair failed"
grep -q 'There is no "dotads" app repository\.' "$MA" || fail "dotads block not restored"
python3 - "$T/config/ai/memory/skills.md" <<'PY'
import re, sys; p = sys.argv[1]; s = open(p).read()
open(p, "w").write(re.sub(r"<!-- locked:dotuiux-name -->.*?<!-- /locked:dotuiux-name -->\n", "", s, flags=re.S))
PY
grep -q 'locked:dotuiux-name' "$T/config/ai/memory/skills.md" && fail "fixture did not delete block"
"$L" repair --root "$T" >/dev/null 2>&1 || fail "re-adding a deleted block failed"
grep -q '"dotuiux" always means the dotfiles UI/UX CLI' "$T/config/ai/memory/skills.md" || fail "dotuiux block not re-added"
"$L" check --root "$T" >/dev/null 2>&1 || fail "drift remains after repairs"
ok "dotads block restored; deleted dotuiux block re-added"

# 5. deleted slot cannot be guessed: it must fail loudly
python3 - "$CORE" <<'PY'
import sys; p = sys.argv[1]; s = open(p).read()
open(p, "w").write(s.replace("Address the user as **Paduka Ongki**.", "", 1))
PY
if "$L" repair --root "$T" >/dev/null 2>&1; then fail "deleted CORE slot passed repair"; fi
if AI_DIR="$T/config/ai" "$T/bin/ai-memory-link" --check >/dev/null 2>&1; then fail "ai-memory-link --check passed a deleted slot"; fi
cp "$DOT/config/ai/CORE.md" "$CORE"
ok "deleted slot fails repair and ai-memory-link --check"

# 6. ai-memory-link --check reports drift; plain link mode would restore it
sed -i.bak 's/Paduka Ongki\./Paduka Olan./' "$T/config/ai/memory/preferences.md"
out="$(AI_DIR="$T/config/ai" "$T/bin/ai-memory-link" --check 2>&1 || true)"
printf '%s' "$out" | grep -q 'locked rules drifted' || fail "ai-memory-link --check did not report locked drift: $out"
"$L" repair --root "$T" >/dev/null 2>&1
ok "ai-memory-link --check reports locked drift"

# 7. review 2026-11-01: markdown/case/hyphen renames, no false positives, idempotence
WF="$T/config/ai/memory/workflow.md"; cp "$DOT/config/ai/memory/workflow.md" "$WF"
printf '\nA: Paduka **Olan** · B: PADUKA Olan · C: Paduka-Olan · D: Paduka Óscar\non behalf of Paduka\n\nAddress Rules stay. Paduka adalah sapaan.\n' >> "$WF"
"$L" repair --root "$T" >/dev/null 2>&1 || fail "repair of rename variants failed"
grep -q 'A: Paduka \*\*Ongki\*\* · B: Paduka Ongki · C: Paduka Ongki · D: Paduka Ongki$' "$WF" || fail "rename variants not all restored: $(tail -4 "$WF")"
grep -q '^on behalf of Paduka$' "$WF" && grep -q '^Address Rules stay\. Paduka adalah sapaan\.$' "$WF" || fail "guard crossed a paragraph or rewrote ordinary text"
before="$(cat "$T"/config/ai/memory/*.md "$CORE" | cksum)"
"$L" repair --root "$T" >/dev/null 2>&1; [ "$(cat "$T"/config/ai/memory/*.md "$CORE" | cksum)" = "$before" ] || fail "second repair changed files"
ok "markdown, upper-case, hyphen and accented renames restored; paragraphs and 'Paduka adalah' untouched; repair is idempotent"

# 7b. review round 2: CRLF files keep CRLF; a rename that drops the period fails loudly
#     instead of swallowing the next sentence; an apostrophe survives
python3 - "$ID" "$T/config/ai/memory/skills.md" <<'PY'
import re, sys
for p in sys.argv[1:]:
    s = open(p, newline="").read().replace("\r\n", "\n")
    if p.endswith("identity.md"):
        s = re.sub(r"(?m)^- Preferred name / form of address:.*$", "- Preferred name / form of address: Olan", s)
    else:
        s = re.sub(r"<!-- locked:dotuiux-name -->.*?<!-- /locked:dotuiux-name -->\n", "", s, flags=re.S)
    open(p, "w", newline="").write(s.replace("\n", "\r\n"))
PY
"$L" repair --root "$T" >/dev/null 2>&1 || fail "CRLF repair failed"
python3 - "$ID" "$T/config/ai/memory/skills.md" <<'PY' || fail "a repaired CRLF file now mixes line endings"
import sys
for p in sys.argv[1:]:
    b = open(p, "rb").read()
    assert b.count(b"\n") == b.count(b"\r\n"), p
    assert b"Paduka Ongki." in b or b"locked:dotuiux-name" in b, p
PY
cp "$DOT/config/ai/memory/identity.md" "$ID"; cp "$DOT/config/ai/memory/skills.md" "$T/config/ai/memory/skills.md"
python3 - "$CORE" <<'PY'
import sys; p = sys.argv[1]; s = open(p).read()
open(p, "w").write(s.replace("Address the user as **Paduka Ongki**.", "Address the user as Olan", 1))
PY
snap="$(cksum < "$CORE")"
if "$L" repair --root "$T" >/dev/null 2>&1; then fail "a period-less rename mid-line passed repair"; fi
[ "$(cksum < "$CORE")" = "$snap" ] || fail "repair rewrote CORE around a period-less rename"
cp "$DOT/config/ai/CORE.md" "$CORE"
for short in "Address the user as Olan Natural phrasing, no ritual." "Address the user as Olan, natural."; do
  SHORT="$short" python3 - "$CORE" <<'PY'
import os, sys; p = sys.argv[1]; s = open(p).read()
open(p, "w").write(s.replace("Address the user as **Paduka Ongki**.", os.environ["SHORT"], 1))
PY
  snap="$(cksum < "$CORE")"
  if "$L" repair --root "$T" >/dev/null 2>&1; then fail "short trailing text swallowed: $short"; fi
  [ "$(cksum < "$CORE")" = "$snap" ] || fail "repair rewrote CORE for: $short"
  cp "$DOT/config/ai/CORE.md" "$CORE"
done
printf "\nPaduka Olan's notes.\n" >> "$WF"
"$L" repair --root "$T" >/dev/null 2>&1 && grep -q "^Paduka Ongki's notes\.$" "$WF" || fail "apostrophe lost in forbid repair"
ok "CRLF kept; period-less mid-line rename fails without eating text; apostrophe kept"

# 8. damaged markers: refuse and change nothing (a dangling opener once ate the file)
sed -i.bak '/<!-- \/locked:dotads-name -->/d' "$MA"
lines="$(wc -l < "$MA")"
set +e; out="$("$L" repair --root "$T" 2>&1)"; rc=$?; set -e
[ "$rc" -eq 1 ] && printf '%s' "$out" | grep -q 'locked markers are damaged' || fail "damaged markers not refused cleanly (rc=$rc): $out"
[ "$(wc -l < "$MA")" -eq "$lines" ] || fail "repair changed a file with damaged markers"
cp "$DOT/config/ai/memory/meta-ads.md" "$MA"
ok "a dangling locked marker fails repair and leaves the file untouched"

# 9. a symlinked target is fixed through the link, and the link survives
mv "$T/config/ai/memory/preferences.md" "$T/prefs-real.md"; ln -s ../../../prefs-real.md "$T/config/ai/memory/preferences.md"
sed -i.bak 's/Paduka Ongki\./Olan./' "$T/prefs-real.md"
"$L" repair --root "$T" >/dev/null 2>&1 || fail "repair through symlink failed"
[ -L "$T/config/ai/memory/preferences.md" ] || fail "repair replaced the symlink with a file"
grep -q '^- Preferred form of address: Paduka Ongki\.$' "$T/prefs-real.md" || fail "symlink target not restored"
ok "symlinked target restored through the link"

# 10. ai-memory-link link mode reports a failed repair with a non-zero exit
H="$T/home"; mkdir -p "$H/.config"; ln -s "$T/config/ai" "$H/.config/ai"
# Stub every other runtime command so only the lock decides the exit code.
grep -v '^#' "$T/config/ai/runtime-commands.txt" | while read -r c; do
  if [ -n "$c" ] && [ ! -e "$T/bin/$c" ]; then printf '#!/bin/sh\n' > "$T/bin/$c"; chmod +x "$T/bin/$c"; fi
done
HOME="$H" "$T/bin/ai-memory-link" >/dev/null 2>&1 || fail "clean ai-memory-link run in a temp home failed"
python3 - "$CORE" <<'PY'
import sys; p = sys.argv[1]; s = open(p).read()
open(p, "w").write(s.replace("Address the user as **Paduka Ongki**.", "", 1))
PY
set +e; out="$(HOME="$H" "$T/bin/ai-memory-link" 2>&1)"; rc=$?; set -e
cp "$DOT/config/ai/CORE.md" "$CORE"
printf '%s' "$out" | grep -q 'skipped render of context/claude.md' || fail "an unresolved locked rule was rendered into the runtimes: $out"
[ "$rc" -ne 0 ] && printf '%s' "$out" | grep -q 'locked owner rules need attention' || fail "ai-memory-link hid a failed repair (rc=$rc): $out"
ok "ai-memory-link exits non-zero and warns when a locked rule cannot be restored"

# 11. signature (CI): only the password re-signs a changed rule
J="$T/config/ai/locked-rules.json"
edit_rule() { python3 - "$J" "$1" <<'PY'
import json, sys; p, v = sys.argv[1], sys.argv[2]; d = json.load(open(p))
d["rules"][0]["canonical"] = v; open(p, "w").write(json.dumps(d, indent=2, ensure_ascii=False) + "\n")
PY
}
AI_RULE_LOCK_KEY='correct horse 1' "$L" sign --root "$T" >/dev/null || fail "sign failed"
AI_RULE_LOCK_KEY='correct horse 1' "$L" verify --root "$T" >/dev/null 2>&1 || fail "fresh signature does not verify"
set +e
AI_RULE_LOCK_KEY='wrong password 12' "$L" verify --root "$T" >/dev/null 2>&1; [ $? -eq 1 ] || fail "wrong password verified"
"$L" verify --root "$T" >/dev/null 2>&1; [ $? -eq 2 ] || fail "missing key must exit 2"
edit_rule "Address the user as **Paduka Olan**."
AI_RULE_LOCK_KEY='correct horse 1' "$L" verify --root "$T" >/dev/null 2>&1; [ $? -eq 1 ] || fail "unsigned rule change verified"
edit_rule "Address the user as **Paduka Ongki**."
set -e
grep -q 'correct horse' "$J" && fail "password written to the lock file"
ok "CI verify: right password passes; wrong/missing password and an unsigned edit are rejected; password never stored"

# 12. device enforcement without any password (Ed25519 + pinned owner key)
"$L" repair --root "$T" >/dev/null 2>&1 || fail "first repair with a signed set failed"
[ -f "$AI_RULE_LOCK_PIN" ] || fail "first contact did not pin the owner key"
[ "$(stat -c %a "$AI_RULE_LOCK_PIN" 2>/dev/null || stat -f %Lp "$AI_RULE_LOCK_PIN")" = 600 ] || fail "pin is not 0600"
good="$(cat "$J")"
reject_case() { # $1=label; the lock file was tampered before the call
  set +e; out="$("$L" repair --root "$T" 2>&1)"; rc=$?; set -e
  [ "$rc" -eq 1 ] && printf '%s' "$out" | grep -q 'REJECTED' || fail "$1 was not rejected (rc=$rc): $out"
  [ "$(cat "$J")" = "$good" ] || fail "$1: lock file not restored to the signed version"
  grep -q 'Address the user as \*\*Paduka Ongki\*\*\.' "$CORE" || fail "$1: CORE lost Paduka Ongki"
  if grep -q 'Paduka Olan' "$CORE"; then fail "$1: CORE took the tampered name"; fi
}
edit_rule "Address the user as **Paduka Olan**."; reject_case "rule edited without the password"
edit_rule "Address the user as **Paduka Olan**."
python3 - "$J" <<'PY'
import json, sys; p = sys.argv[1]; d = json.load(open(p))
for k in ("publicKey", "signature"): d.pop(k, None)   # attacker drops the owner key, then signs with their own
open(p, "w").write(json.dumps(d, indent=2, ensure_ascii=False) + "\n")
PY
AI_RULE_LOCK_KEY='attacker pass 99' "$L" sign --root "$T" >/dev/null 2>&1 || fail "fixture: attacker sign failed"
reject_case "rule re-signed with another password"
python3 - "$J" <<'PY'
import json, sys; p = sys.argv[1]; d = json.load(open(p)); d.pop("signature"); d["rules"][0]["canonical"] = "Address the user as Olan."
open(p, "w").write(json.dumps(d, indent=2, ensure_ascii=False) + "\n")
PY
reject_case "signature stripped"
"$L" check --root "$T" >/dev/null 2>&1 || fail "check fails on the restored signed set"
ok "device rejects an edited, foreign-signed or unsigned rule set and keeps Paduka Ongki"

# 13. the owner's own changes: same password accepted; a new password needs the old one
AI_RULE_LOCK_KEY='correct horse 1' "$L" sign --root "$T" >/dev/null || fail "owner re-sign failed"
"$L" repair --root "$T" >/dev/null 2>&1 || fail "owner-signed set rejected"
set +e; AI_RULE_LOCK_KEY='brand new pass 7' "$L" sign --root "$T" >/dev/null 2>&1; rc=$?; set -e
[ "$rc" -eq 1 ] || fail "a new password without the old one was accepted"
AI_RULE_LOCK_KEY='brand new pass 7' AI_RULE_LOCK_OLD_KEY='correct horse 1' "$L" sign --root "$T" >/dev/null || fail "endorsed rotation failed"
"$L" repair --root "$T" >/dev/null 2>&1 || fail "device rejected an endorsed key rotation"
python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); p=json.load(open(sys.argv[2])); assert d["publicKey"]==p["publicKey"]' "$J" "$AI_RULE_LOCK_PIN" || fail "pin not moved to the endorsed key"
ok "owner re-sign accepted; a new password only with the old one's endorsement"

# 14. review 2026-11-01 (Ed25519 round): nothing tampered is ever enforced
cp "$AI_RULE_LOCK_PIN" "$T/pin.good"; cp "$J" "$T/lock.good"
no_bos() { if grep -q 'Bos Olan' "$CORE"; then fail "$1: a rejected rule was enforced"; fi; }
edit_rule "Address the user as **Bos Olan**."
for state in forged unreadable none; do
  case $state in
    forged) printf '{"rules": []}\n' > "$AI_RULE_LOCK_PIN" ;;
    unreadable) printf 'not json' > "$AI_RULE_LOCK_PIN" ;;
    none) rm -f "$AI_RULE_LOCK_PIN" ;;
  esac
  set +e; out="$("$L" repair --root "$T" 2>&1)"; rc=$?; set -e
  [ "$rc" -eq 1 ] && printf '%s' "$out" | grep -q 'Nothing enforced' || fail "$state pin + tampered set not refused (rc=$rc): $out"
  no_bos "$state pin"
done
cp "$T/pin.good" "$AI_RULE_LOCK_PIN"; cp "$T/lock.good" "$J"
ok "with a forged, unreadable or missing pin a tampered set is refused and nothing is written"

# rollback: an older set signed by the same key is refused
AI_RULE_LOCK_KEY='brand new pass 7' "$L" sign --root "$T" >/dev/null || fail "owner sign (newer serial) failed"
"$L" repair --root "$T" >/dev/null 2>&1 || fail "newer serial rejected"
newer="$(cat "$J")"; good="$newer"
cp "$T/lock.good" "$J"
set +e; out="$("$L" repair --root "$T" 2>&1)"; rc=$?; set -e
[ "$rc" -eq 1 ] && printf '%s' "$out" | grep -q 'rollback' || fail "rollback to an older signed set accepted (rc=$rc): $out"
[ "$(cat "$J")" = "$newer" ] || fail "rollback: lock file not restored to the newest signed set"
python3 - "$T/lock.good" "$J" <<'PY'
import json, sys; d = json.load(open(sys.argv[1])); d["serial"] = 999   # forge a higher serial on the old set
open(sys.argv[2], "w").write(json.dumps(d, indent=2, ensure_ascii=False) + "\n")
PY
set +e; out="$("$L" repair --root "$T" 2>&1)"; rc=$?; set -e
[ "$rc" -eq 1 ] && printf '%s' "$out" | grep -q 'REJECTED' || fail "an old set with a forged serial was accepted (rc=$rc): $out"
[ "$(cat "$J")" = "$newer" ] || fail "forged serial: lock file not restored"
ok "an older signed set (rollback), even with a forged serial, is refused and the newest restored"

# deleting the lock file on a pinned device does not switch enforcement off
rm -f "$J"
sed -i.bak 's/Address the user as \*\*Paduka Ongki\*\*\./Address the user as **Paduka Olan**./' "$CORE"
set +e; out="$(HOME="$H" "$T/bin/ai-memory-link" 2>&1)"; rc=$?; set -e
[ -f "$J" ] && [ "$(cat "$J")" = "$newer" ] || fail "deleted lock file not restored from the pin: $out"
grep -q 'Address the user as \*\*Paduka Ongki\*\*\.' "$CORE" || fail "deleted lock file switched enforcement off"
[ "$rc" -ne 0 ] || fail "a deleted lock file passed silently"
ok "a deleted lock file is restored from the pin and the name is still enforced"

# review round 2: a malformed lock file must not crash before the pinned rules are enforced
for bad in '{' '[]' 'null' 'serial-string' 'serial-bool'; do
  case $bad in
    serial-string) python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); d["serial"]="x"; open(sys.argv[1],"w").write(json.dumps(d))' "$J" ;;
    serial-bool) python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); d["serial"]=True; open(sys.argv[1],"w").write(json.dumps(d))' "$J" ;;
    *) printf '%s' "$bad" > "$J" ;;
  esac
  sed -i.bak 's/Address the user as \*\*Paduka Ongki\*\*\./Address the user as **Bos Olan**./' "$CORE"
  set +e; out="$("$L" repair --root "$T" 2>&1)"; rc=$?; set -e
  printf '%s' "$out" | grep -q Traceback && fail "malformed lock ($bad) crashed: $out"
  [ "$rc" -eq 1 ] || fail "malformed lock ($bad) passed silently"
  [ "$(cat "$J")" = "$newer" ] || fail "malformed lock ($bad) not restored from the pin"
  no_bos "malformed lock ($bad)"
done
ok "a malformed lock file (bad JSON, non-object, bad serial) is restored from the pin; the name stays enforced"

# two-hop rotation reaches a device that skipped the middle release
cp "$AI_RULE_LOCK_PIN" "$T/pin.hop0"
AI_RULE_LOCK_KEY='third pass 333' AI_RULE_LOCK_OLD_KEY='brand new pass 7' "$L" sign --root "$T" >/dev/null || fail "hop 1 sign failed"
AI_RULE_LOCK_KEY='fourth pass 444' AI_RULE_LOCK_OLD_KEY='third pass 333' "$L" sign --root "$T" >/dev/null || fail "hop 2 sign failed"
cp "$T/pin.hop0" "$AI_RULE_LOCK_PIN"
"$L" repair --root "$T" >/dev/null 2>&1 || fail "a device two keys behind rejected the endorsed chain"
ok "a two-hop endorsed key chain is followed"

# crypto: RFC 8032 vectors 1-2, and the identity key never verifies
python3 - "$L" <<'PY' || fail "Ed25519 vectors or small-order rejection failed"
import importlib.machinery, importlib.util, sys
ld = importlib.machinery.SourceFileLoader("arl", sys.argv[1]); sp = importlib.util.spec_from_loader("arl", ld)
m = importlib.util.module_from_spec(sp); ld.exec_module(m)
for sk, msg, pk, sig in [
  ("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60", "", "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a",
   "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"),
  ("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb", "72", "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c",
   "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00")]:
    s, mm = bytes.fromhex(sk), bytes.fromhex(msg)
    assert m.ed_public(s).hex() == pk and m.ed_sign(s, mm).hex() == sig and m.ed_verify(bytes.fromhex(pk), mm, bytes.fromhex(sig))
    assert not m.ed_verify(bytes.fromhex(pk), mm + b"x", bytes.fromhex(sig))
ident = (1).to_bytes(32, "little")
s = 12345
forged = m._compress(m._mul(s, m._G)) + s.to_bytes(32, "little")
assert not m.ed_verify(ident, b"any message", forged)
PY
ok "Ed25519 matches RFC 8032 vectors; the identity public key is refused"

# CI verify refuses the pre-Ed25519 (HMAC) format with exit 2
python3 - "$J" <<'PY'
import json, sys; p = sys.argv[1]; d = json.load(open(p))
for k in ("publicKey", "keyChain", "serial"): d.pop(k, None)
d["signature"] = "00" * 32; open(p, "w").write(json.dumps(d, indent=2) + "\n")
PY
set +e; AI_RULE_LOCK_KEY='fourth pass 444' "$L" verify --root "$T" >/dev/null 2>&1; rc=$?; set -e
[ "$rc" -eq 2 ] || fail "legacy-format verify must exit 2, got $rc"
ok "verify reports the legacy HMAC format as unsigned (exit 2)"

echo "ai-rule-lock-test: PASS"
