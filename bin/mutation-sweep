#!/usr/bin/env bash
# mutation-sweep — ask every test whether it would notice its subject being gone.
#
# Six independent reviews on 2026-09-04 found five real defects and not one came
# from reading: a hygiene branch that could not execute, a gate measuring with a
# different ruler than it validated with, four silent-green paths, and four test
# cases keyed on a heading string that no longer appeared — passing while
# asserting nothing. Reading is the wrong instrument for that defect class.
#
# One operator, deliberately: replace bin/<name> with a stub that exits 0 and
# run bin/<name>-test against a scratch copy. A test that still passes is not
# testing behaviour. This is coarse — it cannot see a test that checks half of
# what it should — and that is the point of starting here. A second operator
# earns its place only with a case showing what this one missed.
#
# The stub records its own invocation. A test that passes WITHOUT the stub ever
# running never looked at the root it was handed, so it is reported UNSWEEPABLE
# by name rather than counted as healthy: not knowing is a third answer, not a
# rounding of the other two.
#
#   mutation-sweep              stub every bin/<name> that has a bin/<name>-test
#   mutation-sweep <name>...    stub only these
#   mutation-sweep --subject <name>...
#                               MUTATE the subject line by line instead of
#                               stubbing it, and report each mutant the test
#                               fails to notice. Slower and opt-in: one subject
#                               with a 14-second test costs minutes, so this is
#                               never part of the default sweep.
#   mutation-sweep --json       machine-readable
#
# Stubbing answers "does this test assert anything at all". Mutating answers the
# question that actually found defects here: would it notice a plausible bug?
# Nine of ten tests written on 2026-09-04 passed the stub and fell to a hand
# mutation days later, so the second question is the one worth automating.
#
# Exit 1 if any test SURVIVED or ERROR occurred. Read-only for this repository: the
# working tree is fingerprinted before and after and a change aborts the run.
set -uo pipefail

ROOT="${DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)}"
JSON=0
MODE=stub
REQUESTED=()
TIMEOUT_S="${MUTATION_SWEEP_TIMEOUT:-120}"
MAX_MUTANTS="${MUTATION_SWEEP_MAX_MUTANTS:-20}"
for a in "$@"; do
  case "$a" in
    --json) JSON=1 ;;
    --subject) MODE=subject ;;
    -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "mutation-sweep: unknown option $a" >&2; exit 2 ;;
    *) REQUESTED+=("$a") ;;
  esac
done

[ -d "$ROOT/bin" ] || { echo "mutation-sweep: no bin/ under $ROOT" >&2; exit 2; }
command -v git >/dev/null || { echo "mutation-sweep: git is required" >&2; exit 2; }

WORK="$(mktemp -d "${TMPDIR:-/tmp}/mutation-sweep.XXXXXX")"
trap 'chmod -R u+w "$WORK" 2>/dev/null; rm -rf "$WORK"' EXIT

# A sweep that corrupted the repository it measures would be the exact failure
# this command exists to catch, so the tree is pinned before anything runs.
fingerprint() { git -C "$ROOT" status --porcelain 2>/dev/null | sort; }
BEFORE="$(fingerprint)"

# GNU `timeout` is absent on stock macOS. Keep Perl as the parent process: an
# `alarm; exec` fallback loses the alarm on exec and lets a hanging fixture run
# unbounded. Exit 124 to retain GNU timeout's observable contract.
run_bounded() {
  local seconds="$1" timeout_bin="" perl_bin=""
  shift
  timeout_bin="$(command -v timeout 2>/dev/null || command -v gtimeout 2>/dev/null || true)"
  if [ -n "$timeout_bin" ]; then
    "$timeout_bin" -k 2 "$seconds" "$@"
    return
  fi
  perl_bin="$(command -v perl 2>/dev/null || true)"
  if [ -n "$perl_bin" ]; then
    "$perl_bin" -e '
      my $seconds = shift;
      my $pid = fork;
      exit 125 unless defined $pid;
      if ($pid == 0) { setpgrp(0, 0); exec @ARGV; exit 127 }
      use POSIX qw(WNOHANG);
      sub wait_until {
        my ($child, $deadline) = @_;
        while (time < $deadline) {
          my $done = waitpid($child, WNOHANG);
          return $done if $done == $child;
          select undef, undef, undef, 0.1;
        }
        return 0;
      }
      my $done = wait_until($pid, time + $seconds);
      exit($? >> 8) if $done == $pid;
      kill "TERM", -$pid;
      $done = wait_until($pid, time + 2);
      kill "KILL", -$pid if $done != $pid;
      waitpid $pid, 0 if $done != $pid;
      exit 124;
    ' "$seconds" "$@"
    return
  fi
  "$@"
}

bites=0; survived=0; unsweepable=0; errored=0; survived_total=0; unmeasured=0
rows=()

sweep_one() {
  local name="$1"
  local subject="$ROOT/bin/$name"
  local test="$ROOT/bin/$name-test"
  local scratch="$WORK/$name"
  local marker="$WORK/$name.marker"
  rm -rf "$scratch"; mkdir -p "$scratch"
  # Tracked files only: an untracked artefact from another run must not decide
  # whether a test passes.
  git -C "$ROOT" archive HEAD | tar -x -C "$scratch" 2>/dev/null || return 3
  # Several tests expect a repository; give them one that is not this one.
  git -C "$scratch" init -q 2>/dev/null
  git -C "$scratch" add -A >/dev/null 2>&1
  git -C "$scratch" -c user.email=sweep@local -c user.name=sweep \
      commit -qm "mutation-sweep baseline" >/dev/null 2>&1

  : > "$marker"
  local shebang; shebang="$(head -1 "$subject")"
  # The stub must be written in the subject's own language. A bash stub under a
  # node shebang cannot run, the marker stays empty, and the sweep then reports
  # UNSWEEPABLE — a wrong answer that looks like a cautious one. Found when
  # ai-memory-check, the only node command with a test, was misclassified.
  case "$shebang" in
    *python*) printf '%s\n' "$shebang" \
        "import sys; open(r'$marker','a').write('x'); sys.exit(0)" > "$scratch/bin/$name" ;;
    *node*) printf '%s\n' "$shebang" \
        "require('fs').appendFileSync(String.raw\`$marker\`, 'x'); process.exit(0);" > "$scratch/bin/$name" ;;
    *) printf '%s\n' "$shebang" "printf 'x' >> '$marker'" "exit 0" > "$scratch/bin/$name" ;;
  esac
  chmod +x "$scratch/bin/$name"

  local out rc
  # Both conventions this repository actually uses: the first argument, and
  # DOTFILES_DIR. resume-brief-test and dotsync-test read only the latter, so
  # passing the argument alone would have called them unsweepable when they are
  # simply pointed a different way.
  # To a file, never a command substitution. run_bounded kills the test's shell,
  # but a child it left behind — a sleep, a hung fetch — keeps the pipe open, and
  # `$(...)` waits on the PIPE rather than the process. The suite's own case
  # measured 30 seconds under a 2-second bound because of it: the timeout was
  # real and the capture made it decorative. A file has no pipe to wait on.
  (cd "$scratch" && DOTFILES_DIR="$scratch" run_bounded "$TIMEOUT_S" bash "$test" "$scratch") \
    > "$WORK/$name.out" 2>&1 </dev/null
  rc=$?
  out="$(cat "$WORK/$name.out" 2>/dev/null)"
  local touched=0; [ -s "$marker" ] && touched=1

  if [ "$rc" -eq 124 ]; then
    rows+=("ERROR|$name|test timed out after ${TIMEOUT_S}s"); errored=$((errored+1)); return
  fi
  # GNU timeout returns 137 when its kill-after deadline requires SIGKILL.
  # A killed test is inconclusive even if it ran the stub before being killed.
  if [ "$rc" -eq 137 ]; then
    rows+=("ERROR|$name|test killed by SIGKILL (possibly after timeout)"); errored=$((errored+1)); return
  fi
  if [ "$touched" -eq 0 ]; then
    rows+=("UNSWEEPABLE|$name|the stub was never run; the test does not use the root it is given")
    unsweepable=$((unsweepable+1)); return
  fi
  if [ "$rc" -ne 0 ]; then
    rows+=("BITES|$name|failed with the subject stubbed"); bites=$((bites+1))
  else
    rows+=("SURVIVED|$name|passed with the subject stubbed — it asserts nothing about behaviour")
    survived=$((survived+1))
  fi
}

# ── Subject mutation ──────────────────────────────────────────────────────────
# Two operators, chosen because every defect this repository has actually found
# was one of these two shapes: a guard that stopped firing, or a refusal that
# stopped refusing. A wider operator set would mostly produce equivalent mutants
# and drown the signal — the sweep's own escape on 2026-09-04 was exactly that,
# a `sorted()` removal that changed no output.
#
# EQUIVALENT_MUTANTS holds the ones proven to change nothing, one "name:line"
# per line with the reason after a space. A survivor not listed here is a gap in
# the test, not a quirk of the operator.
#
# A plain string, not `declare -A`: macOS ships bash 3.2, which has no
# associative arrays. CI caught this the same day, which is the second time this
# file has needed a bash-3.2 accommodation — run_bounded exists because macOS
# has no GNU timeout either.
EQUIVALENT_MUTANTS=""

is_equivalent_mutant() { # is_equivalent_mutant <name> <line>
  printf '%s\n' "$EQUIVALENT_MUTANTS" | grep -q "^$1:$2 "
}

# A guard-shaped LINE is not the same thing as a guard. `if x > 0:` inside a
# docstring is documentation: mutating it changes nothing, and reporting the
# survivor sends whoever closes gaps chasing prose. `exit 124;` inside the
# quoted Perl program in run_bounded is the opposite — real code, in a language
# these operators do not speak, rewritten by bash's own rule. One defect wears
# two faces, so each language answers with its own instrument.
#
# Python answers with its own parser. That is the dependency the contract names:
# a subject its interpreter cannot parse becomes UNMEASURABLE rather than merely
# under-measured, so the failure is reported by name instead of being guessed at.
python_statements() { # python_statements <file> -> "guard|refuse <line>" per line
  local py; py="$(command -v python3 2>/dev/null || command -v python 2>/dev/null || true)"
  [ -n "$py" ] || return 2
  "$py" - "$1" 2>/dev/null <<'PYSTMT'
import ast, sys
tree = ast.parse(open(sys.argv[1], encoding="utf-8", errors="replace").read())
seen = set()
for node in ast.walk(tree):
    if isinstance(node, ast.If):
        seen.add(("guard", node.lineno))
    elif isinstance(node, ast.Call) and node.args:
        f = node.func
        name = getattr(f, "attr", None) or getattr(f, "id", None)
        arg = node.args[0]
        if name in ("exit", "SystemExit") and isinstance(arg, ast.Constant) \
                and isinstance(arg.value, int) and arg.value != 0:
            seen.add(("refuse", node.lineno))
for kind, line in sorted(seen, key=lambda x: x[1]):
    print(kind, line)
PYSTMT
}

# Bash answers in bash, deliberately. Reaching for python here would make every
# bash subject unmeasurable on a machine without it — trading a narrow blind
# spot for a wide one. This tracks heredocs and multi-line quoted strings, which
# is where embedded programs actually live in this repository.
bash_embedded() { # bash_embedded <file> -> line numbers inside a heredoc or quote
  local n=0 delims="" q="" line stripped qscan trimmed scan rest hit first
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    { [ -n "$delims" ] || [ -n "$q" ]; } && printf '%s\n' "$n"
    if [ -n "$delims" ]; then
      trimmed="$(printf '%s' "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      first="${delims# }"; first="${first%% *}"
      if [ "$trimmed" = "$first" ]; then
        delims="${delims# }"
        case "$delims" in *" "*) delims=" ${delims#* }" ;; *) delims="" ;; esac
      fi
      continue
    fi
    stripped="$(printf '%s' "$line" | sed 's/\\.//g')"
    # Closing an open quote comes BEFORE the comment test. A continuation line
    # that starts with `#` is text inside the string, not a comment, and skipping
    # it left the quote open forever — every guard after it was then reported
    # EMBEDDED, which removes coverage instead of adding honesty.
    if [ -n "$q" ]; then
      case "$stripped" in *"$q"*) q="" ;; esac
      continue
    fi
    # First non-blank character, not "contains a #": the loose glob skipped any
    # line with a trailing comment, and skipping a line means its quotes never
    # update, which desynchronises everything after it.
    case "$(printf '%s' "$line" | sed 's/^[[:space:]]*//')" in \#*) continue ;; esac
    # Escapes are already gone; remove BALANCED quotes and what survives is an
    # opener without a partner, which is what carries the string onto the next
    # line. A quote decided here WINS over any heredoc opener on the same line,
    # because `msg='start <<EOF` is a string containing the text `<<EOF`, which
    # is what bash itself does with it.
    qscan="$(printf '%s' "$stripped" | sed -e 's/"[^"]*"//g' -e "s/'[^']*'//g")"
    case "$qscan" in
      *\'*) q="'"; continue ;;
      *\"*) q='"'; continue ;;
    esac
    # `<<<` is a here-STRING, not a heredoc, and reading it as one swallowed the
    # rest of the file: `done <<< "$targets"` opened a region that never closed.
    # Blanking it first also lets a real heredoc on the same line still be seen.
    #
    # Then unwrap the DELIMITER's own quoting — `<<'EOF'`, `<<"EOF"`, `<<\EOF`
    # all name the same heredoc — before removing balanced quoted spans. Order
    # matters both ways: scanning the raw line made `echo 'see <<EOF here'` open
    # a heredoc that never closed, so every guard after a usage string was
    # dropped from coverage; removing quotes first would have eaten `<<'EOF'`.
    scan="${line//<<</§}"
    scan="$(printf '%s' "$scan" | sed -E 's/<<(-?)[[:space:]]*[\\'\''"]?([A-Za-z_][A-Za-z0-9_]*)['\''"]?/<<\1\2/g')"
    scan="$(printf '%s' "$scan" | sed -e 's/"[^"]*"//g' -e "s/'[^']*'//g")"
    rest="$scan"
    # Every opener on the line, not just the first: `cat <<A <<B` opens two, and
    # stopping at one left B's body to be read as bash. They close in the order
    # they were opened, which is what bash does.
    while [[ "$rest" =~ \<\<(-?)([A-Za-z_][A-Za-z0-9_]*) ]]; do
      delims="$delims ${BASH_REMATCH[2]}"
      hit="${BASH_REMATCH[0]}"
      rest="${rest#*"$hit"}"
    done
    [ -n "$delims" ] && continue
  done < "$1"
}

mutate_one() {
  local name="$1"
  local subject="$ROOT/bin/$name" test="$ROOT/bin/$name-test"
  local killed=0 survived=0 total=0 unreached=0 inline_unreached=0

  # Two operators, in whichever language the subject is written: guard-off turns
  # a branch condition false, refusal-off turns a non-zero exit into zero. The
  # SHAPES differ per language, the operators do not.
  local lang
  case "$(head -1 "$subject")" in
    *python*) lang=python ;;
    *node*)   lang=node ;;
    *)        lang=bash ;;
  esac
  # No compile check on the mutant, deliberately. An uncompilable mutant fails
  # the test for a reason unrelated to the guard and would read as KILLED,
  # hiding the gap — so it would be worth rejecting IF it could happen. Both
  # operators are grammar-preserving edits to a line-complete statement:
  # applying them to every matching line of all 23 python subjects in bin/
  # produced 519 mutants and 0 that failed to parse. A guard that cannot fire is
  # decoration. A third operator that is not grammar-preserving brings the check
  # back, with a fixture that shows it firing.
  # Guard and refusal get their own patterns rather than one alternation, because
  # which operator a line gets must be decided by which SHAPE it is, not by what
  # substring it happens to contain. Dispatching on `*exit*` sent
  # `if msg == "call sys.exit(1) to quit":` — a guard header — down the refusal
  # branch, which then rewrote the string literal and never tried guard-off on it.
  local guard_re="" refuse_re=""
  case "$lang" in
    bash)   guard_re='^[[:space:]]*(if|elif)[[:space:]].*;[[:space:]]*then[[:space:]]*$'
            refuse_re='^[[:space:]]*exit[[:space:]]+[1-9]' ;;
    python) guard_re='^[[:space:]]*(if|elif)[[:space:]].*:' ;;
  esac

  # Entries are "kind|line|text". Which operator a line gets is decided by what
  # the line IS, never by what substring it contains: dispatching on `*exit*`
  # once sent the guard header `if msg == "call sys.exit(1) to quit":` down the
  # refusal branch, which rewrote its string literal and never tried guard-off.
  local targets="" matched=0 kind ln text embedded stmts rc
  case "$lang" in
    python)
      stmts="$(python_statements "$subject")"; rc=$?
      if [ "$rc" -eq 2 ]; then
        rows+=("UNMEASURED|$name|python subject and no python on PATH to parse it, so a guard cannot be told from a docstring")
        unmeasured=$((unmeasured+1)); return
      elif [ "$rc" -ne 0 ]; then
        rows+=("UNMEASURED|$name|its own interpreter cannot parse it, so nothing here can say which lines are code")
        unmeasured=$((unmeasured+1)); return
      fi
      while read -r kind ln; do
        [ -n "$ln" ] || continue
        matched=$((matched + 1))
        [ "$matched" -gt "$MAX_MUTANTS" ] && break
        text="$(sed -n "${ln}p" "$subject")"
        targets="$targets$kind|$ln|$text
"
      done <<< "$stmts"
      ;;
    bash)
      embedded="$(bash_embedded "$subject")"
      while IFS= read -r entry; do
        [ -n "$entry" ] || continue
        ln="${entry%%:*}"; text="${entry#*:}"
        matched=$((matched + 1))
        [ "$matched" -gt "$MAX_MUTANTS" ] && break
        # Real code, in a language these operators do not speak. Mutating it by
        # bash's rule and reporting the verdict as bash's would be the host
        # language quietly answering for a guest; saying it is out of reach is
        # the honest third answer, and it fails the run like any other.
        if printf '%s\n' "$embedded" | grep -qx "$ln"; then
          rows+=("EMBEDDED|$name|bin/$name:$ln sits inside a heredoc or quoted string: $(printf '%s' "$text" | sed 's/^[[:space:]]*//')")
          unmeasured=$((unmeasured+1)); continue
        fi
        if printf '%s\n' "$text" | grep -qE "$guard_re"; then kind=guard; else kind=refuse; fi
        targets="$targets$kind|$ln|$text
"
      done <<< "$(grep -nE "$guard_re|$refuse_re" "$subject" | grep -vE '^[0-9]+:[[:space:]]*#')"
      ;;
  esac

  # A subject in a language with no shapes defined yields nothing, and reporting
  # that as "0 survived" would read as full coverage — the same shape of lie as a
  # gate that judged nothing and printed PASS. A subject whose every target was
  # out of reach is already reported line by line and must not be counted twice.
  if [ "$matched" -eq 0 ]; then
    rows+=("UNMEASURED|$name|no guard or refusal statement found; the operators have no shapes for $(head -1 "$subject" | sed 's|.*/||')")
    unmeasured=$((unmeasured+1)); return
  fi
  [ -n "$targets" ] || return

  local scratch="$WORK/mut-$name"
  rm -rf "$scratch"; mkdir -p "$scratch"
  git -C "$ROOT" archive HEAD | tar -x -C "$scratch" 2>/dev/null || return 3
  git -C "$scratch" init -q 2>/dev/null
  git -C "$scratch" add -A >/dev/null 2>&1
  git -C "$scratch" -c user.email=sweep@local -c user.name=sweep \
      commit -qm "mutation-sweep baseline" >/dev/null 2>&1

  # A test that fails on the UNMUTATED subject makes every verdict meaningless:
  # every mutant would look killed. ai-doctor-test was in exactly that state on
  # 2026-09-07, so the baseline is checked before anything is mutated.
  # stdin closed here too. The stub runner got this and the mutation runner did
  # not, so a test that blocks on stdin stalled until the timeout on every single
  # mutant — a bound that holds in one mode and not the other is the worse kind.
  if ! (cd "$scratch" && DOTFILES_DIR="$scratch" run_bounded "$TIMEOUT_S" bash "$test" "$scratch" >/dev/null 2>&1 </dev/null); then
    rows+=("BASELINE|$name|the test fails on the unmutated subject, so no verdict is possible")
    errored=$((errored+1)); return
  fi

  local line_no line_text op mutated rest
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    kind="${entry%%|*}"; rest="${entry#*|}"
    line_no="${rest%%|*}"; line_text="${rest#*|}"
    if [ "$kind" = guard ]; then
      op="guard-off"
      case "$lang" in
        bash)   mutated="$(printf '%s' "$line_text" | sed -E 's/^([[:space:]]*)(if|elif)[[:space:]].*;[[:space:]]*then[[:space:]]*$/\1\2 false; then/')" ;;
        # The trailing-comment form is the common one — `if x:  # type: ignore`
        # — and anchoring on the colon being last never reached it.
        python) mutated="$(printf '%s' "$line_text" | sed -E 's/^([[:space:]]*)(if|elif)[[:space:]].*:([[:space:]]*#.*)?$/\1\2 False:/')" ;;
      esac
    else
      op="refusal-off"
      case "$lang" in
        bash)   mutated="$(printf '%s' "$line_text" | sed -E 's/exit[[:space:]]+[1-9][0-9]*/exit 0/')" ;;
        python) mutated="$(printf '%s' "$line_text" | sed -E 's/(sys\.exit|SystemExit)\([1-9][0-9]*\)/\1(0)/')" ;;
      esac
    fi
    # The rewrite is line-based and the parser is not: a guard whose condition
    # spans several lines is a guard this tool knows about and cannot reach.
    # Counting it as nothing would round "unmeasured" down to "covered", which is
    # the one answer this sweep exists to refuse.
    if [ "$mutated" = "$line_text" ]; then
      # Two different shapes land here and they deserve different words: a true
      # count with a false explanation is how a report starts being read past.
      if printf '%s\n' "$line_text" | grep -qE '^[[:space:]]*(if|elif)[[:space:]].*:[[:space:]]*[^[:space:]#]'; then
        inline_unreached=$((inline_unreached+1))
      else
        unreached=$((unreached+1))
      fi
      continue
    fi
    total=$((total+1))
    cp "$subject" "$scratch/bin/$name"
    awk -v n="$line_no" -v repl="$mutated" 'NR==n{print repl; next}{print}' \
      "$subject" > "$scratch/bin/$name.tmp" && mv "$scratch/bin/$name.tmp" "$scratch/bin/$name"
    chmod +x "$scratch/bin/$name"
    if (cd "$scratch" && DOTFILES_DIR="$scratch" run_bounded "$TIMEOUT_S" bash "$test" "$scratch" >/dev/null 2>&1 </dev/null); then
      if is_equivalent_mutant "$name" "$line_no"; then
        killed=$((killed+1))   # accepted as changing nothing
      else
        survived=$((survived+1)); survived_total=$((survived_total+1))
        rows+=("SURVIVED|$name|bin/$name:$line_no $op — the test passes with: $(printf '%s' "$line_text" | sed 's/^[[:space:]]*//')")
      fi
    else
      killed=$((killed+1))
    fi
  done <<< "$targets"

  local why=""
  [ "$unreached" -gt 0 ] && why="$unreached guard(s) whose condition spans several lines"
  if [ "$inline_unreached" -gt 0 ]; then
    [ -n "$why" ] && why="$why and "
    why="$why$inline_unreached with a body on the same line as the \`if\`"
  fi
  unreached=$((unreached + inline_unreached))
  if [ "$unreached" -gt 0 ]; then
    rows+=("UNREACHED|$name|$why; the rewrite is line-based and cannot change them")
    unmeasured=$((unmeasured+1))
  fi
  # A subject with guards this tool could not reach is not fully covered, and
  # printing KILLED beside its own UNREACHED row would be the report arguing with
  # itself. (The subject-mode condition still reads the RUN totals rather than
  # this subject's — TASK-075, left alone here on purpose.)
  if [ "$unreached" -eq 0 ] \
     && if [ "$MODE" = subject ]; then [ "$survived_total" -eq 0 ] && [ "$errored" -eq 0 ]; else [ "$survived" -eq 0 ]; fi; then
    rows+=("KILLED|$name|$killed/$total mutants noticed")
    bites=$((bites+1))
  fi
}

names=()
if [ "$MODE" = subject ] && [ "${#REQUESTED[@]}" -eq 0 ]; then
  echo "mutation-sweep: --subject needs at least one name; mutating every subject" \
       "would take hours and say little" >&2
  exit 2
fi
if [ "${#REQUESTED[@]}" -gt 0 ]; then
  names=("${REQUESTED[@]}")
else
  for t in "$ROOT"/bin/*-test; do
    [ -e "$t" ] || continue
    s="${t%-test}"
    [ -f "$s" ] && names+=("$(basename "$s")")
  done
fi

for n in "${names[@]}"; do
  if [ ! -f "$ROOT/bin/$n" ] || [ ! -f "$ROOT/bin/$n-test" ]; then
    rows+=("ERROR|$n|no bin/$n and bin/$n-test pair"); errored=$((errored+1)); continue
  fi
  if [ "$MODE" = subject ]; then mutate_one "$n"; else sweep_one "$n"; fi
done

# Tests whose subject is not bin/<name> — skills/agents-bin, the hooks, the
# installers — are outside this sweep's naming convention. Naming them is the
# honest form of "not covered"; silence would read as covered.
unpaired=()
if [ "${#REQUESTED[@]}" -eq 0 ]; then
  for t in "$ROOT"/bin/*-test; do
    [ -e "$t" ] || continue
    [ -f "${t%-test}" ] || unpaired+=("$(basename "$t")")
  done
fi

AFTER="$(fingerprint)"
if [ "$BEFORE" != "$AFTER" ]; then
  echo "mutation-sweep: ABORT — the working tree changed during the sweep" >&2
  diff <(printf '%s\n' "$BEFORE") <(printf '%s\n' "$AFTER") >&2
  exit 2
fi

if [ "$JSON" -eq 1 ]; then
  printf '{"bites":%d,"survived":%d,"unsweepable":%d,"errored":%d,"results":[' \
    "$bites" "$survived" "$unsweepable" "$errored"
  sep=""
  for r in "${rows[@]}"; do
    IFS='|' read -r verdict name detail <<< "$r"
    printf '%s{"verdict":"%s","name":"%s","detail":"%s"}' "$sep" "$verdict" "$name" "$detail"
    sep=","
  done
  printf '],"unpaired":['
  sep=""
  for u in "${unpaired[@]:-}"; do [ -n "$u" ] && { printf '%s"%s"' "$sep" "$u"; sep=","; }; done
  printf ']}\n'
else
  for r in "${rows[@]}"; do
    IFS='|' read -r verdict name detail <<< "$r"
    printf '  %-12s %-26s %s\n' "$verdict" "$name" "$detail"
  done
  if [ "${#unpaired[@]}" -gt 0 ]; then
    printf '\nNot swept — no bin/<name> subject to stub (%d):\n  %s\n' \
      "${#unpaired[@]}" "$(printf '%s ' "${unpaired[@]}")"
  fi
  if [ "$MODE" = subject ]; then
    printf '\nmutation-sweep: %d subject(s) fully covered, %d mutant(s) survived, %d unmeasured, %d errored\n' \
      "$bites" "$survived_total" "$unmeasured" "$errored"
  else
    printf '\nmutation-sweep: %d bite, %d survived, %d unsweepable, %d errored\n' \
      "$bites" "$survived" "$unsweepable" "$errored"
  fi
fi

# Subject mode counts surviving MUTANTS, stub mode counts surviving TESTS. Both
# must fail the run; an earlier edit patched a line the other device had already
# rewritten, so subject mode silently exited 0 with nine gaps on the screen.
if [ "$MODE" = subject ]; then
  # Unmeasured is not a pass. A subject the operators cannot reach is a gap in
  # this tool, and hiding it behind exit 0 is how a gate becomes decoration.
  [ "$survived_total" -eq 0 ] && [ "$errored" -eq 0 ] && [ "$unmeasured" -eq 0 ]
else
  [ "$survived" -eq 0 ] && [ "$errored" -eq 0 ]
fi
