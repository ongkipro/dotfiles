#!/usr/bin/env bash
# Regression test for bin/mutation-sweep.
#
# The sweep's whole value is its three-way answer, so each verdict gets a
# fixture built to earn exactly that verdict. A sweep that called everything
# BITES would look healthy and mean nothing, which is the failure it exists to
# find in other tests.
set -uo pipefail

ROOT="${1:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
SWEEP="$ROOT/bin/mutation-sweep"
[ -x "$SWEEP" ] || { echo "mutation-sweep-test: $SWEEP not executable" >&2; exit 2; }
TMP="$(mktemp -d "${TMPDIR:-/tmp}/mutation-sweep-test.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
fails=0
fail(){ echo "  FAIL $*" >&2; fails=$((fails+1)); }
ok(){ printf '  ✓ %s\n' "$1"; }

FIX="$TMP/fixture"; mkdir -p "$FIX/bin"

# 1. A subject with real behaviour and a test that checks it: BITES.
printf '#!/usr/bin/env bash\necho seventeen\n' > "$FIX/bin/biter"
cat > "$FIX/bin/biter-test" <<'EOF'
#!/usr/bin/env bash
R="${1:?}"
[ "$("$R/bin/biter")" = "seventeen" ] || exit 1
EOF

# 2. A test that runs its subject and asserts nothing about the result. This is
#    the shape the sweep exists to name: green, and empty.
printf '#!/usr/bin/env bash\necho anything\n' > "$FIX/bin/sleeper"
cat > "$FIX/bin/sleeper-test" <<'EOF'
#!/usr/bin/env bash
R="${1:?}"
"$R/bin/sleeper" >/dev/null 2>&1
exit 0
EOF

# 3. A test that resolves its subject from its own location, so the root it is
#    handed is decoration. Not healthy, not broken — unmeasured, and said so.
printf '#!/usr/bin/env bash\necho fixed\n' > "$FIX/bin/hardcoded"
cat > "$FIX/bin/hardcoded-test" <<'EOF'
#!/usr/bin/env bash
SELF="$(cd "$(dirname "$0")" && pwd)"
[ "$("$SELF/hardcoded")" = "fixed" ] || exit 1
EOF

# 4. A node subject. The stub must be written in the subject's own language: a
#    bash stub under a node shebang cannot run, the marker stays empty, and the
#    sweep reports UNSWEEPABLE — a wrong answer wearing a cautious one. That is
#    exactly what shipped before this fixture existed.
if command -v node >/dev/null 2>&1; then
  printf '#!/usr/bin/env node\nconsole.log("nineteen");\n' > "$FIX/bin/noder"
  cat > "$FIX/bin/noder-test" <<'EOF'
#!/usr/bin/env bash
R="${1:?}"
[ "$(node "$R/bin/noder")" = "nineteen" ] || exit 1
EOF
fi

chmod +x "$FIX"/bin/*
git -C "$FIX" init -q
git -C "$FIX" add -A >/dev/null
git -C "$FIX" -c user.email=t@t -c user.name=t commit -qm fixture >/dev/null

verdict() { printf '%s' "$1" | python3 -c '
import json,sys
d=json.load(sys.stdin)
print(next((r["verdict"] for r in d["results"] if r["name"]==sys.argv[1]), "ABSENT"))' "$2"; }

OUT="$(DOTFILES_DIR="$FIX" MUTATION_SWEEP_TIMEOUT=30 "$SWEEP" --json 2>/dev/null)"
rc_all=$?

[ "$(verdict "$OUT" biter)" = BITES ] && ok "a test that checks behaviour bites" \
  || fail "biter should BITE, got $(verdict "$OUT" biter)"
[ "$(verdict "$OUT" sleeper)" = SURVIVED ] && ok "a test that asserts nothing survives" \
  || fail "sleeper should SURVIVE, got $(verdict "$OUT" sleeper)"
[ "$(verdict "$OUT" hardcoded)" = UNSWEEPABLE ] && ok "a test that ignores its root is unsweepable" \
  || fail "hardcoded should be UNSWEEPABLE, got $(verdict "$OUT" hardcoded)"

if command -v node >/dev/null 2>&1; then
  [ "$(verdict "$OUT" noder)" = BITES ] && ok "a node subject is stubbed in its own language" \
    || fail "noder should BITE, got $(verdict "$OUT" noder) — the stub is not valid node"
fi

# A survivor must fail the command, or the sweep is a report nobody has to act on.
[ "$rc_all" -ne 0 ] && ok "a survivor exits non-zero" || fail "a survivor did not fail the run"

# UNSWEEPABLE alone must NOT fail: it is a gap to record, not a defect to block on.
OUT2="$(DOTFILES_DIR="$FIX" MUTATION_SWEEP_TIMEOUT=30 "$SWEEP" --json hardcoded 2>/dev/null)"; rc2=$?
[ "$rc2" -eq 0 ] && ok "unsweepable alone does not fail the run" \
  || fail "unsweepable alone failed the run (exit $rc2)"

# A test whose subject is not bin/<name> is named, not silently omitted.
cat > "$FIX/bin/orphan-test" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
chmod +x "$FIX/bin/orphan-test"
git -C "$FIX" add -A >/dev/null
git -C "$FIX" -c user.email=t@t -c user.name=t commit -qm orphan >/dev/null
OUT3="$(DOTFILES_DIR="$FIX" MUTATION_SWEEP_TIMEOUT=30 "$SWEEP" --json 2>/dev/null)"
printf '%s' "$OUT3" | grep -q '"orphan-test"' && ok "an unpaired test is named" \
  || fail "an unpaired test was omitted from the report"

# ── Subject mutation (TASK-072) ──────────────────────────────────────────────
# Stubbing asks whether a test asserts anything. Mutating asks the question that
# actually caught defects here: would it notice a plausible bug? Nine of ten
# tests written on 2026-09-04 passed the stub and fell to a hand mutation days
# later, so each verdict of the new mode gets a fixture built to earn it.
MFIX="$TMP/mutfix"; mkdir -p "$MFIX/bin"

# A subject with two guards. The test below checks one and ignores the other, so
# one mutant must be killed and one must survive — a mode that reported all-clear
# or all-gap would pass a fixture with only one of them.
cat > "$MFIX/bin/guarded" <<'EOF'
#!/usr/bin/env bash
if [ "${1:-}" = "checked" ]; then
  echo "checked-branch"
fi
if [ "${1:-}" = "ignored" ]; then
  echo "ignored-branch"
fi
exit 0
EOF
cat > "$MFIX/bin/guarded-test" <<'EOF'
#!/usr/bin/env bash
R="${1:?}"
[ "$("$R/bin/guarded" checked)" = "checked-branch" ] || exit 1
"$R/bin/guarded" ignored >/dev/null 2>&1 || exit 1
EOF

# A subject whose refusal is asserted: exit 1 -> exit 0 must be noticed.
cat > "$MFIX/bin/refuser" <<'EOF'
#!/usr/bin/env bash
if [ -z "${1:-}" ]; then
  echo "need an argument" >&2
  exit 1
fi
exit 0
EOF
cat > "$MFIX/bin/refuser-test" <<'EOF'
#!/usr/bin/env bash
R="${1:?}"
"$R/bin/refuser" >/dev/null 2>&1 && exit 1
exit 0
EOF

# A test that fails on the UNMUTATED subject. Every mutant would look killed and
# the subject would be reported perfectly covered — ai-doctor-test was in exactly
# this state on 2026-09-07, which is why the baseline is checked first.
cat > "$MFIX/bin/broken" <<'EOF'
#!/usr/bin/env bash
if [ -n "${1:-}" ]; then
  echo ok
fi
exit 0
EOF
printf '#!/usr/bin/env bash
exit 1
' > "$MFIX/bin/broken-test"

chmod +x "$MFIX"/bin/*
git -C "$MFIX" init -q
git -C "$MFIX" add -A >/dev/null
git -C "$MFIX" -c user.email=t@t -c user.name=t commit -qm mutfix >/dev/null

msweep() { DOTFILES_DIR="$MFIX" MUTATION_SWEEP_TIMEOUT=30 "$SWEEP" --subject "$@" 2>&1; }

OUTG="$(msweep guarded)"; rcg=$?
printf '%s' "$OUTG" | grep -q 'SURVIVED.*guarded:5' \
  && ok "a guard the test ignores survives, named by line" \
  || fail "the ignored guard was not reported: $(printf '%s' "$OUTG" | head -3 | tr '\n' ' ')"
printf '%s' "$OUTG" | grep -q 'guarded:2' \
  && fail "the guard the test DOES check was reported as a gap" \
  || ok "a guard the test checks is not reported"
[ "$rcg" -ne 0 ] && ok "a surviving mutant fails the run" || fail "survivors did not fail the run"

OUTR="$(msweep refuser)"; rcr=$?
printf '%s' "$OUTR" | grep -q 'SURVIVED' \
  && fail "an asserted refusal was reported as a gap" \
  || ok "a refusal the test asserts is killed"
[ "$rcr" -eq 0 ] && ok "a fully covered subject exits 0" || fail "a covered subject failed (exit $rcr)"

# The same two operators, in python. Guard-off is `if COND:` -> `if False:`,
# refusal-off is `sys.exit(N)` -> `sys.exit(0)`. Both fixtures are built the way
# the bash ones are: something the test checks must be killed and something it
# ignores must survive, so a mode reporting all-clear or all-gap fails here.
cat > "$MFIX/bin/pyguard" <<'EOF'
#!/usr/bin/env python3
import sys
arg = sys.argv[1] if len(sys.argv) > 1 else ""
if arg == "checked":
    print("checked-branch")
if arg == "ignored":
    print("ignored-branch")
EOF
cat > "$MFIX/bin/pyguard-test" <<'EOF'
#!/usr/bin/env bash
R="${1:?}"
[ "$("$R/bin/pyguard" checked)" = "checked-branch" ] || exit 1
"$R/bin/pyguard" ignored >/dev/null 2>&1 || exit 1
EOF

# The refusal here is reachable but its EXIT STATUS is never asserted: the test
# only greps the message. exit 1 -> exit 0 must therefore survive, and be
# labelled refusal-off rather than guard-off — the two operators stay distinct
# in python exactly as they are in bash.
cat > "$MFIX/bin/pyrefuser" <<'EOF'
#!/usr/bin/env python3
import sys
if len(sys.argv) < 2:
    print("need an argument", file=sys.stderr)
    sys.exit(1)
EOF
cat > "$MFIX/bin/pyrefuser-test" <<'EOF'
#!/usr/bin/env bash
R="${1:?}"
"$R/bin/pyrefuser" 2>&1 | grep -q "need an argument" || exit 1
exit 0
EOF

# Node has no shapes defined, so it must still be UNMEASURED. Reporting
# "0 survived" for it reads as full coverage, which is the same lie as a gate
# that judged nothing and printed PASS.
printf '#!/usr/bin/env node\nprocess.exit(0);\n' > "$MFIX/bin/nodesubject"
printf '#!/usr/bin/env bash\nexit 0\n' > "$MFIX/bin/nodesubject-test"
chmod +x "$MFIX"/bin/pyguard "$MFIX"/bin/pyguard-test "$MFIX"/bin/pyrefuser \
         "$MFIX"/bin/pyrefuser-test "$MFIX"/bin/nodesubject "$MFIX"/bin/nodesubject-test
git -C "$MFIX" add -A >/dev/null
git -C "$MFIX" -c user.email=t@t -c user.name=t commit -qm py >/dev/null

OUTPG="$(msweep pyguard)"; rcpg=$?
printf '%s' "$OUTPG" | grep -q 'SURVIVED.*pyguard:6 guard-off' \
  && ok "a python guard the test ignores survives, named by line and operator" \
  || fail "the ignored python guard was not reported: $(printf '%s' "$OUTPG" | head -3 | tr '\n' ' ')"
printf '%s' "$OUTPG" | grep -q 'pyguard:4' \
  && fail "the python guard the test DOES check was reported as a gap" \
  || ok "a python guard the test checks is killed"
printf '%s' "$OUTPG" | grep -q 'pyguard:3' \
  && fail "a ternary if mid-line was mutated as if it were a guard" \
  || ok "and an inline ternary is not mistaken for a guard header"
[ "$rcpg" -ne 0 ] && ok "a surviving python mutant fails the run" \
  || fail "python survivors did not fail the run"

OUTPR="$(msweep pyrefuser)"
printf '%s' "$OUTPR" | grep -q 'SURVIVED.*pyrefuser:5 refusal-off' \
  && ok "a python refusal whose exit status is never asserted survives" \
  || fail "the python refusal was not reported: $(printf '%s' "$OUTPR" | head -3 | tr '\n' ' ')"
printf '%s' "$OUTPR" | grep -q 'pyrefuser:3' \
  && fail "the python guard the test reaches was reported as a gap" \
  || ok "and the guard the test does reach is killed"

# Positive evidence that both python guards and the python refusal are actually
# TARGETED, not merely absent from the survivor list. The assertions above are
# negative — "this line was not reported" reads the same whether the mutant was
# killed or never generated — so this fixture asserts the denominator: three
# shapes in, three mutants noticed.
cat > "$MFIX/bin/pycovered" <<'EOF'
#!/usr/bin/env python3
import sys
if len(sys.argv) < 2:
    print("need an argument", file=sys.stderr)
    sys.exit(1)
if sys.argv[1] == "loud":
    print("loud-branch")
EOF
cat > "$MFIX/bin/pycovered-test" <<'EOF'
#!/usr/bin/env bash
R="${1:?}"
out="$("$R/bin/pycovered" 2>&1)"; rc=$?
[ "$rc" -ne 0 ] || exit 1
printf '%s' "$out" | grep -q "need an argument" || exit 1
[ "$("$R/bin/pycovered" loud)" = "loud-branch" ] || exit 1
exit 0
EOF

# A guard header whose CONDITION mentions sys.exit. Dispatching on the substring
# sent this down the refusal branch, which rewrote the string literal and never
# tried guard-off on it — the operators stayed two in name and became something
# else in fact. Found by the R3 review of this change, 2026-09-11.
cat > "$MFIX/bin/pymisdispatch" <<'EOF'
#!/usr/bin/env python3
import sys
msg = sys.argv[1] if len(sys.argv) > 1 else ""
if msg == "call sys.exit(1) to quit":
    print("triggered")
EOF
cat > "$MFIX/bin/pymisdispatch-test" <<'EOF'
#!/usr/bin/env bash
R="${1:?}"
"$R/bin/pymisdispatch" >/dev/null 2>&1 || exit 1
EOF
chmod +x "$MFIX"/bin/pycovered "$MFIX"/bin/pycovered-test \
         "$MFIX"/bin/pymisdispatch "$MFIX"/bin/pymisdispatch-test
git -C "$MFIX" add -A >/dev/null
git -C "$MFIX" -c user.email=t@t -c user.name=t commit -qm pycov >/dev/null

OUTPC="$(msweep pycovered)"; rcpc=$?
printf '%s' "$OUTPC" | grep -q 'KILLED.*pycovered.*3/3' \
  && ok "two python guards and a python refusal are all three targeted and killed" \
  || fail "python targets were not all generated: $(printf '%s' "$OUTPC" | head -3 | tr '\n' ' ')"
[ "$rcpc" -eq 0 ] && ok "a fully covered python subject exits 0" \
  || fail "a covered python subject failed (exit $rcpc)"

OUTPM="$(msweep pymisdispatch)"
printf '%s' "$OUTPM" | grep -q 'pymisdispatch:4 guard-off' \
  && ok "a guard whose condition mentions sys.exit is still mutated as a guard" \
  || fail "the guard was dispatched by substring: $(printf '%s' "$OUTPM" | head -3 | tr '\n' ' ')"

OUTN="$(msweep nodesubject)"; rcn=$?
printf '%s' "$OUTN" | grep -q 'UNMEASURED' \
  && ok "a subject in a language with no shapes is UNMEASURED" \
  || fail "a node subject was not reported unmeasured"
printf '%s' "$OUTN" | grep -q 'node' \
  && ok "and the report names the language it could not reach" \
  || fail "unmeasured did not name the language"
[ "$rcn" -ne 0 ] && ok "and unmeasured fails the run rather than passing quietly" \
  || fail "unmeasured exited 0"

# A test that reads stdin must not hang the sweep: the runner closes it.
cat > "$MFIX/bin/asker" <<'EOF'
#!/usr/bin/env bash
if [ -z "${1:-}" ]; then
  exit 1
fi
exit 0
EOF
# `cat`, not `read`. A read returns immediately when stdin is already closed and
# blocks when it is a terminal, so the case proved something different depending
# on who invoked the suite — it passed 14 times by hand and failed once under the
# ledger. cat blocks until EOF either way: with the runner closing stdin it ends
# at once, without it the sweep timeout is the only thing that stops it.
cat > "$MFIX/bin/asker-test" <<'EOF'
#!/usr/bin/env bash
R="${1:?}"
cat >/dev/null
"$R/bin/asker" >/dev/null 2>&1 && exit 1
exit 0
EOF
chmod +x "$MFIX/bin/asker" "$MFIX/bin/asker-test"
git -C "$MFIX" add -A >/dev/null
git -C "$MFIX" -c user.email=t@t -c user.name=t commit -qm asker >/dev/null
# The bound is the signal: closed stdin finishes in about a second, an open one
# runs until the 30-second sweep timeout. 15 leaves room for a loaded machine
# without letting a genuine stall through.
# The sweep is handed an stdin that stays OPEN, so the outcome depends on the
# runner and not on whoever invoked this suite. Without that, stdin was already
# /dev/null from the caller and `cat` returned instantly either way — the case
# passed with the guard removed, which is a case that proves nothing.
start=$(date +%s); msweep asker >/dev/null 2>&1 < <(sleep 45); elapsed=$(( $(date +%s) - start ))
[ "$elapsed" -lt 15 ] && ok "a test that blocks on stdin does not stall the sweep (${elapsed}s)" \
  || fail "a stdin read stalled the sweep for ${elapsed}s"

OUTB="$(msweep broken)"
printf '%s' "$OUTB" | grep -q 'BASELINE' \
  && ok "a test that fails unmutated is reported, not read as perfect coverage" \
  || fail "a broken baseline was not detected: $(printf '%s' "$OUTB" | head -3 | tr '\n' ' ')"
printf '%s' "$OUTB" | grep -q 'KILLED' \
  && fail "a broken baseline was counted as killed mutants" || ok "and no verdict is claimed from it"

DOTFILES_DIR="$MFIX" "$SWEEP" --subject >/dev/null 2>&1
[ "$?" -eq 2 ] && ok "--subject with no name exits 2 rather than running for hours" \
  || fail "--subject with no name did not refuse"

# The stub mode must be unchanged by any of this.
printf '%s' "$(DOTFILES_DIR="$FIX" MUTATION_SWEEP_TIMEOUT=30 "$SWEEP" --json 2>/dev/null)" \
  | grep -q '"verdict":"SURVIVED"' && ok "stub mode still classifies as before" \
  || fail "stub mode changed"

# macOS ships bash 3.2 and CI runs there. `declare -A` shipped in this file and
# broke the macOS job the same day; run_bounded exists because macOS has no GNU
# timeout either. That is twice, so the next one fails here instead of in CI.
bash4_only="$(grep -nE '^[^#]*(declare[[:space:]]+-A|local[[:space:]]+-A|mapfile|readarray|\$\{[A-Za-z_][A-Za-z0-9_]*\^\^|\$\{[A-Za-z_][A-Za-z0-9_]*,,)' "$SWEEP" || true)"
[ -z "$bash4_only" ] && ok "no bash 4 only construct (macOS ships 3.2)" \
  || fail "bash 4 construct would break the macOS job: $(printf '%s' "$bash4_only" | head -1)"

# The sweep must not disturb the repository it measures.
BEFORE="$(git -C "$ROOT" status --porcelain | sort)"
DOTFILES_DIR="$FIX" MUTATION_SWEEP_TIMEOUT=30 "$SWEEP" >/dev/null 2>&1
[ "$(git -C "$ROOT" status --porcelain | sort)" = "$BEFORE" ] \
  && ok "the working tree is untouched" || fail "the sweep changed the working tree"

# A timeout is reported as ERROR, never as a pass.
printf '#!/usr/bin/env bash\nexit 0\n' > "$FIX/bin/slow"
printf '#!/usr/bin/env bash\ntrap "" TERM\nsleep 30\n' > "$FIX/bin/slow-test"
chmod +x "$FIX/bin/slow" "$FIX/bin/slow-test"
git -C "$FIX" add -A >/dev/null
git -C "$FIX" -c user.email=t@t -c user.name=t commit -qm slow >/dev/null
started=$(date +%s)
OUT4="$(DOTFILES_DIR="$FIX" MUTATION_SWEEP_TIMEOUT=2 "$SWEEP" --json slow 2>/dev/null)"; rc4=$?
elapsed=$(( $(date +%s) - started ))
[ "$(verdict "$OUT4" slow)" = ERROR ] && ok "a hanging test is an ERROR, not a pass" \
  || fail "a hanging test was not reported as ERROR, got $(verdict "$OUT4" slow)"
[ "$rc4" -ne 0 ] && ok "a timed-out sweep exits non-zero" || fail "a timed-out sweep exited zero"
[ "$elapsed" -lt 15 ] && ok "a hanging test is bounded" \
  || fail "a hanging test took ${elapsed}s"

echo
[ "$fails" -eq 0 ] && { echo "mutation-sweep-test: PASS"; exit 0; }
echo "mutation-sweep-test: $fails case(s) failed" >&2; exit 1
