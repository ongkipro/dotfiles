#!/usr/bin/env node
/**
 * dotads-meta — Per-project Meta Ads workflow & secrets-env bridge for Meta's official `meta` CLI.
 *
 * Subcommands:
 *   baseline --market ID [--province <name|BPS code>] [--city <name>] [--json]
 *     Query the dated public Indonesia baseline offline, without a brand or credentials.
 *   setup [--version <ver>]
 *     Ensure Meta's official `meta-ads` CLI (default 1.2.0) is installed via pipx on this device.
 *   init [dir] [--force]
 *     Scaffold a per-project Meta Ads workspace (brand.json, campaigns/sample-campaign.json, media/, .gitignore).
 *   validate <campaign.json> [--brand <brand.json>] [--json]
 *     Validate campaign + brand manifests offline against Meta ODAX, CBO/ABO, DCO, and conversion rules.
 *   deploy <campaign.json> [--brand <brand.json>] [--apply] [--activate] [--json]
 *     Build the L3->L1 creation plan (dry-run by default). Pass --apply to execute via `meta` CLI with
 *     stateful resume, drift detection, and media SHA-256 deduplication in .meta-state.json. Forces PAUSED unless --activate.
 *   status [campaign.json] [--brand <brand.json>] [--json]
 *     Inspect created entity IDs and cached media SHA-256 hashes recorded in .meta-state.json.
 *   doctor [--brand <brand.json>] [--token-env <NAME>]
 *     Check the installed `meta` CLI binary, secrets-env token availability, and `meta auth status`.
 *   run [--brand <brand.json>] [--token-env <NAME>] -- <meta args...>
 *     Execute raw `meta` CLI commands with ACCESS_TOKEN, AD_ACCOUNT_ID, and BUSINESS_ID injected in-memory.
 */

import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import { spawnSync } from "node:child_process";
import os from "node:os";

const DEFAULT_META_ADS_VERSION = "1.2.0";

const VALID_OBJECTIVES = new Set([
  "OUTCOME_APP_PROMOTION",
  "OUTCOME_AWARENESS",
  "OUTCOME_ENGAGEMENT",
  "OUTCOME_LEADS",
  "OUTCOME_SALES",
  "OUTCOME_TRAFFIC",
]);

const VALID_STATUSES = new Set(["PAUSED", "ACTIVE"]);

const VALID_BID_STRATEGIES = new Set([
  "COST_CAP",
  "LOWEST_COST_WITHOUT_CAP",
  "LOWEST_COST_WITH_BID_CAP",
  "LOWEST_COST_WITH_MIN_ROAS",
]);

const VALID_BILLING_EVENTS = new Set([
  "APP_INSTALLS",
  "CLICKS",
  "IMPRESSIONS",
  "LINK_CLICKS",
  "PAGE_LIKES",
  "POST_ENGAGEMENT",
  "THRUPLAY",
]);

const VALID_OPTIMIZATION_GOALS = new Set([
  "APP_INSTALLS",
  "CONVERSATIONS",
  "EVENT_RESPONSES",
  "IMPRESSIONS",
  "LANDING_PAGE_VIEWS",
  "LEAD_GENERATION",
  "LINK_CLICKS",
  "OFFSITE_CONVERSIONS",
  "PAGE_LIKES",
  "POST_ENGAGEMENT",
  "REACH",
  "THRUPLAY",
  "VALUE",
]);

const VALID_CTAS = new Set([
  "APPLY_NOW",
  "BOOK_TRAVEL",
  "BUY_NOW",
  "CONTACT_US",
  "DOWNLOAD",
  "GET_OFFER",
  "GET_QUOTE",
  "LEARN_MORE",
  "NO_BUTTON",
  "OPEN_LINK",
  "SHOP_NOW",
  "SIGN_UP",
  "SUBSCRIBE",
  "WATCH_MORE",
]);

const VALID_AD_FORMATS = new Set([
  "AUTOMATIC_FORMAT",
  "CAROUSEL",
  "COLLECTION",
  "SINGLE_IMAGE",
  "SINGLE_VIDEO",
]);

const ZERO_DECIMAL_CURRENCIES = new Set([
  "CLP",
  "CRC",
  "HUF",
  "IDR",
  "ISK",
  "JPY",
  "KRW",
  "PYG",
  "TWD",
  "UGX",
  "VND",
]);

const IMAGE_EXTENSIONS = new Set([".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp"]);
const VIDEO_EXTENSIONS = new Set([".mp4", ".mov", ".avi", ".mkv", ".wmv"]);

// Strict Indonesia (ID) vs Malaysia (MY) market lexical guard:
// Flags Malaysian Malay vocabulary when an ad set targets Indonesia ("ID").
const MALAYSIAN_LEXICAL_LEAKS_FOR_ID = [
  { pattern: /\bpercuma\b/i, term: "percuma", idReplacement: "gratis / cuma-cuma ('percuma' means 'sia-sia/useless' in Indonesia)" },
  { pattern: /\bpenghantaran\b/i, term: "penghantaran", idReplacement: "pengiriman / ongkir" },
  { pattern: /\bdiskaun\b/i, term: "diskaun", idReplacement: "diskon / potongan harga" },
  { pattern: /\btempah(?:an)?\b/i, term: "tempah/tempahan", idReplacement: "pesan / pesanan" },
  { pattern: /\b(?:wang dikembalikan|pulangan wang)\b/i, term: "wang dikembalikan / pulangan wang", idReplacement: "garansi uang kembali" },
  { pattern: /\bsila layari\b/i, term: "sila layari", idReplacement: "kunjungi / cek di" },
  { pattern: /\bbila-bila masa\b/i, term: "bila-bila masa", idReplacement: "kapan saja" },
  { pattern: /\btelefon\s+(?:bimbit|pintar)\b/i, term: "telefon bimbit/pintar", idReplacement: "HP / smartphone / ponsel" },
  { pattern: /\bkaki\s*tangan\b/i, term: "kakitangan", idReplacement: "tim / staf / karyawan" },
  { pattern: /\bkesan sampingan\b/i, term: "kesan sampingan", idReplacement: "efek samping" },
  { pattern: /\bsaiz\b/i, term: "saiz", idReplacement: "ukuran / size" },
];

// Flags Indonesian-only vocabulary/slang when an ad set targets Malaysia ("MY").
const INDONESIAN_LEXICAL_LEAKS_FOR_MY = [
  { pattern: /\bgratis(?:\s+ongkir)?\b/i, term: "gratis / gratis ongkir", myReplacement: "percuma / penghantaran percuma" },
  { pattern: /\bongkir\b/i, term: "ongkir", myReplacement: "kos penghantaran" },
  { pattern: /\bdiskon\b/i, term: "diskon", myReplacement: "diskaun / potongan harga" },
  { pattern: /\b(?:nggak|gak|enggak)\b/i, term: "nggak/gak/enggak", myReplacement: "tidak / tak" },
  { pattern: /\bbanget\b/i, term: "banget", myReplacement: "sangat / sekali" },
  { pattern: /\b(?:cewek|cowok)\b/i, term: "cewek/cowok", myReplacement: "wanita / lelaki" },
  { pattern: /\bcelana\b/i, term: "celana", myReplacement: "seluar" },
];

// Local copy/funnel heuristics, not documented ranking penalties. A messaging
// campaign may intentionally use a WhatsApp CTA; review the actual destination.
const SPAMMY_TEXT_CTA_PATTERNS = [
  { pattern: /\bklik\s+(?:link|tautan|tombol)\s+di\s+bawah\b/i, label: "klik link/tombol di bawah" },
  { pattern: /\bklik\s+di\s+sini\b/i, label: "klik di sini" },
  { pattern: /\bclick\s+the\s+link\s+below\b/i, label: "click the link below" },
  { pattern: /\b(?:chat|hubungi|klik|order\s+via|pesan\s+via)\s+(?:wa|whatsapp)\b/i, label: "direct WA/WhatsApp CTA in ad text" },
  { pattern: /\b(?:wa|whatsapp)\s+sekarang\b/i, label: "WA/WhatsApp sekarang" },
  { pattern: /\b(?:beli|order|checkout)\s+sekarang\s+juga\b/i, label: "beli/order sekarang juga" },
];

function extractAdsetCountries(as) {
  const out = new Set();
  if (typeof as?.targeting_countries === "string") {
    for (const c of as.targeting_countries.split(",")) {
      const code = c.trim().toUpperCase();
      if (code) out.add(code);
    }
  } else if (Array.isArray(as?.targeting_countries)) {
    for (const c of as.targeting_countries) {
      const code = String(c || "").trim().toUpperCase();
      if (code) out.add(code);
    }
  }
  const geoCountries = as?.targeting?.geo_locations?.countries;
  if (Array.isArray(geoCountries)) {
    for (const c of geoCountries) {
      const code = String(c || "").trim().toUpperCase();
      if (code) out.add(code);
    }
  }
  return out;
}

function collectCreativeTexts(cr) {
  const texts = [];
  for (const field of ["title", "body", "description"]) {
    if (typeof cr?.[field] === "string" && cr[field].trim()) {
      texts.push({ field, text: cr[field].trim() });
    }
  }
  for (const field of ["titles", "bodies", "descriptions"]) {
    if (Array.isArray(cr?.[field])) {
      cr[field].forEach((val, idx) => {
        if (typeof val === "string" && val.trim()) {
          texts.push({ field: `${field}[${idx}]`, text: val.trim() });
        }
      });
    }
  }
  return texts;
}

function usage(exitCode = 0) {
  const text = `Usage: dotads-meta <subcommand> [options]

Dotfiles helper for Meta Ads. The underlying CLI command remains meta.
Existing campaign/state formats remain compatible; legacy unscoped economics require explicit reconfiguration for financial comparisons.

Subcommands:
  baseline --market ID [--province <name|BPS code>] [--city <name>] [--json]
      Read the public Indonesia shopping baseline offline. Other markets never inherit ID data.
      Province/city evidence retains source periods, populations, and coverage limits.

  setup [--version <ver>]
      Ensure Meta's official meta-ads CLI (default ${DEFAULT_META_ADS_VERSION}) is installed via pipx.

  init [dir] [--force]
      Scaffold brand.json, campaigns/sample-campaign.json, media/, and .gitignore.

  validate <campaign.json> [--brand <brand.json>] [--json]
      Offline validation of brand.json + campaign.json (CBO/ABO rules, OUTCOME_SALES
      conversion requirements, DCO limits, local media files, and budget summary).

  deploy <campaign.json> [--brand <brand.json>] [--apply] [--activate] [--json]
      Dry-run execution plan by default. With --apply, injects ACCESS_TOKEN via
      secrets-env, executes meta CLI steps, and saves IDs/hashes to .meta-state.json.
      Enforces PAUSED status on all created entities unless --activate is passed.

  status [campaign.json] [--brand <brand.json>] [--json]
      Show deployed campaign/creative/adset/ad IDs and media hashes in .meta-state.json.

  doctor [--brand <brand.json>] [--token-env <NAME>]
      Verify meta CLI installation, secrets-env token presence, and auth status.

  run [--brand <brand.json>] [--token-env <NAME>] -- <meta args...>
      Run any meta CLI command with credentials injected in-memory from secrets-env.

  learn <unit-economics|add|list> [options]
      Maintain per-brand Meta Ads intelligence & unit-economics memory in memory/ads-memory.json
      and memory/MEMORY.md (learn from 1st-party data, competitor references, outsource, and audits).

  analyze [<insights.json>] [--pull] [--date-preset <preset>] [--purchase-basis placed|delivered] [--delivery-rate <0..1>] [--brand <brand.json>] [--record-memory] [--json]
      Report observational conversion/creative diagnostics with explicit order and cost bases,
      estimated contribution after ads (not net profit), and unknown/invalid-data qualification,
      with diagnostic candidates and deduplicated insight capture; emits no mutation commands.
`;
  if (exitCode === 0) {
    process.stdout.write(text);
  } else {
    process.stderr.write(text);
  }
  process.exit(exitCode);
}

function resolveMetaBin() {
  if (process.env.META_ADS_BIN) return process.env.META_ADS_BIN;
  const pathDirs = (process.env.PATH || "").split(path.delimiter).filter(Boolean);
  const candidates = [
    ...pathDirs.map((dir) => path.join(dir, "meta")),
    path.join(os.homedir(), ".local", "bin", "meta"),
  ];
  for (const candidate of candidates) {
    try {
      fs.accessSync(candidate, fs.constants.X_OK);
      return candidate;
    } catch {
      // keep searching
    }
  }
  return "meta";
}

function resolveSecretsEnvBin() {
  if (process.env.SECRETS_ENV_BIN) return process.env.SECRETS_ENV_BIN;
  const pathDirs = (process.env.PATH || "").split(path.delimiter).filter(Boolean);
  const candidates = [
    ...pathDirs.map((dir) => path.join(dir, "secrets-env")),
    path.join(os.homedir(), ".local", "bin", "secrets-env"),
    path.join(os.homedir(), "dotfiles", "bin", "secrets-env"),
  ];
  for (const candidate of candidates) {
    try {
      fs.accessSync(candidate, fs.constants.X_OK);
      return candidate;
    } catch {
      // keep searching
    }
  }
  return "secrets-env";
}

function readSecretToken(tokenEnvName = "META_ACCESS_TOKEN") {
  const bin = resolveSecretsEnvBin();
  const res = spawnSync(bin, ["get", tokenEnvName], {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
  });
  if (res.status === 0 && res.stdout && res.stdout.trim()) {
    return res.stdout.trim();
  }
  if (process.env[tokenEnvName] && process.env[tokenEnvName].trim()) {
    return process.env[tokenEnvName].trim();
  }
  if (process.env.ACCESS_TOKEN && process.env.ACCESS_TOKEN.trim()) {
    return process.env.ACCESS_TOKEN.trim();
  }
  const detail = (res.stderr || "").trim() || `key '${tokenEnvName}' not found in secrets-env`;
  throw new Error(`Unable to load secret '${tokenEnvName}' via secrets-env (${detail}).`);
}

function readJsonFile(filePath, label) {
  let raw;
  try {
    raw = fs.readFileSync(filePath, "utf8");
  } catch (err) {
    throw new Error(`Cannot read ${label} at ${filePath}: ${err.message}`);
  }
  try {
    return JSON.parse(raw);
  } catch (err) {
    throw new Error(`Invalid JSON in ${label} at ${filePath}: ${err.message}`);
  }
}

function readJsonArgument(value, workspaceDir, campaignDir, label) {
  if (typeof value !== "string") return value;
  return value.startsWith("@")
    ? readJsonFile(resolveMediaFile(workspaceDir, campaignDir, value.slice(1)), label)
    : JSON.parse(value);
}

function containsRetiredPoll(value, inComponents = false) {
  if (!value || typeof value !== "object") return false;
  return Object.entries(value).some(([key, child]) =>
    key === "poll_spec" || (inComponents && key === "type" && child === "poll") ||
    containsRetiredPoll(child, inComponents || key === "interactive_components_spec")
  );
}

function findBrandPath(campaignPath, explicitBrandPath) {
  if (explicitBrandPath) return path.resolve(explicitBrandPath);
  if (campaignPath) {
    const campaignDir = path.dirname(path.resolve(campaignPath));
    const candidates = [
      path.join(campaignDir, "brand.json"),
      path.join(path.dirname(campaignDir), "brand.json"),
    ];
    for (const candidate of candidates) {
      if (fs.existsSync(candidate)) return candidate;
    }
  }
  const cwdCandidate = path.resolve("brand.json");
  if (fs.existsSync(cwdCandidate)) return cwdCandidate;
  throw new Error(
    "Cannot locate brand.json. Pass --brand <path/to/brand.json> or run inside a project initialized with `dotads-meta init`."
  );
}

function sha256File(filePath) {
  const hash = crypto.createHash("sha256");
  hash.update(fs.readFileSync(filePath));
  return hash.digest("hex");
}

function stableHashObject(obj) {
  return crypto.createHash("sha256").update(JSON.stringify(obj)).digest("hex").slice(0, 16);
}

function resolveMediaFile(workspaceDir, campaignDir, relOrAbsPath) {
  if (path.isAbsolute(relOrAbsPath)) return relOrAbsPath;
  const fromWorkspace = path.resolve(workspaceDir, relOrAbsPath);
  if (fs.existsSync(fromWorkspace)) return fromWorkspace;
  return path.resolve(campaignDir, relOrAbsPath);
}

function formatBudgetSummary(minorAmount, currency = "USD") {
  const cur = String(currency || "USD").toUpperCase();
  const num = Number(minorAmount);
  const major100 = (num / 100).toFixed(2);
  if (ZERO_DECIMAL_CURRENCIES.has(cur)) {
    return `${minorAmount} API units (${num.toLocaleString("en-US")} ${cur} at offset-1 OR ${major100} ${cur} at /100; verify account currency offset in Meta)`;
  }
  return `${minorAmount} minor units (${major100} ${cur} at /100 standard minor-unit scale)`;
}

function validateManifests(campaignPath, explicitBrandPath) {
  const resolvedCampaignPath = path.resolve(campaignPath);
  const brandPath = findBrandPath(resolvedCampaignPath, explicitBrandPath);
  const workspaceDir = path.dirname(brandPath);
  const campaignDir = path.dirname(resolvedCampaignPath);

  const brand = readJsonFile(brandPath, "brand.json");
  const manifest = readJsonFile(resolvedCampaignPath, "campaign manifest");

  const errors = [];
  const warnings = [];
  const mediaFiles = {};

  if (!brand || typeof brand !== "object" || Array.isArray(brand)) {
    errors.push("brand.json must be a JSON object.");
  } else {
    if (!brand.ad_account_id || typeof brand.ad_account_id !== "string") {
      errors.push("brand.json: missing required string 'ad_account_id' (e.g. 'act_1234567890').");
    } else if (!/^act_[0-9]+$/.test(brand.ad_account_id)) {
      errors.push(
        `brand.json: 'ad_account_id' must match 'act_<digits>' (got '${brand.ad_account_id}').`
      );
    }
    if (brand.business_id !== undefined && brand.business_id !== "" && !/^[0-9]+$/.test(String(brand.business_id))) {
      errors.push(`brand.json: 'business_id' must be numeric digits when set (got '${brand.business_id}').`);
    }
    if (brand.page_id !== undefined && brand.page_id !== "" && !/^[0-9]+$/.test(String(brand.page_id))) {
      errors.push(`brand.json: 'page_id' must be numeric digits when set (got '${brand.page_id}').`);
    }
  }

  const campaign = manifest?.campaign;
  if (!campaign || typeof campaign !== "object" || Array.isArray(campaign)) {
    errors.push("campaign manifest: missing required 'campaign' object.");
  }

  const creatives = Array.isArray(manifest?.creatives) ? manifest.creatives : [];
  const adsets = Array.isArray(manifest?.adsets) ? manifest.adsets : [];
  const ads = Array.isArray(manifest?.ads) ? manifest.ads : [];

  // Keys are persisted object identities, not display labels. Validate every
  // namespace before credential lookup or any remote operation.
  for (const [group, entries] of [["campaign", campaign ? [campaign] : []], ["creatives", creatives], ["adsets", adsets], ["ads", ads]]) {
    const seen = new Set();
    for (const item of entries) {
      const key = item?.key ?? item?.name;
      if (typeof key !== "string" || !key.trim() || ["__proto__", "constructor", "prototype"].includes(key)) {
        errors.push(`${group}: effective key must be a non-empty, non-reserved string.`);
      } else if (seen.has(key)) {
        errors.push(`${group}: duplicate key '${key}'.`);
      } else seen.add(key);
    }
  }
  if (errors.length) return { ok: false, errors, warnings, campaignPath: resolvedCampaignPath };

  if (creatives.length === 0) errors.push("campaign manifest: 'creatives' must be a non-empty array.");
  if (adsets.length === 0) errors.push("campaign manifest: 'adsets' must be a non-empty array.");
  if (ads.length === 0) errors.push("campaign manifest: 'ads' must be a non-empty array.");

  let isCbo = false;
  let isFlex = false;
  const budgets = [];
  const currency = brand?.currency || "USD";

  if (campaign && typeof campaign === "object") {
    if (!campaign.name || typeof campaign.name !== "string") {
      errors.push("campaign: 'name' is required.");
    }
    if (!campaign.objective || !VALID_OBJECTIVES.has(campaign.objective)) {
      errors.push(
        `campaign: 'objective' must be one of ${Array.from(VALID_OBJECTIVES).join(", ")} (got '${campaign.objective || ""}').`
      );
    }
    if (campaign.status !== undefined && !VALID_STATUSES.has(campaign.status)) {
      errors.push(`campaign: 'status' must be PAUSED or ACTIVE (got '${campaign.status}').`);
    }
    const hasDaily = campaign.daily_budget !== undefined && campaign.daily_budget !== null;
    const hasLifetime = campaign.lifetime_budget !== undefined && campaign.lifetime_budget !== null;
    if (hasDaily && hasLifetime) {
      errors.push("campaign: 'daily_budget' and 'lifetime_budget' are mutually exclusive.");
    }
    if (hasDaily) {
      if (!Number.isInteger(campaign.daily_budget) || campaign.daily_budget <= 0) {
        errors.push("campaign: 'daily_budget' must be a positive integer in minor currency units.");
      } else {
        isCbo = true;
        budgets.push({
          scope: `campaign:${campaign.name || "unnamed"}`,
          type: "daily_budget",
          minor: campaign.daily_budget,
          formatted: formatBudgetSummary(campaign.daily_budget, currency),
        });
      }
    }
    if (hasLifetime) {
      if (!Number.isInteger(campaign.lifetime_budget) || campaign.lifetime_budget <= 0) {
        errors.push("campaign: 'lifetime_budget' must be a positive integer in minor currency units.");
      } else {
        isCbo = true;
        budgets.push({
          scope: `campaign:${campaign.name || "unnamed"}`,
          type: "lifetime_budget",
          minor: campaign.lifetime_budget,
          formatted: formatBudgetSummary(campaign.lifetime_budget, currency),
        });
      }
    }
    isFlex = Boolean(campaign.adset_budget_sharing);
    if (isCbo && isFlex) {
      errors.push("campaign: 'adset_budget_sharing' cannot be combined with a campaign budget (CBO).");
    }
    if (!isCbo && !isFlex && campaign.bid_strategy) {
      errors.push(
        "campaign: 'bid_strategy' on a plain ABO campaign is rejected by Meta; set 'bid_strategy' on the ad set instead."
      );
    }
    if (!isCbo && campaign.pacing_type) {
      errors.push(
        "campaign: 'pacing_type' requires a campaign budget (CBO); for ABO/flex set 'pacing_type' on the ad set."
      );
    }
    if (campaign.bid_strategy && !VALID_BID_STRATEGIES.has(campaign.bid_strategy)) {
      errors.push(`campaign: invalid 'bid_strategy' '${campaign.bid_strategy}'.`);
    }
    if (campaign.smart_promotion_type !== undefined && campaign.smart_promotion_type !== null && campaign.smart_promotion_type !== "") {
      errors.push(
        `campaign: 'smart_promotion_type' ('${campaign.smart_promotion_type}') is retired for legacy ASC/AAC creation, duplication, and updates in v25.0 and across versions since 2026-05-19. Use a standard supported objective and verify current Advantage+ eligibility.`
      );
    }
  }

  // Validate creatives
  const creativeMap = new Map();
  for (let i = 0; i < creatives.length; i++) {
    const cr = creatives[i];
    const key = cr.key || cr.name;
    const label = `creatives[${i}] (${key || "unnamed"})`;
    if (!key || typeof key !== "string") {
      errors.push(`${label}: requires a string 'key' or 'name'.`);
      continue;
    }
    if (creativeMap.has(key)) {
      errors.push(`${label}: duplicate creative key '${key}'.`);
    }
    if (!cr.name || typeof cr.name !== "string") {
      errors.push(`${label}: 'name' is required.`);
    }
    if (cr.status !== undefined && !VALID_STATUSES.has(cr.status)) {
      errors.push(`${label}: 'status' must be PAUSED or ACTIVE.`);
    }
    if (cr.call_to_action && !VALID_CTAS.has(cr.call_to_action)) {
      errors.push(`${label}: invalid 'call_to_action' '${cr.call_to_action}'.`);
    }
    if (cr.ad_format && !VALID_AD_FORMATS.has(cr.ad_format)) {
      errors.push(
        `${label}: invalid 'ad_format' '${cr.ad_format}' (must be one of ${Array.from(VALID_AD_FORMATS).join(", ")}).`
      );
    }
    for (const field of ["poll_spec", "interactive_components_spec"]) {
      if (cr[field] !== undefined) {
        errors.push(`${label}: '${field}' is not forwarded by this helper. Poll creatives are retired across API versions since 2026-10-27.`);
      }
    }
    for (const field of ["object_story_spec", "asset_feed_spec"]) {
      if (cr[field] === undefined || cr[field] === null) continue;
      try {
        const rawSpec = readJsonArgument(cr[field], workspaceDir, campaignDir, `${label}.${field}`);
        if (!rawSpec || typeof rawSpec !== "object" || Array.isArray(rawSpec)) {
          errors.push(`${label}.${field}: expected a JSON object, not an array, primitive, or null.`);
        } else if (containsRetiredPoll(rawSpec)) {
          errors.push(`${label}.${field}: poll_spec / interactive_components_spec type 'poll' is retired across API versions since 2026-10-27.`);
        }
      } catch {
        errors.push(`${label}.${field}: expected valid JSON or a readable JSON file.`);
      }
    }
    if (cr.applink_treatment === "web_only") {
      warnings.push(`${label}: applink_treatment='web_only' is retired for Web and App campaigns since 2026-10-27. Review the actual conversion locations; use 'automatic' or 'deeplink_with_web_fallback' where applicable. This helper cannot establish the campaign's live configuration.`);
    }
    if (
      cr.degrees_of_freedom_spec &&
      typeof cr.degrees_of_freedom_spec === "object" &&
      cr.degrees_of_freedom_spec?.creative_features_spec?.standard_enhancements !== undefined
    ) {
      warnings.push(
        `${label}: 'creative_features_spec.standard_enhancements' bundle is deprecated in Meta Graph API v22.0+; prefer granular keys (image_touchups, image_templates, video_auto_crop, text_optimizations, inline_comment, background_generation, image_expansion, text_generation).`
      );
    }

    const isDco =
      Array.isArray(cr.images) ||
      Array.isArray(cr.videos) ||
      Array.isArray(cr.titles) ||
      Array.isArray(cr.bodies) ||
      Array.isArray(cr.descriptions) ||
      Array.isArray(cr.call_to_actions);

    const isExistingPost = Boolean(
      cr.object_story_id || cr.source_instagram_media_id || cr.instagram_permalink_url
    );
    const isRawSpec = Boolean(cr.object_story_spec || cr.asset_feed_spec);
    const isCatalog = Boolean(cr.product_set_id);
    const hasSingleMedia = Boolean(cr.image || cr.video || cr.image_hash || cr.video_id);

    const pageId = cr.page_id || brand?.page_id;
    if (!isExistingPost && !cr.object_story_spec && !pageId) {
      errors.push(`${label}: requires 'page_id' (in creative or brand.json) unless boosting an existing post or passing object_story_spec.`);
    }

    if (!isDco && !isExistingPost && !isRawSpec && !isCatalog && !hasSingleMedia && !cr.body) {
      errors.push(`${label}: creative has no media, DCO assets, post reference, catalog product_set_id, or body text.`);
    }

    if (cr.image && cr.video) {
      errors.push(`${label}: cannot set both 'image' and 'video' on a single-media creative.`);
    }

    // Check local media files
    const checkLocalFile = (fileRef, kind) => {
      const resolved = resolveMediaFile(workspaceDir, campaignDir, fileRef);
      if (!fs.existsSync(resolved)) {
        errors.push(`${label}: ${kind} file not found at '${fileRef}' (resolved: ${resolved}).`);
        return null;
      }
      const stat = fs.statSync(resolved);
      if (!stat.isFile() || stat.size === 0) {
        errors.push(`${label}: ${kind} file '${fileRef}' must be a non-empty file.`);
        return null;
      }
      const ext = path.extname(resolved).toLowerCase();
      const allowed = kind === "image" ? IMAGE_EXTENSIONS : VIDEO_EXTENSIONS;
      if (!allowed.has(ext)) {
        errors.push(
          `${label}: unsupported ${kind} extension '${ext}' on '${fileRef}' (allowed: ${Array.from(allowed).join(", ")}).`
        );
        return null;
      }
      const sha256 = sha256File(resolved);
      mediaFiles[resolved] = { path: resolved, kind, bytes: stat.size, sha256 };
      return { resolved, sha256, bytes: stat.size };
    };

    if (cr.image) checkLocalFile(cr.image, "image");
    if (cr.video) checkLocalFile(cr.video, "video");

    if (isDco) {
      if (Array.isArray(cr.images)) {
        if (cr.images.length > 10) errors.push(`${label}: DCO 'images' exceeds maximum of 10.`);
        for (const img of cr.images) checkLocalFile(img, "image");
      }
      if (Array.isArray(cr.videos)) {
        if (cr.videos.length > 10) errors.push(`${label}: DCO 'videos' exceeds maximum of 10.`);
        for (const vid of cr.videos) checkLocalFile(vid, "video");
      }
      if (Array.isArray(cr.titles) && cr.titles.length > 5) {
        errors.push(`${label}: DCO 'titles' exceeds maximum of 5.`);
      }
      if (Array.isArray(cr.bodies) && cr.bodies.length > 5) {
        errors.push(`${label}: DCO 'bodies' exceeds maximum of 5.`);
      }
      if (Array.isArray(cr.descriptions) && cr.descriptions.length > 5) {
        errors.push(`${label}: DCO 'descriptions' exceeds maximum of 5.`);
      }
      if (Array.isArray(cr.call_to_actions)) {
        if (cr.call_to_actions.length > 5) {
          errors.push(`${label}: DCO 'call_to_actions' exceeds maximum of 5.`);
        }
        for (const cta of cr.call_to_actions) {
          if (!VALID_CTAS.has(cta)) {
            errors.push(`${label}: invalid DCO call_to_action '${cta}'.`);
          }
        }
      }
    }

    creativeMap.set(key, { ...cr, _key: key, _isDco: isDco });
  }

  // Validate adsets
  const adsetMap = new Map();
  for (let i = 0; i < adsets.length; i++) {
    const as = adsets[i];
    const key = as.key || as.name;
    const label = `adsets[${i}] (${key || "unnamed"})`;
    if (!key || typeof key !== "string") {
      errors.push(`${label}: requires a string 'key' or 'name'.`);
      continue;
    }
    if (adsetMap.has(key)) {
      errors.push(`${label}: duplicate ad set key '${key}'.`);
    }
    if (!as.name || typeof as.name !== "string") {
      errors.push(`${label}: 'name' is required.`);
    }
    if (!as.optimization_goal || !VALID_OPTIMIZATION_GOALS.has(as.optimization_goal)) {
      errors.push(
        `${label}: 'optimization_goal' must be one of ${Array.from(VALID_OPTIMIZATION_GOALS).join(", ")} (got '${as.optimization_goal || ""}').`
      );
    }
    if (!as.billing_event || !VALID_BILLING_EVENTS.has(as.billing_event)) {
      errors.push(
        `${label}: 'billing_event' must be one of ${Array.from(VALID_BILLING_EVENTS).join(", ")} (got '${as.billing_event || ""}').`
      );
    }
    if (as.status !== undefined && !VALID_STATUSES.has(as.status)) {
      errors.push(`${label}: 'status' must be PAUSED or ACTIVE.`);
    }

    const hasDaily = as.daily_budget !== undefined && as.daily_budget !== null;
    const hasLifetime = as.lifetime_budget !== undefined && as.lifetime_budget !== null;
    if (hasDaily && hasLifetime) {
      errors.push(`${label}: 'daily_budget' and 'lifetime_budget' are mutually exclusive.`);
    }
    if (isCbo && (hasDaily || hasLifetime)) {
      errors.push(
        `${label}: cannot set ad set budget when campaign uses CBO budget (Error 1885621 guard).`
      );
    }
    if (!isCbo && !hasDaily && !hasLifetime) {
      errors.push(
        `${label}: ad set requires 'daily_budget' or 'lifetime_budget' when campaign has no CBO budget.`
      );
    }
    if (isFlex && hasLifetime) {
      errors.push(
        `${label}: 'adset_budget_sharing' (flex) requires 'daily_budget' on ad sets; 'lifetime_budget' is not supported.`
      );
    }
    if (hasDaily) {
      if (!Number.isInteger(as.daily_budget) || as.daily_budget <= 0) {
        errors.push(`${label}: 'daily_budget' must be a positive integer in minor currency units.`);
      } else {
        budgets.push({
          scope: `adset:${as.name || key}`,
          type: "daily_budget",
          minor: as.daily_budget,
          formatted: formatBudgetSummary(as.daily_budget, currency),
        });
      }
    }
    if (hasLifetime) {
      if (!Number.isInteger(as.lifetime_budget) || as.lifetime_budget <= 0) {
        errors.push(`${label}: 'lifetime_budget' must be a positive integer in minor currency units.`);
      } else {
        budgets.push({
          scope: `adset:${as.name || key}`,
          type: "lifetime_budget",
          minor: as.lifetime_budget,
          formatted: formatBudgetSummary(as.lifetime_budget, currency),
        });
      }
      if (!as.end_time) {
        errors.push(`${label}: 'end_time' (ISO 8601) is required when using 'lifetime_budget'.`);
      }
    }

    if (as.bid_strategy && !VALID_BID_STRATEGIES.has(as.bid_strategy)) {
      errors.push(`${label}: invalid 'bid_strategy' '${as.bid_strategy}'.`);
    }
    if (
      (as.bid_strategy === "COST_CAP" || as.bid_strategy === "LOWEST_COST_WITH_BID_CAP") &&
      (!Number.isInteger(as.bid_amount) || as.bid_amount <= 0)
    ) {
      errors.push(`${label}: 'bid_amount' (in minor units) is required for ${as.bid_strategy}.`);
    }

    const hasCountries =
      (typeof as.targeting_countries === "string" && as.targeting_countries.trim().length > 0) ||
      (Array.isArray(as.targeting_countries) && as.targeting_countries.length > 0);
    const hasTargetingJson = Boolean(as.targeting);
    if (!hasCountries && !hasTargetingJson) {
      errors.push(`${label}: must specify either 'targeting_countries' or 'targeting'.`);
    }
    if (hasCountries && hasTargetingJson) {
      errors.push(
        `${label}: specify either 'targeting_countries' or 'targeting', not both ('targeting' replaces 'targeting_countries').`
      );
    }
    if (as.targeting) {
      try {
        const targeting = readJsonArgument(as.targeting, workspaceDir, campaignDir, `${label}.targeting`);
        if (!targeting || typeof targeting !== "object" || Array.isArray(targeting)) {
          errors.push(`${label}: 'targeting' must be a JSON object, not an array, primitive, or null.`);
        } else {
          const automation = targeting.targeting_automation;
          if (automation !== undefined && (!automation || typeof automation !== "object" || Array.isArray(automation))) {
            errors.push(`${label}: targeting_automation must be a JSON object.`);
          } else if (automation?.advantage_audience !== undefined && automation.advantage_audience !== 0 && automation.advantage_audience !== 1) {
            errors.push(`${label}: targeting_automation.advantage_audience must be 0 or 1. The raw nested value overrides the shortcut flag.`);
          }
        }
      } catch {
        errors.push(`${label}: 'targeting' must contain valid JSON or reference a readable JSON file.`);
      }
    }

    const pixelId = as.pixel_id || brand?.pixel_id;
    const needsConversionObject =
      as.optimization_goal === "OFFSITE_CONVERSIONS" || as.optimization_goal === "VALUE";
    if (needsConversionObject && !as.promoted_object) {
      if (!pixelId) {
        errors.push(
          `${label}: optimization_goal '${as.optimization_goal}' requires 'pixel_id' (in ad set or brand.json) or 'promoted_object'.`
        );
      }
      if (!as.custom_event_type) {
        errors.push(
          `${label}: optimization_goal '${as.optimization_goal}' requires 'custom_event_type' (e.g. 'PURCHASE' or 'LEAD').`
        );
      }
    }

    for (const field of ["incremental_attribution", "advantage_audience", "dynamic_creative"]) {
      if (as[field] !== undefined && typeof as[field] !== "boolean") {
        errors.push(`${label}: '${field}' must be a boolean.`);
      }
    }
    if (as.incremental_attribution === true) {
      if (as.attribution_spec !== undefined && as.attribution_spec !== null) {
        errors.push(`${label}: cannot combine 'incremental_attribution: true' with 'attribution_spec'; choose one attribution mode.`);
      }
      if (!["OFFSITE_CONVERSIONS", "VALUE", "RETURN_ON_AD_SPEND"].includes(as.optimization_goal)) {
        errors.push(`${label}: incremental attribution requires a supported conversion/value optimization_goal.`);
      }
      const bidStrategy = (isCbo ? campaign.bid_strategy : as.bid_strategy) || "LOWEST_COST_WITHOUT_CAP";
      if (!["LOWEST_COST_WITHOUT_CAP", "COST_CAP", "LOWEST_COST_WITH_MIN_ROAS"].includes(bidStrategy)) {
        errors.push(`${label}: incremental attribution does not support bid_strategy '${bidStrategy}'.`);
      }
    }

    // Inspect the same inline JSON / @file forms that the CLI receives so files
    // cannot bypass the attribution-window guard. Forwarding retains its form.
    let attributionSpec = as.attribution_spec;
    if (typeof attributionSpec === "string") {
      try {
        attributionSpec = readJsonArgument(attributionSpec, workspaceDir, campaignDir, `${label}.attribution_spec`);
      } catch {
        errors.push(`${label}: 'attribution_spec' must contain valid JSON or reference a readable JSON file.`);
      }
    }
    if (as.attribution_spec !== undefined && as.attribution_spec !== null && !Array.isArray(attributionSpec)) {
      errors.push(`${label}: 'attribution_spec' must be an array of attribution windows.`);
    }
    if (Array.isArray(attributionSpec)) {
      for (const spec of attributionSpec) {
        if (!spec || typeof spec !== "object" || Array.isArray(spec) || typeof spec.event_type !== "string" || !Number.isInteger(spec.window_days) || spec.window_days <= 0) {
          errors.push(`${label}: attribution_spec entries require an event_type and positive integer window_days.`);
          continue;
        }
        if (spec.event_type.toUpperCase() === "ENGAGED_VIEW") {
          errors.push(`${label}: attribution_spec uses 'ENGAGED_VIEW'; the documented API event is 'ENGAGED_VIDEO_VIEW'.`);
        }
        if (
          spec &&
          typeof spec === "object" &&
          String(spec.event_type || "").toUpperCase() === "VIEW_THROUGH" &&
          (Number(spec.window_days) === 7 || Number(spec.window_days) === 28)
        ) {
          errors.push(
            `${label}: attribution_spec VIEW_THROUGH window_days=${spec.window_days} (7d_view/28d_view) is deprecated in Meta Marketing API; choose a goal-supported CLICK_THROUGH, VIEW_THROUGH, or ENGAGED_VIDEO_VIEW window.`
          );
        }
      }
    }

    adsetMap.set(key, { ...as, _key: key });
  }

  // Validate ads
  const dcoAdsetUsageCount = new Map();
  const creativeCountriesMap = new Map();
  for (let i = 0; i < ads.length; i++) {
    const ad = ads[i];
    const key = ad.key || ad.name;
    const label = `ads[${i}] (${key || "unnamed"})`;
    if (!ad.name || typeof ad.name !== "string") {
      errors.push(`${label}: 'name' is required.`);
    }
    if (ad.status !== undefined && !VALID_STATUSES.has(ad.status)) {
      errors.push(`${label}: 'status' must be PAUSED or ACTIVE.`);
    }
    const adsetRef = ad.adset || ad.adset_key;
    const creativeRef = ad.creative || ad.creative_key;
    if (!adsetRef || !adsetMap.has(adsetRef)) {
      errors.push(`${label}: references unknown ad set '${adsetRef || ""}'.`);
    }
    if (!creativeRef || !creativeMap.has(creativeRef)) {
      errors.push(`${label}: references unknown creative '${creativeRef || ""}'.`);
    }
    const resolvedAdset = adsetRef ? adsetMap.get(adsetRef) : null;
    const resolvedCreative = creativeRef ? creativeMap.get(creativeRef) : null;

    if (resolvedCreative && resolvedAdset) {
      if (!creativeCountriesMap.has(creativeRef)) {
        creativeCountriesMap.set(creativeRef, new Set());
      }
      const countrySet = creativeCountriesMap.get(creativeRef);
      for (const c of extractAdsetCountries(resolvedAdset)) {
        countrySet.add(c);
      }
    }

    const isFlexibleCreative = Boolean(
      resolvedCreative?.ad_format === "AUTOMATIC_FORMAT" || resolvedCreative?.asset_feed_spec
    );
    if (resolvedCreative?._isDco && resolvedAdset && !resolvedAdset.dynamic_creative && !isFlexibleCreative) {
      errors.push(
        `${label}: creative '${creativeRef}' uses DCO multi-asset fields, so either ad set '${adsetRef}' must set "dynamic_creative": true (classic DCO) or creative '${creativeRef}' must set "ad_format": "AUTOMATIC_FORMAT" (Flexible Ad Format).`
      );
    }
    if (resolvedAdset?.dynamic_creative) {
      dcoAdsetUsageCount.set(adsetRef, (dcoAdsetUsageCount.get(adsetRef) || 0) + 1);
    }

    const conversionDomain = ad.conversion_domain || brand?.conversion_domain;
    const isSalesOrConversion =
      campaign?.objective === "OUTCOME_SALES" ||
      resolvedAdset?.optimization_goal === "OFFSITE_CONVERSIONS" ||
      resolvedAdset?.optimization_goal === "VALUE";
    if (isSalesOrConversion && !conversionDomain) {
      errors.push(
        `${label}: requires 'conversion_domain' (in ad or brand.json) for OUTCOME_SALES / OFFSITE_CONVERSIONS.`
      );
    }
  }

  for (const [adsetKey, count] of dcoAdsetUsageCount.entries()) {
    if (count > 1) {
      errors.push(
        `adset '${adsetKey}' has "dynamic_creative": true and cannot be referenced by more than 1 ad (got ${count}); Meta API allows only 1 ad per DCO ad set. Either keep 1 ad per DCO ad set or use ad-level Flexible Format ("ad_format": "AUTOMATIC_FORMAT" on creatives with "dynamic_creative": false on the ad set).`
      );
    }
  }

  // Local copy, placement-length, attribution, and market-language heuristics.
  const fallbackCampaignCountries = new Set();
  for (const as of adsets) {
    for (const c of extractAdsetCountries(as)) fallbackCampaignCountries.add(c);
  }
  for (let i = 0; i < creatives.length; i++) {
    const cr = creatives[i];
    const key = cr.key || cr.name;
    const label = `creatives[${i}] (${key || "unnamed"})`;
    const targetCountries = creativeCountriesMap.get(key) || fallbackCampaignCountries;
    const targetsIndonesiaOnly = targetCountries.has("ID") && !targetCountries.has("MY");
    const targetsMalaysiaOnly = targetCountries.has("MY") && !targetCountries.has("ID");
    const textEntries = collectCreativeTexts(cr);

    if (
      campaign?.objective === "OUTCOME_SALES" &&
      cr.link_url &&
      !cr.url_tags &&
      !String(cr.link_url).includes("utm_")
    ) {
      warnings.push(
        `${label}: missing 'url_tags' (e.g. "utm_source=meta&utm_medium=paid_social&utm_campaign=...&utm_content={{ad.id}}") for backend ROAS reconciliation.`
      );
    }

    for (const { field, text } of textEntries) {
      if (field.startsWith("title") && text.length > 40) {
        warnings.push(
          `${label}.${field}: headline length (${text.length} chars) exceeds the local 40-char mobile Feed preview guideline; actual truncation varies by placement.`
        );
      }
      if (field.startsWith("description") && text.length > 30) {
        warnings.push(
          `${label}.${field}: description length (${text.length} chars) exceeds the local 30-char mobile Feed preview guideline; actual visibility varies by placement.`
        );
      }
      for (const rule of SPAMMY_TEXT_CTA_PATTERNS) {
        if (rule.pattern.test(text)) {
          warnings.push(
            `${label}.${field}: contains pushy/off-funnel CTA text ('${rule.label}'). Local copy heuristic: check repetition and destination consistency; messaging campaigns may intentionally use it. This is not evidence of a Meta ranking penalty.`
          );
        }
      }
      if (targetsIndonesiaOnly) {
        for (const leak of MALAYSIAN_LEXICAL_LEAKS_FOR_ID) {
          if (leak.pattern.test(text)) {
            warnings.push(
              `${label}.${field}: targets Indonesia ('ID') but contains Malaysian Malay term '${leak.term}'. Use natural Bahasa Indonesia for the Indonesian market instead: ${leak.idReplacement}.`
            );
          }
        }
      }
      if (targetsMalaysiaOnly) {
        for (const leak of INDONESIAN_LEXICAL_LEAKS_FOR_MY) {
          if (leak.pattern.test(text)) {
            warnings.push(
              `${label}.${field}: targets Malaysia ('MY') but contains Indonesian term/slang '${leak.term}'. Use natural Malaysian Malay for the Malaysian market instead: ${leak.myReplacement}.`
            );
          }
        }
      }
    }
  }

  const allAdvantageAudience = adsets.length > 0 && adsets.every((a) => {
    if (a.targeting) {
      // Raw targeting overrides the shortcut flag. Uninspected JSON/file input
      // cannot establish this local candidate; the CLI resolves it at execution.
      if (typeof a.targeting !== "object" || Array.isArray(a.targeting)) return false;
      const nested = a.targeting.targeting_automation?.advantage_audience;
      if (nested !== undefined) return nested === 1;
    }
    return a.advantage_audience === true;
  });
  let advantageStateCandidate = "MANUAL_OR_HYBRID";
  if (isCbo && allAdvantageAudience) {
    if (campaign?.objective === "OUTCOME_SALES") advantageStateCandidate = "ADVANTAGE_PLUS_SALES";
    else if (campaign?.objective === "OUTCOME_LEADS") advantageStateCandidate = "ADVANTAGE_PLUS_LEADS";
    else if (campaign?.objective === "OUTCOME_APP_PROMOTION") advantageStateCandidate = "ADVANTAGE_PLUS_APP";
  }
  const algorithmAlignment = {
    advantageStateCandidate,
    verifiedWithMeta: false,
    incrementalAttributionAdsets: adsets.filter((a) => a.incremental_attribution === true).length,
    totalAdsets: adsets.length,
    distinctCreatives: creatives.length,
  };

  return {
    ok: errors.length === 0,
    errors,
    warnings,
    brandPath,
    campaignPath: resolvedCampaignPath,
    workspaceDir,
    campaignDir,
    brand,
    manifest,
    isCbo,
    isFlex,
    budgets,
    mediaFiles,
    algorithmAlignment,
  };
}

function serializeJsonOrFileArg(val, workspaceDir, campaignDir) {
  if (typeof val === "string") {
    if (val.startsWith("@")) {
      const fileRef = val.slice(1);
      const resolved = resolveMediaFile(workspaceDir, campaignDir, fileRef);
      return `@${resolved}`;
    }
    return val;
  }
  return JSON.stringify(val);
}

function buildCampaignArgs(validation, activate) {
  const { brand, manifest } = validation;
  const c = manifest.campaign;
  const status = activate ? c.status || "PAUSED" : "PAUSED";
  const args = [
    "--output",
    "json",
    "--no-input",
    "ads",
    "--ad-account-id",
    brand.ad_account_id,
  ];
  if (brand.business_id) {
    args.push("--business-id", String(brand.business_id));
  }
  args.push("campaign", "create", "--name", c.name, "--objective", c.objective, "--status", status);

  if (c.daily_budget !== undefined && c.daily_budget !== null) {
    args.push("--daily-budget", String(c.daily_budget));
  }
  if (c.lifetime_budget !== undefined && c.lifetime_budget !== null) {
    args.push("--lifetime-budget", String(c.lifetime_budget));
  }
  if (c.bid_strategy) args.push("--bid-strategy", c.bid_strategy);
  if (c.buying_type) args.push("--buying-type", c.buying_type);
  if (c.pacing_type) args.push("--pacing-type", c.pacing_type);
  if (c.adset_budget_sharing === true) args.push("--adset-budget-sharing");
  if (c.adset_budget_sharing === false) args.push("--no-adset-budget-sharing");
  if (c.skadnetwork_attribution === true) args.push("--skadnetwork-attribution");
  if (c.skadnetwork_attribution === false) args.push("--no-skadnetwork-attribution");
  if (c.spend_cap !== undefined && c.spend_cap !== null) args.push("--spend-cap", String(c.spend_cap));
  if (c.start_time) args.push("--start-time", c.start_time);
  if (c.stop_time) args.push("--stop-time", c.stop_time);
  if (Array.isArray(c.special_ad_categories)) {
    for (const cat of c.special_ad_categories) {
      args.push("--special-ad-categories", String(cat));
    }
  } else if (c.special_ad_categories) {
    args.push("--special-ad-categories", String(c.special_ad_categories));
  }
  return args;
}

function buildCreativeArgs(validation, cr, stateMediaCache, activate) {
  const { brand, workspaceDir, campaignDir } = validation;
  const args = [
    "--output",
    "json",
    "--no-input",
    "ads",
    "--ad-account-id",
    brand.ad_account_id,
  ];
  if (brand.business_id) {
    args.push("--business-id", String(brand.business_id));
  }
  args.push("creative", "create", "--name", cr.name);

  const pageId = cr.page_id || brand.page_id;
  const isExistingPost = Boolean(
    cr.object_story_id || cr.source_instagram_media_id || cr.instagram_permalink_url
  );
  if (pageId && !isExistingPost && !cr.object_story_spec) {
    args.push("--page-id", String(pageId));
  }
  const igUserId = cr.instagram_user_id || brand.instagram_user_id;
  if (igUserId) {
    args.push("--instagram-user-id", String(igUserId));
  }

  let primaryMediaSha = null;
  let primaryMediaKind = null;

  if (cr.image_hash) {
    args.push("--image-hash", String(cr.image_hash));
  } else if (cr.image) {
    const resolved = resolveMediaFile(workspaceDir, campaignDir, cr.image);
    const sha = validation.mediaFiles[resolved]?.sha256 || sha256File(resolved);
    primaryMediaSha = sha;
    primaryMediaKind = "image";
    const cached = stateMediaCache?.[sha];
    if (cached?.image_hash) {
      args.push("--image-hash", String(cached.image_hash));
    } else {
      args.push("--image", resolved);
    }
  }

  if (cr.video_id) {
    args.push("--video-id", String(cr.video_id));
  } else if (cr.video) {
    const resolved = resolveMediaFile(workspaceDir, campaignDir, cr.video);
    const sha = validation.mediaFiles[resolved]?.sha256 || sha256File(resolved);
    primaryMediaSha = sha;
    primaryMediaKind = "video";
    const cached = stateMediaCache?.[sha];
    if (cached?.video_id) {
      args.push("--video-id", String(cached.video_id));
    } else {
      args.push("--video", resolved);
    }
  }

  if (cr.body) args.push("--body", cr.body);
  if (cr.title) args.push("--title", cr.title);
  if (cr.description) args.push("--description", cr.description);
  if (cr.link_url) args.push("--link-url", cr.link_url);
  if (cr.call_to_action) args.push("--call-to-action", cr.call_to_action);

  if (Array.isArray(cr.images)) {
    for (const img of cr.images) {
      args.push("--images", resolveMediaFile(workspaceDir, campaignDir, img));
    }
  }
  if (Array.isArray(cr.videos)) {
    for (const vid of cr.videos) {
      args.push("--videos", resolveMediaFile(workspaceDir, campaignDir, vid));
    }
  }
  if (Array.isArray(cr.titles)) {
    for (const t of cr.titles) args.push("--titles", String(t));
  }
  if (Array.isArray(cr.bodies)) {
    for (const b of cr.bodies) args.push("--bodies", String(b));
  }
  if (Array.isArray(cr.descriptions)) {
    for (const d of cr.descriptions) args.push("--descriptions", String(d));
  }
  if (Array.isArray(cr.call_to_actions)) {
    for (const cta of cr.call_to_actions) args.push("--call-to-actions", String(cta));
  }
  if (cr.ad_format) args.push("--ad-format", cr.ad_format);

  if (cr.object_story_id) args.push("--object-story-id", String(cr.object_story_id));
  if (cr.source_instagram_media_id) {
    args.push("--source-instagram-media-id", String(cr.source_instagram_media_id));
  }
  if (cr.instagram_permalink_url) {
    args.push("--instagram-permalink-url", String(cr.instagram_permalink_url));
  }
  if (cr.product_set_id) args.push("--product-set-id", String(cr.product_set_id));
  if (cr.url_tags) args.push("--url-tags", String(cr.url_tags));
  if (cr.authorization_category) {
    args.push("--authorization-category", String(cr.authorization_category));
  }
  if (cr.applink_treatment) args.push("--applink-treatment", String(cr.applink_treatment));
  if (cr.contextual_multi_ads === true) args.push("--contextual-multi-ads");
  if (cr.contextual_multi_ads === false) args.push("--no-contextual-multi-ads");

  if (cr.status) {
    args.push("--status", activate ? cr.status : "PAUSED");
  }
  if (cr.object_story_spec) {
    args.push("--object-story-spec", serializeJsonOrFileArg(cr.object_story_spec, workspaceDir, campaignDir));
  }
  if (cr.asset_feed_spec) {
    args.push("--asset-feed-spec", serializeJsonOrFileArg(cr.asset_feed_spec, workspaceDir, campaignDir));
  }
  if (cr.degrees_of_freedom_spec) {
    args.push(
      "--degrees-of-freedom-spec",
      serializeJsonOrFileArg(cr.degrees_of_freedom_spec, workspaceDir, campaignDir)
    );
  }

  const multiMediaSha = [...(cr.images || []), ...(cr.videos || [])].map((ref) => {
    const file = resolveMediaFile(workspaceDir, campaignDir, ref);
    return validation.mediaFiles[file]?.sha256 || sha256File(file);
  });
  return { args, primaryMediaSha, primaryMediaKind, multiMediaSha };
}

function buildAdsetArgs(validation, as, campaignId, activate) {
  const { brand, workspaceDir, campaignDir } = validation;
  const status = activate ? as.status || "PAUSED" : "PAUSED";
  const args = [
    "--output",
    "json",
    "--no-input",
    "ads",
    "--ad-account-id",
    brand.ad_account_id,
  ];
  if (brand.business_id) {
    args.push("--business-id", String(brand.business_id));
  }
  args.push(
    "adset",
    "create",
    "--campaign-id",
    String(campaignId),
    "--name",
    as.name,
    "--optimization-goal",
    as.optimization_goal,
    "--billing-event",
    as.billing_event,
    "--status",
    status
  );

  if (as.daily_budget !== undefined && as.daily_budget !== null) {
    args.push("--daily-budget", String(as.daily_budget));
  }
  if (as.lifetime_budget !== undefined && as.lifetime_budget !== null) {
    args.push("--lifetime-budget", String(as.lifetime_budget));
  }
  if (as.bid_strategy) args.push("--bid-strategy", as.bid_strategy);
  if (as.bid_amount !== undefined && as.bid_amount !== null) {
    args.push("--bid-amount", String(as.bid_amount));
  }
  if (as.pacing_type) args.push("--pacing-type", as.pacing_type);
  if (as.destination_type) args.push("--destination-type", as.destination_type);
  if (as.start_time) args.push("--start-time", as.start_time);
  if (as.end_time) args.push("--end-time", as.end_time);

  const pixelId = as.pixel_id || brand.pixel_id;
  if (as.promoted_object) {
    args.push("--promoted-object", serializeJsonOrFileArg(as.promoted_object, workspaceDir, campaignDir));
  } else {
    if (pixelId && (as.pixel_id || as.optimization_goal === "OFFSITE_CONVERSIONS" || as.optimization_goal === "VALUE")) {
      args.push("--pixel-id", String(pixelId));
    }
    if (as.custom_event_type) {
      args.push("--custom-event-type", String(as.custom_event_type));
    }
  }

  if (as.targeting) {
    args.push("--targeting", serializeJsonOrFileArg(as.targeting, workspaceDir, campaignDir));
  } else if (as.targeting_countries) {
    const countries = Array.isArray(as.targeting_countries)
      ? as.targeting_countries.join(",")
      : String(as.targeting_countries);
    args.push("--targeting-countries", countries);
  }

  if (as.dynamic_creative === true) args.push("--dynamic-creative");
  if (as.dynamic_creative === false) args.push("--no-dynamic-creative");
  if (as.advantage_audience === true) args.push("--advantage-audience");
  if (as.advantage_audience === false) args.push("--no-advantage-audience");
  if (as.incremental_attribution === true) args.push("--incremental-attribution");
  if (as.incremental_attribution === false) args.push("--no-incremental-attribution");
  if (as.attribution_spec) {
    args.push("--attribution-spec", serializeJsonOrFileArg(as.attribution_spec, workspaceDir, campaignDir));
  }
  if (as.dsa_beneficiary) args.push("--dsa-beneficiary", String(as.dsa_beneficiary));
  if (as.dsa_payor) args.push("--dsa-payor", String(as.dsa_payor));

  return args;
}

function buildAdArgs(validation, ad, adsetId, creativeId, activate) {
  const { brand, workspaceDir, campaignDir, manifest } = validation;
  const status = activate ? ad.status || "PAUSED" : "PAUSED";
  const args = [
    "--output",
    "json",
    "--no-input",
    "ads",
    "--ad-account-id",
    brand.ad_account_id,
  ];
  if (brand.business_id) {
    args.push("--business-id", String(brand.business_id));
  }
  args.push(
    "ad",
    "create",
    "--adset-id",
    String(adsetId),
    "--name",
    ad.name,
    "--creative-id",
    String(creativeId),
    "--status",
    status
  );

  const conversionDomain = ad.conversion_domain || brand.conversion_domain;
  if (conversionDomain) {
    args.push("--conversion-domain", String(conversionDomain));
  }
  const pixelId = ad.pixel_id || (manifest.campaign?.objective === "OUTCOME_SALES" ? brand.pixel_id : undefined);
  if (ad.tracking_specs) {
    args.push("--tracking-specs", serializeJsonOrFileArg(ad.tracking_specs, workspaceDir, campaignDir));
  } else if (pixelId) {
    args.push("--pixel-id", String(pixelId));
  }
  if (ad.schedule_start_time) args.push("--schedule-start-time", String(ad.schedule_start_time));
  if (ad.schedule_end_time) args.push("--schedule-end-time", String(ad.schedule_end_time));

  return args;
}

function entityHash(kind, spec, brand, extra = {}) {
  const defaults = { ad_account_id: brand.ad_account_id, business_id: brand.business_id };
  if (kind === "creative") {
    defaults.page_id = spec.page_id || brand.page_id;
    defaults.instagram_user_id = spec.instagram_user_id || brand.instagram_user_id;
  }
  if (kind === "adset" || kind === "ad") defaults.pixel_id = spec.pixel_id || brand.pixel_id;
  if (kind === "ad") defaults.conversion_domain = spec.conversion_domain || brand.conversion_domain;
  return stableHashObject({ spec, defaults, ...extra });
}

function checkStateScope(state, manifest, brand) {
  const populated = ["campaigns", "creatives", "adsets", "ads", "media_cache"].some((k) => Object.keys(state[k]).length);
  if (populated && !state.ad_account_id) {
    throw new Error("Legacy deployment state has no account binding. Verify every saved ID and media entry belongs to this account, back up the state, then explicitly add its ad_account_id before retrying. Do not delete state to bypass this check.");
  }
  if (state.ad_account_id && state.ad_account_id !== brand.ad_account_id) {
    throw new Error("Deployment state account differs from brand.ad_account_id. Use a separate workspace for another account.");
  }
  const campaignId = state.campaigns[manifest.campaign.key || manifest.campaign.name]?.id;
  for (const spec of manifest.adsets) {
    const saved = state.adsets[spec.key || spec.name];
    if (saved && (!campaignId || saved.campaign_id !== campaignId)) {
      throw new Error("Ad set parent conflict: use new ad set and ad keys when changing campaign identity.");
    }
  }
  for (const spec of manifest.ads) {
    const saved = state.ads[spec.key || spec.name];
    const adsetId = state.adsets[spec.adset || spec.adset_key]?.id;
    const creativeId = state.creatives[spec.creative || spec.creative_key]?.id;
    if (saved && (!adsetId || !creativeId || saved.adset_id !== adsetId || saved.creative_id !== creativeId)) {
      throw new Error("Ad parent conflict: use a new ad key when changing ad set or creative identity.");
    }
  }
  state.ad_account_id = brand.ad_account_id;
}

// mkdir is exclusive on Linux and macOS. Never reclaim by age: a slow live
// deploy can outlast any timeout, and a crash may leave unrecorded remote IDs.
function acquireDeployLock(workspaceDir) {
  const lock = path.join(workspaceDir, ".dotads-meta.lock");
  try { fs.mkdirSync(lock, { mode: 0o700 }); }
  catch (err) {
    if (err.code !== "EEXIST") throw err;
    throw new Error(`Deployment lock exists: ${lock}. Wait for the active deploy. After a crash, confirm its process is stopped and reconcile remote IDs with state before removing this lock.`);
  }
  try {
    fs.writeFileSync(path.join(lock, "owner.json"), JSON.stringify({ pid: process.pid, hostname: os.hostname(), started_at: new Date().toISOString() }), { mode: 0o600, flag: "wx" });
  } catch (err) { fs.rmdirSync(lock); throw err; }
  return () => { fs.unlinkSync(path.join(lock, "owner.json")); fs.rmdirSync(lock); };
}

function loadState(stateFile) {
  if (!fs.existsSync(stateFile)) {
    return { version: 1, ...Object.fromEntries(["media_cache", "campaigns", "creatives", "adsets", "ads"].map((key) => [key, Object.create(null)])) };
  }
  const data = readJsonFile(stateFile, "deployment state");
  if (!data || Array.isArray(data) || data.version !== 1) {
    throw new Error(`Invalid deployment state at ${stateFile}: expected version 1. Restore the last valid state before retrying.`);
  }
  for (const group of ["media_cache", "campaigns", "creatives", "adsets", "ads"]) {
    const records = data[group];
    if (!records || typeof records !== "object" || Array.isArray(records)) {
      throw new Error(`Invalid deployment state at ${stateFile}: '${group}' must be an object. Restore the last valid state before retrying.`);
    }
    Object.setPrototypeOf(records, null);
    for (const [key, record] of Object.entries(records)) {
      if (!record || typeof record !== "object" || Array.isArray(record) ||
          (group !== "media_cache" && (typeof record.id !== "string" || !record.id.trim()))) {
        throw new Error(`Invalid deployment state at ${stateFile}: invalid record '${group}.${key}'. Restore the last valid state before retrying.`);
      }
    }
  }
  return data;
}

function saveState(stateFile, state) {
  state.updated_at = new Date().toISOString();
  const tempFile = `${stateFile}.${crypto.randomUUID()}.tmp`;
  try {
    fs.writeFileSync(tempFile, JSON.stringify(state, null, 2) + "\n", { mode: 0o600, flag: "wx" });
    fs.renameSync(tempFile, stateFile);
  } catch (err) {
    throw new Error(`Cannot persist deployment state at ${stateFile}: ${err.message}. Remote creation may already have succeeded; reconcile its ID before retrying.`);
  } finally {
    fs.rmSync(tempFile, { force: true });
  }
}

function parseMetaJsonOutput(stdout) {
  const trimmed = (stdout || "").trim();
  if (!trimmed) throw new Error("Empty stdout from meta CLI.");
  let parsed;
  try {
    parsed = JSON.parse(trimmed);
  } catch {
    const idxArr = trimmed.indexOf("[");
    const idxObj = trimmed.indexOf("{");
    const start =
      idxArr >= 0 && idxObj >= 0 ? Math.min(idxArr, idxObj) : idxArr >= 0 ? idxArr : idxObj;
    if (start >= 0) {
      parsed = JSON.parse(trimmed.slice(start));
    } else {
      throw new Error(`Could not parse JSON from meta CLI output: ${trimmed.slice(0, 200)}`);
    }
  }
  const record = Array.isArray(parsed) ? parsed[0] : parsed;
  if (!record || typeof record !== "object" || !record.id) {
    throw new Error(`meta CLI JSON response did not include an 'id' field: ${trimmed.slice(0, 200)}`);
  }
  return record;
}

function cmdSetup(argv) {
  let version = DEFAULT_META_ADS_VERSION;
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === "--version") {
      version = argv[++i];
      if (!version) throw new Error("--version requires a version string.");
    } else {
      throw new Error(`Unknown option for setup: ${arg}`);
    }
  }

  const metaBin = resolveMetaBin();
  const verRes = spawnSync(metaBin, ["--version"], { encoding: "utf8" });
  if (verRes.status === 0 && (verRes.stdout || "").includes(version)) {
    console.log(`✓ meta-ads CLI already installed: ${(verRes.stdout || "").trim()} (${metaBin})`);
    return;
  }

  const pipxCheck = spawnSync("pipx", ["--version"], { encoding: "utf8" });
  if (pipxCheck.status !== 0) {
    throw new Error("pipx is not installed. Install pipx first (e.g. `sudo apt install pipx` or `brew install pipx`).");
  }

  const pkgSpec = `meta-ads==${version}`;
  console.log(`Installing ${pkgSpec} via pipx...`);
  const installRes = spawnSync("pipx", ["install", "--force", pkgSpec], { stdio: "inherit" });
  if (installRes.status !== 0) {
    throw new Error(`pipx install ${pkgSpec} failed with exit code ${installRes.status}`);
  }
  console.log(`✓ ${pkgSpec} installed.`);
}

function cmdInit(argv) {
  let targetDir = ".";
  let force = false;
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === "--force") {
      force = true;
    } else if (!arg.startsWith("-")) {
      targetDir = arg;
    } else {
      throw new Error(`Unknown option for init: ${arg}`);
    }
  }

  const root = path.resolve(targetDir);
  const campaignsDir = path.join(root, "campaigns");
  const mediaDir = path.join(root, "media");
  const memoryDir = path.join(root, "memory");
  fs.mkdirSync(campaignsDir, { recursive: true });
  fs.mkdirSync(mediaDir, { recursive: true });
  fs.mkdirSync(memoryDir, { recursive: true });

  const brandPath = path.join(root, "brand.json");
  const sampleCampaignPath = path.join(campaignsDir, "sample-campaign.json");
  const memoryJsonPath = path.join(memoryDir, "ads-memory.json");
  const memoryMdPath = path.join(memoryDir, "MEMORY.md");
  const gitignorePath = path.join(root, ".gitignore");
  const mediaPlaceholderPath = path.join(mediaDir, ".gitkeep");

  const created = [];
  const skipped = [];

  if (!fs.existsSync(mediaPlaceholderPath)) {
    fs.writeFileSync(mediaPlaceholderPath, "");
  }

  if (!fs.existsSync(brandPath) || force) {
    const brandTemplate = {
      brand: path.basename(root),
      ad_account_id: "act_1234567890",
      business_id: "9876543210",
      page_id: "1122334455",
      instagram_user_id: "",
      pixel_id: "5566778899",
      conversion_domain: "example.com",
      currency: "USD",
      token_env: "META_ACCESS_TOKEN",
    };
    fs.writeFileSync(brandPath, JSON.stringify(brandTemplate, null, 2) + "\n");
    created.push(brandPath);
  } else {
    skipped.push(brandPath);
  }

  if (!fs.existsSync(sampleCampaignPath) || force) {
    const sampleCampaign = {
      campaign: {
        key: "camp_sales_cbo",
        name: "Sales_CBO_Launch",
        objective: "OUTCOME_SALES",
        status: "PAUSED",
        daily_budget: 5000,
      },
      creatives: [
        {
          key: "cr_hero_v1",
          name: "Creative_Hero_V1",
          image: "media/hero.jpg",
          title: "Engineered for Daily Comfort",
          body: "Discover breathable materials crafted for everyday durability.",
          description: "Fast nationwide shipping",
          link_url: "https://example.com/products/flagship",
          call_to_action: "SHOP_NOW",
          url_tags: "utm_source=meta&utm_medium=paid_social&utm_campaign=sales_cbo_launch",
        },
      ],
      adsets: [
        {
          key: "adset_broad_id",
          name: "AdSet_Broad_ID",
          optimization_goal: "OFFSITE_CONVERSIONS",
          billing_event: "IMPRESSIONS",
          custom_event_type: "PURCHASE",
          targeting_countries: ["ID"],
          status: "PAUSED",
        },
      ],
      ads: [
        {
          key: "ad_hero_v1",
          name: "Ad_Hero_V1",
          adset: "adset_broad_id",
          creative: "cr_hero_v1",
          status: "PAUSED",
        },
      ],
    };
    fs.writeFileSync(sampleCampaignPath, JSON.stringify(sampleCampaign, null, 2) + "\n");
    created.push(sampleCampaignPath);
  } else {
    skipped.push(sampleCampaignPath);
  }

  if (!fs.existsSync(memoryJsonPath) || force) {
    const initialMemory = defaultAdsMemory(path.basename(root));
    saveAdsMemory(root, initialMemory);
    created.push(memoryJsonPath);
    created.push(memoryMdPath);
  } else {
    skipped.push(memoryJsonPath);
  }

  const ignoreLines = [".meta-state.json",
    ".dotads-meta.lock/", ".env", ".env.*"];
  let existingIgnore = fs.existsSync(gitignorePath) ? fs.readFileSync(gitignorePath, "utf8") : "";
  let ignoreUpdated = false;
  for (const line of ignoreLines) {
    if (!existingIgnore.split(/\r?\n/).includes(line)) {
      existingIgnore += (existingIgnore && !existingIgnore.endsWith("\n") ? "\n" : "") + line + "\n";
      ignoreUpdated = true;
    }
  }
  if (ignoreUpdated || !fs.existsSync(gitignorePath)) {
    fs.writeFileSync(gitignorePath, existingIgnore);
    created.push(gitignorePath);
  }

  console.log(`Initialized Meta Ads project workspace at ${root}`);
  for (const p of created) console.log(`  + created ${path.relative(root, p) || "."}`);
  for (const p of skipped) console.log(`  = kept existing ${path.relative(root, p)}`);
  console.log(
    "\nNext steps:\n  1. Edit brand.json with your real Business Manager IDs (ad_account_id, page_id, pixel_id, conversion_domain).\n  2. Place your image/video assets in media/ (e.g. media/hero.jpg).\n  3. Run: dotads-meta validate campaigns/sample-campaign.json"
  );
}

function cmdValidate(argv) {
  let campaignPath = null;
  let brandPath = null;
  let jsonOut = false;

  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === "--brand") {
      brandPath = argv[++i];
      if (!brandPath) throw new Error("--brand requires a file path.");
    } else if (arg === "--json") {
      jsonOut = true;
    } else if (!arg.startsWith("-") && !campaignPath) {
      campaignPath = arg;
    } else {
      throw new Error(`Unknown or unexpected argument for validate: ${arg}`);
    }
  }
  if (!campaignPath) {
    throw new Error("validate requires <campaign.json>.");
  }

  const res = validateManifests(campaignPath, brandPath);
  if (jsonOut) {
    console.log(
      JSON.stringify(
        {
          ok: res.ok,
          errors: res.errors,
          warnings: res.warnings,
          brandPath: res.brandPath,
          campaignPath: res.campaignPath,
          mode: res.isCbo ? "CBO" : res.isFlex ? "FLEX" : "ABO",
          algorithmAlignment: res.algorithmAlignment,
          budgets: res.budgets,
          mediaFiles: Object.values(res.mediaFiles),
        },
        null,
        2
      )
    );
    process.exit(res.ok ? 0 : 1);
  }

  if (!res.ok) {
    console.error(`Validation FAILED for ${res.campaignPath}:`);
    for (const err of res.errors) {
      console.error(`  ✗ ${err}`);
    }
    process.exit(1);
  }

  console.log(`Validation PASSED for ${res.campaignPath}`);
  console.log(`  Brand config : ${res.brandPath} (${res.brand.ad_account_id})`);
  console.log(`  Budget mode  : ${res.isCbo ? "CBO (Campaign Budget)" : res.isFlex ? "FLEX (Ad Set Budget Sharing)" : "ABO (Ad Set Budget)"}`);
  console.log(
    `  Advantage+   : ${res.algorithmAlignment.advantageStateCandidate} (local candidate, not verified with Meta; incremental_attribution: ${res.algorithmAlignment.incrementalAttributionAdsets}/${res.algorithmAlignment.totalAdsets} ad sets, ${res.algorithmAlignment.distinctCreatives} creative key(s))`
  );
  for (const b of res.budgets) {
    console.log(`  Budget       : [${b.scope}] ${b.type} = ${b.formatted}`);
  }
  const mediaList = Object.values(res.mediaFiles);
  console.log(`  Media files  : ${mediaList.length} verified on disk`);
  for (const m of mediaList) {
    console.log(`    - ${path.relative(res.workspaceDir, m.path)} (${m.kind}, ${m.bytes} bytes, sha256:${m.sha256.slice(0, 12)})`);
  }
  for (const w of res.warnings) {
    console.log(`  ⚠ Warning    : ${w}`);
  }
}

function cmdDeploy(argv) {
  let campaignPath = null;
  let brandPath = null;
  let apply = false;
  let activate = false;
  let jsonOut = false;

  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === "--brand") {
      brandPath = argv[++i];
      if (!brandPath) throw new Error("--brand requires a file path.");
    } else if (arg === "--apply") {
      apply = true;
    } else if (arg === "--activate") {
      activate = true;
    } else if (arg === "--json") {
      jsonOut = true;
    } else if (!arg.startsWith("-") && !campaignPath) {
      campaignPath = arg;
    } else {
      throw new Error(`Unknown or unexpected argument for deploy: ${arg}`);
    }
  }
  if (!campaignPath) {
    throw new Error("deploy requires <campaign.json>.");
  }

  const validation = validateManifests(campaignPath, brandPath);
  if (!validation.ok) {
    if (jsonOut) {
      console.log(JSON.stringify({ ok: false, errors: validation.errors }, null, 2));
    } else {
      console.error(`Validation FAILED for ${validation.campaignPath}:`);
      for (const err of validation.errors) console.error(`  ✗ ${err}`);
    }
    process.exit(1);
  }

  const stateFile = path.join(validation.workspaceDir, ".meta-state.json");
  const releaseLock = apply ? acquireDeployLock(validation.workspaceDir) : () => {};
  let uncertainRemote = false;
  try {
  const state = loadState(stateFile);
  const { manifest, brand } = validation;
  checkStateScope(state, manifest, brand);
  const metaBin = resolveMetaBin();

  const campKey = manifest.campaign.key || manifest.campaign.name;
  const campArgs = buildCampaignArgs(validation, activate);
  const campHash = entityHash("campaign", manifest.campaign, brand);
  const existingCamp = state.campaigns[campKey];

  const steps = [];

  steps.push({
    step: 1,
    kind: "campaign",
    key: campKey,
    name: manifest.campaign.name,
    hash: campHash,
    cachedId: existingCamp?.id || null,
    drift: Boolean(existingCamp?.id && existingCamp?.hash && existingCamp.hash !== campHash),
    action: existingCamp?.id ? "SKIP" : "CREATE",
    args: campArgs,
  });

  // Creatives
  for (const cr of manifest.creatives) {
    const crKey = cr.key || cr.name;
    const { args: crArgs, primaryMediaSha, primaryMediaKind, multiMediaSha } = buildCreativeArgs(
      validation,
      cr,
      state.media_cache,
      activate
    );
    const crHash = entityHash("creative", cr, brand, { primaryMediaSha, multiMediaSha });
    const existingCr = state.creatives[crKey];
    steps.push({
      step: steps.length + 1,
      kind: "creative",
      key: crKey,
      name: cr.name,
      hash: crHash,
      primaryMediaSha,
      primaryMediaKind,
      cachedId: existingCr?.id || null,
      drift: Boolean(existingCr?.id && existingCr?.hash && existingCr.hash !== crHash),
      action: existingCr?.id ? "SKIP" : "CREATE",
      args: crArgs,
    });
  }

  // Adsets
  for (const as of manifest.adsets) {
    const asKey = as.key || as.name;
    const placeholderCampId = existingCamp?.id || `<CAMPAIGN_ID:${campKey}>`;
    const asArgs = buildAdsetArgs(validation, as, placeholderCampId, activate);
    const asHash = entityHash("adset", as, brand);
    const existingAs = state.adsets[asKey];
    steps.push({
      step: steps.length + 1,
      kind: "adset",
      key: asKey,
      name: as.name,
      hash: asHash,
      rawSpec: as,
      cachedId: existingAs?.id || null,
      drift: Boolean(existingAs?.id && existingAs?.hash && existingAs.hash !== asHash),
      action: existingAs?.id ? "SKIP" : "CREATE",
      args: asArgs,
    });
  }

  // Ads
  for (const ad of manifest.ads) {
    const adKey = ad.key || ad.name;
    const adsetRef = ad.adset || ad.adset_key;
    const creativeRef = ad.creative || ad.creative_key;
    const placeholderAdsetId = state.adsets[adsetRef]?.id || `<ADSET_ID:${adsetRef}>`;
    const placeholderCreativeId = state.creatives[creativeRef]?.id || `<CREATIVE_ID:${creativeRef}>`;
    const adArgs = buildAdArgs(validation, ad, placeholderAdsetId, placeholderCreativeId, activate);
    const adHash = entityHash("ad", ad, brand, { objective: manifest.campaign.objective });
    const existingAd = state.ads[adKey];
    steps.push({
      step: steps.length + 1,
      kind: "ad",
      key: adKey,
      name: ad.name,
      hash: adHash,
      rawSpec: ad,
      adsetRef,
      creativeRef,
      cachedId: existingAd?.id || null,
      drift: Boolean(existingAd?.id && existingAd?.hash && existingAd.hash !== adHash),
      action: existingAd?.id ? "SKIP" : "CREATE",
      args: adArgs,
    });
  }

  if (!apply) {
    if (jsonOut) {
      console.log(
        JSON.stringify(
          {
            ok: true,
            mode: "DRY_RUN",
            pausedForced: !activate,
            budgets: validation.budgets,
            stateFile,
            steps: steps.map((s) => ({
              step: s.step,
              kind: s.kind,
              key: s.key,
              action: s.action,
              cachedId: s.cachedId,
              drift: s.drift,
              command: [metaBin, ...s.args],
            })),
          },
          null,
          2
        )
      );
      return;
    }

    console.log(`=== DRY-RUN DEPLOYMENT PLAN (${validation.campaignPath}) ===`);
    console.log(`Ad Account : ${brand.ad_account_id}`);
    console.log(`Safety Gate: ${activate ? "ACTIVE ALLOWED (--activate)" : "PAUSED FORCED (default safe mode)"}`);
    for (const b of validation.budgets) {
      console.log(`Budget     : [${b.scope}] ${b.type} = ${b.formatted}`);
    }
    console.log(`State File : ${stateFile}`);
    console.log("");
    for (const s of steps) {
      if (s.action === "SKIP") {
        console.log(`  [${s.step}] SKIP   ${s.kind}:${s.key} -> reuse id=${s.cachedId}`);
        if (s.drift) {
          console.log(
            `      ⚠ DRIFT: local manifest for '${s.key}' changed since id=${s.cachedId} was created. Bump 'key' to create a new entity or update via 'dotads-meta run -- ... update'.`
          );
        }
      } else {
        console.log(`  [${s.step}] CREATE ${s.kind}:${s.key}`);
        console.log(`      $ ${metaBin} ${s.args.map((a) => (/\s/.test(a) ? JSON.stringify(a) : a)).join(" ")}`);
      }
    }
    console.log("\nDry-run complete. No API calls were made. Pass --apply to execute.");
    return;
  }

  // Execute with --apply
  const tokenEnv = brand.token_env || "META_ACCESS_TOKEN";
  const token = readSecretToken(tokenEnv);
  const childEnv = {
    ...process.env,
    ACCESS_TOKEN: token,
    AD_ACCOUNT_ID: brand.ad_account_id,
  };
  if (brand.business_id) {
    childEnv.BUSINESS_ID = String(brand.business_id);
  } else {
    delete childEnv.BUSINESS_ID;
  }

  const runMetaStep = (args, label) => {
    uncertainRemote = true;
    const res = spawnSync(metaBin, args, {
      env: childEnv,
      encoding: "utf8",
      stdio: ["ignore", "pipe", "pipe"],
    });
    if (res.status !== 0) {
      const errText = (res.stderr || res.stdout || "").trim() || `exit code ${res.status}`;
      throw new Error(`Failed at ${label}: ${errText}. Deployment lock retained; reconcile remote IDs before retrying.`);
    }
    return parseMetaJsonOutput(res.stdout);
  };

  const results = [];

  // 1. Campaign
  let campaignId = state.campaigns[campKey]?.id;
  if (!campaignId) {
    const rec = runMetaStep(campArgs, `campaign:${campKey}`);
    campaignId = String(rec.id);
    state.campaigns[campKey] = {
      id: campaignId,
      name: manifest.campaign.name,
      hash: campHash,
      created_at: new Date().toISOString(),
    };
    saveState(stateFile, state);
    uncertainRemote = false;
    results.push({ kind: "campaign", key: campKey, action: "CREATED", id: campaignId, drift: false });
  } else {
    const drift = Boolean(state.campaigns[campKey]?.hash && state.campaigns[campKey].hash !== campHash);
    results.push({ kind: "campaign", key: campKey, action: "SKIPPED", id: campaignId, drift });
  }

  // 2. Creatives
  for (const cr of manifest.creatives) {
    const crKey = cr.key || cr.name;
    let creativeId = state.creatives[crKey]?.id;
    const { args: crArgs, primaryMediaSha, primaryMediaKind, multiMediaSha } = buildCreativeArgs(
      validation,
      cr,
      state.media_cache,
      activate
    );
    const crHash = entityHash("creative", cr, brand, { primaryMediaSha, multiMediaSha });
    if (!creativeId) {
      const rec = runMetaStep(crArgs, `creative:${crKey}`);
      creativeId = String(rec.id);
      const imageHash =
        rec.image_hash ||
        rec.object_story_spec?.link_data?.image_hash ||
        rec.object_story_spec?.photo_data?.image_hash ||
        null;
      const videoId =
        rec.video_id ||
        rec.object_story_spec?.video_data?.video_id ||
        null;

      if (primaryMediaSha) {
        state.media_cache[primaryMediaSha] = {
          kind: primaryMediaKind,
          creative_id: creativeId,
          ...(imageHash ? { image_hash: String(imageHash) } : {}),
          ...(videoId ? { video_id: String(videoId) } : {}),
          updated_at: new Date().toISOString(),
        };
      }
      state.creatives[crKey] = {
        id: creativeId,
        name: cr.name,
        hash: crHash,
        ...(imageHash ? { image_hash: String(imageHash) } : {}),
        ...(videoId ? { video_id: String(videoId) } : {}),
        created_at: new Date().toISOString(),
      };
      saveState(stateFile, state);
    uncertainRemote = false;
      results.push({ kind: "creative", key: crKey, action: "CREATED", id: creativeId, drift: false });
    } else {
      const drift = Boolean(state.creatives[crKey]?.hash && state.creatives[crKey].hash !== crHash);
      results.push({ kind: "creative", key: crKey, action: "SKIPPED", id: creativeId, drift });
    }
  }

  // 3. Ad Sets
  for (const as of manifest.adsets) {
    const asKey = as.key || as.name;
    let adsetId = state.adsets[asKey]?.id;
    const asHash = entityHash("adset", as, brand);
    if (!adsetId) {
      const asArgs = buildAdsetArgs(validation, as, campaignId, activate);
      const rec = runMetaStep(asArgs, `adset:${asKey}`);
      adsetId = String(rec.id);
      state.adsets[asKey] = {
        id: adsetId,
        campaign_id: campaignId,
        name: as.name,
        hash: asHash,
        created_at: new Date().toISOString(),
      };
      saveState(stateFile, state);
    uncertainRemote = false;
      results.push({ kind: "adset", key: asKey, action: "CREATED", id: adsetId, drift: false });
    } else {
      const drift = Boolean(state.adsets[asKey]?.hash && state.adsets[asKey].hash !== asHash);
      results.push({ kind: "adset", key: asKey, action: "SKIPPED", id: adsetId, drift });
    }
  }

  // 4. Ads
  for (const ad of manifest.ads) {
    const adKey = ad.key || ad.name;
    let adId = state.ads[adKey]?.id;
    const adHash = entityHash("ad", ad, brand, { objective: manifest.campaign.objective });
    if (!adId) {
      const adsetRef = ad.adset || ad.adset_key;
      const creativeRef = ad.creative || ad.creative_key;
      const adsetId = state.adsets[adsetRef]?.id;
      const creativeId = state.creatives[creativeRef]?.id;
      const adArgs = buildAdArgs(validation, ad, adsetId, creativeId, activate);
      const rec = runMetaStep(adArgs, `ad:${adKey}`);
      adId = String(rec.id);
      state.ads[adKey] = {
        id: adId,
        adset_id: adsetId,
        creative_id: creativeId,
        name: ad.name,
        hash: adHash,
        created_at: new Date().toISOString(),
      };
      saveState(stateFile, state);
    uncertainRemote = false;
      results.push({ kind: "ad", key: adKey, action: "CREATED", id: adId, drift: false });
    } else {
      const drift = Boolean(state.ads[adKey]?.hash && state.ads[adKey].hash !== adHash);
      results.push({ kind: "ad", key: adKey, action: "SKIPPED", id: adId, drift });
    }
  }

  if (jsonOut) {
    console.log(JSON.stringify({ ok: true, mode: "APPLIED", stateFile, results }, null, 2));
    return;
  }

  console.log(`Deployment SUCCEEDED for ${validation.campaignPath}`);
  for (const r of results) {
    console.log(`  ✓ [${r.action}] ${r.kind}:${r.key} -> id=${r.id}${r.drift ? " (⚠ DRIFT: manifest modified since creation)" : ""}`);
  }
  console.log(`State saved to ${stateFile}`);
  } finally { if (!uncertainRemote) releaseLock(); }
}

function cmdStatus(argv) {
  let campaignPath = null;
  let brandPath = null;
  let jsonOut = false;

  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === "--brand") {
      brandPath = argv[++i];
      if (!brandPath) throw new Error("--brand requires a file path.");
    } else if (arg === "--json") {
      jsonOut = true;
    } else if (!arg.startsWith("-") && !campaignPath) {
      campaignPath = arg;
    } else {
      throw new Error(`Unknown or unexpected argument for status: ${arg}`);
    }
  }

  const resolvedBrand = findBrandPath(campaignPath, brandPath);
  const workspaceDir = path.dirname(resolvedBrand);
  const brand = readJsonFile(resolvedBrand, "brand.json");
  const stateFile = path.join(workspaceDir, ".meta-state.json");
  const state = loadState(stateFile);

  if (jsonOut) {
    console.log(
      JSON.stringify(
        {
          ok: true,
          brand: brand.brand || path.basename(workspaceDir),
          ad_account_id: brand.ad_account_id,
          stateFile,
          exists: fs.existsSync(stateFile),
          state,
        },
        null,
        2
      )
    );
    return;
  }

  console.log(`Workspace   : ${workspaceDir} (${brand.ad_account_id})`);
  console.log(`State File  : ${stateFile} (${fs.existsSync(stateFile) ? "present" : "not created yet"})`);
  const printGroup = (title, mapObj) => {
    const entries = Object.entries(mapObj || {});
    console.log(`  ${title} (${entries.length}):`);
    for (const [key, val] of entries) {
      console.log(`    - ${key}: id=${val.id} (${val.name || "unnamed"})`);
    }
  };
  printGroup("Campaigns", state.campaigns);
  printGroup("Creatives", state.creatives);
  printGroup("Ad Sets  ", state.adsets);
  printGroup("Ads      ", state.ads);
  const mediaEntries = Object.entries(state.media_cache || {});
  console.log(`  Media Cache (${mediaEntries.length}):`);
  for (const [sha, val] of mediaEntries) {
    const ref = val.image_hash ? `image_hash=${val.image_hash}` : val.video_id ? `video_id=${val.video_id}` : `creative_id=${val.creative_id}`;
    console.log(`    - sha256:${sha.slice(0, 12)} (${val.kind}) -> ${ref}`);
  }
}

function cmdDoctor(argv) {
  let brandPath = null;
  let tokenEnv = "META_ACCESS_TOKEN";
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === "--brand") {
      brandPath = argv[++i];
    } else if (arg === "--token-env") {
      tokenEnv = argv[++i];
    } else {
      throw new Error(`Unknown option for doctor: ${arg}`);
    }
  }

  if (brandPath || fs.existsSync(path.resolve("brand.json"))) {
    try {
      const resolved = findBrandPath(null, brandPath);
      const brand = readJsonFile(resolved, "brand.json");
      if (brand.token_env) tokenEnv = brand.token_env;
      console.log(`✓ brand.json: ${resolved} (ad_account_id=${brand.ad_account_id || "unset"})`);
    } catch (err) {
      console.error(`✗ brand.json: ${err.message}`);
      process.exit(1);
    }
  }

  const metaBin = resolveMetaBin();
  const verRes = spawnSync(metaBin, ["--version"], { encoding: "utf8" });
  if (verRes.status !== 0) {
    console.error(`✗ meta CLI binary not executable at '${metaBin}'. Run: dotads-meta setup (or pipx install meta-ads==${DEFAULT_META_ADS_VERSION})`);
    process.exit(1);
  }
  console.log(`✓ meta CLI: ${(verRes.stdout || verRes.stderr).trim()} (${metaBin})`);

  let token = null;
  try {
    token = readSecretToken(tokenEnv);
    console.log(`✓ secret '${tokenEnv}': available via secrets-env (redacted, length=${token.length})`);
  } catch (err) {
    console.error(`✗ secret '${tokenEnv}': ${err.message}`);
    process.exit(1);
  }

  const authRes = spawnSync(metaBin, ["auth", "status"], {
    env: { ...process.env, ACCESS_TOKEN: token },
    encoding: "utf8",
  });
  const authOut = ((authRes.stdout || "") + (authRes.stderr || "")).trim();
  if (authRes.status !== 0 || /Not authenticated/i.test(authOut)) {
    console.error(`✗ meta auth status failed: ${authOut}`);
    process.exit(1);
  }
  console.log(`✓ meta auth status: ${authOut.split(/\r?\n/)[0]}`);
}

function cmdRun(argv) {
  let brandPath = null;
  let tokenEnv = null;
  let passthrough = [];

  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg === "--") {
      passthrough = argv.slice(i + 1);
      break;
    } else if (arg === "--brand") {
      brandPath = argv[++i];
    } else if (arg === "--token-env") {
      tokenEnv = argv[++i];
    } else {
      passthrough = argv.slice(i);
      break;
    }
  }

  if (passthrough.length === 0) {
    throw new Error("run requires arguments to pass to `meta` (e.g. `dotads-meta run -- ads campaign list`).");
  }

  let brand = null;
  if (brandPath || fs.existsSync(path.resolve("brand.json"))) {
    const resolved = findBrandPath(null, brandPath);
    brand = readJsonFile(resolved, "brand.json");
  }

  const effectiveTokenEnv = tokenEnv || brand?.token_env || "META_ACCESS_TOKEN";
  const token = readSecretToken(effectiveTokenEnv);
  const env = {
    ...process.env,
    ACCESS_TOKEN: token,
  };
  if (brand?.ad_account_id) {
    env.AD_ACCOUNT_ID = String(brand.ad_account_id);
  }
  if (brand?.business_id) {
    env.BUSINESS_ID = String(brand.business_id);
  } else if (brand) {
    delete env.BUSINESS_ID;
  }

  const metaBin = resolveMetaBin();
  const res = spawnSync(metaBin, passthrough, {
    env,
    stdio: "inherit",
  });
  process.exit(res.status ?? 1);
}

const VALID_LEARN_SOURCES = new Set([
  "audit",
  "competitor",
  "data",
  "experiment",
  "outsource",
  "reference",
]);

const VALID_LEARN_CATEGORIES = new Set([
  "angle",
  "audience",
  "bidding",
  "format",
  "hook",
  "landing-page",
  "offer",
  "unit-economics",
]);

const VALID_LEARN_VERDICTS = new Set(["insight", "loser", "rule", "winner"]);

function analysisNumber(value) {
  if (typeof value !== "number" && (typeof value !== "string" || !/^[+]?(?:\d+\.?\d*|\.\d+)(?:e[+-]?\d+)?$/i.test(value.trim()))) return null;
  const number = Number(value);
  return Number.isFinite(number) && number >= 0 ? number : null;
}

function computeUnitEconomics(input) {
  const aov = analysisNumber(input.aov);
  const cogs = analysisNumber(input.cogs);
  const shippingFee = analysisNumber(input.shipping_fee);
  const codRtsRate = analysisNumber(input.cod_rts_rate);
  const rtsPenalty = analysisNumber(input.rts_penalty);
  const targetMargin = analysisNumber(input.target_margin);
  for (const [field, value] of Object.entries(input)) {
    if (value !== undefined && analysisNumber(value) === null) throw new Error(`unit-economics: '${field}' must be a finite nonnegative number.`);
  }

  if (aov === null || aov <= 0) throw new Error("unit-economics requires a positive --aov.");
  if (cogs === null || cogs >= aov) {
    throw new Error("unit-economics requires --cogs >= 0 and < --aov.");
  }
  if (codRtsRate !== null && codRtsRate >= 1) {
    throw new Error("unit-economics requires --cod-rts-rate between 0 and 0.99.");
  }
  if (targetMargin !== null && targetMargin >= 1) {
    throw new Error("unit-economics requires --target-margin between 0 and 0.99.");
  }

  const complete = shippingFee !== null && codRtsRate !== null && rtsPenalty !== null;
  const deliveredRate = codRtsRate === null ? null : 1 - codRtsRate;
  const contributionMargin = complete ? (aov - cogs - shippingFee) * deliveredRate - rtsPenalty * codRtsRate : null;
  if (contributionMargin !== null && contributionMargin <= 0) {
    throw new Error(
      `Negative or zero contribution margin (${contributionMargin.toFixed(2)}) after COGS/shipping/RTS; increase AOV (bundles) or lower RTS/COGS before running paid conversion ads.`
    );
  }
  const maxCprBreakeven = contributionMargin;
  const breakevenRoas = contributionMargin === null ? null : analysisNumber(aov / contributionMargin);
  const rawTargetCpr = contributionMargin !== null && targetMargin !== null ? contributionMargin - aov * deliveredRate * targetMargin : null;
  const targetCpr = rawTargetCpr !== null && rawTargetCpr > 0 ? rawTargetCpr : null;
  const targetRoas = targetCpr === null ? null : analysisNumber(aov / targetCpr);
  const roundedCostCap = targetCpr === null ? null : Math.round(targetCpr * 85) / 100;
  const recommendedCostCap = roundedCostCap !== null && roundedCostCap > 0 ? roundedCostCap : null;

  return {
    aov,
    cogs,
    shipping_fee: shippingFee,
    cod_rts_rate: codRtsRate,
    rts_penalty: rtsPenalty,
    target_margin: targetMargin,
    delivered_rate: deliveredRate === null ? null : Number(deliveredRate.toFixed(4)),
    cost_coverage: "COGS, shipping subsidy, and RTS penalty only; excludes other operating costs",
    economic_basis: "expected_per_placed_order",
    qualification: complete ? "CONFIGURED_COST_ASSUMPTIONS" : "INCOMPLETE_COST_ASSUMPTIONS",
    target_feasible: rawTargetCpr === null ? null : rawTargetCpr > 0,
    contribution_margin_per_order: maxCprBreakeven,
    max_cpr_breakeven: maxCprBreakeven,
    breakeven_roas: breakevenRoas,
    expected_delivered_breakeven_roas: contributionMargin === null ? null : analysisNumber(aov * deliveredRate / contributionMargin),
    target_cpr: targetCpr,
    target_roas: targetRoas,
    expected_delivered_target_roas: targetCpr === null ? null : analysisNumber(aov * deliveredRate / targetCpr),
    target_margin_revenue_basis: "expected_delivered_revenue",
    recommended_cost_cap: recommendedCostCap,
    updated_at: new Date().toISOString(),
  };
}

function defaultAdsMemory(brandName = "brand") {
  return {
    version: 1,
    brand: brandName,
    updated_at: new Date().toISOString(),
    unit_economics: null,
    entries: [],
  };
}

function loadAdsMemory(workspaceDir, brandName = "brand") {
  const memFile = path.join(workspaceDir, "memory", "ads-memory.json");
  if (!fs.existsSync(memFile)) {
    return defaultAdsMemory(brandName);
  }
  const data = readJsonFile(memFile, "ads-memory.json");
  if (!data || typeof data !== "object" || Array.isArray(data) || data.version !== 1 || !Array.isArray(data.entries)) {
    throw new Error(`Invalid ads-memory.json at ${memFile}: expected version 1 with 'entries' array.`);
  }
  return data;
}

function renderAdsMemoryMarkdown(memory) {
  const lines = [
    `# Meta Ads Intelligence & Conversion Memory — ${memory.brand || "Brand"}`,
    "",
    `Updated: ${memory.updated_at}`,
    "",
    "> Per-brand observations and user-recorded claims. Source labels and automatic diagnostics do not establish causality, independent validation, or permission to change spend.",
    "",
  ];

  const ue = memory.unit_economics;
  lines.push("## 1. Conversion Unit Economics & Bidding Floors");
  lines.push("");
  if (ue) {
    lines.push(`- **Economics Scope**: account \`${ue.scope?.ad_account_id ?? "unscoped legacy record"}\`, currency \`${ue.scope?.currency ?? "unknown"}\`; analysis requires matching current brand and insight scope.`);
    lines.push(`- **Gross AOV**: \`${ue.aov ?? "unknown"}\` | **COGS**: \`${ue.cogs ?? "unknown"}\` | **Shipping Subsidy**: \`${ue.shipping_fee ?? "unknown"}\``);
    lines.push(`- **COD RTS Rate**: \`${ue.cod_rts_rate == null ? "unknown" : (ue.cod_rts_rate * 100).toFixed(1) + "%"}\` (Delivered Rate: \`${ue.delivered_rate == null ? "unknown" : (ue.delivered_rate * 100).toFixed(1) + "%"}\`, RTS Penalty: \`${ue.rts_penalty ?? "unknown"}\`)`);
    lines.push(`- **Expected Placed-Order Contribution / Max Break-Even CPR**: \`${ue.max_cpr_breakeven ?? "unknown"}\` (**Gross Placed-Order Break-Even ROAS**: \`${ue.breakeven_roas ?? "unknown"}\`)`);
    lines.push(`- **Target CPR**: \`${ue.target_cpr ?? "unknown"}\` (**Gross Placed-Order Target ROAS**: \`${ue.target_roas ?? "unknown"}\`, Target Margin Assumption: \`${ue.target_margin == null ? "unknown" : (ue.target_margin * 100).toFixed(1) + "%"}\`)`);
    lines.push(`- **Local Cost Cap Suggestion (0.85x Target CPR)**: \`${ue.recommended_cost_cap ?? "unknown"}\`; neither a realized cost ceiling nor spend approval.`);
  } else {
    lines.push("_Not configured yet. Run `dotads-meta learn unit-economics --aov <AOV> --cogs <COGS>` to compute Break-Even ROAS, Max CPR, and a local Cost Cap suggestion._");
  }
  lines.push("");

  const groups = [
    ["winner", "## 2. User-Recorded Winner Claims (Verification Required)"],
    ["loser", "## 3. User-Recorded Loser Claims (Verification Required)"],
    ["rule", "## 4. User-Recorded Rules (Scope and Validation Required)"],
    ["insight", "## 5. Observations, References & Diagnostic Candidates"],
  ];

  for (const [verdict, heading] of groups) {
    lines.push(heading);
    lines.push("");
    const items = memory.entries.filter((e) => e.verdict === verdict);
    if (items.length === 0) {
      lines.push("_No entries recorded yet._");
      lines.push("");
      continue;
    }
    for (const item of items) {
      const m = item.metrics ? ` | metrics: \`${JSON.stringify(item.metrics)}\`` : "";
      lines.push(`- **[${item.category.toUpperCase()} | source:${item.source}] ${item.title}** (${item.created_at.slice(0, 10)}${m})`);
      lines.push(`  - Summary: ${item.summary}`);
      if (item.action) {
        lines.push(`  - Action: ${item.action}`);
      }
    }
    lines.push("");
  }

  return lines.join("\n");
}

function saveAdsMemory(workspaceDir, memory) {
  const memDir = path.join(workspaceDir, "memory");
  fs.mkdirSync(memDir, { recursive: true });
  memory.updated_at = new Date().toISOString();
  const memFile = path.join(memDir, "ads-memory.json");
  const mdFile = path.join(memDir, "MEMORY.md");
  const tmpJson = `${memFile}.${crypto.randomUUID()}.tmp`;
  const tmpMd = `${mdFile}.${crypto.randomUUID()}.tmp`;
  try {
    fs.writeFileSync(tmpJson, JSON.stringify(memory, null, 2) + "\n", { mode: 0o600, flag: "wx" });
    fs.renameSync(tmpJson, memFile);
    fs.writeFileSync(tmpMd, renderAdsMemoryMarkdown(memory), { mode: 0o600, flag: "wx" });
    fs.renameSync(tmpMd, mdFile);
  } finally {
    fs.rmSync(tmpJson, { force: true });
    fs.rmSync(tmpMd, { force: true });
  }
}

function cmdLearn(argv) {
  const sub = argv[0];
  if (!sub || sub === "-h" || sub === "--help") {
    console.log(`Usage:
  dotads-meta learn unit-economics --aov <num> --cogs <num> [--shipping-fee <num>] [--cod-rts-rate <0..1>] [--rts-penalty <num>] [--target-margin <0..1>] [--brand <brand.json>] [--json]
  dotads-meta learn add --source <data|reference|competitor|outsource|experiment|audit> --category <hook|angle|format|offer|audience|bidding|landing-page|unit-economics> --verdict <winner|loser|insight|rule> --title <text> --summary <text> [--action <text>] [--metrics <json>] [--brand <brand.json>] [--json]
  dotads-meta learn list [--source <s>] [--category <c>] [--verdict <v>] [--brand <brand.json>] [--json]`);
    return;
  }

  const rest = argv.slice(1);
  let brandPath = null;
  let jsonOut = false;

  if (sub === "unit-economics") {
    const opts = {};
    for (let i = 0; i < rest.length; i++) {
      const a = rest[i];
      if (a === "--brand") brandPath = rest[++i];
      else if (a === "--json") jsonOut = true;
      else if (a === "--aov") opts.aov = rest[++i];
      else if (a === "--cogs") opts.cogs = rest[++i];
      else if (a === "--shipping-fee") opts.shipping_fee = rest[++i];
      else if (a === "--cod-rts-rate") opts.cod_rts_rate = rest[++i];
      else if (a === "--rts-penalty") opts.rts_penalty = rest[++i];
      else if (a === "--target-margin") opts.target_margin = rest[++i];
      else throw new Error(`Unknown option for learn unit-economics: ${a}`);
    }
    const resolvedBrand = findBrandPath(null, brandPath);
    const workspaceDir = path.dirname(resolvedBrand);
    const brand = readJsonFile(resolvedBrand, "brand.json");
    if (!/^act_[0-9]+$/.test(brand.ad_account_id) || typeof brand.currency !== "string" || !/^[A-Z]{3}$/.test(brand.currency)) {
      throw new Error("unit-economics requires an explicit act_<digits> ad_account_id and three-letter uppercase currency in brand.json.");
    }
    const ue = computeUnitEconomics(opts);
    ue.scope = { ad_account_id: brand.ad_account_id, currency: brand.currency };
    const memory = loadAdsMemory(workspaceDir, brand.brand || path.basename(workspaceDir));
    memory.unit_economics = ue;
    saveAdsMemory(workspaceDir, memory);

    if (jsonOut) {
      console.log(JSON.stringify({ ok: true, unit_economics: ue, memoryPath: path.join(workspaceDir, "memory", "ads-memory.json") }, null, 2));
      return;
    }
    console.log(`✓ Saved conversion unit economics for ${memory.brand}`);
    console.log(`  Max Break-Even CPR : ${ue.max_cpr_breakeven} (${brand.currency || "USD"}) | Break-Even ROAS: ${ue.breakeven_roas}x`);
    console.log(`  Target Profit CPR  : ${ue.target_cpr} (${brand.currency || "USD"}) | Target ROAS    : ${ue.target_roas}x`);
    console.log(`  Local CostCap suggestion: ${ue.recommended_cost_cap} (${brand.currency || "USD"})`);
    return;
  }

  if (sub === "add") {
    let source = null;
    let category = null;
    let verdict = null;
    let title = null;
    let summary = null;
    let action = "";
    let metricsRaw = null;

    for (let i = 0; i < rest.length; i++) {
      const a = rest[i];
      if (a === "--brand") brandPath = rest[++i];
      else if (a === "--json") jsonOut = true;
      else if (a === "--source") source = rest[++i];
      else if (a === "--category") category = rest[++i];
      else if (a === "--verdict") verdict = rest[++i];
      else if (a === "--title") title = rest[++i];
      else if (a === "--summary") summary = rest[++i];
      else if (a === "--action") action = rest[++i];
      else if (a === "--metrics") metricsRaw = rest[++i];
      else throw new Error(`Unknown option for learn add: ${a}`);
    }

    if (!source || !VALID_LEARN_SOURCES.has(source)) {
      throw new Error(`--source must be one of ${Array.from(VALID_LEARN_SOURCES).join(", ")}.`);
    }
    if (!category || !VALID_LEARN_CATEGORIES.has(category)) {
      throw new Error(`--category must be one of ${Array.from(VALID_LEARN_CATEGORIES).join(", ")}.`);
    }
    if (!verdict || !VALID_LEARN_VERDICTS.has(verdict)) {
      throw new Error(`--verdict must be one of ${Array.from(VALID_LEARN_VERDICTS).join(", ")}.`);
    }
    if (!title || !String(title).trim()) throw new Error("learn add requires a non-empty --title.");
    if (!summary || !String(summary).trim()) throw new Error("learn add requires a non-empty --summary.");

    let metrics = null;
    if (metricsRaw) {
      try {
        metrics = JSON.parse(metricsRaw);
      } catch (err) {
        throw new Error(`Invalid JSON in --metrics: ${err.message}`);
      }
    }

    const resolvedBrand = findBrandPath(null, brandPath);
    const workspaceDir = path.dirname(resolvedBrand);
    const brand = readJsonFile(resolvedBrand, "brand.json");
    const memory = loadAdsMemory(workspaceDir, brand.brand || path.basename(workspaceDir));

    const entry = {
      id: `mem_${crypto.randomUUID().slice(0, 8)}`,
      created_at: new Date().toISOString(),
      source,
      category,
      verdict,
      title: String(title).trim(),
      summary: String(summary).trim(),
      action: action ? String(action).trim() : "",
      ...(metrics ? { metrics } : {}),
    };
    memory.entries.push(entry);
    saveAdsMemory(workspaceDir, memory);

    if (jsonOut) {
      console.log(JSON.stringify({ ok: true, entry, totalEntries: memory.entries.length }, null, 2));
      return;
    }
    console.log(`✓ Recorded [${verdict.toUpperCase()}] (${category} / ${source}): ${entry.title}`);
    return;
  }

  if (sub === "list") {
    let filterSource = null;
    let filterCategory = null;
    let filterVerdict = null;
    for (let i = 0; i < rest.length; i++) {
      const a = rest[i];
      if (a === "--brand") brandPath = rest[++i];
      else if (a === "--json") jsonOut = true;
      else if (a === "--source") filterSource = rest[++i];
      else if (a === "--category") filterCategory = rest[++i];
      else if (a === "--verdict") filterVerdict = rest[++i];
      else throw new Error(`Unknown option for learn list: ${a}`);
    }
    const resolvedBrand = findBrandPath(null, brandPath);
    const workspaceDir = path.dirname(resolvedBrand);
    const brand = readJsonFile(resolvedBrand, "brand.json");
    const memory = loadAdsMemory(workspaceDir, brand.brand || path.basename(workspaceDir));
    const entries = memory.entries.filter((e) => {
      if (filterSource && e.source !== filterSource) return false;
      if (filterCategory && e.category !== filterCategory) return false;
      if (filterVerdict && e.verdict !== filterVerdict) return false;
      return true;
    });
    const ue = memory.unit_economics;
    const economicsScopeStatus = !ue ? "UNCONFIGURED" : !ue.scope?.ad_account_id || !ue.scope?.currency ? "UNSCOPED"
      : ue.scope.ad_account_id === brand.ad_account_id && ue.scope.currency === brand.currency ? "MATCHES_CURRENT_BRAND" : "MISMATCH";

    if (jsonOut) {
      console.log(JSON.stringify({ ok: true, brand: memory.brand, unit_economics: ue, unit_economics_scope_status: economicsScopeStatus, entries }, null, 2));
      return;
    }
    console.log(`Meta Ads Memory for ${memory.brand} (${entries.length} entries)`);
    if (ue) {
      console.log(`  Economics scope: saved account=${ue.scope?.ad_account_id ?? "unknown"}, currency=${ue.scope?.currency ?? "unknown"}; selected account=${brand.ad_account_id ?? "unknown"}, currency=${brand.currency ?? "unknown"}; ${economicsScopeStatus}`);
      if (economicsScopeStatus !== "MATCHES_CURRENT_BRAND") console.log("  RECONFIGURE: historical/unscoped costs do not qualify for this brand. Explicitly relearn assumptions; changing a currency label does not convert costs.");
      console.log(`  Recorded thresholds (not approval): Break-Even ROAS=${ue.breakeven_roas ?? "unknown"} (Max CPR=${ue.max_cpr_breakeven ?? "unknown"}) | Target ROAS=${ue.target_roas ?? "unknown"} (Target CPR=${ue.target_cpr ?? "unknown"}); analyze recomputes qualified inputs.`);
    }
    for (const e of entries) {
      console.log(`  - [${e.verdict.toUpperCase()}] (${e.category}/${e.source}) ${e.title}: ${e.summary}`);
    }
    return;
  }

  throw new Error(`Unknown learn subcommand: ${sub}`);
}

function extractActionMetric(list, matchTypes, issues, label) {
  if (list === undefined) return null;
  if (!Array.isArray(list)) { issues.push(`invalid ${label}: expected an action array`); return null; }
  const matches = list.filter((item) => item && matchTypes.includes(item.action_type));
  if (!matches.length) return null;
  const values = matches.map((item) => analysisNumber(item.value));
  if (values.some((value) => value === null) || new Set(values).size > 1) {
    issues.push(`invalid ${label}: malformed or conflicting action values; select an unambiguous event`);
    return null;
  }
  return values[0]; // Equivalent aliases are not summed into additional conversions.
}

function analysisHash(value) {
  const canonical = (v) => Array.isArray(v) ? v.map(canonical) : v && typeof v === "object"
    ? Object.fromEntries(Object.keys(v).sort().map((key) => [key, canonical(v[key])])) : v;
  return crypto.createHash("sha256").update(JSON.stringify(canonical(value))).digest("hex");
}

function cmdAnalyze(argv) {
  let insightsPath = null;
  let brandPath = null;
  let pullLive = false;
  let datePreset = "last_7d";
  let deliveryRate = null;
  let purchaseBasis = null;
  let recordMemory = false;
  let jsonOut = false;

  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--brand") brandPath = argv[++i];
    else if (a === "--pull") pullLive = true;
    else if (a === "--date-preset") datePreset = argv[++i] || "last_7d";
    else if (a === "--delivery-rate") {
      deliveryRate = analysisNumber(argv[++i]);
      if (deliveryRate === null) throw new Error("--delivery-rate requires a finite number between 0 and 1.");
    }
    else if (a === "--purchase-basis") {
      purchaseBasis = argv[++i];
      if (!["placed", "delivered"].includes(purchaseBasis)) throw new Error("--purchase-basis must be placed or delivered.");
    }
    else if (a === "--record-memory") recordMemory = true;
    else if (a === "--json") jsonOut = true;
    else if (!a.startsWith("-") && !insightsPath) insightsPath = a;
    else throw new Error(`Unknown or unexpected option for analyze: ${a}`);
  }
  if (!insightsPath && !pullLive) {
    throw new Error("analyze requires <insights.json> or --pull.");
  }
  if (deliveryRate !== null && (!Number.isFinite(deliveryRate) || deliveryRate < 0 || deliveryRate > 1)) {
    throw new Error("--delivery-rate must be between 0 and 1 (inclusive).");
  }

  const resolvedBrand = findBrandPath(insightsPath, brandPath);
  const workspaceDir = path.dirname(resolvedBrand);
  const brand = readJsonFile(resolvedBrand, "brand.json");
  const memory = loadAdsMemory(workspaceDir, brand.brand || path.basename(workspaceDir));

  let rawInsights;
  if (pullLive) {
    const metaBin = resolveMetaBin();
    const token = readSecretToken(brand.token_env || "META_ACCESS_TOKEN");
    const childEnv = {
      ...process.env,
      ACCESS_TOKEN: token,
      AD_ACCOUNT_ID: brand.ad_account_id,
    };
    if (brand.business_id) childEnv.BUSINESS_ID = String(brand.business_id);
    else delete childEnv.BUSINESS_ID;

    const pullArgs = [
      "--output",
      "json",
      "--no-input",
      "ads",
      "--ad-account-id",
      brand.ad_account_id,
    ];
    if (brand.business_id) pullArgs.push("--business-id", String(brand.business_id));
    pullArgs.push(
      "insights",
      "--date-preset",
      datePreset,
      "--level",
      "ad",
      "--fields",
      "account_id,account_currency,date_start,date_stop,ad_id,ad_name,adset_id,campaign_id,spend,impressions,frequency,clicks,outbound_clicks,cpc,ctr,actions,action_values,video_3_sec_watched_actions,video_thruplay_watched_actions"
    );

    const res = spawnSync(metaBin, pullArgs, {
      env: childEnv,
      encoding: "utf8",
      stdio: ["ignore", "pipe", "pipe"],
    });
    if (res.status !== 0) {
      throw new Error(`Failed to pull insights via meta CLI: ${(res.stderr || res.stdout || "").trim()}`);
    }
    try {
      rawInsights = JSON.parse((res.stdout || "").trim() || "[]");
    } catch (err) {
      throw new Error(`Invalid JSON returned by meta insights: ${err.message}`);
    }
    if (insightsPath) {
      fs.writeFileSync(path.resolve(insightsPath), JSON.stringify(rawInsights, null, 2) + "\n", { mode: 0o600 });
    }
  } else {
    rawInsights = readJsonFile(path.resolve(insightsPath), "insights JSON");
  }

  const rows = Array.isArray(rawInsights)
    ? rawInsights
    : Array.isArray(rawInsights?.data)
      ? rawInsights.data
      : [];

  if (rows.length === 0) {
    throw new Error(`No insight rows found${insightsPath ? ` in ${insightsPath}` : ""}.`);
  }

  // Recompute from explicitly configured inputs; cached or legacy derived fields are not approval.
  let ue = null;
  const savedEconomics = memory.unit_economics;
  const economicsIssues = [];
  if (savedEconomics && (!savedEconomics.scope?.ad_account_id || !savedEconomics.scope?.currency)) {
    economicsIssues.push("Persisted economics scope is missing; explicitly relearn account/currency-scoped assumptions before financial comparison.");
  } else if (savedEconomics?.scope) {
    if (savedEconomics.scope.ad_account_id !== brand.ad_account_id) economicsIssues.push("Persisted economics account scope differs from the selected brand; explicitly relearn assumptions for this account.");
    if (savedEconomics.scope.currency !== brand.currency) economicsIssues.push("Persisted economics currency scope differs from the selected brand; currency changes do not convert historical costs.");
  }
  if (!economicsIssues.length && ["CONFIGURED_COST_ASSUMPTIONS", "INCOMPLETE_COST_ASSUMPTIONS"].includes(savedEconomics?.qualification)) {
    try {
      const fields = ["aov", "cogs", "shipping_fee", "cod_rts_rate", "rts_penalty", "target_margin"];
      ue = computeUnitEconomics(Object.fromEntries(fields.filter((field) => savedEconomics[field] != null).map((field) => [field, savedEconomics[field]])));
    } catch { /* Invalid persisted assumptions remain unknown; never reuse cached thresholds. */ }
  }
  const benchmarks = {
    breakeven_roas: analysisNumber(ue?.breakeven_roas), target_roas: analysisNumber(ue?.target_roas),
    max_cpr: analysisNumber(ue?.max_cpr_breakeven), target_cpr: analysisNumber(ue?.target_cpr),
    expected_delivered_breakeven_roas: analysisNumber(ue?.expected_delivered_breakeven_roas),
    expected_delivered_target_roas: analysisNumber(ue?.expected_delivered_target_roas),
    basis: "configured_expected_per_placed_order; row comparisons use comparison_benchmarks",
  };
  const snapshotId = analysisHash(rawInsights);
  const purchaseTypes = ["purchase", "omni_purchase", "offsite_conversion.fb_pixel_purchase"];
  const round = (n, digits = 2) => n === null || !Number.isFinite(n) ? null : Number(n.toFixed(digits));
  const ratio = (n, d, digits = 2) => n === null || d === null || d <= 0 ? null : round(n / d, digits);
  const evaluated = rows.map((input, idx) => {
    const issues = [];
    const row = input && typeof input === "object" && !Array.isArray(input) ? input : {};
    if (row !== input) issues.push("invalid row: expected an object");
    const has = (key) => Object.prototype.hasOwnProperty.call(row, key);
    const metric = (key, max = Infinity) => {
      if (!has(key)) return null;
      const value = analysisNumber(row[key]);
      if (value === null || value > max) { issues.push(`invalid ${key}: expected a finite nonnegative number${max === 1 ? " at most 1" : ""}`); return null; }
      return value;
    };
    const name = row.ad_name || row.adset_name || row.campaign_name || row.name || `row_${idx + 1}`;
    const id = row.ad_id || row.adset_id || row.campaign_id || row.id || String(idx + 1);
    const spend = metric("spend"), impressions = metric("impressions"), frequency = metric("frequency");
    const metaPurchases = has("purchases") ? metric("purchases") : extractActionMetric(row.actions, purchaseTypes, issues, "purchases");
    const metaRevenue = has("revenue") ? metric("revenue") : has("purchase_value") ? metric("purchase_value") : extractActionMetric(row.action_values, purchaseTypes, issues, "revenue");
    const real = has("real_purchases") || has("real_revenue");
    const backend = has("backend_purchases") || has("backend_revenue");
    let source = real && backend ? "mixed_backend" : real ? "backend_real" : backend ? "backend" : "meta";
    let rawPurchases = real ? metric("real_purchases") : backend ? metric("backend_purchases") : metaPurchases;
    let rawRevenue = real ? metric("real_revenue") : backend ? metric("backend_revenue") : metaRevenue;
    const contextIssues = [...economicsIssues];
    let compatible = true;
    if (real && backend) { contextIssues.push("Mixed real_* and backend_* sources are unqualified."); compatible = false; }
    if ((real || backend) && (rawPurchases === null || rawRevenue === null)) {
      contextIssues.push("A backend purchase/revenue pair is incomplete; missing values are not filled from Meta."); compatible = false;
    }
    let basis = has("purchase_basis") ? row.purchase_basis : purchaseBasis;
    if ((has("purchase_basis") || basis != null) && !["placed", "delivered"].includes(basis)) { contextIssues.push("Invalid purchase_basis."); compatible = false; basis = null; }
    if (purchaseBasis && has("purchase_basis") && row.purchase_basis !== purchaseBasis) { contextIssues.push("Row and CLI purchase bases conflict."); compatible = false; }
    // A rate supplied for raw Meta orders declares placed input; backend counts need their own explicit basis.
    if (!basis && deliveryRate !== null && !real && !backend) basis = "placed";
    if (!basis) contextIssues.push("Purchase basis is unknown; financial comparison is unavailable.");
    if (deliveryRate !== null && basis !== "placed") { contextIssues.push("--delivery-rate requires placed input; do not apply it to delivered or unknown backend orders."); compatible = false; }
    if (typeof row.account_id !== "string" || !/^(act_)?[0-9]+$/.test(row.account_id)) { contextIssues.push("Insight account scope is missing or invalid; financial comparison requires an explicit account_id."); compatible = false; }
    else if (row.account_id.replace(/^act_/, "") !== String(brand.ad_account_id).replace(/^act_/, "")) { contextIssues.push("Insight account differs from the selected brand."); compatible = false; }
    const currency = brand.currency;
    if (typeof currency !== "string" || !/^[A-Z]{3}$/.test(currency)) { contextIssues.push("Brand currency is unknown or invalid."); compatible = false; }
    for (const field of ["currency", "account_currency"]) {
      if (has(field) && row[field] !== currency) { contextIssues.push(`Insight ${field} differs from the selected brand.`); compatible = false; }
    }
    if (!has("currency") && !has("account_currency")) { contextIssues.push("Insight currency scope is missing; financial comparison requires account_currency or currency."); compatible = false; }
    if (!row.date_start || !row.date_stop) contextIssues.push("Reporting window is unknown; freshness and cohort comparability are unverified.");
    if (rawInsights?.paging?.next) { contextIssues.push("Input pagination is incomplete."); compatible = false; }
    for (const [field, value] of [["spend", spend], ["purchases", rawPurchases], ["revenue", rawRevenue]]) {
      if (value === null) issues.push(`unavailable ${field}`);
    }
    if (rawPurchases === 0 && rawRevenue !== null && rawRevenue > 0) { contextIssues.push("Positive revenue with zero purchases needs reconciliation."); compatible = false; }
    const applyRate = deliveryRate !== null && basis === "placed" && compatible;
    const purchases = applyRate && rawPurchases !== null ? round(rawPurchases * deliveryRate) : rawPurchases;
    const revenue = applyRate && rawRevenue !== null ? round(rawRevenue * deliveryRate) : rawRevenue;
    const outboundClicks = has("outbound_clicks") && Array.isArray(row.outbound_clicks)
      ? extractActionMetric(row.outbound_clicks, ["outbound_click"], issues, "outbound_clicks") : metric("outbound_clicks");
    const video3s = has("video_3s_views") ? metric("video_3s_views") : extractActionMetric(row.video_3_sec_watched_actions, ["video_view"], issues, "video_3s_views");
    const thruplays = has("thruplays") ? metric("thruplays") : extractActionMetric(row.video_thruplay_watched_actions, ["video_view"], issues, "thruplays");
    const roas = ratio(revenue, spend), cpr = ratio(spend, purchases);
    const cpm = impressions !== null && impressions > 0 && spend !== null ? round(spend / impressions * 1000) : null;
    const ctr = ratio(outboundClicks, impressions, 4), cpc = ratio(spend, outboundClicks);
    const hookRate = has("hook_rate") ? metric("hook_rate", 1) : ratio(video3s, impressions, 4);
    const holdRate = has("hold_rate") ? metric("hold_rate", 1) : ratio(thruplays, video3s, 4);
    const cvr = ratio(purchases, outboundClicks, 4);
    const costs = [ue?.cogs, ue?.shipping_fee, ue?.rts_penalty, ue?.cod_rts_rate].map(analysisNumber);
    const costsKnown = ue?.qualification === "CONFIGURED_COST_ASSUMPTIONS" && costs.every((value) => value !== null) && costs[3] < 1;
    const d = deliveryRate ?? (costsKnown ? 1 - costs[3] : null);
    const comparisonQualified = compatible && basis === "placed" && costsKnown && spend !== null && rawPurchases !== null && rawRevenue !== null;
    if (!costsKnown) contextIssues.push("Required cost assumptions are unknown; contribution and financial comparison are unavailable.");
    if (basis === "delivered") contextIssues.push("Delivered inputs do not establish placed/failed order counts or total RTS costs; full contribution is unavailable.");
    const comparisonCpr = comparisonQualified && rawPurchases > 0 ? analysisNumber(spend / rawPurchases) : null;
    const comparisonRoas = comparisonQualified && spend > 0 ? analysisNumber(rawRevenue / spend) : null;
    const aov = rawPurchases > 0 && rawRevenue !== null ? rawRevenue / rawPurchases : analysisNumber(ue?.aov);
    const contributionPerPlaced = comparisonQualified && aov !== null ? (aov - costs[0] - costs[1]) * d - costs[2] * (1 - d) : null;
    const maxCpr = contributionPerPlaced !== null && contributionPerPlaced > 0 ? contributionPerPlaced : null;
    const margin = analysisNumber(ue?.target_margin);
    const targetCpr = maxCpr !== null && margin !== null && margin < 1 && maxCpr - aov * d * margin > 0 ? maxCpr - aov * d * margin : null;
    const rowBenchmarks = { basis: "placed", max_cpr: maxCpr, target_cpr: targetCpr, breakeven_roas: ratio(aov, maxCpr), target_roas: ratio(aov, targetCpr),
      expected_delivered_breakeven_roas: ratio(aov === null || d === null ? null : aov * d, maxCpr),
      expected_delivered_target_roas: ratio(aov === null || d === null ? null : aov * d, targetCpr), target_margin_revenue_basis: "expected_delivered_revenue" };
    const rawContribution = comparisonQualified ? rawRevenue * d - rawPurchases * ((costs[0] + costs[1]) * d + costs[2] * (1 - d)) - spend : null;
    const contribution = round(rawContribution);
    const meetsTarget = comparisonCpr !== null && targetCpr !== null && rawPurchases > 0 && spend > 0 && comparisonCpr <= targetCpr;
    const meetsBreakeven = comparisonCpr !== null && maxCpr !== null && rawPurchases > 0 && spend > 0 && comparisonCpr <= maxCpr;
    const early = comparisonQualified && rawPurchases === 0 && maxCpr !== null && spend > 0 && spend < maxCpr;
    const stopLoss = comparisonQualified && !meetsBreakeven && !early && ((maxCpr !== null && spend >= 1.5 * maxCpr && rawPurchases === 0) || (rawContribution !== null && rawContribution < -spend / 2));
    let classification = "INSUFFICIENT_DATA";
    let diagnosis = "Insufficient qualified financial data. Available metrics remain observations; missing values are not zero.";
    let nextAction = "Resolve unavailable fields, order/cost bases, conversion lag and evidence sufficiency before a performance conclusion.";
    if (comparisonQualified) {
      classification = "MONITOR_EARLY";
      diagnosis = "Local observation only; platform learning, incrementality, sample sufficiency and future performance are unverified.";
      if (meetsTarget) { classification = "ABOVE_TARGET_CANDIDATE"; diagnosis = "Observed placed-order economics meet the configured target assumptions; this is not a proven winner or permission to scale."; }
      else if (meetsBreakeven) { classification = "ABOVE_BREAKEVEN_CANDIDATE"; diagnosis = "Observed placed-order economics exceed break-even under the declared cost coverage; other operating costs and persistence remain unverified."; }
      else if (!early && spend > 0) {
        if (frequency !== null && frequency >= 2.5) classification = "CREATIVE_FATIGUE_CANDIDATE";
        else if (hookRate !== null && hookRate < .25) classification = "FIX_HOOK_FIRST_3S_CANDIDATE";
        else if (holdRate !== null && holdRate < .20) classification = "FIX_HOLD_BODY_PACING_CANDIDATE";
        else if (ctr !== null && ctr < .01) classification = "FIX_OFFER_OR_CTA_CANDIDATE";
        else if (ctr !== null) classification = "FIX_LANDING_CVR_OR_SIGNAL_CANDIDATE";
        diagnosis = "Below local economic assumptions. The diagnostic candidate is a hypothesis; compare alternative causes, conversion lag and matched periods.";
      }
      nextAction = "Review the observation, cost coverage, conversion lag and evidence sufficiency; design a measured test if warranted. No automatic spend change or winner/loser promotion.";
    }
    return {
      id, name, spend, impressions, frequency, purchases, revenue, meta_purchases: metaPurchases, meta_revenue: metaRevenue,
      meta_roas: ratio(metaRevenue, spend), reconciled: false, reconciliation_status: applyRate ? "DELIVERY_RATE_ESTIMATE" : real || backend ? "BACKEND_SUPPLIED_UNVERIFIED" : "NONE",
      roas, cpr, cpm, ctr, cpc, hook_rate: hookRate, hold_rate: holdRate, cvr,
      revenue_after_ad_spend: revenue !== null && spend !== null ? round(revenue - spend) : null,
      estimated_contribution_after_ads: contribution, estimated_net_profit: null,
      economic_basis: comparisonQualified ? "expected_per_placed_order" : "unavailable",
      cost_coverage: "COGS, shipping subsidy, RTS penalty and ad spend only; excludes other operating costs",
      purchase_basis: basis || "unknown", output_purchase_basis: applyRate ? "estimated_delivered" : basis || "unknown",
      effective_delivery_rate: d, metric_source: source, comparison_qualified: comparisonQualified,
      comparison_cpr: comparisonCpr, comparison_roas: comparisonRoas, comparison_benchmarks: rowBenchmarks,
      data_quality: { status: issues.some((issue) => issue.startsWith("invalid")) ? "INVALID" : issues.length ? "INSUFFICIENT" : "VALID", issues },
      context_issues: contextIssues, provenance_status: "UNVERIFIED", evidence_status: "OBSERVATIONAL_CANDIDATE", stop_loss: stopLoss,
      classification, diagnosis, next_action: nextAction, recommended_command: null,
      observation_id: analysisHash({ account: brand.ad_account_id,
        row: Object.fromEntries(Object.entries(row).filter(([key]) => !["purchase_basis", "ad_name", "adset_name", "campaign_name", "name"].includes(key))),
        purchase_basis: basis || "unknown", deliveryRate }),
      scope: { ad_account_id: brand.ad_account_id, entity_id: id, date_start: row.date_start ?? null, date_stop: row.date_stop ?? null, metric_source: source, purchase_basis: basis || "unknown", snapshot_id: snapshotId },
    };
  });

  let recordedCount = 0, updatedCount = 0;
  if (recordMemory) {
    for (const item of evaluated) {
      if ([item.spend, item.impressions, item.purchases, item.revenue].every((value) => value === null)) continue;
      const entry = {
        id: `obs_${item.observation_id.slice(0, 16)}`, observation_id: item.observation_id,
        analysis_version: 2, source: "data", category: "angle", verdict: "insight",
        title: `Observed Ad: ${item.name} [${item.classification}]`, summary: item.diagnosis, action: item.next_action,
        scope: item.scope, metrics: { spend: item.spend, purchases: item.purchases, revenue: item.revenue, roas: item.roas, cpr: item.cpr, ctr: item.ctr, cpc: item.cpc, estimated_contribution_after_ads: item.estimated_contribution_after_ads },
        classification: item.classification, data_quality: item.data_quality, context_issues: item.context_issues,
        comparison_benchmarks: item.comparison_benchmarks, replication_status: "NOT_ESTABLISHED",
      };
      const existing = memory.entries.find((e) => e.observation_id === item.observation_id);
      if (existing) {
        const comparable = { ...existing }; delete comparable.created_at; delete comparable.updated_at;
        if (analysisHash(comparable) !== analysisHash(entry)) { Object.assign(existing, entry, { updated_at: new Date().toISOString() }); updatedCount++; }
      } else { memory.entries.push({ ...entry, created_at: new Date().toISOString() }); recordedCount++; }
    }
    if (recordedCount || updatedCount) saveAdsMemory(workspaceDir, memory);
  }
  if (jsonOut) {
    console.log(JSON.stringify({ ok: true, analysis_version: 2, brand: memory.brand, benchmarks,
      diagnosticBasis: "local observational heuristics; causality, evidence sufficiency and platform learning state unverified",
      recommendationsRequireApproval: true,
      deprecated_fields: { estimated_net_profit: "Always null; use estimated_contribution_after_ads with its explicit basis and cost coverage.", reconciled: "Always false; supplied backend values or a delivery estimate do not prove reconciliation." },
      recordedToMemory: recordedCount, updatedInMemory: updatedCount, results: evaluated }, null, 2));
    return;
  }
  console.log(`=== META ADS OBSERVATIONS (${memory.brand}) ===`);
  console.log("Local hypotheses only; no mutation commands or automatic winner/loser promotion. Unknown costs and unsupported order bases remain unavailable.");
  for (const r of evaluated) {
    console.log(`  [${r.classification}] ${r.name}: ROAS=${r.roas ?? "n/a"}, CPR=${r.cpr ?? "n/a"}, contribution after ads=${r.estimated_contribution_after_ads ?? "unknown"}`);
    console.log(`    ${r.diagnosis}`);
    for (const issue of [...r.data_quality.issues, ...r.context_issues]) console.log(`    Review: ${issue}`);
  }
  if (recordMemory) console.log(`Recorded ${recordedCount} new observation(s); updated ${updatedCount}. Reanalysis is not replication.`);
}

function cmdBaseline(argv) {
  const options = {};
  for (let i = 0; i < argv.length; i++) {
    const flag = argv[i];
    if (flag === "--help" || flag === "-h") {
      console.log("Usage: dotads-meta baseline --market ID [--province <name|BPS code>] [--city <name>] [--json]");
      return;
    }
    if (!["--market", "--province", "--city", "--json"].includes(flag) || flag in options) {
      throw new Error(`Unknown or repeated baseline option: ${flag}`);
    }
    if (flag === "--json") options[flag] = true;
    else {
      const value = argv[++i]?.trim();
      if (!value || value.startsWith("--")) throw new Error(`${flag} requires a value.`);
      options[flag] = value;
    }
  }
  if (options["--market"]?.toUpperCase() !== "ID") {
    throw new Error("Public baseline requires explicit --market ID. No Indonesia data is applied to other or unspecified markets.");
  }
  // Resolve the installed command's symlink; do not depend on the caller's cwd or brand workspace.
  const repoRoot = path.dirname(path.dirname(fs.realpathSync(process.argv[1])));
  const data = readJsonFile(path.join(repoRoot, "skills/local/meta-ads-cli/references/indonesia-baseline.json"), "Indonesia baseline");
  const provinces = data?.province_participation?.rows;
  const cities = data?.city_participation?.rows;
  const transactions = data?.regional_transactions;
  const pct = (value) => typeof value === "number" && Number.isFinite(value) && value >= 0 && value <= 100;
  const normalize = (value) => value.normalize("NFKC").trim().replace(/\s+/g, " ").toLocaleLowerCase("id-ID");
  const sourceExists = (key) => typeof key === "string" && typeof data.sources?.[key]?.url === "string";
  if (data?.schema_version !== 1 || data.market !== "ID" || data.documentation_language !== "en" || data.market_language !== "id-ID"
      || !Array.isArray(provinces) || provinces.length !== 38 || !Array.isArray(cities) || !Array.isArray(transactions)
      || !Array.isArray(data.limitations) || !/^\d{4}-\d{2}-\d{2}$/.test(data.reviewed_at)
      || !sourceExists(data.province_participation.source_id) || !sourceExists(data.city_participation.source_id)
      || ![data.province_participation.national_pct, data.province_participation.urban_pct, data.province_participation.rural_pct, data.city_participation.national_pct].every(pct)) {
    throw new Error("Invalid Indonesia baseline schema, source metadata, or national comparators.");
  }
  const codes = new Set(), names = new Set();
  for (const row of provinces) {
    if (!row || typeof row.bps_code !== "string" || !/^\d{2}$/.test(row.bps_code) || typeof row.name !== "string" || !row.name.trim()
        || codes.has(row.bps_code) || names.has(normalize(row.name)) || !pct(row.purchasing_pct)) {
      throw new Error("Invalid or duplicate Indonesia province record.");
    }
    codes.add(row.bps_code); names.add(normalize(row.name));
  }
  const cityNames = new Set();
  for (const row of cities) {
    if (!row || typeof row.name !== "string" || !row.name.trim() || cityNames.has(normalize(row.name))
        || !codes.has(row.province_bps_code) || !pct(row.purchasing_pct)) throw new Error("Invalid Indonesia city record or parent.");
    cityNames.add(normalize(row.name));
  }
  for (const row of transactions) {
    if (!row || !sourceExists(row.source_id) || !codes.has(row.province_bps_code) || !/^\d{4}-Q[1-4]$/.test(row.period)
        || typeof row.value_idr !== "number" || !Number.isFinite(row.value_idr) || row.value_idr < 0
        || typeof row.transactions !== "number" || !Number.isFinite(row.transactions) || row.transactions <= 0) {
      throw new Error("Invalid Indonesia regional transaction record.");
    }
  }
  let province = null;
  if (options["--province"]) {
    const query = normalize(options["--province"]);
    province = provinces.find((row) => row.bps_code === query || normalize(row.name) === query);
    if (!province) throw new Error("Unknown province; use a BPS code or the dataset's province name.");
  }
  const cityQuery = options["--city"];
  const city = cityQuery ? cities.find((row) => normalize(row.name) === normalize(cityQuery)) : null;
  if (city && province && city.province_bps_code !== province.bps_code) throw new Error("City does not match the selected province.");
  if (city && !province) province = provinces.find((row) => row.bps_code === city.province_bps_code);
  if (cityQuery && !city && !province) throw new Error("No direct city observation; supply an explicit valid --province for inherited context.");
  const selectedTransactions = transactions.filter((row) => !province || row.province_bps_code === province.bps_code);
  const sourceIds = new Set([data.province_participation.source_id, data.city_participation.source_id, ...selectedTransactions.map((row) => row.source_id)]);
  const result = {
    ...data,
    sources: Object.fromEntries([...sourceIds].map((key) => [key, data.sources[key]])),
    selection: {
      province: province ? { bps_code: province.bps_code, name: province.name } : null,
      requested_city: cityQuery || null,
      city_evidence: !cityQuery ? "not_selected" : city ? "direct_observation" : "province_context_only",
      city_purchasing_pct: city?.purchasing_pct ?? null,
      note: cityQuery && !city ? "No direct city metric. Province context is inherited; the requested city label and administrative parent are not verified." : "BPS codes are not Meta location keys. City coverage is selected and incomplete.",
    },
    province_participation: { ...data.province_participation, rows: province ? [province] : provinces },
    city_participation: { ...data.city_participation, rows: cityQuery ? (city ? [city] : []) : cities.filter((row) => !province || row.province_bps_code === province.bps_code) },
    regional_transactions: selectedTransactions,
  };
  if (options["--json"]) { console.log(JSON.stringify(result, null, 2)); return; }
  console.log(`Indonesia public baseline | reviewed ${data.reviewed_at} | documentation en | customer market id-ID`);
  console.log(`Province participation (${data.province_participation.reference_period}): ${data.province_participation.population}`);
  console.log(`National ${data.province_participation.national_pct}% | urban ${data.province_participation.urban_pct}% | rural ${data.province_participation.rural_pct}%`);
  for (const row of result.province_participation.rows) console.log(`  ${row.bps_code} ${row.name}: ${row.purchasing_pct.toFixed(2)}%`);
  console.log(`Selected city participation (${data.city_participation.reference_period}): ${data.city_participation.population}`);
  console.log(`National ${data.city_participation.national_pct}% | incomplete city coverage; different denominator from provinces`);
  for (const row of result.city_participation.rows) console.log(`  ${row.name}: ${row.purchasing_pct.toFixed(2)}%`);
  if (cityQuery && !city) console.log(`  ${cityQuery}: unavailable city metric; inherited ${province.name} context only. Administrative parent unverified.`);
  for (const row of selectedTransactions) console.log(`Regional transactions (${row.period}, BPS province ${row.province_bps_code}): IDR ${row.value_idr}, ${row.transactions} transactions; rounded aggregates, not unique buyers or brand AOV.`);
  for (const [key, source] of Object.entries(result.sources)) console.log(`Source ${key}: published ${source.published_at}, measured ${source.measurement_period} | ${source.url}`);
  console.log("Shared Susenas lineage is not independent replication. No campaign CPA, age optimum, buyer-pool size, or budget ranking follows from this baseline.");
}

function main() {
  const argv = process.argv.slice(2);
  if (argv.length === 0 || argv[0] === "-h" || argv[0] === "--help" || argv[0] === "help") {
    usage(0);
  }

  const sub = argv[0];
  const rest = argv.slice(1);

  try {
    switch (sub) {
      case "baseline":
        cmdBaseline(rest);
        break;
      case "setup":
        cmdSetup(rest);
        break;
      case "init":
        cmdInit(rest);
        break;
      case "validate":
        cmdValidate(rest);
        break;
      case "deploy":
        cmdDeploy(rest);
        break;
      case "status":
        cmdStatus(rest);
        break;
      case "doctor":
        cmdDoctor(rest);
        break;
      case "run":
        cmdRun(rest);
        break;
      case "learn":
        cmdLearn(rest);
        break;
      case "analyze":
        cmdAnalyze(rest);
        break;
      default:
        console.error(`Unknown subcommand: ${sub}`);
        usage(1);
    }
  } catch (err) {
    console.error(`dotads-meta error: ${err.message}`);
    process.exit(1);
  }
}

main();
