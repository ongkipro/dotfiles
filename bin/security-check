#!/usr/bin/env bash
# Scan dotfiles for obvious secrets before commit/push.
# Conservative guard: catches common tokens/keys, with allowlist for docs/config examples.
set -euo pipefail

REPO="${1:-$HOME/dotfiles}"
cd "$REPO"

if ! command -v git >/dev/null 2>&1; then
  echo "ERROR: git not found." >&2
  exit 1
fi

# Fail loudly when there is nothing to scan. The two `git grep … || true` calls
# below absorb git's exit 1 ("no match"), but they absorb fatal errors just as
# happily — a non-repository, a corrupt index, a bad pathspec. Without this
# guard the scan never runs and the script still prints "no obvious secrets
# found" and exits 0, which is the worst possible failure mode for a secret
# gate: green because it looked nowhere.
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "ERROR: $REPO is not a git work tree; refusing to report a clean scan." >&2
  exit 1
fi

# Keep this intentionally broad. False positives are cheaper than leaked secrets,
# but match credential-name families rather than every variable containing words
# such as TOKEN or SECRET. Prefixes are naturally allowed because git grep is not
# anchored: AWS_SECRET_ACCESS_KEY matches the SECRET_ACCESS_KEY suffix.
ASSIGNMENT_NAME='(API[_-]?(KEY|TOKEN)|ACCESS[_-]?(KEY|TOKEN)|AUTH[_-]?TOKEN|SECRET([_-]?(ACCESS[_-]?KEY|KEY|TOKEN))?|GITHUB[_-]?TOKEN|NPM[_-]?(AUTH[_-]?)?TOKEN|PASSWORD|PRIVATE[_-]?KEY)'
# The short sk prefix must start a token, not the suffix of a task identifier.
PRECISE_PATTERN='(BEGIN (RSA|OPENSSH|DSA|EC|PGP) PRIVATE KEY|ghp_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]+|glpat-[A-Za-z0-9_-]{20,}|(^|[^[:alnum:]_])sk-[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35})'
ASSIGNMENT_PATTERN="${ASSIGNMENT_NAME}[[:space:]]*=[[:space:]]*[^.\`[:space:]]"

# Placeholders — an assignment whose VALUE is obviously not a real secret.
# Precise token/private-key matches use a separate stream and NEVER pass through
# this allowlist. Otherwise an attacker could append `API_KEY=placeholder` (or a
# public Turnstile test key) to a real token line and suppress the precise hit.
#
# A noisy guard is a dangerous guard — people learn to bypass it. Keep it quiet AND strict.
# CAREFUL: an empty-value alternative must be spelled "" / '' explicitly.
# A bare `"` alternative would match the OPENING quote of `KEY="realsecret"`
# and silently whitelist every quoted secret in the repo. Do not add a bare `$`
# alternative either: it matches the padding `=` at the end of base64 values.
PLACEHOLDER='=[[:space:]]*(""|'\'''\''|`?<[^>]*>|["'\''`]?(\$\{?[A-Za-z_]|\$\(|your[-_]|my[-_]|the[-_]|xxx|X{3,}|changeme|change[-_]me|placeholder|example|dummy|sample|redacted|noauth|local-dev|test[-_]|fake|\.\.\.))'
# Exact documentation/test values require an explicit safe boundary: end of
# line, a Markdown code/table wrapper, a shell continuation, or a comment.
# Keep this separate from PLACEHOLDER: unanchored `token` or `test` would
# suppress real values that merely begin with those words.
SAFE_DOC_VALUE="=[[:space:]]*['\"]?((token|test)|(local|dev)-[A-Za-z0-9_-]*(secret|token|key)[A-Za-z0-9_-]*)['\"]?\`?[[:space:]]*(\\\\|\\|.*|#.*|//.*)?$"
# An environment reference contains a variable name, not its runtime value.
SAFE_ENV_REFERENCE='=[[:space:]]*process\.env\.'

# Cloudflare's PUBLIC, documented Turnstile test keys (developers.cloudflare.com/turnstile/troubleshooting/testing/).
# These are meant to be committed; they authenticate nothing.
TURNSTILE_TEST='[123]x0{20,}[A-Za-z]{2}'

EXCLUDES=(
  ':(exclude).git/**'
  ':(exclude).gitignore'
  ':(exclude)config/gitignore_global'
  ':(exclude)bin/security-check'
  ':(exclude).gitleaks.toml'
)

# Scan the WORKING TREE and the INDEX, then union them.
#
# Why both: plain `git grep` reads the working-tree copy of tracked files. It
# therefore MISSES a secret that lives only in the index — staged, then edited
# back out of the working tree. That content is exactly what `git commit` would
# write. `git grep --cached` reads the index and catches it.
#
# This does not make the guard noisier: a hit present in both views produces a
# byte-identical `path:line:content` line, and `sort -u` collapses it. Same file
# reported once. A noisy guard is a dangerous guard — the union is a superset of
# what is about to be committed, not a second opinion about the same thing.
# No flag needed: callers that scan the repo as-is (ai-doctor) get the same
# answer plus anything already staged, which is strictly more correct.
# The report file contains locations only. A security gate must never echo the
# credential it is protecting into CI logs, terminals, or captured diagnostics.
umask 077
TMP="$(mktemp "${TMPDIR:-/tmp}/dotfiles-secret-scan.XXXXXX")"
trap 'rm -f "$TMP"' EXIT

{
  # Precise signatures are never allowlisted.
  git grep -nEI          "$PRECISE_PATTERN" -- "${EXCLUDES[@]}" || true
  git grep -nEI --cached "$PRECISE_PATTERN" -- "${EXCLUDES[@]}" || true

  # Only broad NAME=value heuristics receive placeholder/test-key filtering.
  {
    git grep -nEI          "$ASSIGNMENT_PATTERN" -- "${EXCLUDES[@]}" || true
    git grep -nEI --cached "$ASSIGNMENT_PATTERN" -- "${EXCLUDES[@]}" || true
  } | sort -u \
    | { grep -vEi "$PLACEHOLDER" || true; } \
    | { grep -vEi "$SAFE_DOC_VALUE" || true; } \
    | { grep -vEi "$SAFE_ENV_REFERENCE" || true; } \
    | { grep -vE  "$TURNSTILE_TEST" || true; }
} | sort -u \
  | awk 'match($0, /:[0-9]+:/) {
      print substr($0, 1, RSTART + RLENGTH - 2) ": potential secret"
      next
    }
    { print "potential secret (location unavailable)" }' \
  | sort -u \
  > "$TMP"

if [ -s "$TMP" ]; then
  echo "Potential secret detected. Review before commit/push:" >&2
  cat "$TMP" >&2
  exit 1
fi

echo "security-check: no obvious secrets found."
