#!/usr/bin/env bash
# Scan dotfiles for obvious secrets before commit/push.
# Conservative guard: catches common tokens/keys, with allowlist for docs/config examples.
set -euo pipefail

REPO="${1:-$HOME/dotfiles}"
cd "$REPO"

if ! command -v git >/dev/null 2>&1; then
  echo "ERROR: git not found." >&2
  exit 1
fi

# Keep this intentionally broad. False positives are cheaper than leaked secrets.
PATTERN='(BEGIN (RSA|OPENSSH|DSA|EC|PGP) PRIVATE KEY|ghp_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]+|glpat-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|API[_-]?KEY[[:space:]]*=[[:space:]]*[^.`[:space:]]|ACCESS[_-]?TOKEN[[:space:]]*=[[:space:]]*[^.`[:space:]]|AUTH[_-]?TOKEN[[:space:]]*=[[:space:]]*[^.`[:space:]]|SECRET[[:space:]]*=[[:space:]]*[^.`[:space:]]|PASSWORD[[:space:]]*=[[:space:]]*[^.`[:space:]]|PRIVATE[_-]?KEY[[:space:]]*=[[:space:]]*[^.`[:space:]])'

# Placeholders — an assignment whose VALUE is obviously not a real secret.
# High-entropy patterns above (ghp_, sk-, AKIA, AIza, PRIVATE KEY) are NEVER filtered:
# they are precise enough that a match is a real leak. Only the broad NAME=value
# heuristics (SECRET=, API_KEY=, PASSWORD=…) get this second pass.
#
# A noisy guard is a dangerous guard — people learn to bypass it. Keep it quiet AND strict.
# CAREFUL: an empty-value alternative must be spelled "" / '' explicitly.
# A bare `"` alternative would match the OPENING quote of a real value (="s3cr3t")
# and silently whitelist every quoted secret in the repo. That bug was caught by
# the bait test below — keep that test.
PLACEHOLDER='=[[:space:]]*(""|'\'''\''|`?<[^>]*>|["'\''`]?(\$\{?[A-Za-z_]|your[-_]|my[-_]|the[-_]|xxx|X{3,}|changeme|change[-_]me|placeholder|example|dummy|sample|redacted|noauth|local-dev|test[-_]|fake|\.\.\.)|$)'

# Cloudflare's PUBLIC, documented Turnstile test keys (developers.cloudflare.com/turnstile/troubleshooting/testing/).
# These are meant to be committed; they authenticate nothing.
TURNSTILE_TEST='[123]x0{20,}[A-Za-z]{2}'

if git grep -nEI "$PATTERN" -- \
  ':(exclude).git/**' \
  ':(exclude).gitignore' \
  ':(exclude)config/gitignore_global' \
  ':(exclude)bin/security-check' \
  ':(exclude)docs/security.md' \
  ':(exclude).gitleaks.toml' \
  | grep -vEi "$PLACEHOLDER" \
  | grep -vE "$TURNSTILE_TEST" \
  >/tmp/dotfiles-secret-scan.$$ 2>/dev/null; then
  if [ -s /tmp/dotfiles-secret-scan.$$ ]; then
    echo "Potential secret detected. Review before commit/push:" >&2
    cat /tmp/dotfiles-secret-scan.$$ >&2
    rm -f /tmp/dotfiles-secret-scan.$$
    exit 1
  fi
fi

rm -f /tmp/dotfiles-secret-scan.$$ 2>/dev/null || true
echo "security-check: no obvious secrets found."
