#!/usr/bin/env bash
# Semi-auto dotfiles sync for Linux + macOS.
# Usage:
#   dotsync status
#   dotsync commit [message]
#   dotsync push
#   dotsync pull
#   dotsync autopull   (non-interactive ff-only pull for shell start; never commits)
#   dotsync sync [message]
#   dotsync doctor
# Options:
#   --yes   Skip confirmation prompts for the current command.
set -euo pipefail

# Resolve ke file asli (follow symlink) — fix saat script di-link ke ~/.local/bin/
if command -v realpath >/dev/null 2>&1; then
  SCRIPT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
elif command -v readlink >/dev/null 2>&1 && readlink -f "${BASH_SOURCE[0]}" >/dev/null 2>&1; then
  SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
else
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi
DOTFILES_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
AUTO_YES=0

if [ "${1:-}" = "--yes" ]; then
  AUTO_YES=1
  shift
fi

# A bare invocation must stay read-only. Mutating actions require an explicit verb.
COMMAND="${1:-status}"
if [ "$#" -gt 0 ]; then
  shift
fi
MESSAGE="${*:-}"

cd "$DOTFILES_ROOT"

say() { printf '%s\n' "$*"; }
err() { printf 'ERROR: %s\n' "$*" >&2; }
now() { date '+%Y-%m-%d %H:%M' 2>/dev/null || date; }
platform() {
  case "$(uname -s 2>/dev/null || echo unknown)" in
    Darwin) echo macOS ;;
    Linux) echo Linux ;;
    *) echo Unknown ;;
  esac
}
copy_if_exists() {
  local src="$1" dst="$2"
  [ -e "$src" ] || return 0
  # Some of these "snapshots" are symlinked live by install.sh — mise config is
  # one — so source and destination are the same inode. `cp` refuses that with
  # exit 1, and under `set -euo pipefail` it kills the whole run before `git add`
  # ever happens. A symlinked file needs no snapshot refresh anyway: it is
  # already the tracked file. This is the one place `-ef` is the right test.
  [ "$src" -ef "$dst" ] && return 0
  mkdir -p "$(dirname "$dst")"
  cp -f "$src" "$dst"
}
refresh_snapshots() {
  copy_if_exists "$HOME/.gitconfig" "$DOTFILES_ROOT/home/gitconfig"
  copy_if_exists "$HOME/.config/mise/config.toml" "$DOTFILES_ROOT/config/mise-config.toml"
  copy_if_exists "$HOME/.bashrc" "$DOTFILES_ROOT/home/bashrc.snapshot"
  copy_if_exists "$HOME/.zshrc" "$DOTFILES_ROOT/home/zshrc.snapshot"
  copy_if_exists "$HOME/.config/Code/User/settings.json" "$DOTFILES_ROOT/config/vscode-settings.json"
  copy_if_exists "$HOME/Library/Application Support/Code/User/settings.json" "$DOTFILES_ROOT/config/vscode-settings.json"
}
require_git_repo() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    err "Bukan git repo: $DOTFILES_ROOT"
    exit 1
  }
}
confirm() {
  local prompt="$1"
  if [ "$AUTO_YES" -eq 1 ]; then
    return 0
  fi
  if [ ! -t 0 ]; then
    return 1
  fi
  printf '%s [y/N] ' "$prompt"
  read -r answer
  case "$answer" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}
print_status() {
  git -c core.pager=cat status --short --branch
}
show_staged_preview() {
  say ""
  say "Staged preview:"
  git -c core.pager=cat diff --cached --stat
}
run_security_check() {
  local scanner="$DOTFILES_ROOT/bin/security-check"
  if [ ! -x "$scanner" ]; then
    err "security-check tidak ada atau tidak executable: $scanner; menolak commit tanpa pemindaian."
    return 1
  fi
  # Pass the repository explicitly. Without an argument security-check falls back
  # to $HOME/dotfiles, so a worktree or a second clone would be committed after
  # scanning a different tree entirely.
  if ! "$scanner" "$DOTFILES_ROOT" >/dev/null; then
    err "security-check menemukan kemungkinan secret; commit dibatalkan."
    "$scanner" "$DOTFILES_ROOT" >&2 || true
    err "Perubahan tetap ter-stage untuk direview. Batalkan staging dengan: git reset"
    return 1
  fi
}
ensure_clean_for_pull() {
  if ! git diff --quiet || ! git diff --cached --quiet; then
    err "Working tree belum bersih. Commit/stash dulu sebelum pull."
    print_status
    exit 1
  fi
}
# A pull can change CORE.md, an adapter, or the runtime wiring itself; relink
# so no runtime keeps a dangling or outdated global context.
relink_runtimes() {
  [ -x "$DOTFILES_ROOT/bin/ai-memory-link" ] || return 0
  # Only the no-op "ok:" lines are hidden; backups, skipped targets, and
  # dangling-link warnings must stay visible after a pull.
  if link_out="$("$DOTFILES_ROOT/bin/ai-memory-link" 2>&1)"; then
    printf '%s\n' "$link_out" | grep -v '^ok: ' || true
    say "✓ AI runtime context di-link ulang"
  else
    printf '%s\n' "$link_out"
    err "ai-memory-link gagal — jalankan manual: ai-memory-link"
    return 1
  fi
}
file_mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }
autopull_state() { printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/dotsync"; }
# Devices drift when pulls are manual (TASK-099). autopull runs from shell start
# in the background: fast-forward only, never on a dirty tree or another branch,
# never commits or pushes, throttled, and it records one line of outcome that the
# next shell and ai-doctor can show. `dotsync pull` keeps its confirmation.
cmd_autopull() {
  require_git_repo
  local state stamp interval branch before fails=0
  state="$(autopull_state)"; mkdir -p "$state"
  stamp="$state/last-attempt"
  interval="${DOTSYNC_AUTOPULL_INTERVAL:-21600}"
  if [ -f "$stamp" ] && [ $(( $(date +%s) - $(file_mtime "$stamp") )) -lt "$interval" ]; then
    return 0
  fi
  # Several shells opening at once (tmux panes) must not race on index.lock.
  # A lock older than 10 minutes is a crashed run, not a live one.
  # Renamed before removal to narrow the race with another shell reclaiming the
  # same stale lock; the residual window only risks an index.lock warn: record.
  if [ -d "$state/lock" ] && [ $(( $(date +%s) - $(file_mtime "$state/lock") )) -gt 600 ]; then
    mv "$state/lock" "$state/lock.stale.$$" 2>/dev/null && rmdir "$state/lock.stale.$$" 2>/dev/null || true
  fi
  mkdir "$state/lock" 2>/dev/null || return 0
  # Expanded now: $state is local and gone by the time the EXIT trap runs.
  trap "rmdir $(printf '%q' "$state/lock") 2>/dev/null || true" EXIT
  touch "$stamp"
  [ -f "$state/fail-count" ] && fails="$(cat "$state/fail-count" 2>/dev/null || echo 0)"
  case "$fails" in ''|*[!0-9]*) fails=0 ;; esac
  record() {
    printf '%s %s\n' "$(now)" "$1" > "$state/last-result"
    case "$1" in fail:*) printf '%s\n' $((fails + 1)) > "$state/fail-count" ;; *) rm -f "$state/fail-count" ;; esac
  }
  branch="$(git rev-parse --abbrev-ref HEAD)"
  [ "$branch" = main ] || { record "skip: on branch $branch, not main"; return 0; }
  if ! git diff --quiet || ! git diff --cached --quiet; then
    record "skip: local changes; run dotsync status"; return 0
  fi
  # A background job must never open a prompt or a password window, and a
  # stalled transfer must give up. ssh options apply only when the device has
  # not chosen its own ssh command.
  if [ -z "${GIT_SSH_COMMAND:-}" ] && [ -z "$(git config core.sshCommand 2>/dev/null)" ]; then
    export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=2"
  fi
  if ! env -u GIT_ASKPASS -u SSH_ASKPASS GIT_TERMINAL_PROMPT=0 \
       git -c core.askPass= -c credential.interactive=false \
           -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=20 fetch -q origin main </dev/null 2>/dev/null; then
    record "fail: fetch origin main"; return 1
  fi
  if git merge-base --is-ancestor origin/main HEAD; then
    record "ok: up to date"; return 0
  fi
  before="$(git rev-parse --short HEAD)"
  if ! git merge -q --ff-only origin/main >/dev/null 2>&1; then
    record "warn: cannot fast-forward (diverged, or local files in the way); run dotsync pull"; return 1
  fi
  if relink_runtimes >/dev/null 2>&1; then
    record "ok: pulled $before..$(git rev-parse --short HEAD)"
  else
    record "warn: pulled $before..$(git rev-parse --short HEAD) but ai-memory-link failed; run ai-memory-link"
    return 1
  fi
}
cmd_status() {
  require_git_repo
  say "dotfiles: $DOTFILES_ROOT"
  say "platform: $(platform)"
  print_status
}
cmd_commit() {
  require_git_repo
  refresh_snapshots
  git add -A
  if git diff --cached --quiet; then
    say "Tidak ada perubahan untuk di-commit."
    return 0
  fi
  print_status
  show_staged_preview
  run_security_check
  if ! confirm "Commit perubahan dotfiles ini?"; then
    say "Batal commit."
    exit 1
  fi
  git commit -m "${MESSAGE:-sync: $(now)}"
  say "✓ Commit selesai"
}
cmd_push() {
  require_git_repo
  print_status
  if ! confirm "Push branch ini ke origin?"; then
    say "Batal push."
    exit 1
  fi
  git push
  say "✓ Push selesai"
}
cmd_pull() {
  require_git_repo
  ensure_clean_for_pull
  if ! confirm "Pull update terbaru (ff-only) dari origin?"; then
    say "Batal pull."
    exit 1
  fi
  git pull --ff-only
  say "✓ Pull selesai"
  relink_runtimes
}

cmd_sync() {
  cmd_commit
  if confirm "Lanjut push ke origin?"; then
    git push
    say "✓ Sync selesai"
  else
    say "Commit lokal sudah dibuat. Push dilewati."
  fi
}
cmd_doctor() {
  require_git_repo
  say "dotfiles: $DOTFILES_ROOT"
  say "platform: $(platform)"
  say "remote: $(git remote get-url origin 2>/dev/null || echo '(tidak ada origin)')"
  say ""
  say "Shared memory targets:"
  for target in \
    "$HOME/.config/ai" \
    "$HOME/.claude/CLAUDE.md" \
    "$HOME/.codex/AGENTS.md" \
    "$HOME/.gemini/GEMINI.md" \
    "$HOME/.omp/agent/AGENTS.md"
  do
    if [ -L "$target" ] || [ -e "$target" ]; then
      say "- OK  $target"
    else
      say "- MISS $target"
    fi
  done
  say ""
  print_status
}

case "$COMMAND" in
  status) cmd_status ;;
  commit) cmd_commit ;;
  push) cmd_push ;;
  pull) cmd_pull ;;
  autopull) cmd_autopull ;;
  sync) cmd_sync ;;
  doctor) cmd_doctor ;;
  help|-h|--help)
    sed -n '1,13p' "$0"
    ;;
  *)
    err "Perintah tidak dikenal: $COMMAND"
    exit 1
    ;;
esac
