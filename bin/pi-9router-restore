#!/usr/bin/env bash
# Restore optional Pi settings/model integration, then delegate 9Router setup.
# Safe to run repeatedly. OMP does not depend on this adapter or on Pi state.
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
PI_AGENT_DIR="$HOME/.pi/agent"
PI_EXT_DIR="$HOME/.pi/extensions/compact-free"
OS="$(uname -s)"

say()  { printf '\033[1;32m→\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m⚠\033[0m  %s\n' "$*" >&2; }
err()  { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; }

if ! command -v pi >/dev/null 2>&1; then
  warn "Pi is not installed; preparing its optional config without making it an OMP prerequisite"
fi

mkdir -p "$PI_AGENT_DIR" "$PI_EXT_DIR"

settings_source="$DOTFILES_DIR/config/pi/settings.json"
if [ -f "$settings_source" ]; then
  # Pi rewrites settings.json during normal use — model switches and
  # lastChangelogVersion both land here. It must therefore be a machine-local
  # copy, never a link into the tracked repository, or every model switch dirties
  # the working tree and syncs one device's preference to all of them.
  #
  # The previous guard tested `-ef` and so did the opposite of what it intended:
  # a symlink pointing at the source *is* the same file, which made the condition
  # false and preserved the very link it should have replaced. Seed when missing,
  # de-link when linked, and otherwise leave a real local file untouched.
  if [ ! -e "$PI_AGENT_DIR/settings.json" ] || [ -L "$PI_AGENT_DIR/settings.json" ]; then
    # `rm -f` then copy, rather than `cp --remove-destination`: that flag is GNU
    # coreutils only and this repository also installs on macOS, where BSD cp
    # would reject it. Without the removal, cp follows an existing symlink and
    # writes straight through to the tracked file — the very thing being fixed.
    rm -f "$PI_AGENT_DIR/settings.json"
    cp "$settings_source" "$PI_AGENT_DIR/settings.json"
  fi
  # Report what is actually in place, not what the seed says. A machine-local
  # file that was kept will differ from the tracked seed, and printing the seed
  # would claim a state that is not there.
  SETTINGS_LIVE="$PI_AGENT_DIR/settings.json" python3 - <<'PY'
import json
import os

with open(os.environ["SETTINGS_LIVE"]) as live:
    settings = json.load(live)
print(
    "Pi settings in place "
    f"(provider={settings.get('defaultProvider', '?')}, "
    f"model={settings.get('defaultModel', '?')})"
)
PY
else
  warn "Missing config/pi/settings.json"
fi

models_source="$DOTFILES_DIR/config/pi/models.template.json"
if [ -f "$models_source" ]; then
  if [ ! -e "$PI_AGENT_DIR/models.json" ]; then
    cp "$models_source" "$PI_AGENT_DIR/models.json"
    say "Restored the optional Pi model template"
  else
    say "Kept the existing Pi models.json"
  fi
fi

extension_source="$DOTFILES_DIR/config/pi/extensions/compact-free"
if [ -d "$extension_source" ]; then
  # Same reasoning as settings.json above: `-ef` is true for a symlink pointing
  # at the source, so the old guard skipped the copy and kept the link — while
  # still reporting "Restored", a claim about work that never happened. Pi writes
  # into its extension directory (installs, caches, updates), and through a link
  # those writes land in the tracked repository.
  if [ -L "$PI_EXT_DIR" ]; then
    rm -f "$PI_EXT_DIR"
  fi
  mkdir -p "$PI_EXT_DIR"
  cp -R "$extension_source/." "$PI_EXT_DIR/"
  say "Restored the optional Pi compact-free extension"
else
  warn "Missing config/pi/extensions/compact-free"
fi

sync_source="$DOTFILES_DIR/bin/pi-9router-sync.js"
if [ -f "$sync_source" ]; then
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$sync_source" "$HOME/.local/bin/pi-9router-sync.js"
  say "Linked the optional Pi model sync helper"
fi

extra_models_source="$DOTFILES_DIR/config/9router/pi-extra-models.json"
if [ -f "$extra_models_source" ]; then
  mkdir -p "$HOME/.9router"
  # Last of the `-ef` guards: a link here was preserved rather than replaced.
  rm -f "$HOME/.9router/pi-extra-models.json"
  cp "$extra_models_source" "$HOME/.9router/pi-extra-models.json"
  say "Restored optional Pi-only model metadata"
fi

generic_restore="$DOTFILES_DIR/bin/9router-restore"
if [ ! -x "$generic_restore" ]; then
  err "Missing executable bin/9router-restore"
  exit 1
fi
DOTFILES_DIR="$DOTFILES_DIR" "$generic_restore"

if [ "$OS" = "Linux" ] \
  && command -v node >/dev/null 2>&1 \
  && command -v systemctl >/dev/null 2>&1 \
  && [ -e "$HOME/.local/bin/pi-9router-sync.js" ]; then
  systemd_user_dir="$HOME/.config/systemd/user"
  sync_service_path="$systemd_user_dir/pi-9router-sync.service"
  mkdir -p "$systemd_user_dir"
  cat > "$sync_service_path" <<SYNCEOF
[Unit]
Description=Sync active 9Router models into optional Pi models.json
After=network-online.target 9router.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$(command -v node) $HOME/.local/bin/pi-9router-sync.js

[Install]
WantedBy=default.target
SYNCEOF
  systemctl --user daemon-reload
  systemctl --user enable pi-9router-sync.service >/dev/null
  say "Restored the optional Pi model-sync service at $sync_service_path"
fi

say "Pi adapter restore complete; Pi credentials and existing models remain machine-local"
say "Image generation belongs to the runtime-neutral 9Router skill/API, not this adapter"
