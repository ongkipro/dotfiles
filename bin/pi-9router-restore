#!/usr/bin/env bash
# pi-9router-restore — restore pi.dev settings + 9router service (macOS + Linux)
# Safe to run multiple times. Handles both launchd (macOS) and systemd (Linux).
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
PI_AGENT_DIR="$HOME/.pi/agent"
PI_EXT_DIR="$HOME/.pi/extensions/compact-free"
OS="$(uname -s)"

say()  { printf '\033[1;32m→\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m⚠\033[0m  %s\n' "$*" >&2; }
err()  { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; }

NODE_BIN="$(command -v node || true)"
ROUTER_BIN="$(command -v 9router || true)"

# ── 1) Restore pi settings ──────────────────────────────────────────────────
mkdir -p "$PI_AGENT_DIR" "$PI_EXT_DIR"

if [ -f "$DOTFILES_DIR/config/pi/settings.json" ]; then
  cp "$DOTFILES_DIR/config/pi/settings.json" "$PI_AGENT_DIR/settings.json"
  say "pi settings.json restored (provider=9router, model=ocg/deepseek-v4-pro)"
else
  warn "dotfiles/config/pi/settings.json tidak ditemukan"
fi

# ── 1.5) Restore models.json (9router provider definition) ──────────────────
if [ -f "$DOTFILES_DIR/config/pi/models.template.json" ]; then
  if [ ! -f "$PI_AGENT_DIR/models.json" ]; then
    cp "$DOTFILES_DIR/config/pi/models.template.json" "$PI_AGENT_DIR/models.json"
    say "models.json restored (9router provider + 7 models)"
  else
    say "models.json sudah ada — skip (jangan overwrite custom models)"
  fi
fi

# ── 1.6) Ensure 9router entry in auth.json (needed for pi to show 9router models) ──
AUTH_FILE="$PI_AGENT_DIR/auth.json"
if [ -f "$AUTH_FILE" ]; then
  if ! grep -q '"9router-fantastico"' "$AUTH_FILE" 2>/dev/null; then
    say "Menambahkan 9router ke auth.json (localhost trust)..."
    python3 -c "
import json
with open('$AUTH_FILE') as f:
    auth = json.load(f)
if '9router-fantastico' not in auth:
    auth['9router-fantastico'] = {'type': 'api_key', 'key': '9router-local'}
    with open('$AUTH_FILE', 'w') as f:
        json.dump(auth, f, indent=2)
    print('✓ 9router entry added')
" 2>/dev/null || warn "Gagal update auth.json — tambahkan manual"
  else
    say "9router sudah ada di auth.json"
  fi
fi

# ── 2) Restore compact-free extension ────────────────────────────────────────
if [ -d "$DOTFILES_DIR/config/pi/extensions/compact-free" ]; then
  cp "$DOTFILES_DIR/config/pi/extensions/compact-free/"* "$PI_EXT_DIR/"
  say "compact-free extension restored"
else
  warn "compact-free extension tidak ditemukan di dotfiles"
fi

# ── 3) Setup 9router service ─────────────────────────────────────────────────
if [ -z "$NODE_BIN" ] || [ -z "$ROUTER_BIN" ]; then
  warn "node atau 9router tidak ditemukan — skip service setup."
  warn "Install: npm i -g 9router"
  exit 0
fi

ROUTER_CLI="$(readlink -f "$ROUTER_BIN" 2>/dev/null || realpath "$ROUTER_BIN" 2>/dev/null || echo "$ROUTER_BIN")"
APP_DIR="$(dirname "$ROUTER_CLI")/app"
RUNTIME_NM="$HOME/.9router/runtime/node_modules"
BUNDLED_NM="$APP_DIR/node_modules"
NODE_PATH_COMBINED="$RUNTIME_NM:$BUNDLED_NM"
PORT="${NINEROUTER_PORT:-20128}"
HOST="${NINEROUTER_HOST:-127.0.0.1}"

mkdir -p "$HOME/.9router/logs"

case "$OS" in
  Darwin)
    # ── macOS: launchd plist ─────────────────────────────────────────────
    PLIST="$HOME/Library/LaunchAgents/com.9router.gateway.plist"

    cat > "$PLIST" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.9router.gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>$NODE_BIN</string>
    <string>$APP_DIR/custom-server.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PORT</key>
    <string>$PORT</string>
    <key>HOSTNAME</key>
    <string>$HOST</string>
    <key>NODE_PATH</key>
    <string>$NODE_PATH_COMBINED</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>$APP_DIR</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$HOME/.9router/logs/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>$HOME/.9router/logs/stderr.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
PLISTEOF

    launchctl unload "$PLIST" 2>/dev/null || true
    launchctl load "$PLIST"
    say "9router launchd service generated → $PLIST"
    ;;

  Linux)
    # ── Linux: systemd user service ──────────────────────────────────────
    SYSTEMD_USER_DIR="$HOME/.config/systemd/user"
    SERVICE_PATH="$SYSTEMD_USER_DIR/9router.service"
    mkdir -p "$SYSTEMD_USER_DIR"

    cat > "$SERVICE_PATH" <<SERVICEEOF
[Unit]
Description=9Router AI Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=$APP_DIR
Environment=NODE_ENV=production
Environment=HOME=%h
Environment=PORT=$PORT
Environment=HOSTNAME=$HOST
Environment=NODE_PATH=$NODE_PATH_COMBINED
ExecStart=$NODE_BIN $APP_DIR/custom-server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
SERVICEEOF

    systemctl --user daemon-reload
    systemctl --user enable 9router.service >/dev/null
    systemctl --user restart 9router.service
    say "9router systemd service generated → $SERVICE_PATH"
    ;;
esac

sleep 2

# ── 4) Health check ──────────────────────────────────────────────────────────
HEALTH_URL="http://${HOST}:${PORT}/api/health"
if curl -fsS "$HEALTH_URL" >/dev/null 2>&1; then
  say "✓ 9router healthy on $HEALTH_URL"
else
  warn "9router service started, tapi health check gagal"
  case "$OS" in
    Darwin) warn "  cek: cat ~/.9router/logs/stderr.log" ;;
    Linux)  warn "  cek: journalctl --user -u 9router.service -n 50 --no-pager" ;;
  esac
fi

echo ""
say "Catatan penting:"
say "- models.json TIDAK di-restore karena berisi API key 9router"
say "- pastikan ~/.pi/agent/models.json sudah ada dan valid"
say "- jalankan '9router-start status' untuk cek status kapan saja"
