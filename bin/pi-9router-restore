#!/usr/bin/env bash
# pi-9router-restore — restore pi.dev settings + 9router service (macOS + Linux)
# Safe to run multiple times. Handles both launchd (macOS) and systemd (Linux).
set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
PI_AGENT_DIR="$HOME/.pi/agent"
PI_EXT_DIR="$HOME/.pi/extensions/compact-free"
OS="$(uname -s)"

say()  { printf '\033[1;32m→\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m⚠\033[0m  %s\n' "$*" >&2; }
err()  { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; }

NODE_BIN="$(command -v node || true)"
ROUTER_BIN="$(command -v 9router || true)"
AUTOSTART_DESKTOP="$HOME/.config/autostart/9router.desktop"

ensure_linux_systemd_owns_9router() {
  [ "$OS" = "Linux" ] || return 0
  [ -f "$AUTOSTART_DESKTOP" ] || return 0
  if grep -q '9router/cli\.js --tray' "$AUTOSTART_DESKTOP" 2>/dev/null; then
    python3 - <<'PY'
from pathlib import Path
p = Path.home() / '.config/autostart/9router.desktop'
text = p.read_text()
repls = {
    'Hidden=false': 'Hidden=true',
    'NoDisplay=false': 'NoDisplay=true',
    'X-GNOME-Autostart-enabled=true': 'X-GNOME-Autostart-enabled=false',
}
for old, new in repls.items():
    text = text.replace(old, new)
p.write_text(text)
PY
    say "Disabled GNOME tray autostart for 9router (systemd is the source of truth)"
  fi
}

# ── 1) Restore pi settings ──────────────────────────────────────────────────
mkdir -p "$PI_AGENT_DIR" "$PI_EXT_DIR"

if [ -f "$DOTFILES_DIR/config/pi/settings.json" ]; then
  cp "$DOTFILES_DIR/config/pi/settings.json" "$PI_AGENT_DIR/settings.json"
  SETTINGS_SUMMARY="$(python3 - <<'PY'
import json, os
p=os.path.expanduser('~/dotfiles/config/pi/settings.json')
try:
    s=json.load(open(p))
    print(f"provider={s.get('defaultProvider','?')}, model={s.get('defaultModel','?')}, thinking={s.get('defaultThinkingLevel','?')}, theme={s.get('theme','?')}")
except Exception:
    print('provider=?, model=?, thinking=?, theme=?')
PY
)"
  say "pi settings.json restored ($SETTINGS_SUMMARY)"
else
  warn "dotfiles/config/pi/settings.json tidak ditemukan"
fi

# ── 1.5) Restore models.json (9router provider definition) ──────────────────
if [ -f "$DOTFILES_DIR/config/pi/models.template.json" ]; then
  if [ ! -f "$PI_AGENT_DIR/models.json" ]; then
    cp "$DOTFILES_DIR/config/pi/models.template.json" "$PI_AGENT_DIR/models.json"
    say "models.json restored (9router provider + 7 models)"
  else
    say "models.json sudah ada — skip (jangan overwrite custom models)"
  fi
fi

# ── 1.6) Ensure 9router entry in auth.json (needed for pi to show 9router models) ──
AUTH_FILE="$PI_AGENT_DIR/auth.json"
if [ -f "$AUTH_FILE" ]; then
  if ! grep -q '"9router-fantastico"' "$AUTH_FILE" 2>/dev/null; then
    say "Menambahkan 9router ke auth.json (localhost trust)..."
    # auth.json = file KREDENSIAL. Ditulis atomik: temp di direktori yang SAMA
    # (agar os.replace tidak lintas-filesystem) lalu rename. Truncate-in-place
    # akan meninggalkan file kosong/rusak kalau proses mati di tengah jalan —
    # artinya SEMUA kredensial pi hilang, bukan cuma entri 9router.
    # Mode file lama dipertahankan; file baru dibuat 0600, jangan world-readable.
    # Error TIDAK ditelan (`2>/dev/null` dihapus): gagal menulis kredensial harus terlihat.
    if ! AUTH_FILE="$AUTH_FILE" python3 - <<'PY'
import json, os, tempfile

path = os.environ['AUTH_FILE']
with open(path) as f:
    auth = json.load(f)

if '9router-fantastico' in auth:
    raise SystemExit(0)

auth['9router-fantastico'] = {'type': 'api_key', 'key': '9router-local'}

try:
    mode = os.stat(path).st_mode & 0o777
except FileNotFoundError:
    mode = 0o600

fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or '.', prefix='.auth.json.')
try:
    with os.fdopen(fd, 'w') as f:
        json.dump(auth, f, indent=2)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)
    os.replace(tmp, path)
except BaseException:
    os.unlink(tmp)
    raise

print('✓ 9router entry added')
PY
    then
      err "Gagal menulis $AUTH_FILE (lihat error Python di atas)."
      err "auth.json TIDAK diubah — isinya masih utuh. Tambahkan entri 9router manual."
    fi
  else
    say "9router sudah ada di auth.json"
  fi
fi

# ── 2) Restore compact-free extension ────────────────────────────────────────
if [ -d "$DOTFILES_DIR/config/pi/extensions/compact-free" ]; then
  cp "$DOTFILES_DIR/config/pi/extensions/compact-free/"* "$PI_EXT_DIR/"
  say "compact-free extension restored"
else
  warn "compact-free extension tidak ditemukan di dotfiles"
fi

# ── 2.6) Link pi-9router-sync.js (dipakai service auto-sync models) ──────────
if [ -f "$DOTFILES_DIR/bin/pi-9router-sync.js" ]; then
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$DOTFILES_DIR/bin/pi-9router-sync.js" "$HOME/.local/bin/pi-9router-sync.js"
  say "pi-9router-sync.js linked → ~/.local/bin/"
fi

# ── 2.7) Restore 9router shared config (non-secret) ──────────────────────────
mkdir -p "$HOME/.9router/runtime"
if [ -f "$DOTFILES_DIR/config/9router/aliases.json" ]; then
  cp "$DOTFILES_DIR/config/9router/aliases.json" "$HOME/.9router/aliases.json"
  say "9router aliases restored"
fi
if [ -f "$DOTFILES_DIR/config/9router/runtime-package.json" ]; then
  cp "$DOTFILES_DIR/config/9router/runtime-package.json" "$HOME/.9router/runtime/package.json"
  say "9router runtime package restored"
fi
if [ -f "$DOTFILES_DIR/config/9router/pi-extra-models.json" ]; then
  cp "$DOTFILES_DIR/config/9router/pi-extra-models.json" "$HOME/.9router/pi-extra-models.json"
  say "9router pi-extra-models restored (pinned models untuk pi /model)"
fi

# ── 3) Setup 9router service ─────────────────────────────────────────────────
if [ -z "$NODE_BIN" ] || [ -z "$ROUTER_BIN" ]; then
  warn "node atau 9router tidak ditemukan — skip service setup."
  warn "Install: npm i -g 9router"
  exit 0
fi

ROUTER_CLI="$(readlink -f "$ROUTER_BIN" 2>/dev/null || realpath "$ROUTER_BIN" 2>/dev/null || echo "$ROUTER_BIN")"
APP_DIR="$(dirname "$ROUTER_CLI")/app"
RUNTIME_NM="$HOME/.9router/runtime/node_modules"
BUNDLED_NM="$APP_DIR/node_modules"
NODE_PATH_COMBINED="$RUNTIME_NM:$BUNDLED_NM"
PORT="${NINEROUTER_PORT:-20128}"
HOST="${NINEROUTER_HOST:-127.0.0.1}"

mkdir -p "$HOME/.9router/logs"

case "$OS" in
  Darwin)
    # ── macOS: launchd plist ─────────────────────────────────────────────
    # ⚠️ 9router memasang autostart-nya SENDIRI (`com.9router.autostart`, mode --tray).
    # Job itu TIDAK menyetel HOSTNAME → gateway bind ke 0.0.0.0 = API key semua provider
    # bisa dipakai siapa pun di WiFi yang sama. Dia juga duplikat dengan service di bawah
    # (dua proses rebutan port 20128). Cabut dulu — disimpan, bukan dihapus.
    STRAY="$HOME/Library/LaunchAgents/com.9router.autostart.plist"
    if [ -e "$STRAY" ]; then
      launchctl bootout "gui/$(id -u)/com.9router.autostart" 2>/dev/null || launchctl unload "$STRAY" 2>/dev/null || true
      mkdir -p "$HOME/.local/share/9router-disabled"
      mv -f "$STRAY" "$HOME/.local/share/9router-disabled/" 2>/dev/null || true
      say "autostart 9router bawaan (bind 0.0.0.0) dicabut → ~/.local/share/9router-disabled/"
    fi

    PLIST="$HOME/Library/LaunchAgents/com.9router.gateway.plist"

    cat > "$PLIST" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.9router.gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>$NODE_BIN</string>
    <string>$APP_DIR/custom-server.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PORT</key>
    <string>$PORT</string>
    <key>HOSTNAME</key>
    <string>$HOST</string>
    <key>NODE_PATH</key>
    <string>$NODE_PATH_COMBINED</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>$APP_DIR</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$HOME/.9router/logs/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>$HOME/.9router/logs/stderr.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
PLISTEOF

    launchctl unload "$PLIST" 2>/dev/null || true
    launchctl load "$PLIST"
    say "9router launchd service generated → $PLIST"
    ;;

  Linux)
    # ── Linux: systemd user service ──────────────────────────────────────
    ensure_linux_systemd_owns_9router
    SYSTEMD_USER_DIR="$HOME/.config/systemd/user"
    SERVICE_PATH="$SYSTEMD_USER_DIR/9router.service"
    mkdir -p "$SYSTEMD_USER_DIR"

    cat > "$SERVICE_PATH" <<SERVICEEOF
[Unit]
Description=9Router AI Gateway
After=network-online.target
Wants=network-online.target
# GLITCH-FIX 2026-07-28: anti crash-loop
#   1) ExecStartPre sleep — beri waktu node release port sebelum systemd retry
#      (EADDRINUSE sebelumnya loop 28K+ kali karena RestartSec=5 lebih cepat
#      dari waktu node shutdown bersih)
#   2) StartLimit* — hentikan restart loop setelah 10 crash dalam 5 menit
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=$APP_DIR
Environment=NODE_ENV=production
Environment=HOME=%h
Environment=PORT=$PORT
Environment=HOSTNAME=$HOST
Environment=NODE_PATH=$NODE_PATH_COMBINED
ExecStartPre=/bin/sleep 2
ExecStart=$NODE_BIN $APP_DIR/custom-server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
SERVICEEOF

    systemctl --user daemon-reload
    systemctl --user enable 9router.service >/dev/null
    systemctl --user restart 9router.service
    say "9router systemd service generated → $SERVICE_PATH"

    # ── pi-9router-sync: oneshot sync models 9router → pi models.json ───
    SYNC_SERVICE_PATH="$SYSTEMD_USER_DIR/pi-9router-sync.service"
    cat > "$SYNC_SERVICE_PATH" <<SYNCEOF
[Unit]
Description=Sync active 9router models into pi models.json
After=network-online.target 9router.service
# GLITCH-FIX 2026-07-28: RemainAfterExit agar unit "considered active" setelah
#   sukses — dependency (jika ada) akan nunggu, dan kita bisa cek `is-active`.
#   Tanpa ini: oneshot setelah selesai → inactive → sync tidak pernah jalan
#   di session berikutnya tanpa manual trigger.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$NODE_BIN $HOME/.local/bin/pi-9router-sync.js

[Install]
WantedBy=default.target
SYNCEOF
    systemctl --user daemon-reload
    systemctl --user enable pi-9router-sync.service >/dev/null
    say "pi-9router-sync service generated → $SYNC_SERVICE_PATH"
    ;;
esac

sleep 2

# ── 4) Health check ──────────────────────────────────────────────────────────
HEALTH_URL="http://${HOST}:${PORT}/api/health"
if curl -fsS "$HEALTH_URL" >/dev/null 2>&1; then
  say "✓ 9router healthy on $HEALTH_URL"
  if [ "$OS" = "Linux" ] && systemctl --user list-unit-files 2>/dev/null | grep -q '^pi-9router-sync.service'; then
    systemctl --user start pi-9router-sync.service >/dev/null 2>&1 || warn "pi-9router-sync gagal jalan; cek journalctl --user -u pi-9router-sync.service"
    say "pi-9router-sync triggered"
  fi
else
  warn "9router service started, tapi health check gagal"
  case "$OS" in
    Darwin) warn "  cek: cat ~/.9router/logs/stderr.log" ;;
    Linux)  warn "  cek: journalctl --user -u 9router.service -n 50 --no-pager" ;;
  esac
fi

echo ""
say "Catatan penting:"
say "- settings.json + compact-free + 9router shared config sudah di-restore dari dotfiles"
say "- models.template.json hanya di-copy menjadi models.json kalau models.json belum ada (aman, tanpa secret)"
say "- auth.json, models.json existing, sessions/, dan secret 9router tetap manual / device-local"
say "- jalankan '9router-start status' atau systemctl/launchctl sesuai OS untuk cek status kapan saja"
